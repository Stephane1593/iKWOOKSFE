                                        <Run Text="{Binding Quantity, StringFormat=G}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" FontSize="22"
                                               FontWeight="Bold" HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               FontFamily="{StaticResource AppFont}">
                                        <Run Text="{Binding Total, StringFormat=N0}"/>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Grand total -->
            <Border Grid.Row="2" Background="#0F172A" Padding="30,24">
                <Grid>
                    <StackPanel>
