            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Margin="30,10">
                <ItemsControl ItemsSource="{Binding DisplayItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
