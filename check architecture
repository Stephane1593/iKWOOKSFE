                               Foreground="{StaticResource PrimaryBrush}"
                               FontFamily="{StaticResource AppFont}">
                        <Run Text="{Binding GrandTotal, StringFormat=N0, Mode=OneWay}"/>
                        <Run Text=" CDF" FontSize="28"/>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <!-- -- NORMALIZED: Thank you + QR Code -- -->
        <Grid Visibility="{Binding ShowReceipt, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0F172A" Offset="0"/>
                    <GradientStop Color="#1E3A5F" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="?" FontSize="80" HorizontalAlignment="Center"
