                <TextBlock Text="Merci pour votre achat !" FontSize="36"
                           FontWeight="Bold" HorizontalAlignment="Center"
                           Margin="0,20,0,0" FontFamily="{StaticResource AppFont}"/>
                <TextBlock Text="{Binding CompanyName}" FontSize="22"
                           HorizontalAlignment="Center" Foreground="#94A3B8"
                           Margin="0,8,0,30" FontFamily="{StaticResource AppFont}"/>

                <!-- Total -->
                <Border Background="#1E293B" CornerRadius="16" Padding="40,20"
                        HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="TOTAL" FontSize="16" Foreground="#94A3B8"
                                   HorizontalAlignment="Center"
                                   FontFamily="{StaticResource AppFont}"/>
                        <TextBlock FontSize="52" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   FontFamily="{StaticResource AppFont}">
                            <Run Text="{Binding GrandTotal, StringFormat=N0, Mode=OneWay}"/>
                            <Run Text=" CDF" FontSize="24"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- QR Code -->
                <Border Background="White" CornerRadius="12" Padding="16"
                        Margin="0,30,0,0" HorizontalAlignment="Center">
                    <Image Source="{Binding QrCodeImage}" Width="200" Height="200"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>

                <TextBlock Text="{Binding CodeDEFDGI}" FontSize="14"
                           Foreground="#64748B" HorizontalAlignment="Center"
                           Margin="0,12,0,0" FontFamily="Consolas"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>


