                return;
            }

            if (mainVm.Reason == MainViewModel.CloseReason.ZClose)
            {
                sessionState.Close();
            }
            else if (mainVm.Reason == MainViewModel.CloseReason.Logout)
            {
                if (sessionState.IsSetupMode)
                    sessionState.ExitSetupMode();
            }

            authService.Logout();
        }
