            <!-- Header -->
            <Border Background="#0F172A" Padding="30,20">
                <Grid>
                    <TextBlock Text="{Binding CompanyName}" FontSize="24"
                               FontWeight="Bold" FontFamily="{StaticResource AppFont}"/>
                    <TextBlock Text="{Binding CurrentTime}" FontSize="20"
                               HorizontalAlignment="Right" FontFamily="Consolas"
                               Foreground="#94A3B8" VerticalAlignment="Center"/>
                </Grid>
            </Border>

