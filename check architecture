    <!--  -------------------------------------------------------  -->
    <!--  MAIN LAYOUT  -->
    <!--  -------------------------------------------------------  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  Navbar  -->
            <RowDefinition Height="Auto" />
            <!--  Notification banner  -->
            <RowDefinition Height="*" />
            <!--  Content  -->
            <RowDefinition Height="Auto" />
            <!--  Footer  -->
        </Grid.RowDefinitions>

        <!--  ---------------------------------------------------  -->
        <!--  TOP NAVBAR  +  ACCENT LINE  -->
        <!--  ---------------------------------------------------  -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  -- NAVBAR BAR --  -->
            <Border Grid.Row="0"
                    Background="{StaticResource NavbarGradient}"
                    Effect="{StaticResource NavbarShadow}">
                <!--  Glass overlay layer  -->
                <Border Background="{StaticResource NavbarGlassOverlay}">
                    <Grid Margin="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  -- LOGO --  -->
                        <StackPanel Grid.Column="0"
                                    Margin="0,0,28,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Border Width="136"
                                    Height="38"
                                    Background="{StaticResource LogoGradient}"
                                    CornerRadius="10">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14"
                                                      Direction="270"
                                                      Opacity="0.2"
                                                      ShadowDepth="2"
                                                      Color="#1A8CBF" />
                                </Border.Effect>
                                <!--  Inner glass shine  -->
                                <Border CornerRadius="10">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0" Color="#20FFFFFF" />
                                            <GradientStop Offset="0.5" Color="#00FFFFFF" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="18"
                                                                 Height="18"
                                                                 Margin="0,0,7,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="White"
                                                                 Kind="CubeOutline" />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   Text="iKWOOK SFE" />
                                    </StackPanel>
                                </Border>
                            </Border>
                        </StackPanel>

                        <!--  --------------------------------------  -->
                        <!--  NAVIGATION ITEMS  -->
                        <!--  --------------------------------------  -->
                        <ScrollViewer Grid.Column="1"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      PanningMode="HorizontalOnly"
                                      PreviewMouseWheel="NavScrollViewer_PreviewMouseWheel"
                                      VerticalScrollBarVisibility="Disabled">
                            <!-- -------------------------------------- -->
                            <!-- NAVIGATION ITEMS -->
                            <!-- -------------------------------------- -->
                            <ScrollViewer Grid.Column="1"
              Focusable="False"
              HorizontalScrollBarVisibility="Hidden"
              PreviewMouseWheel="NavScrollViewer_PreviewMouseWheel"
              PanningMode="HorizontalOnly"
              VerticalScrollBarVisibility="Disabled">
                                <StackPanel VerticalAlignment="Center"
                Orientation="Horizontal">

                                    <!-- +- TABLEAU DE BORD -+ -->
                                    <Button Command="{Binding NavigateToPageCommand}"
                CommandParameter="Dashboard"
                IsEnabled="{Binding CanAccessDashboard}"
                Padding="9,8"
                Style="{StaticResource NavBtn}"
                ToolTip="Tableau de bord">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="18"
                                         Height="18"
                                         VerticalAlignment="Center"
                                         Kind="ViewDashboard" />
                                            <TextBlock Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource NavLabelAdaptiveStyle}"
                           Text="Tableau de bord" />
                                        </StackPanel>
                                    </Button>

                                    <!-- +- FICHIER -+ -->
                                    <Grid>
                                        <ToggleButton x:Name="FichierDropdownBtn"
                          Checked="OnDropdownOpened"
                          IsEnabled="{Binding CanSeeFichier}"
                          Padding="9,8"
                          Style="{StaticResource NavDropdownBtn}"
                          ToolTip="Fichier">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Width="18"
                                             Height="18"
                                             VerticalAlignment="Center"
                                             Kind="FolderOutline" />
                                                <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource NavLabelAdaptiveStyle}"
                               Text="Fichier" />
                                                <materialDesign:PackIcon Width="16"
                                             Height="16"
                                             Margin="4,0,0,0"
                                             VerticalAlignment="Center"
                                             Kind="ChevronDown"
                                             Opacity="0.45"
                                             Style="{StaticResource NavLabelAdaptiveStyle}" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <Popup AllowsTransparency="True"
                   HorizontalOffset="-4"
                   IsOpen="{Binding IsChecked, ElementName=FichierDropdownBtn, Mode=TwoWay}"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=FichierDropdownBtn}"
                   PopupAnimation="Fade"
                   StaysOpen="False"
                   VerticalOffset="8">
                                            <Border MinWidth="240"
                        Padding="6"
                        Background="{StaticResource PopupGradient}"
                        BorderBrush="#E8F0F5"
                        BorderThickness="1"
                        CornerRadius="14"
                        Effect="{StaticResource PopupShadow}">
                                                <StackPanel>
                                                    <!-- Caisse -->
                                                    <Button Click="CloseDropdowns"
                                Command="{Binding NavigateToPageCommand}"
                                CommandParameter="Cash"
                                IsEnabled="{Binding CanAccessPos}"
                                Style="{StaticResource NavSubBtn}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="32"
                                        Height="32"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        CornerRadius="8">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                        <GradientStop Offset="0" Color="#ECFDF5" />
                                                                        <GradientStop Offset="1" Color="#D1FAE5" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                                <materialDesign:PackIcon Width="16"
                                                             Height="16"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="#059669"
                                                             Kind="CashRegister" />
                                                            </Border>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock FontWeight="Medium" Text="Caisse" />
                                                                <TextBlock FontSize="10" Foreground="#94A3B8" Text="Point de vente" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- Plan de Salle -->
                                                    <Button Click="CloseDropdowns"
                                Command="{Binding NavigateToPageCommand}"
                                CommandParameter="Tables"
                                IsEnabled="{Binding CanAccessTables}"
                                Style="{StaticResource NavSubBtn}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="32"
                                        Height="32"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        CornerRadius="8">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                        <GradientStop Offset="0" Color="#FFF7ED" />
                                                                        <GradientStop Offset="1" Color="#FFEDD5" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                                <materialDesign:PackIcon Width="16"
                                                             Height="16"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="#C2410C"
                                                             Kind="TableFurniture" />
                                                            </Border>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock FontWeight="Medium" Text="Plan de Salle" />
                                                                <TextBlock FontSize="10" Foreground="#94A3B8" Text="Gestion des tables" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- Facture -->
                                                    <Button Click="CloseDropdowns"
                                Command="{Binding NavigateToPageCommand}"
                                CommandParameter="Invoicing"
                                IsEnabled="{Binding CanAccessInvoicing}"
                                Style="{StaticResource NavSubBtn}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="32"
                                        Height="32"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        CornerRadius="8">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                        <GradientStop Offset="0" Color="#EFF6FF" />
                                                                        <GradientStop Offset="1" Color="#DBEAFE" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                                <materialDesign:PackIcon Width="16"
                                                             Height="16"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="#2563EB"
                                                             Kind="ReceiptTextOutline" />
                                                            </Border>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock FontWeight="Medium" Text="Facture" />
                                                                <TextBlock FontSize="10" Foreground="#94A3B8" Text="Créer une facture" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- Séparateur -->
                                                    <Border Height="1" Margin="8,4" Background="#E5E7EB" />

                                                    <!-- Facturation en masse -->
                                                    <Button Click="CloseDropdowns"
                                Command="{Binding NavigateToPageCommand}"
                                CommandParameter="BulkInvoicing"
                                IsEnabled="{Binding CanAccessBulkInvoicing}"
                                Style="{StaticResource NavSubBtn}"
                                ToolTip="Importer et facturer plusieurs clients depuis un fichier Excel">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="32"
                                        Height="32"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        CornerRadius="8">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                        <GradientStop Offset="0" Color="#F5F3FF" />
                                                                        <GradientStop Offset="1" Color="#EDE9FE" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                                <materialDesign:PackIcon Width="16"
                                                             Height="16"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="#7C3AED"
                                                             Kind="FileExcelBoxOutline" />
                                                            </Border>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock FontWeight="Medium" Text="Facturation en masse" />
                                                                    <Border Margin="8,0,0,0"
                                                Padding="5,1"
                                                VerticalAlignment="Center"
                                                Background="#EDE9FE"
                                                CornerRadius="4">
                                                                        <TextBlock FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="#7C3AED"
                                                       Text="EXCEL" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock FontSize="10" Foreground="#94A3B8" Text="Import multi-clients" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>

                                    <!-- +- ÉDITER -+ -->
                                    <Grid>
                                        <ToggleButton x:Name="EditerDropdownBtn"
                          Checked="OnDropdownOpened"
                          IsEnabled="{Binding CanSeeEditer}"
                          Padding="9,8"
                          Style="{StaticResource NavDropdownBtn}"
                          ToolTip="Éditer">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Width="18"
                                             Height="18"
                                             VerticalAlignment="Center"
                                             Kind="PencilOutline" />
                                                <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource NavLabelAdaptiveStyle}"
                               Text="Éditer" />
                                                <materialDesign:PackIcon Width="16"
                                             Height="16"
                                             Margin="4,0,0,0"
                                             VerticalAlignment="Center"
                                             Kind="ChevronDown"
                                             Opacity="0.45"
                                             Style="{StaticResource NavLabelAdaptiveStyle}" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <Popup AllowsTransparency="True"
