<Window x:Class="SFE.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:SFE.WPF.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        Title="iKWOOK SFE — Système de Facturation d'Entreprise"
        Height="800" Width="1300"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <!-- ═══ Gradient Brushes ═══ -->
        <LinearGradientBrush x:Key="NavbarGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0A1E2E" Offset="0"/>
            <GradientStop Color="#0D2B3E" Offset="0.3"/>
            <GradientStop Color="#102F45" Offset="0.7"/>
            <GradientStop Color="#0E2939" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="NavbarGlassOverlay" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0AFFFFFF" Offset="0"/>
            <GradientStop Color="#04FFFFFF" Offset="0.5"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LogoGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#37B1E4" Offset="0"/>
            <GradientStop Color="#2196D4" Offset="0.5"/>
            <GradientStop Color="#1A8CBF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentLineGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1A8CBF" Offset="0"/>
            <GradientStop Color="#37B1E4" Offset="0.25"/>
            <GradientStop Color="#3B82F6" Offset="0.5"/>
            <GradientStop Color="#8B5CF6" Offset="0.75"/>
            <GradientStop Color="#3B82F6" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AvatarGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#37B1E4" Offset="0"/>
            <GradientStop Color="#2196D4" Offset="0.5"/>
            <GradientStop Color="#1A8CBF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PopupGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#FCFDFE" Offset="0.5"/>
            <GradientStop Color="#F8FAFC" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#FAFBFD" Offset="0.4"/>
            <GradientStop Color="#F5F7FA" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterSeparator" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="Transparent" Offset="0"/>
            <GradientStop Color="#E2E8F0" Offset="0.15"/>
            <GradientStop Color="#CBD5E1" Offset="0.5"/>
            <GradientStop Color="#E2E8F0" Offset="0.85"/>
            <GradientStop Color="Transparent" Offset="1"/>
        </LinearGradientBrush>

        <!-- ═══ Premium popup shadow ═══ -->
        <DropShadowEffect x:Key="PopupShadow"
                          BlurRadius="36" ShadowDepth="8"
                          Opacity="0.14" Direction="270" Color="#0D2B3E"/>

        <DropShadowEffect x:Key="NavbarShadow"
                          BlurRadius="20" ShadowDepth="4"
                          Opacity="0.22" Direction="270" Color="#000"/>

        <!-- ══════════════════════════════════════════════════ -->
        <!--  NAV BUTTON  (smooth glow hover)                   -->
        <!-- ══════════════════════════════════════════════════ -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Foreground"       Value="#8BAAB9"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="FontFamily"       Value="{StaticResource AppFont}"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Margin"           Value="1,0"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="14,10">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="#00FFFFFF"/>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#14FFFFFF" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#00FFFFFF" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════ -->
        <!--  NAV DROPDOWN TOGGLE  (glass hover + checked)      -->
        <!-- ══════════════════════════════════════════════════ -->
        <Style x:Key="NavDropdownBtn" TargetType="ToggleButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"       Value="#8BAAB9"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="FontFamily"       Value="{StaticResource AppFont}"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Margin"           Value="1,0"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="14,10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1CFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════ -->
        <!--  DROPDOWN SUB-ITEM  (gradient hover)               -->
        <!-- ══════════════════════════════════════════════════ -->
        <Style x:Key="NavSubBtn" TargetType="Button">
            <Setter Property="Foreground"       Value="#1E3A4F"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="FontFamily"       Value="{StaticResource AppFont}"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="12,10">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="#00E1F3FB"/>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#EFF6FF" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#00E1F3FB" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════ -->
        <!--  DANGER SUB-ITEM  (red glow hover)                 -->
        <!-- ══════════════════════════════════════════════════ -->
        <Style x:Key="NavSubBtnDanger" TargetType="Button">
            <Setter Property="Foreground"       Value="#EF4444"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="FontFamily"       Value="{StaticResource AppFont}"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="12,10">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="#00FEE2E2"/>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#FEF2F2" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#00FEE2E2" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Warning sub-item (gold hover for Rapport Z) ═══ -->
        <Style x:Key="NavSubBtnWarning" TargetType="Button">
            <Setter Property="Foreground"       Value="#92400E"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="FontFamily"       Value="{StaticResource AppFont}"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="12,10">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="#00FEF3C7"/>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#FFFBEB" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#00FEF3C7" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ DROPDOWN SECTION HEADER ═══ -->
        <Style x:Key="NavSectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="Foreground"   Value="#94A3B8"/>
            <Setter Property="Margin"       Value="14,10,14,6"/>
            <Setter Property="FontFamily"   Value="{StaticResource AppFont}"/>
        </Style>

        <!-- ═══ Popup separator ═══ -->
        <Style x:Key="PopupSep" TargetType="Separator">
            <Setter Property="Margin" Value="10,6"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#E2E8F0" Offset="0.15"/>
                        <GradientStop Color="#E2E8F0" Offset="0.85"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  MAIN LAYOUT                                           -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Navbar -->
            <RowDefinition Height="Auto"/>
            <!-- Notification banner -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════ -->
        <!--  TOP NAVBAR  +  ACCENT LINE                        -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── NAVBAR BAR ── -->
            <Border Grid.Row="0" Background="{StaticResource NavbarGradient}"
                    Effect="{StaticResource NavbarShadow}">
                <!-- Glass overlay layer -->
                <Border Background="{StaticResource NavbarGlassOverlay}">
                    <Grid Margin="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- ── LOGO ── -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="0,0,28,0">
                            <Border CornerRadius="10" Width="136" Height="38"
                                    Background="{StaticResource LogoGradient}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2"
                                                      Opacity="0.2" Direction="270"
                                                      Color="#1A8CBF"/>
                                </Border.Effect>
                                <!-- Inner glass shine -->
                                <Border CornerRadius="10">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#20FFFFFF" Offset="0"/>
                                            <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="CubeOutline" Width="18" Height="18"
                                                                 Foreground="White" Margin="0,0,7,0"
                                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="iKWOOK SFE" Foreground="White" FontSize="14"
                                                   FontWeight="Bold" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"/>
                                    </StackPanel>
                                </Border>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════════════════════════════ -->
                        <!--  NAVIGATION ITEMS                     -->
                        <!-- ══════════════════════════════════════ -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <!-- ┌─ TABLEAU DE BORD ─┐ -->
                            <Button Style="{StaticResource NavBtn}"
                                    Command="{Binding NavigateToPageCommand}"
                                    CommandParameter="Dashboard"
                                    IsEnabled="{Binding CanAccessDashboard}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ViewDashboard" Width="18" Height="18"
                                                             Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tableau de bord" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- ┌─ FICHIER ─┐ -->
                            <Grid>
                                <ToggleButton x:Name="FichierDropdownBtn"
                                              Style="{StaticResource NavDropdownBtn}"
                                              Checked="OnDropdownOpened"
                                              IsEnabled="{Binding CanSeeFichier}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderOutline" Width="18" Height="18"
                                                                 Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Fichier" VerticalAlignment="Center"/>
                                        <materialDesign:PackIcon Kind="ChevronDown" Width="16" Height="16"
                                                                 Margin="4,0,0,0" VerticalAlignment="Center"
                                                                 Opacity="0.45"/>
                                    </StackPanel>
                                </ToggleButton>
                                <Popup IsOpen="{Binding IsChecked, ElementName=FichierDropdownBtn, Mode=TwoWay}"
                                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                                       PlacementTarget="{Binding ElementName=FichierDropdownBtn}"
                                       Placement="Bottom" HorizontalOffset="-4" VerticalOffset="8">
                                    <Border Background="{StaticResource PopupGradient}"
                                            CornerRadius="14" Padding="6"
                                            MinWidth="230" BorderBrush="#E8F0F5" BorderThickness="1"
                                            Effect="{StaticResource PopupShadow}">
                                        <StackPanel>
                                            <Button Style="{StaticResource NavSubBtn}"
                                                    Command="{Binding NavigateToPageCommand}"
                                                    CommandParameter="Cash" Click="CloseDropdowns"
                                                    IsEnabled="{Binding CanAccessPos}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="32" Height="32" CornerRadius="8"
                                                            Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#ECFDF5" Offset="0"/>
                                                                <GradientStop Color="#D1FAE5" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <materialDesign:PackIcon Kind="CashRegister" Width="16" Height="16"
                                                                                 Foreground="#059669"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Caisse" FontWeight="Medium"/>
                                                        <TextBlock Text="Point de vente" FontSize="10"
                                                                   Foreground="#94A3B8"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource NavSubBtn}"
                                                    Command="{Binding NavigateToPageCommand}"
                                                    CommandParameter="Invoicing" Click="CloseDropdowns"
                                                    IsEnabled="{Binding CanAccessInvoicing}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="32" Height="32" CornerRadius="8"
                                                            Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#EFF6FF" Offset="0"/>
                                                                <GradientStop Color="#DBEAFE" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <materialDesign:PackIcon Kind="ReceiptTextOutline" Width="16" Height="16"
                                                                                 Foreground="#2563EB"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Facture" FontWeight="Medium"/>
                                                        <TextBlock Text="Créer une facture" FontSize="10"
                                                                   Foreground="#94A3B8"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>

                            <!-- ┌─ ÉDITER ─┐ -->
                            <Grid>
                                <ToggleButton x:Name="EditerDropdownBtn"
                                              Style="{StaticResource NavDropdownBtn}"
                                              Checked="OnDropdownOpened"
                                              IsEnabled="{Binding CanSeeEditer}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18"
                                                                 Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Éditer" VerticalAlignment="Center"/>
                                        <materialDesign:PackIcon Kind="ChevronDown" Width="16" Height="16"
                                                                 Margin="4,0,0,0" VerticalAlignment="Center"
                                                                 Opacity="0.45"/>
                                    </StackPanel>
                                </ToggleButton>
                                <Popup IsOpen="{Binding IsChecked, ElementName=EditerDropdownBtn, Mode=TwoWay}"
                                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                                       PlacementTarget="{Binding ElementName=EditerDropdownBtn}"
                                       Placement="Bottom" HorizontalOffset="-4" VerticalOffset="8">
                                    <Border Background="{StaticResource PopupGradient}"
                                            CornerRadius="14" Padding="6"
                                            MinWidth="260" BorderBrush="#E8F0F5" BorderThickness="1"
                                            Effect="{StaticResource PopupShadow}">
                                        <StackPanel>
                                            <TextBlock Text="DONNÉES" Style="{StaticResource NavSectionHeader}"/>

                                            <Button Style="{StaticResource NavSubBtn}"
                                                    Command="{Binding NavigateToPageCommand}"
                                                    CommandParameter="Articles" Click="CloseDropdowns"
                                                    IsEnabled="{Binding CanAccessProducts}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="30" Height="30" CornerRadius="8"
                                                            Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#F5F3FF" Offset="0"/>
                                                                <GradientStop Color="#EDE9FE" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <materialDesign:PackIcon Kind="PackageVariantClosed" Width="15" Height="15"
                                                                                 Foreground="#7C3AED"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="Articles" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource NavSubBtn}"
                                                    Command="{Binding NavigateToPageCommand}"
                                                    CommandParameter="Categories" Click="CloseDropdowns"
                                                    IsEnabled="{Binding CanAccessProducts}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="30" Height="30" CornerRadius="8"
                                                            Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#FDF2F8" Offset="0"/>
                                                                <GradientStop Color="#FCE7F3" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <materialDesign:PackIcon Kind="TagMultipleOutline" Width="15" Height="15"
                                                                                 Foreground="#DB2777"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="Catégories" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource NavSubBtn}"
                                                    Command="{Binding NavigateToPageCommand}"
                                                    CommandParameter="Clients" Click="CloseDropdowns"
                                                    IsEnabled="{Binding CanAccessClients}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="30" Height="30" CornerRadius="8"
                                                            Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#EFF6FF" Offset="0"/>
                                                                <GradientStop Color="#DBEAFE" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <materialDesign:PackIcon Kind="AccountGroupOutline" Width="15" Height="15"
                                                                                 Foreground="#2563EB"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="Clients" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource NavSubBtn}"
                                                    Command="{Binding NavigateToPageCommand}"
                                                    CommandParameter="Stock" Click="CloseDropdowns"
                                                    IsEnabled="{Binding CanAccessStock}">
                                                <StackPanel Orientation="Horizontal">
