                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">

                            <!--  Device status chip (glass)  -->
                            <Border Margin="0,0,14,0"
                                    Padding="12,6"
                                    CornerRadius="12"
                                    Cursor="Hand"
                                    ToolTip="{Binding DeviceStatus}">
                                <Border.Background>
                                    <SolidColorBrush Opacity="0.07"
                                                     Color="#FFFFFF" />
                                </Border.Background>
                                <Border.InputBindings>
                                    <MouseBinding Command="{Binding CheckDeviceStatusCommand}"
                                                  Gesture="LeftClick" />
                                </Border.InputBindings>
                                <StackPanel Orientation="Horizontal">
                                    <!--  Dot with pulse when online  -->
                                    <Grid Width="8"
                                          Height="8"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center">
                                        <Ellipse Width="8"
                                                 Height="8">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#10B981" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDeviceOnline}"
                                                                     Value="False">
                                                            <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>

                                    <!--  Label changes: online = short label, offline = "Hors ligne"  -->
                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding DeviceStatusShort}" />
                                                <Setter Property="Foreground" Value="#7D9DAE" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDeviceOnline}"
                                                                 Value="False">
                                                        <Setter Property="Text" Value="Hors ligne" />
                                                        <Setter Property="Foreground" Value="#F87171" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!--  Divider (gradient)  -->
                            <Border Width="1"
                                    Height="28"
                                    Margin="0,0,14,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#00FFFFFF" />
                                        <GradientStop Offset="0.5" Color="#20FFFFFF" />
                                        <GradientStop Offset="1" Color="#00FFFFFF" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!--  User dropdown  -->
                            <Grid>
                                <ToggleButton x:Name="UserDropdownBtn"
                                              Checked="OnDropdownOpened"
                                              Style="{StaticResource NavDropdownBtn}">
                                    <StackPanel Orientation="Horizontal">
                                        <!--  Gradient avatar  -->
                                        <Border Width="32"
                                                Height="32"
                                                Margin="0,0,10,0"
                                                Background="{StaticResource AvatarGradient}"
                                                CornerRadius="14">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="8"
                                                                  Direction="270"
                                                                  Opacity="0.15"
                                                                  ShadowDepth="1"
                                                                  Color="#1A8CBF" />
                                            </Border.Effect>
                                            <!--  Glass shine  -->
                                            <Border CornerRadius="14">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Offset="0" Color="#18FFFFFF" />
                                                        <GradientStop Offset="0.5" Color="#00FFFFFF" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"
                                                           Text="{Binding UserInitials}" />
                                            </Border>
                                        </Border>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="13"
                                                   Foreground="#8BAAB9"
                                                   Text="{Binding CurrentUserName}" />
                                        <materialDesign:PackIcon Width="16"
                                                                 Height="16"
                                                                 Margin="6,0,0,0"
                                                                 VerticalAlignment="Center"
                                                                 Kind="ChevronDown"
                                                                 Opacity="0.4" />
                                    </StackPanel>
                                </ToggleButton>
                                <Popup AllowsTransparency="True"
                                       HorizontalOffset="-4"
                                       IsOpen="{Binding IsChecked, ElementName=UserDropdownBtn, Mode=TwoWay}"
                                       Placement="Bottom"
                                       PlacementTarget="{Binding ElementName=UserDropdownBtn}"
                                       PopupAnimation="Fade"
                                       StaysOpen="False"
                                       VerticalOffset="8">
                                    <Border MinWidth="270"
                                            Padding="6"
                                            Background="{StaticResource PopupGradient}"
                                            BorderBrush="#E8F0F5"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Effect="{StaticResource PopupShadow}">
                                        <StackPanel>
                                            <!--  User info card  -->
                                            <Border Margin="2"
                                                    Padding="14,12"
                                                    CornerRadius="12">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Offset="0" Color="#F8FAFC" />
                                                        <GradientStop Offset="1" Color="#F1F5F9" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <!--  Mini avatar  -->
                                                    <Border Grid.Column="0"
                                                            Width="40"
                                                            Height="40"
                                                            Margin="0,0,14,0"
                                                            VerticalAlignment="Center"
                                                            Background="{StaticResource AvatarGradient}"
                                                            CornerRadius="16">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="8"
                                                                              Direction="270"
                                                                              Opacity="0.15"
                                                                              ShadowDepth="1"
                                                                              Color="#1A8CBF" />
                                                        </Border.Effect>
                                                        <Border CornerRadius="16">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Offset="0" Color="#18FFFFFF" />
                                                                    <GradientStop Offset="0.5" Color="#00FFFFFF" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                            <TextBlock HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontFamily="{StaticResource AppFont}"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="White"
                                                                       Text="{Binding UserInitials}" />
                                                        </Border>
                                                    </Border>
                                                    <StackPanel Grid.Column="1"
                                                                VerticalAlignment="Center">
                                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#0F172A"
                                                                   Text="{Binding CurrentUserName}" />
                                                        <TextBlock Margin="0,3,0,0"
                                                                   FontFamily="{StaticResource AppFont}"
                                                                   FontSize="12"
                                                                   Foreground="#475569">
                                                            <Run Text="{Binding CurrentRoleName, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Margin="0,2,0,0"
                                                                   FontFamily="{StaticResource AppFont}"
                                                                   FontSize="11"
                                                                   Foreground="#94A3B8">
                                                            <Run Text="{Binding CurrentPosCode, Mode=OneWay}" />
                                                            <Run Text=" · " />
                                                            <Run Text="{Binding CurrentPosCity, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Separator Style="{StaticResource PopupSep}" />

                                            <Button Click="CloseDropdowns"
                                                    Command="{Binding LogoutCommand}"
                                                    Style="{StaticResource NavSubBtnDanger}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="30"
                                                            Height="30"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center"
                                                            CornerRadius="8">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Offset="0" Color="#FEF2F2" />
                                                                <GradientStop Offset="1" Color="#FEE2E2" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <materialDesign:PackIcon Width="15"
                                                                                 Height="15"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="#EF4444"
                                                                                 Kind="LogoutVariant" />
                                                    </Border>
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontWeight="Medium"
                                                               Foreground="#EF4444"
                                                               Text="Déconnexion" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <!--  ── ACCENT LINE (multi-color gradient) ──  -->
            <Border Grid.Row="1"
                    Height="3"
                    Background="{StaticResource AccentLineGradient}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6"
                                      Opacity="0.25"
                                      ShadowDepth="0"
                                      Color="#3B82F6" />
                </Border.Effect>
            </Border>
        </Grid>
        <!--  ═══════════════ NOTIFICATION BANNER ═══════════════  -->
        <Border Grid.Row="1"
                Padding="16,10"
                Panel.ZIndex="10"
                Visibility="{Binding ShowNotificationBanner, Converter={StaticResource B2V}}">
            <Border.Style>
                <Style TargetType="Border">
                    <!--  Default: warning (amber)  -->
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#FEF3C7" />
                                <GradientStop Offset="1" Color="#FDE68A" />
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Tag" Value="#92400E" />
                    <Style.Triggers>
                        <!--  ERROR: red  -->
                        <DataTrigger Binding="{Binding NotificationType}"
                                     Value="error">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#FEE2E2" />
                                        <GradientStop Offset="1" Color="#FECACA" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Tag" Value="#991B1B" />
                        </DataTrigger>
                        <!--  INFO: blue  -->
                        <DataTrigger Binding="{Binding NotificationType}"
                                     Value="info">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#DBEAFE" />
                                        <GradientStop Offset="1" Color="#BFDBFE" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Tag" Value="#1E3A8A" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  ── Icon: changes per type ──  -->
                <materialDesign:PackIcon Grid.Column="0"
                                         Width="20"
                                         Height="20"
                                         Margin="0,0,12,0"
                                         VerticalAlignment="Center">
                    <materialDesign:PackIcon.Style>
                        <Style TargetType="materialDesign:PackIcon">
                            <Setter Property="Kind" Value="AlertCircleOutline" />
                            <Setter Property="Foreground" Value="#92400E" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NotificationType}"
                                             Value="error">
                                    <Setter Property="Kind" Value="AlertOctagonOutline" />
                                    <Setter Property="Foreground" Value="#991B1B" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NotificationType}"
                                             Value="info">
                                    <Setter Property="Kind" Value="InformationOutline" />
                                    <Setter Property="Foreground" Value="#1E3A8A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:PackIcon.Style>
                </materialDesign:PackIcon>

                <!--  ── Message text: color changes per type ──  -->
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="12.5"
                           Text="{Binding NotificationMessage}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#92400E" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NotificationType}"
                                             Value="error">
                                    <Setter Property="Foreground" Value="#991B1B" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NotificationType}"
                                             Value="info">
                                    <Setter Property="Foreground" Value="#1E3A8A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!--  ── Restart sync button (only for 7-day MCF warning) ──  -->
                <Button Grid.Column="2"
                        Margin="12,0,4,0"
                        Command="{Binding RestartMcfSyncCommand}"
                        Cursor="Hand"
                        Visibility="{Binding IsMcfDisconnectedWarning, Converter={StaticResource B2V}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBd"
                                    Padding="10,5"
                                    Background="#18000000"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBd" Property="Background" Value="#28000000" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="14"
                                                 Height="14"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Kind="Refresh">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Foreground" Value="#92400E" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NotificationType}"
                                                     Value="error">
                                            <Setter Property="Foreground" Value="#991B1B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="12"
                                   Text="Relancer">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#92400E" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NotificationType}"
                                                     Value="error">
                                            <Setter Property="Foreground" Value="#991B1B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <!--  ── Dismiss button ──  -->
                <Button Grid.Column="3"
                        Command="{Binding DismissNotificationCommand}"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CloseBd"
                                    Padding="6"
                                    Background="Transparent"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseBd" Property="Background" Value="#18000000" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <materialDesign:PackIcon Width="16"
                                             Height="16"
                                             Kind="Close">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Foreground" Value="#92400E" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NotificationType}"
                                                 Value="error">
                                        <Setter Property="Foreground" Value="#991B1B" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NotificationType}"
                                                 Value="info">
                                        <Setter Property="Foreground" Value="#1E3A8A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                </Button>
            </Grid>
        </Border>


        <!--  ═══════════════ PAGE CONTENT ═══════════════  -->
        <ContentControl Grid.Row="2"
                        Margin="0"
                        Content="{Binding CurrentPage}" />

        <!--  ═══════════════ PREMIUM FOOTER ═══════════════  -->
        <Border Grid.Row="3"
                Padding="22,10"
                Background="{StaticResource FooterGradient}">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="Transparent" />
                    <GradientStop Offset="0.15" Color="#E2E8F0" />
                    <GradientStop Offset="0.5" Color="#CBD5E1" />
                    <GradientStop Offset="0.85" Color="#E2E8F0" />
                    <GradientStop Offset="1" Color="Transparent" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>
                <Thickness Top="1" />
            </Border.BorderThickness>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Left: version  -->
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Border Width="22"
                            Height="22"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            CornerRadius="6">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#EFF6FF" />
                                <GradientStop Offset="1" Color="#DBEAFE" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <materialDesign:PackIcon Width="12"
                                                 Height="12"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Foreground="#2563EB"
                                                 Kind="CubeOutline" />
                    </Border>
                    <TextBlock VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="11"
                               Foreground="#94A3B8">
                        <Run Text="iKWOOK SFE v1.0.0" />
                        <Run Text=" — " />
                        <Run Text="Système de Facturation" />
                    </TextBlock>
                </StackPanel>

                <!--  Center: POS badge (gradient)  -->
                <Border Grid.Column="1"
                        Margin="16,0"
                        Padding="14,5"
                        CornerRadius="8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#EFF6FF" />
                            <GradientStop Offset="0.5" Color="#DBEAFE" />
                            <GradientStop Offset="1" Color="#EFF6FF" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6"
                                          Direction="270"
                                          Opacity="0.06"
                                          ShadowDepth="1"
                                          Color="#2563EB" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="13"
                                                 Height="13"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="#2563EB"
                                                 Kind="MapMarkerOutline" />
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#1E40AF">
                            <Run Text="{Binding CurrentPosCode, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding CurrentPosCity, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!--  Right: status + copyright  -->
                <StackPanel Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">

                    <!--  Online status chip — background changes with status  -->
                    <Border Margin="0,0,14,0"
                            Padding="8,3"
                            VerticalAlignment="Center"
                            CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <!--  Default: online (green tint)  -->
                                <Setter Property="Background" Value="#F0FDF4" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDeviceOnline}"
                                                 Value="False">
                                        <Setter Property="Background" Value="#FEF2F2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <!--  Pulsing dot for online, static red for offline  -->
                            <Grid Width="7"
                                  Height="7"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center">
                                <!--  Pulse ring (only visible when online)  -->
                                <Ellipse Width="7"
                                         Height="7"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Opacity="0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#10B981" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDeviceOnline}"
                                                             Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="0.6"
                                                                                 To="0"
                                                                                 Duration="0:0:2" />
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                 From="1"
                                                                                 To="2.5"
                                                                                 Duration="0:0:2" />
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                 From="1"
                                                                                 To="2.5"
                                                                                 Duration="0:0:2" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform CenterX="3.5" CenterY="3.5" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <!--  Solid dot  -->
                                <Ellipse Width="7"
                                         Height="7"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#10B981" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDeviceOnline}"
                                                             Value="False">
                                                    <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>

                            <TextBlock FontFamily="{StaticResource AppFont}"
                                       FontSize="11"
                                       Text="{Binding DeviceStatus}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#15803D" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeviceOnline}"
                                                         Value="False">
                                                <Setter Property="Foreground" Value="#DC2626" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBlock VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="11"
                               Foreground="#CBD5E1"
                               Text="© 2026 · Conforme DGI-RDC" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>