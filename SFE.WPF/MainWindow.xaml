<!-- File: SFE.WPF/MainWindow.xaml -->
<Window x:Class="SFE.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SFE.WPF.ViewModels"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        Title="GECOM2025" Height="768" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <!-- Convertisseur booléen → couleur pour l'indicateur de statut -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar -->
            <ColumnDefinition Width="260"/>
            <!-- Contenu principal -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════ SIDEBAR ═══════════════ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Logo/Header -->
                    <RowDefinition Height="*"/>
                    <!-- Navigation principale -->
                    <RowDefinition Height="Auto"/>
                    <!-- Navigation basse (Paramètres) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Info utilisateur -->
                </Grid.RowDefinitions>

                <!-- ── Logo et nom de l'app ── -->
                <Border Grid.Row="0" Padding="24,24,24,20">
                    <StackPanel Orientation="Horizontal">
                        <!-- Icône app -->
                        <Border Background="{StaticResource PrimaryBrush}"
                                CornerRadius="10" Width="40" Height="40"
                                Margin="0,0,14,0">
                            <TextBlock Text="G" Foreground="White"
                                       FontSize="20" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="GECOM25" Foreground="White"
                                       FontSize="20" FontWeight="Bold"
                                       FontFamily="{StaticResource AppFont}"/>
                            <TextBlock Text="v2.0 — RDC"
                                       Foreground="{StaticResource SidebarTextBrush}"
                                       FontSize="11"
                                       FontFamily="{StaticResource AppFont}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Navigation principale ── -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="12,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                CornerRadius="8"
                                                Padding="14,11"
                                                Margin="0,2"
                                                Cursor="Hand"
                                                Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background"
                                                        Value="{StaticResource SidebarHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background"
                                                        Value="{StaticResource SidebarActiveBgBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding IconGlyph}"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="18"
                                           Foreground="{StaticResource SidebarTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,14,0"
                                           Width="20" TextAlignment="Center"/>
                                <TextBlock Text="{Binding Label}"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="14"
                                           Foreground="{StaticResource SidebarTextBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- ── Navigation basse (Paramètres) ── -->
                <StackPanel Grid.Row="2" Margin="12,0,12,8">
                    <Separator Background="#334155" Margin="0,0,0,8"/>

                    <Button Command="{Binding NavigateToPageCommand}"
                            CommandParameter="Settings"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalContentAlignment="Left">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="8" Padding="14,11"
                                        Background="Transparent" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="18"
                                                   Foreground="{StaticResource SidebarTextBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,14,0" Width="20"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="Paramètres"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="14"
                                                   Foreground="{StaticResource SidebarTextBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="{StaticResource SidebarHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- ── Info utilisateur en bas ── -->
                <Border Grid.Row="3" Padding="18,16" Background="#0F172A">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar -->
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                                Background="{StaticResource PrimaryBrush}" Margin="0,0,12,0">
                            <TextBlock Text="A" Foreground="White" FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"/>
                        </Border>

                        <!-- Nom et POS -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUserName}" Foreground="White"
                                       FontSize="13" FontWeight="SemiBold"
                                       FontFamily="{StaticResource AppFont}"/>
                            <TextBlock Text="{Binding CurrentPosName}"
                                       Foreground="{StaticResource SidebarTextBrush}"
                                       FontSize="11"
                                       FontFamily="{StaticResource AppFont}"/>
                        </StackPanel>

                        <!-- Indicateur statut dispositif -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill"
                                                Value="{StaticResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeviceOnline}"
                                                         Value="False">
                                                <Setter Property="Fill"
                                                        Value="{StaticResource ErrorBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════ ZONE DE CONTENU PRINCIPALE ═══════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header bar -->
                <RowDefinition Height="*"/>
                <!-- Page content -->
            </Grid.RowDefinitions>

            <!-- ── Header bar ── -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    Padding="28,16" BorderThickness="0,0,0,1"
                    BorderBrush="{StaticResource BorderBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Statut du dispositif fiscal -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill"
                                            Value="{StaticResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDeviceOnline}"
                                                     Value="False">
                                            <Setter Property="Fill"
                                                    Value="{StaticResource ErrorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding DeviceStatus}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Date et heure -->
                    <TextBlock Grid.Column="1"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Text="{Binding Source={x:Static System:DateTime.Now},
                                      StringFormat='{}{0:dddd dd MMMM yyyy}'}"/>
                </Grid>
            </Border>

            <!-- ── Contenu de la page active ── -->
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentPage}"
                            Margin="0"/>
        </Grid>
    </Grid>
</Window>