<Window x:Class="SFE.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SFE.WPF.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        Title="iKWOOK SFE — Système de Facturation d'Entreprise"
        Height="800" Width="1300"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <!-- Drop shadow for popups -->
        <DropShadowEffect x:Key="DropShadow"
                          BlurRadius="20" ShadowDepth="4"
                          Opacity="0.18" Direction="270" Color="#000"/>

        <!-- ═══ NAV BUTTON (single top-level item) ═══ -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ NAV DROPDOWN TOGGLE ═══ -->
        <Style x:Key="NavDropdownBtn" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ DROPDOWN SUB-ITEM BUTTON ═══ -->
        <Style x:Key="NavSubBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="12,9">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ LOGOUT SUB-ITEM (red text) ═══ -->
        <Style x:Key="NavSubBtnDanger" TargetType="Button" BasedOn="{StaticResource NavSubBtn}">
            <Setter Property="Foreground" Value="#EF4444"/>
        </Style>
    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  MAIN LAYOUT: Navbar / Content / Footer                -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Top navbar -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ═══════════════ TOP NAVBAR ═══════════════ -->
        <Border Grid.Row="0" Background="#1E293B" Padding="0" Height="52">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Logo -->
                    <ColumnDefinition Width="*"/>
                    <!-- Nav items -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Right section -->
                </Grid.ColumnDefinitions>

                <!-- ── LOGO ── -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,28,0">
                    <Border Background="{StaticResource PrimaryBrush}"
                            CornerRadius="8" Width="120" Height="32" Margin="0,0,10,0">
                        <TextBlock Text="iKWOOK SFE" Foreground="White" FontSize="16"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource AppFont}"/>
                    </Border>
                    <!--<TextBlock Text="SFE" Foreground="White" FontSize="18"
                               FontWeight="Bold" VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFont}"/>
                    <TextBlock Text=" · " Foreground="#475569" FontSize="14"
                               VerticalAlignment="Center"/>-->
                    <!--<TextBlock Text="{Binding CompanyName}" Foreground="#94A3B8"
                               FontSize="18" VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFont}"/>-->
                </StackPanel>

                <!-- ── NAVIGATION ITEMS ── -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- ┌──────────────────────────────┐ -->
                    <!-- │  TABLEAU DE BORD (single)     │ -->
                    <!-- └──────────────────────────────┘ -->
                    <Button Style="{StaticResource NavBtn}"
                            Command="{Binding NavigateToPageCommand}"
                            CommandParameter="Dashboard"
                            Visibility="{Binding CanAccessDashboard, Converter={StaticResource B2V}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}"
                                       FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tableau de bord" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- ┌──────────────────────────────┐ -->
                    <!-- │  VENTES (dropdown)            │ -->
                    <!-- └──────────────────────────────┘ -->
                    <Grid Visibility="{Binding CanSeeVentes, Converter={StaticResource B2V}}">
                        <ToggleButton x:Name="VentesDropdownBtn"
                                      Style="{StaticResource NavDropdownBtn}"
                                      Checked="OnDropdownOpened">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C7;" FontFamily="{StaticResource IconFont}"
                                           FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Ventes" VerticalAlignment="Center"/>
                                <TextBlock Text="  ▾" FontSize="9" VerticalAlignment="Center"
                                           Foreground="#64748B"/>
                            </StackPanel>
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsChecked, ElementName=VentesDropdownBtn, Mode=TwoWay}"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                               PlacementTarget="{Binding ElementName=VentesDropdownBtn}"
                               Placement="Bottom" HorizontalOffset="-4" VerticalOffset="4">
                            <Border Background="White" CornerRadius="10" Padding="6"
                                    MinWidth="220" Effect="{StaticResource DropShadow}">
                                <StackPanel>
                                    <Button Style="{StaticResource NavSubBtn}"
                                            Command="{Binding NavigateToPageCommand}"
                                            CommandParameter="Cash" Click="CloseDropdowns"
                                            Visibility="{Binding CanAccessPos, Converter={StaticResource B2V}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8C7;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="14" Width="22" Foreground="#64748B"/>
                                            <TextBlock Text="Caisse (POS)" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource NavSubBtn}"
                                            Command="{Binding NavigateToPageCommand}"
                                            CommandParameter="Invoicing" Click="CloseDropdowns"
                                            Visibility="{Binding CanAccessInvoicing, Converter={StaticResource B2V}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="14" Width="22" Foreground="#64748B"/>
                                            <TextBlock Text="Facturation" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource NavSubBtn}"
                                            Command="{Binding NavigateToPageCommand}"
                                            CommandParameter="Clients" Click="CloseDropdowns"
                                            Visibility="{Binding CanAccessClients, Converter={StaticResource B2V}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="14" Width="22" Foreground="#64748B"/>
                                            <TextBlock Text="Clients" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Separator Background="#E2E8F0" Margin="6,4"
                                               Visibility="{Binding CanAccessSalesHistory, Converter={StaticResource B2V}}"/>
                                    <Button Style="{StaticResource NavSubBtn}"
                                            Command="{Binding NavigateToPageCommand}"
                                            CommandParameter="SalesHistory" Click="CloseDropdowns"
                                            Visibility="{Binding CanAccessSalesHistory, Converter={StaticResource B2V}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="14" Width="22" Foreground="#64748B"/>
                                            <TextBlock Text="Journal des ventes" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- ┌──────────────────────────────┐ -->
                    <!-- │  GESTION (dropdown)           │ -->
                    <!-- └──────────────────────────────┘ -->
                    <Grid Visibility="{Binding CanSeeGestion, Converter={StaticResource B2V}}">
                        <ToggleButton x:Name="GestionDropdownBtn"
                                      Style="{StaticResource NavDropdownBtn}"
                                      Checked="OnDropdownOpened">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74C;" FontFamily="{StaticResource IconFont}"
                                           FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Gestion" VerticalAlignment="Center"/>
                                <TextBlock Text="  ▾" FontSize="9" VerticalAlignment="Center"
                                           Foreground="#64748B"/>
                            </StackPanel>
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsChecked, ElementName=GestionDropdownBtn, Mode=TwoWay}"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                               PlacementTarget="{Binding ElementName=GestionDropdownBtn}"
                               Placement="Bottom" HorizontalOffset="-4" VerticalOffset="4">
                            <Border Background="White" CornerRadius="10" Padding="6"
                                    MinWidth="220" Effect="{StaticResource DropShadow}">
                                <StackPanel>
                                    <Button Style="{StaticResource NavSubBtn}"
                                            Command="{Binding NavigateToPageCommand}"
                                            CommandParameter="Products" Click="CloseDropdowns"
                                            Visibility="{Binding CanAccessProducts, Converter={StaticResource B2V}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE719;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="14" Width="22" Foreground="#64748B"/>
                                            <TextBlock Text="Produits" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource NavSubBtn}"
                                            Command="{Binding NavigateToPageCommand}"
                                            CommandParameter="Stock" Click="CloseDropdowns"
                                            Visibility="{Binding CanAccessStock, Converter={StaticResource B2V}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74C;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="14" Width="22" Foreground="#64748B"/>
                                            <TextBlock Text="Stock" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource NavSubBtn}"
                                            Command="{Binding NavigateToPageCommand}"
                                            CommandParameter="StockTransfer" Click="CloseDropdowns"
                                            Visibility="{Binding CanAccessTransfers, Converter={StaticResource B2V}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="14" Width="22" Foreground="#64748B"/>
                                            <TextBlock Text="Transferts" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Separator Background="#E2E8F0" Margin="6,4"
                                               Visibility="{Binding CanAccessLoyalty, Converter={StaticResource B2V}}"/>
                                    <Button Style="{StaticResource NavSubBtn}"
                                            Command="{Binding NavigateToPageCommand}"
                                            CommandParameter="Loyalty" Click="CloseDropdowns"
                                            Visibility="{Binding CanAccessLoyalty, Converter={StaticResource B2V}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEB51;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="14" Width="22" Foreground="#64748B"/>
                                            <TextBlock Text="Fidélité" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- ┌──────────────────────────────┐ -->
                    <!-- │  RAPPORTS (dropdown)          │ -->
                    <!-- └──────────────────────────────┘ -->
                    <Grid Visibility="{Binding CanSeeRapports, Converter={StaticResource B2V}}">
                        <ToggleButton x:Name="RapportsDropdownBtn"
                                      Style="{StaticResource NavDropdownBtn}"
                                      Checked="OnDropdownOpened">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9F9;" FontFamily="{StaticResource IconFont}"
                                           FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Rapports" VerticalAlignment="Center"/>
                                <TextBlock Text="  ▾" FontSize="9" VerticalAlignment="Center"
                                           Foreground="#64748B"/>
                            </StackPanel>
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsChecked, ElementName=RapportsDropdownBtn, Mode=TwoWay}"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                               PlacementTarget="{Binding ElementName=RapportsDropdownBtn}"
                               Placement="Bottom" HorizontalOffset="-4" VerticalOffset="4">
                            <Border Background="White" CornerRadius="10" Padding="6"
                                    MinWidth="220" Effect="{StaticResource DropShadow}">
                                <StackPanel>
                                    <Button Style="{StaticResource NavSubBtn}"
                                            Command="{Binding NavigateToPageCommand}"
                                            CommandParameter="Reports" Click="CloseDropdowns">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE9F9;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="14" Width="22" Foreground="#64748B"/>
                                            <TextBlock Text="Rapports DGI (X, Z, A)" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- ┌──────────────────────────────┐ -->
                    <!-- │  ADMINISTRATION (dropdown)    │ -->
                    <!-- └──────────────────────────────┘ -->
                    <Grid Visibility="{Binding CanSeeAdmin, Converter={StaticResource B2V}}">
                        <ToggleButton x:Name="AdminDropdownBtn"
                                      Style="{StaticResource NavDropdownBtn}"
                                      Checked="OnDropdownOpened">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}"
                                           FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Admin" VerticalAlignment="Center"/>
                                <TextBlock Text="  ▾" FontSize="9" VerticalAlignment="Center"
                                           Foreground="#64748B"/>
                            </StackPanel>
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsChecked, ElementName=AdminDropdownBtn, Mode=TwoWay}"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                               PlacementTarget="{Binding ElementName=AdminDropdownBtn}"
                               Placement="Bottom" HorizontalOffset="-4" VerticalOffset="4">
                            <Border Background="White" CornerRadius="10" Padding="6"
                                    MinWidth="220" Effect="{StaticResource DropShadow}">
                                <StackPanel>
                                    <Button Style="{StaticResource NavSubBtn}"
                                            Command="{Binding NavigateToPageCommand}"
                                            CommandParameter="Settings" Click="CloseDropdowns"
                                            Visibility="{Binding CanAccessSettings, Converter={StaticResource B2V}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="14" Width="22" Foreground="#64748B"/>
                                            <TextBlock Text="Paramètres" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource NavSubBtn}"
                                            Command="{Binding NavigateToPageCommand}"
                                            CommandParameter="Users" Click="CloseDropdowns"
                                            Visibility="{Binding CanAccessUsers, Converter={StaticResource B2V}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="14" Width="22" Foreground="#64748B"/>
                                            <TextBlock Text="Utilisateurs" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <!-- ── RIGHT SECTION: Status + User ── -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- MCF Status indicator -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                 VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDeviceOnline}" Value="False">
                                            <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding DeviceStatusShort}" Foreground="#94A3B8"
                                   FontSize="12" VerticalAlignment="Center"
                                   FontFamily="{StaticResource AppFont}"/>
                    </StackPanel>

                    <!-- Separator -->
                    <Border Width="1" Height="24" Background="#334155" Margin="0,0,16,0"/>

                    <!-- User dropdown -->
                    <Grid>
                        <ToggleButton x:Name="UserDropdownBtn"
                                      Style="{StaticResource NavDropdownBtn}"
                                      Checked="OnDropdownOpened">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{StaticResource PrimaryBrush}"
                                        CornerRadius="14" Width="28" Height="28"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="{Binding UserInitials}"
                                               Foreground="White" FontSize="11"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}"/>
                                </Border>
                                <TextBlock Text="{Binding CurrentUserName}"
                                           Foreground="#CBD5E1" FontSize="13"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}"/>
                                <TextBlock Text="  ▾" FontSize="9"
                                           Foreground="#64748B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsChecked, ElementName=UserDropdownBtn, Mode=TwoWay}"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                               PlacementTarget="{Binding ElementName=UserDropdownBtn}"
                               Placement="Bottom" HorizontalOffset="-4" VerticalOffset="4">
                            <Border Background="White" CornerRadius="10" Padding="6"
                                    MinWidth="240" Effect="{StaticResource DropShadow}">
                                <StackPanel>
                                    <!-- User info header -->
                                    <Border Padding="12,10" Margin="0,0,0,4">
                                        <StackPanel>
                                            <TextBlock Text="{Binding CurrentUserName}"
                                                       FontWeight="SemiBold" FontSize="14"
                                                       Foreground="#0F172A"
                                                       FontFamily="{StaticResource AppFont}"/>
                                            <TextBlock FontSize="12" Foreground="#64748B"
                                                       Margin="0,2,0,0"
                                                       FontFamily="{StaticResource AppFont}">
                                                <Run Text="{Binding CurrentRoleName, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="#94A3B8"
                                                       Margin="0,2,0,0"
                                                       FontFamily="{StaticResource AppFont}">
                                                <Run Text="{Binding CurrentPosCode, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding CurrentPosCity, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <Separator Background="#E2E8F0" Margin="6,0,6,4"/>
                                    <!-- Logout -->
                                    <Button Style="{StaticResource NavSubBtnDanger}"
                                            Command="{Binding LogoutCommand}"
                                            Click="CloseDropdowns">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="14" Width="22" Foreground="#EF4444"/>
                                            <TextBlock Text="Déconnexion" Margin="8,0,0,0"
                                                       Foreground="#EF4444"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════ PAGE CONTENT ═══════════════ -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Margin="0"/>

        <!-- ═══════════════ FOOTER ═══════════════ -->
        <Border Grid.Row="2" Background="#F8FAFC" Padding="20,8"
                BorderThickness="0,1,0,0" BorderBrush="#E2E8F0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: App info -->
                <TextBlock Grid.Column="0" FontSize="11" Foreground="#94A3B8"
                           VerticalAlignment="Center" FontFamily="{StaticResource AppFont}">
                    <Run Text="iKWOOK SFE v2.0"/>
                    <Run Text=" — "/>
                    <Run Text="Système de Facturation d'Entreprise"/>
                </TextBlock>

                <!-- Center: POS info -->
                <Border Grid.Column="1" Background="#EFF6FF" CornerRadius="4"
                        Padding="10,3" Margin="16,0">
                    <TextBlock FontSize="11" Foreground="#3B82F6"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFont}">
                        <Run Text="{Binding CurrentPosCode, Mode=OneWay}"/>
                        <Run Text=" · "/>
                        <Run Text="{Binding CurrentPosCity, Mode=OneWay}"/>
                    </TextBlock>
                </Border>

                <!-- Right: MCF status + copyright -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Margin="0,0,5,0"
                             VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDeviceOnline}" Value="False">
                                        <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding DeviceStatus}" FontSize="11"
                               Foreground="#64748B" Margin="0,0,20,0"
                               FontFamily="{StaticResource AppFont}"/>
                    <TextBlock Text="© 2026 · Conforme DGI-RDC" FontSize="11"
                               Foreground="#CBD5E1"
                               FontFamily="{StaticResource AppFont}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>