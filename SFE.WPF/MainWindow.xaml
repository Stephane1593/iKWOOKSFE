<Window x:Class="SFE.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SFE.WPF.ViewModels"
        Title="iKWOOK SFE — Système de Facturation d'Entreprise"
        Width="1300"
        Height="800"
        MinWidth="1000"
        MinHeight="600"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel,
                                         IsDesignTimeCreatable=False}"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />

        <!--  ═══ Gradient Brushes ═══  -->
        <LinearGradientBrush x:Key="NavbarGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#0A1E2E" />
            <GradientStop Offset="0.3" Color="#0D2B3E" />
            <GradientStop Offset="0.7" Color="#102F45" />
            <GradientStop Offset="1" Color="#0E2939" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="NavbarGlassOverlay" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#0AFFFFFF" />
            <GradientStop Offset="0.5" Color="#04FFFFFF" />
            <GradientStop Offset="1" Color="#00FFFFFF" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LogoGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#37B1E4" />
            <GradientStop Offset="0.5" Color="#2196D4" />
            <GradientStop Offset="1" Color="#1A8CBF" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentLineGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#1A8CBF" />
            <GradientStop Offset="0.25" Color="#37B1E4" />
            <GradientStop Offset="0.5" Color="#3B82F6" />
            <GradientStop Offset="0.75" Color="#8B5CF6" />
            <GradientStop Offset="1" Color="#3B82F6" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AvatarGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#37B1E4" />
            <GradientStop Offset="0.5" Color="#2196D4" />
            <GradientStop Offset="1" Color="#1A8CBF" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PopupGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FFFFFF" />
            <GradientStop Offset="0.5" Color="#FCFDFE" />
            <GradientStop Offset="1" Color="#F8FAFC" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FFFFFF" />
            <GradientStop Offset="0.4" Color="#FAFBFD" />
            <GradientStop Offset="1" Color="#F5F7FA" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterSeparator" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="Transparent" />
            <GradientStop Offset="0.15" Color="#E2E8F0" />
            <GradientStop Offset="0.5" Color="#CBD5E1" />
            <GradientStop Offset="0.85" Color="#E2E8F0" />
            <GradientStop Offset="1" Color="Transparent" />
        </LinearGradientBrush>

        <!--  ═══ Premium popup shadow ═══  -->
        <DropShadowEffect x:Key="PopupShadow"
                          BlurRadius="36"
                          Direction="270"
                          Opacity="0.14"
                          ShadowDepth="8"
                          Color="#0D2B3E" />

        <DropShadowEffect x:Key="NavbarShadow"
                          BlurRadius="20"
                          Direction="270"
                          Opacity="0.22"
                          ShadowDepth="4"
                          Color="#000" />

        <!--  ══════════════════════════════════════════════════  -->
        <!--  NAV BUTTON  (smooth glow hover)  -->
        <!--  ══════════════════════════════════════════════════  -->
        <Style x:Key="NavBtn"
               TargetType="Button">
            <Setter Property="Foreground" Value="#8BAAB9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Padding="14,10"
                                CornerRadius="10">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg"
                                                 Color="#00FFFFFF" />
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#14FFFFFF"
                                                        Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#00FFFFFF"
                                                        Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.3" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ══════════════════════════════════════════════════  -->
        <!--  NAV DROPDOWN TOGGLE  (glass hover + checked)  -->
        <!--  ══════════════════════════════════════════════════  -->
        <Style x:Key="NavDropdownBtn"
               TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#8BAAB9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Padding="14,10"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1CFFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.3" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ══════════════════════════════════════════════════  -->
        <!--  DROPDOWN SUB-ITEM  (gradient hover)  -->
        <!--  ══════════════════════════════════════════════════  -->
        <Style x:Key="NavSubBtn"
               TargetType="Button">
            <Setter Property="Foreground" Value="#1E3A4F" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Padding="12,10"
                                CornerRadius="10">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg"
                                                 Color="#00E1F3FB" />
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#EFF6FF"
                                                        Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#00E1F3FB"
                                                        Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ══════════════════════════════════════════════════  -->
        <!--  DANGER SUB-ITEM  (red glow hover)  -->
        <!--  ══════════════════════════════════════════════════  -->
        <Style x:Key="NavSubBtnDanger"
               TargetType="Button">
            <Setter Property="Foreground" Value="#EF4444" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Padding="12,10"
                                CornerRadius="10">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg"
                                                 Color="#00FEE2E2" />
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#FEF2F2"
                                                        Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#00FEE2E2"
                                                        Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ═══ Warning sub-item (gold hover for Rapport Z) ═══  -->
        <Style x:Key="NavSubBtnWarning"
               TargetType="Button">
            <Setter Property="Foreground" Value="#92400E" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Padding="12,10"
                                CornerRadius="10">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg"
                                                 Color="#00FEF3C7" />
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#FFFBEB"
                                                        Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#00FEF3C7"
                                                        Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ═══ DROPDOWN SECTION HEADER ═══  -->
        <Style x:Key="NavSectionHeader"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="Margin" Value="14,10,14,6" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        </Style>

        <!--  ═══ Popup separator ═══  -->
        <Style x:Key="PopupSep"
               TargetType="Separator">
            <Setter Property="Margin" Value="10,6" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="Transparent" />
                        <GradientStop Offset="0.15" Color="#E2E8F0" />
                        <GradientStop Offset="0.85" Color="#E2E8F0" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!--  ═══════════════════════════════════════════════════════  -->
    <!--  MAIN LAYOUT  -->
    <!--  ═══════════════════════════════════════════════════════  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  Navbar  -->
            <RowDefinition Height="Auto" />
            <!--  Notification banner  -->
            <RowDefinition Height="*" />
            <!--  Content  -->
            <RowDefinition Height="Auto" />
            <!--  Footer  -->
        </Grid.RowDefinitions>

        <!--  ═══════════════════════════════════════════════════  -->
        <!--  TOP NAVBAR  +  ACCENT LINE  -->
        <!--  ═══════════════════════════════════════════════════  -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ── NAVBAR BAR ──  -->
            <Border Grid.Row="0"
                    Background="{StaticResource NavbarGradient}"
                    Effect="{StaticResource NavbarShadow}">
                <!--  Glass overlay layer  -->
                <Border Background="{StaticResource NavbarGlassOverlay}">
                    <Grid Margin="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  ── LOGO ──  -->
                        <StackPanel Grid.Column="0"
                                    Margin="0,0,28,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Border Width="136"
                                    Height="38"
                                    Background="{StaticResource LogoGradient}"
                                    CornerRadius="10">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14"
                                                      Direction="270"
                                                      Opacity="0.2"
                                                      ShadowDepth="2"
                                                      Color="#1A8CBF" />
                                </Border.Effect>
                                <!--  Inner glass shine  -->
                                <Border CornerRadius="10">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0" Color="#20FFFFFF" />
                                            <GradientStop Offset="0.5" Color="#00FFFFFF" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="18"
                                                                 Height="18"
                                                                 Margin="0,0,7,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="White"
                                                                 Kind="CubeOutline" />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   Text="iKWOOK SFE" />
                                    </StackPanel>
                                </Border>
                            </Border>
                        </StackPanel>

                        <!--  ══════════════════════════════════════  -->
                        <!--  NAVIGATION ITEMS  -->
                        <!--  ══════════════════════════════════════  -->
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">

                            <!--  ┌─ TABLEAU DE BORD ─┐  -->
                            <Button Command="{Binding NavigateToPageCommand}"
                                    CommandParameter="Dashboard"
                                    IsEnabled="{Binding CanAccessDashboard}"
                                    Style="{StaticResource NavBtn}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="18"
                                                             Height="18"
                                                             Margin="0,0,8,0"
                                                             VerticalAlignment="Center"
                                                             Kind="ViewDashboard" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Tableau de bord" />
                                </StackPanel>
                            </Button>

                            <!--  ┌─ FICHIER ─┐  -->
                            <Grid>
                                <ToggleButton x:Name="FichierDropdownBtn"
                                              Checked="OnDropdownOpened"
                                              IsEnabled="{Binding CanSeeFichier}"
                                              Style="{StaticResource NavDropdownBtn}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="18"
                                                                 Height="18"
                                                                 Margin="0,0,8,0"
                                                                 VerticalAlignment="Center"
                                                                 Kind="FolderOutline" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="Fichier" />
                                        <materialDesign:PackIcon Width="16"
                                                                 Height="16"
                                                                 Margin="4,0,0,0"
                                                                 VerticalAlignment="Center"
                                                                 Kind="ChevronDown"
                                                                 Opacity="0.45" />
                                    </StackPanel>
                                </ToggleButton>
                                <Popup AllowsTransparency="True"
                                       HorizontalOffset="-4"
                                       IsOpen="{Binding IsChecked, ElementName=FichierDropdownBtn, Mode=TwoWay}"
                                       Placement="Bottom"
                                       PlacementTarget="{Binding ElementName=FichierDropdownBtn}"
                                       PopupAnimation="Fade"
                                       StaysOpen="False"
                                       VerticalOffset="8">
                                    <Border MinWidth="240"
                                            Padding="6"
                                            Background="{StaticResource PopupGradient}"
                                            BorderBrush="#E8F0F5"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Effect="{StaticResource PopupShadow}">
                                        <StackPanel>

                                            <!--  ═══ Caisse ═══  -->
                                            <Button Click="CloseDropdowns"
                                                    Command="{Binding NavigateToPageCommand}"
                                                    CommandParameter="Cash"
                                                    IsEnabled="{Binding CanAccessPos}"
                                                    Style="{StaticResource NavSubBtn}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="32"
                                                            Height="32"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center"
                                                            CornerRadius="8">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Offset="0" Color="#ECFDF5" />
                                                                <GradientStop Offset="1" Color="#D1FAE5" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <materialDesign:PackIcon Width="16"
                                                                                 Height="16"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="#059669"
                                                                                 Kind="CashRegister" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock FontWeight="Medium"
                                                                   Text="Caisse" />
                                                        <TextBlock FontSize="10"
                                                                   Foreground="#94A3B8"
                                                                   Text="Point de vente" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>

                                            <!--  ═══ Facture ═══  -->
                                            <Button Click="CloseDropdowns"
                                                    Command="{Binding NavigateToPageCommand}"
                                                    CommandParameter="Invoicing"
                                                    IsEnabled="{Binding CanAccessInvoicing}"
                                                    Style="{StaticResource NavSubBtn}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="32"
                                                            Height="32"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center"
                                                            CornerRadius="8">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Offset="0" Color="#EFF6FF" />
                                                                <GradientStop Offset="1" Color="#DBEAFE" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <materialDesign:PackIcon Width="16"
                                                                                 Height="16"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="#2563EB"
                                                                                 Kind="ReceiptTextOutline" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock FontWeight="Medium"
                                                                   Text="Facture" />
                                                        <TextBlock FontSize="10"
                                                                   Foreground="#94A3B8"
                                                                   Text="Créer une facture" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>

                                            <!--  🆕 Séparateur  -->
                                            <Border Height="1"
                                                    Margin="8,4"
                                                    Background="#E5E7EB" />

                                            <!--  🆕 ═══ Facturation en masse ═══  -->
                                            <Button Click="CloseDropdowns"
                                                    Command="{Binding NavigateToPageCommand}"
                                                    CommandParameter="BulkInvoicing"
                                                    IsEnabled="{Binding CanAccessBulkInvoicing}"
                                                    Style="{StaticResource NavSubBtn}"
                                                    ToolTip="Importer et facturer plusieurs clients depuis un fichier Excel">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="32"
                                                            Height="32"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center"
                                                            CornerRadius="8">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Offset="0" Color="#F5F3FF" />
                                                                <GradientStop Offset="1" Color="#EDE9FE" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <materialDesign:PackIcon Width="16"
                                                                                 Height="16"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="#7C3AED"
                                                                                 Kind="FileExcelBoxOutline" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontWeight="Medium"
                                                                       Text="Facturation en masse" />
                                                            <Border Margin="8,0,0,0"
                                                                    Padding="5,1"
                                                                    VerticalAlignment="Center"
                                                                    Background="#EDE9FE"
                                                                    CornerRadius="4">
                                                                <TextBlock FontSize="9"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#7C3AED"
                                                                           Text="EXCEL" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock FontSize="10"
                                                                   Foreground="#94A3B8"
                                                                   Text="Import multi-clients" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>

                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>

                            <!--  ┌─ ÉDITER ─┐  -->
                            <Grid>
                                <ToggleButton x:Name="EditerDropdownBtn"
                                              Checked="OnDropdownOpened"
                                              IsEnabled="{Binding CanSeeEditer}"
                                              Style="{StaticResource NavDropdownBtn}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="18"
                                                                 Height="18"
                                                                 Margin="0,0,8,0"
                                                                 VerticalAlignment="Center"
                                                                 Kind="PencilOutline" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="Éditer" />
                                        <materialDesign:PackIcon Width="16"
                                                                 Height="16"
                                                                 Margin="4,0,0,0"
                                                                 VerticalAlignment="Center"
                                                                 Kind="ChevronDown"
