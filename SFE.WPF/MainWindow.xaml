                        <!-- ══════════════════════════════════════ -->
                        <!--  RIGHT: Status  ·  User               -->
                        <!-- ══════════════════════════════════════ -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <!-- Device status chip (glass) -->
                            <Border CornerRadius="12" Padding="12,6" Margin="0,0,14,0"
        Cursor="Hand"
        ToolTip="{Binding DeviceStatus}">
                                <Border.Background>
                                    <SolidColorBrush Color="#FFFFFF" Opacity="0.07"/>
                                </Border.Background>
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding CheckDeviceStatusCommand}"/>
                                </Border.InputBindings>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Dot with pulse when online -->
                                    <Grid Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#10B981"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDeviceOnline}" Value="False">
                                                            <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>

                                    <!-- Label changes: online = short label, offline = "Hors ligne" -->
                                    <TextBlock FontSize="11" VerticalAlignment="Center"
                   FontFamily="{StaticResource AppFont}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding DeviceStatusShort}"/>
                                                <Setter Property="Foreground" Value="#7D9DAE"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDeviceOnline}" Value="False">
                                                        <Setter Property="Text" Value="Hors ligne"/>
                                                        <Setter Property="Foreground" Value="#F87171"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Divider (gradient) -->
                            <Border Width="1" Height="28" Margin="0,0,14,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                                        <GradientStop Color="#20FFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- User dropdown -->
                            <Grid>
                                <ToggleButton x:Name="UserDropdownBtn"
                                              Style="{StaticResource NavDropdownBtn}"
                                              Checked="OnDropdownOpened">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Gradient avatar -->
                                        <Border CornerRadius="14" Width="32" Height="32"
                                                Margin="0,0,10,0"
                                                Background="{StaticResource AvatarGradient}">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="8" ShadowDepth="1"
                                                                  Opacity="0.15" Direction="270"
                                                                  Color="#1A8CBF"/>
                                            </Border.Effect>
                                            <!-- Glass shine -->
                                            <Border CornerRadius="14">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#18FFFFFF" Offset="0"/>
                                                        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="{Binding UserInitials}"
                                                           Foreground="White" FontSize="11"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{StaticResource AppFont}"/>
                                            </Border>
                                        </Border>
                                        <TextBlock Text="{Binding CurrentUserName}"
                                                   Foreground="#8BAAB9" FontSize="13"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"/>
                                        <materialDesign:PackIcon Kind="ChevronDown" Width="16" Height="16"
                                                                 Margin="6,0,0,0" VerticalAlignment="Center"
                                                                 Opacity="0.4"/>
                                    </StackPanel>
                                </ToggleButton>
                                <Popup IsOpen="{Binding IsChecked, ElementName=UserDropdownBtn, Mode=TwoWay}"
                                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                                       PlacementTarget="{Binding ElementName=UserDropdownBtn}"
                                       Placement="Bottom" HorizontalOffset="-4" VerticalOffset="8">
                                    <Border Background="{StaticResource PopupGradient}"
                                            CornerRadius="14" Padding="6"
                                            MinWidth="270" BorderBrush="#E8F0F5" BorderThickness="1"
                                            Effect="{StaticResource PopupShadow}">
                                        <StackPanel>
                                            <!-- User info card -->
                                            <Border Padding="14,12" Margin="2" CornerRadius="12">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#F8FAFC" Offset="0"/>
                                                        <GradientStop Color="#F1F5F9" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Mini avatar -->
                                                    <Border Grid.Column="0" CornerRadius="16"
                                                            Width="40" Height="40" Margin="0,0,14,0"
                                                            VerticalAlignment="Center"
                                                            Background="{StaticResource AvatarGradient}">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="8" ShadowDepth="1"
                                                                              Opacity="0.15" Direction="270"
                                                                              Color="#1A8CBF"/>
                                                        </Border.Effect>
                                                        <Border CornerRadius="16">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#18FFFFFF" Offset="0"/>
                                                                    <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                            <TextBlock Text="{Binding UserInitials}"
                                                                       Foreground="White" FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontFamily="{StaticResource AppFont}"/>
                                                        </Border>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CurrentUserName}"
                                                                   FontWeight="SemiBold" FontSize="14"
                                                                   Foreground="#0F172A"
                                                                   FontFamily="{StaticResource AppFont}"/>
                                                        <TextBlock FontSize="12" Foreground="#475569"
                                                                   Margin="0,3,0,0"
                                                                   FontFamily="{StaticResource AppFont}">
                                                            <Run Text="{Binding CurrentRoleName, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock FontSize="11" Foreground="#94A3B8"
                                                                   Margin="0,2,0,0"
                                                                   FontFamily="{StaticResource AppFont}">
                                                            <Run Text="{Binding CurrentPosCode, Mode=OneWay}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding CurrentPosCity, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Separator Style="{StaticResource PopupSep}"/>

                                            <Button Style="{StaticResource NavSubBtnDanger}"
                                                    Command="{Binding LogoutCommand}"
                                                    Click="CloseDropdowns">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="30" Height="30" CornerRadius="8"
                                                            Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#FEF2F2" Offset="0"/>
                                                                <GradientStop Color="#FEE2E2" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <materialDesign:PackIcon Kind="LogoutVariant" Width="15" Height="15"
                                                                                 Foreground="#EF4444"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="Déconnexion" Foreground="#EF4444"
                                                               FontWeight="Medium" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <!-- ── ACCENT LINE (multi-color gradient) ── -->
            <Border Grid.Row="1" Height="3"
                    Background="{StaticResource AccentLineGradient}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="0"
                                      Opacity="0.25" Color="#3B82F6"/>
                </Border.Effect>
            </Border>
        </Grid>
        <!-- ═══════════════ NOTIFICATION BANNER ═══════════════ -->
        <Border Grid.Row="1" Panel.ZIndex="10"
        Visibility="{Binding ShowNotificationBanner, Converter={StaticResource B2V}}"
        Padding="16,10">
            <Border.Style>
                <Style TargetType="Border">
                    <!-- Default: warning (amber) -->
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FEF3C7" Offset="0"/>
                                <GradientStop Color="#FDE68A" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Tag" Value="#92400E"/>
                    <Style.Triggers>
                        <!-- ERROR: red -->
                        <DataTrigger Binding="{Binding NotificationType}" Value="error">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FEE2E2" Offset="0"/>
                                        <GradientStop Color="#FECACA" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Tag" Value="#991B1B"/>
                        </DataTrigger>
                        <!-- INFO: blue -->
                        <DataTrigger Binding="{Binding NotificationType}" Value="info">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#DBEAFE" Offset="0"/>
                                        <GradientStop Color="#BFDBFE" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Tag" Value="#1E3A8A"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ── Icon: changes per type ── -->
                <materialDesign:PackIcon Grid.Column="0" Width="20" Height="20"
                                 Margin="0,0,12,0" VerticalAlignment="Center">
                    <materialDesign:PackIcon.Style>
                        <Style TargetType="materialDesign:PackIcon">
                            <Setter Property="Kind" Value="AlertCircleOutline"/>
                            <Setter Property="Foreground" Value="#92400E"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NotificationType}" Value="error">
                                    <Setter Property="Kind" Value="AlertOctagonOutline"/>
                                    <Setter Property="Foreground" Value="#991B1B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NotificationType}" Value="info">
                                    <Setter Property="Kind" Value="InformationOutline"/>
                                    <Setter Property="Foreground" Value="#1E3A8A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:PackIcon.Style>
                </materialDesign:PackIcon>

                <!-- ── Message text: color changes per type ── -->
                <TextBlock Grid.Column="1" Text="{Binding NotificationMessage}"
                   TextWrapping="Wrap" FontFamily="{StaticResource AppFont}"
                   FontSize="12.5" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#92400E"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NotificationType}" Value="error">
                                    <Setter Property="Foreground" Value="#991B1B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NotificationType}" Value="info">
                                    <Setter Property="Foreground" Value="#1E3A8A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- ── Restart sync button (only for 7-day MCF warning) ── -->
                <Button Grid.Column="2" Margin="12,0,4,0" Cursor="Hand"
                Command="{Binding RestartMcfSyncCommand}"
                Visibility="{Binding IsMcfDisconnectedWarning, Converter={StaticResource B2V}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBd" CornerRadius="8" Padding="10,5"
                            Background="#18000000">
                                <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBd" Property="Background" Value="#28000000"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14"
                                         Margin="0,0,6,0" VerticalAlignment="Center">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Foreground" Value="#92400E"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NotificationType}" Value="error">
                                            <Setter Property="Foreground" Value="#991B1B"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                        <TextBlock Text="Relancer" FontSize="12" VerticalAlignment="Center"
                           FontFamily="{StaticResource AppFont}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#92400E"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NotificationType}" Value="error">
                                            <Setter Property="Foreground" Value="#991B1B"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <!-- ── Dismiss button ── -->
                <Button Grid.Column="3" Cursor="Hand"
                Command="{Binding DismissNotificationCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CloseBd" CornerRadius="8" Padding="6"
                            Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseBd" Property="Background" Value="#18000000"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Foreground" Value="#92400E"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NotificationType}" Value="error">
                                        <Setter Property="Foreground" Value="#991B1B"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NotificationType}" Value="info">
                                        <Setter Property="Foreground" Value="#1E3A8A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                </Button>
            </Grid>
        </Border>


        <!-- ═══════════════ PAGE CONTENT ═══════════════ -->
        <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" Margin="0"/>

        <!-- ═══════════════ PREMIUM FOOTER ═══════════════ -->
        <Border Grid.Row="3" Padding="22,10"
                Background="{StaticResource FooterGradient}">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="#E2E8F0" Offset="0.15"/>
                    <GradientStop Color="#CBD5E1" Offset="0.5"/>
                    <GradientStop Color="#E2E8F0" Offset="0.85"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>
                <Thickness Top="1"/>
            </Border.BorderThickness>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: version -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="6" Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#EFF6FF" Offset="0"/>
                                <GradientStop Color="#DBEAFE" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <materialDesign:PackIcon Kind="CubeOutline" Width="12" Height="12"
                                                 Foreground="#2563EB"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFont}">
                        <Run Text="iKWOOK SFE v2.0"/>
                        <Run Text=" — "/>
                        <Run Text="Système de Facturation"/>
                    </TextBlock>
                </StackPanel>

                <!-- Center: POS badge (gradient) -->
                <Border Grid.Column="1" CornerRadius="8" Padding="14,5" Margin="16,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#EFF6FF" Offset="0"/>
                            <GradientStop Color="#DBEAFE" Offset="0.5"/>
                            <GradientStop Color="#EFF6FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1"
                                          Opacity="0.06" Direction="270"
                                          Color="#2563EB"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="MapMarkerOutline" Width="13" Height="13"
                                                 Foreground="#2563EB"
                                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock FontSize="11" Foreground="#1E40AF"
                                   VerticalAlignment="Center" FontWeight="SemiBold"
                                   FontFamily="{StaticResource AppFont}">
                            <Run Text="{Binding CurrentPosCode, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding CurrentPosCity, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Right: status + copyright -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
            HorizontalAlignment="Right" VerticalAlignment="Center">

                    <!-- Online status chip — background changes with status -->
                    <Border CornerRadius="6" Padding="8,3" Margin="0,0,14,0"
            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <!-- Default: online (green tint) -->
                                <Setter Property="Background" Value="#F0FDF4"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDeviceOnline}" Value="False">
                                        <Setter Property="Background" Value="#FEF2F2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <!-- Pulsing dot for online, static red for offline -->
                            <Grid Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                <!-- Pulse ring (only visible when online) -->
                                <Ellipse Width="7" Height="7" Opacity="0"
                         VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#10B981"/>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDeviceOnline}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0.6" To="0"
                                                                 Duration="0:0:2"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 From="1" To="2.5"
                                                                 Duration="0:0:2"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 From="1" To="2.5"
                                                                 Duration="0:0:2"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform CenterX="3.5" CenterY="3.5"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <!-- Solid dot -->
                                <Ellipse Width="7" Height="7"
                         VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#10B981"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDeviceOnline}" Value="False">
                                                    <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>

                            <TextBlock Text="{Binding DeviceStatus}" FontSize="11"
                       FontFamily="{StaticResource AppFont}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#15803D"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeviceOnline}" Value="False">
                                                <Setter Property="Foreground" Value="#DC2626"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="© 2026 · Conforme DGI-RDC" FontSize="11"
               Foreground="#CBD5E1"
               FontFamily="{StaticResource AppFont}"
               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>