<UserControl x:Class="SFE.WPF.Views.Pages.AuditLogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:SFE.WPF.Converters"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>

        <Color x:Key="AccBlue">#3B82F6</Color>
        <Color x:Key="AccBlueDk">#1E40AF</Color>
        <SolidColorBrush x:Key="AccBlueBrush" Color="{StaticResource AccBlue}"/>
        <Color x:Key="AccGreen">#059669</Color>
        <Color x:Key="AccViolet">#8B5CF6</Color>
        <Color x:Key="AccAmber">#F59E0B</Color>
        <Color x:Key="AccPink">#DB2777</Color>

        <!-- Scrollbar (same as SalesHistoryPage) -->
        <Style x:Key="SbThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="5" Margin="2,0"
                                Background="#C4CDD5"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SbVert" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border CornerRadius="5" Background="#F1F5F9" Margin="2,0"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SbThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost button -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="14,8"
                                BorderThickness="1.5" Background="White"
                                BorderBrush="{StaticResource BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="16,8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3B82F6" Offset="0"/>
                                    <GradientStop Color="#2563EB" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark button -->
        <Style x:Key="DarkBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="16,8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1E293B" Offset="0"/>
                                    <GradientStop Color="#0F172A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon button -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Period pill -->
        <Style x:Key="PeriodPill" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="16" Padding="14,7"
                                Background="White" BorderThickness="1.5"
                                BorderBrush="{StaticResource BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search box -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="10" Padding="12,9"
                                BorderThickness="1.5" Background="#F8FAFC"
                                BorderBrush="{StaticResource BorderBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <md:PackIcon Kind="Magnify" Width="18" Height="18"
                                             Margin="0,0,10,0" Foreground="#94A3B8"
                                             VerticalAlignment="Center"/>
                                <ScrollViewer Grid.Column="1" x:Name="PART_ContentHost"
                                              VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="ph"
                                           Text="Recherche par description, facture, code DEF…"
                                           Foreground="#94A3B8" FontSize="13"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ══════════════════════ MAIN LAYOUT ══════════════════════ -->
    <Grid>
        <DockPanel Margin="24,20">

            <!-- ═══ HEADER ═══ -->
            <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}"
                    CornerRadius="14" Padding="24,18" Margin="0,0,0,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" Opacity="0.06" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border CornerRadius="10" Padding="10" Margin="0,0,16,0">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource AccViolet}" Opacity="0.08"/>
                        </Border.Background>
                        <md:PackIcon Kind="ShieldSearch" Width="22" Height="22">
                            <md:PackIcon.Foreground>
                                <SolidColorBrush Color="{StaticResource AccViolet}"/>
                            </md:PackIcon.Foreground>
                        </md:PackIcon>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Journal d'audit"
                                   Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                        <TextBlock Text="Journal électronique — factures, rapports et activités (DGI §19)"
                                   FontFamily="{StaticResource AppFont}" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <TextBox Grid.Column="2" Style="{StaticResource SearchBox}"
                             Width="280" Margin="0,0,12,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostBtn}"
                                Command="{Binding ExportCsvCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="FileDelimitedOutline" Width="15" Height="15"
                                             Foreground="{StaticResource TextMutedBrush}"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Exporter CSV" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryBtn}"
                                Command="{Binding SearchCommand}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Magnify" Width="15" Height="15"
                                             Foreground="White" VerticalAlignment="Center"
                                             Margin="0,0,6,0"/>
                                <TextBlock Text="Rechercher" Foreground="White"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ FILTER BAR ═══ -->
            <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}"
                    CornerRadius="14" Padding="20,16" Margin="0,0,0,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.04" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Utilisateur -->
                        <StackPanel>
                            <TextBlock Text="Utilisateur" FontFamily="{StaticResource AppFont}"
                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,0,4"/>
                            <ComboBox Width="160" FontSize="12" MinHeight="38"
                                      ItemsSource="{Binding AvailableUsers}"
                                      SelectedItem="{Binding FilterUser}"
                                      IsEditable="True"/>
                        </StackPanel>

                        <!-- Dates -->
                        <TextBlock Grid.Column="2" Text="Du :" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Bottom" Margin="0,0,8,10"/>
                        <DatePicker Grid.Column="3" FontSize="12" Width="140" MinHeight="38"
                                    SelectedDate="{Binding DateFrom}" VerticalAlignment="Bottom"/>

                        <TextBlock Grid.Column="5" Text="Au :" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Bottom" Margin="0,0,8,10"/>
                        <DatePicker Grid.Column="6" FontSize="12" Width="140" MinHeight="38"
                                    SelectedDate="{Binding DateTo}" VerticalAlignment="Bottom"/>

                        <!-- Module -->
                        <StackPanel Grid.Column="8">
                            <TextBlock Text="Module" FontFamily="{StaticResource AppFont}"
                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,0,4"/>
                            <ComboBox Width="150" FontSize="12" MinHeight="38"
                                      ItemsSource="{Binding FilterModules}"
                                      SelectedItem="{Binding FilterModule}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="12">
                                            <TextBlock.Text>
                                                <Binding FallbackValue="Tous">
                                                    <Binding.TargetNullValue>Tous</Binding.TargetNullValue>
                                                </Binding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Reset -->
                        <Button Grid.Column="12" Style="{StaticResource GhostBtn}"
                                Command="{Binding ResetFiltersCommand}" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Refresh" Width="15" Height="15"
                                             Foreground="{StaticResource TextMutedBrush}"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Réinitialiser" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Apply -->
                        <Button Grid.Column="14" Style="{StaticResource DarkBtn}"
                                Command="{Binding SearchCommand}" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="FilterOutline" Width="15" Height="15"
                                             Foreground="White" VerticalAlignment="Center"
                                             Margin="0,0,6,0"/>
                                <TextBlock Text="Appliquer" Foreground="White"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Period presets -->
                    <Border Margin="0,12,0,0" Padding="0,10,0,0"
                            BorderBrush="#F1F5F9" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="CalendarRangeOutline" Width="16" Height="16"
                                         Margin="0,0,10,0"
                                         Foreground="{StaticResource TextMutedBrush}"
                                         VerticalAlignment="Center"/>
                            <ItemsControl ItemsSource="{Binding PeriodPresets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" Style="{StaticResource PeriodPill}"
                                                Command="{Binding DataContext.SetPeriodCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══ STATS STRIP ═══ -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">

                    <!-- Total -->
                    <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                            Padding="18,14" Width="150" Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Opacity="0.05" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Total entrées" FontFamily="{StaticResource AppFont}"
                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding StatsTotalCount}" FontFamily="{StaticResource AppFont}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Factures -->
                    <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                            Padding="18,14" Width="145" Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Opacity="0.05" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Factures" FontFamily="{StaticResource AppFont}"
                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding StatsInvoiceCount}" FontFamily="{StaticResource AppFont}"
                                       FontSize="20" FontWeight="Bold" Margin="0,2,0,0"
                                       Foreground="{StaticResource AccBlueBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Rapports -->
                    <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                            Padding="18,14" Width="140" Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Opacity="0.05" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Rapports" FontFamily="{StaticResource AppFont}"
                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding StatsReportCount}" FontFamily="{StaticResource AppFont}"
                                       FontSize="20" FontWeight="Bold" Margin="0,2,0,0">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{StaticResource AccViolet}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Connexions -->
                    <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                            Padding="18,14" Width="145" Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Opacity="0.05" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Auth/Sessions" FontFamily="{StaticResource AppFont}"
                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding StatsAuthCount}" FontFamily="{StaticResource AppFont}"
                                       FontSize="20" FontWeight="Bold" Margin="0,2,0,0">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{StaticResource AccGreen}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Stock -->
                    <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                            Padding="18,14" Width="130" Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Opacity="0.05" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Stock" FontFamily="{StaticResource AppFont}"
                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding StatsStockCount}" FontFamily="{StaticResource AppFont}"
                                       FontSize="20" FontWeight="Bold" Margin="0,2,0,0">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{StaticResource AccAmber}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Paramètres -->
                    <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                            Padding="18,14" Width="140">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Opacity="0.05" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Config/Users" FontFamily="{StaticResource AppFont}"
                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding StatsSettingsCount}" FontFamily="{StaticResource AppFont}"
                                       FontSize="20" FontWeight="Bold" Margin="0,2,0,0">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{StaticResource AccPink}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══ STATUS MESSAGES ═══ -->
            <Border DockPanel.Dock="Top" CornerRadius="10" Padding="14,10" Margin="0,0,0,10"
                    Visibility="{Binding ShowSuccess, Converter={StaticResource BoolVis}}"
                    Background="#0A059669" BorderBrush="#30059669" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="CheckCircleOutline" Width="18" Height="18"
                                 Foreground="#059669" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" FontFamily="{StaticResource AppFont}"
                               FontSize="13" Foreground="#059669"/>
                </StackPanel>
            </Border>
            <Border DockPanel.Dock="Top" CornerRadius="10" Padding="14,10" Margin="0,0,0,10"
                    Visibility="{Binding ShowError, Converter={StaticResource BoolVis}}"
                    Background="#0AEF4444" BorderBrush="#30EF4444" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="AlertCircleOutline" Width="18" Height="18"
                                 Foreground="#EF4444" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" FontFamily="{StaticResource AppFont}"
                               FontSize="13" Foreground="#EF4444" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ═══ TABLE + DETAIL ═══ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- TABLE -->
                <Border Background="{StaticResource CardBrush}" CornerRadius="14" ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" Opacity="0.06" ShadowDepth="2"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Empty state -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding NoResults, Converter={StaticResource BoolVis}}">
                            <md:PackIcon Kind="TextBoxSearchOutline" Width="40" Height="40"
                                         Foreground="{StaticResource AccBlueBrush}"
                                         HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Aucune entrée trouvée" FontFamily="{StaticResource AppFont}"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Entries}"
                                  SelectedItem="{Binding SelectedEntry}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F5F9"
                                  BorderThickness="0" Background="Transparent"
                                  RowBackground="White" AlternatingRowBackground="#FAFBFC"
                                  FontFamily="{StaticResource AppFont}" FontSize="12"
                                  CanUserResizeRows="False" SelectionUnit="FullRow"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel">

                            <DataGrid.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource SbVert}"/>
                            </DataGrid.Resources>

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                    <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="14,12"/>
                                    <Setter Property="BorderBrush" Value="#F1F5F9"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="SeparatorVisibility" Value="Collapsed"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Padding" Value="14,10"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="14,10" Background="Transparent">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.CellStyle>

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="MinHeight" Value="46"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F8FAFC"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <!-- Date -->
                                <DataGridTemplateColumn Header="Date" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DateDisplay}" FontWeight="Medium"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding TimeDisplay}" FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Module badge -->
                                <DataGridTemplateColumn Header="Module" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" Padding="8,3"
                                                    HorizontalAlignment="Left"
                                                    Background="{Binding ModuleBadgeBg}">
                                                <TextBlock Text="{Binding ModuleLabel}" FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding ModuleColor}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Action -->
                                <DataGridTemplateColumn Header="Action" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}">
                                                <Run Text="{Binding ActionIcon, Mode=OneWay}" FontSize="10"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding ActionLabel, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Utilisateur -->
                                <DataGridTextColumn Header="Utilisateur" Width="120"
                                                    Binding="{Binding UserName}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="{StaticResource TextSecondaryBrush}"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Description -->
                                <DataGridTextColumn Header="Description" Width="*"
                                                    Binding="{Binding Description}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="{StaticResource TextSecondaryBrush}"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Code DEF -->
                                <DataGridTextColumn Header="Code DEF" Width="140"
                                                    Binding="{Binding CodeDEFShort}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="FontSize" Value="10"/>
                                            <Setter Property="Foreground"
                                                    Value="{StaticResource TextMutedBrush}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Actions -->
                                <DataGridTemplateColumn Header="" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource IconBtn}" Width="32" Height="32"
                                                    ToolTip="Voir le détail"
                                                    Command="{Binding DataContext.ViewEntryCommand,
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}">
                                                <md:PackIcon Kind="EyeOutline" Width="16" Height="16"
                                                             Foreground="{StaticResource AccBlueBrush}"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Pagination -->
                        <Border Grid.Row="1" Padding="16,12" Background="#FAFBFC"
                                BorderBrush="#F1F5F9" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding PaginationInfo}" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource IconBtn}" Width="34" Height="34"
                                            Command="{Binding GoFirstPageCommand}"
                                            IsEnabled="{Binding CanGoBack}">
                                        <md:PackIcon Kind="PageFirst" Width="18" Height="18"
                                                     Foreground="{StaticResource TextMutedBrush}"/>
                                    </Button>
                                    <Button Style="{StaticResource IconBtn}" Width="34" Height="34"
                                            Command="{Binding GoPreviousPageCommand}"
                                            IsEnabled="{Binding CanGoBack}">
                                        <md:PackIcon Kind="ChevronLeft" Width="18" Height="18"
                                                     Foreground="{StaticResource TextMutedBrush}"/>
                                    </Button>
                                    <Border CornerRadius="8" Padding="12,6" Margin="4,0">
                                        <Border.Background>
                                            <SolidColorBrush Color="{StaticResource AccBlue}" Opacity="0.08"/>
                                        </Border.Background>
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12"
                                                   FontWeight="Bold" Foreground="{StaticResource AccBlueBrush}">
                                            <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                                            <Run Text=" / " FontWeight="Normal"/>
                                            <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Border>
                                    <Button Style="{StaticResource IconBtn}" Width="34" Height="34"
                                            Command="{Binding GoNextPageCommand}"
                                            IsEnabled="{Binding CanGoForward}">
                                        <md:PackIcon Kind="ChevronRight" Width="18" Height="18"
                                                     Foreground="{StaticResource TextMutedBrush}"/>
                                    </Button>
                                    <Button Style="{StaticResource IconBtn}" Width="34" Height="34"
                                            Command="{Binding GoLastPageCommand}"
                                            IsEnabled="{Binding CanGoForward}">
                                        <md:PackIcon Kind="PageLast" Width="18" Height="18"
                                                     Foreground="{StaticResource TextMutedBrush}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ═══ DETAIL PANEL ═══ -->
                <Border Grid.Column="1" Width="380" Margin="14,0,0,0"
                        Background="{StaticResource CardBrush}" CornerRadius="14"
                        ClipToBounds="True"
                        Visibility="{Binding ShowDetailPanel, Converter={StaticResource BoolVis}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" Opacity="0.06" ShadowDepth="2"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Panel header -->
                        <Border Padding="18,14" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Détail de l'entrée"
                                               FontFamily="{StaticResource AppFont}" FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding DetailTimestamp}"
                                               FontFamily="{StaticResource AppFont}" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource IconBtn}"
                                        Command="{Binding CloseDetailPanelCommand}">
                                    <md:PackIcon Kind="Close" Width="16" Height="16"
                                                 Foreground="{StaticResource TextMutedBrush}"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Detail content -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      PanningMode="VerticalOnly">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource SbVert}"/>
                            </ScrollViewer.Resources>
                            <StackPanel Margin="18,14">
                                <!-- Module / Action -->
                                <TextBlock Text="MODULE" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding DetailModule}" FontSize="13" FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                                <TextBlock Text="ACTION" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding DetailAction}" FontSize="13" FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                                <TextBlock Text="UTILISATEUR" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding DetailUser}" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                                <TextBlock Text="DESCRIPTION" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding DetailDescription}" FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,14"/>

                                <!-- Entity -->
                                <TextBlock Text="ENTITÉ" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,14">
                                    <Run Text="{Binding DetailEntityType, Mode=OneWay}"/>
                                    <Run Text=" #"/>
                                    <Run Text="{Binding DetailEntityId, Mode=OneWay}"/>
                                </TextBlock>

                                <!-- Invoice number -->
                                <StackPanel Visibility="{Binding HasCodeDEF, Converter={StaticResource BoolVis}}"
                                            Margin="0,0,0,14">
                                    <TextBlock Text="N° FACTURE" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding DetailInvoiceNumber}" FontFamily="Consolas"
                                               FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <!-- Code DEF -->
                                <StackPanel Visibility="{Binding HasCodeDEF, Converter={StaticResource BoolVis}}"
                                            Margin="0,0,0,14">
                                    <TextBlock Text="CODE DEF / DGI" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                    <Border Background="#0F172A" CornerRadius="8" Padding="12,10">
                                        <TextBlock Text="{Binding DetailCodeDEF}" FontFamily="Consolas"
                                                   FontSize="10.5" Foreground="#E2E8F0"
                                                   TextWrapping="Wrap" LineHeight="16"/>
                                    </Border>
                                    <Button Style="{StaticResource GhostBtn}" Margin="0,8,0,0"
                                            HorizontalAlignment="Left"
                                            Command="{Binding CopyCodeDEFCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="ContentCopy" Width="14" Height="14"
                                                         Foreground="{StaticResource TextMutedBrush}"
                                                         Margin="0,0,6,0"/>
                                            <TextBlock Text="Copier"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- PDV -->
                                <TextBlock Text="POINT DE VENTE" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding DetailPointOfSale, TargetNullValue=—, FallbackValue=—}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,14"/>

                                <!-- JSON details -->
                                <StackPanel Visibility="{Binding HasDetails, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="DÉTAILS" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10"
                                            BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="{Binding DetailJson}" FontFamily="Consolas"
                                                   FontSize="10" Foreground="#475569"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>

        <!-- ═══ LOADING ═══ -->
        <Border Panel.ZIndex="200" Background="#60000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <Border Background="{StaticResource CardBrush}" CornerRadius="16"
                    Padding="36,28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <md:PackIcon Kind="Loading" Width="36" Height="36"
                                 Foreground="{StaticResource AccBlueBrush}"
                                 HorizontalAlignment="Center"
                                 RenderTransformOrigin="0.5,0.5">
                        <md:PackIcon.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate"/>
                        </md:PackIcon.RenderTransform>
                        <md:PackIcon.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </md:PackIcon.Triggers>
                    </md:PackIcon>
                    <TextBlock Text="Chargement…" FontFamily="{StaticResource AppFont}"
                               FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>