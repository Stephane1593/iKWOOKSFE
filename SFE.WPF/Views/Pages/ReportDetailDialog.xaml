<Window x:Class="SFE.WPF.Views.Pages.ReportDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Détail du rapport"
        Width="680" Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#0F172A">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Background="#1E293B" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="TitleBlock" FontSize="16" FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock x:Name="SubtitleBlock" FontSize="12" Foreground="#94A3B8"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="✕" FontSize="16"
                        Background="Transparent" Foreground="#94A3B8"
                        BorderThickness="0" Cursor="Hand"
                        Click="CloseClick"
                        Width="32" Height="32"
                        VerticalAlignment="Top"/>
            </Grid>
        </Border>

        <!-- ═══ REPORT CONTENT ═══ -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Border Background="#0F172A" Padding="24,20">
                <TextBlock x:Name="ContentBlock"
                           FontFamily="Consolas"
                           FontSize="12.5"
                           LineHeight="18"
                           Foreground="#E2E8F0"
                           TextWrapping="NoWrap"/>
            </Border>
        </ScrollViewer>

        <!-- ═══ FOOTER ═══ -->
        <Border Grid.Row="2" Background="#1E293B" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="📋 Copier" Padding="14,8"
                        Background="#334155" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        FontSize="12" Click="CopyClick"
                        Margin="0,0,8,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#475569"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="🖨 Imprimer" Padding="14,8"
                        Background="#334155" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        FontSize="12" Click="PrintClick"
                        Margin="0,0,8,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#475569"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="Fermer" Padding="14,8"
                        Background="#3B82F6" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        FontSize="12" FontWeight="SemiBold"
                        Click="CloseClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>