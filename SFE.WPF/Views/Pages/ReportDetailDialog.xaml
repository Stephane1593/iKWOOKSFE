<!-- File: SFE.WPF/Views/Pages/ReportDetailDialog.xaml -->
<Window x:Class="SFE.WPF.Views.Pages.ReportDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Détail du rapport"
        Width="720" Height="760"
        MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>

        <!-- ══════════ ACCENT PALETTE ══════════ -->
        <Color x:Key="AccentBlue">#3B82F6</Color>
        <Color x:Key="AccentBlueDark">#2563EB</Color>
        <Color x:Key="AccentBlueDeep">#1D4ED8</Color>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}"/>

        <Color x:Key="DarkBase">#0F172A</Color>
        <Color x:Key="DarkCard">#1E293B</Color>
        <Color x:Key="DarkElevated">#334155</Color>
        <Color x:Key="DarkElevatedHover">#475569</Color>
        <SolidColorBrush x:Key="DarkBaseBrush"    Color="{StaticResource DarkBase}"/>
        <SolidColorBrush x:Key="DarkCardBrush"    Color="{StaticResource DarkCard}"/>
        <SolidColorBrush x:Key="DarkElevatedBrush" Color="{StaticResource DarkElevated}"/>
        <SolidColorBrush x:Key="DarkTextPrimary"  Color="#F1F5F9"/>
        <SolidColorBrush x:Key="DarkTextMuted"    Color="#94A3B8"/>
        <SolidColorBrush x:Key="DarkBorder"       Color="#334155"/>

        <!-- ══════════ CUSTOM SCROLLBAR THUMB ══════════ -->
        <Style x:Key="DarkScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBd" CornerRadius="4" Margin="2,0">
                            <Border.Background>
                                <SolidColorBrush x:Name="ThumbBg" Color="#475569"/>
                            </Border.Background>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="ThumbBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#64748B" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="ThumbBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#475569" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource AccentBlue}"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ VERTICAL SCROLLBAR (dark) ══════════ -->
        <Style x:Key="DarkScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border CornerRadius="4" Background="#1E293B" Margin="2,0"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ HORIZONTAL SCROLLBAR (dark) ══════════ -->
        <Style x:Key="DarkScrollBarH" TargetType="ScrollBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="MinHeight" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border CornerRadius="3" Background="#1E293B" Margin="0,2"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="#475569" Margin="0,2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ DARK GHOST BUTTON (animated) ══════════ -->
        <Style x:Key="DarkGhostBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource DarkTextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="16,9"
                                BorderThickness="1">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="{StaticResource DarkElevated}"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="BdBr" Color="#475569"/>
                            </Border.BorderBrush>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource DarkElevatedHover}"
                                                        Duration="0:0:0.15"/>
                                        <ColorAnimation Storyboard.TargetName="BdBr"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#64748B" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource DarkElevated}"
                                                        Duration="0:0:0.18"/>
                                        <ColorAnimation Storyboard.TargetName="BdBr"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#475569" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ ACCENT BUTTON (blue gradient, animated) ══════════ -->
        <Style x:Key="AccentBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="18,9">
                            <Border.Background>
                                <LinearGradientBrush x:Name="BdGrad" StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="G0" Color="{StaticResource AccentBlue}" Offset="0"/>
                                    <GradientStop x:Name="G1" Color="{StaticResource AccentBlueDark}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="8"
                                                  Opacity="0.25" Color="{StaticResource AccentBlue}"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource AccentBlueDark}"
                                                        Duration="0:0:0.18"/>
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource AccentBlueDeep}"
                                                        Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource AccentBlue}"
                                                        Duration="0:0:0.22"/>
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource AccentBlueDark}"
                                                        Duration="0:0:0.22"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ TITLE BAR ICON BUTTON ══════════ -->
        <Style x:Key="TitleBarIconBtn" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="Transparent"/>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#334155" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="Transparent" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ CLOSE (X) BUTTON — red on hover ══════════ -->
        <Style x:Key="CloseIconBtn" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="Transparent"/>
                            </Border.Background>
                            <materialDesign:PackIcon x:Name="Ico" Kind="Close"
                                Width="18" Height="18"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon.Foreground>
                                    <SolidColorBrush x:Name="IcoFg" Color="#94A3B8"/>
                                </materialDesign:PackIcon.Foreground>
                            </materialDesign:PackIcon>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#DC2626" Duration="0:0:0.12"/>
                                        <ColorAnimation Storyboard.TargetName="IcoFg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="White" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="Transparent" Duration="0:0:0.18"/>
                                        <ColorAnimation Storyboard.TargetName="IcoFg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#94A3B8" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- OUTER SHELL (rounded window with shadow)                   -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <Border CornerRadius="16" ClipToBounds="True">
        <Border.Background>
            <SolidColorBrush Color="{StaticResource DarkBase}"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" Opacity="0.45"
                              ShadowDepth="6" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════ -->
            <!-- TITLE BAR / HEADER                      -->
            <!-- ═══════════════════════════════════════ -->
            <Border Grid.Row="0" Padding="24,18"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1E293B" Offset="0"/>
                        <GradientStop Color="#253449" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Color="#334155" Opacity="0.5"/>
                </Border.BorderBrush>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon Badge -->
                    <Border CornerRadius="10" Padding="9" Margin="0,0,16,0"
                            VerticalAlignment="Center">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource AccentBlue}" Opacity="0.12"/>
                        </Border.Background>
                        <materialDesign:PackIcon Kind="FileDocumentOutline"
                                                 Width="20" Height="20"
                                                 Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>

                    <!-- Title + Subtitle -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleBlock"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource DarkTextPrimary}"/>
                        <TextBlock x:Name="SubtitleBlock"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="11.5" Foreground="{StaticResource DarkTextMuted}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Minimize (optional, for polish) -->
                    <Button Grid.Column="2" Style="{StaticResource TitleBarIconBtn}"
                            Click="MinimizeClick" Margin="0,0,4,0"
                            VerticalAlignment="Top">
                        <materialDesign:PackIcon Kind="WindowMinimize"
                            Width="16" Height="16"
                            Foreground="{StaticResource DarkTextMuted}"/>
                    </Button>

                    <!-- Close -->
                    <Button Grid.Column="3" Style="{StaticResource CloseIconBtn}"
                            Click="CloseClick" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════ -->
            <!-- REPORT CONTENT (code viewer)            -->
            <!-- ═══════════════════════════════════════ -->
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          PanningMode="Both">
                <ScrollViewer.Resources>
                    <Style TargetType="{x:Type ScrollBar}"
                           BasedOn="{StaticResource DarkScrollBar}">
                        <Style.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="6"/>
                                <Setter Property="MinHeight" Value="6"/>
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Grid>
                                                <Border CornerRadius="3" Background="#1E293B"
                                                        Margin="0,2"/>
                                                <Track x:Name="PART_Track"
                                                       IsDirectionReversed="False">
                                                    <Track.Thumb>
                                                        <Thumb>
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Border CornerRadius="3"
                                                                            Background="#475569"
                                                                            Margin="0,2"/>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Resources>

                <Border Padding="28,24">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#0F172A" Offset="0"/>
                            <GradientStop Color="#131C2E" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <!-- Line numbers gutter + content -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Optional line accent bar -->
                        <Border Grid.Column="0" Width="3" CornerRadius="2"
                                Margin="0,0,20,0" VerticalAlignment="Stretch">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="{StaticResource AccentBlue}" Offset="0"/>
                                    <GradientStop Color="#8B5CF6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <TextBlock Grid.Column="1" x:Name="ContentBlock"
                                   FontFamily="Consolas" FontSize="12.5"
                                   LineHeight="20" Foreground="#E2E8F0"
                                   TextWrapping="NoWrap"/>
                    </Grid>
                </Border>
            </ScrollViewer>

            <!-- ═══════════════════════════════════════ -->
            <!-- FOOTER                                  -->
            <!-- ═══════════════════════════════════════ -->
            <Border Grid.Row="2" Padding="20,16"
                    BorderThickness="0,1,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1E293B" Offset="0"/>
                        <GradientStop Color="#253449" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Color="#334155" Opacity="0.5"/>
                </Border.BorderBrush>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: resize hint -->
                    <TextBlock VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFont}" FontSize="11"
                               Foreground="#475569">
                        <Run Text="⤡ Redimensionnable"/>
                    </TextBlock>

                    <!-- Right: action buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource DarkGhostBtn}"
                                Click="CopyClick" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentCopy"
                                    Width="15" Height="15"
                                    Foreground="{StaticResource DarkTextMuted}"
                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Copier" VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource DarkGhostBtn}"
                                Click="PrintClick" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer"
                                    Width="15" Height="15"
                                    Foreground="{StaticResource DarkTextMuted}"
                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Imprimer" VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource AccentBtn}"
                                Click="CloseClick">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Check"
                                    Width="15" Height="15"
                                    Foreground="White" VerticalAlignment="Center"
                                    Margin="0,0,8,0"/>
                                <TextBlock Text="Fermer" VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}"
                                           Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════ -->
            <!-- RESIZE GRIP (bottom-right corner)       -->
            <!-- ═══════════════════════════════════════ -->
            <ResizeGrip Grid.Row="2" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom" Opacity="0"
                        Width="16" Height="16"/>
        </Grid>
    </Border>
</Window>