<UserControl x:Class="SFE.WPF.Views.Pages.BulkInvoicingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <!-- ★ Thin scrollbars / fade scroll viewer (same as PosPage) -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBarStyle}"/>
        <Style TargetType="ScrollViewer" BasedOn="{StaticResource FadeScrollViewerStyle}"/>

        <!-- ══════════ CARD ══════════ -->
        <Style x:Key="CCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="24,20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="14"
                                      Opacity="0.06" Color="#0D2B3E"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ FIELD LABEL ══════════ -->
        <Style x:Key="CFieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <!-- ══════════ TOUCH TEXTBOX (min 48px) ══════════ -->
        <Style x:Key="CTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <SolidColorBrush Color="{StaticResource BorderLightColor}"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}"
                                MinHeight="{TemplateBinding MinHeight}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ TOUCH COMBOBOX (min 48px) ══════════ -->
        <Style x:Key="CComboBox" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinHeight" Value="48"/>
        </Style>

        <!-- ══════════ PRIMARY GRADIENT BUTTON ══════════ -->
        <Style x:Key="CPrimaryBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="22,14"/>
            <Setter Property="MinHeight" Value="50"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12" Padding="{TemplateBinding Padding}"
                                MinHeight="{TemplateBinding MinHeight}">
                            <Border.Background>
                                <LinearGradientBrush x:Name="BdGrad" StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="G0" Color="#37B1E4" Offset="0"/>
                                    <GradientStop x:Name="G1" Color="#1A8CBF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="8"
                                                  Opacity="0.18" Color="#37B1E4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#2DA0D3" Duration="0:0:0.18"/>
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#1579A8" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#37B1E4" Duration="0:0:0.22"/>
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#1A8CBF" Duration="0:0:0.22"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ GHOST BUTTON ══════════ -->
        <Style x:Key="CGhostBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                MinHeight="{TemplateBinding MinHeight}">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="#F3F4F6"/>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#E5E7EB" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#F3F4F6" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ DANGER BUTTON ══════════ -->
        <Style x:Key="CDangerBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                MinHeight="{TemplateBinding MinHeight}">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="#FEE2E2"/>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#FECACA" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#FEE2E2" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ SUCCESS BUTTON ══════════ -->
        <Style x:Key="CSuccessBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="22,14"/>
            <Setter Property="MinHeight" Value="50"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12" Padding="{TemplateBinding Padding}"
                                MinHeight="{TemplateBinding MinHeight}">
                            <Border.Background>
                                <LinearGradientBrush x:Name="BdGrad" StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="G0" Color="#10B981" Offset="0"/>
                                    <GradientStop x:Name="G1" Color="#059669" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="8"
                                                  Opacity="0.18" Color="#10B981"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#059669" Duration="0:0:0.18"/>
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#047857" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#10B981" Duration="0:0:0.22"/>
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#059669" Duration="0:0:0.22"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ ICON BUTTON (touch 44×44) ══════════ -->
        <Style x:Key="CIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ CLOSE BUTTON (touch 40×40) ══════════ -->
        <Style x:Key="CCloseBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Width="40" Height="40">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18"
                                                     Foreground="{StaticResource TextSecondaryBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FECACA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ DATAGRID ROW (touch 56px) ══════════ -->
        <Style x:Key="TouchDataGridRow" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <SolidColorBrush Color="{StaticResource BorderLightColor}"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.04"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.08"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ══════════ DATAGRID HEADER ══════════ -->
        <Style x:Key="TouchDataGridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="14,14"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <SolidColorBrush Color="{StaticResource BorderLightColor}"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ DATAGRID CELL ══════════ -->
        <Style x:Key="TouchDataGridCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header: title/subtitle on the left, secondary actions on the right. -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Facturation en masse" FontFamily="{StaticResource AppFont}"
                           FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Importez un fichier Excel et créez plusieurs factures en une seule opération."
                           Margin="0,6,0,0" FontFamily="{StaticResource AppFont}" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource CGhostBtn}" Command="{Binding DownloadTemplateCommand}"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileDownloadOutline" Width="18" Height="18"
                                                 Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="Modèle Excel" FontFamily="{StaticResource AppFont}" FontSize="13"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource CGhostBtn}" Command="{Binding ResetCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"
                                                 Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="Réinitialiser" FontFamily="{StaticResource AppFont}" FontSize="13"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Point de vente + file picker. CCard is 14px radius and 24,20 padding. -->
        <Border Grid.Row="1" Style="{StaticResource CCard}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Point de vente" Style="{StaticResource CFieldLabel}"/>
                    <ComboBox Style="{StaticResource CComboBox}" ItemsSource="{Binding AvailablePointsOfSale}"
                              SelectedItem="{Binding SelectedPointOfSale, Mode=TwoWay}" DisplayMemberPath="Name"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Fichier Excel" Style="{StaticResource CFieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource BackgroundBrush}" CornerRadius="10"
                                Padding="14,0" MinHeight="48">
                            <TextBlock Text="{Binding SelectedFilePath, TargetNullValue=Séléctionnez un fichier Excel}"
                                       FontFamily="{StaticResource AppFont}" FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <Button Grid.Column="1" Style="{StaticResource CGhostBtn}" Command="{Binding BrowseFileCommand}"
                                Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderOpenOutline" Width="18" Height="18"
                                                         Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Parcourir" FontFamily="{StaticResource AppFont}" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Primary action row. -->
        <Border Grid.Row="2" Style="{StaticResource CCard}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Traitement du fichier" FontFamily="{StaticResource AppFont}"
                               FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="Validez d'abord les lignes importées, puis lancez la création des factures."
                               Margin="0,4,0,0" FontFamily="{StaticResource AppFont}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource CPrimaryBtn}" Command="{Binding ParseCommand}"
                        IsEnabled="{Binding IsParsing, Converter={StaticResource InverseBoolConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileCheckOutline" Width="18" Height="18" Foreground="White" Margin="0,0,8,0"/>
                        <TextBlock Text="Valider le fichier" Foreground="White" FontFamily="{StaticResource AppFont}"
                                   FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource CSuccessBtn}" Command="{Binding ExecuteCommand}"
                        IsEnabled="{Binding CanExecute}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PlayCircleOutline" Width="18" Height="18" Foreground="White" Margin="0,0,8,0"/>
                        <TextBlock Text="Lancer la facturation" Foreground="White" FontFamily="{StaticResource AppFont}"
                                   FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="5" Style="{StaticResource CDangerBtn}" Command="{Binding CancelCommand}"
                        IsEnabled="{Binding IsExecuting}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="StopCircleOutline" Width="18" Height="18" Foreground="{StaticResource ErrorBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="Arrêter" Foreground="{StaticResource ErrorBrush}" FontFamily="{StaticResource AppFont}" FontSize="13"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Execution progress and touch-friendly stat badges. -->
        <Border Grid.Row="3" Style="{StaticResource CCard}" Margin="0,0,0,14"
                Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <Grid>
                    <TextBlock Text="{Binding ProgressCaption}" FontFamily="{StaticResource AppFont}"
                               FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource AppFont}" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="{Binding ProgressCurrent}"/><Run Text=" / "/><Run Text="{Binding ProgressTotal}"/>
                    </TextBlock>
                </Grid>
                <ProgressBar Margin="0,12,0,16" Height="8" Minimum="0" Maximum="{Binding ProgressTotal}"
                             Value="{Binding ProgressCurrent}" Foreground="{StaticResource PrimaryBrush}"/>
                <WrapPanel>
                    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="10" Padding="14,8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Réussites  " FontFamily="{StaticResource AppFont}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding SuccessCount}" FontFamily="{StaticResource AppFont}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="10" Padding="14,8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Échecs  " FontFamily="{StaticResource AppFont}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding FailureCount}" FontFamily="{StaticResource AppFont}" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="10" Padding="14,8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Temps écoulé  " FontFamily="{StaticResource AppFont}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding ElapsedText}" FontFamily="{StaticResource AppFont}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="10" Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Restant  " FontFamily="{StaticResource AppFont}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding RemainingText}" FontFamily="{StaticResource AppFont}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Results workspace. -->
        <Border Grid.Row="4" Style="{StaticResource CCard}" Padding="0">
            <TabControl Background="Transparent" BorderThickness="0" FontFamily="{StaticResource AppFont}">
                <TabItem Header="Aperçu">
                    <DataGrid ItemsSource="{Binding ParsedInvoices}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" GridLinesVisibility="None" HeadersVisibility="Column" BorderThickness="0"
                              Background="Transparent" RowStyle="{StaticResource TouchDataGridRow}"
                              ColumnHeaderStyle="{StaticResource TouchDataGridColumnHeader}" CellStyle="{StaticResource TouchDataGridCell}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="RÉFÉRENCE" Binding="{Binding Reference}" Width="150"/>
                            <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="100"/>
                            <DataGridTextColumn Header="CLIENT" Binding="{Binding ClientName}" Width="*"/>
                            <DataGridTextColumn Header="LIGNES" Binding="{Binding LineCount}" Width="80"/>
                            <DataGridTextColumn Header="TOTAL TTC" Binding="{Binding TotalTTC}" Width="120"/>
                            <DataGridTextColumn Header="DEVISE" Binding="{Binding Currency}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Erreurs de validation">
                    <DataGrid ItemsSource="{Binding ParseErrors}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" GridLinesVisibility="None" HeadersVisibility="Column" BorderThickness="0"
                              Background="Transparent" RowStyle="{StaticResource TouchDataGridRow}"
                              ColumnHeaderStyle="{StaticResource TouchDataGridColumnHeader}" CellStyle="{StaticResource TouchDataGridCell}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="LIGNE EXCEL" Binding="{Binding ExcelRow}" Width="110"/>
                            <DataGridTextColumn Header="RÉFÉRENCE" Binding="{Binding Reference}" Width="180"/>
                            <DataGridTextColumn Header="MESSAGE" Binding="{Binding Message}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Résultats">
                    <DataGrid ItemsSource="{Binding ExecutionResults}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" GridLinesVisibility="None" HeadersVisibility="Column" BorderThickness="0"
                              Background="Transparent" RowStyle="{StaticResource TouchDataGridRow}"
                              ColumnHeaderStyle="{StaticResource TouchDataGridColumnHeader}" CellStyle="{StaticResource TouchDataGridCell}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="RÉFÉRENCE" Binding="{Binding Reference}" Width="145"/>
                            <DataGridTextColumn Header="N° FACTURE" Binding="{Binding InvoiceNumber}" Width="125"/>
                            <DataGridTextColumn Header="CLIENT" Binding="{Binding ClientName}" Width="*"/>
                            <DataGridTextColumn Header="TOTAL TTC" Binding="{Binding TotalTTC}" Width="120"/>
                            <DataGridTemplateColumn Header="STATUT" Width="105" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Success}" Value="True">
                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                        <Setter Property="Text" Value="Échec"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Success}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                <Setter Property="Text" Value="Réussite"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="CODE DGI" Binding="{Binding CodeDEFDGI}" Width="120"/>
                            <DataGridTextColumn Header="ERREUR" Binding="{Binding ErrorMessage}" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
