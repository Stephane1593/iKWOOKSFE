                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Width="20"
                                                         Height="20"
                                                         Margin="0,0,12,0"
                                                         VerticalAlignment="Top"
                                                         Foreground="#DC2626"
                                                         Kind="AlertCircle" />
                                            <TextBlock MaxWidth="300"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="12"
                                                       FontWeight="Medium"
                                                       Foreground="#DC2626"
                                                       Text="{Binding StatusMessage}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>