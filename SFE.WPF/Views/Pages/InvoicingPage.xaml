<UserControl x:Class="SFE.WPF.Views.Pages.InvoicingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>

        <!-- ══════════ CARD (branded shadow) ══════════ -->
        <Style x:Key="InvCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="28"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="14"
                                      Opacity="0.06" Color="#0D2B3E"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ SECTION TITLE (with left accent) ══════════ -->
        <Style x:Key="InvSectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <!-- ══════════ FIELD LABEL ══════════ -->
        <Style x:Key="InvFieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- ══════════ TOUCH TEXTBOX (min 44px) ══════════ -->
        <Style x:Key="InvTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ══════════ TOUCH COMBOBOX (min 44px) ══════════ -->
        <Style x:Key="InvComboBox" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="42"/>
        </Style>

        <!-- ══════════ MINI ACTION BUTTON (animated, touch min 42px) ══════════ -->
        <Style x:Key="InvMiniBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="#37B1E4"/>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#1A8CBF" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#37B1E4" Duration="0:0:0.22"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ DANGER MINI BUTTON ══════════ -->
        <Style x:Key="InvDangerBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="#FEE2E2"/>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#FECACA" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#FEE2E2" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ GREEN MINI BUTTON ══════════ -->
        <Style x:Key="InvSuccessBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#065F46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="#DCFCE7"/>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#BBF7D0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#DCFCE7" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ PURPLE MINI BUTTON ══════════ -->
        <Style x:Key="InvPurpleBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="#7C3AED"/>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#6D28D9" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#7C3AED" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ ACCENT MINI BUTTON (red) ══════════ -->
        <Style x:Key="InvAccentBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="{StaticResource AccentColor}"/>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#DC0F0F" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource AccentColor}" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ NORMALIZE BUTTON (big gradient) ══════════ -->
        <Style x:Key="NormalizeBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush x:Name="BdGrad" StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="G0" Color="#10B981" Offset="0"/>
                                    <GradientStop x:Name="G1" Color="#059669" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="3" BlurRadius="16"
                                                  Opacity="0.3" Color="#10B981"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#059669" Duration="0:0:0.18"/>
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#047857" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#10B981" Duration="0:0:0.22"/>
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#059669" Duration="0:0:0.22"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource BorderColor}"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="Effect" Value="{x:Null}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ PRIMARY GRADIENT BUTTON ══════════ -->
        <Style x:Key="InvPrimaryBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush x:Name="BdGrad" StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="G0" Color="#37B1E4" Offset="0"/>
                                    <GradientStop x:Name="G1" Color="#1A8CBF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="6"
                                                  Opacity="0.15" Color="#37B1E4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#2DA0D3" Duration="0:0:0.18"/>
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#1579A8" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#37B1E4" Duration="0:0:0.22"/>
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#1A8CBF" Duration="0:0:0.22"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ POPUP SHADOW ══════════ -->
        <DropShadowEffect x:Key="PopupShadow" BlurRadius="24" ShadowDepth="5"
                          Opacity="0.12" Direction="270" Color="#0D2B3E"/>

        <!-- ══════════ SCROLLBAR — Thin pill (light bg variant) ══════════ -->
        <Style x:Key="InvScrollThumb" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBd" CornerRadius="4" Margin="1">
                            <Border.Background>
                                <SolidColorBrush x:Name="ThumbBg" Color="#C8D0D8"/>
                            </Border.Background>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="ThumbBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#94A3B8" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="ThumbBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#C8D0D8" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#64748B"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvScrollPageBtn" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvVScrollBar" TargetType="ScrollBar">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource InvScrollPageBtn}"
                                              Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource InvScrollThumb}" MinHeight="30"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource InvScrollPageBtn}"
                                              Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvHScrollBar" TargetType="ScrollBar">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="MinHeight" Value="8"/>
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource InvScrollPageBtn}"
                                              Command="ScrollBar.PageLeftCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource InvScrollThumb}" MinWidth="30"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource InvScrollPageBtn}"
                                              Command="ScrollBar.PageRightCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ PANEL SCROLLVIEWER (fade-on-hover) ══════════ -->
        <Style x:Key="InvPanelScroll" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollContentPresenter Grid.Column="0" Grid.Row="0"
                                                    Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>

                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1" Grid.Row="0"
                                       Style="{StaticResource InvVScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Opacity="0.3" Margin="2,8"/>

                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Column="0" Grid.Row="1"
                                       Style="{StaticResource InvHScrollBar}"
                                       Orientation="Horizontal"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                       Opacity="0.3" Margin="8,2"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="PART_HorizontalScrollBar"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.3" Duration="0:0:0.5"/>
                                        <DoubleAnimation Storyboard.TargetName="PART_HorizontalScrollBar"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.3" Duration="0:0:0.5"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ DATAGRID STYLES ══════════ -->
        <Style x:Key="InvDataGridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="SeparatorVisibility" Value="Collapsed"/>
        </Style>

        <Style x:Key="InvDataGridCell" TargetType="DataGridCell">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.06"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InvDataGridRow" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.03"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ══════════ POPUP ITEM BUTTON (touch 48px) ══════════ -->
        <Style x:Key="PopupItemBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,1">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="#00000000"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource BorderLightColor}"/>
                            </Border.BorderBrush>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#0A37B1E4" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#00000000" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 🆕 ══════════ RICH TOOLTIP (error-friendly, wrapping) ══════════ -->
        <Style x:Key="ErrorTooltipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="#1C1917"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="MaxWidth" Value="420"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#1C1917" CornerRadius="8" Padding="14,10"
                                Effect="{StaticResource PopupShadow}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       TextWrapping="Wrap" MaxWidth="400"
                                       Foreground="White"
                                       FontFamily="{StaticResource AppFont}" FontSize="12"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="580"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════ -->
        <!-- LEFT PANEL                                            -->
        <!-- ══════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Column="0"
                      Style="{StaticResource InvPanelScroll}"
                      VerticalScrollBarVisibility="Auto"
                      Padding="32,28,16,28">
            <StackPanel>

                <!-- ═══════════════════════════════════════════ -->
                <!-- HEADER CARD                                 -->
                <!-- ═══════════════════════════════════════════ -->
                <Border Style="{StaticResource InvCard}">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ReceiptTextOutline" Width="22" Height="22"
                                                         Foreground="{StaticResource PrimaryBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Nouvelle facture" Style="{StaticResource InvSectionTitle}"/>
                            </StackPanel>
                            <!-- Mode badge -->
                            <Border HorizontalAlignment="Right" CornerRadius="8" Padding="12,6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.1"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHtMode}" Value="True">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.12"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,5,0"
                                                             VerticalAlignment="Center">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="TagOutline"/>
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHtMode}" Value="True">
                                                        <Setter Property="Foreground" Value="#92400E"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <TextBlock Text="{Binding PriceModeDisplay}"
                                               FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHtMode}" Value="True">
                                                        <Setter Property="Foreground" Value="#92400E"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- POS display -->
                        <Border CornerRadius="10" Padding="16,12" Margin="0,16,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.06"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="BorderBrush">
                                        <Setter.Value>
                                            <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.2"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPointOfSale}" Value="{x:Null}">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Color="{StaticResource ErrorColor}" Opacity="0.06"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="BorderBrush">
                                                <Setter.Value>
                                                    <SolidColorBrush Color="{StaticResource ErrorColor}" Opacity="0.2"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <materialDesign:PackIcon Kind="StorefrontOutline" Width="16" Height="16"
                                                                 Foreground="{StaticResource PrimaryDarkBrush}"
                                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Point de vente" FontFamily="{StaticResource AppFont}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                Visibility="{Binding SelectedPointOfSale, Converter={StaticResource IsNotNullToVisibilityConverter}}">
                                        <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="4"
                                                Padding="6,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedPointOfSale.Code}" FontFamily="Consolas"
                                                       FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryDarkBrush}"/>
                                        </Border>
                                        <TextBlock Text="{Binding SelectedPointOfSale.Name}"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" CornerRadius="10" Padding="10,4" Margin="8,0,0,0"
                                            Background="{StaticResource PrimaryBrush}" VerticalAlignment="Center"
                                            Visibility="{Binding HasMultiplePos, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                                   Foreground="White" FontWeight="Bold">
                                            <Run Text="{Binding AvailablePointsOfSale.Count, Mode=OneWay}"/>
                                            <Run Text=" POS"/>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding SelectedPosInfo}" FontFamily="{StaticResource AppFont}"
                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"
                                           Visibility="{Binding SelectedPointOfSale, Converter={StaticResource IsNotNullToVisibilityConverter}}"/>

                                <!-- No POS warning -->
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedPointOfSale}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <materialDesign:PackIcon Kind="AlertOutline" Width="13" Height="13"
                                                             Foreground="#DC2626" Margin="0,0,5,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Aucun point de vente configuré — la normalisation sera bloquée"
                                               FontFamily="{StaticResource AppFont}" FontSize="10"
                                               Foreground="#DC2626" FontStyle="Italic"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Invoice fields grid -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,10">
                                <TextBlock Text="Type" Style="{StaticResource InvFieldLabel}"/>
                                <ComboBox Style="{StaticResource InvComboBox}"
                                          ItemsSource="{Binding InvoiceTypes}"
                                          SelectedItem="{Binding SelectedInvoiceType}"
                                          IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"
                                          ToolTip="Type de facture (FV, FA, FT…)"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,10">
                                <TextBlock Text="N° Facture" Style="{StaticResource InvFieldLabel}"/>
                                <TextBox Style="{StaticResource InvTextBox}"
                                         Text="{Binding InvoiceNumber}" IsReadOnly="True"
                                         FontWeight="SemiBold"
                                         Background="{StaticResource BackgroundBrush}"
                                         ToolTip="Numéro de facture généré automatiquement"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,0,10">
                                <TextBlock Text="Date" Style="{StaticResource InvFieldLabel}"/>
                                <TextBox Style="{StaticResource InvTextBox}"
                                         Text="{Binding CurrentDateTime}" IsReadOnly="True"
                                         Background="{StaticResource BackgroundBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,10,0">
                                <TextBlock Text="Opérateur" Style="{StaticResource InvFieldLabel}"/>
                                <TextBox Style="{StaticResource InvTextBox}"
                                         Text="{Binding OperatorName}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="ISF" Style="{StaticResource InvFieldLabel}"/>
                                <TextBox Style="{StaticResource InvTextBox}"
                                         Text="{Binding Isf}" IsReadOnly="True"
                                         Background="{StaticResource BackgroundBrush}"
                                         ToolTip="Identifiant du Système de Facturation"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════ -->
                <!-- CREDIT NOTE (AVOIR)                         -->
                <!-- ═══════════════════════════════════════════ -->
                <Border Style="{StaticResource InvCard}"
                        Visibility="{Binding IsCreditNote, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileUndoOutline" Width="22" Height="22"
                                                     Foreground="{StaticResource AccentBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Facture d'avoir" Style="{StaticResource InvSectionTitle}"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Nature *" Style="{StaticResource InvFieldLabel}"/>
                                <ComboBox Style="{StaticResource InvComboBox}"
                                          ItemsSource="{Binding CreditNoteNatures}"
                                          SelectedItem="{Binding SelectedCreditNoteNature}"
                                          ToolTip="Nature de l'avoir : Correction, Annulation, Remboursement ou RRR"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Réf. facture originale (Code DEF/DGI ou RRR) *"
                                           Style="{StaticResource InvFieldLabel}"/>
                                <TextBox Style="{StaticResource InvTextBox}" FontFamily="Consolas"
                                         Text="{Binding OriginalReference, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsRRR, Converter={StaticResource InverseBoolConverter}}"
                                         ToolTip="Saisir le Code DEF/DGI de la facture originale à rembourser"/>
                            </StackPanel>

                            <Button Grid.Column="2" Style="{StaticResource InvMiniBtn}"
                                    VerticalAlignment="Bottom"
                                    Command="{Binding LookupOriginalInvoiceCommand}"
                                    Visibility="{Binding RequiresOriginalLookup, Converter={StaticResource BoolToVisibilityConverter}}"
                                    ToolTip="Rechercher et charger la facture originale depuis la référence saisie">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Magnify" Width="14" Height="14"
                                                             Foreground="White" Margin="0,0,5,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Charger" Foreground="White" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- RRR info -->
                        <Border CornerRadius="8" Padding="14,10" Margin="0,12,0,0"
                                Visibility="{Binding IsRRR, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.08"/>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="LightbulbOnOutline" Width="15" Height="15"
                                                         Foreground="#92400E" Margin="0,0,8,0"
                                                         VerticalAlignment="Top"/>
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11" Foreground="#92400E"
                                           TextWrapping="Wrap"
                                           Text="Type RRR : Remise, Ristourne, Rabais — Saisie libre des articles. Référence automatiquement définie à « RRR »."/>
                            </StackPanel>
                        </Border>

                        <!-- Original invoice loaded -->
                        <Border CornerRadius="10" Padding="16,12" Margin="0,12,0,0"
                                Visibility="{Binding IsOriginalLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource SuccessColor}" Opacity="0.06"/>
                            </Border.Background>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CheckCircleOutline" Width="16" Height="16"
                                                             Foreground="#065F46" Margin="0,0,6,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Facture originale" FontFamily="{StaticResource AppFont}"
                                               FontSize="12" FontWeight="Bold" Foreground="#065F46"/>
                                </StackPanel>
                                <TextBlock Text="{Binding OriginalInvoiceSummary}" FontFamily="{StaticResource AppFont}"
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="22,4,0,0"
                                           ToolTip="{Binding OriginalInvoiceSummary}"/>
                            </StackPanel>
                        </Border>

                        <!-- Items to refund -->
                        <Border CornerRadius="10" Margin="0,12,0,0" BorderThickness="1"
                                Visibility="{Binding IsOriginalLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource BorderLightColor}"/>
                            </Border.BorderBrush>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource BackgroundBrush}"
                                            CornerRadius="10,10,0,0" Padding="16,12">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FormatListBulleted" Width="16" Height="16"
                                                                     Foreground="{StaticResource TextSecondaryBrush}"
                                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Articles à rembourser"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{StaticResource BackgroundBrush}"
                                            CornerRadius="0,10,0,0" Padding="10,8">
                                        <Button Style="{StaticResource InvAccentBtn}"
                                                Command="{Binding AddAllSelectedCreditNoteLinesCommand}"
                                                ToolTip="Ajouter tous les articles cochés aux lignes de facture">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Plus" Width="14" Height="14"
                                                                         Foreground="White" Margin="0,0,4,0"
                                                                         VerticalAlignment="Center"/>
                                                <TextBlock Text="Ajouter sélection" Foreground="White" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                    </Border>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding CreditNoteSelections}" Margin="12,8,12,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="0,0,0,1" Padding="6,10"
                                                    MinHeight="48">
                                                <Border.BorderBrush>
                                                    <SolidColorBrush Color="{StaticResource BorderLightColor}"/>
                                                </Border.BorderBrush>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="90"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontFamily="{StaticResource AppFont}"
                                                                   FontSize="12" FontWeight="Medium"
                                                                   ToolTip="{Binding DisplayName}"/>
                                                        <TextBlock Text="{Binding DisplayQuantity}"
                                                                   FontFamily="{StaticResource AppFont}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   ToolTip="{Binding DisplayQuantity}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding TaxGroupLabel}"
                                                               FontFamily="{StaticResource AppFont}" FontSize="11"
                                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="4,0">
                                                        <TextBlock Text="Quantité" FontFamily="{StaticResource AppFont}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                                        <TextBox Style="{StaticResource InvTextBox}"
                                                                 MinHeight="34" Padding="8,4"
                                                                 Text="{Binding SelectedQuantity, UpdateSourceTrigger=PropertyChanged}"
                                                                 ToolTip="Quantité à rembourser (max indiqué ci-dessus)"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="4" Text="{Binding DisplayPrice}"
                                                               FontFamily="{StaticResource AppFont}" FontSize="11"
                                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                                               Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════ -->
                <!-- ADVANCE PAYMENT (ACOMPTE)                   -->
                <!-- ═══════════════════════════════════════════ -->
                <Border Style="{StaticResource InvCard}"
                        Visibility="{Binding ShowAdvanceSection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CashClock" Width="22" Height="22"
                                                     Foreground="#7C3AED"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Facture d'acompte" Style="{StaticResource InvSectionTitle}"
                                       Foreground="#7C3AED"/>
                        </StackPanel>

                        <TextBlock Text="Identifiant du groupe d'avances (optionnel — pour lier plusieurs acomptes)"
                                   FontFamily="{StaticResource AppFont}" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Style="{StaticResource InvTextBox}" FontFamily="Consolas"
                                     Text="{Binding AdvanceGroupId, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Identifiant unique du groupe d'avances"/>

                            <Button Grid.Column="1" Style="{StaticResource InvPurpleBtn}" Margin="8,0"
                                    Command="{Binding CreateNewAdvanceGroupCommand}"
                                    ToolTip="Générer un nouvel identifiant de groupe d'avances">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="PlusCircleOutline" Width="14" Height="14"
                                                             Foreground="White" Margin="0,0,4,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Nouveau" Foreground="White" FontSize="11"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Command="{Binding LoadAdvanceGroupCommand}"
                                    FontFamily="{StaticResource AppFont}" FontSize="11"
                                    Background="{StaticResource BackgroundBrush}" Padding="12,8"
                                    MinHeight="42" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Charger les avances précédentes de ce groupe">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderOpenOutline" Width="14" Height="14"
                                                             Foreground="{StaticResource TextSecondaryBrush}"
                                                             Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Charger"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Previous advances -->
                        <ItemsControl ItemsSource="{Binding PreviousAdvances}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F5F3FF" CornerRadius="8" Padding="14,10" Margin="0,4"
                                            MinHeight="46">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12">
                                                    <Run Text="{Binding InvoiceNumber}" FontWeight="SemiBold"/>
                                                    <Run Text=" — "/>
                                                    <Run Text="{Binding DateDisplay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding CodeDEFDGI}" FontFamily="Consolas" FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           ToolTip="{Binding CodeDEFDGI}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}" FontSize="13"
                                                       FontWeight="Bold" Foreground="#7C3AED">
                                                <Run Text="{Binding Amount, StringFormat=N0}"/>
                                                <Run Text=" CDF" FontSize="10"/>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Total advances -->
                        <Border Background="#EDE9FE" CornerRadius="10" Padding="16,12" Margin="0,12,0,0"
                                Visibility="{Binding PreviousAdvances.Count, Converter={StaticResource IsGreaterThanZeroConverter}}">
                            <Grid>
                                <TextBlock Text="Total acomptes versés" FontFamily="{StaticResource AppFont}"
                                           FontSize="12" FontWeight="SemiBold" Foreground="#7C3AED"/>
                                <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource AppFont}"
                                           FontSize="14" FontWeight="Bold" Foreground="#7C3AED">
                                    <Run Text="{Binding AdvancesTotalPaid, StringFormat=N0, Mode=OneWay}"/>
                                    <Run Text=" CDF" FontSize="10"/>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="13" Height="13"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     Margin="0,0,5,0" VerticalAlignment="Top"/>
                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                                       Text="Chaque acompte est une facture normalisée indépendante. Le groupe d'avances permet de les relier pour le suivi."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════ -->
                <!-- CLIENT                                      -->
                <!-- ═══════════════════════════════════════════ -->
                <Border Style="{StaticResource InvCard}">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountOutline" Width="22" Height="22"
                                                         Foreground="{StaticResource PrimaryBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Client" Style="{StaticResource InvSectionTitle}"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" CornerRadius="8" Padding="12,5" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedClientType}" Value="PM">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.1"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedClientType}" Value="AO">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.12"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ClientTypeMention}" FontFamily="{StaticResource AppFont}"
                                           FontSize="11" FontWeight="SemiBold"
                                           ToolTip="{Binding ClientTypeMention}"/>
                            </Border>
                        </Grid>

                        <!-- Type + Search -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Type *" Style="{StaticResource InvFieldLabel}"/>
                                <ComboBox Style="{StaticResource InvComboBox}"
                                          ItemsSource="{Binding ClientTypes}"
                                          SelectedItem="{Binding SelectedClientType}"
                                          IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"
                                          ToolTip="PP=Personne physique, PM=Personne morale, PC=Commerçant, PL=Profession libérale, AO=Ambassade/Org."/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <materialDesign:PackIcon Kind="Magnify" Width="13" Height="13"
                                                             Foreground="{StaticResource TextMutedBrush}"
                                                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Rechercher un client existant"
                                               Style="{StaticResource InvFieldLabel}" Margin="0"/>
                                </StackPanel>
                                <Grid>
                                    <TextBox x:Name="ClientSearchBox"
                                             Style="{StaticResource InvTextBox}"
                                             Text="{Binding ClientSearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                             IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"
                                             ToolTip="Taper au moins 2 caractères pour rechercher par nom, NIF ou téléphone"/>
                                    <Popup IsOpen="{Binding IsClientSearchOpen, Mode=TwoWay}" StaysOpen="False"
                                           PlacementTarget="{Binding ElementName=ClientSearchBox}"
                                           Placement="Bottom" Width="{Binding ActualWidth, ElementName=ClientSearchBox}"
                                           AllowsTransparency="True" PopupAnimation="Fade">
                                        <Border Background="White" CornerRadius="0,0,12,12" MaxHeight="300"
                                                BorderThickness="1" Effect="{StaticResource PopupShadow}">
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="{StaticResource BorderLightColor}"/>
                                            </Border.BorderBrush>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding ClientSearchResults}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource PopupItemBtn}"
                                                                    Command="{Binding DataContext.SelectClientCommand,
                                                                        RelativeSource={RelativeSource AncestorType=Popup}}"
                                                                    CommandParameter="{Binding}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border CornerRadius="4" Padding="8,3" Margin="0,0,12,0"
                                                                            Background="{StaticResource BackgroundBrush}"
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Type}" FontFamily="Consolas"
                                                                                   FontSize="10" FontWeight="Bold"/>
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Name}"
                                                                                   FontFamily="{StaticResource AppFont}" FontSize="13"
                                                                                   FontWeight="Medium"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock FontFamily="Consolas" FontSize="11"
                                                                                   Foreground="{StaticResource TextMutedBrush}">
                                                                            <Run Text="NIF: "/><Run Text="{Binding NIF, TargetNullValue='-'}"/>
                                                                            <Run Text=" · "/><Run Text="{Binding Phone, TargetNullValue=''}"/>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                    <materialDesign:PackIcon Grid.Column="2"
                                                                        Kind="ArrowRight" Width="16" Height="16"
                                                                        Foreground="{StaticResource PrimaryBrush}"
                                                                        VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>

                            <Button Grid.Column="2" Style="{StaticResource InvDangerBtn}"
                                    VerticalAlignment="Bottom"
                                    Command="{Binding ClearClientCommand}"
                                    Visibility="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"
                                    ToolTip="Vider tous les champs client">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Close" Width="13" Height="13"
                                                             Foreground="#DC2626" Margin="0,0,4,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Vider" Foreground="#DC2626" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- NIF + Name -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="NIF" Style="{StaticResource InvFieldLabel}" Margin="0"/>
                                    <TextBlock Text=" *" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="12"
                                               Visibility="{Binding IsClientNifRequired, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                                <TextBox Style="{StaticResource InvTextBox}" Margin="0,6,0,0"
                                         Text="{Binding ClientNIF, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"
                                         ToolTip="Numéro d'Identification Fiscale — obligatoire pour PM, PC et PL"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Nom / Dénomination" Style="{StaticResource InvFieldLabel}" Margin="0"/>
                                    <TextBlock Text=" *" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="12"
                                               Visibility="{Binding IsClientNameRequired, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                                <TextBox Style="{StaticResource InvTextBox}" Margin="0,6,0,0"
                                         Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"
                                         ToolTip="Nom du client ou dénomination sociale — obligatoire sauf pour PP"/>
                            </StackPanel>
                        </Grid>

                        <!-- Address, Phone, Email -->
                        <Grid Margin="0,12,0,0"
                              Visibility="{Binding ShowClientDetails, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Adresse" Style="{StaticResource InvFieldLabel}"/>
                                <TextBox Style="{StaticResource InvTextBox}"
                                         Text="{Binding ClientAddress}"
                                         IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Téléphone" Style="{StaticResource InvFieldLabel}"/>
                                <TextBox Style="{StaticResource InvTextBox}"
                                         Text="{Binding ClientPhone}"
                                         IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Email" Style="{StaticResource InvFieldLabel}"/>
                                <TextBox Style="{StaticResource InvTextBox}"
                                         Text="{Binding ClientEmail}"
                                         IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Save client -->
                        <Button Style="{StaticResource InvSuccessBtn}"
                                Command="{Binding SaveClientInlineCommand}"
                                HorizontalAlignment="Left" Margin="0,14,0,0"
                                Visibility="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"
                                ToolTip="Sauvegarder les informations client pour un usage futur">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="14" Height="14"
                                                         Foreground="#065F46" Margin="0,0,5,0"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Enregistrer ce client" Foreground="#065F46" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════ -->
                <!-- COMMENTS (A-H)                              -->
                <!-- ═══════════════════════════════════════════ -->
                <Border Style="{StaticResource InvCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CommentTextOutline" Width="22" Height="22"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Commentaires (lignes A–H)" Style="{StaticResource InvSectionTitle}"/>
                        </StackPanel>

                        <!-- Line A -->
                        <Border CornerRadius="10" Padding="16,12" Margin="0,16,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCommentARequired}" Value="True">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.06"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="BorderBrush">
                                                <Setter.Value>
                                                    <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.3"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding CommentALabel, Mode=OneWay}" FontFamily="{StaticResource AppFont}"
                                               FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text=" (obligatoire)" Foreground="#EA580C" FontSize="11"
                                               FontFamily="{StaticResource AppFont}" FontStyle="Italic"
                                               Visibility="{Binding IsCommentARequired, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                                <TextBox Style="{StaticResource InvTextBox}"
                                         Text="{Binding CommentA, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCommentARequired}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <materialDesign:PackIcon Kind="AlertOutline" Width="12" Height="12"
                                                             Foreground="#EA580C" Margin="0,0,5,0"
                                                             VerticalAlignment="Top"/>
                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap">
                                        <TextBlock.Inlines>
                                            <Run Text="{Binding CommentALabel,Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text=" — Ce champ est requis pour ce type de client/article."/>
                                        </TextBlock.Inlines>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Lines B-H -->
                        <Expander Header="Lignes B–H (réservées)" FontFamily="{StaticResource AppFont}" FontSize="12"
                                  Foreground="{StaticResource TextSecondaryBrush}" Margin="0,14,0,0"
                                  IsExpanded="False">
                            <StackPanel Margin="0,12,0,0">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="B" FontFamily="{StaticResource AppFont}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource InvTextBox}" MinHeight="36" Padding="10,6"
                                             Text="{Binding CommentB}"
                                             IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="C" FontFamily="{StaticResource AppFont}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource InvTextBox}" MinHeight="36" Padding="10,6" Text="{Binding CommentC}" IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="D" FontFamily="{StaticResource AppFont}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource InvTextBox}" MinHeight="36" Padding="10,6" Text="{Binding CommentD}" IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="E" FontFamily="{StaticResource AppFont}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource InvTextBox}" MinHeight="36" Padding="10,6" Text="{Binding CommentE}" IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="F" FontFamily="{StaticResource AppFont}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource InvTextBox}" MinHeight="36" Padding="10,6" Text="{Binding CommentF}" IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="G" FontFamily="{StaticResource AppFont}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource InvTextBox}" MinHeight="36" Padding="10,6" Text="{Binding CommentG}" IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="H" FontFamily="{StaticResource AppFont}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource InvTextBox}" MinHeight="36" Padding="10,6" Text="{Binding CommentH}" IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="50,6,0,0">
                                    <materialDesign:PackIcon Kind="InformationOutline" Width="12" Height="12"
                                                             Foreground="{StaticResource TextMutedBrush}"
                                                             Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Ces lignes sont réservées par la DGI pour usage futur."
                                               FontFamily="{StaticResource AppFont}" FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════ -->
                <!-- ADD ARTICLE                                 -->
                <!-- ═══════════════════════════════════════════ -->
                <Border Style="{StaticResource InvCard}"
                        Visibility="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PackageVariantClosedPlus" Width="22" Height="22"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Ajouter un article" Style="{StaticResource InvSectionTitle}"/>
                        </StackPanel>

                        <!-- Row 1: Code, Name, Type, Group -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Text="Code" Style="{StaticResource InvFieldLabel}"/>
                                <TextBox Style="{StaticResource InvTextBox}"
                                         Text="{Binding ArticleCode}"
                                         ToolTip="Code article (optionnel)"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,10">
                                <TextBlock Text="Désignation *" Style="{StaticResource InvFieldLabel}"/>
                                <Grid>
                                    <TextBox x:Name="ArticleNameBox"
                                             Style="{StaticResource InvTextBox}"
                                             Text="{Binding ArticleName, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                             ToolTip="Nom ou désignation de l'article — obligatoire"/>
                                    <Popup IsOpen="{Binding IsSearchPopupOpen, Mode=TwoWay}" StaysOpen="False"
                                           PlacementTarget="{Binding ElementName=ArticleNameBox}"
                                           Placement="Bottom"
                                           MinWidth="400"
                                           AllowsTransparency="True" PopupAnimation="Fade">
                                        <Border Background="White" CornerRadius="0,0,12,12" MaxHeight="320"
                                                BorderThickness="1" Effect="{StaticResource PopupShadow}"
                                                MinWidth="500" MaxWidth="700">
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="{StaticResource BorderLightColor}"/>
                                            </Border.BorderBrush>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding ProductSearchResults}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource PopupItemBtn}"
                                                                    Command="{Binding DataContext.SelectProductCommand,
                                                                        RelativeSource={RelativeSource AncestorType=Popup}}"
                                                                    CommandParameter="{Binding}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Name}"
                                                                                   FontFamily="{StaticResource AppFont}" FontSize="13"
                                                                                   FontWeight="Medium"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                            <Border Background="{StaticResource BackgroundBrush}"
                                                                                    CornerRadius="3" Padding="5,1" Margin="0,0,6,0">
                                                                                <TextBlock Text="{Binding Code}" FontFamily="Consolas"
                                                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                                                            </Border>
                                                                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                                                                       Foreground="{StaticResource TextMutedBrush}">
                                                                                <Run Text="{Binding TaxGroup}"/>
                                                                                <Run Text=" · T.S.: "/>
                                                                                <Run Text="{Binding SpecificTaxDisplay, Mode=OneWay}"/>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                    <Border Grid.Column="1" CornerRadius="6"
                                                                            Padding="10,4" Margin="12,0,0,0"
                                                                            VerticalAlignment="Center">
                                                                        <Border.Background>
                                                                            <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.08"/>
                                                                        </Border.Background>
                                                                        <TextBlock Text="{Binding UnitPrice, StringFormat='{}{0:N2} CDF'}"
                                                                                   FontFamily="{StaticResource AppFont}" FontSize="12"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="{StaticResource PrimaryBrush}"/>
                                                                    </Border>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,10,10">
                                <TextBlock Text="Type" Style="{StaticResource InvFieldLabel}"/>
                                <ComboBox Style="{StaticResource InvComboBox}"
                                          ItemsSource="{Binding ItemTypes}" SelectedItem="{Binding ArticleItemType}"
                                          ToolTip="BIE=Bien, SER=Service"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,0,10">
                                <TextBlock Text="Groupe" Style="{StaticResource InvFieldLabel}"/>
                                <ComboBox Style="{StaticResource InvComboBox}"
                                          ItemsSource="{Binding TaxGroups}" SelectedItem="{Binding ArticleTaxGroup}"
                                          ToolTip="Groupe fiscal : A=Taxable 16%, B=Taxable 16%, C=Exonéré, D=Dérogatoire"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Price, Qty, Unit -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,10,10">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource InvFieldLabel}">
                                            <Setter Property="Text" Value="Prix unit. TTC *"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHtMode}" Value="True">
                                                    <Setter Property="Text" Value="Prix unit. HT *"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Style="{StaticResource InvTextBox}"
                                         Text="{Binding ArticleUnitPrice, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Prix unitaire — doit être un nombre positif"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,10">
                                <TextBlock Text="Quantité *" Style="{StaticResource InvFieldLabel}"/>
                                <TextBox Style="{StaticResource InvTextBox}"
                                         Text="{Binding ArticleQuantity, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Quantité — doit être un nombre positif"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,10,10">
                                <TextBlock Text="Unité" Style="{StaticResource InvFieldLabel}"/>
                                <ComboBox Style="{StaticResource InvComboBox}"
                                          ItemsSource="{Binding CommonUnits}" SelectedItem="{Binding ArticleUnit}"
                                          IsEditable="True"
                                          ToolTip="Unité de mesure (pce, kg, L, m, etc.)"/>
                            </StackPanel>
                        </Grid>

                        <!-- Specific Tax row -->
                        <Border CornerRadius="10" Padding="16,12" Margin="0,6,0,10">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.06"/>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <materialDesign:PackIcon Kind="FlashOutline" Width="15" Height="15"
                                                             Foreground="#92400E" Margin="0,0,4,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="T.S. :" FontFamily="{StaticResource AppFont}" FontSize="12"
                                               Foreground="#92400E" FontWeight="SemiBold"/>
                                </StackPanel>

                                <ComboBox Grid.Column="1" Style="{StaticResource InvComboBox}"
                                          ItemsSource="{Binding SpecificTaxTypes}"
                                          SelectedItem="{Binding ArticleSpecificTaxType}"
                                          Margin="0,0,10,0"
                                          ToolTip="Type de taxe spécifique : Aucune, Montant fixe par unité ou Pourcentage"/>

                                <TextBox Grid.Column="2" Style="{StaticResource InvTextBox}"
                                         Text="{Binding ArticleSpecificTaxValue, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,10,0"
                                         Visibility="{Binding ShowArticleSpecificTaxFields, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBox.ToolTip>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Montant fixe par unité (ex : 230)"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ArticleSpecificTaxType}" Value="Percentage">
                                                            <Setter Property="Text" Value="Pourcentage sur HT (ex : 10)"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </TextBox.ToolTip>
                                </TextBox>

                                <ComboBox Grid.Column="3" Style="{StaticResource InvComboBox}"
                                          ItemsSource="{Binding TaxApplicationModes}"
                                          SelectedItem="{Binding ArticleTaxApplicationMode}"
                                          Visibility="{Binding ShowArticleSpecificTaxFields, Converter={StaticResource BoolToVisibilityConverter}}"
                                          ToolTip="Mode d'application : Par article (chaque ligne) ou Sur le total (regroupé)"/>
                            </Grid>
                        </Border>

                        <!-- T.S. info -->
                        <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,10"
                                Visibility="{Binding ShowArticleSpecificTaxFields, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.04"/>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="InformationOutline" Width="13" Height="13"
                                                         Foreground="#854D0E" Margin="0,0,6,0"
                                                         VerticalAlignment="Top"/>
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                           Foreground="#854D0E" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text"
                                                    Value="Montant fixe par unité · Par article : appliqué sur chaque ligne"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ArticleSpecificTaxType}" Value="Percentage"/>
                                                        <Condition Binding="{Binding ArticleTaxApplicationMode}" Value="PerArticle"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Text"
                                                            Value="Pourcentage appliqué sur le montant HT · Par article : appliqué sur chaque ligne"/>
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ArticleSpecificTaxType}" Value="FixedPerUnit"/>
                                                        <Condition Binding="{Binding ArticleTaxApplicationMode}" Value="OnTotal"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Text"
                                                            Value="Montant fixe par unité · Sur le total : T.S. différée, calculée une seule fois sur le sous-total regroupé"/>
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ArticleSpecificTaxType}" Value="Percentage"/>
                                                        <Condition Binding="{Binding ArticleTaxApplicationMode}" Value="OnTotal"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Text"
                                                            Value="Pourcentage appliqué sur le montant HT · Sur le total : T.S. différée, calculée une seule fois sur le sous-total regroupé"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Discount + Add button -->
                        <Border CornerRadius="10" Padding="16,12" Margin="0,6,0,10">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource ErrorColor}" Opacity="0.04"/>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <materialDesign:PackIcon Kind="PercentOutline" Width="15" Height="15"
                                                             Foreground="#DC2626" Margin="0,0,4,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Remise :" FontFamily="{StaticResource AppFont}" FontSize="12"
                                               Foreground="#DC2626"/>
                                </StackPanel>

                                <ComboBox Grid.Column="1" Style="{StaticResource InvComboBox}"
                                          ItemsSource="{Binding DiscountTypes}"
                                          SelectedItem="{Binding ArticleDiscountType}"
                                          Margin="0,0,10,0"
                                          ToolTip="Type de remise : Aucune, Pourcentage ou Montant fixe"/>

                                <TextBox Grid.Column="2" Style="{StaticResource InvTextBox}"
                                         Text="{Binding ArticleDiscountValue, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,10,0"
                                         ToolTip="Valeur de la remise (% ou montant fixe)"/>

                                <StackPanel Grid.Column="3"/>

                                <!-- 🆕 Tooltip on Add button -->
                                <Button Grid.Column="4" Style="{StaticResource InvPrimaryBtn}"
                                        Command="{Binding AddArticleCommand}" VerticalAlignment="Center"
                                        ToolTip="Ajouter cet article aux lignes de facture">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16"
                                                                 Foreground="White" Margin="0,0,6,0"
                                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="Ajouter" Foreground="White"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════ -->
                <!-- INVOICE LINES GRID                          -->
                <!-- ═══════════════════════════════════════════ -->
                <Border Style="{StaticResource InvCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="FormatListNumbered" Width="22" Height="22"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Lignes de facture" Style="{StaticResource InvSectionTitle}"/>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding InvoiceLines}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                  CanUserResizeColumns="False" CanUserReorderColumns="False"
                                  GridLinesVisibility="None" HeadersVisibility="Column"
                                  BorderThickness="0" FontFamily="{StaticResource AppFont}" FontSize="12"
                                  MaxHeight="360" Background="Transparent"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  ColumnHeaderStyle="{StaticResource InvDataGridColumnHeader}"
                                  CellStyle="{StaticResource InvDataGridCell}"
                                  RowStyle="{StaticResource InvDataGridRow}">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#"
                                                    Binding="{Binding LineNumber}"
                                                    Width="40" MinWidth="40"/>

                                <DataGridTextColumn Header="Désignation"
                                                    Binding="{Binding Name}"
                                                    Width="*" MinWidth="180">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="ToolTip" Value="{Binding Name}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Groupe"
                                                    Binding="{Binding TaxGroupDisplay}"
                                                    Width="75" MinWidth="75">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="Medium"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="P.U. HT"
                                                    Binding="{Binding UnitPriceHT, StringFormat=N2}"
                                                    Width="100" MinWidth="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Qté"
                                                    Binding="{Binding Quantity, StringFormat=G}"
                                                    Width="60" MinWidth="50">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Unité"
                                                    Binding="{Binding Unit}"
                                                    Width="60" MinWidth="50">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Remise"
                                                    Binding="{Binding DiscountDisplay}"
                                                    Width="75" MinWidth="65">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#DC2626"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="T.S." Width="80" MinWidth="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="4,0"
                                                        Visibility="{Binding HasSpecificTax, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding SpecificTaxDisplay}"
                                                           FontFamily="{StaticResource AppFont}" FontSize="10"
                                                           HorizontalAlignment="Center" FontWeight="Medium"
                                                           Foreground="#92400E"/>
                                                <TextBlock Text="{Binding TaxSpecificAmount, StringFormat=N0}"
                                                           FontFamily="{StaticResource AppFont}" FontSize="9"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="H.T."
                                                    Binding="{Binding AmountHT, StringFormat=N2}"
                                                    Width="100" MinWidth="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="TVA"
                                                    Binding="{Binding AmountTVA, StringFormat=N2}"
                                                    Width="85" MinWidth="75">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="TTC"
                                                    Binding="{Binding AmountTTC, StringFormat=N2}"
                                                    Width="110" MinWidth="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- 🆕 FIX: Remove button with DataTrigger visibility + proper hover template + tooltip -->
                                <DataGridTemplateColumn Header="" Width="50" MinWidth="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.RemoveArticleCommand,
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Supprimer cette ligne de la facture">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Width" Value="36"/>
                                                        <Setter Property="Height" Value="36"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="RemBd" CornerRadius="8"
                                                                            Width="36" Height="36">
                                                                        <Border.Background>
                                                                            <SolidColorBrush x:Name="RemBg" Color="Transparent"/>
                                                                        </Border.Background>
                                                                        <materialDesign:PackIcon Kind="DeleteOutline"
                                                                                                 Width="16" Height="16"
                                                                                                 Foreground="#EF4444"
                                                                                                 HorizontalAlignment="Center"
                                                                                                 VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <EventTrigger RoutedEvent="MouseEnter">
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <ColorAnimation Storyboard.TargetName="RemBg"
                                                                                                    Storyboard.TargetProperty="Color"
                                                                                                    To="#FEE2E2" Duration="0:0:0.12"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </EventTrigger>
                                                                        <EventTrigger RoutedEvent="MouseLeave">
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <ColorAnimation Storyboard.TargetName="RemBg"
                                                                                                    Storyboard.TargetProperty="Color"
                                                                                                    To="Transparent" Duration="0:0:0.18"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </EventTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <!-- 🆕 FIX: Use DataTrigger instead of InverseBoolConverter for Visibility -->
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsNormalized,
                                                                RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Empty state -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,28,0,16"
                                    Visibility="{Binding InvoiceLines.Count, 
                                      Converter={StaticResource ZeroToVisibilityConverter}}">
                            <materialDesign:PackIcon Kind="PackageVariantRemove" Width="36" Height="36"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Aucun article ajouté" FontFamily="{StaticResource AppFont}"
                                       FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ══════════════════════════════════════════════════════ -->
        <!-- RIGHT PANEL                                            -->
        <!-- ══════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Column="1"
                      Style="{StaticResource InvPanelScroll}"
                      VerticalScrollBarVisibility="Auto"
                      Padding="16,28,32,28">
            <StackPanel>

                <!-- ═══ TAX SUMMARY ═══ -->
                <Border Style="{StaticResource InvCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalculatorVariantOutline" Width="20" Height="20"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Résumé fiscal" Style="{StaticResource InvSectionTitle}"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding TaxGroupSummaries}" Margin="0,16,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Label}" FontFamily="{StaticResource AppFont}"
                                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TotalHT, StringFormat='HT: {0:N2}'}"
                                                       FontFamily="{StaticResource AppFont}" FontSize="12"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding TotalTVA, StringFormat='TVA: {0:N2}'}"
                                                       FontFamily="{StaticResource AppFont}" FontSize="12"
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Background="{StaticResource BorderLightBrush}" Margin="0,10"/>

                        <!-- Totals detail -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition MinHeight="28"/>
                                <RowDefinition MinHeight="28"/>
                                <RowDefinition MinHeight="28"/>
                                <RowDefinition MinHeight="28"/>
                                <RowDefinition MinHeight="28"/>
                                <RowDefinition MinHeight="28"/>
                                <RowDefinition MinHeight="28"/>
                                <RowDefinition MinHeight="28"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Sous-total avant remise" FontFamily="{StaticResource AppFont}" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                       Visibility="{Binding HasAnyDiscount, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Grid.Column="1" Text="{Binding TotalHTBeforeDiscount, StringFormat=N2}"
                                       FontFamily="{StaticResource AppFont}" FontSize="12" HorizontalAlignment="Right"
                                       Foreground="{StaticResource TextMutedBrush}" TextDecorations="Strikethrough"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasAnyDiscount, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding HasAnyDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                <materialDesign:PackIcon Kind="PercentOutline" Width="13" Height="13"
                                                         Foreground="#DC2626" Margin="0,0,4,0"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Remise" FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="#DC2626"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalDiscount, StringFormat='-{0:N2}'}"
                                       FontFamily="{StaticResource AppFont}" FontSize="12" HorizontalAlignment="Right"
                                       Foreground="#DC2626" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Visibility="{Binding HasAnyDiscount, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <TextBlock Grid.Row="2" Text="Total H.T." FontFamily="{StaticResource AppFont}" FontSize="13"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalHT, StringFormat=N2}"
                                       FontFamily="{StaticResource AppFont}" FontSize="13" HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="3" Text="Total TVA" FontFamily="{StaticResource AppFont}" FontSize="13"
                                       Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TotalTVA, StringFormat=N2}"
                                       FontFamily="{StaticResource AppFont}" FontSize="13"
                                       Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding HasFixedSpecificTax, Converter={StaticResource BoolToVisibilityConverter}}">
                                <materialDesign:PackIcon Kind="FlashOutline" Width="13" Height="13"
                                                         Foreground="#92400E" Margin="0,0,4,0"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="T.S. fixe / unité" FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="#92400E"/>
                            </StackPanel>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TotalFixedSpecificTax, StringFormat=N2}"
                                       FontFamily="{StaticResource AppFont}" FontSize="12" HorizontalAlignment="Right"
                                       Foreground="#92400E" VerticalAlignment="Center"
                                       Visibility="{Binding HasFixedSpecificTax, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <StackPanel Grid.Row="5" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding HasPercentSpecificTax, Converter={StaticResource BoolToVisibilityConverter}}">
                                <materialDesign:PackIcon Kind="FlashOutline" Width="13" Height="13"
                                                         Foreground="#92400E" Margin="0,0,4,0"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="T.S. pourcentage" FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="#92400E"/>
                            </StackPanel>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TotalPercentSpecificTax, StringFormat=N2}"
                                       FontFamily="{StaticResource AppFont}" FontSize="12" HorizontalAlignment="Right"
                                       Foreground="#92400E" VerticalAlignment="Center"
                                       Visibility="{Binding HasPercentSpecificTax, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <StackPanel Grid.Row="6" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding HasAnySpecificTax, Converter={StaticResource BoolToVisibilityConverter}}">
                                <materialDesign:PackIcon Kind="Flash" Width="14" Height="14"
                                                         Foreground="#92400E" Margin="0,0,4,0"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Total taxe spécifique" FontFamily="{StaticResource AppFont}" FontSize="13"
                                           Foreground="#92400E" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding TotalSpecificTax, StringFormat=N2}"
                                       FontFamily="{StaticResource AppFont}" FontSize="13" HorizontalAlignment="Right"
                                       Foreground="#92400E" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Visibility="{Binding HasAnySpecificTax, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <TextBlock Grid.Row="7" Text="Total TTC" FontFamily="{StaticResource AppFont}" FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding TotalTTC, StringFormat=N2}"
                                       FontFamily="{StaticResource AppFont}" FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"
                                       Margin="0,4,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Grand total -->
                        <Border CornerRadius="12" Padding="18,14" Margin="0,16,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.08"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHtMode}" Value="True">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.08"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{Binding GrandTotalLabel}"
                                               FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Montant toutes taxes comprises"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHtMode}" Value="True">
                                                        <Setter Property="Text" Value="Montant hors taxes · TVA en sus"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}">
                                    <Run Text="{Binding GrandTotal, StringFormat=N2, Mode=OneWay}"/>
                                    <Run Text=" CDF" FontSize="12"/>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- HT mode: à payer TTC -->
                        <Border CornerRadius="10" Padding="16,12" Margin="0,10,0,0"
                                Visibility="{Binding IsHtMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource SuccessColor}" Opacity="0.06"/>
                            </Border.Background>
                            <Grid>
                                <TextBlock Text="À payer (TTC)" FontFamily="{StaticResource AppFont}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#065F46"
                                           VerticalAlignment="Center"/>
                                <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource AppFont}"
                                           FontSize="15" FontWeight="Bold" Foreground="#065F46"
                                           VerticalAlignment="Center">
                                    <Run Text="{Binding TotalTTC, StringFormat=N2, Mode=OneWay}"/>
                                    <Run Text=" CDF" FontSize="11"/>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- Alternate currency -->
                        <Border CornerRadius="10" Padding="16,12" Margin="0,10,0,0"
                                BorderThickness="1">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource BackgroundColor}"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource BorderLightColor}"/>
                            </Border.BorderBrush>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="SwapHorizontal" Width="18" Height="18"
                                                         Foreground="{StaticResource TextMutedBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" FontFamily="{StaticResource AppFont}" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center">
                                    <Run Text="Équivalent "/>
                                    <Run Text="{Binding AlternateCurrencyLabel, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}">
                                    <Run Text="{Binding TotalInAlternateCurrency, StringFormat=N2, Mode=OneWay}"/>
                                    <Run Text=" " FontSize="10"/>
                                    <Run Text="{Binding AlternateCurrencyLabel, Mode=OneWay}" FontSize="10"/>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═══ PAYMENTS ═══ -->
                <Border Style="{StaticResource InvCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CreditCardOutline" Width="20" Height="20"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Paiements" Style="{StaticResource InvSectionTitle}"/>
                        </StackPanel>

                        <Grid Margin="0,16,0,10"
                              Visibility="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Style="{StaticResource InvComboBox}"
                                      ItemsSource="{Binding PaymentTypes}"
                                      SelectedItem="{Binding SelectedPaymentType}"
                                      Margin="0,0,8,0"
                                      ToolTip="Mode de paiement"/>
                            <TextBox Grid.Column="1" Style="{StaticResource InvTextBox}"
                                     Text="{Binding PaymentAmount}"
                                     Margin="0,0,8,0"
                                     ToolTip="Montant du paiement — laisser vide pour le montant restant"/>
                            <Button Grid.Column="2" Style="{StaticResource InvMiniBtn}" Padding="12,8"
                                    Command="{Binding AddPaymentCommand}"
                                    ToolTip="Ajouter ce paiement">
                                <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Foreground="White"/>
                            </Button>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding PaymentItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4" MinHeight="40">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" FontFamily="{StaticResource AppFont}" FontSize="13"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat=N2}"
                                                   FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"
                                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Background="Transparent" BorderThickness="0"
                                                Cursor="Hand" Width="36" Height="36"
                                                ToolTip="Supprimer ce paiement"
                                                Command="{Binding DataContext.RemovePaymentCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Close" Width="14" Height="14"
                                                                     Foreground="#EF4444"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Background="{StaticResource BorderLightBrush}" Margin="0,8"/>
                        <Grid MinHeight="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Reste à payer (TTC)" FontFamily="{StaticResource AppFont}"
                                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Remaining, StringFormat=N2}"
                                       FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Remaining}" Value="0">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══ PENDING INVOICES ═══ -->
                <Border Style="{StaticResource InvCard}">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClockOutline" Width="20" Height="20"
                                                         Foreground="{StaticResource WarningBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Factures en attente" Style="{StaticResource InvSectionTitle}"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource InvSuccessBtn}" Margin="0,0,8,0"
                                        Command="{Binding CheckPendingInvoicesCommand}" VerticalAlignment="Center"
                                        ToolTip="Interroger le dispositif fiscal pour lister les factures en attente">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14"
                                                                 Foreground="#065F46" Margin="0,0,5,0"
                                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="Vérifier" Foreground="#065F46" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource InvDangerBtn}"
                                        Command="{Binding CancelAllPendingCommand}"
                                        Visibility="{Binding HasPendingInvoices, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTip="Annuler toutes les factures en attente">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="TrashCanOutline" Width="13" Height="13"
                                                                 Foreground="#DC2626" Margin="0,0,4,0"
                                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="Annuler" Foreground="#DC2626" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Pending status -->
                        <Border CornerRadius="10" Padding="14,10" Margin="0,14,0,0"
                                Visibility="{Binding ShowPendingSection, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Color="{StaticResource SuccessColor}" Opacity="0.06"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPendingInvoices}" Value="True">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.08"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon VerticalAlignment="Center" Margin="0,0,8,0">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="CheckCircleOutline"/>
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            <Setter Property="Width" Value="16"/>
                                            <Setter Property="Height" Value="16"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasPendingInvoices}" Value="True">
                                                    <Setter Property="Kind" Value="AlertCircleOutline"/>
                                                    <Setter Property="Foreground" Value="#92400E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Aucune facture en attente"/>
                                            <Setter Property="Foreground" Value="#065F46"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasPendingInvoices}" Value="True">
                                                    <Setter Property="Foreground" Value="#92400E"/>
                                                    <Setter Property="Text" Value="{Binding PendingInvoiceCount, StringFormat='{}{0} facture(s) en attente'}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Pending list -->
                        <ItemsControl ItemsSource="{Binding PendingInvoices}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="14,10" Margin="0,4"
                                            BorderThickness="1" MinHeight="48">
                                        <Border.Background>
                                            <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.05"/>
                                        </Border.Background>
                                        <Border.BorderBrush>
                                            <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.2"/>
                                        </Border.BorderBrush>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           ToolTip="{Binding Uid}">
                                                    <Run Text="UID: "/><Run Text="{Binding Uid}"/>
                                                </TextBlock>
                                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}">
                                                    <Run Text="Date: "/><Run Text="{Binding DateDisplay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource InvDangerBtn}"
                                                    Command="{Binding DataContext.CancelPendingInvoiceCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Uid}" VerticalAlignment="Center"
                                                    ToolTip="Annuler cette facture en attente">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Close" Width="12" Height="12"
                                                                             Foreground="#DC2626" Margin="0,0,4,0"
                                                                             VerticalAlignment="Center"/>
                                                    <TextBlock Text="Annuler" Foreground="#DC2626" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Manual UID -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource InvTextBox}" FontFamily="Consolas"
                                     Text="{Binding CancelUid, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Saisir manuellement le UID d'une facture en attente à annuler"/>
                            <Button Grid.Column="1" Style="{StaticResource InvAccentBtn}" Margin="8,0,0,0"
                                    Command="{Binding CancelPendingInvoiceCommand}"
                                    ToolTip="Annuler la facture correspondant au UID saisi">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="TrashCanOutline" Width="13" Height="13"
                                                             Foreground="White" Margin="0,0,4,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Annuler" Foreground="White" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="12" Height="12"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Saisir un UID ou cliquer « Vérifier » pour lister"
                                       FontFamily="{StaticResource AppFont}" FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>

                        <!-- 🆕 Pending status messages — with tooltip for full text -->
                        <Border Margin="0,12,0,0" CornerRadius="8" Padding="14,10"
                                Visibility="{Binding ShowPendingSuccess, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTip="{Binding PendingStatusMessage}">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource SuccessColor}" Opacity="0.06"/>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="15" Height="15"
                                                         Foreground="{StaticResource SuccessBrush}"
                                                         Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PendingStatusMessage}"
                                           Foreground="{StaticResource SuccessBrush}"
                                           FontFamily="{StaticResource AppFont}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,12,0,0" CornerRadius="8" Padding="14,10"
                                Visibility="{Binding ShowPendingError, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTip="{Binding PendingStatusMessage}">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource ErrorColor}" Opacity="0.06"/>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertCircleOutline" Width="15" Height="15"
                                                         Foreground="{StaticResource ErrorBrush}"
                                                         Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PendingStatusMessage}"
                                           Foreground="{StaticResource ErrorBrush}"
                                           FontFamily="{StaticResource AppFont}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═══ ACTIONS ═══ -->
                <Border Style="{StaticResource InvCard}">
                    <StackPanel>
                        <!-- 🆕 Normalize button with dynamic tooltip -->
                        <Button Style="{StaticResource NormalizeBtn}"
                                Command="{Binding NormalizeInvoiceCommand}"
                                IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"
                                HorizontalContentAlignment="Center" Margin="0,0,0,12">
                            <Button.ToolTip>
                                <TextBlock TextWrapping="Wrap" MaxWidth="350">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Envoyer la facture au dispositif fiscal pour normalisation DGI"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNormalized}" Value="True">
                                                    <Setter Property="Text" Value="Cette facture a déjà été normalisée"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ShieldLockOutline" Width="22" Height="22"
                                                         Foreground="White" Margin="0,0,10,0"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="NORMALISER LA FACTURE" VerticalAlignment="Center"
                                           Foreground="White"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource InvPrimaryBtn}"
                                Command="{Binding NewInvoiceCommand}"
                                HorizontalContentAlignment="Center"
                                ToolTip="Réinitialiser le formulaire pour créer une nouvelle facture">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilePlusOutline" Width="16" Height="16"
                                                         Foreground="White" Margin="0,0,8,0"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Nouvelle facture" Foreground="White"/>
                            </StackPanel>
                        </Button>

                        <!-- 🆕 Success / Error — with tooltip for full message -->
                        <Border Margin="0,14,0,0" CornerRadius="10" Padding="16,12"
                                Visibility="{Binding ShowSuccess, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTip="{Binding StatusMessage}"
                                ToolTipService.ShowDuration="30000">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource SuccessColor}" Opacity="0.06"/>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="16" Height="16"
                                                         Foreground="{StaticResource SuccessBrush}"
                                                         Margin="0,0,8,0" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                                           FontFamily="{StaticResource AppFont}" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,14,0,0" CornerRadius="10" Padding="16,12"
                                Visibility="{Binding ShowError, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTip="{Binding StatusMessage}"
                                ToolTipService.ShowDuration="30000">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource ErrorColor}" Opacity="0.06"/>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertCircleOutline" Width="16" Height="16"
                                                         Foreground="{StaticResource ErrorBrush}"
                                                         Margin="0,0,8,0" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource ErrorBrush}"
                                           FontFamily="{StaticResource AppFont}" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═══ SECURITY ═══ -->
                <Border Style="{StaticResource InvCard}"
                        Visibility="{Binding IsNormalized, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="22" Height="22"
                                                     Foreground="{StaticResource SuccessBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Éléments de sécurité" Style="{StaticResource InvSectionTitle}"
                                       Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>

                        <Border CornerRadius="12" Padding="20,16" Margin="0,16,0,0">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource SuccessColor}" Opacity="0.05"/>
                            </Border.Background>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="CODE DEF/DGI" FontFamily="{StaticResource AppFont}"
                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding CodeDEFDGI}" FontFamily="Consolas"
                                           FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"
                                           Margin="0,4,0,0"
                                           ToolTip="{Binding CodeDEFDGI}"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition MinHeight="28"/>
                                <RowDefinition MinHeight="28"/>
                                <RowDefinition MinHeight="28"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="DEF NIM:" FontFamily="{StaticResource AppFont}" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Nim}" FontFamily="Consolas" FontSize="12"
                                       VerticalAlignment="Center" ToolTip="{Binding Nim}"/>

                            <TextBlock Grid.Row="1" Text="Compteurs:" FontFamily="{StaticResource AppFont}" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Counters}" FontFamily="Consolas" FontSize="12"
                                       VerticalAlignment="Center" ToolTip="{Binding Counters}"/>

                            <TextBlock Grid.Row="2" Text="Date DEF:" FontFamily="{StaticResource AppFont}" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DeviceDateTime}" FontFamily="Consolas" FontSize="12"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>