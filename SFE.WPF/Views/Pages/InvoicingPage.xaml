<UserControl x:Class="SFE.WPF.Views.Pages.InvoicingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>

        <!--  ══════════ CARD (branded shadow) ══════════  -->
        <Style x:Key="InvCard"
               TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="28" />
            <Setter Property="Margin" Value="0,0,0,18" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14"
                                      Opacity="0.06"
                                      ShadowDepth="2"
                                      Color="#0D2B3E" />
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ══════════ SECTION TITLE (with left accent) ══════════  -->
        <Style x:Key="InvSectionTitle"
               TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <!--  ══════════ FIELD LABEL ══════════  -->
        <Style x:Key="InvFieldLabel"
               TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!--  ══════════ TOUCH TEXTBOX (min 44px) ══════════  -->
        <Style x:Key="InvTextBox"
               TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!--  ══════════ TOUCH COMBOBOX (min 44px) ══════════  -->
        <Style x:Key="InvComboBox"
               TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="42" />
        </Style>

        <!--  ══════════ MINI ACTION BUTTON (animated, touch min 42px) ══════════  -->
        <Style x:Key="InvMiniBtn"
               TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg"
                                                 Color="#37B1E4" />
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#1A8CBF"
                                                        Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#37B1E4"
                                                        Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ══════════ DANGER MINI BUTTON ══════════  -->
        <Style x:Key="InvDangerBtn"
               TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#DC2626" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg"
                                                 Color="#FEE2E2" />
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#FECACA"
                                                        Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#FEE2E2"
                                                        Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ══════════ GREEN MINI BUTTON ══════════  -->
        <Style x:Key="InvSuccessBtn"
               TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#065F46" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg"
                                                 Color="#DCFCE7" />
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#BBF7D0"
                                                        Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#DCFCE7"
                                                        Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ══════════ PURPLE MINI BUTTON ══════════  -->
        <Style x:Key="InvPurpleBtn"
               TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg"
                                                 Color="#7C3AED" />
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#6D28D9"
                                                        Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#7C3AED"
                                                        Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ══════════ ACCENT MINI BUTTON (red) ══════════  -->
        <Style x:Key="InvAccentBtn"
               TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg"
                                                 Color="{StaticResource AccentColor}" />
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#DC0F0F"
                                                        Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource AccentColor}"
                                                        Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ══════════ NORMALIZE BUTTON (big gradient) ══════════  -->
        <Style x:Key="NormalizeBtn"
               TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush x:Name="BdGrad" StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="G0" Offset="0" Color="#10B981" />
                                    <GradientStop x:Name="G1" Offset="1" Color="#059669" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16"
                                                  Opacity="0.3"
                                                  ShadowDepth="3"
                                                  Color="#10B981" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#059669"
                                                        Duration="0:0:0.18" />
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#047857"
                                                        Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#10B981"
                                                        Duration="0:0:0.22" />
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#059669"
                                                        Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource BorderColor}" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="Effect" Value="{x:Null}" />
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ══════════ PRIMARY GRADIENT BUTTON ══════════  -->
        <Style x:Key="InvPrimaryBtn"
               TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush x:Name="BdGrad" StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="G0" Offset="0" Color="#37B1E4" />
                                    <GradientStop x:Name="G1" Offset="1" Color="#1A8CBF" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6"
                                                  Opacity="0.15"
                                                  ShadowDepth="1"
                                                  Color="#37B1E4" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#2DA0D3"
                                                        Duration="0:0:0.18" />
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#1579A8"
                                                        Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#37B1E4"
                                                        Duration="0:0:0.22" />
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#1A8CBF"
                                                        Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ══════════ POPUP SHADOW ══════════  -->
        <DropShadowEffect x:Key="PopupShadow"
                          BlurRadius="24"
                          Direction="270"
                          Opacity="0.12"
                          ShadowDepth="5"
                          Color="#0D2B3E" />

        <!--  ══════════ SCROLLBAR — Thin pill (light bg variant) ══════════  -->
        <Style x:Key="InvScrollThumb"
               TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBd"
                                Margin="1"
                                CornerRadius="4">
                            <Border.Background>
                                <SolidColorBrush x:Name="ThumbBg"
                                                 Color="#C8D0D8" />
                            </Border.Background>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="ThumbBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#94A3B8"
                                                        Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="ThumbBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#C8D0D8"
                                                        Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#64748B" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvScrollPageBtn"
               TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvVScrollBar"
               TargetType="ScrollBar">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track"
                               IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                              Style="{StaticResource InvScrollPageBtn}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb MinHeight="30"
                                       Style="{StaticResource InvScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                              Style="{StaticResource InvScrollPageBtn}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvHScrollBar"
               TargetType="ScrollBar">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="8" />
            <Setter Property="MinHeight" Value="8" />
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track"
                               IsDirectionReversed="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageLeftCommand"
                                              Style="{StaticResource InvScrollPageBtn}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb MinWidth="30"
                                       Style="{StaticResource InvScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageRightCommand"
                                              Style="{StaticResource InvScrollPageBtn}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ══════════ PANEL SCROLLVIEWER (fade-on-hover) ══════════  -->
        <Style x:Key="InvPanelScroll"
               TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollContentPresenter Grid.Row="0"
                                                    Grid.Column="0"
                                                    Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}" />

                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Row="0"
                                       Grid.Column="1"
                                       Margin="2,8"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       Opacity="0.3"
                                       Style="{StaticResource InvVScrollBar}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Value="{TemplateBinding VerticalOffset}" />

                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       Margin="8,2"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       Opacity="0.3"
                                       Orientation="Horizontal"
                                       Style="{StaticResource InvHScrollBar}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                       Value="{TemplateBinding HorizontalOffset}" />
                        </Grid>

                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="PART_HorizontalScrollBar"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.3"
                                                         Duration="0:0:0.5" />
                                        <DoubleAnimation Storyboard.TargetName="PART_HorizontalScrollBar"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.3"
                                                         Duration="0:0:0.5" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ══════════ DATAGRID STYLES ══════════  -->
        <Style x:Key="InvDataGridColumnHeader"
               TargetType="DataGridColumnHeader">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="SeparatorVisibility" Value="Collapsed" />
        </Style>

        <Style x:Key="InvDataGridCell"
               TargetType="DataGridCell">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <SolidColorBrush Opacity="0.06"
                                             Color="{StaticResource PrimaryColor}" />
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InvDataGridRow"
               TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <SolidColorBrush Opacity="0.03"
                                             Color="{StaticResource PrimaryColor}" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  ══════════ POPUP ITEM BUTTON (touch 48px) ══════════  -->
        <Style x:Key="PopupItemBtn"
               TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,1">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg"
                                                 Color="#00000000" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource BorderLightColor}" />
                            </Border.BorderBrush>
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#0A37B1E4"
                                                        Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#00000000"
                                                        Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  🆕 ══════════ RICH TOOLTIP (error-friendly, wrapping) ══════════  -->
        <Style x:Key="ErrorTooltipStyle"
               TargetType="ToolTip">
            <Setter Property="Background" Value="#1C1917" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="MaxWidth" Value="420" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Padding="14,10"
                                Background="#1C1917"
                                CornerRadius="8"
                                Effect="{StaticResource PopupShadow}">
                            <TextBlock MaxWidth="400"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="12"
                                       Foreground="White"
                                       Text="{TemplateBinding Content}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"
                              MinWidth="580" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!--  ══════════════════════════════════════════════════════  -->
        <!--  LEFT PANEL  -->
        <!--  ══════════════════════════════════════════════════════  -->
        <ScrollViewer Grid.Column="0"
                      Padding="32,28,16,28"
                      PanningMode="VerticalOnly"
                      Style="{StaticResource InvPanelScroll}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!--  ═══════════════════════════════════════════  -->
                <!--  HEADER CARD  -->
                <!--  ═══════════════════════════════════════════  -->
                <Border Style="{StaticResource InvCard}">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="22"
                                                         Height="22"
                                                         Margin="0,0,10,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource PrimaryBrush}"
                                                         Kind="ReceiptTextOutline" />
                                <TextBlock Style="{StaticResource InvSectionTitle}"
                                           Text="Nouvelle facture" />
                            </StackPanel>
                            <!--  Mode badge  -->
                            <Border Padding="12,6"
                                    HorizontalAlignment="Right"
                                    CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Opacity="0.1"
                                                                 Color="{StaticResource PrimaryColor}" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHtMode}"
                                                         Value="True">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <SolidColorBrush Opacity="0.12"
                                                                         Color="{StaticResource WarningColor}" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="14"
                                                             Height="14"
                                                             Margin="0,0,5,0"
                                                             VerticalAlignment="Center">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="TagOutline" />
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHtMode}"
                                                                 Value="True">
                                                        <Setter Property="Foreground" Value="#92400E" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Text="{Binding PriceModeDisplay}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHtMode}"
                                                                 Value="True">
                                                        <Setter Property="Foreground" Value="#92400E" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!--  POS display  -->
                        <Border Margin="0,16,0,0"
                                Padding="16,12"
                                CornerRadius="10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Opacity="0.06"
                                                             Color="{StaticResource PrimaryColor}" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="BorderBrush">
                                        <Setter.Value>
                                            <SolidColorBrush Opacity="0.2"
                                                             Color="{StaticResource PrimaryColor}" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPointOfSale}"
                                                     Value="{x:Null}">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Opacity="0.06"
                                                                     Color="{StaticResource ErrorColor}" />
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="BorderBrush">
                                                <Setter.Value>
                                                    <SolidColorBrush Opacity="0.2"
                                                                     Color="{StaticResource ErrorColor}" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,12,0"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="16"
                                                                 Height="16"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{StaticResource PrimaryDarkBrush}"
                                                                 Kind="StorefrontOutline" />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                                   Text="Point de vente" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Visibility="{Binding SelectedPointOfSale, Converter={StaticResource IsNotNullToVisibilityConverter}}">
                                        <Border Margin="0,0,8,0"
                                                Padding="6,3"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource PrimaryLightBrush}"
                                                CornerRadius="4">
                                            <TextBlock FontFamily="Consolas"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryDarkBrush}"
                                                       Text="{Binding SelectedPointOfSale.Code}" />
                                        </Border>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Text="{Binding SelectedPointOfSale.Name}" />
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            Margin="8,0,0,0"
                                            Padding="10,4"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource PrimaryBrush}"
                                            CornerRadius="10"
                                            Visibility="{Binding HasMultiplePos, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="White">
                                            <Run Text="{Binding AvailablePointsOfSale.Count, Mode=OneWay}" />
                                            <Run Text=" POS" />
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <TextBlock Margin="0,4,0,0"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="{Binding SelectedPosInfo}"
                                           Visibility="{Binding SelectedPointOfSale, Converter={StaticResource IsNotNullToVisibilityConverter}}" />

                                <!--  No POS warning  -->
                                <StackPanel Margin="0,6,0,0"
                                            Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedPointOfSale}"
                                                             Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <materialDesign:PackIcon Width="13"
                                                             Height="13"
                                                             Margin="0,0,5,0"
                                                             VerticalAlignment="Center"
                                                             Foreground="#DC2626"
                                                             Kind="AlertOutline" />
                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                               FontSize="10"
                                               FontStyle="Italic"
                                               Foreground="#DC2626"
                                               Text="Aucun point de vente configuré — la normalisation sera bloquée" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  Invoice fields grid  -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,10,10">
                                <TextBlock Style="{StaticResource InvFieldLabel}"
                                           Text="Type" />
                                <ComboBox IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"
                                          ItemsSource="{Binding InvoiceTypes}"
                                          SelectedItem="{Binding SelectedInvoiceType}"
                                          Style="{StaticResource InvComboBox}"
                                          ToolTip="Type de facture (FV, FA, FT…)" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="0,0,10,10">
                                <TextBlock Style="{StaticResource InvFieldLabel}"
                                           Text="N° Facture" />
                                <TextBox Background="{StaticResource BackgroundBrush}"
                                         FontWeight="SemiBold"
                                         IsReadOnly="True"
                                         Style="{StaticResource InvTextBox}"
                                         Text="{Binding InvoiceNumber}"
                                         ToolTip="Numéro de facture généré automatiquement" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource InvFieldLabel}"
                                           Text="Date" />
                                <TextBox Background="{StaticResource BackgroundBrush}"
                                         IsReadOnly="True"
                                         Style="{StaticResource InvTextBox}"
                                         Text="{Binding CurrentDateTime}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource InvFieldLabel}"
                                           Text="Opérateur" />
                                <TextBox Style="{StaticResource InvTextBox}"
                                         Text="{Binding OperatorName}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Grid.Column="2">
                                <TextBlock Style="{StaticResource InvFieldLabel}"
                                           Text="ISF" />
                                <TextBox Background="{StaticResource BackgroundBrush}"
                                         IsReadOnly="True"
                                         Style="{StaticResource InvTextBox}"
                                         Text="{Binding Isf}"
                                         ToolTip="Identifiant du Système de Facturation" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  ═══════════════════════════════════════════  -->
                <!--  CREDIT NOTE (AVOIR)  -->
                <!--  ═══════════════════════════════════════════  -->
                <Border Style="{StaticResource InvCard}"
                        Visibility="{Binding IsCreditNote, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="22"
                                                     Height="22"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource AccentBrush}"
                                                     Kind="FileUndoOutline" />
                            <TextBlock Foreground="{StaticResource AccentBrush}"
                                       Style="{StaticResource InvSectionTitle}"
                                       Text="Facture d'avoir" />
                        </StackPanel>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource InvFieldLabel}"
                                           Text="Nature *" />
                                <ComboBox ItemsSource="{Binding CreditNoteNatures}"
                                          SelectedItem="{Binding SelectedCreditNoteNature}"
                                          Style="{StaticResource InvComboBox}"
                                          ToolTip="Nature de l'avoir : Correction, Annulation, Remboursement ou RRR" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource InvFieldLabel}"
                                           Text="Réf. facture originale (Code DEF/DGI ou RRR) *" />
                                <TextBox FontFamily="Consolas"
                                         IsEnabled="{Binding IsRRR, Converter={StaticResource InverseBoolConverter}}"
                                         Style="{StaticResource InvTextBox}"
                                         Text="{Binding OriginalReference, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Saisir le Code DEF/DGI de la facture originale à rembourser" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    VerticalAlignment="Bottom"
                                    Command="{Binding LookupOriginalInvoiceCommand}"
                                    Style="{StaticResource InvMiniBtn}"
                                    ToolTip="Rechercher et charger la facture originale depuis la référence saisie"
                                    Visibility="{Binding RequiresOriginalLookup, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="14"
                                                             Height="14"
                                                             Margin="0,0,5,0"
                                                             VerticalAlignment="Center"
                                                             Foreground="White"
                                                             Kind="Magnify" />
                                    <TextBlock FontSize="12"
                                               Foreground="White"
                                               Text="Charger" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!--  RRR info  -->
                        <Border Margin="0,12,0,0"
                                Padding="14,10"
                                CornerRadius="8"
                                Visibility="{Binding IsRRR, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Background>
                                <SolidColorBrush Opacity="0.08"
                                                 Color="{StaticResource WarningColor}" />
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="15"
                                                         Height="15"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Top"
                                                         Foreground="#92400E"
                                                         Kind="LightbulbOnOutline" />
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="11"
                                           Foreground="#92400E"
                                           Text="Type RRR : Remise, Ristourne, Rabais — Saisie libre des articles. Référence automatiquement définie à « RRR »."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!--  Original invoice loaded  -->
                        <Border Margin="0,12,0,0"
                                Padding="16,12"
                                CornerRadius="10"
                                Visibility="{Binding IsOriginalLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Background>
                                <SolidColorBrush Opacity="0.06"
                                                 Color="{StaticResource SuccessColor}" />
                            </Border.Background>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16"
                                                             Height="16"
                                                             Margin="0,0,6,0"
                                                             VerticalAlignment="Center"
                                                             Foreground="#065F46"
                                                             Kind="CheckCircleOutline" />
                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#065F46"
                                               Text="Facture originale" />
                                </StackPanel>
                                <TextBlock Margin="22,4,0,0"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding OriginalInvoiceSummary}"
                                           ToolTip="{Binding OriginalInvoiceSummary}" />
                            </StackPanel>
                        </Border>

                        <!--  Items to refund  -->
                        <Border Margin="0,12,0,0"
                                BorderThickness="1"
                                CornerRadius="10"
                                Visibility="{Binding IsOriginalLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource BorderLightColor}" />
                            </Border.BorderBrush>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Padding="16,12"
                                            Background="{StaticResource BackgroundBrush}"
                                            CornerRadius="10,10,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="16"
                                                                     Height="16"
                                                                     Margin="0,0,8,0"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="{StaticResource TextSecondaryBrush}"
                                                                     Kind="FormatListBulleted" />
                                            <TextBlock FontFamily="{StaticResource AppFont}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="Articles à rembourser" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1"
                                            Padding="10,8"
                                            Background="{StaticResource BackgroundBrush}"
                                            CornerRadius="0,10,0,0">
                                        <Button Command="{Binding AddAllSelectedCreditNoteLinesCommand}"
                                                Style="{StaticResource InvAccentBtn}"
                                                ToolTip="Ajouter tous les articles cochés aux lignes de facture">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Width="14"
                                                                         Height="14"
                                                                         Margin="0,0,4,0"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="White"
                                                                         Kind="Plus" />
                                                <TextBlock FontSize="11"
                                                           Foreground="White"
                                                           Text="Ajouter sélection" />
                                            </StackPanel>
                                        </Button>
                                    </Border>
                                </Grid>

                                <ItemsControl Margin="12,8,12,12"
                                              ItemsSource="{Binding CreditNoteSelections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border MinHeight="48"
                                                    Padding="6,10"
                                                    BorderThickness="0,0,0,1">
                                                <Border.BorderBrush>
                                                    <SolidColorBrush Color="{StaticResource BorderLightColor}" />
                                                </Border.BorderBrush>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="90" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox VerticalAlignment="Center"
                                                              IsChecked="{Binding IsSelected}" />
                                                    <StackPanel Grid.Column="1"
                                                                VerticalAlignment="Center">
                                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                                   FontSize="12"
                                                                   FontWeight="Medium"
                                                                   Text="{Binding DisplayName}"
                                                                   ToolTip="{Binding DisplayName}" />
                                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   Text="{Binding DisplayQuantity}"
                                                                   ToolTip="{Binding DisplayQuantity}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontFamily="{StaticResource AppFont}"
                                                               FontSize="11"
                                                               Text="{Binding TaxGroupLabel}" />
                                                    <StackPanel Grid.Column="3"
                                                                Margin="4,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   Text="Quantité" />
                                                        <TextBox MinHeight="34"
                                                                 Padding="8,4"
                                                                 Style="{StaticResource InvTextBox}"
                                                                 Text="{Binding SelectedQuantity, UpdateSourceTrigger=PropertyChanged}"
                                                                 ToolTip="Quantité à rembourser (max indiqué ci-dessus)" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="4"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               FontFamily="{StaticResource AppFont}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource PrimaryBrush}"
                                                               Text="{Binding DisplayPrice}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!--  ═══════════════════════════════════════════  -->
                <!--  ADVANCE PAYMENT (ACOMPTE)  -->
                <!--  ═══════════════════════════════════════════  -->
                <Border Style="{StaticResource InvCard}"
                        Visibility="{Binding ShowAdvanceSection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="22"
                                                     Height="22"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="#7C3AED"
                                                     Kind="CashClock" />
                            <TextBlock Foreground="#7C3AED"
                                       Style="{StaticResource InvSectionTitle}"
                                       Text="Facture d'acompte" />
                        </StackPanel>

                        <Border Margin="0,12,0,14"
                                Padding="16,14"
                                BorderThickness="2"
                                CornerRadius="10">
                            <Border.Background>
                                <SolidColorBrush Color="#F5F3FF" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Opacity="0.4"
                                                 Color="#7C3AED" />
                            </Border.BorderBrush>
                            <StackPanel>
                                <StackPanel Margin="0,0,0,8"
                                            Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16"
                                                             Height="16"
                                                             Margin="0,0,6,0"
                                                             VerticalAlignment="Center"
                                                             Foreground="#7C3AED"
                                                             Kind="CashCheck" />
                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#7C3AED"
                                               Text="Montant de l'acompte reçu" />
                                    <TextBlock FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"
                                               Text=" *" />
                                </StackPanel>
                                <TextBox FontSize="16"
                                         FontWeight="SemiBold"
                                         IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"
                                         Style="{StaticResource InvTextBox}"
                                         Text="{Binding AdvanceAmountInput, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Saisir le montant exact remis par le client (ex : 50000). Les lignes ci-dessus représentent la commande totale ; ce champ contient ce que le client paie maintenant." />
                                <StackPanel Margin="0,8,0,0"
                                            Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="12"
                                                             Height="12"
                                                             Margin="0,0,5,0"
                                                             VerticalAlignment="Top"
                                                             Foreground="#6D28D9"
                                                             Kind="InformationOutline" />
                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                               FontSize="10"
                                               Foreground="#6D28D9"
                                               Text="Les lignes ci-dessus représentent la commande totale. Ce montant est ce que le client verse pour cette facture d'acompte."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,4,0,8"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="Identifiant du groupe d'avances (optionnel — pour lier plusieurs acomptes)" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox FontFamily="Consolas"
                                     Style="{StaticResource InvTextBox}"
                                     Text="{Binding AdvanceGroupId, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Identifiant unique du groupe d'avances" />

                            <Button Grid.Column="1"
                                    Margin="8,0"
                                    Command="{Binding CreateNewAdvanceGroupCommand}"
                                    Style="{StaticResource InvPurpleBtn}"
                                    ToolTip="Générer un nouvel identifiant de groupe d'avances">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="14"
                                                             Height="14"
                                                             Margin="0,0,4,0"
                                                             VerticalAlignment="Center"
                                                             Foreground="White"
                                                             Kind="PlusCircleOutline" />
                                    <TextBlock FontSize="11"
                                               Foreground="White"
                                               Text="Nouveau" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2"
                                    MinHeight="42"
                                    Padding="12,8"
                                    Background="{StaticResource BackgroundBrush}"
                                    BorderThickness="0"
                                    Command="{Binding LoadAdvanceGroupCommand}"
                                    Cursor="Hand"
                                    FontFamily="{StaticResource AppFont}"
                                    FontSize="11"
                                    ToolTip="Charger les avances précédentes de ce groupe">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="14"
                                                             Height="14"
                                                             Margin="0,0,4,0"
                                                             VerticalAlignment="Center"
                                                             Foreground="{StaticResource TextSecondaryBrush}"
                                                             Kind="FolderOpenOutline" />
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="Charger" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!--  Previous advances  -->
                        <ItemsControl Margin="0,12,0,0"
                                      ItemsSource="{Binding PreviousAdvances}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border MinHeight="46"
                                            Margin="0,4"
                                            Padding="14,10"
                                            Background="#F5F3FF"
                                            CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontFamily="{StaticResource AppFont}"
                                                           FontSize="12">
                                                    <Run FontWeight="SemiBold"
                                                         Text="{Binding InvoiceNumber}" />
                                                    <Run Text=" — " />
                                                    <Run Text="{Binding Date, StringFormat=dd/MM/yyyy}" />
                                                </TextBlock>
                                                <TextBlock FontFamily="Consolas"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Text="{Binding CodeDEFDGI}"
                                                           ToolTip="{Binding CodeDEFDGI}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       Foreground="#7C3AED">
                                                <Run Text="{Binding Amount, StringFormat=N2}" />
                                                <Run FontSize="10"
                                                     Text=" CDF" />
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  Total advances  -->
                        <Border Margin="0,12,0,0"
                                Padding="16,12"
                                Background="#EDE9FE"
                                CornerRadius="10"
                                Visibility="{Binding PreviousAdvances.Count, Converter={StaticResource IsGreaterThanZeroConverter}}">
                            <Grid>
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#7C3AED"
                                           Text="Total acomptes versés" />
                                <TextBlock HorizontalAlignment="Right"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#7C3AED">
                                    <Run Text="{Binding AdvancesTotalPaid, StringFormat=N2, Mode=OneWay}" />
                                    <Run FontSize="10"
                                         Text=" CDF" />
                                </TextBlock>
                            </Grid>
                        </Border>

                        <StackPanel Margin="0,12,0,0"
                                    Orientation="Horizontal">
                            <materialDesign:PackIcon Width="13"
                                                     Height="13"
                                                     Margin="0,0,5,0"
                                                     VerticalAlignment="Top"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     Kind="InformationOutline" />
                            <TextBlock FontFamily="{StaticResource AppFont}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="Chaque acompte est une facture normalisée indépendante. Le groupe d'avances permet de les relier pour le suivi."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!--  ═══════════════════════════════════════════  -->
                <!--  PROFORMA SECTION  -->
                <!--  ═══════════════════════════════════════════  -->
                <Border Style="{StaticResource InvCard}"
                        Visibility="{Binding ShowProformaSection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="22"
                                                     Height="22"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="#546E7A"
                                                     Kind="FileDocumentOutline" />
                            <TextBlock Foreground="#546E7A"
                                       Style="{StaticResource InvSectionTitle}"
                                       Text="Document proforma (non fiscal)" />
                        </StackPanel>

                        <Border Margin="0,12,0,0"
                                Padding="16,12"
                                Background="#ECEFF1"
                                CornerRadius="10">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="16"
                                                         Height="16"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Top"
                                                         Foreground="#546E7A"
                                                         Kind="InformationOutline" />
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="11"
                                           Foreground="#37474F"
                                           Text="Une proforma n'est PAS transmise à la DGI. Aucun Code DEF/QR ne sera attribué. Vous pourrez la convertir ultérieurement en facture fiscale (FV, EV, FT ou ET)."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Style="{StaticResource InvFieldLabel}"
                                       Text="Date de validité de l'offre" />
                            <DatePicker MinHeight="42"
                                        Padding="10,8"
                                        FontFamily="{StaticResource AppFont}"
                                        FontSize="13"
                                        SelectedDate="{Binding ProformaValidUntil}"
                                        ToolTip="Date jusqu'à laquelle l'offre proforma est valable. Au-delà, elle ne pourra plus être convertie." />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!--  ═══════════════════════════════════════════  -->
                <!--  CLIENT  -->
                <!--  ═══════════════════════════════════════════  -->
                <Border Style="{StaticResource InvCard}">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="22"
                                                         Height="22"
                                                         Margin="0,0,10,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource PrimaryBrush}"
                                                         Kind="AccountOutline" />
                                <TextBlock Style="{StaticResource InvSectionTitle}"
                                           Text="Client" />
                            </StackPanel>
                            <Border Padding="12,5"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedClientType}"
                                                         Value="PM">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <SolidColorBrush Opacity="0.1"
                                                                         Color="{StaticResource PrimaryColor}" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedClientType}"
                                                         Value="AO">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <SolidColorBrush Opacity="0.12"
                                                                         Color="{StaticResource WarningColor}" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Text="{Binding ClientTypeMention}"
                                           ToolTip="{Binding ClientTypeMention}" />
                            </Border>
                        </Grid>

                        <!--  Type + Search  -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource InvFieldLabel}"
                                           Text="Type *" />
                                <ComboBox IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"
                                          ItemsSource="{Binding ClientTypes}"
                                          SelectedItem="{Binding SelectedClientType}"
                                          Style="{StaticResource InvComboBox}"
                                          ToolTip="PP=Personne physique, PM=Personne morale, PC=Commerçant, PL=Profession libérale, AO=Ambassade/Org." />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="0,0,10,0">
                                <StackPanel Margin="0,0,0,6"
                                            Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="13"
                                                             Height="13"
                                                             Margin="0,0,5,0"
                                                             VerticalAlignment="Center"
                                                             Foreground="{StaticResource TextMutedBrush}"
                                                             Kind="Magnify" />
                                    <TextBlock Margin="0"
                                               Style="{StaticResource InvFieldLabel}"
                                               Text="Rechercher un client existant" />
                                </StackPanel>
                                <Grid>
                                    <TextBox x:Name="ClientSearchBox"
                                             IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"
                                             Style="{StaticResource InvTextBox}"
                                             Text="{Binding ClientSearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                             ToolTip="Taper au moins 2 caractères pour rechercher par nom, NIF ou téléphone" />
                                    <Popup Width="{Binding ActualWidth, ElementName=ClientSearchBox}"
                                           AllowsTransparency="True"
                                           IsOpen="{Binding IsClientSearchOpen, Mode=TwoWay}"
                                           Placement="Bottom"
                                           PlacementTarget="{Binding ElementName=ClientSearchBox}"
                                           PopupAnimation="Fade"
                                           StaysOpen="False">
                                        <Border MaxHeight="300"
                                                Background="White"
                                                BorderThickness="1"
                                                CornerRadius="0,0,12,12"
                                                Effect="{StaticResource PopupShadow}">
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="{StaticResource BorderLightColor}" />
                                            </Border.BorderBrush>
                                            <ScrollViewer PanningMode="VerticalOnly"
                                                          VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding ClientSearchResults}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Command="{Binding DataContext.SelectClientCommand, RelativeSource={RelativeSource AncestorType=Popup}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource PopupItemBtn}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Margin="0,0,12,0"
                                                                            Padding="8,3"
                                                                            VerticalAlignment="Center"
                                                                            Background="{StaticResource BackgroundBrush}"
                                                                            CornerRadius="4">
                                                                        <TextBlock FontFamily="Consolas"
                                                                                   FontSize="10"
                                                                                   FontWeight="Bold"
                                                                                   Text="{Binding Type}" />
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1"
                                                                                VerticalAlignment="Center">
                                                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                                                   FontSize="13"
                                                                                   FontWeight="Medium"
                                                                                   Text="{Binding Name}"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock FontFamily="Consolas"
                                                                                   FontSize="11"
                                                                                   Foreground="{StaticResource TextMutedBrush}">
                                                                            <Run Text="NIF: " /><Run Text="{Binding NIF, TargetNullValue='-'}" />
                                                                            <Run Text=" · " /><Run Text="{Binding Phone, TargetNullValue=''}" />
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                    <materialDesign:PackIcon Grid.Column="2"
                                                                                             Width="16"
                                                                                             Height="16"
                                                                                             Margin="8,0,0,0"
                                                                                             VerticalAlignment="Center"
                                                                                             Foreground="{StaticResource PrimaryBrush}"
                                                                                             Kind="ArrowRight" />
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    VerticalAlignment="Bottom"
                                    Command="{Binding ClearClientCommand}"
                                    Style="{StaticResource InvDangerBtn}"
                                    ToolTip="Vider tous les champs client"
                                    Visibility="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="13"
                                                             Height="13"
                                                             Margin="0,0,4,0"
                                                             VerticalAlignment="Center"
                                                             Foreground="#DC2626"
                                                             Kind="Close" />
                                    <TextBlock FontSize="11"
                                               Foreground="#DC2626"
                                               Text="Vider" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!--  NIF + Name  -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0"
                                               Style="{StaticResource InvFieldLabel}"
                                               Text="NIF" />
                                    <TextBlock FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"
                                               Text=" *"
                                               Visibility="{Binding IsClientNifRequired, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                                <TextBox Margin="0,6,0,0"
                                         IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"
                                         Style="{StaticResource InvTextBox}"
                                         Text="{Binding ClientNIF, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Numéro d'Identification Fiscale — obligatoire pour PM, PC et PL" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0"
                                               Style="{StaticResource InvFieldLabel}"
                                               Text="Nom / Dénomination" />
                                    <TextBlock FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"
                                               Text=" *"
                                               Visibility="{Binding IsClientNameRequired, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                                <TextBox Margin="0,6,0,0"
                                         IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"
                                         Style="{StaticResource InvTextBox}"
                                         Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Nom du client ou dénomination sociale — obligatoire sauf pour PP" />
                            </StackPanel>
                        </Grid>

                        <!--  Address, Phone, Email  -->
                        <Grid Margin="0,12,0,0"
                              Visibility="{Binding ShowClientDetails, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource InvFieldLabel}"
                                           Text="Adresse" />
                                <TextBox IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"
                                         Style="{StaticResource InvTextBox}"
                                         Text="{Binding ClientAddress}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource InvFieldLabel}"
                                           Text="Téléphone" />
                                <TextBox IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"
                                         Style="{StaticResource InvTextBox}"
                                         Text="{Binding ClientPhone}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource InvFieldLabel}"
                                           Text="Email" />
                                <TextBox IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"
                                         Style="{StaticResource InvTextBox}"
                                         Text="{Binding ClientEmail}" />
                            </StackPanel>
                        </Grid>

                        <!--  Save client  -->
                        <Button Margin="0,14,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding SaveClientInlineCommand}"
                                Style="{StaticResource InvSuccessBtn}"
                                ToolTip="Sauvegarder les informations client pour un usage futur"
                                Visibility="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="14"
                                                         Height="14"
                                                         Margin="0,0,5,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="#065F46"
                                                         Kind="ContentSave" />
                                <TextBlock FontSize="11"
                                           Foreground="#065F46"
                                           Text="Enregistrer ce client" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!--  ═══════════════════════════════════════════  -->
                <!--  COMMENTS (A-H)  -->
                <!--  ═══════════════════════════════════════════  -->
                <Border Style="{StaticResource InvCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="22"
                                                     Height="22"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     Kind="CommentTextOutline" />
                            <TextBlock Style="{StaticResource InvSectionTitle}"
                                       Text="Commentaires (lignes A–H)" />
                        </StackPanel>

                        <!--  Line A  -->
                        <Border Margin="0,16,0,0"
                                Padding="16,12"
                                CornerRadius="10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCommentARequired}"
                                                     Value="True">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Opacity="0.06"
                                                                     Color="{StaticResource WarningColor}" />
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="BorderBrush">
                                                <Setter.Value>
                                                    <SolidColorBrush Opacity="0.3"
                                                                     Color="{StaticResource WarningColor}" />
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="BorderThickness" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <StackPanel Margin="0,0,0,8"
                                            Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="{Binding CommentALabel, Mode=OneWay}" />
                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                               FontSize="11"
                                               FontStyle="Italic"
                                               Foreground="#EA580C"
                                               Text=" (obligatoire)"
                                               Visibility="{Binding IsCommentARequired, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                                <TextBox IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"
                                         Style="{StaticResource InvTextBox}"
                                         Text="{Binding CommentA, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Margin="0,8,0,0"
                                            Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCommentARequired}"
                                                             Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <materialDesign:PackIcon Width="12"
                                                             Height="12"
                                                             Margin="0,0,5,0"
                                                             VerticalAlignment="Top"
                                                             Foreground="#EA580C"
                                                             Kind="AlertOutline" />
                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextWrapping="Wrap">
                                        <TextBlock.Inlines>
                                            <Run FontWeight="SemiBold"
                                                 Text="{Binding CommentALabel, Mode=OneWay}" />
                                            <Run Text=" — Ce champ est requis pour ce type de client/article." />
                                        </TextBlock.Inlines>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  Lines B-H  -->
                        <Expander Margin="0,14,0,0"
                                  FontFamily="{StaticResource AppFont}"
                                  FontSize="12"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Header="Lignes B–H (réservées)"
                                  IsExpanded="False">
                            <StackPanel Margin="0,12,0,0">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="B" />
                                    <TextBox Grid.Column="1"
                                             MinHeight="36"
                                             Padding="10,6"
                                             IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"
                                             Style="{StaticResource InvTextBox}"
                                             Text="{Binding CommentB}" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="C" />
                                    <TextBox Grid.Column="1"
                                             MinHeight="36"
                                             Padding="10,6"
                                             IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"
                                             Style="{StaticResource InvTextBox}"
                                             Text="{Binding CommentC}" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="D" />
                                    <TextBox Grid.Column="1"
                                             MinHeight="36"
                                             Padding="10,6"
                                             IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"
                                             Style="{StaticResource InvTextBox}"
                                             Text="{Binding CommentD}" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="E" />
                                    <TextBox Grid.Column="1"
                                             MinHeight="36"
                                             Padding="10,6"
                                             IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"
                                             Style="{StaticResource InvTextBox}"
                                             Text="{Binding CommentE}" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="F" />
                                    <TextBox Grid.Column="1"
                                             MinHeight="36"
                                             Padding="10,6"
                                             IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"
                                             Style="{StaticResource InvTextBox}"
                                             Text="{Binding CommentF}" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="G" />
                                    <TextBox Grid.Column="1"
                                             MinHeight="36"
                                             Padding="10,6"
                                             IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"
                                             Style="{StaticResource InvTextBox}"
                                             Text="{Binding CommentG}" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="H" />
                                    <TextBox Grid.Column="1"
                                             MinHeight="36"
                                             Padding="10,6"
                                             IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"
                                             Style="{StaticResource InvTextBox}"
                                             Text="{Binding CommentH}" />
                                </Grid>
                                <StackPanel Margin="50,6,0,0"
                                            Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="12"
                                                             Height="12"
                                                             Margin="0,0,5,0"
                                                             VerticalAlignment="Center"
                                                             Foreground="{StaticResource TextMutedBrush}"
                                                             Kind="InformationOutline" />
                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                               FontSize="10"
                                               FontStyle="Italic"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="Ces lignes sont réservées par la DGI pour usage futur." />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <!--  ═══════════════════════════════════════════  -->
                <!--  ADD ARTICLE  -->
                <!--  ═══════════════════════════════════════════  -->
                <Border Style="{StaticResource InvCard}"
                        Visibility="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="22"
                                                     Height="22"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     Kind="PackageVariantClosedPlus" />
                            <TextBlock Style="{StaticResource InvSectionTitle}"
                                       Text="Ajouter un article" />
                        </StackPanel>

                        <!--  Row 1: Code, Name, Type, Group  -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Style="{StaticResource InvFieldLabel}"
                                           Text="Code" />
                                <TextBox Style="{StaticResource InvTextBox}"
                                         Text="{Binding ArticleCode}"
                                         ToolTip="Code article (optionnel)" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="0,0,10,10">
                                <TextBlock Style="{StaticResource InvFieldLabel}"
                                           Text="Désignation *" />
                                <Grid>
                                    <TextBox x:Name="ArticleNameBox"
                                             Style="{StaticResource InvTextBox}"
                                             Text="{Binding ArticleName, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                             ToolTip="Nom ou désignation de l'article — obligatoire" />
                                    <Popup MinWidth="400"
                                           AllowsTransparency="True"
                                           IsOpen="{Binding IsSearchPopupOpen, Mode=TwoWay}"
                                           Placement="Bottom"
                                           PlacementTarget="{Binding ElementName=ArticleNameBox}"
                                           PopupAnimation="Fade"
                                           StaysOpen="False">
                                        <Border MinWidth="500"
                                                MaxWidth="700"
                                                MaxHeight="320"
                                                Background="White"
                                                BorderThickness="1"
                                                CornerRadius="0,0,12,12"
                                                Effect="{StaticResource PopupShadow}">
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="{StaticResource BorderLightColor}" />
                                            </Border.BorderBrush>
                                            <ScrollViewer PanningMode="VerticalOnly"
                                                          VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding ProductSearchResults}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Command="{Binding DataContext.SelectProductCommand, RelativeSource={RelativeSource AncestorType=Popup}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource PopupItemBtn}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                                                   FontSize="13"
                                                                                   FontWeight="Medium"
                                                                                   Text="{Binding Name}"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <StackPanel Margin="0,3,0,0"
                                                                                    Orientation="Horizontal">
                                                                            <Border Margin="0,0,6,0"
                                                                                    Padding="5,1"
                                                                                    Background="{StaticResource BackgroundBrush}"
                                                                                    CornerRadius="3">
                                                                                <TextBlock FontFamily="Consolas"
                                                                                           FontSize="10"
                                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                                           Text="{Binding Code}" />
                                                                            </Border>
                                                                            <TextBlock FontFamily="{StaticResource AppFont}"
                                                                                       FontSize="10"
                                                                                       Foreground="{StaticResource TextMutedBrush}">
                                                                                <Run Text="{Binding TaxGroup}" />
                                                                                <Run Text=" · T.S.: " />
                                                                                <Run Text="{Binding SpecificTaxDisplay, Mode=OneWay}" />
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                    <Border Grid.Column="1"
                                                                            Margin="12,0,0,0"
                                                                            Padding="10,4"
                                                                            VerticalAlignment="Center"
                                                                            CornerRadius="6">
                                                                        <Border.Background>
                                                                            <SolidColorBrush Opacity="0.08"
                                                                                             Color="{StaticResource PrimaryColor}" />
                                                                        </Border.Background>
                                                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                                                   FontSize="12"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="{StaticResource PrimaryBrush}"
                                                                                   Text="{Binding UnitPrice, StringFormat='{}{0:N2} CDF'}" />
                                                                    </Border>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Margin="0,0,10,10">
                                <TextBlock Style="{StaticResource InvFieldLabel}"
                                           Text="Type" />
                                <ComboBox ItemsSource="{Binding ItemTypes}"
                                          SelectedItem="{Binding ArticleItemType}"
                                          Style="{StaticResource InvComboBox}"
                                          ToolTip="BIE=Bien, SER=Service" />
                            </StackPanel>

                            <StackPanel Grid.Column="3"
                                        Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource InvFieldLabel}"
                                           Text="Groupe" />
                                <ComboBox ItemsSource="{Binding TaxGroups}"
                                          SelectedItem="{Binding ArticleTaxGroup}"
                                          Style="{StaticResource InvComboBox}"
                                          ToolTip="Groupe fiscal : A=Taxable 16%, B=Taxable 16%, C=Exonéré, D=Dérogatoire" />
                            </StackPanel>
                        </Grid>

                        <!--  Row 2: Price, Qty, Unit  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,10,10">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource InvFieldLabel}"
                                               TargetType="TextBlock">
                                            <Setter Property="Text" Value="Prix unit. TTC *" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHtMode}"
                                                             Value="True">
                                                    <Setter Property="Text" Value="Prix unit. HT *" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Style="{StaticResource InvTextBox}"
                                         Text="{Binding ArticleUnitPrice, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Prix unitaire — doit être un nombre positif" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="0,0,10,10">
                                <TextBlock Style="{StaticResource InvFieldLabel}"
                                           Text="Quantité *" />
                                <TextBox Style="{StaticResource InvTextBox}"
                                         Text="{Binding ArticleQuantity, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Quantité — doit être un nombre positif" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Margin="0,0,10,10">
                                <TextBlock Style="{StaticResource InvFieldLabel}"
                                           Text="Unité" />
                                <ComboBox IsEditable="True"
                                          ItemsSource="{Binding CommonUnits}"
                                          SelectedItem="{Binding ArticleUnit}"
                                          Style="{StaticResource InvComboBox}"
                                          ToolTip="Unité de mesure (pce, kg, L, m, etc.)" />
                            </StackPanel>
                        </Grid>

                        <!--  Specific Tax row  -->
                        <Border Margin="0,6,0,10"
                                Padding="16,12"
                                CornerRadius="10">
                            <Border.Background>
                                <SolidColorBrush Opacity="0.06"
                                                 Color="{StaticResource WarningColor}" />
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="15"
                                                             Height="15"
                                                             Margin="0,0,4,0"
                                                             VerticalAlignment="Center"
                                                             Foreground="#92400E"
                                                             Kind="FlashOutline" />
                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#92400E"
                                               Text="T.S. :" />
                                </StackPanel>

                                <ComboBox Grid.Column="1"
                                          Margin="0,0,10,0"
                                          ItemsSource="{Binding SpecificTaxTypes}"
                                          SelectedItem="{Binding ArticleSpecificTaxType}"
                                          Style="{StaticResource InvComboBox}"
                                          ToolTip="Type de taxe spécifique : Aucune, Montant fixe par unité ou Pourcentage" />

                                <TextBox Grid.Column="2"
                                         Margin="0,0,10,0"
                                         Style="{StaticResource InvTextBox}"
                                         Text="{Binding ArticleSpecificTaxValue, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding ShowArticleSpecificTaxFields, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBox.ToolTip>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Montant fixe par unité (ex : 230)" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ArticleSpecificTaxType}"
                                                                     Value="Percentage">
                                                            <Setter Property="Text" Value="Pourcentage sur HT (ex : 10)" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </TextBox.ToolTip>
                                </TextBox>

                                <ComboBox Grid.Column="3"
                                          ItemsSource="{Binding TaxApplicationModes}"
                                          SelectedItem="{Binding ArticleTaxApplicationMode}"
                                          Style="{StaticResource InvComboBox}"
                                          ToolTip="Mode d'application : Par article (chaque ligne) ou Sur le total (regroupé)"
                                          Visibility="{Binding ShowArticleSpecificTaxFields, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </Border>

                        <!--  T.S. info  -->
                        <Border Margin="0,0,0,10"
                                Padding="14,10"
                                CornerRadius="8"
                                Visibility="{Binding ShowArticleSpecificTaxFields, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Background>
                                <SolidColorBrush Opacity="0.04"
                                                 Color="{StaticResource WarningColor}" />
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="13"
                                                         Height="13"
                                                         Margin="0,0,6,0"
                                                         VerticalAlignment="Top"
                                                         Foreground="#854D0E"
                                                         Kind="InformationOutline" />
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="10"
                                           Foreground="#854D0E"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Montant fixe par unité · Par article : appliqué sur chaque ligne" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ArticleSpecificTaxType}" Value="Percentage" />
                                                        <Condition Binding="{Binding ArticleTaxApplicationMode}" Value="PerArticle" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Text" Value="Pourcentage appliqué sur le montant HT · Par article : appliqué sur chaque ligne" />
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ArticleSpecificTaxType}" Value="FixedPerUnit" />
                                                        <Condition Binding="{Binding ArticleTaxApplicationMode}" Value="OnTotal" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Text" Value="Montant fixe par unité · Sur le total : T.S. différée, calculée une seule fois sur le sous-total regroupé" />
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ArticleSpecificTaxType}" Value="Percentage" />
                                                        <Condition Binding="{Binding ArticleTaxApplicationMode}" Value="OnTotal" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Text" Value="Pourcentage appliqué sur le montant HT · Sur le total : T.S. différée, calculée une seule fois sur le sous-total regroupé" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!--  Discount + Add button  -->
                        <Border Margin="0,6,0,10"
                                Padding="16,12"
                                CornerRadius="10">
                            <Border.Background>
                                <SolidColorBrush Opacity="0.04"
                                                 Color="{StaticResource ErrorColor}" />
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="15"
                                                             Height="15"
                                                             Margin="0,0,4,0"
                                                             VerticalAlignment="Center"
                                                             Foreground="#DC2626"
                                                             Kind="PercentOutline" />
                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                               FontSize="12"
                                               Foreground="#DC2626"
                                               Text="Remise :" />
                                </StackPanel>

                                <ComboBox Grid.Column="1"
                                          Margin="0,0,10,0"
                                          ItemsSource="{Binding DiscountTypes}"
                                          SelectedItem="{Binding ArticleDiscountType}"
                                          Style="{StaticResource InvComboBox}"
                                          ToolTip="Type de remise : Aucune, Pourcentage ou Montant fixe" />

                                <TextBox Grid.Column="2"
                                         Margin="0,0,10,0"
                                         Style="{StaticResource InvTextBox}"
                                         Text="{Binding ArticleDiscountValue, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Valeur de la remise (% ou montant fixe)" />

                                <StackPanel Grid.Column="3" />

                                <!--  🆕 Tooltip on Add button  -->
                                <Button Grid.Column="4"
                                        VerticalAlignment="Center"
                                        Command="{Binding AddArticleCommand}"
                                        Style="{StaticResource InvPrimaryBtn}"
                                        ToolTip="Ajouter cet article aux lignes de facture">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="16"
                                                                 Height="16"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="White"
                                                                 Kind="Plus" />
                                        <TextBlock Foreground="White"
                                                   Text="Ajouter" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!--  ═══════════════════════════════════════════  -->
                <!--  INVOICE LINES GRID  -->
                <!--  ═══════════════════════════════════════════  -->
                <Border Style="{StaticResource InvCard}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,16"
                                    Orientation="Horizontal">
                            <materialDesign:PackIcon Width="22"
                                                     Height="22"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     Kind="FormatListNumbered" />
                            <TextBlock Style="{StaticResource InvSectionTitle}"
                                       Text="Lignes de facture" />
                        </StackPanel>

                        <DataGrid MaxHeight="360"
                                  AutoGenerateColumns="False"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="False"
                                  CellStyle="{StaticResource InvDataGridCell}"
                                  ColumnHeaderStyle="{StaticResource InvDataGridColumnHeader}"
                                  FontFamily="{StaticResource AppFont}"
                                  FontSize="12"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  HorizontalScrollBarVisibility="Auto"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding InvoiceLines}"
                                  RowStyle="{StaticResource InvDataGridRow}"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  VerticalScrollBarVisibility="Auto">

                            <DataGrid.Columns>
                                <DataGridTextColumn Width="40"
                                                    MinWidth="40"
                                                    Binding="{Binding LineNumber}"
                                                    Header="#" />

                                <DataGridTextColumn Width="*"
                                                    MinWidth="180"
                                                    Binding="{Binding Name}"
                                                    Header="Désignation">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="ToolTip" Value="{Binding Name}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="75"
                                                    MinWidth="75"
                                                    Binding="{Binding TaxGroupDisplay}"
                                                    Header="Groupe">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="FontWeight" Value="Medium" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="100"
                                                    MinWidth="90"
                                                    Binding="{Binding UnitPriceHT, StringFormat=N2}"
                                                    Header="P.U. HT">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="60"
                                                    MinWidth="50"
                                                    Binding="{Binding Quantity, StringFormat=N3}"
                                                    Header="Qté">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="60"
                                                    MinWidth="50"
                                                    Binding="{Binding Unit}"
                                                    Header="Unité">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="75"
                                                    MinWidth="65"
                                                    Binding="{Binding DiscountDisplay}"
                                                    Header="Remise">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#DC2626" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="TextAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Width="80"
                                                        MinWidth="70"
                                                        Header="T.S.">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding HasSpecificTax, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock HorizontalAlignment="Center"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="10"
                                                           FontWeight="Medium"
                                                           Foreground="#92400E"
                                                           Text="{Binding SpecificTaxDisplay}" />
                                                <TextBlock HorizontalAlignment="Center"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="9"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Text="{Binding TaxSpecificAmount, StringFormat=N2}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Width="100"
                                                    MinWidth="90"
                                                    Binding="{Binding AmountHT, StringFormat=N2}"
                                                    Header="H.T.">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="85"
                                                    MinWidth="75"
                                                    Binding="{Binding AmountTVA, StringFormat=N2}"
                                                    Header="TVA">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="110"
                                                    MinWidth="95"
                                                    Binding="{Binding AmountTTC, StringFormat=N2}"
                                                    Header="TTC">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                            <Setter Property="TextAlignment" Value="Right" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!--  🆕 FIX: Remove button with DataTrigger visibility + proper hover template + tooltip  -->
                                <DataGridTemplateColumn Width="50"
                                                        MinWidth="50"
                                                        Header="">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.RemoveArticleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Supprimer cette ligne de la facture">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Cursor" Value="Hand" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Setter Property="Width" Value="36" />
                                                        <Setter Property="Height" Value="36" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="RemBd"
                                                                            Width="36"
                                                                            Height="36"
                                                                            CornerRadius="8">
                                                                        <Border.Background>
                                                                            <SolidColorBrush x:Name="RemBg"
                                                                                             Color="Transparent" />
                                                                        </Border.Background>
                                                                        <materialDesign:PackIcon Width="16"
                                                                                                 Height="16"
                                                                                                 HorizontalAlignment="Center"
                                                                                                 VerticalAlignment="Center"
                                                                                                 Foreground="#EF4444"
                                                                                                 Kind="DeleteOutline" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <EventTrigger RoutedEvent="MouseEnter">
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <ColorAnimation Storyboard.TargetName="RemBg"
                                                                                                    Storyboard.TargetProperty="Color"
                                                                                                    To="#FEE2E2"
                                                                                                    Duration="0:0:0.12" />
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </EventTrigger>
                                                                        <EventTrigger RoutedEvent="MouseLeave">
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <ColorAnimation Storyboard.TargetName="RemBg"
                                                                                                    Storyboard.TargetProperty="Color"
                                                                                                    To="Transparent"
                                                                                                    Duration="0:0:0.18" />
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </EventTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <!--  🆕 FIX: Use DataTrigger instead of InverseBoolConverter for Visibility  -->
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsNormalized, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                         Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!--  Empty state  -->
                        <StackPanel Margin="0,28,0,16"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding InvoiceLines.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                            <materialDesign:PackIcon Width="36"
                                                     Height="36"
                                                     Margin="0,0,0,10"
                                                     HorizontalAlignment="Center"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     Kind="PackageVariantRemove" />
                            <TextBlock HorizontalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="Aucun article ajouté" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!--  ══════════════════════════════════════════════════════  -->
        <!--  RIGHT PANEL  -->
        <!--  ══════════════════════════════════════════════════════  -->
        <ScrollViewer Grid.Column="1"
                      Padding="16,28,32,28"
                      PanningMode="VerticalOnly"
                      Style="{StaticResource InvPanelScroll}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!--  ═══ TAX SUMMARY ═══  -->
                <Border Style="{StaticResource InvCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="20"
                                                     Height="20"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     Kind="CalculatorVariantOutline" />
                            <TextBlock Style="{StaticResource InvSectionTitle}"
                                       Text="Résumé fiscal" />
                        </StackPanel>

                        <ItemsControl Margin="0,16,0,0"
                                      ItemsSource="{Binding TaxGroupSummaries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="{Binding Label}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontFamily="{StaticResource AppFont}"
                                                       FontSize="12"
                                                       Text="{Binding TotalHT, StringFormat='HT: {0:N2}'}" />
                                            <TextBlock Grid.Column="1"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       Text="{Binding TotalTVA, StringFormat='TVA: {0:N2}'}" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="0,10"
                                   Background="{StaticResource BorderLightBrush}" />

                        <!--  Totals detail  -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition MinHeight="28" />
                                <RowDefinition MinHeight="28" />
                                <RowDefinition MinHeight="28" />
                                <RowDefinition MinHeight="28" />
                                <RowDefinition MinHeight="28" />
                                <RowDefinition MinHeight="28" />
                                <RowDefinition MinHeight="28" />
                                <RowDefinition MinHeight="28" />
                            </Grid.RowDefinitions>

                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="Sous-total avant remise"
                                       Visibility="{Binding HasAnyDiscount, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="{Binding TotalHTBeforeDiscount, StringFormat=N2}"
                                       TextDecorations="Strikethrough"
                                       Visibility="{Binding HasAnyDiscount, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <StackPanel Grid.Row="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Visibility="{Binding HasAnyDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                <materialDesign:PackIcon Width="13"
                                                         Height="13"
                                                         Margin="0,0,4,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="#DC2626"
                                                         Kind="PercentOutline" />
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="12"
                                           Foreground="#DC2626"
                                           Text="Remise" />
                            </StackPanel>
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#DC2626"
                                       Text="{Binding TotalDiscount, StringFormat='-{0:N2}'}"
                                       Visibility="{Binding HasAnyDiscount, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <TextBlock Grid.Row="2"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="13"
                                       Text="Total H.T." />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="13"
                                       Text="{Binding TotalHT, StringFormat=N2}" />

                            <TextBlock Grid.Row="3"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="13"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Text="Total TVA" />
                            <TextBlock Grid.Row="3"
                                       Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="13"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Text="{Binding TotalTVA, StringFormat=N2}" />

                            <StackPanel Grid.Row="4"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Visibility="{Binding HasFixedSpecificTax, Converter={StaticResource BoolToVisibilityConverter}}">
                                <materialDesign:PackIcon Width="13"
                                                         Height="13"
                                                         Margin="0,0,4,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="#92400E"
                                                         Kind="FlashOutline" />
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="12"
                                           Foreground="#92400E"
                                           Text="T.S. fixe / unité" />
                            </StackPanel>
                            <TextBlock Grid.Row="4"
                                       Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="12"
                                       Foreground="#92400E"
                                       Text="{Binding TotalFixedSpecificTax, StringFormat=N2}"
                                       Visibility="{Binding HasFixedSpecificTax, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <StackPanel Grid.Row="5"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Visibility="{Binding HasPercentSpecificTax, Converter={StaticResource BoolToVisibilityConverter}}">
                                <materialDesign:PackIcon Width="13"
                                                         Height="13"
                                                         Margin="0,0,4,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="#92400E"
                                                         Kind="FlashOutline" />
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="12"
                                           Foreground="#92400E"
                                           Text="T.S. pourcentage" />
                            </StackPanel>
                            <TextBlock Grid.Row="5"
                                       Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="12"
                                       Foreground="#92400E"
                                       Text="{Binding TotalPercentSpecificTax, StringFormat=N2}"
                                       Visibility="{Binding HasPercentSpecificTax, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <StackPanel Grid.Row="6"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Visibility="{Binding HasAnySpecificTax, Converter={StaticResource BoolToVisibilityConverter}}">
                                <materialDesign:PackIcon Width="14"
                                                         Height="14"
                                                         Margin="0,0,4,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="#92400E"
                                                         Kind="Flash" />
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#92400E"
                                           Text="Total taxe spécifique" />
                            </StackPanel>
                            <TextBlock Grid.Row="6"
                                       Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#92400E"
                                       Text="{Binding TotalSpecificTax, StringFormat=N2}"
                                       Visibility="{Binding HasAnySpecificTax, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <TextBlock Grid.Row="7"
                                       Margin="0,4,0,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="Total TTC" />
                            <TextBlock Grid.Row="7"
                                       Grid.Column="1"
                                       Margin="0,4,0,0"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="{Binding TotalTTC, StringFormat=N2}" />
                        </Grid>

                        <!--  Grand total  -->
                        <Border Margin="0,16,0,0"
                                Padding="18,14"
                                CornerRadius="12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Opacity="0.08"
                                                             Color="{StaticResource PrimaryColor}" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHtMode}"
                                                     Value="True">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Opacity="0.08"
                                                                     Color="{StaticResource WarningColor}" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <StackPanel>
                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Text="{Binding GrandTotalLabel}" />
                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Montant toutes taxes comprises" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHtMode}"
                                                                 Value="True">
                                                        <Setter Property="Text" Value="Montant hors taxes · TVA en sus" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}">
                                    <Run Text="{Binding GrandTotal, StringFormat=N2, Mode=OneWay}" />
                                    <Run FontSize="12"
                                         Text=" CDF" />
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!--  HT mode: à payer TTC  -->
                        <Border Margin="0,10,0,0"
                                Padding="16,12"
                                CornerRadius="10"
                                Visibility="{Binding IsHtMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Background>
                                <SolidColorBrush Opacity="0.06"
                                                 Color="{StaticResource SuccessColor}" />
                            </Border.Background>
                            <Grid>
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#065F46"
                                           Text="À payer (TTC)" />
                                <TextBlock HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#065F46">
                                    <Run Text="{Binding TotalTTC, StringFormat=N2, Mode=OneWay}" />
                                    <Run FontSize="11"
                                         Text=" CDF" />
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!--  Alternate currency  -->
                        <Border Margin="0,10,0,0"
                                Padding="16,12"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource BackgroundColor}" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource BorderLightColor}" />
                            </Border.BorderBrush>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Width="18"
                                                         Height="18"
                                                         Margin="0,0,10,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource TextMutedBrush}"
                                                         Kind="SwapHorizontal" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}">
                                    <Run Text="Équivalent " />
                                    <Run Text="{Binding AlternateCurrencyLabel, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Grid.Column="2"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}">
                                    <Run Text="{Binding TotalInAlternateCurrency, StringFormat=N2, Mode=OneWay}" />
                                    <Run FontSize="10"
                                         Text=" " />
                                    <Run FontSize="10"
                                         Text="{Binding AlternateCurrencyLabel, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!--  ═══ PAYMENTS ═══  -->
                <Border Style="{StaticResource InvCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="20"
                                                     Height="20"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     Kind="CreditCardOutline" />
                            <TextBlock Style="{StaticResource InvSectionTitle}"
                                       Text="Paiements" />
                        </StackPanel>

                        <Grid Margin="0,16,0,10"
                              Visibility="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Margin="0,0,8,0"
                                      ItemsSource="{Binding PaymentTypes}"
                                      SelectedItem="{Binding SelectedPaymentType}"
                                      Style="{StaticResource InvComboBox}"
                                      ToolTip="Mode de paiement" />
                            <TextBox Grid.Column="1"
                                     Margin="0,0,8,0"
                                     Style="{StaticResource InvTextBox}"
                                     Text="{Binding PaymentAmount}"
                                     ToolTip="Montant du paiement — laisser vide pour le montant restant" />
                            <Button Grid.Column="2"
                                    Padding="12,8"
                                    Command="{Binding AddPaymentCommand}"
                                    Style="{StaticResource InvMiniBtn}"
                                    ToolTip="Ajouter ce paiement">
                                <materialDesign:PackIcon Width="18"
                                                         Height="18"
                                                         Foreground="White"
                                                         Kind="Plus" />
                            </Button>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding PaymentItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="40"
                                          Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="13"
                                                   Text="{Binding Label}" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="0,0,10,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Amount, StringFormat=N2}" />
                                        <Button Grid.Column="2"
                                                Width="36"
                                                Height="36"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.RemovePaymentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                ToolTip="Supprimer ce paiement">
                                            <materialDesign:PackIcon Width="14"
                                                                     Height="14"
                                                                     Foreground="#EF4444"
                                                                     Kind="Close" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="0,8"
                                   Background="{StaticResource BorderLightBrush}" />
                        <Grid MinHeight="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="Reste à payer (TTC)" />
                            <TextBlock Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Text="{Binding Remaining, StringFormat=N2}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Remaining}"
                                                         Value="0">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  ═══ PENDING INVOICES ═══  -->
                <Border Style="{StaticResource InvCard}"
                        Visibility="{Binding IsProforma, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="20"
                                                         Height="20"
                                                         Margin="0,0,10,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource WarningBrush}"
                                                         Kind="ClockOutline" />
                                <TextBlock Style="{StaticResource InvSectionTitle}"
                                           Text="Factures en attente" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <Button Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding CheckPendingInvoicesCommand}"
                                        Style="{StaticResource InvSuccessBtn}"
                                        ToolTip="Interroger le dispositif fiscal pour lister les factures en attente">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="14"
                                                                 Height="14"
                                                                 Margin="0,0,5,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="#065F46"
                                                                 Kind="Refresh" />
                                        <TextBlock FontSize="11"
                                                   Foreground="#065F46"
                                                   Text="Vérifier" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding CancelAllPendingCommand}"
                                        Style="{StaticResource InvDangerBtn}"
                                        ToolTip="Annuler toutes les factures en attente"
                                        Visibility="{Binding HasPendingInvoices, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="13"
                                                                 Height="13"
                                                                 Margin="0,0,4,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="#DC2626"
                                                                 Kind="TrashCanOutline" />
                                        <TextBlock FontSize="11"
                                                   Foreground="#DC2626"
                                                   Text="Annuler" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!--  Pending status  -->
                        <Border Margin="0,14,0,0"
                                Padding="14,10"
                                CornerRadius="10"
                                Visibility="{Binding ShowPendingSection, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Opacity="0.06"
                                                             Color="{StaticResource SuccessColor}" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPendingInvoices}"
                                                     Value="True">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Opacity="0.08"
                                                                     Color="{StaticResource WarningColor}" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                <materialDesign:PackIcon Margin="0,0,8,0"
                                                         VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="CheckCircleOutline" />
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            <Setter Property="Width" Value="16" />
                                            <Setter Property="Height" Value="16" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasPendingInvoices}"
                                                             Value="True">
                                                    <Setter Property="Kind" Value="AlertCircleOutline" />
                                                    <Setter Property="Foreground" Value="#92400E" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Aucune facture en attente" />
                                            <Setter Property="Foreground" Value="#065F46" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasPendingInvoices}"
                                                             Value="True">
                                                    <Setter Property="Foreground" Value="#92400E" />
                                                    <Setter Property="Text" Value="{Binding PendingInvoiceCount, StringFormat='{}{0} facture(s) en attente'}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!--  Pending list  -->
                        <ItemsControl Margin="0,10,0,0"
                                      ItemsSource="{Binding PendingInvoices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border MinHeight="48"
                                            Margin="0,4"
                                            Padding="14,10"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <Border.Background>
                                            <SolidColorBrush Opacity="0.05"
                                                             Color="{StaticResource WarningColor}" />
                                        </Border.Background>
                                        <Border.BorderBrush>
                                            <SolidColorBrush Opacity="0.2"
                                                             Color="{StaticResource WarningColor}" />
                                        </Border.BorderBrush>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontFamily="Consolas"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           ToolTip="{Binding Uid}">
                                                    <Run Text="UID: " /><Run Text="{Binding Uid}" />
                                                </TextBlock>
                                                <TextBlock FontFamily="{StaticResource AppFont}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}">
                                                    <Run Text="Date: " /><Run Text="{Binding Date, StringFormat=dd/MM/yyyy}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.CancelPendingInvoiceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Uid}"
                                                    Style="{StaticResource InvDangerBtn}"
                                                    ToolTip="Annuler cette facture en attente">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Width="12"
                                                                             Height="12"
                                                                             Margin="0,0,4,0"
                                                                             VerticalAlignment="Center"
                                                                             Foreground="#DC2626"
                                                                             Kind="Close" />
                                                    <TextBlock FontSize="11"
                                                               Foreground="#DC2626"
                                                               Text="Annuler" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  Manual UID  -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox FontFamily="Consolas"
                                     Style="{StaticResource InvTextBox}"
                                     Text="{Binding CancelUid, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Saisir manuellement le UID d'une facture en attente à annuler" />
                            <Button Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Command="{Binding CancelPendingInvoiceCommand}"
                                    Style="{StaticResource InvAccentBtn}"
                                    ToolTip="Annuler la facture correspondant au UID saisi">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="13"
                                                             Height="13"
                                                             Margin="0,0,4,0"
                                                             VerticalAlignment="Center"
                                                             Foreground="White"
                                                             Kind="TrashCanOutline" />
                                    <TextBlock FontSize="11"
                                               Foreground="White"
                                               Text="Annuler" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <StackPanel Margin="0,8,0,0"
                                    Orientation="Horizontal">
                            <materialDesign:PackIcon Width="12"
                                                     Height="12"
                                                     Margin="0,0,5,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     Kind="InformationOutline" />
                            <TextBlock FontFamily="{StaticResource AppFont}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="Saisir un UID ou cliquer « Vérifier » pour lister" />
                        </StackPanel>

                        <!--  🆕 Pending status messages — with tooltip for full text  -->
                        <Border Margin="0,12,0,0"
                                Padding="14,10"
                                CornerRadius="8"
                                ToolTip="{Binding PendingStatusMessage}"
                                Visibility="{Binding ShowPendingSuccess, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Background>
                                <SolidColorBrush Opacity="0.06"
                                                 Color="{StaticResource SuccessColor}" />
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="15"
                                                         Height="15"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource SuccessBrush}"
                                                         Kind="CheckCircleOutline" />
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource SuccessBrush}"
                                           Text="{Binding PendingStatusMessage}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,12,0,0"
                                Padding="14,10"
                                CornerRadius="8"
                                ToolTip="{Binding PendingStatusMessage}"
                                Visibility="{Binding ShowPendingError, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Background>
                                <SolidColorBrush Opacity="0.06"
                                                 Color="{StaticResource ErrorColor}" />
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="15"
                                                         Height="15"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource ErrorBrush}"
                                                         Kind="AlertCircleOutline" />
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource ErrorBrush}"
                                           Text="{Binding PendingStatusMessage}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!--  ═══ ACTIONS ═══  -->
                <Border Style="{StaticResource InvCard}">
                    <StackPanel>
                        <!--  🆕 Normalize button with dynamic tooltip  -->
                        <Button Margin="0,0,0,12"
                                HorizontalContentAlignment="Center"
                                Command="{Binding NormalizeInvoiceCommand}"
                                IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"
                                Style="{StaticResource NormalizeBtn}">
                            <Button.ToolTip>
                                <TextBlock MaxWidth="350"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Envoyer la facture au dispositif fiscal pour normalisation DGI" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProforma}"
                                                             Value="True">
                                                    <Setter Property="Text" Value="Enregistrer la proforma (aucun envoi à la DGI)" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsNormalized}"
                                                             Value="True">
                                                    <Setter Property="Text" Value="Document déjà finalisé" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="22"
                                                         Height="22"
                                                         Margin="0,0,10,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="White">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="ShieldLockOutline" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProforma}"
                                                             Value="True">
                                                    <Setter Property="Kind" Value="ContentSaveOutline" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="White">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="NORMALISER LA FACTURE" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProforma}"
                                                             Value="True">
                                                    <Setter Property="Text" Value="ENREGISTRER LA PROFORMA" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <Button HorizontalContentAlignment="Center"
                                Command="{Binding NewInvoiceCommand}"
                                Style="{StaticResource InvPrimaryBtn}"
                                ToolTip="Réinitialiser le formulaire pour créer une nouvelle facture">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="16"
                                                         Height="16"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="White"
                                                         Kind="FilePlusOutline" />
                                <TextBlock Foreground="White"
                                           Text="Nouvelle facture" />
                            </StackPanel>
                        </Button>

                        <!--  🆕 Success / Error — with tooltip for full message  -->
                        <Border Margin="0,14,0,0"
                                Padding="16,12"
                                CornerRadius="10"
                                ToolTip="{Binding StatusMessage}"
                                ToolTipService.ShowDuration="30000"
                                Visibility="{Binding ShowSuccess, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Background>
                                <SolidColorBrush Opacity="0.06"
                                                 Color="{StaticResource SuccessColor}" />
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="16"
                                                         Height="16"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Top"
                                                         Foreground="{StaticResource SuccessBrush}"
                                                         Kind="CheckCircleOutline" />
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="13"
                                           Foreground="{StaticResource SuccessBrush}"
                                           Text="{Binding StatusMessage}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,14,0,0"
                                Padding="16,12"
                                CornerRadius="10"
                                ToolTip="{Binding StatusMessage}"
                                ToolTipService.ShowDuration="30000"
                                Visibility="{Binding ShowError, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Background>
                                <SolidColorBrush Opacity="0.06"
                                                 Color="{StaticResource ErrorColor}" />
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="16"
                                                         Height="16"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Top"
                                                         Foreground="{StaticResource ErrorBrush}"
                                                         Kind="AlertCircleOutline" />
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="13"
                                           Foreground="{StaticResource ErrorBrush}"
                                           Text="{Binding StatusMessage}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!--  ═══ SECURITY ═══  -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource InvCard}"
                               TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsNormalized}" Value="True" />
                                        <Condition Binding="{Binding IsProforma}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="22"
                                                     Height="22"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource SuccessBrush}"
                                                     Kind="ShieldCheckOutline" />
                            <TextBlock Foreground="{StaticResource SuccessBrush}"
                                       Style="{StaticResource InvSectionTitle}"
                                       Text="Éléments de sécurité" />
                        </StackPanel>

                        <Border Margin="0,16,0,0"
                                Padding="20,16"
                                CornerRadius="12">
                            <Border.Background>
                                <SolidColorBrush Opacity="0.05"
                                                 Color="{StaticResource SuccessColor}" />
                            </Border.Background>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="CODE DEF/DGI" />
                                <TextBlock Margin="0,4,0,0"
                                           HorizontalAlignment="Center"
                                           FontFamily="Consolas"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Text="{Binding CodeDEFDGI}"
                                           ToolTip="{Binding CodeDEFDGI}" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition MinHeight="28" />
                                <RowDefinition MinHeight="28" />
                                <RowDefinition MinHeight="28" />
                            </Grid.RowDefinitions>

                            <TextBlock Margin="0,0,14,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="DEF NIM:" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Text="{Binding Nim}"
                                       ToolTip="{Binding Nim}" />

                            <TextBlock Grid.Row="1"
                                       Margin="0,0,14,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="Compteurs:" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Text="{Binding Counters}"
                                       ToolTip="{Binding Counters}" />

                            <TextBlock Grid.Row="2"
                                       Margin="0,0,14,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="Date DEF:" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Text="{Binding DeviceDateTime}" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>