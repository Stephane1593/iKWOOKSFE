<UserControl x:Class="SFE.WPF.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SFE.WPF.Converters"
             Background="#F1F5F9">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
        <conv:StringToColorBrushConverter x:Key="StrBrush"/>

        <!-- ═══ FLAT BUTTON ═══ -->
        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ GHOST BUTTON ═══ -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ SEARCH TEXTBOX ═══ -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ph"
                                           Text="🔍  Rechercher un rapport…"
                                           Foreground="#94A3B8"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="bd" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ LIST ITEM CONTAINER ═══ -->
        <Style x:Key="ReportListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="12,10"
                                BorderThickness="2"
                                BorderBrush="Transparent"
                                Cursor="Hand"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="bd" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ ROW 0 — HEADER ═══ -->
            <Border Grid.Row="0" Background="White"
                    Padding="24,16" BorderBrush="#E2E8F0"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Historique des rapports"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="#0F172A"/>
                        <TextBlock Foreground="#64748B" FontSize="12" Margin="0,3,0,0">
                            <Run Text="Consulter les rapports Z, X et A générés — "/>
                            <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text=" rapports au total"/>
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource GhostBtn}"
                            Command="{Binding RefreshCommand}"
                            Content="🔄  Actualiser" FontSize="12"/>
                </Grid>
            </Border>

            <!-- ═══ ROW 1 — STATS STRIP ═══ -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="16,12,16,0">

                <!-- Z -->
                <Border Background="White" CornerRadius="8" Padding="14,10"
                        Margin="0,0,4,0" BorderBrush="#FEE2E2" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#FEF2F2" CornerRadius="6"
                                Width="34" Height="34" Margin="0,0,10,0">
                            <TextBlock Text="Z" FontWeight="Bold"
                                       Foreground="#DC2626" FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Foreground="#1E293B" FontSize="13" FontWeight="SemiBold">
                                <Run Text="{Binding ZCount, Mode=OneWay}"/>
                                <Run Text=" Z-Rapports"/>
                            </TextBlock>
                            <TextBlock Text="{Binding LastZInfo}" FontSize="11"
                                       Foreground="#94A3B8" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- X -->
                <Border Background="White" CornerRadius="8" Padding="14,10"
                        Margin="4,0,4,0" BorderBrush="#BFDBFE" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#EFF6FF" CornerRadius="6"
                                Width="34" Height="34" Margin="0,0,10,0">
                            <TextBlock Text="X" FontWeight="Bold"
                                       Foreground="#2563EB" FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Foreground="#1E293B" FontSize="13" FontWeight="SemiBold">
                                <Run Text="{Binding XCount, Mode=OneWay}"/>
                                <Run Text=" X-Rapports"/>
                            </TextBlock>
                            <TextBlock Text="{Binding LastXInfo}" FontSize="11"
                                       Foreground="#94A3B8" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- A -->
                <Border Background="White" CornerRadius="8" Padding="14,10"
                        Margin="4,0,0,0" BorderBrush="#A7F3D0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#ECFDF5" CornerRadius="6"
                                Width="34" Height="34" Margin="0,0,10,0">
                            <TextBlock Text="A" FontWeight="Bold"
                                       Foreground="#059669" FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Foreground="#1E293B" FontSize="13" FontWeight="SemiBold">
                                <Run Text="{Binding ACount, Mode=OneWay}"/>
                                <Run Text=" A-Rapports"/>
                            </TextBlock>
                            <TextBlock Text="{Binding LastAInfo}" FontSize="11"
                                       Foreground="#94A3B8" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- ═══ ROW 2 — LIST + PREVIEW ═══ -->
            <Grid Grid.Row="2" Margin="16,12,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ─── LEFT: LIST ─── -->
                <Border Background="White" CornerRadius="10"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search + Filter bar -->
                        <Border Padding="10,10,10,6" BorderBrush="#E2E8F0"
                                BorderThickness="0,0,0,1">
                            <StackPanel>
                                <!-- Search -->
                                <TextBox Style="{StaticResource SearchBox}"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,8"/>

                                <!-- Filter + count -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox ItemsSource="{Binding FilterOptions}"
                                              SelectedItem="{Binding SelectedFilter}"
                                              FontSize="12" MinWidth="110"
                                              VerticalContentAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontSize="11" Foreground="#94A3B8"
                                               Margin="10,0,0,0">
                                        <Run Text="{Binding Reports.Count, Mode=OneWay}"/>
                                        <Run Text=" résultat(s)"/>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- List -->
                        <ListBox Grid.Row="2"
                                 ItemsSource="{Binding Reports}"
                                 SelectedItem="{Binding SelectedReport}"
                                 ItemContainerStyle="{StaticResource ReportListItem}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="6"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Badge -->
                                        <Border Width="34" Height="34"
                                                CornerRadius="8"
                                                Background="{Binding TypeBgColor, Converter={StaticResource StrBrush}}"
                                                Margin="0,0,10,0">
                                            <TextBlock Text="{Binding TypeBadge}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="Bold" FontSize="13"
                                                       Foreground="{Binding TypeColor, Converter={StaticResource StrBrush}}"/>
                                        </Border>

                                        <!-- Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold" FontSize="12.5"
                                                       Foreground="#1E293B"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding DateLabel}"
                                                           FontSize="11" Foreground="#94A3B8"/>
                                                <TextBlock Text="  •  " FontSize="11"
                                                           Foreground="#CBD5E1"/>
                                                <TextBlock Text="{Binding OperatorName}"
                                                           FontSize="11" Foreground="#94A3B8"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Amount -->
                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding TotalLabel}"
                                                       FontWeight="SemiBold" FontSize="12"
                                                       Foreground="#1E293B"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding InvoiceCountLabel}"
                                                       FontSize="11" Foreground="#94A3B8"
                                                       HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty state -->
                        <StackPanel Grid.Row="2"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding NoResults, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="📋" FontSize="32"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Aucun rapport trouvé"
                                       FontSize="13" Foreground="#94A3B8"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                            <TextBlock Text="Modifiez le filtre ou la recherche"
                                       FontSize="11" Foreground="#CBD5E1"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ─── RIGHT: PREVIEW ─── -->
                <Border Grid.Column="2" Background="White"
                        CornerRadius="10" BorderBrush="#E2E8F0"
                        BorderThickness="1">
                    <Grid>
                        <!-- When a report is selected -->
                        <Grid Visibility="{Binding ShowPreview, Converter={StaticResource BoolVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Toolbar -->
                            <Border Padding="14,10" BorderBrush="#E2E8F0"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PreviewTitle}"
                                                   FontWeight="SemiBold" FontSize="14"
                                                   Foreground="#1E293B"/>
                                        <TextBlock Text="{Binding PreviewSubtitle}"
                                                   FontSize="11" Foreground="#94A3B8"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostBtn}"
                                                Command="{Binding CopyReportCommand}"
                                                Content="📋 Copier"
                                                Margin="0,0,4,0"/>
                                        <Button Style="{StaticResource GhostBtn}"
                                                Command="{Binding ExportReportCommand}"
                                                Content="💾 Exporter"
                                                Margin="0,0,4,0"/>
                                        <Button Style="{StaticResource FlatBtn}"
                                                Background="#1E293B"
                                                Command="{Binding PrintReportCommand}"
                                                Content="🖨 Imprimer"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Content -->
                            <ScrollViewer Grid.Row="1"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <Border Background="#0F172A" Padding="20,16">
                                    <TextBlock Text="{Binding ReportPreview}"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               LineHeight="17"
                                               Foreground="#E2E8F0"
                                               TextWrapping="NoWrap"/>
                                </Border>
                            </ScrollViewer>
                        </Grid>

                        <!-- Placeholder -->
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding ShowPreview, Converter={StaticResource InvBoolVis}}">
                            <TextBlock Text="📄" FontSize="40"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Sélectionnez un rapport"
                                       FontSize="14" Foreground="#94A3B8"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0"/>
                            <TextBlock Text="Cliquez sur un rapport dans la liste pour afficher son contenu"
                                       FontSize="11" Foreground="#CBD5E1"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ ROW 3 — STATUS BAR ═══ -->
            <Border Grid.Row="3" Padding="16,8"
                    Visibility="{Binding ShowSuccess, Converter={StaticResource BoolVis}}"
                    Background="#ECFDF5">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12" Foreground="#059669"/>
            </Border>

            <Border Grid.Row="3" Padding="16,8"
                    Visibility="{Binding ShowError, Converter={StaticResource BoolVis}}"
                    Background="#FEF2F2">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12" Foreground="#DC2626"
                           TextWrapping="Wrap"/>
            </Border>
        </Grid>

        <!-- ═══ LOADING OVERLAY ═══ -->
        <Border Background="#60FFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <Border Background="White" CornerRadius="12"
                    Padding="32,24" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="8"
                                      Opacity="0.2" Color="Black"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="⏳" FontSize="24"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Chargement…" FontSize="13"
                               Foreground="#64748B"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>