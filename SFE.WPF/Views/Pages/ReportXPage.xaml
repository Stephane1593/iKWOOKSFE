<UserControl x:Class="SFE.WPF.Views.Pages.ReportXPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SFE.WPF.Converters"
             Background="#F1F5F9">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>

        <!-- ═══ FLAT BUTTON ═══ -->
        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ GHOST BUTTON ═══ -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="#CBD5E1" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ LINK BUTTON ═══ -->
        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="txt" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="txt" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ SMALL ICON BUTTON (for detail panel toolbar) ═══ -->
        <Style x:Key="SmallIconBtn" TargetType="Button">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════
             ROW 0: HEADER
             ═══════════════════════════════════════ -->
        <Border Grid.Row="0" Background="White" Padding="24,16"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Background="#EFF6FF" CornerRadius="8"
                        Width="44" Height="44" Margin="0,0,14,0">
                    <TextBlock Text="X" FontWeight="Bold" FontSize="20"
                               Foreground="#2563EB"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Rapport X — Lecture" FontSize="20" FontWeight="Bold"
                               Foreground="#0F172A"/>
                    <TextBlock Text="Rapports de situation (lecture seule, compteurs non remis à zéro)"
                               FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource GhostBtn}"
                        Command="{Binding RefreshCommand}"
                        Content="🔄 Actualiser"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════
             ROW 1: GENERATION STRIP
             ═══════════════════════════════════════ -->
        <Border Grid.Row="1" Background="White" Padding="24,12"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource FlatBtn}"
                        Background="#2563EB"
                        Command="{Binding GenerateXDailyCommand}"
                        Content="📊 X Quotidien"/>

                <Border Grid.Column="1" Width="1" Background="#E2E8F0" Margin="8,4"/>

                <TextBlock Grid.Column="2" Text="Du :" FontSize="12" Foreground="#64748B"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker Grid.Column="3" FontSize="12" Width="130"
                            SelectedDate="{Binding PeriodicFrom}"
                            VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="5" Text="Au :" FontSize="12" Foreground="#64748B"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker Grid.Column="6" FontSize="12" Width="130"
                            SelectedDate="{Binding PeriodicTo}"
                            VerticalContentAlignment="Center"/>

                <Button Grid.Column="8" Style="{StaticResource FlatBtn}"
                        Background="#1E40AF"
                        Command="{Binding GenerateXPeriodicCommand}"
                        Content="📊 X Périodique"/>

                <TextBlock Grid.Column="10" FontSize="12" Foreground="#64748B"
                           VerticalAlignment="Center">
                    <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                    <Run Text=" rapports  •  "/>
                    <Run Text="{Binding LastGeneratedInfo, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════
             ROW 2: TWO-COLUMN CONTENT AREA
             ═══════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="16,12,16,12">
            <Grid.ColumnDefinitions>
                <!-- Left: Table (always visible) -->
                <ColumnDefinition Width="*"/>
                <!-- Right: Detail panel (conditional) -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ─────────────────────────────────
                 LEFT COLUMN: DATA TABLE
                 ───────────────────────────────── -->
            <Border Grid.Column="0" Background="White"
                    CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- DataGrid -->
                    <DataGrid ItemsSource="{Binding Reports}"
                              SelectedItem="{Binding SelectedReport}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9"
                              BorderThickness="0" Background="White"
                              RowBackground="White" AlternatingRowBackground="#FAFBFC"
                              FontSize="13" CanUserResizeRows="False" SelectionUnit="FullRow"
                              Visibility="{Binding IsEmpty, Converter={StaticResource InvBoolVis}}">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="14,11"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="14,10" Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EFF6FF"/>
                                        <Setter Property="Foreground" Value="#1E293B"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EFF6FF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Width="155" Binding="{Binding DateDisplay}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#1E293B"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Opérateur" Width="*" Binding="{Binding OperatorName}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#475569"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Réf. E-UF" Width="110" Binding="{Binding ReferenceDisplay}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#2563EB"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Période" Width="170" Binding="{Binding PeriodDisplay}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                        <Setter Property="FontSize" Value="11"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Action" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Voir détails →" Style="{StaticResource LinkBtn}"
                                                Command="{Binding DataContext.ViewDetailCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty state -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="📊" FontSize="40" HorizontalAlignment="Center"/>
                        <TextBlock Text="Aucun X-Rapport" FontSize="15" Foreground="#94A3B8"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock Text="Générez un rapport avec les boutons ci-dessus"
                                   FontSize="12" Foreground="#CBD5E1"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Footer buttons inside table card -->
                    <Border Grid.Row="1" Padding="12,8"
                            BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostBtn}" Content="🖨 Imprimer"
                                    Command="{Binding PrintReportCommand}"
                                    CommandParameter="{Binding SelectedReport}"
                                    IsEnabled="{Binding HasSelectedReport}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource GhostBtn}" Content="📤 Exporter"
                                    Command="{Binding ExportReportCommand}"
                                    CommandParameter="{Binding SelectedReport}"
                                    IsEnabled="{Binding HasSelectedReport}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ─────────────────────────────────
                 RIGHT COLUMN: DETAIL PANEL
                 ───────────────────────────────── -->
            <Border Grid.Column="1"
                    Width="420"
                    Margin="12,0,0,0"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    Visibility="{Binding ShowDetailPanel, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ── Detail header ── -->
                    <Border Grid.Row="0" Padding="16,12"
                            BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding DetailTitle}"
                                           FontWeight="Bold" FontSize="14"
                                           Foreground="#1E293B"/>
                                <TextBlock Text="{Binding DetailSubtitle}"
                                           FontSize="11" Foreground="#94A3B8"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Pop-out -->
                            <Button Grid.Column="1" Style="{StaticResource SmallIconBtn}"
                                    Content="⧉" ToolTip="Ouvrir dans une fenêtre"
                                    Command="{Binding PopOutDetailCommand}"
                                    Margin="4,0"/>

                            <!-- Copy -->
                            <Button Grid.Column="2" Style="{StaticResource SmallIconBtn}"
                                    Content="📋" ToolTip="Copier le contenu"
                                    Command="{Binding CopyDetailCommand}"
                                    Margin="0,0,4,0"/>

                            <!-- Close -->
                            <Button Grid.Column="3" Style="{StaticResource SmallIconBtn}"
                                    Content="✕" ToolTip="Fermer le panneau"
                                    Command="{Binding CloseDetailPanelCommand}"/>
                        </Grid>
                    </Border>

                    <!-- ── Detail content (monospace) ── -->
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Border Background="#0F172A" Padding="20,16">
                            <TextBlock Text="{Binding DetailContent}"
                                       FontFamily="Consolas"
                                       FontSize="11.5"
                                       LineHeight="17"
                                       Foreground="#E2E8F0"
                                       TextWrapping="NoWrap"/>
                        </Border>
                    </ScrollViewer>

                    <!-- ── Detail footer actions ── -->
                    <Border Grid.Row="2" Padding="12,10"
                            BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
                            Background="#F8FAFC">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostBtn}"
                                    Content="🖨 Imprimer" FontSize="12"
                                    Command="{Binding PrintReportCommand}"
                                    CommandParameter="{Binding DetailItem}"
                                    Margin="0,0,8,0"/>
                            <Button Style="{StaticResource GhostBtn}"
                                    Content="📤 Exporter" FontSize="12"
                                    Command="{Binding ExportReportCommand}"
                                    CommandParameter="{Binding DetailItem}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════
             ROW 3: STATUS BAR
             ═══════════════════════════════════════ -->
        <Border Grid.Row="3" Padding="16,8"
                Visibility="{Binding HasStatus, Converter={StaticResource BoolVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#ECFDF5"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Background" Value="#FEF2F2"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#059669"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="#DC2626"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- ═══ LOADING ═══ -->
        <Border Grid.RowSpan="4" Background="#60FFFFFF"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}">
            <Border Background="White" CornerRadius="10" Padding="28,20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="⏳ Chargement..." FontSize="14" Foreground="#64748B"/>
            </Border>
        </Border>
    </Grid>
</UserControl>