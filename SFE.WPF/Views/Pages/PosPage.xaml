            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                MinHeight="{TemplateBinding MinHeight}">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="#FEE2E2"/>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#FECACA" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#FEE2E2" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ PRODUCT CARD ══════════ -->
        <Style x:Key="ProductCardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <SolidColorBrush Color="{StaticResource BorderLightColor}"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="4" Opacity="0.04" ShadowDepth="1" Color="#0D2B3E"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ POPUP ITEM BUTTON ══════════ -->
        <Style x:Key="PopupItemBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,1">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="#00000000"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource BorderLightColor}"/>
                            </Border.BorderBrush>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.04"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ OVERLAY HEADER ══════════ -->
        <Style x:Key="OverlayHeader" TargetType="Border">
            <Setter Property="Padding" Value="28,20,28,16"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <SolidColorBrush Color="{StaticResource BorderLightColor}"/>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="440"/>
            <ColumnDefinition Width="460"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════ -->
        <!-- LEFT: Catalogue                                        -->
        <!-- ══════════════════════════════════════════════════════ -->
        <DockPanel Grid.Column="0" Margin="20,16,10,16">

            <!-- TOP BAR -->
            <Border DockPanel.Dock="Top" Style="{StaticResource PosCard}"
                    Padding="22,16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentTime}" FontFamily="Consolas"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="{Binding CurrentDate}" FontFamily="{StaticResource AppFont}"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1" CornerRadius="8" Padding="12,6" Margin="16,0,0,0"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.1"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHtMode}" Value="True">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.12"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="TagOutline"/>
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHtMode}" Value="True">
                                                    <Setter Property="Foreground" Value="#92400E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock Text="{Binding PriceModeDisplay}"
                                           FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHtMode}" Value="True">
                                                    <Setter Property="Foreground" Value="#92400E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource BackgroundBrush}"
                                CornerRadius="10" Margin="18,0" Padding="14,0" MinHeight="44">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18"
                                                         Foreground="{StaticResource TextMutedBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="SearchBox" Grid.Column="1"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                         FontFamily="{StaticResource AppFont}" FontSize="14"
                                         Background="Transparent" BorderThickness="0"
                                         VerticalAlignment="Center" Padding="0,10"/>
                                <Popup Grid.Column="1" IsOpen="{Binding ShowSearchResults, Mode=TwoWay}"
                                       StaysOpen="False" PlacementTarget="{Binding ElementName=SearchBox}"
                                       Placement="Bottom" MinWidth="400"
                                       AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Background="White" CornerRadius="0,0,12,12" MaxHeight="360"
                                            BorderThickness="1" Effect="{StaticResource PopupShadow}"
                                            MinWidth="400" MaxWidth="600">
                                        <Border.BorderBrush>
                                            <SolidColorBrush Color="{StaticResource BorderLightColor}"/>
                                        </Border.BorderBrush>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource PopupItemBtn}"
                                                                Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource AppFont}"
                                                                               FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock FontFamily="Consolas" FontSize="11"
                                                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0">
                                                                        <Run Text="{Binding Code, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <Border Grid.Column="1" CornerRadius="6" Padding="10,4"
                                                                        Margin="12,0,0,0" VerticalAlignment="Center">
                                                                    <Border.Background>
                                                                        <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.08"/>
                                                                    </Border.Background>
                                                                    <TextBlock Text="{Binding UnitPriceTtcCdf, StringFormat='{}{0:N0} CDF'}"
                                                                               FontFamily="{StaticResource AppFont}" FontSize="13"
                                                                               FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                                                </Border>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChartBarStacked" Width="14" Height="14"
                                                         Foreground="{StaticResource TextMutedBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}">
                                    <Run Text="{Binding TodaySalesCount, Mode=OneWay}"/>
                                    <Run Text=" ventes"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" Foreground="{StaticResource PrimaryBrush}" Margin="0,2,0,0">
                                <Run Text="{Binding TodaySalesTotal, StringFormat=N0, Mode=OneWay}"/>
                                <Run Text=" CDF"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <Border CornerRadius="10" Padding="14,10" Margin="0,14,0,0" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.05"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="BorderBrush">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.2"/>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPointOfSale}" Value="{x:Null}">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="{StaticResource ErrorColor}" Opacity="0.05"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="BorderBrush">
                                            <Setter.Value>
                                                <SolidColorBrush Color="{StaticResource ErrorColor}" Opacity="0.2"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="StorefrontOutline" Width="16" Height="16"
                                                         Foreground="{StaticResource PrimaryDarkBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="4"
                                        Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center"
                                        Visibility="{Binding SelectedPointOfSale, Converter={StaticResource IsNotNullToVisibilityConverter}}">
                                    <TextBlock Text="{Binding SelectedPointOfSale.Code}" FontFamily="Consolas"
                                               FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}"/>
                                </Border>
                                <TextBlock Text="{Binding SelectedPointOfSale.Name}" FontFamily="{StaticResource AppFont}"
                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedPosInfo}" FontFamily="{StaticResource AppFont}"
                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="24,3,0,0"
                                       Visibility="{Binding SelectedPointOfSale, Converter={StaticResource IsNotNullToVisibilityConverter}}"/>
                            <StackPanel Orientation="Horizontal" Margin="24,3,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPointOfSale}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <materialDesign:PackIcon Kind="AlertOutline" Width="13" Height="13"
                                                         Foreground="#DC2626" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Aucun point de vente configuré" FontFamily="{StaticResource AppFont}"
                                           FontSize="11" Foreground="#DC2626" FontStyle="Italic"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- CATEGORIES -->
            <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled" Margin="0,0,0,16" Height="52"
                          PanningMode="VerticalOnly">
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding ShowFavoritesCommand}" Margin="0,0,10,0" Cursor="Hand"
                            Padding="18,10" MinHeight="48" BorderThickness="0" FontFamily="{StaticResource AppFont}"
                            FontSize="13" FontWeight="SemiBold">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CatBd" Background="{TemplateBinding Background}"
                                                    CornerRadius="10" Padding="{TemplateBinding Padding}"
                                                    BorderThickness="1.5" BorderBrush="Transparent">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="4" Opacity="0.04" ShadowDepth="1" Color="#0D2B3E"/>
                                                </Border.Effect>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CatBd" Property="BorderBrush"
                                                            Value="{StaticResource PrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowFavoritesOnly}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="StarOutline" Width="15" Height="15"
                                                     Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Favoris"/>
                        </StackPanel>
                    </Button>
                    <Button Content="Tout" Command="{Binding ShowAllProductsCommand}" Margin="0,0,10,0"
                            Cursor="Hand" Padding="18,10" MinHeight="48" Background="{StaticResource CardBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"
                            FontFamily="{StaticResource AppFont}" FontSize="13"/>
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,10,0" Cursor="Hand" Padding="18,10" MinHeight="48"
                                        BorderThickness="0" FontFamily="{StaticResource AppFont}" FontSize="13"
                                        Background="{StaticResource CardBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                        Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Name}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- PRODUCT GRID -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                <ItemsControl ItemsSource="{Binding DisplayProducts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,12,12" Width="160" Height="118" Cursor="Hand" BorderThickness="0"
                                    Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CardBorder" Style="{StaticResource ProductCardBorder}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource AppFont}"
                                                           FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                                           MaxHeight="34" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Row="1" VerticalAlignment="Center" FontFamily="Consolas"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}">
                                                    <Run Text="{Binding Code, Mode=OneWay}"/>
                                                </TextBlock>
                                                <Grid Grid.Row="2">
                                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="15"
                                                               FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}">
                                                        <Run Text="{Binding UnitPriceTtcCdf, StringFormat=N0, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                               FontFamily="{StaticResource AppFont}" FontSize="10"
                                                               Foreground="{StaticResource TextMutedBrush}">
                                                        <Run Text="{Binding TaxGroup, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter TargetName="CardBorder" Property="Background">
                                                    <Setter.Value>
                                                        <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.06"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="CardBorder" Property="Background">
                                                    <Setter.Value>
                                                        <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.12"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- ══════════════════════════════════════════════════════ -->
        <!-- RIGHT: Cart (460px wide)                               -->
        <!-- ══════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Margin="8,16,20,16">

            <Border Style="{StaticResource PosCard}" CornerRadius="16">
                <!-- ★★★ FIX: Replaced DockPanel with Grid + RowDefinitions ★★★ -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Row 0: Cart Header -->
                        <RowDefinition Height="*"/>
                        <!-- Row 1: Cart Items (scrollable) -->
                        <RowDefinition Height="1.8*"/>
                        <!-- Row 2: Cart Footer / Totals / Payment -->
                    </Grid.RowDefinitions>

                    <!-- ────── ROW 0: CART HEADER ────── -->
                    <Border Grid.Row="0" Padding="28,20,28,16" BorderThickness="0,0,0,1">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{StaticResource BorderLightColor}"/>
                        </Border.BorderBrush>
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CartOutline" Width="22" Height="22"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Panier" FontFamily="{StaticResource AppFont}"
                                       FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource PosIconBtn}" ToolTip="Client"
                                    Command="{Binding ToggleClientPanelCommand}">
                                        <materialDesign:PackIcon Kind="AccountOutline" Width="19" Height="19"
                                                         Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Button>
                                    <Button Style="{StaticResource PosIconBtn}" ToolTip="Commentaires"
                                    Command="{Binding ToggleCommentPanelCommand}">
                                        <materialDesign:PackIcon Kind="CommentTextOutline" Width="18" Height="18"
                                                         Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Button>
                                    <Button Style="{StaticResource PosIconBtn}" ToolTip="Remise"
                                    Command="{Binding ToggleDiscountPanelCommand}"
                                    Visibility="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}">
                                        <materialDesign:PackIcon Kind="PercentOutline" Width="18" Height="18"
                                                         Foreground="{StaticResource AccentBrush}"/>
                                    </Button>
                                    <Button Style="{StaticResource PosIconBtn}" ToolTip="En attente"
                                    Command="{Binding ToggleHeldPanelCommand}">
                                        <Grid>
                                            <materialDesign:PackIcon Kind="PauseCircleOutline" Width="18" Height="18"
                                                             Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Border Background="#EF4444" CornerRadius="8" MinWidth="16" Height="16"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-4,-6,0" Padding="4,0"
                                            Visibility="{Binding HeldCount, Converter={StaticResource IntToVisibilityConverter}}">
                                                <TextBlock Text="{Binding HeldCount}" FontSize="9" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource PosIconBtn}" ToolTip="Factures en attente"
                                    Command="{Binding TogglePendingPanelCommand}">
                                        <materialDesign:PackIcon Kind="TimerSandEmpty" Width="18" Height="18"
                                                         Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Button>
                                    <Button Style="{StaticResource PosIconBtn}"
                                    Command="{Binding ClearCartCommand}"
                                    Visibility="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}">
                                        <materialDesign:PackIcon Kind="TrashCanOutline" Width="18" Height="18"
                                                         Foreground="{StaticResource TextMutedBrush}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center">
                            <Run Text="{Binding CartItemCount, Mode=OneWay}"/>
                            <Run Text=" ligne(s) ·"/>
                            <Run Text="{Binding TotalArticles, Mode=OneWay}"/>
                            <Run Text=" art."/>
                                </TextBlock>
                                <TextBlock Text="{Binding InvoiceNumber}" FontFamily="Consolas"
                                   FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                            </Grid>

                            <!-- Client badge -->
                            <Border CornerRadius="10" Padding="14,10" Margin="0,12,0,0" MinHeight="42"
                            Visibility="{Binding HasClientSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border.Background>
                                    <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.06"/>
                                </Border.Background>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="AccountCheckOutline" Width="15" Height="15"
                                                         Foreground="{StaticResource PrimaryBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding ClientName}" FontFamily="{StaticResource AppFont}"
                                           FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                        <TextBlock Text="{Binding ClientTypeMention}" FontFamily="{StaticResource AppFont}"
                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" Width="36" Height="36"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding ClearClientCommand}">
                                        <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Foreground="#DC2626"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Credit note / Advance badges -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border CornerRadius="8" Padding="12,7" Margin="0,0,8,0" MinHeight="36"
                                Visibility="{Binding IsCreditNote, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border.Background>
                                        <SolidColorBrush Color="{StaticResource ErrorColor}" Opacity="0.08"/>
                                    </Border.Background>
                                    <Button Command="{Binding ToggleCreditNotePanelCommand}"
                                    Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FileUndoOutline" Width="14" Height="14"
                                                             Foreground="#DC2626" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Avoir" FontFamily="{StaticResource AppFont}"
                                               FontSize="11" FontWeight="SemiBold" Foreground="#DC2626"/>
                                        </StackPanel>
                                    </Button>
                                </Border>
                                <Border CornerRadius="8" Padding="12,7" MinHeight="36"
                                Visibility="{Binding IsAdvanceInvoice, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border.Background>
                                        <SolidColorBrush Color="#7C3AED" Opacity="0.08"/>
                                    </Border.Background>
                                    <Button Command="{Binding ToggleAdvancePanelCommand}"
                                    Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CashClock" Width="14" Height="14"
                                                             Foreground="#7C3AED" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Acompte" FontFamily="{StaticResource AppFont}"
                                               FontSize="11" FontWeight="SemiBold" Foreground="#7C3AED"/>
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ────── ROW 1: CART ITEMS LIST ────── -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding CartItems}" SelectedItem="{Binding SelectedCartItem}"
                             Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Padding="0" Margin="0">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer Focusable="False"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  PanningMode="VerticalOnly">
                                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="20,3"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="MinHeight" Value="64"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="12" Padding="18,14"
                                            Background="{StaticResource BackgroundBrush}"
                                            BorderThickness="1.5" BorderBrush="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush"
                                                    Value="{StaticResource PrimaryBrush}"/>
                                                    <Setter TargetName="Bd" Property="Background">
                                                        <Setter.Value>
                                                            <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.06"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush">
                                                        <Setter.Value>
                                                            <SolidColorBrush Color="{StaticResource BorderColor}"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource AppFont}" FontSize="13"
                                           FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0">
                                    <Run Text="{Binding QuantityDisplay, Mode=OneWay}"/>
                                    <Run Text=" · Grp "/>
                                    <Run Text="{Binding TaxGroupLabel, Mode=OneWay}"/>
                                        </TextBlock>
                                        <Border Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}"
                                        CornerRadius="4" Padding="6,2" Margin="0,3,0,0" HorizontalAlignment="Left">
                                            <Border.Background>
                                                <SolidColorBrush Color="{StaticResource ErrorColor}" Opacity="0.08"/>
                                            </Border.Background>
                                            <TextBlock Text="{Binding DiscountDisplay, Mode=OneWay}" FontFamily="{StaticResource AppFont}"
                                               FontSize="10" Foreground="#DC2626" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                        <Button Width="42" Height="42" Padding="0"
                                        Background="{StaticResource BackgroundBrush}" BorderThickness="0" Cursor="Hand"
                                        Command="{Binding DataContext.DecrementQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                            <TextBlock Text="−" FontSize="18" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                        <TextBlock Text="{Binding Quantity, StringFormat=G}" FontFamily="{StaticResource AppFont}"
                                           FontSize="15" FontWeight="Bold" VerticalAlignment="Center"
                                           Margin="8,0" MinWidth="28" TextAlignment="Center"/>
                                        <Button Width="42" Height="42" Padding="0"
                                        Background="{StaticResource BackgroundBrush}" BorderThickness="0" Cursor="Hand"
                                        Command="{Binding DataContext.IncrementQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                            <TextBlock Text="＋" FontSize="18" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="78">
                                        <TextBlock Text="{Binding AmountTTC, StringFormat='{}{0:N0}'}"
                                           FontFamily="{StaticResource AppFont}" FontSize="15"
                                           FontWeight="Bold" HorizontalAlignment="Right"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                                        <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        HorizontalAlignment="Right" Padding="0" MinHeight="26"
                                        Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding DataContext.IsNormalized, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Close" Width="10" Height="10"
                                                                 Foreground="#EF4444" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="retirer" FontSize="9" Foreground="#EF4444"
                                                   FontFamily="{StaticResource AppFont}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- ────── ROW 2: CART FOOTER ────── -->
                    <DockPanel Grid.Row="2">

                        <!-- Status messages -->
                        <Border DockPanel.Dock="Bottom" Margin="28,0,28,12" CornerRadius="8" Padding="14,10"
                        Visibility="{Binding ShowSuccess, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource SuccessColor}" Opacity="0.06"/>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="14" Height="14"
                                                 Foreground="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                                   FontFamily="{StaticResource AppFont}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border DockPanel.Dock="Bottom" Margin="28,0,28,6" CornerRadius="8" Padding="14,10"
                        Visibility="{Binding ShowError, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource ErrorColor}" Opacity="0.06"/>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertCircleOutline" Width="14" Height="14"
                                                 Foreground="{StaticResource ErrorBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource ErrorBrush}"
                                   FontFamily="{StaticResource AppFont}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- ── Scrollable totals + payment area ── -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                            <StackPanel Margin="28,12,28,24">

                                <Separator Background="{StaticResource BorderLightBrush}" Margin="0,0,0,14"/>

                                <!-- Discount sub-total -->
                                <Grid Margin="0,0,0,8" MinHeight="28"
                              Visibility="{Binding HasAnyDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Sous-total avant remise" FontFamily="{StaticResource AppFont}"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalHTBeforeDiscount, StringFormat='{}{0:N0}'}"
                                       HorizontalAlignment="Right" FontFamily="{StaticResource AppFont}"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                       TextDecorations="Strikethrough" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,8" MinHeight="28"
                              Visibility="{Binding HasAnyDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="PercentOutline" Width="12" Height="12"
                                                         Foreground="#DC2626" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Remise" FontFamily="{StaticResource AppFont}" FontSize="11" Foreground="#DC2626"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding TotalDiscount, StringFormat='-{0:N0}'}"
                                       HorizontalAlignment="Right" FontFamily="{StaticResource AppFont}"
                                       FontSize="11" Foreground="#DC2626" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- HT -->
                                <Grid Margin="0,0,0,8" MinHeight="30">
                                    <TextBlock Text="HT" FontFamily="{StaticResource AppFont}" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalHT, StringFormat='{}{0:N0}'}" HorizontalAlignment="Right"
                                       FontFamily="{StaticResource AppFont}" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- TVA -->
                                <Grid Margin="0,0,0,8" MinHeight="30">
                                    <TextBlock Text="TVA" FontFamily="{StaticResource AppFont}" FontSize="12"
                                       Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalTVA, StringFormat='{}{0:N0}'}" HorizontalAlignment="Right"
                                       FontFamily="{StaticResource AppFont}" FontSize="12"
                                       Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Specific tax -->
                                <Grid Margin="0,0,0,8" MinHeight="30"
                              Visibility="{Binding HasAnySpecificTax, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="FlashOutline" Width="13" Height="13"
                                                         Foreground="#92400E" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Taxe spécifique" FontFamily="{StaticResource AppFont}" FontSize="12" Foreground="#92400E"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding TotalSpecificTax, StringFormat='{}{0:N0}'}"
                                       HorizontalAlignment="Right" FontFamily="{StaticResource AppFont}"
                                       FontSize="12" Foreground="#92400E" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- ── Grand Total ── -->
                                <Border CornerRadius="14" Padding="22,18" Margin="0,10,0,10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.08"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHtMode}" Value="True">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.08"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBlock Text="{Binding GrandTotalLabel}" FontFamily="{StaticResource AppFont}"
                                           FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}">
                                    <Run Text="{Binding GrandTotal, StringFormat=N0, Mode=OneWay}"/>
                                    <Run Text=" CDF" FontSize="14"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- ── Alternate currency ── -->
                                <Border CornerRadius="10" Padding="18,12" Margin="0,0,0,12" BorderThickness="1" MinHeight="44">
                                    <Border.Background>
                                        <SolidColorBrush Color="{StaticResource BackgroundColor}"/>
                                    </Border.Background>
                                    <Border.BorderBrush>
                                        <SolidColorBrush Color="{StaticResource BorderLightColor}"/>
                                    </Border.BorderBrush>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="SwapHorizontal" Width="15" Height="15"
                                                             Foreground="{StaticResource TextMutedBrush}"
                                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}">
                                        <Run Text="{Binding AlternateCurrencyLabel, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource AppFont}"
                                           FontSize="14" FontWeight="Bold" VerticalAlignment="Center">
                                    <Run Text="{Binding TotalInAlternateCurrency, StringFormat=N2, Mode=OneWay}"/>
                                    <Run Text=" " FontSize="9"/>
                                    <Run Text="{Binding AlternateCurrencyLabel, Mode=OneWay}" FontSize="9"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- ── À payer TTC (HT mode) ── -->
                                <Border CornerRadius="12" Padding="20,14" Margin="0,0,0,12"
                                Visibility="{Binding IsHtMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border.Background>
                                        <SolidColorBrush Color="{StaticResource SuccessColor}" Opacity="0.06"/>
                                    </Border.Background>
                                    <Grid MinHeight="38">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="CashMultiple" Width="16" Height="16"
                                                             Foreground="#065F46" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="À encaisser (TTC)" FontFamily="{StaticResource AppFont}"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#065F46"/>
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource AppFont}"
                                           FontSize="17" FontWeight="Bold" Foreground="#065F46" VerticalAlignment="Center">
                                    <Run Text="{Binding TotalTTC, StringFormat=N0, Mode=OneWay}"/>
                                    <Run Text=" CDF" FontSize="11"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- ═══════ BEFORE NORMALIZATION ═══════ -->
                                <StackPanel Visibility="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}">

                                    <!-- Payment type + Invoice type -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Style="{StaticResource PosComboBox}"
                                          ItemsSource="{Binding PaymentTypes}"
                                          SelectedItem="{Binding SelectedPaymentType}"/>
                                        <ComboBox Grid.Column="2" Style="{StaticResource PosComboBox}"
                                          ItemsSource="{Binding InvoiceTypes}"
                                          SelectedItem="{Binding InvoiceType}"/>
                                    </Grid>

                                    <!-- Split payment toggle -->
                                    <Button Style="{StaticResource PosGhostBtn}" Margin="0,0,0,14"
                                    Command="{Binding ToggleSplitPaymentCommand}" HorizontalContentAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="14" Height="14"
                                                             Foreground="{StaticResource TextSecondaryBrush}"
                                                             Margin="0,0,8,0" VerticalAlignment="Center">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="CreditCardOutline"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowSplitPayment}" Value="True">
                                                                <Setter Property="Kind" Value="Close"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Paiement fractionné"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowSplitPayment}" Value="True">
                                                                <Setter Property="Text" Value="Fermer paiement fractionné"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>

                                    <!-- ── Split payment section ── -->
                                    <StackPanel Visibility="{Binding ShowSplitPayment, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl ItemsSource="{Binding PaymentItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4" MinHeight="40">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" FontFamily="{StaticResource AppFont}"
                                                           FontSize="12" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat=N0}"
                                                           FontFamily="{StaticResource AppFont}" FontSize="12"
                                                           FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="2" Width="36" Height="36"
                                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                        Command="{Binding DataContext.RemovePaymentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                            <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Foreground="#EF4444"/>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid Margin="0,10,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource PosTextBox}" Text="{Binding PaymentAmount}" ToolTip="Vide = reste à payer"/>
                                            <Button Grid.Column="1" Style="{StaticResource PosMiniBtn}"
                                            Command="{Binding AddPaymentCommand}" Margin="12,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Plus" Width="14" Height="14"
                                                                     Foreground="White" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Ajouter" Foreground="White" FontSize="12"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <Grid Margin="0,0,0,12" MinHeight="38">
                                            <TextBlock Text="Reste à payer" FontFamily="{StaticResource AppFont}"
                                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource AppFont}"
                                               FontSize="14" FontWeight="Bold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Remaining}" Value="0">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                        <Run Text="{Binding Remaining, StringFormat=N0, Mode=OneWay}"/>
                                        <Run Text=" CDF"/>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>

                                    <!-- ── Simple payment section ── -->
                                    <StackPanel Visibility="{Binding ShowSplitPayment, Converter={StaticResource InverseBoolConverter}}">
                                        <TextBlock Text="Montant reçu" FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,8"/>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding ReceivedAmount, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{StaticResource AppFont}" FontSize="20"
                                             FontWeight="SemiBold" Padding="16,14" MinHeight="54"
                                             Background="White" VerticalContentAlignment="Center">
                                                <TextBox.Template>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                        CornerRadius="10" BorderThickness="1.5"
                                                        Padding="{TemplateBinding Padding}"
                                                        MinHeight="{TemplateBinding MinHeight}"
                                                        SnapsToDevicePixels="True">
                                                            <Border.BorderBrush>
                                                                <SolidColorBrush Color="{StaticResource BorderLightColor}"/>
                                                            </Border.BorderBrush>
                                                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsFocused" Value="True">
                                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                                Value="{StaticResource PrimaryBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </TextBox.Template>
                                            </TextBox>
                                            <Button Grid.Column="1" Style="{StaticResource PosGhostBtn}"
                                            Command="{Binding SetExactAmountCommand}" Margin="12,0,0,0">
                                                <TextBlock Text="= Exact" FontFamily="{StaticResource AppFont}" FontSize="12"/>
                                            </Button>
                                        </Grid>

                                        <!-- Quick amount chips -->
                                        <WrapPanel Margin="0,0,0,12">
                                            <Button Style="{StaticResource PosChipBtn}" Content="1 000"
                                            Margin="0,0,8,8" Command="{Binding SetRoundedAmountCommand}" CommandParameter="1000"/>
                                            <Button Style="{StaticResource PosChipBtn}" Content="5 000"
                                            Margin="0,0,8,8" Command="{Binding SetRoundedAmountCommand}" CommandParameter="5000"/>
                                            <Button Style="{StaticResource PosChipBtn}" Content="10 000"
                                            Margin="0,0,8,8" Command="{Binding SetRoundedAmountCommand}" CommandParameter="10000"/>
                                            <Button Style="{StaticResource PosChipBtn}" Content="20 000"
                                            Margin="0,0,8,8" Command="{Binding SetRoundedAmountCommand}" CommandParameter="20000"/>
                                            <Button Style="{StaticResource PosChipBtn}" Content="50 000"
                                            Margin="0,0,0,8" Command="{Binding SetRoundedAmountCommand}" CommandParameter="50000"/>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Change -->
                                    <Border CornerRadius="12" Padding="20,14" Margin="0,0,0,14"
                                    Visibility="{Binding ShowChange, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Border.Background>
                                            <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.08"/>
                                        </Border.Background>
                                        <Grid MinHeight="38">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="CashRefund" Width="16" Height="16"
                                                                 Foreground="#92400E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Monnaie" FontFamily="{StaticResource AppFont}"
                                                   FontSize="13" FontWeight="Medium" Foreground="#92400E"/>
                                            </StackPanel>
                                            <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource AppFont}"
                                               FontSize="17" FontWeight="Bold" Foreground="#92400E" VerticalAlignment="Center">
                                        <Run Text="{Binding ChangeAmount, StringFormat=N0, Mode=OneWay}"/>
                                        <Run Text=" CDF"/>
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <!-- Hold + Process buttons -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource PosHoldBtn}" Margin="0,0,12,0"
                                        Command="{Binding RequestHoldCommand}">
                                            <materialDesign:PackIcon Kind="PauseCircleOutline" Width="22" Height="22" Foreground="White"/>
                                        </Button>
                                        <Button Grid.Column="1" Style="{StaticResource PosProcessBtn}"
                                        Command="{Binding ProcessSaleCommand}" HorizontalContentAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ShieldLockOutline" Width="20" Height="20"
                                                                 Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="ENCAISSER" FontFamily="{StaticResource AppFont}"
                                                   FontSize="16" FontWeight="Bold" Foreground="White"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <!-- ═══════ AFTER NORMALIZATION ═══════ -->
                                <StackPanel Visibility="{Binding IsNormalized, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border CornerRadius="12" Padding="20,16" Margin="0,0,0,14">
                                        <Border.Background>
                                            <SolidColorBrush Color="{StaticResource SuccessColor}" Opacity="0.05"/>
                                        </Border.Background>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="CODE DEF/DGI" FontFamily="{StaticResource AppFont}" FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding CodeDEFDGI}" FontFamily="Consolas" FontSize="13"
                                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition MinHeight="28"/>
                                            <RowDefinition MinHeight="28"/>
                                            <RowDefinition MinHeight="28"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="NIM:" FontFamily="{StaticResource AppFont}" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Nim}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Text="Compteurs:" FontFamily="{StaticResource AppFont}"
                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Counters}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Text="Date DEF:" FontFamily="{StaticResource AppFont}"
                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DeviceDateTime}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Button Style="{StaticResource PosPrimaryBtn}"
                                    Command="{Binding NewSaleCommand}" HorizontalContentAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FilePlusOutline" Width="18" Height="18"
                                                             Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="NOUVELLE VENTE" FontFamily="{StaticResource AppFont}"
                                               FontSize="14" FontWeight="Bold" Foreground="White"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Reprint -->
                                <Button Style="{StaticResource PosGhostBtn}" Padding="18,12" Margin="0,14,0,0"
                                Command="{Binding ReprintReceiptCommand}" HorizontalContentAlignment="Center"
                                Visibility="{Binding HasThermalPrinter, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PrinterOutline" Width="15" Height="15"
                                                         Foreground="{StaticResource TextSecondaryBrush}"
                                                         Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Réimprimer (Duplicata)" FontFamily="{StaticResource AppFont}"
                                           FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <!-- Printer indicator -->
                                <Border CornerRadius="8" Padding="10,6" Margin="0,12,0,0" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Color="{StaticResource SuccessColor}" Opacity="0.06"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasThermalPrinter}" Value="False">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <SolidColorBrush Color="{StaticResource ErrorColor}" Opacity="0.06"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#10B981"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasThermalPrinter}" Value="False">
                                                            <Setter Property="Fill" Value="#EF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding ThermalPrinterName}" FontFamily="{StaticResource AppFont}"
                                           FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>

                </Grid>
                <!-- ★★★ END FIX ★★★ -->
            </Border>

            <!-- ══════════════════════════════════════════════════════ -->
            <!-- OVERLAY PANELS                                         -->
            <!-- ══════════════════════════════════════════════════════ -->

            <!-- CLIENT PANEL ★ -->
            <Border Style="{StaticResource PosOverlayCard}"
                    VerticalAlignment="Stretch" Margin="0"
                    Visibility="{Binding ShowClientPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Style="{StaticResource OverlayHeader}">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountOutline" Width="22" Height="22"
                                                         Foreground="{StaticResource PrimaryBrush}"
                                                         Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Client" FontFamily="{StaticResource AppFont}"
                                           FontSize="17" FontWeight="Bold"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Style="{StaticResource PosCloseBtn}"
                                    Command="{Binding ToggleClientPanelCommand}"/>
                        </Grid>
                    </Border>

                    <!-- Scrollable form -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                        <StackPanel Margin="28,20,28,20">
                            <!-- Search -->
                            <TextBlock Text="Rechercher" Style="{StaticResource PosFieldLabel}"/>
                            <Grid Margin="0,0,0,18">
                                <TextBox x:Name="PosClientSearch" Style="{StaticResource PosTextBox}"
                                         Text="{Binding ClientSearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
                                <Popup IsOpen="{Binding IsClientSearchOpen, Mode=TwoWay}" StaysOpen="False"
                                       PlacementTarget="{Binding ElementName=PosClientSearch}" Placement="Bottom"
                                       Width="{Binding ActualWidth, ElementName=PosClientSearch}"
                                       AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Background="White" CornerRadius="0,0,12,12" MaxHeight="260"
                                            BorderThickness="1" Effect="{StaticResource PopupShadow}">
                                        <Border.BorderBrush>
                                            <SolidColorBrush Color="{StaticResource BorderLightColor}"/>
                                        </Border.BorderBrush>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                                            <ItemsControl ItemsSource="{Binding ClientSearchResults}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource PopupItemBtn}"
                                                                Command="{Binding DataContext.SelectClientCommand, RelativeSource={RelativeSource AncestorType=Popup}}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource AppFont}"
                                                                           FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock FontFamily="Consolas" FontSize="11"
                                                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0">
                                                                    <Run Text="{Binding Type}"/>
                                                                    <Run Text=" · NIF: "/>
                                                                    <Run Text="{Binding NIF, TargetNullValue='-'}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>

                            <!-- Type -->
                            <TextBlock Text="Type client" Style="{StaticResource PosFieldLabel}"/>
                            <ComboBox Style="{StaticResource PosComboBox}" Margin="0,0,0,18"
                                      ItemsSource="{Binding ClientTypes}" SelectedItem="{Binding SelectedClientType}"/>

                            <!-- NIF -->
                            <TextBlock Text="NIF" Style="{StaticResource PosFieldLabel}"/>
                            <TextBox Style="{StaticResource PosTextBox}" Margin="0,0,0,18"
                                     Text="{Binding ClientNIF}"/>

                            <!-- Name -->
                            <TextBlock Text="Nom / Dénomination" Style="{StaticResource PosFieldLabel}"/>
                            <TextBox Style="{StaticResource PosTextBox}" Margin="0,0,0,18"
                                     Text="{Binding ClientName}"/>

                            <!-- Phone -->
                            <TextBlock Text="Téléphone" Style="{StaticResource PosFieldLabel}"/>
                            <TextBox Style="{StaticResource PosTextBox}" Margin="0,0,0,18"
                                     Text="{Binding ClientPhone}"/>

                            <!-- Address -->
                            <TextBlock Text="Adresse" Style="{StaticResource PosFieldLabel}"/>
                            <TextBox Style="{StaticResource PosTextBox}"
                                     Text="{Binding ClientAddress}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer buttons -->
                    <Border Grid.Row="2" Padding="28,16,28,22" BorderThickness="0,1,0,0">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{StaticResource BorderLightColor}"/>
                        </Border.BorderBrush>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource PosSuccessBtn}"
                                    Command="{Binding SaveClientInlineCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSave" Width="15" Height="15"
                                                             Foreground="#065F46" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Enregistrer" Foreground="#065F46" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource PosDangerBtn}"
                                    Command="{Binding ClearClientCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Close" Width="14" Height="14"
                                                             Foreground="#DC2626" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Vider" Foreground="#DC2626" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- CREDIT NOTE PANEL -->
            <Border Style="{StaticResource PosOverlayCard}"
                    VerticalAlignment="Stretch" Margin="0"
                    Visibility="{Binding ShowCreditNotePanel, Converter={StaticResource BoolToVisibilityConverter}}">
