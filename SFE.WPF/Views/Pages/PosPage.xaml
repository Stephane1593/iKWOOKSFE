<UserControl x:Class="SFE.WPF.Views.Pages.PosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F2F5">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- ══════ GAUCHE : Catalogue ══════ -->
        <DockPanel Grid.Column="0" Margin="16,12,8,12">

            <!-- BARRE DU HAUT -->
            <Border DockPanel.Dock="Top" Background="White" CornerRadius="12"
                    Padding="16,10" Margin="0,0,0,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.06" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentTime}" FontFamily="Consolas"
                                       FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="{Binding CurrentDate}" FontFamily="{StaticResource AppFont}"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <Border Grid.Column="1" CornerRadius="8" Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#DBEAFE"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHtMode}" Value="True">
                                            <Setter Property="Background" Value="#FEF3C7"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding PriceModeDisplay}" FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#1D4ED8"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHtMode}" Value="True">
                                                <Setter Property="Foreground" Value="#92400E"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <Border Grid.Column="2" Background="#F3F4F6" CornerRadius="10" Margin="16,0" Padding="14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="SearchBox" Grid.Column="1"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                         FontFamily="{StaticResource AppFont}" FontSize="14"
                                         Background="Transparent" BorderThickness="0"
                                         VerticalAlignment="Center" Padding="0,10"/>
                                <Popup Grid.Column="1" IsOpen="{Binding ShowSearchResults, Mode=TwoWay}"
                                       StaysOpen="False" PlacementTarget="{Binding ElementName=SearchBox}"
                                       Placement="Bottom" Width="{Binding ActualWidth, ElementName=SearchBox}">
                                    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                                            CornerRadius="0,0,10,10" MaxHeight="300">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" Opacity="0.12" ShadowDepth="6"/>
                                        </Border.Effect>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" Background="Transparent" BorderThickness="0"
                                                                HorizontalContentAlignment="Stretch" Cursor="Hand" Padding="14,10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="Medium"/>
                                                                    <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                                                        <Run Text="{Binding Code, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding UnitPriceTtcCdf, StringFormat='{}{0:N0} CDF'}"
                                                                           FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="Bold"
                                                                           Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊 " FontSize="13"/>
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="{Binding TodaySalesCount, Mode=OneWay}"/> <Run Text=" ventes"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" Foreground="{StaticResource PrimaryBrush}">
                                <Run Text="{Binding TodaySalesTotal, StringFormat=N0, Mode=OneWay}"/> <Run Text=" CDF"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- POS Selector -->
                    <Border CornerRadius="8" Padding="10,7" Margin="0,8,0,0" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#F0F9FF"/>
                                <Setter Property="BorderBrush" Value="#BAE6FD"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPointOfSale}" Value="{x:Null}">
                                        <Setter Property="Background" Value="#FEF2F2"/>
                                        <Setter Property="BorderBrush" Value="#FECACA"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🏪" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailablePointsOfSale}"
                                      SelectedItem="{Binding SelectedPointOfSale}"
                                      IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"
                                      FontFamily="{StaticResource AppFont}" FontSize="12" Padding="6,4">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#E0F2FE" CornerRadius="4" Padding="5,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Code}" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#0369A1"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Column="2" Text="{Binding SelectedPosInfo}" FontFamily="{StaticResource AppFont}"
                                       FontSize="10" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- CATÉGORIES -->
            <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled" Margin="0,0,0,12" Height="44">
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding ShowFavoritesCommand}" Margin="0,0,8,0" Cursor="Hand" Padding="14,8"
                            BorderThickness="0" FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowFavoritesOnly}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⭐" Margin="0,0,6,0"/>
                            <TextBlock Text="Favoris"/>
                        </StackPanel>
                    </Button>
                    <Button Content="Tout" Command="{Binding ShowAllProductsCommand}" Margin="0,0,8,0" Cursor="Hand"
                            Padding="14,8" Background="White" Foreground="{StaticResource TextPrimaryBrush}"
                            BorderThickness="0" FontFamily="{StaticResource AppFont}" FontSize="13"/>
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,8,0" Cursor="Hand" Padding="14,8" BorderThickness="0"
                                        FontFamily="{StaticResource AppFont}" FontSize="13"
                                        Background="White" Foreground="{StaticResource TextPrimaryBrush}"
                                        Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Name}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- GRILLE PRODUITS -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DisplayProducts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,10,10" Width="150" Height="110" Cursor="Hand" BorderThickness="0"
                                    Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CardBorder" Background="White" CornerRadius="12"
                                                Padding="12" BorderThickness="1" BorderBrush="#E5E7EB">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="4" Opacity="0.05" ShadowDepth="1"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource AppFont}" FontSize="12"
                                                           FontWeight="Medium" TextTrimming="CharacterEllipsis" MaxHeight="34" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Row="1" VerticalAlignment="Center" FontFamily="Consolas" FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="{Binding Code, Mode=OneWay}"/>
                                                </TextBlock>
                                                <Grid Grid.Row="2">
                                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="Bold"
                                                               Foreground="{StaticResource PrimaryBrush}">
                                                        <Run Text="{Binding UnitPriceTtcCdf, StringFormat=N0, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                               FontFamily="{StaticResource AppFont}" FontSize="10"
                                                               Foreground="{StaticResource TextSecondaryBrush}">
                                                        <Run Text="{Binding TaxGroup, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter TargetName="CardBorder" Property="Background" Value="#EFF6FF"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="CardBorder" Property="Background" Value="#DBEAFE"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- ══════ DROITE : Panier ══════ -->
        <Grid Grid.Column="1" Margin="8,12,16,12">

            <Border Background="White" CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Opacity="0.08" ShadowDepth="3"/>
                </Border.Effect>
                <DockPanel>

                    <!-- HEADER PANIER -->
                    <Border DockPanel.Dock="Top" Padding="16,12,16,8" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="🛒 Panier" FontFamily="{StaticResource AppFont}" FontSize="17" FontWeight="Bold"/>
                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="{Binding CartItemCount, Mode=OneWay}"/> <Run Text=" ligne(s) ·"/>
                                        <Run Text="{Binding TotalArticles, Mode=OneWay}"/> <Run Text=" art."/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- 👤 Client -->
                                <Button Grid.Column="1" Command="{Binding ToggleClientPanelCommand}" Background="Transparent"
                                        BorderThickness="0" Cursor="Hand" ToolTip="Client" Margin="0,0,4,0" Padding="6">
                                    <TextBlock Text="👤" FontSize="17"/>
                                </Button>
                                <!-- 💬 Commentaire -->
                                <Button Grid.Column="2" Command="{Binding ToggleCommentPanelCommand}" Background="Transparent"
                                        BorderThickness="0" Cursor="Hand" ToolTip="Commentaires" Margin="0,0,4,0" Padding="6">
                                    <TextBlock Text="💬" FontSize="16"/>
                                </Button>
                                <!-- % Remise -->
                                <Button Grid.Column="3" Command="{Binding ToggleDiscountPanelCommand}" Background="Transparent"
                                        BorderThickness="0" Cursor="Hand" ToolTip="Remise" Margin="0,0,4,0" Padding="6"
                                        Visibility="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}">
                                    <TextBlock Text="%" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                </Button>
                                <!-- ⏸ Held -->
                                <Button Grid.Column="4" Command="{Binding ToggleHeldPanelCommand}" Background="Transparent"
                                        BorderThickness="0" Cursor="Hand" ToolTip="En attente" Margin="0,0,4,0" Padding="6">
                                    <Grid>
                                        <TextBlock Text="⏸" FontSize="16"/>
                                        <Border Background="#EF4444" CornerRadius="8" MinWidth="16" Height="16"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-8,0" Padding="4,0"
                                                Visibility="{Binding HeldCount, Converter={StaticResource IntToVisibilityConverter}}">
                                            <TextBlock Text="{Binding HeldCount}" FontSize="9" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Button>
                                <!-- ⏳ Pending -->
                                <Button Grid.Column="5" Command="{Binding TogglePendingPanelCommand}" Background="Transparent"
                                        BorderThickness="0" Cursor="Hand" ToolTip="Factures en attente" Margin="0,0,4,0" Padding="6">
                                    <TextBlock Text="⏳" FontSize="16"/>
                                </Button>
                                <!-- Invoice # -->
                                <TextBlock Grid.Column="6" Text="{Binding InvoiceNumber}" FontFamily="Consolas" FontSize="10"
                                           VerticalAlignment="Center" Margin="4,0,6,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <!-- 🗑 Clear -->
                                <Button Grid.Column="7" Content="🗑" FontSize="16" Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Command="{Binding ClearCartCommand}"
                                        Visibility="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"/>
                            </Grid>

                            <!-- Client badge (when selected) -->
                            <Border CornerRadius="8" Padding="10,6" Margin="0,6,0,0" Background="#EFF6FF"
                                    Visibility="{Binding HasClientSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="👤 " FontSize="12"/>
                                        <TextBlock Text="{Binding ClientName}" FontFamily="{StaticResource AppFont}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                        <TextBlock Text="{Binding ClientTypeMention}" FontFamily="{StaticResource AppFont}"
                                                   FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" Content="✕" FontSize="10" Background="Transparent"
                                            BorderThickness="0" Cursor="Hand" Foreground="#DC2626"
                                            Command="{Binding ClearClientCommand}"/>
                                </Grid>
                            </Border>

                            <!-- Credit note / Advance badges -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Background="#FEE2E2" CornerRadius="6" Padding="8,3" Margin="0,0,6,0" Cursor="Hand"
                                        Visibility="{Binding IsCreditNote, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button Command="{Binding ToggleCreditNotePanelCommand}" Background="Transparent" BorderThickness="0" Padding="0">
                                        <TextBlock Text="📄 Avoir" FontFamily="{StaticResource AppFont}" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="#DC2626"/>
                                    </Button>
                                </Border>
                                <Border Background="#EDE9FE" CornerRadius="6" Padding="8,3" Cursor="Hand"
                                        Visibility="{Binding IsAdvanceInvoice, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button Command="{Binding ToggleAdvancePanelCommand}" Background="Transparent" BorderThickness="0" Padding="0">
                                        <TextBlock Text="💰 Acompte" FontFamily="{StaticResource AppFont}" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="#7C3AED"/>
                                    </Button>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- PIED : Totaux + Actions -->
                    <DockPanel DockPanel.Dock="Bottom">
                        <!-- Status -->
                        <Border DockPanel.Dock="Bottom" Margin="12,0,12,10" CornerRadius="8" Padding="10,6"
                                Visibility="{Binding ShowSuccess, Converter={StaticResource BoolToVisibilityConverter}}" Background="#ECFDF5">
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                                       FontFamily="{StaticResource AppFont}" FontSize="11" TextWrapping="Wrap"/>
                        </Border>
                        <Border DockPanel.Dock="Bottom" Margin="12,0,12,4" CornerRadius="8" Padding="10,6"
                                Visibility="{Binding ShowError, Converter={StaticResource BoolToVisibilityConverter}}" Background="#FEF2F2">
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource ErrorBrush}"
                                       FontFamily="{StaticResource AppFont}" FontSize="11" TextWrapping="Wrap"/>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,16,12">
                            <StackPanel>
                                <Separator Margin="0,4,0,8"/>

                                <!-- Totals -->
                                <Grid Margin="0,0,0,3" Visibility="{Binding HasAnyDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Sous-total avant remise" FontFamily="{StaticResource AppFont}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding TotalHTBeforeDiscount, StringFormat='{}{0:N0}'}" HorizontalAlignment="Right"
                                               FontFamily="{StaticResource AppFont}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextDecorations="Strikethrough"/>
                                </Grid>
                                <Grid Margin="0,0,0,3" Visibility="{Binding HasAnyDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="💸 Remise" FontFamily="{StaticResource AppFont}" FontSize="11" Foreground="#DC2626"/>
                                    <TextBlock Text="{Binding TotalDiscount, StringFormat='-{0:N0}'}" HorizontalAlignment="Right"
                                               FontFamily="{StaticResource AppFont}" FontSize="11" Foreground="#DC2626" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="HT" FontFamily="{StaticResource AppFont}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding TotalHT, StringFormat='{}{0:N0}'}" HorizontalAlignment="Right"
                                               FontFamily="{StaticResource AppFont}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Grid>
                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="TVA" FontFamily="{StaticResource AppFont}" FontSize="12" Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="{Binding TotalTVA, StringFormat='{}{0:N0}'}" HorizontalAlignment="Right"
                                               FontFamily="{StaticResource AppFont}" FontSize="12" Foreground="{StaticResource PrimaryBrush}"/>
                                </Grid>
                                <Grid Margin="0,0,0,3" Visibility="{Binding HasAnySpecificTax, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="⚡ Taxe spécifique" FontFamily="{StaticResource AppFont}" FontSize="12" Foreground="#92400E"/>
                                    <TextBlock Text="{Binding TotalSpecificTax, StringFormat='{}{0:N0}'}" HorizontalAlignment="Right"
                                               FontFamily="{StaticResource AppFont}" FontSize="12" Foreground="#92400E"/>
                                </Grid>

                                <!-- Grand Total -->
                                <Border CornerRadius="10" Padding="14,10" Margin="0,6,0,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#EFF6FF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHtMode}" Value="True">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBlock Text="{Binding GrandTotalLabel}" FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="Bold"/>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}" FontSize="22" FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}">
                                            <Run Text="{Binding GrandTotal, StringFormat=N0, Mode=OneWay}"/>
                                            <Run Text=" CDF" FontSize="13"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- USD equivalent -->
                                <Border Background="#F8FAFC" CornerRadius="8" Padding="10,6" Margin="0,0,0,4"
                                        BorderBrush="#E2E8F0" BorderThickness="1">
                                    <Grid>
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="💱 "/><Run Text="{Binding AlternateCurrencyLabel, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="Bold">
                                            <Run Text="{Binding TotalInAlternateCurrency, StringFormat=N2, Mode=OneWay}"/>
                                            <Run Text=" " FontSize="9"/><Run Text="{Binding AlternateCurrencyLabel, Mode=OneWay}" FontSize="9"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- À payer TTC (HT mode) -->
                                <Border Background="#F0FDF4" CornerRadius="8" Padding="12,8" Margin="0,0,0,6"
                                        Visibility="{Binding IsHtMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid>
                                        <TextBlock Text="💰 À encaisser (TTC)" FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold" Foreground="#065F46"/>
                                        <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource AppFont}" FontSize="16" FontWeight="Bold" Foreground="#065F46">
                                            <Run Text="{Binding TotalTTC, StringFormat=N0, Mode=OneWay}"/> <Run Text=" CDF" FontSize="11"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- ══ BEFORE NORMALIZATION ══ -->
                                <StackPanel Visibility="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding PaymentTypes}" SelectedItem="{Binding SelectedPaymentType}"
                                                  FontFamily="{StaticResource AppFont}" Padding="8,6" Margin="0,0,4,0"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding InvoiceTypes}" SelectedItem="{Binding InvoiceType}"
                                                  FontFamily="{StaticResource AppFont}" Padding="8,6" Margin="4,0,0,0"/>
                                    </Grid>

                                    <!-- Split payment toggle -->
                                    <Button Command="{Binding ToggleSplitPaymentCommand}" Padding="8,5" Margin="0,0,0,6"
                                            Background="#F3F4F6" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Center">
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="💳 Paiement fractionné"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowSplitPayment}" Value="True">
                                                            <Setter Property="Text" Value="✕ Fermer paiement fractionné"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>

                                    <!-- Split payment items -->
                                    <StackPanel Visibility="{Binding ShowSplitPayment, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl ItemsSource="{Binding PaymentItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" FontFamily="{StaticResource AppFont}" FontSize="12"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat=N0}" FontFamily="{StaticResource AppFont}"
                                                                   FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                                        <Button Grid.Column="2" Content="✕" FontSize="10" Foreground="Red" Background="Transparent"
                                                                BorderThickness="0" Cursor="Hand"
                                                                Command="{Binding DataContext.RemovePaymentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid Margin="0,4,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding PaymentAmount}" FontFamily="{StaticResource AppFont}" FontSize="13" Padding="8,6"
                                                     ToolTip="Vide = reste à payer"/>
                                            <Button Grid.Column="1" Content="+ Ajouter" Command="{Binding AddPaymentCommand}"
                                                    FontFamily="{StaticResource AppFont}" FontSize="11" Padding="10,6" Margin="6,0,0,0"
                                                    Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Reste à payer" FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Remaining}" Value="0">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="{Binding Remaining, StringFormat=N0, Mode=OneWay}"/> <Run Text=" CDF"/>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Simple payment (when not split) -->
                                    <StackPanel Visibility="{Binding ShowSplitPayment, Converter={StaticResource InverseBoolConverter}}">
                                        <TextBlock Text="Montant reçu" FontFamily="{StaticResource AppFont}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding ReceivedAmount, UpdateSourceTrigger=PropertyChanged}"
                                                     FontFamily="{StaticResource AppFont}" FontSize="18" FontWeight="SemiBold" Padding="10,8"/>
                                            <Button Grid.Column="1" Content="= Exact" Command="{Binding SetExactAmountCommand}"
                                                    FontFamily="{StaticResource AppFont}" FontSize="11" Padding="10,6" Margin="6,0,0,0"
                                                    Background="#F3F4F6" BorderThickness="0" Cursor="Hand"/>
                                        </Grid>
                                        <WrapPanel Margin="0,0,0,6">
                                            <Button Content="1 000" Padding="10,6" Margin="0,0,6,4" FontFamily="{StaticResource AppFont}" FontSize="12"
                                                    Background="#F3F4F6" BorderThickness="0" Cursor="Hand"
                                                    Command="{Binding SetRoundedAmountCommand}" CommandParameter="1000"/>
                                            <Button Content="5 000" Padding="10,6" Margin="0,0,6,4" FontFamily="{StaticResource AppFont}" FontSize="12"
                                                    Background="#F3F4F6" BorderThickness="0" Cursor="Hand"
                                                    Command="{Binding SetRoundedAmountCommand}" CommandParameter="5000"/>
                                            <Button Content="10 000" Padding="10,6" Margin="0,0,6,4" FontFamily="{StaticResource AppFont}" FontSize="12"
                                                    Background="#F3F4F6" BorderThickness="0" Cursor="Hand"
                                                    Command="{Binding SetRoundedAmountCommand}" CommandParameter="10000"/>
                                            <Button Content="20 000" Padding="10,6" Margin="0,0,6,4" FontFamily="{StaticResource AppFont}" FontSize="12"
                                                    Background="#F3F4F6" BorderThickness="0" Cursor="Hand"
                                                    Command="{Binding SetRoundedAmountCommand}" CommandParameter="20000"/>
                                            <Button Content="50 000" Padding="10,6" Margin="0,0,0,4" FontFamily="{StaticResource AppFont}" FontSize="12"
                                                    Background="#F3F4F6" BorderThickness="0" Cursor="Hand"
                                                    Command="{Binding SetRoundedAmountCommand}" CommandParameter="50000"/>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Change -->
                                    <Border Background="#FEF3C7" CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
                                            Visibility="{Binding ShowChange, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid>
                                            <TextBlock Text="💰 Monnaie" FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="Medium" Foreground="#92400E"/>
                                            <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource AppFont}" FontSize="16" FontWeight="Bold" Foreground="#92400E">
                                                <Run Text="{Binding ChangeAmount, StringFormat=N0, Mode=OneWay}"/> <Run Text=" CDF"/>
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <!-- Hold + Encaisser -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Command="{Binding RequestHoldCommand}" Padding="14,14" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#F59E0B"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bg" Property="Opacity" Value="0.9"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="⏸" FontSize="20" Foreground="White"/>
                                        </Button>
                                        <Button Grid.Column="1" Command="{Binding ProcessSaleCommand}" Padding="16,14" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Center">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bg" Property="Opacity" Value="0.9"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔒" FontSize="18" Foreground="White" Margin="0,0,10,0"/>
                                                <TextBlock Text="ENCAISSER" FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <!-- ══ AFTER NORMALIZATION ══ -->
                                <StackPanel Visibility="{Binding IsNormalized, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border Background="#F0FDF4" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="CODE DEF/DGI" FontFamily="{StaticResource AppFont}" FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding CodeDEFDGI}" FontFamily="Consolas" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="NIM:" FontFamily="{StaticResource AppFont}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,2"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Nim}" FontFamily="Consolas" FontSize="11"/>
                                        <TextBlock Grid.Row="1" Text="Compteurs:" FontFamily="{StaticResource AppFont}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,2"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Counters}" FontFamily="Consolas" FontSize="11"/>
                                        <TextBlock Grid.Row="2" Text="Date DEF:" FontFamily="{StaticResource AppFont}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DeviceDateTime}" FontFamily="Consolas" FontSize="11"/>
                                    </Grid>
                                    <Button Command="{Binding NewSaleCommand}" Padding="14,12" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Center">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.9"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📄" FontSize="16" Foreground="White" Margin="0,0,8,0"/>
                                            <TextBlock Text="NOUVELLE VENTE" FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Reprint -->
                                <Button Command="{Binding ReprintReceiptCommand}" Padding="12,10" BorderThickness="0" Cursor="Hand" Margin="0,8,0,0"
                                        HorizontalContentAlignment="Center"
                                        Visibility="{Binding HasThermalPrinter, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#F3F4F6"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bg" Property="Background" Value="#E5E7EB"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🖨" FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="Réimprimer (Duplicata)" FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <!-- Printer indicator -->
                                <Border CornerRadius="8" Padding="8,5" Margin="0,6,0,0" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F0FDF4"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasThermalPrinter}" Value="False">
                                                    <Setter Property="Background" Value="#FEF2F2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#10B981"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasThermalPrinter}" Value="False">
                                                            <Setter Property="Fill" Value="#EF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding ThermalPrinterName}" FontFamily="{StaticResource AppFont}" FontSize="9"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- CART ITEMS LIST -->
                    <ListBox ItemsSource="{Binding CartItems}" SelectedItem="{Binding SelectedCartItem}"
                             Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="8,8">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="4,2"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="10" Padding="12,10" Background="#FAFAFA"
                                                    BorderBrush="#F3F4F6" BorderThickness="1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                    <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource AppFont}" FontSize="13"
                                                   FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="{Binding QuantityDisplay, Mode=OneWay}"/> <Run Text=" · Grp "/> <Run Text="{Binding TaxGroupLabel, Mode=OneWay}"/>
                                        </TextBlock>
                                        <Border Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Background="#FEE2E2" CornerRadius="4" Padding="6,1" Margin="0,2,0,0" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding DiscountDisplay, Mode=OneWay}" FontFamily="{StaticResource AppFont}" FontSize="10"
                                                       Foreground="#DC2626" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                        <Button Content="−" FontSize="14" FontWeight="Bold" Width="32" Height="32" Padding="0"
                                                Background="#F3F4F6" BorderThickness="0" Cursor="Hand"
                                                Command="{Binding DataContext.DecrementQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <TextBlock Text="{Binding Quantity, StringFormat=G}" FontFamily="{StaticResource AppFont}" FontSize="14"
                                                   FontWeight="Bold" VerticalAlignment="Center" Margin="8,0" MinWidth="20" TextAlignment="Center"/>
                                        <Button Content="＋" FontSize="14" FontWeight="Bold" Width="32" Height="32" Padding="0"
                                                Background="#F3F4F6" BorderThickness="0" Cursor="Hand"
                                                Command="{Binding DataContext.IncrementQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="70">
                                        <TextBlock Text="{Binding AmountTTC, StringFormat='{}{0:N0}'}" FontFamily="{StaticResource AppFont}" FontSize="14"
                                                   FontWeight="Bold" HorizontalAlignment="Right" Foreground="{StaticResource PrimaryBrush}"/>
                                        <Button Content="✕ retirer" FontSize="9" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Foreground="#EF4444" HorizontalAlignment="Right" Padding="0" FontFamily="{StaticResource AppFont}"
                                                Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.IsNormalized, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolConverter}}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════ -->
            <!--  OVERLAY PANELS (touch-friendly, one at a time)       -->
            <!-- ══════════════════════════════════════════════════════ -->

            <!-- 👤 CLIENT PANEL -->
            <Border Background="White" CornerRadius="16" Margin="0,60,0,0" VerticalAlignment="Top" MaxHeight="500"
                    Visibility="{Binding ShowClientPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.15" ShadowDepth="5"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="👤 Client" FontFamily="{StaticResource AppFont}" FontSize="16" FontWeight="Bold"/>
                            <Button HorizontalAlignment="Right" Content="✕" FontSize="14" Background="Transparent"
                                    BorderThickness="0" Cursor="Hand" Command="{Binding ToggleClientPanelCommand}"/>
                        </Grid>
                        <TextBlock Text="🔍 Rechercher" FontFamily="{StaticResource AppFont}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="PosClientSearch" Text="{Binding ClientSearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                 FontFamily="{StaticResource AppFont}" FontSize="14" Padding="10,8" Margin="0,0,0,4"/>
                        <Popup IsOpen="{Binding IsClientSearchOpen, Mode=TwoWay}" StaysOpen="False"
                               PlacementTarget="{Binding ElementName=PosClientSearch}" Placement="Bottom"
                               Width="{Binding ActualWidth, ElementName=PosClientSearch}">
                            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="0,0,8,8" MaxHeight="200">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ClientSearchResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.SelectClientCommand, RelativeSource={RelativeSource AncestorType=Popup}}"
                                                        CommandParameter="{Binding}" Background="Transparent" BorderThickness="0"
                                                        HorizontalContentAlignment="Stretch" Cursor="Hand" Padding="12,10">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="Medium"/>
                                                        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                                            <Run Text="{Binding Type}"/> <Run Text=" · NIF: "/> <Run Text="{Binding NIF, TargetNullValue='-'}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                        <ComboBox ItemsSource="{Binding ClientTypes}" SelectedItem="{Binding SelectedClientType}"
                                  FontFamily="{StaticResource AppFont}" Padding="8,6" Margin="0,6,0,6"/>
                        <TextBox Text="{Binding ClientNIF}" FontFamily="{StaticResource AppFont}" Padding="10,8" Margin="0,0,0,6"
                                 Tag="NIF"/>
                        <TextBox Text="{Binding ClientName}" FontFamily="{StaticResource AppFont}" Padding="10,8" Margin="0,0,0,6"
                                 Tag="Nom / Dénomination"/>
                        <TextBox Text="{Binding ClientPhone}" FontFamily="{StaticResource AppFont}" Padding="10,8" Margin="0,0,0,6"
                                 Tag="Téléphone"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="💾 Enregistrer" Command="{Binding SaveClientInlineCommand}" Margin="0,0,4,0"
                                    FontFamily="{StaticResource AppFont}" FontSize="12" Padding="10,10"
                                    Background="#F0FDF4" Foreground="#065F46" BorderThickness="1" BorderBrush="#BBF7D0" Cursor="Hand"/>
                            <Button Grid.Column="1" Content="✕ Vider" Command="{Binding ClearClientCommand}" Margin="4,0,0,0"
                                    FontFamily="{StaticResource AppFont}" FontSize="12" Padding="10,10"
                                    Background="#FEF2F2" Foreground="#DC2626" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 📄 CREDIT NOTE PANEL -->
            <Border Background="White" CornerRadius="16" Margin="0,60,0,0" VerticalAlignment="Top" MaxHeight="500"
                    Visibility="{Binding ShowCreditNotePanel, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.15" ShadowDepth="5"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="📄 Avoir" FontFamily="{StaticResource AppFont}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <Button HorizontalAlignment="Right" Content="✕" FontSize="14" Background="Transparent"
                                    BorderThickness="0" Cursor="Hand" Command="{Binding ToggleCreditNotePanelCommand}"/>
                        </Grid>
                        <ComboBox ItemsSource="{Binding CreditNoteNatures}" SelectedItem="{Binding SelectedCreditNoteNature}"
                                  FontFamily="{StaticResource AppFont}" Padding="8,6" Margin="0,0,0,8"/>
                        <TextBlock Text="Code DEF/DGI original" FontFamily="{StaticResource AppFont}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding OriginalReference, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="14" Padding="10,8"
                                     IsEnabled="{Binding IsRRR, Converter={StaticResource InverseBoolConverter}}"/>
                            <Button Grid.Column="1" Content="🔍 Charger" Command="{Binding LookupOriginalInvoiceCommand}" Margin="6,0,0,0"
                                    FontFamily="{StaticResource AppFont}" FontSize="12" Background="{StaticResource PrimaryBrush}" Foreground="White"
                                    Padding="12,8" BorderThickness="0" Cursor="Hand"
                                    Visibility="{Binding RequiresOriginalLookup, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                        <Border Background="#F0FDF4" CornerRadius="8" Padding="10,8" Margin="0,0,0,8"
                                Visibility="{Binding IsOriginalLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="✓ Facture chargée" FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="Bold" Foreground="#065F46"/>
                                <TextBlock Text="{Binding OriginalInvoiceSummary}" FontFamily="{StaticResource AppFont}" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding CreditNoteSelections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="4,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayName}" FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="Medium"/>
                                                <TextBlock Text="{Binding DisplayQuantity}" FontFamily="{StaticResource AppFont}" FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="2" Text="{Binding SelectedQuantity, UpdateSourceTrigger=PropertyChanged}"
                                                     FontFamily="{StaticResource AppFont}" FontSize="13" Padding="6,4" Margin="4,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding DisplayPrice}" FontFamily="{StaticResource AppFont}" FontSize="11"
                                                       Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+ Ajouter sélection" Command="{Binding AddAllSelectedCreditNoteLinesCommand}" Margin="0,8,0,0"
                                FontFamily="{StaticResource AppFont}" FontSize="13" Padding="12,10"
                                Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand"
                                HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 💰 ADVANCE PANEL -->
            <Border Background="White" CornerRadius="16" Margin="0,60,0,0" VerticalAlignment="Top" MaxHeight="400"
                    Visibility="{Binding ShowAdvancePanel, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.15" ShadowDepth="5"/>
                </Border.Effect>
                <StackPanel Margin="20">
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="💰 Acompte" FontFamily="{StaticResource AppFont}" FontSize="16" FontWeight="Bold" Foreground="#7C3AED"/>
                        <Button HorizontalAlignment="Right" Content="✕" FontSize="14" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" Command="{Binding ToggleAdvancePanelCommand}"/>
                    </Grid>
                    <TextBox Text="{Binding AdvanceGroupId, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="13" Padding="10,8" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="🆕 Nouveau" Command="{Binding CreateNewAdvanceGroupCommand}" Margin="0,0,4,0"
                                FontFamily="{StaticResource AppFont}" FontSize="12" Padding="10,10"
                                Background="#7C3AED" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <Button Grid.Column="1" Content="📋 Charger" Command="{Binding LoadAdvanceGroupCommand}" Margin="4,0,0,0"
                                FontFamily="{StaticResource AppFont}" FontSize="12" Padding="10,10"
                                Background="#F3F4F6" BorderThickness="0" Cursor="Hand"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding PreviousAdvances}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F5F3FF" CornerRadius="6" Padding="10,6" Margin="0,2">
                                    <Grid>
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12">
                                            <Run Text="{Binding InvoiceNumber}" FontWeight="SemiBold"/> <Run Text=" — "/> <Run Text="{Binding DateDisplay}"/>
                                        </TextBlock>
                                        <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="Bold" Foreground="#7C3AED">
                                            <Run Text="{Binding Amount, StringFormat=N0}"/> <Run Text=" CDF" FontSize="10"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 💬 COMMENT PANEL -->
            <Border Background="White" CornerRadius="16" Margin="0,60,0,0" VerticalAlignment="Top" MaxHeight="400"
                    Visibility="{Binding ShowCommentPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.15" ShadowDepth="5"/>
                </Border.Effect>
                <StackPanel Margin="20">
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="💬 Commentaires" FontFamily="{StaticResource AppFont}" FontSize="16" FontWeight="Bold"/>
                        <Button HorizontalAlignment="Right" Content="✕" FontSize="14" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" Command="{Binding ToggleCommentPanelCommand}"/>
                    </Grid>
                    <TextBlock Text="{Binding CommentALabel}" FontFamily="{StaticResource AppFont}" FontSize="12"
                               FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding CommentA, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource AppFont}"
                             FontSize="14" Padding="10,8" Margin="0,0,0,10"/>
                    <Expander Header="Lignes B–H" FontFamily="{StaticResource AppFont}" FontSize="12"
                              Foreground="{StaticResource TextSecondaryBrush}">
                        <StackPanel Margin="0,8,0,0">
                            <TextBox Text="{Binding CommentB}" FontFamily="{StaticResource AppFont}" Padding="8,6" Margin="0,0,0,4" Tag="B"/>
                            <TextBox Text="{Binding CommentC}" FontFamily="{StaticResource AppFont}" Padding="8,6" Margin="0,0,0,4" Tag="C"/>
                            <TextBox Text="{Binding CommentD}" FontFamily="{StaticResource AppFont}" Padding="8,6" Margin="0,0,0,4" Tag="D"/>
                            <TextBox Text="{Binding CommentE}" FontFamily="{StaticResource AppFont}" Padding="8,6" Margin="0,0,0,4" Tag="E"/>
                            <TextBox Text="{Binding CommentF}" FontFamily="{StaticResource AppFont}" Padding="8,6" Margin="0,0,0,4" Tag="F"/>
                            <TextBox Text="{Binding CommentG}" FontFamily="{StaticResource AppFont}" Padding="8,6" Margin="0,0,0,4" Tag="G"/>
                            <TextBox Text="{Binding CommentH}" FontFamily="{StaticResource AppFont}" Padding="8,6" Tag="H"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- ⏳ PENDING INVOICES PANEL -->
            <Border Background="White" CornerRadius="16" Margin="0,60,0,0" VerticalAlignment="Top" MaxHeight="450"
                    Visibility="{Binding ShowPendingPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.15" ShadowDepth="5"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="⏳ Factures en attente" FontFamily="{StaticResource AppFont}" FontSize="16" FontWeight="Bold"/>
                            <Button HorizontalAlignment="Right" Content="✕" FontSize="14" Background="Transparent"
                                    BorderThickness="0" Cursor="Hand" Command="{Binding TogglePendingPanelCommand}"/>
                        </Grid>
                        <Button Content="🔄 Vérifier le dispositif" Command="{Binding CheckPendingInvoicesCommand}" Margin="0,0,0,10"
                                FontFamily="{StaticResource AppFont}" FontSize="13" Padding="12,10"
                                Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" Cursor="Hand"
                                HorizontalContentAlignment="Center"/>
                        <ItemsControl ItemsSource="{Binding PendingInvoices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFFBEB" CornerRadius="6" Padding="10,8" Margin="0,3" BorderBrush="#FDE68A" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontFamily="Consolas" FontSize="12" FontWeight="SemiBold">
                                                    <Run Text="UID: "/><Run Text="{Binding Uid}"/>
                                                </TextBlock>
                                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="{Binding DateDisplay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="✕ Annuler"
                                                    Command="{Binding DataContext.CancelPendingInvoiceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Uid}" FontFamily="{StaticResource AppFont}" FontSize="12"
                                                    Background="#FEE2E2" Foreground="#DC2626" Padding="12,8" BorderThickness="0" Cursor="Hand"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding CancelUid, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="13" Padding="10,8"
                                     ToolTip="UID manuel"/>
                            <Button Grid.Column="1" Content="🗑 Annuler" Command="{Binding CancelPendingInvoiceCommand}" Margin="6,0,0,0"
                                    FontFamily="{StaticResource AppFont}" FontSize="12" Background="#DC2626" Foreground="White"
                                    Padding="12,8" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                        <Border Margin="0,8,0,0" CornerRadius="6" Padding="10,6" Background="#ECFDF5"
                                Visibility="{Binding ShowPendingSuccess, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding PendingStatusMessage}" Foreground="{StaticResource SuccessBrush}"
                                       FontFamily="{StaticResource AppFont}" FontSize="11" TextWrapping="Wrap"/>
                        </Border>
                        <Border Margin="0,8,0,0" CornerRadius="6" Padding="10,6" Background="#FEF2F2"
                                Visibility="{Binding ShowPendingError, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding PendingStatusMessage}" Foreground="{StaticResource ErrorBrush}"
                                       FontFamily="{StaticResource AppFont}" FontSize="11" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- DISCOUNT PANEL (existing) -->
            <Border Background="White" CornerRadius="16" Margin="0,60,0,0" VerticalAlignment="Top" MaxHeight="420"
                    Visibility="{Binding ShowDiscountPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.15" ShadowDepth="5"/>
                </Border.Effect>
                <StackPanel Margin="20">
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="% Remise" FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="Bold"/>
                        <Button HorizontalAlignment="Right" Content="✕" FontSize="14" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" Command="{Binding ToggleDiscountPanelCommand}"/>
                    </Grid>
                    <Border Background="#F3F4F6" CornerRadius="8" Padding="10,8" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedCartItem.Name}" FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="Medium"/>
                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="{Binding SelectedCartItem.QuantityDisplay, Mode=OneWay}"/> <Run Text=" → "/>
                                <Run Text="{Binding SelectedCartItem.AmountTTC, StringFormat=N0, Mode=OneWay}"/> <Run Text=" CDF"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <WrapPanel Margin="0,0,0,14">
                        <Button Content="5 %" Padding="16,10" Margin="0,0,6,6" FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="SemiBold"
                                Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Cursor="Hand"
                                Command="{Binding ApplyQuickDiscountCommand}" CommandParameter="5"/>
                        <Button Content="10 %" Padding="16,10" Margin="0,0,6,6" FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="SemiBold"
                                Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Cursor="Hand"
                                Command="{Binding ApplyQuickDiscountCommand}" CommandParameter="10"/>
                        <Button Content="15 %" Padding="16,10" Margin="0,0,6,6" FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="SemiBold"
                                Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Cursor="Hand"
                                Command="{Binding ApplyQuickDiscountCommand}" CommandParameter="15"/>
                        <Button Content="20 %" Padding="16,10" Margin="0,0,0,6" FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="SemiBold"
                                Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Cursor="Hand"
                                Command="{Binding ApplyQuickDiscountCommand}" CommandParameter="20"/>
                    </WrapPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding CustomDiscountValue, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource AppFont}" FontSize="16" Padding="10,8"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                            <RadioButton Content=" %" IsChecked="{Binding IsPercentDiscount}" FontFamily="{StaticResource AppFont}" FontSize="13" Margin="0,0,8,0"/>
                            <RadioButton Content=" CDF" FontFamily="{StaticResource AppFont}" FontSize="13"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="OK" Command="{Binding ApplyCustomDiscountCommand}"
                                Padding="14,8" FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="Bold"
                                Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    </Grid>
                    <Button Command="{Binding RemoveItemDiscountCommand}" Padding="10,10" BorderThickness="1" BorderBrush="#FCA5A5"
                            Background="#FFF5F5" Cursor="Hand" HorizontalContentAlignment="Center"
                            Visibility="{Binding SelectedCartItem.HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="🗑 Supprimer la remise" FontFamily="{StaticResource AppFont}" FontSize="13" Foreground="#DC2626"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- HELD PANEL (existing) -->
            <Border Background="White" CornerRadius="16" Margin="0,60,0,0" VerticalAlignment="Top" MaxHeight="400"
                    Visibility="{Binding ShowHeldPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.15" ShadowDepth="5"/>
                </Border.Effect>
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FEF3C7" Padding="16,12" CornerRadius="16,16,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏸ En attente" FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="Bold" Foreground="#92400E"/>
                                <Border Background="#92400E" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding HeldCount}" FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Content="✕" FontSize="14" Background="Transparent"
                                    BorderThickness="0" Cursor="Hand" Foreground="#92400E" Command="{Binding ToggleHeldPanelCommand}"/>
                        </Grid>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                        <ItemsControl ItemsSource="{Binding HeldTransactions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="4,4" CornerRadius="12" Padding="14,12" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontFamily="{StaticResource AppFont}" FontSize="13"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="{Binding ItemCount, Mode=OneWay}"/> <Run Text=" art. · "/>
                                                    <Run Text="{Binding TotalDisplay, Mode=OneWay}"/> <Run Text=" CDF"/>
                                                </TextBlock>
                                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="🕐 "/><Run Text="{Binding TimeDisplay, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center" Cursor="Hand"
                                                    Command="{Binding DataContext.RecallHeldSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,10">
                                                                        <TextBlock Text="▶" FontSize="14" Foreground="White" FontWeight="Bold"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bg" Property="Opacity" Value="0.9"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Grid.Column="2" VerticalAlignment="Center" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                                    Command="{Binding DataContext.DeleteHeldSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="🗑" FontSize="14" Opacity="0.6"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- HOLD DIALOG -->
            <Grid Visibility="{Binding ShowHoldDialog, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="#80000000" CornerRadius="16"/>
                <Border Background="White" CornerRadius="16" Padding="24" VerticalAlignment="Center" Margin="30">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" Opacity="0.2" ShadowDepth="4"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="⏸ Mettre en attente" FontFamily="{StaticResource AppFont}" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Text="Raison (optionnel) :" FontFamily="{StaticResource AppFont}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding HoldReason, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource AppFont}"
                                 FontSize="14" Padding="12,10" Margin="0,0,0,16" MaxLength="100"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Annuler" Margin="0,0,4,0" Padding="12,12" Background="#F3F4F6" BorderThickness="0" Cursor="Hand"
                                    FontFamily="{StaticResource AppFont}" FontSize="14" Command="{Binding CancelHoldCommand}"/>
                            <Button Grid.Column="1" Margin="4,0,0,0" Padding="12,12" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding HoldCurrentSaleCommand}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#F59E0B"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Opacity" Value="0.9"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="⏸ Confirmer" FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="Bold" Foreground="White"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>