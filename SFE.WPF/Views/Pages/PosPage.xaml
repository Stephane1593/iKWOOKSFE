<UserControl x:Class="SFE.WPF.Views.Pages.PosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F2F5">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- ══════ GAUCHE : Catalogue ══════ -->
        <DockPanel Grid.Column="0" Margin="16,12,8,12">

            <!-- BARRE DU HAUT -->
            <Border DockPanel.Dock="Top" Background="White" CornerRadius="12"
                    Padding="16,10" Margin="0,0,0,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.06" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Row 1: Clock, Mode, Search, Stats -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Horloge -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentTime}" FontFamily="Consolas"
                                       FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="{Binding CurrentDate}" FontFamily="{StaticResource AppFont}"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <!-- ★ MODE BADGE ★ -->
                        <Border Grid.Column="1" CornerRadius="8" Padding="10,4" Margin="12,0,0,0"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#DBEAFE"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHtMode}" Value="True">
                                            <Setter Property="Background" Value="#FEF3C7"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding PriceModeDisplay}"
                                       FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#1D4ED8"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHtMode}" Value="True">
                                                <Setter Property="Foreground" Value="#92400E"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- Recherche -->
                        <Border Grid.Column="2" Background="#F3F4F6" CornerRadius="10" Margin="16,0" Padding="14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="SearchBox" Grid.Column="1"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                         FontFamily="{StaticResource AppFont}" FontSize="14"
                                         Background="Transparent" BorderThickness="0"
                                         VerticalAlignment="Center" Padding="0,10"/>
                                <Popup Grid.Column="1" IsOpen="{Binding ShowSearchResults, Mode=TwoWay}"
                                       StaysOpen="False" PlacementTarget="{Binding ElementName=SearchBox}"
                                       Placement="Bottom" Width="{Binding ActualWidth, ElementName=SearchBox}">
                                    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                                            CornerRadius="0,0,10,10" MaxHeight="300">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" Opacity="0.12" ShadowDepth="6"/>
                                        </Border.Effect>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.AddToCartCommand,
                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent" BorderThickness="0"
                                                                HorizontalContentAlignment="Stretch"
                                                                Cursor="Hand" Padding="14,10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontFamily="{StaticResource AppFont}"
                                                                               FontSize="13" FontWeight="Medium"/>
                                                                    <TextBlock FontFamily="Consolas" FontSize="11"
                                                                               Foreground="{StaticResource TextSecondaryBrush}">
                                                                        <Run Text="{Binding Code, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding UnitPrice, StringFormat='{}{0:N0} CDF'}"
                                                                           FontFamily="{StaticResource AppFont}"
                                                                           FontSize="13" FontWeight="Bold"
                                                                           Foreground="{StaticResource PrimaryBrush}"
                                                                           VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>

                        <!-- Stats -->
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊 " FontSize="13"/>
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="{Binding TodaySalesCount, Mode=OneWay}"/>
                                    <Run Text=" ventes"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="13"
                                       FontWeight="SemiBold" HorizontalAlignment="Right"
                                       Foreground="{StaticResource PrimaryBrush}">
                                <Run Text="{Binding TodaySalesTotal, StringFormat=N0, Mode=OneWay}"/>
                                <Run Text=" CDF"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- ═══ 🆕 Row 2: POINT DE VENTE ═══ -->
                    <Border CornerRadius="8" Padding="10,7" Margin="0,8,0,0"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#F0F9FF"/>
                                <Setter Property="BorderBrush" Value="#BAE6FD"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPointOfSale}" Value="{x:Null}">
                                        <Setter Property="Background" Value="#FEF2F2"/>
                                        <Setter Property="BorderBrush" Value="#FECACA"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="🏪" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailablePointsOfSale}"
                                      SelectedItem="{Binding SelectedPointOfSale}"
                                      IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"
                                      FontFamily="{StaticResource AppFont}" FontSize="12"
                                      Padding="6,4">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#E0F2FE" CornerRadius="4" Padding="5,1" Margin="0,0,8,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Code}" FontFamily="Consolas" FontSize="10"
                                                           FontWeight="Bold" Foreground="#0369A1"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource AppFont}"
                                                       FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                                       Foreground="#6B7280" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <Run Text="("/>
                                                <Run Text="{Binding City}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding DeviceType}"/>
                                                <Run Text=")"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- POS info -->
                            <TextBlock Grid.Column="2" Text="{Binding SelectedPosInfo}"
                                       FontFamily="{StaticResource AppFont}" FontSize="10"
                                       Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPointOfSale}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Badge count -->
                            <Border Grid.Column="3" CornerRadius="10" Padding="8,3" Margin="8,0,0,0"
                                    Background="#0EA5E9" VerticalAlignment="Center"
                                    Visibility="{Binding HasMultiplePos, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                           Foreground="White" FontWeight="Bold">
                                    <Run Text="{Binding AvailablePointsOfSale.Count, Mode=OneWay}"/>
                                    <Run Text=" POS"/>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Warning when no POS -->
                    <TextBlock Text="⚠ Aucun point de vente sélectionné — l'encaissement sera bloqué"
                               FontFamily="{StaticResource AppFont}" FontSize="10"
                               Foreground="#DC2626" Margin="0,4,0,0" FontStyle="Italic">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPointOfSale}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- CATÉGORIES -->
            <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled" Margin="0,0,0,12" Height="44">
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding ShowFavoritesCommand}" Margin="0,0,8,0"
                            Cursor="Hand" Padding="14,8" BorderThickness="0"
                            FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowFavoritesOnly}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⭐" Margin="0,0,6,0"/>
                            <TextBlock Text="Favoris"/>
                        </StackPanel>
                    </Button>

                    <Button Content="Tout" Command="{Binding ShowAllProductsCommand}"
                            Margin="0,0,8,0" Cursor="Hand" Padding="14,8"
                            Background="White" Foreground="{StaticResource TextPrimaryBrush}"
                            BorderThickness="0" FontFamily="{StaticResource AppFont}" FontSize="13"/>

                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,8,0" Cursor="Hand" Padding="14,8" BorderThickness="0"
                                        FontFamily="{StaticResource AppFont}" FontSize="13"
                                        Background="White" Foreground="{StaticResource TextPrimaryBrush}"
                                        Command="{Binding DataContext.SelectCategoryCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Name}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- GRILLE PRODUITS -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DisplayProducts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,10,10" Width="150" Height="110"
                                    Cursor="Hand" BorderThickness="0"
                                    Command="{Binding DataContext.AddToCartCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CardBorder" Background="White" CornerRadius="12"
                                                Padding="12" BorderThickness="1" BorderBrush="#E5E7EB">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="4" Opacity="0.05" ShadowDepth="1"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource AppFont}"
                                                           FontSize="12" FontWeight="Medium"
                                                           TextTrimming="CharacterEllipsis" MaxHeight="34" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Row="1" VerticalAlignment="Center"
                                                           FontFamily="Consolas" FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="{Binding Code, Mode=OneWay}"/>
                                                </TextBlock>
                                                <Grid Grid.Row="2">
                                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="15"
                                                               FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}">
                                                        <Run Text="{Binding UnitPrice, StringFormat=N0, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                               FontFamily="{StaticResource AppFont}" FontSize="10"
                                                               Foreground="{StaticResource TextSecondaryBrush}">
                                                        <Run Text="{Binding TaxGroup, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush"
                                                        Value="{StaticResource PrimaryBrush}"/>
                                                <Setter TargetName="CardBorder" Property="Background" Value="#EFF6FF"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="CardBorder" Property="Background" Value="#DBEAFE"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- ══════ DROITE : Panier ══════ -->
        <Grid Grid.Column="1" Margin="8,12,16,12">

            <Border Background="White" CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Opacity="0.08" ShadowDepth="3"/>
                </Border.Effect>
                <DockPanel>

                    <!-- HEADER PANIER -->
                    <Border DockPanel.Dock="Top" Padding="20,16,20,12"
                            BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="🛒 Panier" FontFamily="{StaticResource AppFont}"
                                           FontSize="17" FontWeight="Bold"/>
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="{Binding CartItemCount, Mode=OneWay}"/>
                                    <Run Text=" ligne(s) ·"/>
                                    <Run Text="{Binding TotalArticles, Mode=OneWay}"/>
                                    <Run Text=" article(s)"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Bouton Remise -->
                            <Button Grid.Column="1" Command="{Binding ToggleDiscountPanelCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" ToolTip="Remise sur l'article sélectionné" Margin="0,0,6,0"
                                    Visibility="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}">
                                <TextBlock Text="%" FontSize="17" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </Button>

                            <Button Grid.Column="2" Command="{Binding ToggleHeldPanelCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" ToolTip="Paniers en attente" Margin="0,0,6,0">
                                <Grid>
                                    <TextBlock Text="⏸" FontSize="18"/>
                                    <Border Background="#EF4444" CornerRadius="8" MinWidth="16" Height="16"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-6,-8,0" Padding="4,0"
                                            Visibility="{Binding HeldCount, Converter={StaticResource IntToVisibilityConverter}}">
                                        <TextBlock Text="{Binding HeldCount}" FontSize="9" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" FontFamily="{StaticResource AppFont}"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <TextBlock Grid.Column="3" Text="{Binding InvoiceNumber}" FontFamily="Consolas"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                            <Button Grid.Column="4" Content="🗑" FontSize="16"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" ToolTip="Vider le panier"
                                    Command="{Binding ClearCartCommand}"
                                    Visibility="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}"/>
                        </Grid>
                    </Border>

                    <!-- PIED : Totaux + Actions -->
                    <DockPanel DockPanel.Dock="Bottom">

                        <!-- Status messages -->
                        <Border DockPanel.Dock="Bottom" Margin="12,0,12,12" CornerRadius="8" Padding="12,8"
                                Visibility="{Binding ShowSuccess, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="#ECFDF5">
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                                       FontFamily="{StaticResource AppFont}" FontSize="12" TextWrapping="Wrap"/>
                        </Border>
                        <Border DockPanel.Dock="Bottom" Margin="12,0,12,6" CornerRadius="8" Padding="12,8"
                                Visibility="{Binding ShowError, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="#FEF2F2">
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource ErrorBrush}"
                                       FontFamily="{StaticResource AppFont}" FontSize="12" TextWrapping="Wrap"/>
                        </Border>

                        <StackPanel Margin="20,0,20,16">
                            <Separator Margin="0,0,0,12"/>

                            <!-- Sous-total avant remise -->
                            <Grid Margin="0,0,0,4"
                                  Visibility="{Binding HasAnyDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Sous-total avant remise" FontFamily="{StaticResource AppFont}"
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding TotalHTBeforeDiscount, StringFormat='{}{0:N0} CDF'}"
                                           FontFamily="{StaticResource AppFont}" FontSize="12"
                                           HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}"
                                           TextDecorations="Strikethrough"/>
                            </Grid>

                            <!-- Total remise -->
                            <Grid Margin="0,0,0,4"
                                  Visibility="{Binding HasAnyDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="💸 Remise totale" FontFamily="{StaticResource AppFont}"
                                           FontSize="12" Foreground="#DC2626"/>
                                <TextBlock Text="{Binding TotalDiscount, StringFormat='-{0:N0} CDF'}"
                                           FontFamily="{StaticResource AppFont}" FontSize="12"
                                           HorizontalAlignment="Right" Foreground="#DC2626" FontWeight="SemiBold"/>
                            </Grid>

                            <!-- Détail fiscal -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Total HT" FontFamily="{StaticResource AppFont}"
                                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding TotalHT, StringFormat='{}{0:N0} CDF'}"
                                           FontFamily="{StaticResource AppFont}" FontSize="13"
                                           HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="TVA" FontFamily="{StaticResource AppFont}" FontSize="13"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="{Binding TotalTVA, StringFormat='{}{0:N0} CDF'}"
                                           FontFamily="{StaticResource AppFont}" FontSize="13"
                                           HorizontalAlignment="Right" Foreground="{StaticResource PrimaryBrush}"/>
                            </Grid>

                            <!-- Taxe spécifique -->
                            <Grid Margin="0,0,0,4">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TotalSpecificTax, Converter={StaticResource IsGreaterThanZeroConverter}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <TextBlock Text="Taxe spécifique" FontFamily="{StaticResource AppFont}" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding TotalSpecificTax, StringFormat='{}{0:N0} CDF'}"
                                           FontFamily="{StaticResource AppFont}" FontSize="13"
                                           HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Total TTC" FontFamily="{StaticResource AppFont}" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding TotalTTC, StringFormat='{}{0:N0} CDF'}"
                                           FontFamily="{StaticResource AppFont}" FontSize="13"
                                           HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>

                            <!-- ★ GRAND TOTAL ★ -->
                            <Border CornerRadius="10" Padding="14,10" Margin="0,8,0,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#EFF6FF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHtMode}" Value="True">
                                                <Setter Property="Background" Value="#FEF3C7"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="{Binding GrandTotalLabel}" FontFamily="{StaticResource AppFont}"
                                                   FontSize="16" FontWeight="Bold"/>
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Prix saisis TTC"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHtMode}" Value="True">
                                                            <Setter Property="Text" Value="Prix saisis HT · TVA en sus"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}" FontSize="22"
                                               FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}">
                                        <Run Text="{Binding GrandTotal, StringFormat=N0, Mode=OneWay}"/>
                                        <Run Text=" CDF" FontSize="14"/>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- "À PAYER TTC" in HT mode -->
                            <Border Background="#F0FDF4" CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
                                    Visibility="{Binding IsHtMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <TextBlock Text="💰 À encaisser (TTC)" FontFamily="{StaticResource AppFont}"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#065F46"/>
                                    <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource AppFont}"
                                               FontSize="16" FontWeight="Bold" Foreground="#065F46">
                                        <Run Text="{Binding TotalTTC, StringFormat=N0, Mode=OneWay}"/>
                                        <Run Text=" CDF" FontSize="11"/>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- ══ AVANT NORMALISATION ══ -->
                            <StackPanel Visibility="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}">

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding PaymentTypes}"
                                              SelectedItem="{Binding SelectedPaymentType}"
                                              FontFamily="{StaticResource AppFont}" Padding="8,6" Margin="0,0,4,0"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding InvoiceTypes}"
                                              SelectedItem="{Binding InvoiceType}"
                                              FontFamily="{StaticResource AppFont}" Padding="8,6" Margin="4,0,0,0"/>
                                </Grid>

                                <TextBlock Text="Montant reçu" FontFamily="{StaticResource AppFont}"
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding ReceivedAmount, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{StaticResource AppFont}" FontSize="18"
                                             FontWeight="SemiBold" Padding="10,8"/>
                                    <Button Grid.Column="1" Content="= Exact"
                                            Command="{Binding SetExactAmountCommand}"
                                            FontFamily="{StaticResource AppFont}" FontSize="11"
                                            Padding="10,6" Margin="6,0,0,0" Cursor="Hand"
                                            Background="#F3F4F6" BorderThickness="0"/>
                                </Grid>

                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="1 000" Padding="8,4" Margin="0,0,6,4"
                                            FontFamily="{StaticResource AppFont}" FontSize="11"
                                            Background="#F3F4F6" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding SetRoundedAmountCommand}" CommandParameter="1000"/>
                                    <Button Content="5 000" Padding="8,4" Margin="0,0,6,4"
                                            FontFamily="{StaticResource AppFont}" FontSize="11"
                                            Background="#F3F4F6" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding SetRoundedAmountCommand}" CommandParameter="5000"/>
                                    <Button Content="10 000" Padding="8,4" Margin="0,0,6,4"
                                            FontFamily="{StaticResource AppFont}" FontSize="11"
                                            Background="#F3F4F6" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding SetRoundedAmountCommand}" CommandParameter="10000"/>
                                    <Button Content="20 000" Padding="8,4" Margin="0,0,6,4"
                                            FontFamily="{StaticResource AppFont}" FontSize="11"
                                            Background="#F3F4F6" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding SetRoundedAmountCommand}" CommandParameter="20000"/>
                                    <Button Content="50 000" Padding="8,4" Margin="0,0,0,4"
                                            FontFamily="{StaticResource AppFont}" FontSize="11"
                                            Background="#F3F4F6" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding SetRoundedAmountCommand}" CommandParameter="50000"/>
                                </WrapPanel>

                                <!-- Monnaie à rendre -->
                                <Border Background="#FEF3C7" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                                        Visibility="{Binding ShowChange, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid>
                                        <TextBlock Text="💰 Monnaie à rendre" FontFamily="{StaticResource AppFont}"
                                                   FontSize="13" FontWeight="Medium" Foreground="#92400E"/>
                                        <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource AppFont}"
                                                   FontSize="16" FontWeight="Bold" Foreground="#92400E">
                                            <Run Text="{Binding ChangeAmount, StringFormat=N0, Mode=OneWay}"/>
                                            <Run Text=" CDF"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Boutons Hold + Encaisser -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Command="{Binding RequestHoldCommand}"
                                            Padding="14,14" BorderThickness="0" Cursor="Hand"
                                            Margin="0,0,8,0" ToolTip="Mettre en attente (F9)">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#F59E0B"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                                                    CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.9"/>
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="⏸" FontSize="20" Foreground="White"/>
                                    </Button>

                                    <Button Grid.Column="1" Command="{Binding ProcessSaleCommand}"
                                            Padding="16,14" BorderThickness="0" Cursor="Hand"
                                            HorizontalContentAlignment="Center">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                                                    CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.9"/>
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔒" FontSize="18" Foreground="White" Margin="0,0,10,0"/>
                                            <TextBlock Text="ENCAISSER" FontFamily="{StaticResource AppFont}"
                                                       FontSize="15" FontWeight="Bold" Foreground="White"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- ══ APRÈS NORMALISATION ══ -->
                            <StackPanel Visibility="{Binding IsNormalized, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border Background="#F0FDF4" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="CODE DEF/DGI" FontFamily="{StaticResource AppFont}"
                                                   FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding CodeDEFDGI}" FontFamily="Consolas"
                                                   FontSize="13" FontWeight="Bold"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="NIM:" FontFamily="{StaticResource AppFont}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,2"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Nim}" FontFamily="Consolas" FontSize="11"/>
                                    <TextBlock Grid.Row="1" Text="Compteurs:" FontFamily="{StaticResource AppFont}"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Counters}"
                                               FontFamily="Consolas" FontSize="11"/>
                                </Grid>

                                <Button Command="{Binding NewSaleCommand}" Padding="14,12" BorderThickness="0"
                                        Cursor="Hand" HorizontalContentAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bg" Property="Opacity" Value="0.9"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📄" FontSize="16" Foreground="White" Margin="0,0,8,0"/>
                                        <TextBlock Text="NOUVELLE VENTE" FontFamily="{StaticResource AppFont}"
                                                   FontSize="14" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <!-- LISTE PANIER -->
                    <ListBox ItemsSource="{Binding CartItems}"
                             SelectedItem="{Binding SelectedCartItem}"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Padding="8,8">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="4,2"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="10" Padding="12,10"
                                                    Background="#FAFAFA" BorderBrush="#F3F4F6" BorderThickness="1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush"
                                                            Value="{StaticResource PrimaryBrush}"/>
                                                    <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                        <Condition Property="IsSelected" Value="False"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Bd" Property="Background" Value="#F5F5F5"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource AppFont}"
                                                   FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="{Binding QuantityDisplay, Mode=OneWay}"/>
                                            <Run Text=" · Grp "/>
                                            <Run Text="{Binding TaxGroupLabel, Mode=OneWay}"/>
                                        </TextBlock>
                                        <!-- Badge remise -->
                                        <Border Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Background="#FEE2E2" CornerRadius="4" Padding="6,1" Margin="0,2,0,0"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding DiscountDisplay, Mode=OneWay}"
                                                       FontFamily="{StaticResource AppFont}" FontSize="10"
                                                       Foreground="#DC2626" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Quantity controls -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="8,0">
                                        <Button Content="−" FontSize="14" FontWeight="Bold"
                                                Width="28" Height="28" Padding="0"
                                                Background="#F3F4F6" BorderThickness="0" Cursor="Hand"
                                                Command="{Binding DataContext.DecrementQuantityCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <TextBlock Text="{Binding Quantity, StringFormat=G}"
                                                   FontFamily="{StaticResource AppFont}" FontSize="14"
                                                   FontWeight="Bold" VerticalAlignment="Center"
                                                   Margin="8,0" MinWidth="20" TextAlignment="Center"/>
                                        <Button Content="＋" FontSize="14" FontWeight="Bold"
                                                Width="28" Height="28" Padding="0"
                                                Background="#F3F4F6" BorderThickness="0" Cursor="Hand"
                                                Command="{Binding DataContext.IncrementQuantityCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>

                                    <!-- Montant TTC -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="70">
                                        <TextBlock Text="{Binding AmountTTC, StringFormat='{}{0:N0}'}"
                                                   FontFamily="{StaticResource AppFont}" FontSize="14"
                                                   FontWeight="Bold" HorizontalAlignment="Right"
                                                   Foreground="{StaticResource PrimaryBrush}"/>
                                        <Button Content="✕ retirer" FontSize="9" Background="Transparent"
                                                BorderThickness="0" Cursor="Hand" Foreground="#EF4444"
                                                HorizontalAlignment="Right" Padding="0"
                                                FontFamily="{StaticResource AppFont}"
                                                Command="{Binding DataContext.RemoveFromCartCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.IsNormalized,
                                                    RelativeSource={RelativeSource AncestorType=UserControl},
                                                    Converter={StaticResource InverseBoolConverter}}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- PANNEAU REMISE -->
            <Border Background="White" CornerRadius="16"
                    Visibility="{Binding ShowDiscountPanel, Converter={StaticResource BoolToVisibilityConverter}}"
                    Margin="0,60,0,0" VerticalAlignment="Top" MaxHeight="420">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.15" ShadowDepth="5"/>
                </Border.Effect>
                <StackPanel Margin="20">
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="% " FontSize="16" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="Remise" FontFamily="{StaticResource AppFont}"
                                       FontSize="15" FontWeight="Bold"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Content="✕" FontSize="14"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Command="{Binding ToggleDiscountPanelCommand}"/>
                    </Grid>

                    <Border Background="#F3F4F6" CornerRadius="8" Padding="10,8" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedCartItem.Name}"
                                       FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="Medium"/>
                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="{Binding SelectedCartItem.QuantityDisplay, Mode=OneWay}"/>
                                <Run Text=" → "/>
                                <Run Text="{Binding SelectedCartItem.AmountTTC, StringFormat=N0, Mode=OneWay}"/>
                                <Run Text=" CDF"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="REMISE RAPIDE" FontFamily="{StaticResource AppFont}"
                               FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6"/>
                    <WrapPanel Margin="0,0,0,14">
                        <Button Content="5 %" Padding="14,8" Margin="0,0,6,6"
                                FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"
                                Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Cursor="Hand"
                                Command="{Binding ApplyQuickDiscountCommand}" CommandParameter="5"/>
                        <Button Content="10 %" Padding="14,8" Margin="0,0,6,6"
                                FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"
                                Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Cursor="Hand"
                                Command="{Binding ApplyQuickDiscountCommand}" CommandParameter="10"/>
                        <Button Content="15 %" Padding="14,8" Margin="0,0,6,6"
                                FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"
                                Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Cursor="Hand"
                                Command="{Binding ApplyQuickDiscountCommand}" CommandParameter="15"/>
                        <Button Content="20 %" Padding="14,8" Margin="0,0,0,6"
                                FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"
                                Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Cursor="Hand"
                                Command="{Binding ApplyQuickDiscountCommand}" CommandParameter="20"/>
                    </WrapPanel>

                    <TextBlock Text="REMISE PERSONNALISÉE" FontFamily="{StaticResource AppFont}"
                               FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding CustomDiscountValue, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource AppFont}" FontSize="14" Padding="8,6"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                            <RadioButton Content=" %" IsChecked="{Binding IsPercentDiscount}"
                                         FontFamily="{StaticResource AppFont}" FontSize="12"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <RadioButton Content=" CDF"
                                         FontFamily="{StaticResource AppFont}" FontSize="12"
                                         VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding ApplyCustomDiscountCommand}"
                                Padding="12,6" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Opacity" Value="0.9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="Appliquer" FontFamily="{StaticResource AppFont}"
                                       FontSize="12" FontWeight="Bold" Foreground="White"/>
                        </Button>
                    </Grid>

                    <Button Command="{Binding RemoveItemDiscountCommand}"
                            Padding="10,8" BorderThickness="1" BorderBrush="#FCA5A5"
                            Background="#FFF5F5" Cursor="Hand" HorizontalContentAlignment="Center"
                            Visibility="{Binding SelectedCartItem.HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="🗑 Supprimer la remise" FontFamily="{StaticResource AppFont}"
                                   FontSize="12" Foreground="#DC2626"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- PANNEAU HELD -->
            <Border Background="White" CornerRadius="16"
                    Visibility="{Binding ShowHeldPanel, Converter={StaticResource BoolToVisibilityConverter}}"
                    Margin="0,60,0,0" VerticalAlignment="Top" MaxHeight="400">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.15" ShadowDepth="5"/>
                </Border.Effect>
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FEF3C7" Padding="16,12" CornerRadius="16,16,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏸ " FontSize="16"/>
                                <TextBlock Text="Paniers en attente" FontFamily="{StaticResource AppFont}"
                                           FontSize="15" FontWeight="Bold" Foreground="#92400E" VerticalAlignment="Center"/>
                                <Border Background="#92400E" CornerRadius="10" Padding="8,2" Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding HeldCount}" FontFamily="{StaticResource AppFont}"
                                               FontSize="12" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Content="✕" FontSize="14"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Foreground="#92400E" FontWeight="Bold"
                                    Command="{Binding ToggleHeldPanelCommand}"/>
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                        <ItemsControl ItemsSource="{Binding HeldTransactions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="4,4" CornerRadius="12" Padding="14,12"
                                            Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="⏸ " FontSize="12"/>
                                                    <TextBlock Text="{Binding Label}" FontFamily="{StaticResource AppFont}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                                </StackPanel>
                                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="{Binding ItemCount, Mode=OneWay}"/>
                                                    <Run Text=" art. · "/>
                                                    <Run Text="{Binding TotalDisplay, Mode=OneWay}"/>
                                                    <Run Text=" CDF"/>
                                                </TextBlock>
                                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                                           Foreground="#B45309" Margin="0,2,0,0"
                                                           Visibility="{Binding Reason, Converter={StaticResource StringToVisibilityConverter}}">
                                                    <Run Text="💬 "/>
                                                    <Run Text="{Binding Reason, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="🕐 "/>
                                                    <Run Text="{Binding TimeDisplay, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <Button Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center"
                                                    Cursor="Hand" ToolTip="Reprendre ce panier"
                                                    Command="{Binding DataContext.RecallHeldSaleCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                                                            CornerRadius="8" Padding="10,8">
                                                                        <TextBlock Text="▶ Rappeler"
                                                                                   FontFamily="{StaticResource AppFont}"
                                                                                   FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bg" Property="Opacity" Value="0.9"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Grid.Column="2" VerticalAlignment="Center" Cursor="Hand"
                                                    ToolTip="Abandonner ce panier" Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding DataContext.DeleteHeldSaleCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="🗑" FontSize="14" Opacity="0.6"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- HOLD DIALOG -->
            <Grid Visibility="{Binding ShowHoldDialog, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="#80000000" CornerRadius="16"/>
                <Border Background="White" CornerRadius="16" Padding="24"
                        VerticalAlignment="Center" Margin="30">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" Opacity="0.2" ShadowDepth="4"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="⏸ Mettre en attente" FontFamily="{StaticResource AppFont}"
                                   FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Text="Raison (optionnel) :" FontFamily="{StaticResource AppFont}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding HoldReason, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource AppFont}" FontSize="13"
                                 Padding="10,8" Margin="0,0,0,16" MaxLength="100"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Annuler" Margin="0,0,4,0" Padding="10,10"
                                    Background="#F3F4F6" BorderThickness="0" Cursor="Hand"
                                    FontFamily="{StaticResource AppFont}" FontSize="13"
                                    Command="{Binding CancelHoldCommand}"/>
                            <Button Grid.Column="1" Margin="4,0,0,0" Padding="10,10"
                                    BorderThickness="0" Cursor="Hand"
                                    Command="{Binding HoldCurrentSaleCommand}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#F59E0B"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Opacity" Value="0.9"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="⏸ Confirmer" FontFamily="{StaticResource AppFont}"
                                           FontSize="13" FontWeight="Bold" Foreground="White"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>