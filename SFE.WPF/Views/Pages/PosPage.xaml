                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource OverlayHeader}">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TimerSandEmpty" Width="22" Height="22"
                                                         Foreground="{StaticResource WarningBrush}"
