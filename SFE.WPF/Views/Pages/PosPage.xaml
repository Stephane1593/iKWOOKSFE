            <Setter Property="Padding" Value="16,10" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                MinHeight="{TemplateBinding MinHeight}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="10">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg"
                                                 Color="{StaticResource BackgroundColor}" />
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource BorderColor}"
                                                        Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource BackgroundColor}"
                                                        Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ══════════ DISCOUNT CHIP ══════════  -->
        <Style x:Key="PosDiscountChip"
               TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#DC2626" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                MinHeight="{TemplateBinding MinHeight}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="10">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg"
                                                 Color="#FEE2E2" />
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#FECACA"
                                                        Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#FEE2E2"
                                                        Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ══════════ PRODUCT CARD ══════════  -->
        <Style x:Key="ProductCardBorder"
               TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <SolidColorBrush Color="{StaticResource BorderLightColor}" />
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="4"
                                      Opacity="0.04"
                                      ShadowDepth="1"
                                      Color="#0D2B3E" />
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ══════════ POPUP ITEM BUTTON ══════════  -->
        <Style x:Key="PopupItemBtn"
               TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,1">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg"
                                                 Color="#00000000" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource BorderLightColor}" />
                            </Border.BorderBrush>
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Opacity="0.04"
                                                         Color="{StaticResource PrimaryColor}" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ══════════ OVERLAY HEADER ══════════  -->
        <Style x:Key="OverlayHeader"
               TargetType="Border">
            <Setter Property="Padding" Value="28,20,28,16" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <SolidColorBrush Color="{StaticResource BorderLightColor}" />
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"
                              MinWidth="440" />
            <ColumnDefinition Width="460" />
        </Grid.ColumnDefinitions>

        <!--  ══════════════════════════════════════════════════════  -->
        <!--  LEFT: Catalogue  -->
        <!--  ══════════════════════════════════════════════════════  -->
        <DockPanel Grid.Column="0"
                   Margin="20,16,10,16">

            <!--  TOP BAR  -->
            <Border Margin="0,0,0,16"
                    Padding="22,16"
                    DockPanel.Dock="Top"
                    Style="{StaticResource PosCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontFamily="Consolas"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Text="{Binding CurrentTime}" />
                            <TextBlock Margin="0,2,0,0"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="{Binding CurrentDate}" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Margin="16,0,0,0"
                                Padding="12,6"
                                VerticalAlignment="Center"
                                CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Opacity="0.1"
                                                             Color="{StaticResource PrimaryColor}" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHtMode}"
                                                     Value="True">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Opacity="0.12"
                                                                     Color="{StaticResource WarningColor}" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="14"
                                                         Height="14"
                                                         Margin="0,0,5,0"
                                                         VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="TagOutline" />
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHtMode}"
                                                             Value="True">
                                                    <Setter Property="Foreground" Value="#92400E" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Text="{Binding PriceModeDisplay}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHtMode}"
                                                             Value="True">
                                                    <Setter Property="Foreground" Value="#92400E" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                MinHeight="44"
                                Margin="18,0"
                                Padding="14,0"
                                Background="{StaticResource BackgroundBrush}"
                                CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Width="18"
                                                         Height="18"
                                                         Margin="0,0,10,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource TextMutedBrush}"
                                                         Kind="Magnify" />
                                <TextBox x:Name="SearchBox"
                                         Grid.Column="1"
                                         Padding="0,10"
                                         VerticalAlignment="Center"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontFamily="{StaticResource AppFont}"
                                         FontSize="14"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                                <Popup Grid.Column="1"
                                       MinWidth="400"
                                       AllowsTransparency="True"
                                       IsOpen="{Binding ShowSearchResults, Mode=TwoWay}"
                                       Placement="Bottom"
                                       PlacementTarget="{Binding ElementName=SearchBox}"
                                       PopupAnimation="Fade"
                                       StaysOpen="False">
                                    <Border MinWidth="400"
                                            MaxWidth="600"
                                            MaxHeight="360"
                                            Background="White"
                                            BorderThickness="1"
                                            CornerRadius="0,0,12,12"
                                            Effect="{StaticResource PopupShadow}">
                                        <Border.BorderBrush>
                                            <SolidColorBrush Color="{StaticResource BorderLightColor}" />
                                        </Border.BorderBrush>
                                        <ScrollViewer PanningMode="VerticalOnly"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource PopupItemBtn}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                                                               FontSize="13"
                                                                               FontWeight="Medium"
                                                                               Text="{Binding Name}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Margin="0,2,0,0"
                                                                               FontFamily="Consolas"
                                                                               FontSize="11"
                                                                               Foreground="{StaticResource TextMutedBrush}">
                                                                        <Run Text="{Binding Code, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <Border Grid.Column="1"
                                                                        Margin="12,0,0,0"
                                                                        Padding="10,4"
                                                                        VerticalAlignment="Center"
                                                                        CornerRadius="6">
                                                                    <Border.Background>
                                                                        <SolidColorBrush Opacity="0.08"
                                                                                         Color="{StaticResource PrimaryColor}" />
                                                                    </Border.Background>
                                                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                                                               FontSize="13"
                                                                               FontWeight="Bold"
                                                                               Foreground="{StaticResource PrimaryBrush}"
                                                                               Text="{Binding UnitPriceTtcCdf, StringFormat='{}{0:N0} CDF'}" />
                                                                </Border>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="3"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="14"
                                                         Height="14"
                                                         Margin="0,0,6,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource TextMutedBrush}"
                                                         Kind="ChartBarStacked" />
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}">
                                    <Run Text="{Binding TodaySalesCount, Mode=OneWay}" />
                                    <Run Text=" ventes" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Margin="0,2,0,0"
                                       HorizontalAlignment="Right"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}">
                                <Run Text="{Binding TodaySalesTotal, StringFormat=N0, Mode=OneWay}" />
                                <Run Text=" CDF" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,14,0,0"
                            Padding="14,10"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Opacity="0.05"
                                                         Color="{StaticResource PrimaryColor}" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="BorderBrush">
                                    <Setter.Value>
                                        <SolidColorBrush Opacity="0.2"
                                                         Color="{StaticResource PrimaryColor}" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPointOfSale}"
                                                 Value="{x:Null}">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Opacity="0.05"
                                                                 Color="{StaticResource ErrorColor}" />
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="BorderBrush">
                                            <Setter.Value>
                                                <SolidColorBrush Opacity="0.2"
                                                                 Color="{StaticResource ErrorColor}" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="16"
                                                         Height="16"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource PrimaryDarkBrush}"
                                                         Kind="StorefrontOutline" />
                                <Border Margin="0,0,8,0"
                                        Padding="6,2"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource PrimaryLightBrush}"
                                        CornerRadius="4"
                                        Visibility="{Binding SelectedPointOfSale, Converter={StaticResource IsNotNullToVisibilityConverter}}">
                                    <TextBlock FontFamily="Consolas"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryDarkBrush}"
                                               Text="{Binding SelectedPointOfSale.Code}" />
                                </Border>
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="{Binding SelectedPointOfSale.Name}" />
                            </StackPanel>
                            <TextBlock Margin="24,3,0,0"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="{Binding SelectedPosInfo}"
                                       Visibility="{Binding SelectedPointOfSale, Converter={StaticResource IsNotNullToVisibilityConverter}}" />
                            <StackPanel Margin="24,3,0,0"
                                        Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPointOfSale}"
                                                         Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <materialDesign:PackIcon Width="13"
                                                         Height="13"
                                                         Margin="0,0,5,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="#DC2626"
                                                         Kind="AlertOutline" />
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="11"
                                           FontStyle="Italic"
                                           Foreground="#DC2626"
                                           Text="Aucun point de vente configuré" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>


            <!--  CATEGORIES  -->
            <ScrollViewer Margin="0,0,0,16"
                          ClipToBounds="False"
                          DockPanel.Dock="Top"
                          HorizontalScrollBarVisibility="Auto"
                          PanningMode="HorizontalOnly"
                          VerticalScrollBarVisibility="Disabled">
                <!--  ↑ Removed Height="52", added ClipToBounds="False", changed PanningMode to HorizontalOnly (horizontal scroll)  -->
                <StackPanel Margin="0,4,0,8"
                            Orientation="Horizontal">
                    <!--  ↑ top margin 4 gives shadow room above too  -->

                    <Button MinHeight="68"
                            Margin="0,0,10,0"
                            Padding="28,18"
                            BorderThickness="0"
                            Command="{Binding ShowFavoritesCommand}"
                            Cursor="Hand"
                            FontFamily="{StaticResource AppFont}"
                            FontSize="15"
                            FontWeight="SemiBold">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{StaticResource CardBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CatBd"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1.5"
                                                    CornerRadius="10">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="4"
                                                                      Opacity="0.04"
                                                                      ShadowDepth="1"
                                                                      Color="#0D2B3E" />
                                                </Border.Effect>
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CatBd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowFavoritesOnly}"
                                                 Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="15"
                                                     Height="15"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"
                                                     Kind="StarOutline" />
                            <TextBlock Text="Favoris" />
                        </StackPanel>
                    </Button>

                    <Button MinHeight="68"
                            Margin="0,0,10,0"
                            Padding="28,18"
                            Background="{StaticResource CardBrush}"
                            BorderThickness="0"
                            Command="{Binding ShowAllProductsCommand}"
                            Content="Tout"
                            Cursor="Hand"
                            FontFamily="{StaticResource AppFont}"
                            FontSize="15"
                            Foreground="{StaticResource TextPrimaryBrush}" />

                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button MinHeight="68"
                                        Margin="0,0,10,0"
                                        Padding="28,18"
                                        Background="{StaticResource CardBrush}"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand"
                                        FontFamily="{StaticResource AppFont}"
                                        FontSize="15"
                                        Foreground="{StaticResource TextPrimaryBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,6,0"
                                                   Text="{Binding Icon}" />
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!--  PRODUCT GRID  -->
            <ScrollViewer PanningMode="VerticalOnly"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DisplayProducts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="160"
                                    Height="118"
                                    Margin="0,0,12,12"
                                    BorderThickness="0"
                                    Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CardBorder"
                                                Style="{StaticResource ProductCardBorder}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock MaxHeight="34"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="12"
                                                           FontWeight="Medium"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Row="1"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Consolas"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}">
                                                    <Run Text="{Binding Code, Mode=OneWay}" />
                                                </TextBlock>
                                                <Grid Grid.Row="2">
                                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                                               FontSize="15"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource PrimaryBrush}">
                                                        <Run Text="{Binding UnitPriceTtcCdf, StringFormat=N0, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock HorizontalAlignment="Right"
                                                               VerticalAlignment="Bottom"
                                                               FontFamily="{StaticResource AppFont}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextMutedBrush}">
                                                        <Run Text="{Binding TaxGroup, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                <Setter TargetName="CardBorder" Property="Background">
                                                    <Setter.Value>
                                                        <SolidColorBrush Opacity="0.06"
                                                                         Color="{StaticResource PrimaryColor}" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <EventTrigger RoutedEvent="Button.Click">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="CardBorder"
                                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                        To="#37B1E4"
                                                                        Duration="0:0:0.08"
                                                                        AutoReverse="True"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!--  ══════════════════════════════════════════════════════  -->
        <!--  RIGHT: Cart (460px wide)  -->
        <!--  ══════════════════════════════════════════════════════  -->
        <Grid Grid.Column="1"
              Margin="8,16,20,16">

            <Border CornerRadius="16"
                    Style="{StaticResource PosCard}">
                <!--  ★★★ FIX: Replaced DockPanel with Grid + RowDefinitions ★★★  -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!--  Row 0: Cart Header  -->
                        <RowDefinition Height="*" />
                        <!--  Row 1: Cart Items (scrollable)  -->
                        <RowDefinition Height="1.8*" />
                        <!--  Row 2: Cart Footer / Totals / Payment  -->
                    </Grid.RowDefinitions>

                    <!--  ────── ROW 0: CART HEADER ──────  -->
                    <Border Grid.Row="0"
                            Padding="28,20,28,16"
                            BorderThickness="0,0,0,1">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{StaticResource BorderLightColor}" />
                        </Border.BorderBrush>
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <StackPanel VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                        <Grid>
                                            <materialDesign:PackIcon x:Name="CartIcon"
                                                                     Width="22"
                                                                     Height="22"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="{StaticResource PrimaryBrush}"
                                                                     Kind="CartOutline" />

                                            <!--  Badge  -->
                                            <Border x:Name="CartBadge"
                                                    Height="18"
                                                    MinWidth="18"
                                                    Margin="0,-6,-8,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Background="#EF4444"
                                                    CornerRadius="10"
                                                    RenderTransformOrigin="0.5,0.5"
                                                    Visibility="{Binding CartItemCount, Converter={StaticResource IntToVisibilityConverter}}">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="BadgeScale" ScaleX="1" ScaleY="1" />
                                                </Border.RenderTransform>

                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           Text="{Binding CartItemCount}" />
                                            </Border>
                                        </Grid>

                                        <TextBlock Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Text="Panier" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                    <Button Command="{Binding ToggleClientPanelCommand}"
                                            Style="{StaticResource PosIconBtn}"
                                            ToolTip="Client">
                                        <materialDesign:PackIcon Width="19"
                                                                 Height="19"
                                                                 Foreground="{StaticResource TextSecondaryBrush}"
                                                                 Kind="AccountOutline" />
                                    </Button>
                                    <Button Command="{Binding ToggleCommentPanelCommand}"
                                            Style="{StaticResource PosIconBtn}"
                                            ToolTip="Commentaires">
                                        <materialDesign:PackIcon Width="18"
                                                                 Height="18"
                                                                 Foreground="{StaticResource TextSecondaryBrush}"
                                                                 Kind="CommentTextOutline" />
                                    </Button>
                                    <Button Command="{Binding ToggleDiscountPanelCommand}"
                                            Style="{StaticResource PosIconBtn}"
                                            ToolTip="Remise"
                                            Visibility="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}">
                                        <materialDesign:PackIcon Width="18"
                                                                 Height="18"
                                                                 Foreground="{StaticResource AccentBrush}"
                                                                 Kind="PercentOutline" />
                                    </Button>
                                    <Button Command="{Binding ToggleHeldPanelCommand}"
                                            Style="{StaticResource PosIconBtn}"
                                            ToolTip="En attente">
                                        <Grid>
                                            <materialDesign:PackIcon Width="18"
                                                                     Height="18"
                                                                     Foreground="{StaticResource TextSecondaryBrush}"
                                                                     Kind="PauseCircleOutline" />
                                            <Border Height="16"
                                                    MinWidth="16"
                                                    Margin="0,-4,-6,0"
                                                    Padding="4,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Background="#EF4444"
                                                    CornerRadius="8"
                                                    Visibility="{Binding HeldCount, Converter={StaticResource IntToVisibilityConverter}}">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           Text="{Binding HeldCount}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Button Command="{Binding TogglePendingPanelCommand}"
                                            Style="{StaticResource PosIconBtn}"
                                            ToolTip="Factures en attente">
                                        <materialDesign:PackIcon Width="18"
                                                                 Height="18"
                                                                 Foreground="{StaticResource TextSecondaryBrush}"
                                                                 Kind="TimerSandEmpty" />
                                    </Button>
                                    <Button Command="{Binding ClearCartCommand}"
                                            Style="{StaticResource PosIconBtn}"
                                            Visibility="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}">
                                        <materialDesign:PackIcon Width="18"
                                                                 Height="18"
                                                                 Foreground="{StaticResource TextMutedBrush}"
                                                                 Kind="TrashCanOutline" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}">
                                    <Run Text="{Binding CartItemCount, Mode=OneWay}" />
                                    <Run Text=" ligne(s) ·" />
                                    <Run Text="{Binding TotalArticles, Mode=OneWay}" />
                                    <Run Text=" art." />
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="{Binding InvoiceNumber}" />
                            </Grid>

                            <!--  Client badge  -->
                            <Border MinHeight="42"
                                    Margin="0,12,0,0"
                                    Padding="14,10"
                                    CornerRadius="10"
                                    Visibility="{Binding HasClientSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border.Background>
                                    <SolidColorBrush Opacity="0.06"
                                                     Color="{StaticResource PrimaryColor}" />
                                </Border.Background>
                                <Grid>
                                    <StackPanel VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="15"
                                                                 Height="15"
                                                                 Margin="0,0,8,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{StaticResource PrimaryBrush}"
                                                                 Kind="AccountCheckOutline" />
                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   Text="{Binding ClientName}" />
                                        <TextBlock Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="{Binding ClientTypeMention}" />
                                    </StackPanel>
                                    <Button Width="36"
                                            Height="36"
                                            HorizontalAlignment="Right"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding ClearClientCommand}"
                                            Cursor="Hand">
                                        <materialDesign:PackIcon Width="14"
                                                                 Height="14"
                                                                 Foreground="#DC2626"
                                                                 Kind="Close" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!--  Credit note / Advance badges  -->
                            <StackPanel Margin="0,8,0,0"
                                        Orientation="Horizontal">
                                <Border MinHeight="36"
                                        Margin="0,0,8,0"
                                        Padding="12,7"
                                        CornerRadius="8"
                                        Visibility="{Binding IsCreditNote, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border.Background>
                                        <SolidColorBrush Opacity="0.08"
                                                         Color="{StaticResource ErrorColor}" />
                                    </Border.Background>
                                    <Button Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding ToggleCreditNotePanelCommand}"
                                            Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="14"
                                                                     Height="14"
                                                                     Margin="0,0,6,0"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="#DC2626"
                                                                     Kind="FileUndoOutline" />
                                            <TextBlock FontFamily="{StaticResource AppFont}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#DC2626"
                                                       Text="Avoir" />
                                        </StackPanel>
                                    </Button>
                                </Border>
                                <Border MinHeight="36"
                                        Padding="12,7"
                                        CornerRadius="8"
                                        Visibility="{Binding IsAdvanceInvoice, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border.Background>
                                        <SolidColorBrush Opacity="0.08"
                                                         Color="#7C3AED" />
                                    </Border.Background>
                                    <Button Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding ToggleAdvancePanelCommand}"
                                            Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="14"
                                                                     Height="14"
                                                                     Margin="0,0,6,0"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="#7C3AED"
                                                                     Kind="CashClock" />
                                            <TextBlock FontFamily="{StaticResource AppFont}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#7C3AED"
                                                       Text="Acompte" />
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--  ────── ROW 1: CART ITEMS LIST ──────  -->
                    <ListBox Grid.Row="1"
                             Margin="0"
                             Padding="0"
                             HorizontalContentAlignment="Stretch"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding CartItems}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectedItem="{Binding SelectedCartItem}">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <Border Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer Focusable="False"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  PanningMode="VerticalOnly"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </ScrollViewer>
                                </Border>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="20,3" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="MinHeight" Value="64" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Padding="18,14"
                                                    Background="{StaticResource BackgroundBrush}"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1.5"
                                                    CornerRadius="12">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                    <Setter TargetName="Bd" Property="Background">
                                                        <Setter.Value>
                                                            <SolidColorBrush Opacity="0.06"
                                                                             Color="{StaticResource PrimaryColor}" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush">
                                                        <Setter.Value>
                                                            <SolidColorBrush Color="{StaticResource BorderColor}" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}">
                                            <Run Text="{Binding QuantityDisplay, Mode=OneWay}" />
                                            <Run Text=" · Grp " />
                                            <Run Text="{Binding TaxGroupLabel, Mode=OneWay}" />
                                        </TextBlock>
                                        <Border Margin="0,3,0,0"
                                                Padding="6,2"
                                                HorizontalAlignment="Left"
                                                CornerRadius="4"
                                                Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border.Background>
                                                <SolidColorBrush Opacity="0.08"
                                                                 Color="{StaticResource ErrorColor}" />
                                            </Border.Background>
                                            <TextBlock FontFamily="{StaticResource AppFont}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="#DC2626"
                                                       Text="{Binding DiscountDisplay, Mode=OneWay}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Margin="10,0"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                        <Button Width="42"
                                                Height="42"
                                                Padding="0"
                                                Background="{StaticResource BackgroundBrush}"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.DecrementQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Text="−" />
                                        </Button>
                                        <TextBlock MinWidth="28"
                                                   Margin="8,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Text="{Binding Quantity, StringFormat=G}"
                                                   TextAlignment="Center" />
                                        <Button Width="42"
                                                Height="42"
                                                Padding="0"
                                                Background="{StaticResource BackgroundBrush}"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.IncrementQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Text="＋" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                MinWidth="78"
                                                VerticalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Right"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   Text="{Binding AmountTTC, StringFormat='{}{0:N0}'}" />
                                        <Button MinHeight="26"
                                                Padding="0"
                                                HorizontalAlignment="Right"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Visibility="{Binding DataContext.IsNormalized, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Width="10"
                                                                         Height="10"
                                                                         Margin="0,0,3,0"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="#EF4444"
                                                                         Kind="Close" />
                                                <TextBlock FontFamily="{StaticResource AppFont}"
                                                           FontSize="9"
                                                           Foreground="#EF4444"
                                                           Text="retirer" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!--  ────── ROW 2: CART FOOTER ──────  -->
                    <DockPanel Grid.Row="2">

                        <!--  Status messages  -->
                        <Border Margin="28,0,28,12"
                                Padding="14,10"
                                CornerRadius="8"
                                DockPanel.Dock="Bottom"
                                Visibility="{Binding ShowSuccess, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Background>
                                <SolidColorBrush Opacity="0.06"
                                                 Color="{StaticResource SuccessColor}" />
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="14"
                                                         Height="14"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource SuccessBrush}"
                                                         Kind="CheckCircleOutline" />
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource SuccessBrush}"
                                           Text="{Binding StatusMessage}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Margin="28,0,28,6"
                                Padding="14,10"
                                CornerRadius="8"
                                DockPanel.Dock="Bottom"
                                Visibility="{Binding ShowError, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Background>
                                <SolidColorBrush Opacity="0.06"
                                                 Color="{StaticResource ErrorColor}" />
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="14"
                                                         Height="14"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource ErrorBrush}"
                                                         Kind="AlertCircleOutline" />
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource ErrorBrush}"
                                           Text="{Binding StatusMessage}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!--  ── Scrollable totals + payment area ──  -->
                        <ScrollViewer PanningMode="VerticalOnly"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="28,12,28,24">

                                <Separator Margin="0,0,0,14"
                                           Background="{StaticResource BorderLightBrush}" />

                                <!--  Discount sub-total  -->
                                <Grid MinHeight="28"
                                      Margin="0,0,0,8"
                                      Visibility="{Binding HasAnyDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="Sous-total avant remise" />
                                    <TextBlock HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="{Binding TotalHTBeforeDiscount, StringFormat='{}{0:N0}'}"
                                               TextDecorations="Strikethrough" />
                                </Grid>
                                <Grid MinHeight="28"
                                      Margin="0,0,0,8"
                                      Visibility="{Binding HasAnyDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="12"
                                                                 Height="12"
                                                                 Margin="0,0,5,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="#DC2626"
                                                                 Kind="PercentOutline" />
                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                   FontSize="11"
                                                   Foreground="#DC2626"
                                                   Text="Remise" />
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#DC2626"
                                               Text="{Binding TotalDiscount, StringFormat='-{0:N0}'}" />
                                </Grid>

                                <!--  HT  -->
                                <Grid MinHeight="30"
                                      Margin="0,0,0,8">
                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="HT" />
                                    <TextBlock HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="{Binding TotalHT, StringFormat='{}{0:N0}'}" />
                                </Grid>

                                <!--  TVA  -->
                                <Grid MinHeight="30"
                                      Margin="0,0,0,8">
                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="12"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Text="TVA" />
                                    <TextBlock HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="12"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Text="{Binding TotalTVA, StringFormat='{}{0:N0}'}" />
                                </Grid>

                                <!--  Specific tax  -->
                                <Grid MinHeight="30"
                                      Margin="0,0,0,8"
                                      Visibility="{Binding HasAnySpecificTax, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="13"
                                                                 Height="13"
                                                                 Margin="0,0,5,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="#92400E"
                                                                 Kind="FlashOutline" />
                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                   FontSize="12"
                                                   Foreground="#92400E"
                                                   Text="Taxe spécifique" />
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="12"
                                               Foreground="#92400E"
                                               Text="{Binding TotalSpecificTax, StringFormat='{}{0:N0}'}" />
                                </Grid>

                                <!--  ── Grand Total ──  -->
                                <Border Margin="0,10,0,10"
                                        Padding="22,18"
                                        CornerRadius="14"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="TotalScale" ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Opacity="0.08"
                                                                     Color="{StaticResource PrimaryColor}" />
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHtMode}"
                                                             Value="True">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <SolidColorBrush Opacity="0.08"
                                                                             Color="{StaticResource WarningColor}" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Text="{Binding GrandTotalLabel}" />
                                        <TextBlock HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}">
                                            <Run Text="{Binding GrandTotal, StringFormat=N0, Mode=OneWay}" />
                                            <Run FontSize="14"
                                                 Text=" CDF" />
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!--  ── Alternate currency ──  -->
                                <Border MinHeight="44"
                                        Margin="0,0,0,12"
                                        Padding="18,12"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Border.Background>
                                        <SolidColorBrush Color="{StaticResource BackgroundColor}" />
                                    </Border.Background>
                                    <Border.BorderBrush>
                                        <SolidColorBrush Color="{StaticResource BorderLightColor}" />
                                    </Border.BorderBrush>
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="15"
                                                                     Height="15"
                                                                     Margin="0,0,8,0"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="{StaticResource TextMutedBrush}"
                                                                     Kind="SwapHorizontal" />
                                            <TextBlock FontFamily="{StaticResource AppFont}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}">
                                                <Run Text="{Binding AlternateCurrencyLabel, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="14"
                                                   FontWeight="Bold">
                                            <Run Text="{Binding TotalInAlternateCurrency, StringFormat=N2, Mode=OneWay}" />
                                            <Run FontSize="9"
                                                 Text=" " />
                                            <Run FontSize="9"
                                                 Text="{Binding AlternateCurrencyLabel, Mode=OneWay}" />
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!--  ── À payer TTC (HT mode) ──  -->
                                <Border Margin="0,0,0,12"
                                        Padding="20,14"
                                        CornerRadius="12"
                                        Visibility="{Binding IsHtMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border.Background>
                                        <SolidColorBrush Opacity="0.06"
                                                         Color="{StaticResource SuccessColor}" />
                                    </Border.Background>
                                    <Grid MinHeight="38">
                                        <StackPanel VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="16"
                                                                     Height="16"
                                                                     Margin="0,0,8,0"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="#065F46"
                                                                     Kind="CashMultiple" />
                                            <TextBlock FontFamily="{StaticResource AppFont}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#065F46"
                                                       Text="À encaisser (TTC)" />
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   Foreground="#065F46">
                                            <Run Text="{Binding TotalTTC, StringFormat=N0, Mode=OneWay}" />
                                            <Run FontSize="11"
                                                 Text=" CDF" />
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!--  ═══════ BEFORE NORMALIZATION ═══════  -->
                                <StackPanel Visibility="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}">

                                    <!--  Payment type + Invoice type  -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding PaymentTypes}"
                                                  SelectedItem="{Binding SelectedPaymentType}"
                                                  Style="{StaticResource PosComboBox}" />
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding InvoiceTypes}"
                                                  SelectedItem="{Binding InvoiceType}"
                                                  Style="{StaticResource PosComboBox}" />
                                    </Grid>

                                    <!--  Split payment toggle  -->
                                    <Button Margin="0,0,0,14"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding ToggleSplitPaymentCommand}"
                                            Style="{StaticResource PosGhostBtn}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="14"
                                                                     Height="14"
                                                                     Margin="0,0,8,0"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="{StaticResource TextSecondaryBrush}">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="CreditCardOutline" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowSplitPayment}"
                                                                         Value="True">
                                                                <Setter Property="Kind" Value="Close" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <TextBlock FontFamily="{StaticResource AppFont}"
                                                       FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Paiement fractionné" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowSplitPayment}"
                                                                         Value="True">
                                                                <Setter Property="Text" Value="Fermer paiement fractionné" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>

                                    <!--  ── Split payment section ──  -->
                                    <StackPanel Visibility="{Binding ShowSplitPayment, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl ItemsSource="{Binding PaymentItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid MinHeight="40"
                                                          Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock VerticalAlignment="Center"
                                                                   FontFamily="{StaticResource AppFont}"
                                                                   FontSize="12"
                                                                   Text="{Binding Label}" />
                                                        <TextBlock Grid.Column="1"
                                                                   Margin="0,0,10,0"
                                                                   VerticalAlignment="Center"
                                                                   FontFamily="{StaticResource AppFont}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding Amount, StringFormat=N0}" />
                                                        <Button Grid.Column="2"
                                                                Width="36"
                                                                Height="36"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Command="{Binding DataContext.RemovePaymentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Cursor="Hand">
                                                            <materialDesign:PackIcon Width="14"
                                                                                     Height="14"
                                                                                     Foreground="#EF4444"
                                                                                     Kind="Close" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid Margin="0,10,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource PosTextBox}"
                                                     Text="{Binding PaymentAmount}"
                                                     ToolTip="Vide = reste à payer" />
                                            <Button Grid.Column="1"
                                                    Margin="12,0,0,0"
                                                    Command="{Binding AddPaymentCommand}"
                                                    Style="{StaticResource PosMiniBtn}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Width="14"
                                                                             Height="14"
                                                                             Margin="0,0,5,0"
                                                                             VerticalAlignment="Center"
                                                                             Foreground="White"
                                                                             Kind="Plus" />
                                                    <TextBlock FontSize="12"
                                                               Foreground="White"
                                                               Text="Ajouter" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <Grid MinHeight="38"
                                              Margin="0,0,0,12">
                                            <TextBlock VerticalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Text="Reste à payer" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="14"
                                                       FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Remaining}"
                                                                         Value="0">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="{Binding Remaining, StringFormat=N0, Mode=OneWay}" />
                                                <Run Text=" CDF" />
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>

                                    <!--  ── Simple payment section ──  -->
                                    <StackPanel Visibility="{Binding ShowSplitPayment, Converter={StaticResource InverseBoolConverter}}">
                                        <TextBlock Margin="2,0,0,8"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="Montant reçu" />
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox MinHeight="54"
                                                     Padding="16,14"
                                                     VerticalContentAlignment="Center"
                                                     Background="White"
                                                     FontFamily="{StaticResource AppFont}"
                                                     FontSize="20"
                                                     FontWeight="SemiBold"
                                                     Text="{Binding ReceivedAmount, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.Template>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <Border x:Name="Bd"
                                                                MinHeight="{TemplateBinding MinHeight}"
                                                                Padding="{TemplateBinding Padding}"
                                                                Background="{TemplateBinding Background}"
                                                                BorderThickness="1.5"
                                                                CornerRadius="10"
                                                                SnapsToDevicePixels="True">
                                                            <Border.BorderBrush>
                                                                <SolidColorBrush Color="{StaticResource BorderLightColor}" />
                                                            </Border.BorderBrush>
                                                            <ScrollViewer x:Name="PART_ContentHost"
                                                                          VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsFocused" Value="True">
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </TextBox.Template>
                                            </TextBox>
                                            <Button Grid.Column="1"
                                                    Margin="12,0,0,0"
                                                    Command="{Binding SetExactAmountCommand}"
                                                    Style="{StaticResource PosGhostBtn}">
                                                <TextBlock FontFamily="{StaticResource AppFont}"
                                                           FontSize="12"
                                                           Text="= Exact" />
                                            </Button>
                                        </Grid>

                                        <!--  Quick amount chips  -->
                                        <WrapPanel Margin="0,0,0,12">
                                            <Button Margin="0,0,8,8"
                                                    Command="{Binding SetRoundedAmountCommand}"
                                                    CommandParameter="1000"
                                                    Content="1 000"
                                                    Style="{StaticResource PosChipBtn}" />
                                            <Button Margin="0,0,8,8"
                                                    Command="{Binding SetRoundedAmountCommand}"
                                                    CommandParameter="5000"
                                                    Content="5 000"
                                                    Style="{StaticResource PosChipBtn}" />
                                            <Button Margin="0,0,8,8"
                                                    Command="{Binding SetRoundedAmountCommand}"
                                                    CommandParameter="10000"
                                                    Content="10 000"
                                                    Style="{StaticResource PosChipBtn}" />
                                            <Button Margin="0,0,8,8"
                                                    Command="{Binding SetRoundedAmountCommand}"
                                                    CommandParameter="20000"
                                                    Content="20 000"
                                                    Style="{StaticResource PosChipBtn}" />
                                            <Button Margin="0,0,0,8"
                                                    Command="{Binding SetRoundedAmountCommand}"
                                                    CommandParameter="50000"
                                                    Content="50 000"
                                                    Style="{StaticResource PosChipBtn}" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <!--  Change  -->
                                    <Border Margin="0,0,0,14"
                                            Padding="20,14"
                                            CornerRadius="12"
                                            Visibility="{Binding ShowChange, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Border.Background>
                                            <SolidColorBrush Opacity="0.08"
                                                             Color="{StaticResource WarningColor}" />
                                        </Border.Background>
                                        <Grid MinHeight="38">
                                            <StackPanel VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                <materialDesign:PackIcon Width="16"
                                                                         Height="16"
                                                                         Margin="0,0,8,0"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="#92400E"
                                                                         Kind="CashRefund" />
                                                <TextBlock FontFamily="{StaticResource AppFont}"
                                                           FontSize="13"
                                                           FontWeight="Medium"
                                                           Foreground="#92400E"
                                                           Text="Monnaie" />
                                            </StackPanel>
                                            <TextBlock HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="17"
                                                       FontWeight="Bold"
                                                       Foreground="#92400E">
                                                <Run Text="{Binding ChangeAmount, StringFormat=N0, Mode=OneWay}" />
                                                <Run Text=" CDF" />
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <!--  Hold + Process buttons  -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Margin="0,0,12,0"
                                                Command="{Binding RequestHoldCommand}"
                                                Style="{StaticResource PosHoldBtn}">
                                            <materialDesign:PackIcon Width="22"
                                                                     Height="22"
                                                                     Foreground="White"
                                                                     Kind="PauseCircleOutline" />
                                        </Button>
                                        <Button Grid.Column="1"
                                                HorizontalContentAlignment="Center"
                                                Command="{Binding ProcessSaleCommand}"
                                                Style="{StaticResource PosProcessBtn}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Width="20"
                                                                         Height="20"
                                                                         Margin="0,0,10,0"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="White"
                                                                         Kind="ShieldLockOutline" />
                                                <TextBlock FontFamily="{StaticResource AppFont}"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           Text="ENCAISSER" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <!--  ═══════ AFTER NORMALIZATION ═══════  -->
                                <StackPanel Visibility="{Binding IsNormalized, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border Margin="0,0,0,14"
                                            Padding="20,16"
                                            CornerRadius="12">
                                        <Border.Background>
                                            <SolidColorBrush Opacity="0.05"
                                                             Color="{StaticResource SuccessColor}" />
                                        </Border.Background>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Text="CODE DEF/DGI" />
                                            <TextBlock Margin="0,6,0,0"
                                                       HorizontalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       Text="{Binding CodeDEFDGI}" />
                                        </StackPanel>
                                    </Border>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition MinHeight="28" />
                                            <RowDefinition MinHeight="28" />
                                            <RowDefinition MinHeight="28" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Margin="0,0,12,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="NIM:" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Text="{Binding Nim}" />
                                        <TextBlock Grid.Row="1"
                                                   Margin="0,0,12,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="Compteurs:" />
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Text="{Binding Counters}" />
                                        <TextBlock Grid.Row="2"
                                                   Margin="0,0,12,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="Date DEF:" />
                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Text="{Binding DeviceDateTime}" />
                                    </Grid>
                                    <Button HorizontalContentAlignment="Center"
                                            Command="{Binding NewSaleCommand}"
                                            Style="{StaticResource PosPrimaryBtn}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="18"
                                                                     Height="18"
                                                                     Margin="0,0,10,0"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="White"
                                                                     Kind="FilePlusOutline" />
                                            <TextBlock FontFamily="{StaticResource AppFont}"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="White"
                                                       Text="NOUVELLE VENTE" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!--  Reprint  -->
                                <Button Margin="0,14,0,0"
                                        Padding="18,12"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding ReprintReceiptCommand}"
                                        Style="{StaticResource PosGhostBtn}"
                                        Visibility="{Binding HasThermalPrinter, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="15"
                                                                 Height="15"
                                                                 Margin="0,0,8,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{StaticResource TextSecondaryBrush}"
                                                                 Kind="PrinterOutline" />
                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Text="Réimprimer (Duplicata)" />
                                    </StackPanel>
                                </Button>

                                <!--  Printer indicator  -->
                                <Border Margin="0,12,0,0"
                                        Padding="10,6"
                                        HorizontalAlignment="Center"
                                        CornerRadius="8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Opacity="0.06"
                                                                     Color="{StaticResource SuccessColor}" />
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasThermalPrinter}"
                                                             Value="False">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <SolidColorBrush Opacity="0.06"
                                                                             Color="{StaticResource ErrorColor}" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#10B981" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasThermalPrinter}"
                                                                     Value="False">
                                                            <Setter Property="Fill" Value="#EF4444" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                   FontSize="9"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="{Binding ThermalPrinterName}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>

                </Grid>
                <!--  ★★★ END FIX ★★★  -->
            </Border>

            <!--  ══════════════════════════════════════════════════════  -->
            <!--  OVERLAY PANELS  -->
            <!--  ══════════════════════════════════════════════════════  -->

            <!--  CLIENT PANEL ★  -->
            <Border Margin="0"
                    VerticalAlignment="Stretch"
                    Style="{StaticResource PosOverlayCard}"
                    Visibility="{Binding ShowClientPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Header  -->
                    <Border Style="{StaticResource OverlayHeader}">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="22"
                                                         Height="22"
                                                         Margin="0,0,10,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource PrimaryBrush}"
                                                         Kind="AccountOutline" />
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Text="Client" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    Command="{Binding ToggleClientPanelCommand}"
                                    Style="{StaticResource PosCloseBtn}" />
                        </Grid>
                    </Border>

                    <!--  Scrollable form  -->
                    <ScrollViewer Grid.Row="1"
                                  PanningMode="VerticalOnly"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,20,28,20">
                            <!--  Search  -->
                            <TextBlock Style="{StaticResource PosFieldLabel}"
                                       Text="Rechercher" />
                            <Grid Margin="0,0,0,18">
                                <TextBox x:Name="PosClientSearch"
                                         Style="{StaticResource PosTextBox}"
                                         Text="{Binding ClientSearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                                <Popup Width="{Binding ActualWidth, ElementName=PosClientSearch}"
                                       AllowsTransparency="True"
                                       IsOpen="{Binding IsClientSearchOpen, Mode=TwoWay}"
                                       Placement="Bottom"
                                       PlacementTarget="{Binding ElementName=PosClientSearch}"
                                       PopupAnimation="Fade"
                                       StaysOpen="False">
                                    <Border MaxHeight="260"
                                            Background="White"
                                            BorderThickness="1"
                                            CornerRadius="0,0,12,12"
                                            Effect="{StaticResource PopupShadow}">
                                        <Border.BorderBrush>
                                            <SolidColorBrush Color="{StaticResource BorderLightColor}" />
                                        </Border.BorderBrush>
                                        <ScrollViewer PanningMode="VerticalOnly"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding ClientSearchResults}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.SelectClientCommand, RelativeSource={RelativeSource AncestorType=Popup}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource PopupItemBtn}">
                                                            <StackPanel>
                                                                <TextBlock FontFamily="{StaticResource AppFont}"
                                                                           FontSize="14"
                                                                           FontWeight="Medium"
                                                                           Text="{Binding Name}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Margin="0,2,0,0"
                                                                           FontFamily="Consolas"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource TextMutedBrush}">
                                                                    <Run Text="{Binding Type}" />
                                                                    <Run Text=" · NIF: " />
                                                                    <Run Text="{Binding NIF, TargetNullValue='-'}" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>

                            <!--  Type  -->
                            <TextBlock Style="{StaticResource PosFieldLabel}"
                                       Text="Type client" />
                            <ComboBox Margin="0,0,0,18"
                                      ItemsSource="{Binding ClientTypes}"
                                      SelectedItem="{Binding SelectedClientType}"
                                      Style="{StaticResource PosComboBox}" />

                            <!--  NIF  -->
                            <TextBlock Style="{StaticResource PosFieldLabel}"
                                       Text="NIF" />
                            <TextBox Margin="0,0,0,18"
                                     Style="{StaticResource PosTextBox}"
                                     Text="{Binding ClientNIF}" />

                            <!--  Name  -->
                            <TextBlock Style="{StaticResource PosFieldLabel}"
                                       Text="Nom / Dénomination" />
                            <TextBox Margin="0,0,0,18"
                                     Style="{StaticResource PosTextBox}"
                                     Text="{Binding ClientName}" />

                            <!--  Phone  -->
                            <TextBlock Style="{StaticResource PosFieldLabel}"
                                       Text="Téléphone" />
                            <TextBox Margin="0,0,0,18"
                                     Style="{StaticResource PosTextBox}"
                                     Text="{Binding ClientPhone}" />

                            <!--  Address  -->
                            <TextBlock Style="{StaticResource PosFieldLabel}"
                                       Text="Adresse" />
                            <TextBox Style="{StaticResource PosTextBox}"
                                     Text="{Binding ClientAddress}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!--  Footer buttons  -->
                    <Border Grid.Row="2"
                            Padding="28,16,28,22"
                            BorderThickness="0,1,0,0">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{StaticResource BorderLightColor}" />
                        </Border.BorderBrush>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding SaveClientInlineCommand}"
                                    Style="{StaticResource PosSuccessBtn}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="15"
                                                             Height="15"
                                                             Margin="0,0,8,0"
                                                             VerticalAlignment="Center"
                                                             Foreground="#065F46"
                                                             Kind="ContentSave" />
                                    <TextBlock FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#065F46"
                                               Text="Enregistrer" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2"
                                    Command="{Binding ClearClientCommand}"
                                    Style="{StaticResource PosDangerBtn}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="14"
                                                             Height="14"
                                                             Margin="0,0,6,0"
                                                             VerticalAlignment="Center"
                                                             Foreground="#DC2626"
                                                             Kind="Close" />
                                    <TextBlock FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#DC2626"
                                               Text="Vider" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!--  CREDIT NOTE PANEL  -->
            <Border Margin="0"
                    VerticalAlignment="Stretch"
                    Style="{StaticResource PosOverlayCard}"
                    Visibility="{Binding ShowCreditNotePanel, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource OverlayHeader}">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="22"
                                                         Height="22"
                                                         Margin="0,0,10,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource AccentBrush}"
                                                         Kind="FileUndoOutline" />
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           Text="Avoir" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    Command="{Binding ToggleCreditNotePanelCommand}"
                                    Style="{StaticResource PosCloseBtn}" />
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1"
                                  PanningMode="VerticalOnly"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,20,28,24">
                            <TextBlock Style="{StaticResource PosFieldLabel}"
                                       Text="Nature" />
                            <ComboBox Margin="0,0,0,18"
                                      ItemsSource="{Binding CreditNoteNatures}"
                                      SelectedItem="{Binding SelectedCreditNoteNature}"
                                      Style="{StaticResource PosComboBox}" />

                            <TextBlock Style="{StaticResource PosFieldLabel}"
                                       Text="Code DEF/DGI original" />
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox FontFamily="Consolas"
                                         IsEnabled="{Binding IsRRR, Converter={StaticResource InverseBoolConverter}}"
                                         Style="{StaticResource PosTextBox}"
                                         Text="{Binding OriginalReference, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1"
                                        Margin="10,0,0,0"
                                        Command="{Binding LookupOriginalInvoiceCommand}"
                                        Style="{StaticResource PosMiniBtn}"
                                        Visibility="{Binding RequiresOriginalLookup, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="14"
                                                                 Height="14"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="White"
                                                                 Kind="Magnify" />
                                        <TextBlock FontSize="12"
                                                   Foreground="White"
                                                   Text="Charger" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Margin="0,0,0,18"
                                    Padding="16,14"
                                    CornerRadius="12"
                                    Visibility="{Binding IsOriginalLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border.Background>
                                    <SolidColorBrush Opacity="0.06"
                                                     Color="{StaticResource SuccessColor}" />
                                </Border.Background>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="15"
                                                                 Height="15"
                                                                 Margin="0,0,8,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="#065F46"
                                                                 Kind="CheckCircleOutline" />
                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="#065F46"
                                                   Text="Facture chargée" />
                                    </StackPanel>
                                    <TextBlock Margin="23,4,0,0"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="{Binding OriginalInvoiceSummary}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding CreditNoteSelections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border MinHeight="56"
                                                Padding="8,12"
                                                BorderThickness="0,0,0,1">
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="{StaticResource BorderLightColor}" />
                                            </Border.BorderBrush>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="85" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox VerticalAlignment="Center"
                                                          IsChecked="{Binding IsSelected}" />
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center">
                                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                                               FontSize="12"
                                                               FontWeight="Medium"
                                                               Text="{Binding DisplayName}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontFamily="{StaticResource AppFont}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               Text="{Binding DisplayQuantity}" />
                                                </StackPanel>
                                                <TextBox Grid.Column="2"
                                                         MinHeight="40"
                                                         Margin="6,0"
                                                         Padding="10,6"
                                                         FontSize="13"
                                                         Style="{StaticResource PosTextBox}"
                                                         Text="{Binding SelectedQuantity, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Grid.Column="3"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           Text="{Binding DisplayPrice}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Margin="0,18,0,0"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding AddAllSelectedCreditNoteLinesCommand}"
                                    Style="{StaticResource PosAccentBtn}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="15"
                                                             Height="15"
                                                             Margin="0,0,8,0"
                                                             VerticalAlignment="Center"
                                                             Foreground="White"
                                                             Kind="Plus" />
                                    <TextBlock FontSize="13"
                                               Foreground="White"
                                               Text="Ajouter sélection" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ADVANCE PANEL  -->
            <Border MaxHeight="500"
                    Margin="0"
                    VerticalAlignment="Top"
                    Style="{StaticResource PosOverlayCard}"
                    Visibility="{Binding ShowAdvancePanel, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource OverlayHeader}">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="22"
                                                         Height="22"
                                                         Margin="0,0,10,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="#7C3AED"
                                                         Kind="CashClock" />
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="#7C3AED"
                                           Text="Acompte" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    Command="{Binding ToggleAdvancePanelCommand}"
                                    Style="{StaticResource PosCloseBtn}" />
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1"
                                  PanningMode="VerticalOnly"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,20,28,24">
                            <TextBlock Style="{StaticResource PosFieldLabel}"
                                       Text="ID du groupe" />
                            <TextBox Margin="0,0,0,16"
                                     FontFamily="Consolas"
                                     Style="{StaticResource PosTextBox}"
                                     Text="{Binding AdvanceGroupId, UpdateSourceTrigger=PropertyChanged}" />
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Command="{Binding CreateNewAdvanceGroupCommand}"
                                        Style="{StaticResource PosPurpleBtn}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="14"
                                                                 Height="14"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="White"
                                                                 Kind="PlusCircleOutline" />
                                        <TextBlock Foreground="White"
                                                   Text="Nouveau" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2"
                                        Command="{Binding LoadAdvanceGroupCommand}"
                                        Style="{StaticResource PosGhostBtn}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="14"
                                                                 Height="14"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{StaticResource TextSecondaryBrush}"
                                                                 Kind="FolderOpenOutline" />
                                        <TextBlock FontSize="12"
                                                   Text="Charger" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding PreviousAdvances}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border MinHeight="48"
                                                Margin="0,4"
                                                Padding="16,12"
                                                Background="#F5F3FF"
                                                CornerRadius="10">
                                            <Grid>
                                                <TextBlock VerticalAlignment="Center"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="12">
                                                    <Run FontWeight="SemiBold"
                                                         Text="{Binding InvoiceNumber}" />
                                                    <Run Text=" — " />
                                                    <Run Text="{Binding DateDisplay}" />
                                                </TextBlock>
                                                <TextBlock HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="#7C3AED">
                                                    <Run Text="{Binding Amount, StringFormat=N0}" />
                                                    <Run FontSize="10"
                                                         Text=" CDF" />
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  COMMENT PANEL  -->
            <Border MaxHeight="540"
                    Margin="0"
                    VerticalAlignment="Top"
                    Style="{StaticResource PosOverlayCard}"
                    Visibility="{Binding ShowCommentPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource OverlayHeader}">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="22"
                                                         Height="22"
                                                         Margin="0,0,10,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource PrimaryBrush}"
                                                         Kind="CommentTextOutline" />
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Text="Commentaires" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    Command="{Binding ToggleCommentPanelCommand}"
                                    Style="{StaticResource PosCloseBtn}" />
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1"
                                  PanningMode="VerticalOnly"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,20,28,24">
                            <TextBlock Margin="2,0,0,8"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Text="{Binding CommentALabel}" />
                            <TextBox Margin="0,0,0,18"
                                     Style="{StaticResource PosTextBox}"
                                     Text="{Binding CommentA, UpdateSourceTrigger=PropertyChanged}" />
                            <Expander Padding="0,8,0,0"
                                      FontFamily="{StaticResource AppFont}"
                                      FontSize="12"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Header="Lignes B–H">
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource PosFieldLabel}"
                                               Text="B" />
                                    <TextBox MinHeight="40"
                                             Margin="0,0,0,12"
                                             Padding="12,8"
                                             Style="{StaticResource PosTextBox}"
                                             Text="{Binding CommentB}" />
                                    <TextBlock Style="{StaticResource PosFieldLabel}"
                                               Text="C" />
                                    <TextBox MinHeight="40"
                                             Margin="0,0,0,12"
                                             Padding="12,8"
                                             Style="{StaticResource PosTextBox}"
                                             Text="{Binding CommentC}" />
                                    <TextBlock Style="{StaticResource PosFieldLabel}"
                                               Text="D" />
                                    <TextBox MinHeight="40"
                                             Margin="0,0,0,12"
                                             Padding="12,8"
                                             Style="{StaticResource PosTextBox}"
                                             Text="{Binding CommentD}" />
                                    <TextBlock Style="{StaticResource PosFieldLabel}"
                                               Text="E" />
                                    <TextBox MinHeight="40"
                                             Margin="0,0,0,12"
                                             Padding="12,8"
                                             Style="{StaticResource PosTextBox}"
                                             Text="{Binding CommentE}" />
                                    <TextBlock Style="{StaticResource PosFieldLabel}"
                                               Text="F" />
                                    <TextBox MinHeight="40"
                                             Margin="0,0,0,12"
                                             Padding="12,8"
                                             Style="{StaticResource PosTextBox}"
                                             Text="{Binding CommentF}" />
                                    <TextBlock Style="{StaticResource PosFieldLabel}"
                                               Text="G" />
                                    <TextBox MinHeight="40"
                                             Margin="0,0,0,12"
                                             Padding="12,8"
                                             Style="{StaticResource PosTextBox}"
                                             Text="{Binding CommentG}" />
                                    <TextBlock Style="{StaticResource PosFieldLabel}"
                                               Text="H" />
                                    <TextBox MinHeight="40"
                                             Padding="12,8"
                                             Style="{StaticResource PosTextBox}"
                                             Text="{Binding CommentH}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  PENDING INVOICES PANEL  -->
            <Border Margin="0"
                    VerticalAlignment="Stretch"
                    Style="{StaticResource PosOverlayCard}"
                    Visibility="{Binding ShowPendingPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource OverlayHeader}">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="22"
                                                         Height="22"
                                                         Margin="0,0,10,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource WarningBrush}"
                                                         Kind="TimerSandEmpty" />
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Text="Factures en attente" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    Command="{Binding TogglePendingPanelCommand}"
                                    Style="{StaticResource PosCloseBtn}" />
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1"
                                  PanningMode="VerticalOnly"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,20,28,24">
                            <Button Margin="0,0,0,16"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding CheckPendingInvoicesCommand}"
                                    Style="{StaticResource PosMiniBtn}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="15"
                                                             Height="15"
                                                             Margin="0,0,8,0"
                                                             VerticalAlignment="Center"
                                                             Foreground="White"
                                                             Kind="Refresh" />
                                    <TextBlock FontSize="13"
                                               Foreground="White"
                                               Text="Vérifier le dispositif" />
                                </StackPanel>
                            </Button>
                            <ItemsControl ItemsSource="{Binding PendingInvoices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border MinHeight="56"
                                                Margin="0,4"
                                                Padding="16,14"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                            <Border.Background>
                                                <SolidColorBrush Opacity="0.05"
                                                                 Color="{StaticResource WarningColor}" />
                                            </Border.Background>
                                            <Border.BorderBrush>
                                                <SolidColorBrush Opacity="0.2"
                                                                 Color="{StaticResource WarningColor}" />
                                            </Border.BorderBrush>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Consolas"
                                                               FontSize="12"
                                                               FontWeight="SemiBold">
                                                        <Run Text="UID: " /><Run Text="{Binding Uid}" />
                                                    </TextBlock>
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontFamily="{StaticResource AppFont}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextMutedBrush}">
                                                        <Run Text="{Binding DateDisplay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Command="{Binding DataContext.CancelPendingInvoiceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Uid}"
                                                        Style="{StaticResource PosDangerBtn}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Width="12"
                                                                                 Height="12"
                                                                                 Margin="0,0,5,0"
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="#DC2626"
                                                                                 Kind="Close" />
                                                        <TextBlock FontSize="12"
                                                                   Foreground="#DC2626"
                                                                   Text="Annuler" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox FontFamily="Consolas"
                                         Style="{StaticResource PosTextBox}"
                                         Text="{Binding CancelUid, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="UID manuel" />
                                <Button Grid.Column="1"
                                        Margin="10,0,0,0"
                                        Command="{Binding CancelPendingInvoiceCommand}"
                                        Style="{StaticResource PosAccentBtn}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="14"
                                                                 Height="14"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="White"
                                                                 Kind="TrashCanOutline" />
                                        <TextBlock FontSize="12"
                                                   Foreground="White"
                                                   Text="Annuler" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border Margin="0,12,0,0"
                                    Padding="14,10"
                                    CornerRadius="10"
                                    Visibility="{Binding ShowPendingSuccess, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border.Background>
                                    <SolidColorBrush Opacity="0.06"
                                                     Color="{StaticResource SuccessColor}" />
                                </Border.Background>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="14"
                                                             Height="14"
                                                             Margin="0,0,8,0"
                                                             VerticalAlignment="Center"
                                                             Foreground="{StaticResource SuccessBrush}"
                                                             Kind="CheckCircleOutline" />
                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                               FontSize="11"
                                               Foreground="{StaticResource SuccessBrush}"
                                               Text="{Binding PendingStatusMessage}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,12,0,0"
                                    Padding="14,10"
                                    CornerRadius="10"
                                    Visibility="{Binding ShowPendingError, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border.Background>
                                    <SolidColorBrush Opacity="0.06"
                                                     Color="{StaticResource ErrorColor}" />
                                </Border.Background>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="14"
                                                             Height="14"
                                                             Margin="0,0,8,0"
                                                             VerticalAlignment="Center"
                                                             Foreground="{StaticResource ErrorBrush}"
                                                             Kind="AlertCircleOutline" />
                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                               FontSize="11"
                                               Foreground="{StaticResource ErrorBrush}"
                                               Text="{Binding PendingStatusMessage}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  DISCOUNT PANEL  -->
            <Border MaxHeight="500"
                    Margin="0"
                    VerticalAlignment="Top"
                    Style="{StaticResource PosOverlayCard}"
                    Visibility="{Binding ShowDiscountPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource OverlayHeader}">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="22"
                                                         Height="22"
                                                         Margin="0,0,10,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource AccentBrush}"
                                                         Kind="PercentOutline" />
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Text="Remise" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    Command="{Binding ToggleDiscountPanelCommand}"
                                    Style="{StaticResource PosCloseBtn}" />
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1"
                                  PanningMode="VerticalOnly"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,20,28,24">
                            <Border Margin="0,0,0,20"
                                    Padding="16,14"
                                    Background="{StaticResource BackgroundBrush}"
                                    CornerRadius="10">
                                <StackPanel>
                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Text="{Binding SelectedCartItem.Name}" />
                                    <TextBlock Margin="0,3,0,0"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}">
                                        <Run Text="{Binding SelectedCartItem.QuantityDisplay, Mode=OneWay}" />
                                        <Run Text=" → " />
                                        <Run Text="{Binding SelectedCartItem.AmountTTC, StringFormat=N0, Mode=OneWay}" />
                                        <Run Text=" CDF" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <WrapPanel Margin="0,0,0,20">
                                <Button Margin="0,0,10,10"
                                        Command="{Binding ApplyQuickDiscountCommand}"
                                        CommandParameter="5"
                                        Content="5 %"
                                        Style="{StaticResource PosDiscountChip}" />
                                <Button Margin="0,0,10,10"
                                        Command="{Binding ApplyQuickDiscountCommand}"
                                        CommandParameter="10"
                                        Content="10 %"
                                        Style="{StaticResource PosDiscountChip}" />
                                <Button Margin="0,0,10,10"
                                        Command="{Binding ApplyQuickDiscountCommand}"
                                        CommandParameter="15"
                                        Content="15 %"
                                        Style="{StaticResource PosDiscountChip}" />
                                <Button Margin="0,0,0,10"
                                        Command="{Binding ApplyQuickDiscountCommand}"
                                        CommandParameter="20"
                                        Content="20 %"
                                        Style="{StaticResource PosDiscountChip}" />
                            </WrapPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox FontSize="16"
                                         Style="{StaticResource PosTextBox}"
                                         Text="{Binding CustomDiscountValue, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Grid.Column="1"
                                            Margin="12,0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                    <RadioButton MinHeight="40"
                                                 Margin="0,0,12,0"
                                                 Content=" %"
                                                 FontFamily="{StaticResource AppFont}"
                                                 FontSize="13"
                                                 IsChecked="{Binding IsPercentDiscount}" />
                                    <RadioButton MinHeight="40"
                                                 Content=" CDF"
                                                 FontFamily="{StaticResource AppFont}"
                                                 FontSize="13" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Padding="18,10"
                                        Command="{Binding ApplyCustomDiscountCommand}"
                                        Content="OK"
                                        Style="{StaticResource PosAccentBtn}" />
                            </Grid>
                            <Button Margin="0,6,0,0"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding RemoveItemDiscountCommand}"
                                    Style="{StaticResource PosDangerBtn}"
                                    Visibility="{Binding SelectedCartItem.HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="14"
                                                             Height="14"
                                                             Margin="0,0,8,0"
                                                             VerticalAlignment="Center"
                                                             Foreground="#DC2626"
                                                             Kind="TrashCanOutline" />
                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                               FontSize="13"
                                               Foreground="#DC2626"
                                               Text="Supprimer la remise" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  HELD PANEL  -->
            <Border Margin="0"
                    VerticalAlignment="Stretch"
                    Style="{StaticResource PosOverlayCard}"
                    Visibility="{Binding ShowHeldPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel>
                    <Border Padding="24,18"
                            CornerRadius="16,16,0,0"
                            DockPanel.Dock="Top">
                        <Border.Background>
                            <SolidColorBrush Opacity="0.1"
                                             Color="{StaticResource WarningColor}" />
                        </Border.Background>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="20"
                                                         Height="20"
                                                         Margin="0,0,10,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="#92400E"
                                                         Kind="PauseCircleOutline" />
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#92400E"
                                           Text="En attente" />
                                <Border Margin="12,0,0,0"
                                        Padding="10,3"
                                        VerticalAlignment="Center"
                                        Background="#92400E"
                                        CornerRadius="10">
                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               Text="{Binding HeldCount}" />
                                </Border>
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    Command="{Binding ToggleHeldPanelCommand}"
                                    Style="{StaticResource PosCloseBtn}" />
                        </Grid>
                    </Border>
                    <ScrollViewer Padding="12,10"
                                  PanningMode="VerticalOnly"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding HeldTransactions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border MinHeight="72"
                                            Margin="4,4"
                                            Padding="18,16"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <Border.Background>
                                            <SolidColorBrush Opacity="0.04"
                                                             Color="{StaticResource WarningColor}" />
                                        </Border.Background>
                                        <Border.BorderBrush>
                                            <SolidColorBrush Opacity="0.2"
                                                             Color="{StaticResource WarningColor}" />
                                        </Border.BorderBrush>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock MaxWidth="200"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Label}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,3,0,0"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}">
                                                    <Run Text="{Binding ItemCount, Mode=OneWay}" />
                                                    <Run Text=" art. · " />
                                                    <Run Text="{Binding TotalDisplay, Mode=OneWay}" />
                                                    <Run Text=" CDF" />
                                                </TextBlock>
                                                <StackPanel Margin="0,3,0,0"
                                                            Orientation="Horizontal">
                                                    <materialDesign:PackIcon Width="11"
                                                                             Height="11"
                                                                             Margin="0,0,4,0"
                                                                             VerticalAlignment="Center"
                                                                             Foreground="{StaticResource TextMutedBrush}"
                                                                             Kind="ClockOutline" />
                                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextMutedBrush}">
                                                        <Run Text="{Binding TimeDisplay, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Width="48"
                                                    Height="48"
                                                    Margin="10,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.RecallHeldSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bg"
                                                                            Width="48"
                                                                            Height="48"
                                                                            CornerRadius="12">
                                                                        <Border.Background>
                                                                            <SolidColorBrush x:Name="BgBr"
                                                                                             Color="#10B981" />
                                                                        </Border.Background>
                                                                        <materialDesign:PackIcon Width="20"
                                                                                                 Height="20"
                                                                                                 HorizontalAlignment="Center"
                                                                                                 VerticalAlignment="Center"
                                                                                                 Foreground="White"
                                                                                                 Kind="Play" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <EventTrigger RoutedEvent="MouseEnter">
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <ColorAnimation Storyboard.TargetName="BgBr"
                                                                                                    Storyboard.TargetProperty="Color"
                                                                                                    To="#059669"
                                                                                                    Duration="0:0:0.15" />
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </EventTrigger>
                                                                        <EventTrigger RoutedEvent="MouseLeave">
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <ColorAnimation Storyboard.TargetName="BgBr"
                                                                                                    Storyboard.TargetProperty="Color"
                                                                                                    To="#10B981"
                                                                                                    Duration="0:0:0.18" />
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </EventTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Width="40"
                                                    Height="40"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding DataContext.DeleteHeldSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand">
                                                <materialDesign:PackIcon Width="16"
                                                                         Height="16"
                                                                         Foreground="{StaticResource TextMutedBrush}"
                                                                         Kind="TrashCanOutline"
                                                                         Opacity="0.6" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!--  HOLD DIALOG  -->
            <Grid Visibility="{Binding ShowHoldDialog, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="#80000000"
                        CornerRadius="16" />
                <Border Margin="32"
                        Padding="32"
                        VerticalAlignment="Center"
                        Background="{StaticResource CardBrush}"
                        CornerRadius="16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28"
                                          Opacity="0.2"
                                          ShadowDepth="4"
                                          Color="#0D2B3E" />
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Margin="0,0,0,18"
                                    Orientation="Horizontal">
                            <materialDesign:PackIcon Width="22"
                                                     Height="22"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="#D97706"
                                                     Kind="PauseCircleOutline" />
                            <TextBlock FontFamily="{StaticResource AppFont}"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Text="Mettre en attente" />
                        </StackPanel>
                        <TextBlock Margin="2,0,0,8"
                                   Style="{StaticResource PosFieldLabel}"
                                   Text="Raison (optionnel) :" />
                        <TextBox Margin="0,0,0,22"
                                 MaxLength="100"
                                 Style="{StaticResource PosTextBox}"
                                 Text="{Binding HoldReason, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Padding="16,14"
                                    Command="{Binding CancelHoldCommand}"
                                    Style="{StaticResource PosGhostBtn}">
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="14"
                                           Text="Annuler" />
                            </Button>
                            <Button Grid.Column="2"
                                    Command="{Binding HoldCurrentSaleCommand}"
                                    Style="{StaticResource PosHoldBtn}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16"
                                                             Height="16"
                                                             Margin="0,0,8,0"
                                                             VerticalAlignment="Center"
                                                             Foreground="White"
                                                             Kind="PauseCircleOutline" />
                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               Text="Confirmer" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>