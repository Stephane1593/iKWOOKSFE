                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding CreditNoteSelections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="0,0,0,1" Padding="8,12" MinHeight="56">
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="{StaticResource BorderLightColor}"/>
                                            </Border.BorderBrush>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="85"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontFamily="{StaticResource AppFont}"
                                                               FontSize="12" FontWeight="Medium"/>
                                                    <TextBlock Text="{Binding DisplayQuantity}" FontFamily="{StaticResource AppFont}"
                                                               FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBox Grid.Column="2" Style="{StaticResource PosTextBox}"
                                                         MinHeight="40" Padding="10,6" FontSize="13"
                                                         Text="{Binding SelectedQuantity, UpdateSourceTrigger=PropertyChanged}" Margin="6,0"/>
                                                <TextBlock Grid.Column="3" Text="{Binding DisplayPrice}" FontFamily="{StaticResource AppFont}"
                                                           FontSize="11" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Style="{StaticResource PosAccentBtn}" Margin="0,18,0,0"
                                    Command="{Binding AddAllSelectedCreditNoteLinesCommand}" HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="15" Height="15"
                                                             Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Ajouter sélection" Foreground="White" FontSize="13"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

