                                                    <TextBlock FontFamily="Consolas" FontSize="12" FontWeight="SemiBold">
                                                        <Run Text="UID: "/><Run Text="{Binding Uid}"/>
                                                    </TextBlock>
                                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0">
                                                        <Run Text="{Binding DateDisplay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource PosDangerBtn}"
                                                        Command="{Binding DataContext.CancelPendingInvoiceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Uid}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Close" Width="12" Height="12"
                                                                                 Foreground="#DC2626" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Annuler" Foreground="#DC2626" FontSize="12"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource PosTextBox}" FontFamily="Consolas"
                                         Text="{Binding CancelUid, UpdateSourceTrigger=PropertyChanged}" ToolTip="UID manuel"/>
                                <Button Grid.Column="1" Style="{StaticResource PosAccentBtn}" Margin="10,0,0,0"
                                        Command="{Binding CancelPendingInvoiceCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="TrashCanOutline" Width="14" Height="14"
                                                                 Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Annuler" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border Margin="0,12,0,0" CornerRadius="10" Padding="14,10"
                                    Visibility="{Binding ShowPendingSuccess, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border.Background>
                                    <SolidColorBrush Color="{StaticResource SuccessColor}" Opacity="0.06"/>
                                </Border.Background>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CheckCircleOutline" Width="14" Height="14"
                                                             Foreground="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PendingStatusMessage}" Foreground="{StaticResource SuccessBrush}"
                                               FontFamily="{StaticResource AppFont}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Margin="0,12,0,0" CornerRadius="10" Padding="14,10"
                                    Visibility="{Binding ShowPendingError, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border.Background>
                                    <SolidColorBrush Color="{StaticResource ErrorColor}" Opacity="0.06"/>
                                </Border.Background>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="14" Height="14"
                                                             Foreground="{StaticResource ErrorBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PendingStatusMessage}" Foreground="{StaticResource ErrorBrush}"
                                               FontFamily="{StaticResource AppFont}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- DISCOUNT PANEL -->
            <Border Style="{StaticResource PosOverlayCard}"
                    VerticalAlignment="Top" MaxHeight="500" Margin="0"
                    Visibility="{Binding ShowDiscountPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource OverlayHeader}">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PercentOutline" Width="22" Height="22"
                                                         Foreground="{StaticResource AccentBrush}"
                                                         Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Remise" FontFamily="{StaticResource AppFont}"
                                           FontSize="17" FontWeight="Bold"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Style="{StaticResource PosCloseBtn}"
                                    Command="{Binding ToggleDiscountPanelCommand}"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                        <StackPanel Margin="28,20,28,24">
                            <Border Background="{StaticResource BackgroundBrush}" CornerRadius="10"
                                    Padding="16,14" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedCartItem.Name}" FontFamily="{StaticResource AppFont}"
                                               FontSize="13" FontWeight="Medium"/>
                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0">
                                        <Run Text="{Binding SelectedCartItem.QuantityDisplay, Mode=OneWay}"/>
                                        <Run Text=" → "/>
                                        <Run Text="{Binding SelectedCartItem.AmountTTC, StringFormat=N0, Mode=OneWay}"/>
                                        <Run Text=" CDF"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <WrapPanel Margin="0,0,0,20">
                                <Button Style="{StaticResource PosDiscountChip}" Content="5 %" Margin="0,0,10,10"
                                        Command="{Binding ApplyQuickDiscountCommand}" CommandParameter="5"/>
                                <Button Style="{StaticResource PosDiscountChip}" Content="10 %" Margin="0,0,10,10"
                                        Command="{Binding ApplyQuickDiscountCommand}" CommandParameter="10"/>
                                <Button Style="{StaticResource PosDiscountChip}" Content="15 %" Margin="0,0,10,10"
                                        Command="{Binding ApplyQuickDiscountCommand}" CommandParameter="15"/>
                                <Button Style="{StaticResource PosDiscountChip}" Content="20 %" Margin="0,0,0,10"
                                        Command="{Binding ApplyQuickDiscountCommand}" CommandParameter="20"/>
                            </WrapPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource PosTextBox}" FontSize="16"
                                         Text="{Binding CustomDiscountValue, UpdateSourceTrigger=PropertyChanged}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                                    <RadioButton Content=" %" IsChecked="{Binding IsPercentDiscount}"
                                                 FontFamily="{StaticResource AppFont}" FontSize="13" Margin="0,0,12,0" MinHeight="40"/>
                                    <RadioButton Content=" CDF" FontFamily="{StaticResource AppFont}" FontSize="13" MinHeight="40"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource PosAccentBtn}" Content="OK" Padding="18,10"
                                        Command="{Binding ApplyCustomDiscountCommand}"/>
                            </Grid>
                            <Button Style="{StaticResource PosDangerBtn}" Margin="0,6,0,0"
                                    Command="{Binding RemoveItemDiscountCommand}" HorizontalContentAlignment="Center"
                                    Visibility="{Binding SelectedCartItem.HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="TrashCanOutline" Width="14" Height="14"
                                                             Foreground="#DC2626" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Supprimer la remise" FontFamily="{StaticResource AppFont}"
                                               FontSize="13" Foreground="#DC2626"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- HELD PANEL -->
            <Border Style="{StaticResource PosOverlayCard}"
                    VerticalAlignment="Stretch" Margin="0"
                    Visibility="{Binding ShowHeldPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="24,18" CornerRadius="16,16,0,0">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.1"/>
                        </Border.Background>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PauseCircleOutline" Width="20" Height="20"
                                                         Foreground="#92400E" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="En attente" FontFamily="{StaticResource AppFont}"
                                           FontSize="16" FontWeight="Bold" Foreground="#92400E"/>
                                <Border Background="#92400E" CornerRadius="10" Padding="10,3" Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding HeldCount}" FontFamily="{StaticResource AppFont}"
                                               FontSize="12" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Style="{StaticResource PosCloseBtn}"
                                    Command="{Binding ToggleHeldPanelCommand}"/>
                        </Grid>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10" PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding HeldTransactions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="4,4" CornerRadius="12" Padding="18,16" BorderThickness="1" MinHeight="72">
                                        <Border.Background>
                                            <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.04"/>
                                        </Border.Background>
                                        <Border.BorderBrush>
                                            <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.2"/>
                                        </Border.BorderBrush>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" FontFamily="{StaticResource AppFont}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0">
                                                    <Run Text="{Binding ItemCount, Mode=OneWay}"/>
                                                    <Run Text=" art. · "/>
                                                    <Run Text="{Binding TotalDisplay, Mode=OneWay}"/>
                                                    <Run Text=" CDF"/>
                                                </TextBlock>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <materialDesign:PackIcon Kind="ClockOutline" Width="11" Height="11"
                                                                             Foreground="{StaticResource TextMutedBrush}"
                                                                             Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                                               Foreground="{StaticResource TextMutedBrush}">
                                                        <Run Text="{Binding TimeDisplay, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center"
                                                    Cursor="Hand" Width="48" Height="48"
                                                    Command="{Binding DataContext.RecallHeldSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bg" CornerRadius="12" Width="48" Height="48">
                                                                        <Border.Background>
                                                                            <SolidColorBrush x:Name="BgBr" Color="#10B981"/>
                                                                        </Border.Background>
                                                                        <materialDesign:PackIcon Kind="Play" Width="20" Height="20"
                                                                                                 Foreground="White"
                                                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <EventTrigger RoutedEvent="MouseEnter">
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <ColorAnimation Storyboard.TargetName="BgBr"
                                                                                                    Storyboard.TargetProperty="Color"
                                                                                                    To="#059669" Duration="0:0:0.15"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </EventTrigger>
                                                                        <EventTrigger RoutedEvent="MouseLeave">
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <ColorAnimation Storyboard.TargetName="BgBr"
                                                                                                    Storyboard.TargetProperty="Color"
                                                                                                    To="#10B981" Duration="0:0:0.18"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </EventTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Grid.Column="2" VerticalAlignment="Center" Cursor="Hand"
                                                    Background="Transparent" BorderThickness="0" Width="40" Height="40"
                                                    Command="{Binding DataContext.DeleteHeldSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16"
                                                                         Foreground="{StaticResource TextMutedBrush}" Opacity="0.6"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- HOLD DIALOG -->
            <Grid Visibility="{Binding ShowHoldDialog, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="#80000000" CornerRadius="16"/>
                <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="32"
                        VerticalAlignment="Center" Margin="32">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" Opacity="0.2" ShadowDepth="4" Color="#0D2B3E"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <materialDesign:PackIcon Kind="PauseCircleOutline" Width="22" Height="22"
                                                     Foreground="#D97706" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Mettre en attente" FontFamily="{StaticResource AppFont}"
                                       FontSize="17" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="Raison (optionnel) :" Style="{StaticResource PosFieldLabel}" Margin="2,0,0,8"/>
                        <TextBox Style="{StaticResource PosTextBox}" Margin="0,0,0,22" MaxLength="100"
                                 Text="{Binding HoldReason, UpdateSourceTrigger=PropertyChanged}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource PosGhostBtn}" Padding="16,14"
                                    Command="{Binding CancelHoldCommand}">
                                <TextBlock Text="Annuler" FontFamily="{StaticResource AppFont}" FontSize="14"/>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource PosHoldBtn}"
                                    Command="{Binding HoldCurrentSaleCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="PauseCircleOutline" Width="16" Height="16"
                                                             Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Confirmer" FontFamily="{StaticResource AppFont}"
                                               FontSize="14" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>