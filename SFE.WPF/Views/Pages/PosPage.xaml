<UserControl x:Class="SFE.WPF.Views.Pages.PosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:SFE.Domain.Enums;assembly=SFE.Domain"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <!--  ══════════ TOUCH SCROLLBARS (Élargies pour les doigts) ══════════  -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource MaterialDesignScrollBar}">
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="MinHeight" Value="40" />
        </Style>

        <Style x:Key="PosSegment" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,6,6" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" MinHeight="36" Padding="10,6" Background="{StaticResource BackgroundBrush}" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush">
                                                <Setter.Value>
                                                    <SolidColorBrush Color="{StaticResource BorderColor}" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                            <Setter TargetName="Bd" Property="TextElement.Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="SemiBold" Text="{Binding}" />
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PosCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Opacity="0.06" ShadowDepth="2" Color="#0D2B3E" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PosOverlayCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="28" Opacity="0.14" ShadowDepth="6" Color="#0D2B3E" />
                </Setter.Value>
            </Setter>
        </Style>

        <DropShadowEffect x:Key="PopupShadow" BlurRadius="24" Direction="270" Opacity="0.12" ShadowDepth="5" Color="#0D2B3E" />

        <Style x:Key="PosFieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="2,0,0,4" />
        </Style>

        <Style x:Key="PosTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <SolidColorBrush Color="{StaticResource BorderLightColor}" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" MinHeight="{TemplateBinding MinHeight}" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PosComboBox" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="38" />
        </Style>

        <Style x:Key="PosIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E7EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PosCloseBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="34" Height="34" Background="{TemplateBinding Background}" CornerRadius="6">
                            <materialDesign:PackIcon Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Kind="Close" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FEE2E2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FECACA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PosMiniBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" MinHeight="{TemplateBinding MinHeight}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="#37B1E4" />
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PosDangerBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#DC2626" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" MinHeight="{TemplateBinding MinHeight}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="#FEE2E2" />
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PosSuccessBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#065F46" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" MinHeight="{TemplateBinding MinHeight}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="#DCFCE7" />
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PosPurpleBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" MinHeight="{TemplateBinding MinHeight}" Padding="{TemplateBinding Padding}" CornerRadius="8">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="#7C3AED" />
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PosGhostBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" MinHeight="{TemplateBinding MinHeight}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="#F3F4F6" />
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#E5E7EB"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PosProcessBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" MinHeight="{TemplateBinding MinHeight}" Padding="{TemplateBinding Padding}" CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush x:Name="BdGrad" StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="G0" Offset="0" Color="#10B981" />
                                    <GradientStop x:Name="G1" Offset="1" Color="#059669" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Opacity="0.25" ShadowDepth="2" Color="#10B981" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PosHoldBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" MinHeight="{TemplateBinding MinHeight}" Padding="{TemplateBinding Padding}" CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush x:Name="BdGrad" StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="G0" Offset="0" Color="#F59E0B" />
                                    <GradientStop x:Name="G1" Offset="1" Color="#D97706" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Opacity="0.25" ShadowDepth="2" Color="#F59E0B" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PosPrimaryBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" MinHeight="{TemplateBinding MinHeight}" Padding="{TemplateBinding Padding}" CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush x:Name="BdGrad" StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="G0" Offset="0" Color="#37B1E4" />
                                    <GradientStop x:Name="G1" Offset="1" Color="#1A8CBF" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Opacity="0.18" ShadowDepth="1" Color="#37B1E4" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PosAccentBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" MinHeight="{TemplateBinding MinHeight}" Padding="{TemplateBinding Padding}" CornerRadius="8">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="{StaticResource AccentColor}" />
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg" Storyboard.TargetProperty="Color" To="#DC0F0F" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg" Storyboard.TargetProperty="Color" To="{StaticResource AccentColor}" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PosDiscountChip" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#DC2626" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" MinHeight="{TemplateBinding MinHeight}" Padding="{TemplateBinding Padding}" CornerRadius="8">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="#FEE2E2" />
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProductCardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <SolidColorBrush Color="{StaticResource BorderLightColor}" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PopupItemBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,1">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="#00000000" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource BorderLightColor}" />
                            </Border.BorderBrush>
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Opacity="0.04" Color="{StaticResource PrimaryColor}" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayHeader" TargetType="Border">
            <Setter Property="Padding" Value="16,12,16,10" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <SolidColorBrush Color="{StaticResource BorderLightColor}" />
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <!-- 🚨 FIXED: Layout ratios ajustés. Le panneau de droite est maintenant beaucoup plus large -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4.5*" MinWidth="360" />
            <ColumnDefinition Width="5.5*" MinWidth="420" MaxWidth="550" />
        </Grid.ColumnDefinitions>

        <!--  ══════════════════════════════════════════════════════  -->
        <!--  LEFT: Catalogue & Infos (Taxes)  -->
        <!--  ══════════════════════════════════════════════════════  -->
        <DockPanel Grid.Column="0" Margin="12,10,6,10">

            <!--  TOP BAR  -->
            <Border Margin="0,0,0,12" Padding="12,10" DockPanel.Dock="Top" Style="{StaticResource PosCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" ToolTip="Heure et date actuelles">
                            <TextBlock FontFamily="Consolas" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding CurrentTime}" />
                            <TextBlock Margin="0,1,0,0" FontFamily="{StaticResource AppFont}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Text="{Binding CurrentDate}" />
                        </StackPanel>

                        <Border Grid.Column="1" Margin="8,0,0,0" Padding="8,4" VerticalAlignment="Center" CornerRadius="6" ToolTip="Mode de tarification actuel (TTC ou HT)">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Opacity="0.1" Color="{StaticResource PrimaryColor}" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHtMode}" Value="True">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Opacity="0.12" Color="{StaticResource WarningColor}" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="TagOutline" />
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHtMode}" Value="True">
                                                    <Setter Property="Foreground" Value="#92400E" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="Bold" Text="{Binding PriceModeDisplay}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHtMode}" Value="True">
                                                    <Setter Property="Foreground" Value="#92400E" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!--  INDICATEUR DE TABLE  -->
                        <Border Grid.Column="2" Margin="8,0,0,0" Padding="8,4" VerticalAlignment="Center" CornerRadius="6" ToolTip="Table actuellement en cours d'édition">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#EFF6FF" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TableLabel}" Value="Vente Comptoir">
                                            <Setter Property="Background" Value="#F3F4F6" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Foreground" Value="#1D4ED8" />
                                            <Setter Property="Kind" Value="TableFurniture" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TableLabel}" Value="Vente Comptoir">
                                                    <Setter Property="Foreground" Value="#6B7280" />
                                                    <Setter Property="Kind" Value="StorefrontOutline" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="Bold" Text="{Binding TableLabel}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#1D4ED8" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TableLabel}" Value="Vente Comptoir">
                                                    <Setter Property="Foreground" Value="#4B5563" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" MinHeight="36" Margin="10,0" Padding="8,0" Background="{StaticResource BackgroundBrush}" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Kind="Magnify" />
                                <TextBox x:Name="SearchBox" Grid.Column="1" Padding="0,6" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" FontFamily="{StaticResource AppFont}" FontSize="12" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" materialDesign:HintAssist.Hint="Rechercher un produit..." />
                                <Popup Grid.Column="1" MinWidth="350" AllowsTransparency="True" IsOpen="{Binding ShowSearchResults, Mode=TwoWay}" Placement="Bottom" PlacementTarget="{Binding ElementName=SearchBox}" StaysOpen="False">
                                    <Border MinWidth="350" MaxWidth="500" MaxHeight="300" Background="White" BorderThickness="1" CornerRadius="0,0,10,10" Effect="{StaticResource PopupShadow}">
                                        <Border.BorderBrush>
                                            <SolidColorBrush Color="{StaticResource BorderLightColor}" />
                                        </Border.BorderBrush>
                                        <ScrollViewer PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource PopupItemBtn}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="Medium" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Margin="0,2,0,0" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}"><Run Text="{Binding Code, Mode=OneWay}" /></TextBlock>
                                                                </StackPanel>
                                                                <Border Grid.Column="1" Margin="10,0,0,0" Padding="8,4" VerticalAlignment="Center" CornerRadius="6">
                                                                    <Border.Background>
                                                                        <SolidColorBrush Opacity="0.08" Color="{StaticResource PrimaryColor}" />
                                                                    </Border.Background>
                                                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding UnitPriceTtcCdf, StringFormat='{}{0:N2} CDF'}" />
                                                                </Border>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Résumé des ventes du jour">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Kind="ChartBarStacked" />
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10" Foreground="{StaticResource TextMutedBrush}">
                                    <Run Text="{Binding TodaySalesCount, Mode=OneWay}" />
                                    <Run Text=" ventes" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Margin="0,1,0,0" HorizontalAlignment="Right" FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}">
                                <Run Text="{Binding TodaySalesTotal, StringFormat=N2, Mode=OneWay}" />
                                <Run Text=" CDF" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,10,0,0" Padding="12,8" BorderThickness="1" CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Opacity="0.05" Color="{StaticResource PrimaryColor}" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="BorderBrush">
                                    <Setter.Value>
                                        <SolidColorBrush Opacity="0.2" Color="{StaticResource PrimaryColor}" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPointOfSale}" Value="{x:Null}">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Opacity="0.05" Color="{StaticResource ErrorColor}" />
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="BorderBrush">
                                            <Setter.Value>
                                                <SolidColorBrush Opacity="0.2" Color="{StaticResource ErrorColor}" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource PrimaryDarkBrush}" Kind="StorefrontOutline" />
                                <Border Margin="0,0,6,0" Padding="6,2" VerticalAlignment="Center" Background="{StaticResource PrimaryLightBrush}" CornerRadius="4" Visibility="{Binding SelectedPointOfSale, Converter={StaticResource IsNotNullToVisibilityConverter}}">
                                    <TextBlock FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" Text="{Binding SelectedPointOfSale.Code}" />
                                </Border>
                                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="SemiBold" Text="{Binding SelectedPointOfSale.Name}" />
                            </StackPanel>
                            <TextBlock Margin="20,2,0,0" FontFamily="{StaticResource AppFont}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Text="{Binding SelectedPosInfo}" Visibility="{Binding SelectedPointOfSale, Converter={StaticResource IsNotNullToVisibilityConverter}}" />
                            <StackPanel Margin="20,2,0,0" Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPointOfSale}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <materialDesign:PackIcon Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="#DC2626" Kind="AlertOutline" />
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10" FontStyle="Italic" Foreground="#DC2626" Text="Aucun point de vente configuré" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 🚨 FIXED: FOOTER INFO FOR THE LEFT SIDE (HT, TVA, Specifiques, Proforma, Duplicata) -->
            <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="14,12" Style="{StaticResource PosCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <Grid MinHeight="20" Margin="0,0,0,2">
                            <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="Total Hors Taxes (HT)" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Text="{Binding TotalHT, StringFormat='{}{0:N2} CDF'}" />
                        </Grid>
                        <Grid MinHeight="20" Margin="0,0,0,2">
                            <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="12" Foreground="{StaticResource PrimaryBrush}" Text="Total TVA" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding TotalTVA, StringFormat='{}{0:N2} CDF'}" />
                        </Grid>
                        <Grid MinHeight="20" Visibility="{Binding HasAnySpecificTax, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="12" Foreground="#92400E" Text="Total Taxe Spécifique" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="SemiBold" Foreground="#92400E" Text="{Binding TotalSpecificTax, StringFormat='{}{0:N2} CDF'}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                        <Button Margin="0,0,8,0" Padding="12,10" Command="{Binding PrintProformaCommand}" IsEnabled="{Binding CanPrintProforma}" Style="{StaticResource PosGhostBtn}" ToolTip="Imprimer un proforma">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Kind="FileDocumentOutline" />
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="SemiBold" Text="Proforma" />
                            </StackPanel>
                        </Button>
                        <Button Padding="12,10" Command="{Binding ReprintReceiptCommand}" Style="{StaticResource PosGhostBtn}" Visibility="{Binding HasThermalPrinter, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="Réimprimer le ticket précédent">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Kind="PrinterOutline" />
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="SemiBold" Text="Duplicata" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  AFFICHAGE 1 : MODE COMPTOIR  -->
            <Grid Visibility="{Binding IsRestaurantMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" Margin="0,0,0,8" HorizontalScrollBarVisibility="Auto" PanningMode="HorizontalOnly" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                        <Button MinHeight="44" Margin="0,0,6,0" Padding="16,10" BorderThickness="0" Command="{Binding ShowFavoritesCommand}" Cursor="Hand" FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="SemiBold">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{StaticResource CardBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowFavoritesOnly}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center" Kind="StarOutline" />
                                <TextBlock Text="Favoris" />
                            </StackPanel>
                        </Button>
                        <Button MinHeight="44" Margin="0,0,6,0" Padding="16,10" Background="{StaticResource CardBrush}" BorderThickness="0" Command="{Binding ShowAllProductsCommand}" Content="Tout" Cursor="Hand" FontFamily="{StaticResource AppFont}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />

                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button MinHeight="44" Margin="0,0,6,0" Padding="16,10" Background="{StaticResource CardBrush}" BorderThickness="0" Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Cursor="Hand" FontFamily="{StaticResource AppFont}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="0,0,4,0" Text="{Binding Icon}" />
                                            <TextBlock Text="{Binding Name}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Grid.Row="1" PanningMode="VerticalOnly" VerticalScrollBarVisibility="Visible">
                    <ItemsControl ItemsSource="{Binding DisplayProducts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="110" Height="80" Margin="0,0,8,8" BorderThickness="0" Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Style="{StaticResource ProductCardBorder}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock MaxHeight="28" FontFamily="{StaticResource AppFont}" FontSize="10" FontWeight="Medium" Text="{Binding Name}" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Row="1" VerticalAlignment="Center" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource TextMutedBrush}"><Run Text="{Binding Code, Mode=OneWay}" /></TextBlock>
                                                    <Grid Grid.Row="2">
                                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"><Run Text="{Binding UnitPriceTtcCdf, StringFormat=N2, Mode=OneWay}" /></TextBlock>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!--  AFFICHAGE 2 : MODE RESTAURANT  -->
            <Grid Visibility="{Binding IsRestaurantMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" Margin="0,0,0,8" HorizontalScrollBarVisibility="Auto" PanningMode="HorizontalOnly" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,2,0,6" Orientation="Horizontal">
                        <ItemsControl ItemsSource="{Binding RestaurantMenus}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button MinHeight="44" Margin="0,0,6,0" Padding="20,10" Background="{StaticResource CardBrush}" BorderThickness="0" Command="{Binding DataContext.SelectRestaurantMenuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Cursor="Hand" FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}">
                                        <TextBlock Text="{Binding Name}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Grid.Row="1" PanningMode="VerticalOnly" VerticalScrollBarVisibility="Visible">
                    <ItemsControl ItemsSource="{Binding RestaurantMenuItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="120" Height="85" Margin="0,0,8,8" BorderThickness="0" Command="{Binding DataContext.AddMenuItemToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CardBorder" Padding="8" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="8">
                                                <Grid>
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="Bold" Foreground="#1E293B" Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>

        <!--  ══════════════════════════════════════════════════════  -->
        <!--  RIGHT: Cart (Flexible Width via Grid.Column=1)  -->
        <!--  ══════════════════════════════════════════════════════  -->
        <Grid Grid.Column="1" Margin="6,10,12,10">
            <Border CornerRadius="12" Style="{StaticResource PosCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />

                        <!-- Middle cart row uses * to take remaining space, collapses on payment -->
                        <RowDefinition>
                            <RowDefinition.Style>
                                <Style TargetType="RowDefinition">
                                    <Setter Property="Height" Value="*" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowPaymentStep}" Value="True">
                                            <Setter Property="Height" Value="0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </RowDefinition.Style>
                        </RowDefinition>

                        <!-- Footer uses Auto to be compact, expands to * on payment -->
                        <RowDefinition>
                            <RowDefinition.Style>
                                <Style TargetType="RowDefinition">
                                    <Setter Property="Height" Value="Auto" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowPaymentStep}" Value="True">
                                            <Setter Property="Height" Value="*" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </RowDefinition.Style>
                        </RowDefinition>
                    </Grid.RowDefinitions>

                    <!--  ────── ROW 0: CART HEADER ──────  -->
                    <Border Grid.Row="0" Padding="16,14,16,10" BorderThickness="0,0,0,1">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{StaticResource BorderLightColor}" />
                        </Border.BorderBrush>
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <Grid>
                                            <materialDesign:PackIcon x:Name="CartIcon" Width="20" Height="20" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}" Kind="CartOutline" />
                                            <Border x:Name="CartBadge" Height="14" MinWidth="14" Margin="0,-4,-4,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#EF4444" CornerRadius="7" RenderTransformOrigin="0.5,0.5" Visibility="{Binding CartItemCount, Converter={StaticResource IntToVisibilityConverter}}">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="BadgeScale" ScaleX="1" ScaleY="1" />
                                                </Border.RenderTransform>
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="8" FontWeight="Bold" Foreground="White" Text="{Binding CartItemCount}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="16" FontWeight="Bold" Text="{Binding TableLabel}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                    <Button Command="{Binding OpenCashDrawerCommand}" Style="{StaticResource PosIconBtn}" Visibility="{Binding HasThermalPrinter, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid>
                                            <materialDesign:PackIcon Width="14" Height="14" Foreground="{StaticResource TextSecondaryBrush}" Kind="CashRegister" />
                                            <Border Width="6" Height="6" Margin="0,-2,-2,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#10B981" CornerRadius="3" Visibility="{Binding SelectedPointOfSale.EnableCashDrawer, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>
                                    </Button>
                                    <Button Command="{Binding ToggleClientPanelCommand}" Style="{StaticResource PosIconBtn}">
                                        <materialDesign:PackIcon Width="14" Height="14" Foreground="{StaticResource TextSecondaryBrush}" Kind="AccountOutline" />
                                    </Button>
                                    <Button Command="{Binding ToggleCommentPanelCommand}" Style="{StaticResource PosIconBtn}">
                                        <materialDesign:PackIcon Width="14" Height="14" Foreground="{StaticResource TextSecondaryBrush}" Kind="CommentTextOutline" />
                                    </Button>
                                    <Button Command="{Binding ToggleDiscountPanelCommand}" Style="{StaticResource PosIconBtn}" Visibility="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}">
                                        <materialDesign:PackIcon Width="14" Height="14" Foreground="{StaticResource AccentBrush}" Kind="PercentOutline" />
                                    </Button>
                                    <Button Command="{Binding ToggleHeldPanelCommand}" Style="{StaticResource PosIconBtn}">
                                        <Grid>
                                            <materialDesign:PackIcon Width="14" Height="14" Foreground="{StaticResource TextSecondaryBrush}" Kind="PauseCircleOutline" />
                                            <Border Height="12" MinWidth="12" Margin="0,-2,-2,0" Padding="2,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#EF4444" CornerRadius="6" Visibility="{Binding HeldCount, Converter={StaticResource IntToVisibilityConverter}}">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="7" FontWeight="Bold" Foreground="White" Text="{Binding HeldCount}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Button Command="{Binding TogglePendingPanelCommand}" Style="{StaticResource PosIconBtn}">
                                        <materialDesign:PackIcon Width="14" Height="14" Foreground="{StaticResource TextSecondaryBrush}" Kind="TimerSandEmpty" />
                                    </Button>
                                    <Button Command="{Binding ClearCartCommand}" Style="{StaticResource PosIconBtn}" Visibility="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}">
                                        <materialDesign:PackIcon Width="14" Height="14" Foreground="{StaticResource TextMutedBrush}" Kind="TrashCanOutline" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="10" Foreground="{StaticResource TextMutedBrush}">
                                    <Run Text="{Binding CartItemCount, Mode=OneWay}" />
                                    <Run Text=" ligne(s) · " />
                                    <Run Text="{Binding TotalArticles, Mode=OneWay}" />
                                    <Run Text=" art." />
                                </TextBlock>
                            </Grid>

                            <Border MinHeight="32" Margin="0,6,0,0" Padding="10,6" CornerRadius="6" Visibility="{Binding HasClientSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border.Background>
                                    <SolidColorBrush Opacity="0.06" Color="{StaticResource PrimaryColor}" />
                                </Border.Background>
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}" Kind="AccountCheckOutline" />
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding ClientName}" />
                                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" Text="{Binding ClientTypeMention}" />
                                    </StackPanel>
                                    <Button Width="24" Height="24" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Command="{Binding ClearClientCommand}" Cursor="Hand">
                                        <materialDesign:PackIcon Width="10" Height="10" Foreground="#DC2626" Kind="Close" />
                                    </Button>
                                </Grid>
                            </Border>

                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                <Border MinHeight="26" Margin="0,0,4,0" Padding="8,4" CornerRadius="4" Visibility="{Binding IsCreditNote, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border.Background>
                                        <SolidColorBrush Opacity="0.08" Color="{StaticResource ErrorColor}" />
                                    </Border.Background>
                                    <Button Padding="0" Background="Transparent" BorderThickness="0" Command="{Binding ToggleCreditNotePanelCommand}" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="10" Height="10" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="#DC2626" Kind="FileUndoOutline" />
                                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="9" FontWeight="SemiBold" Foreground="#DC2626" Text="Avoir" />
                                        </StackPanel>
                                    </Button>
                                </Border>
                                <Border MinHeight="26" Padding="8,4" CornerRadius="4" Visibility="{Binding IsAdvanceInvoice, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border.Background>
                                        <SolidColorBrush Opacity="0.08" Color="#7C3AED" />
                                    </Border.Background>
                                    <Button Padding="0" Background="Transparent" BorderThickness="0" Command="{Binding ToggleAdvancePanelCommand}" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="10" Height="10" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="#7C3AED" Kind="CashClock" />
                                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="9" FontWeight="SemiBold" Foreground="#7C3AED" Text="Acompte" />
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </StackPanel>

                            <StackPanel Margin="0,6,0,0" Visibility="{Binding IsRestaurantMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource PosFieldLabel}" FontSize="10" Text="Type de commande" Margin="2,0,0,2"/>
                                <ListBox Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectedValue="{Binding SelectedDiningOption}" SelectedValuePath="Tag">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Margin" Value="0,0,4,0" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd" MinHeight="32" Padding="2" Background="{StaticResource BackgroundBrush}" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="6">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="BorderBrush">
                                                                    <Setter.Value>
                                                                        <SolidColorBrush Color="{StaticResource BorderColor}" />
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                                <Setter Property="TextElement.Foreground" Value="White" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBoxItem Tag="{x:Static enums:DiningOption.DineIn}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" Kind="Silverware" />
                                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10" FontWeight="SemiBold" Text="Sur place" />
                                        </StackPanel>
                                    </ListBoxItem>
                                    <ListBoxItem Tag="{x:Static enums:DiningOption.Takeaway}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" Kind="ShoppingOutline" />
                                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10" FontWeight="SemiBold" Text="À emporter" />
                                        </StackPanel>
                                    </ListBoxItem>
                                    <ListBoxItem Tag="{x:Static enums:DiningOption.Delivery}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" Kind="MopedOutline" />
                                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10" FontWeight="SemiBold" Text="Livraison" />
                                        </StackPanel>
                                    </ListBoxItem>
                                </ListBox>
                                <StackPanel Margin="0,4,4,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedDiningOption}" Value="{x:Static enums:DiningOption.Delivery}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Style="{StaticResource PosFieldLabel}" FontSize="10" Text="Adresse de livraison" Margin="2,0,0,2"/>
                                    <TextBox MinHeight="34" Padding="8,6" FontSize="11" materialDesign:HintAssist.Hint="Ex: 15 Avenue..." AcceptsReturn="True" Style="{StaticResource PosTextBox}" Text="{Binding DeliveryAddress, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--  ────── ROW 1: CART ITEMS LIST ──────  -->
                    <!-- 🚨 FIXED: Compacter les articles -->
                    <ListBox Grid.Row="1" Margin="0" Padding="0" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" ItemsSource="{Binding CartItems}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectedItem="{Binding SelectedCartItem}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="10,2" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="MinHeight" Value="50" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Padding="12,8" Background="{StaticResource BackgroundBrush}" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="10">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                    <Setter TargetName="Bd" Property="Background">
                                                        <Setter.Value>
                                                            <SolidColorBrush Opacity="0.06" Color="{StaticResource PrimaryColor}" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush">
                                                        <Setter.Value>
                                                            <SolidColorBrush Color="{StaticResource BorderColor}" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding Name}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- COLUMN 0: Name & Info -->
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="Bold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,2,0,0" FontFamily="{StaticResource AppFont}" FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                                            <Run Text="{Binding QuantityDisplay, Mode=OneWay}" />
                                            <Run Text=" · Grp " />
                                            <Run Text="{Binding TaxGroupLabel, Mode=OneWay}" />
                                        </TextBlock>
                                        <Border Margin="0,2,0,0" Padding="4,1" HorizontalAlignment="Left" CornerRadius="4" Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border.Background>
                                                <SolidColorBrush Opacity="0.08" Color="{StaticResource ErrorColor}" />
                                            </Border.Background>
                                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10" FontWeight="Bold" Foreground="#DC2626" Text="{Binding DiscountDisplay, Mode=OneWay}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- COLUMN 1: +/- Buttons (More Compact) -->
                                    <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Orientation="Horizontal">
                                        <Button Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0" Command="{Binding DataContext.DecrementQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Cursor="Hand">
                                            <Border Width="36" Height="36" Background="{StaticResource BackgroundBrush}" CornerRadius="8">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Text="-" />
                                            </Border>
                                        </Button>
                                        <TextBox MinWidth="40" Margin="4,0" Padding="0,2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,2" FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="Bold" IsReadOnly="{Binding DataContext.IsNormalized, RelativeSource={RelativeSource AncestorType=UserControl}}" Text="{Binding Quantity, StringFormat=N3, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" />
                                        <Button Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0" Command="{Binding DataContext.IncrementQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Cursor="Hand">
                                            <Border Width="36" Height="36" Background="{StaticResource BackgroundBrush}" CornerRadius="8">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Text="+" />
                                            </Border>
                                        </Button>
                                    </StackPanel>

                                    <!-- COLUMN 2: Total & Actions -->
                                    <StackPanel Grid.Column="2" MinWidth="80" VerticalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding AmountTTC, StringFormat='{}{0:N2}'}" />
                                        <StackPanel Margin="0,4,0,0" HorizontalAlignment="Right" Orientation="Horizontal" Visibility="{Binding DataContext.IsNormalized, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolConverter}}">
                                            <ToggleButton x:Name="NoteToggle" Margin="0,0,4,0" Padding="4" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                <materialDesign:PackIcon Width="14" Height="14" Foreground="{StaticResource TextSecondaryBrush}" Kind="PencilOutline" />
                                            </ToggleButton>
                                            <Popup IsOpen="{Binding IsChecked, ElementName=NoteToggle}" Placement="Bottom" PlacementTarget="{Binding ElementName=NoteToggle}" StaysOpen="False">
                                                <Border Padding="12" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="10" Effect="{StaticResource PopupShadow}">
                                                    <StackPanel>
                                                        <TextBlock Margin="0,0,0,6" FontWeight="Bold" Text="Notes de préparation :" />
                                                        <TextBox MinWidth="200" MinHeight="50" FontSize="12" materialDesign:HintAssist.Hint="Ex: Sans oignons..." AcceptsReturn="True" Style="{StaticResource PosTextBox}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                            <Button Padding="4" Background="Transparent" BorderThickness="0" Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Cursor="Hand">
                                                <materialDesign:PackIcon Width="14" Height="14" Foreground="#EF4444" Kind="TrashCanOutline" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="0,4,0,0" FontFamily="{StaticResource AppFont}" FontSize="11" FontStyle="Italic" Foreground="#D97706" TextWrapping="Wrap" Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Run FontWeight="Bold" Text="Note: " /><Run Text="{Binding Notes}" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!--  ────── ROW 2: CART FOOTER ──────  -->
                    <!-- 🚨 FIXED: Footer compacté -->
                    <DockPanel Grid.Row="2">

                        <Border Margin="16,0,16,8" Padding="12,8" CornerRadius="8" DockPanel.Dock="Bottom" Visibility="{Binding ShowSuccess, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Background>
                                <SolidColorBrush Opacity="0.06" Color="{StaticResource SuccessColor}" />
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource SuccessBrush}" Kind="CheckCircleOutline" />
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11" Foreground="{StaticResource SuccessBrush}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Margin="16,0,16,6" Padding="12,8" CornerRadius="8" DockPanel.Dock="Bottom" Visibility="{Binding ShowError, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Background>
                                <SolidColorBrush Opacity="0.06" Color="{StaticResource ErrorColor}" />
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource ErrorBrush}" Kind="AlertCircleOutline" />
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11" Foreground="{StaticResource ErrorBrush}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <ScrollViewer PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16,8,16,16">
                                <Separator Margin="0,0,0,10" Background="{StaticResource BorderLightBrush}" />

                                <!-- STEP INDICATOR -->
                                <Border Margin="0,0,0,12" Padding="4" Background="#F3F4F6" CornerRadius="10" Visibility="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" MinHeight="30" Background="Transparent" BorderThickness="0" Command="{Binding GoToReviewStepCommand}" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="P" MinHeight="30" Padding="8,0" Background="Transparent" CornerRadius="8">
                                                        <TextBlock x:Name="T" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280" Text="1 · Récapitulatif" TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsReviewStep}" Value="True">
                                                            <Setter TargetName="P" Property="Background" Value="White" />
                                                            <Setter TargetName="T" Property="Foreground" Value="{StaticResource PrimaryDarkBrush}" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Grid.Column="1" MinHeight="30" Background="Transparent" BorderThickness="0" Command="{Binding GoToPaymentStepCommand}" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="P" MinHeight="30" Padding="8,0" Background="Transparent" CornerRadius="8">
                                                        <TextBlock x:Name="T" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280" Text="2 · Paiement" TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsPaymentStep}" Value="True">
                                                            <Setter TargetName="P" Property="Background" Value="White" />
                                                            <Setter TargetName="T" Property="Foreground" Value="{StaticResource PrimaryDarkBrush}" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- STEP 1 — RÉCAPITULATIF -->
                                <StackPanel Visibility="{Binding ShowReviewStep, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid MinHeight="20" Margin="0,0,0,4" Visibility="{Binding HasAnyDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="Sous-total avant remise" />
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="{Binding TotalHTBeforeDiscount, StringFormat='{}{0:N2}'}" TextDecorations="Strikethrough" />
                                    </Grid>
                                    <Grid MinHeight="20" Margin="0,0,0,4" Visibility="{Binding HasAnyDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="#DC2626" Kind="PercentOutline" />
                                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11" Foreground="#DC2626" Text="Remise" />
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="SemiBold" Foreground="#DC2626" Text="{Binding TotalDiscount, StringFormat='-{0:N2}'}" />
                                    </Grid>

                                    <!-- TOTAL -->
                                    <Border MinHeight="44" Margin="0,0,0,4" Padding="14,8" CornerRadius="10">
                                        <Border.Background>
                                            <SolidColorBrush Opacity="0.08" Color="{StaticResource PrimaryColor}" />
                                        </Border.Background>
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Text="{Binding GrandTotalLabel}" />
                                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" Text="TOTAL" />
                                            </StackPanel>
                                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}">
                                                <Run Text="{Binding GrandTotal, StringFormat=N2, Mode=OneWay}" />
                                                <Run FontSize="11" Text=" CDF" />
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <Border MinHeight="36" Margin="0,4,0,4" Padding="12,8" BorderThickness="1" CornerRadius="8">
                                        <Border.Background>
                                            <SolidColorBrush Color="{StaticResource BackgroundColor}" />
                                        </Border.Background>
                                        <Border.BorderBrush>
                                            <SolidColorBrush Color="{StaticResource BorderLightColor}" />
                                        </Border.BorderBrush>
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Kind="SwapHorizontal" />
                                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"><Run Text="{Binding AlternateCurrencyLabel, Mode=OneWay}" /></TextBlock>
                                            </StackPanel>
                                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="Bold">
                                                <Run Text="{Binding TotalInAlternateCurrency, StringFormat=N2, Mode=OneWay}" />
                                                <Run FontSize="9" Text=" " />
                                                <Run FontSize="9" Text="{Binding AlternateCurrencyLabel, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <!-- Review step buttons -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Margin="0,0,8,0" Command="{Binding RequestHoldCommand}" Style="{StaticResource PosHoldBtn}" Visibility="{Binding IsRestaurantMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                            <materialDesign:PackIcon Width="20" Height="20" Foreground="White" Kind="PauseCircleOutline" />
                                        </Button>
                                        <Button Grid.Column="1" Margin="0,0,8,0" Command="{Binding SaveTableOrderCommand}" Style="{StaticResource PosHoldBtn}" Visibility="{Binding IsRestaurantMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <materialDesign:PackIcon Width="20" Height="20" Foreground="White" Kind="SilverwareForkKnife" />
                                        </Button>
                                        <Button Grid.Column="2" HorizontalContentAlignment="Center" Command="{Binding GoToPaymentStepCommand}" Style="{StaticResource PosPrimaryBtn}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="Bold" Foreground="White" Text="PAIEMENT" />
                                                <materialDesign:PackIcon Width="18" Height="18" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="White" Kind="ArrowRight" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <!-- STEP 2 — PAIEMENT -->
                                <StackPanel Visibility="{Binding ShowPaymentStep, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border Margin="0,0,0,10" Padding="16,12" CornerRadius="10" Visibility="{Binding IsHtMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Border.Background>
                                            <SolidColorBrush Opacity="0.06" Color="{StaticResource SuccessColor}" />
                                        </Border.Background>
                                        <Grid MinHeight="32">
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#065F46" Kind="CashMultiple" />
                                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="SemiBold" Foreground="#065F46" Text="À encaisser (TTC)" />
                                            </StackPanel>
                                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="Bold" Foreground="#065F46">
                                                <Run Text="{Binding TotalTTC, StringFormat=N2, Mode=OneWay}" />
                                                <Run FontSize="10" Text=" CDF" />
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <TextBlock Style="{StaticResource PosFieldLabel}" FontSize="11" Text="Canal" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button MinHeight="44" BorderThickness="0" Command="{Binding SelectPaymentChannelCommand}" CommandParameter="{x:Static enums:PaymentChannel.LocalPos}" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="B" MinHeight="44" Padding="10,8" Background="{StaticResource BackgroundBrush}" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="8">
                                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                            <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Kind="CashRegister" />
                                                            <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="Caisse (POS)" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsLocalPos}" Value="True">
                                                            <Setter TargetName="B" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                            <Setter TargetName="B" Property="TextElement.Foreground" Value="White" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Grid.Column="2" MinHeight="44" BorderThickness="0" Command="{Binding SelectPaymentChannelCommand}" CommandParameter="{x:Static enums:PaymentChannel.SunmiTerminal}" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="B" MinHeight="44" Padding="10,8" Background="{StaticResource BackgroundBrush}" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="8">
                                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                            <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Kind="CellphoneNfc" />
                                                            <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="Terminal Sunmi" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSunmiChannel}" Value="True">
                                                            <Setter TargetName="B" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                            <Setter TargetName="B" Property="TextElement.Foreground" Value="White" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>

                                    <StackPanel Margin="0,0,0,10" Visibility="{Binding IsSunmiChannel, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Style="{StaticResource PosFieldLabel}" FontSize="11" Text="Remise au terminal" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button MinHeight="44" BorderThickness="0" Command="{Binding SelectSunmiHandoffCommand}" CommandParameter="{x:Static enums:SunmiHandoff.ShowQr}" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="B" MinHeight="44" Padding="10,8" Background="{StaticResource BackgroundBrush}" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="8">
                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="Afficher QR" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsSunmiQr}" Value="True">
                                                                <Setter TargetName="B" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                                <Setter TargetName="B" Property="TextElement.Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Grid.Column="2" MinHeight="44" BorderThickness="0" Command="{Binding SelectSunmiHandoffCommand}" CommandParameter="{x:Static enums:SunmiHandoff.LanDevice}" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="B" MinHeight="44" Padding="10,8" Background="{StaticResource BackgroundBrush}" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="8">
                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="Terminal LAN" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsSunmiLan}" Value="True">
                                                                <Setter TargetName="B" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                                <Setter TargetName="B" Property="TextElement.Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding IsLocalPos, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Style="{StaticResource PosFieldLabel}" FontSize="11" Text="Mode de paiement" />
                                        <ListBox Margin="0,0,0,8" ItemsSource="{Binding PaymentTypes}" SelectedItem="{Binding SelectedPaymentType}" Style="{StaticResource PosSegment}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="SemiBold" Text="{Binding Converter={StaticResource PaymentTypeLabelConverter}}" />
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <StackPanel Margin="0,2,0,8" Visibility="{Binding IsMobileMoney, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Style="{StaticResource PosFieldLabel}" FontSize="11" Text="Opérateur Mobile Money *" />
                                            <ListBox ItemsSource="{Binding MobileMoneyOperators}" SelectedItem="{Binding SelectedMobileOperator}" Style="{StaticResource PosSegment}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource PosFieldLabel}" FontSize="11" Text="Type de facture" />
                                    <ListBox Margin="0,0,0,10" ItemsSource="{Binding InvoiceTypes}" SelectedItem="{Binding InvoiceType}" Style="{StaticResource PosSegment}" />

                                    <Button Margin="0,0,0,10" HorizontalContentAlignment="Center" Command="{Binding ToggleSplitPaymentCommand}" Style="{StaticResource PosGhostBtn}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="CreditCardOutline" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowSplitPayment}" Value="True">
                                                                <Setter Property="Kind" Value="Close" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Paiement fractionné" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowSplitPayment}" Value="True">
                                                                <Setter Property="Text" Value="Fermer paiement fractionné" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>

                                    <StackPanel Visibility="{Binding ShowSplitPayment, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl ItemsSource="{Binding PaymentItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid MinHeight="34" Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="12" Text="{Binding Label}" />
                                                        <TextBlock Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="SemiBold" Text="{Binding Amount, StringFormat=N2}" />
                                                        <Button Grid.Column="2" Width="30" Height="30" Background="Transparent" BorderThickness="0" Command="{Binding DataContext.RemovePaymentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Cursor="Hand">
                                                            <materialDesign:PackIcon Width="12" Height="12" Foreground="#EF4444" Kind="Close" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid Margin="0,8,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource PosTextBox}" FontSize="12" MinHeight="38" Text="{Binding PaymentAmount}" materialDesign:HintAssist.Hint="Montant..." />
                                            <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding AddPaymentCommand}" Style="{StaticResource PosMiniBtn}" MinHeight="38">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="White" Kind="Plus" />
                                                    <TextBlock FontSize="11" Foreground="White" Text="Ajouter" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <Grid MinHeight="34" Margin="0,0,0,10">
                                            <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="SemiBold" Text="Reste à payer" />
                                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Remaining}" Value="0">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="{Binding Remaining, StringFormat=N2, Mode=OneWay}" />
                                                <Run Text=" CDF" />
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding ShowSplitPayment, Converter={StaticResource InverseBoolConverter}}">
                                        <TextBlock Margin="2,0,0,6" FontFamily="{StaticResource AppFont}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="Montant reçu" />
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox MinHeight="44" Padding="12,10" VerticalContentAlignment="Center" Background="White" FontFamily="{StaticResource AppFont}" FontSize="16" FontWeight="SemiBold" Text="{Binding ReceivedAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PosTextBox}" />
                                            <Button Grid.Column="1" Margin="10,0,0,0" Command="{Binding SetExactAmountCommand}" Style="{StaticResource PosGhostBtn}" MinHeight="44">
                                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11" Text="= Exact" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <Border Margin="0,0,0,10" Padding="16,12" CornerRadius="10" Visibility="{Binding ShowChange, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Border.Background>
                                            <SolidColorBrush Opacity="0.08" Color="{StaticResource WarningColor}" />
                                        </Border.Background>
                                        <Grid MinHeight="32">
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#92400E" Kind="CashRefund" />
                                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="Medium" Foreground="#92400E" Text="Monnaie" />
                                            </StackPanel>
                                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="Bold" Foreground="#92400E">
                                                <Run Text="{Binding ChangeAmount, StringFormat=N2, Mode=OneWay}" />
                                                <Run Text=" CDF" />
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Margin="0,0,10,0" Command="{Binding GoToReviewStepCommand}" Style="{StaticResource PosGhostBtn}">
                                            <materialDesign:PackIcon Width="18" Height="18" Foreground="{StaticResource TextSecondaryBrush}" Kind="ArrowLeft" />
                                        </Button>
                                        <Button Grid.Column="1" HorizontalContentAlignment="Center" Command="{Binding ProcessSaleCommand}" Style="{StaticResource PosProcessBtn}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White" Kind="ShieldLockOutline" />
                                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="Bold" Foreground="White" Text="ENCAISSER" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <!-- ═══════ AFTER NORMALIZATION ═══════ -->
                                <StackPanel Visibility="{Binding IsNormalized, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border Margin="0,0,0,12" Padding="16,12" CornerRadius="10">
                                        <Border.Background>
                                            <SolidColorBrush Opacity="0.05" Color="{StaticResource SuccessColor}" />
                                        </Border.Background>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Text="CODE DEF/DGI" />
                                            <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Text="{Binding CodeDEFDGI}" />
                                        </StackPanel>
                                    </Border>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition MinHeight="24" />
                                            <RowDefinition MinHeight="24" />
                                            <RowDefinition MinHeight="24" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="NIM:" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11" Text="{Binding Nim}" />
                                        <TextBlock Grid.Row="1" Margin="0,0,10,0" VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="Compteurs:" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11" Text="{Binding Counters}" />
                                        <TextBlock Grid.Row="2" Margin="0,0,10,0" VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="Date DEF:" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11" Text="{Binding DeviceDateTime}" />
                                    </Grid>
                                    <Button HorizontalContentAlignment="Center" Command="{Binding NewSaleCommand}" Style="{StaticResource PosPrimaryBtn}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White" Kind="FilePlusOutline" />
                                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="Bold" Foreground="White" Text="NOUVELLE VENTE" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>

            <!--  ══════════════════════════════════════════════════════  -->
            <!--  OVERLAY PANELS  -->
            <!--  ══════════════════════════════════════════════════════  -->

            <!--  CLIENT PANEL ★  -->
            <Border Margin="0" VerticalAlignment="Stretch" Style="{StaticResource PosOverlayCard}" Visibility="{Binding ShowClientPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource OverlayHeader}">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}" Kind="AccountOutline" />
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="16" FontWeight="Bold" Text="Client" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Command="{Binding ToggleClientPanelCommand}" Style="{StaticResource PosCloseBtn}" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,16,20,16">
                            <TextBlock Style="{StaticResource PosFieldLabel}" Text="Rechercher" />
                            <Grid Margin="0,0,0,14">
                                <TextBox x:Name="PosClientSearch" Style="{StaticResource PosTextBox}" Text="{Binding ClientSearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                                <Popup Width="{Binding ActualWidth, ElementName=PosClientSearch}" AllowsTransparency="True" IsOpen="{Binding IsClientSearchOpen, Mode=TwoWay}" Placement="Bottom" PlacementTarget="{Binding ElementName=PosClientSearch}" PopupAnimation="Fade" StaysOpen="False">
                                    <Border MaxHeight="220" Background="White" BorderThickness="1" CornerRadius="0,0,10,10" Effect="{StaticResource PopupShadow}">
                                        <Border.BorderBrush>
                                            <SolidColorBrush Color="{StaticResource BorderLightColor}" />
                                        </Border.BorderBrush>
                                        <ScrollViewer PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding ClientSearchResults}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.SelectClientCommand, RelativeSource={RelativeSource AncestorType=Popup}}" CommandParameter="{Binding}" Style="{StaticResource PopupItemBtn}">
                                                            <StackPanel>
                                                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="Medium" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Margin="0,2,0,0" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}">
                                                                    <Run Text="{Binding Type}" />
                                                                    <Run Text=" · NIF: " />
                                                                    <Run Text="{Binding NIF, TargetNullValue='-'}" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>

                            <Border Margin="0,0,0,16" Padding="12,10" Background="#FEF3C7" CornerRadius="10" Visibility="{Binding HasLoyaltyAccountLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="Bold" Foreground="#D97706" Text="{Binding LoyaltyClientName}" />
                                        <TextBlock Margin="0,2,0,0" FontFamily="{StaticResource AppFont}" FontSize="10" Foreground="#92400E" Text="{Binding LoyaltyBalanceDisplay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="SemiBold" Foreground="#D97706" Text="Utiliser les points" />
                                        <ToggleButton IsChecked="{Binding UseLoyaltyPoints}" IsEnabled="{Binding CanRedeemPoints}" Style="{StaticResource ToggleSwitchStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel Visibility="{Binding IsLoyaltySystemEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource PosFieldLabel}" Text="Programme de Fidélité" />
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox materialDesign:HintAssist.Hint="Scanner la carte..." Style="{StaticResource PosTextBox}" Text="{Binding ScannedLoyaltyCard, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding ProcessLoyaltyScanCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,0" Command="{Binding ProcessLoyaltyScanCommand}" Style="{StaticResource PosGhostBtn}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}" Kind="Magnify" />
                                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Text="Vérifier" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                            <Separator Margin="0,0,0,14" Background="{StaticResource BorderLightBrush}" Visibility="{Binding IsLoyaltySystemEnabled, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <TextBlock Style="{StaticResource PosFieldLabel}" Text="Type client" />
                            <ComboBox Margin="0,0,0,14" ItemsSource="{Binding ClientTypes}" SelectedItem="{Binding SelectedClientType}" Style="{StaticResource PosComboBox}" />

                            <TextBlock Style="{StaticResource PosFieldLabel}" Text="NIF" />
                            <TextBox Margin="0,0,0,14" Style="{StaticResource PosTextBox}" Text="{Binding ClientNIF}" />

                            <TextBlock Style="{StaticResource PosFieldLabel}" Text="Nom / Dénomination" />
                            <TextBox Margin="0,0,0,14" Style="{StaticResource PosTextBox}" Text="{Binding ClientName}" />

                            <TextBlock Style="{StaticResource PosFieldLabel}" Text="Téléphone" />
                            <TextBox Margin="0,0,0,14" Style="{StaticResource PosTextBox}" Text="{Binding ClientPhone}" />

                            <TextBlock Style="{StaticResource PosFieldLabel}" Text="Adresse" />
                            <TextBox Style="{StaticResource PosTextBox}" Text="{Binding ClientAddress}" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="20,14,20,16" BorderThickness="0,1,0,0">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{StaticResource BorderLightColor}" />
                        </Border.BorderBrush>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding SaveClientInlineCommand}" Style="{StaticResource PosSuccessBtn}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#065F46" Kind="ContentSave" />
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#065F46" Text="Enregistrer" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding ClearClientCommand}" Style="{StaticResource PosDangerBtn}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#DC2626" Kind="Close" />
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#DC2626" Text="Vider" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!--  CREDIT NOTE PANEL  -->
            <Border Margin="0" VerticalAlignment="Stretch" Style="{StaticResource PosOverlayCard}" Visibility="{Binding ShowCreditNotePanel, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource OverlayHeader}">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" Kind="FileUndoOutline" />
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Text="Avoir" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Command="{Binding ToggleCreditNotePanelCommand}" Style="{StaticResource PosCloseBtn}" />
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,16,20,20">
                            <TextBlock Style="{StaticResource PosFieldLabel}" Text="Nature" />
                            <ComboBox Margin="0,0,0,14" ItemsSource="{Binding CreditNoteNatures}" SelectedItem="{Binding SelectedCreditNoteNature}" Style="{StaticResource PosComboBox}" />

                            <TextBlock Style="{StaticResource PosFieldLabel}" Text="Code DEF/DGI original" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox FontFamily="Consolas" IsEnabled="{Binding IsRRR, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource PosTextBox}" Text="{Binding OriginalReference, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding LookupOriginalInvoiceCommand}" Style="{StaticResource PosMiniBtn}" Visibility="{Binding RequiresOriginalLookup, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="White" Kind="Magnify" />
                                        <TextBlock FontSize="11" Foreground="White" Text="Charger" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Margin="0,0,0,14" Padding="12,10" CornerRadius="10" Visibility="{Binding IsOriginalLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border.Background>
                                    <SolidColorBrush Opacity="0.06" Color="{StaticResource SuccessColor}" />
                                </Border.Background>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#065F46" Kind="CheckCircleOutline" />
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="Bold" Foreground="#065F46" Text="Facture chargée" />
                                    </StackPanel>
                                    <TextBlock Margin="20,4,0,0" FontFamily="{StaticResource AppFont}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Text="{Binding OriginalInvoiceSummary}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding CreditNoteSelections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border MinHeight="48" Padding="6,10" BorderThickness="0,0,0,1">
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="{StaticResource BorderLightColor}" />
                                            </Border.BorderBrush>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="Medium" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,2,0,0" FontFamily="{StaticResource AppFont}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" Text="{Binding DisplayQuantity}" />
                                                </StackPanel>
                                                <TextBox Grid.Column="2" MinHeight="36" Margin="6,0" Padding="8,4" FontSize="12" Style="{StaticResource PosTextBox}" Text="{Binding SelectedQuantity, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}" />
                                                <TextBlock Grid.Column="3" Margin="4,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding DisplayPrice}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Margin="0,14,0,0" HorizontalContentAlignment="Center" Command="{Binding AddAllSelectedCreditNoteLinesCommand}" Style="{StaticResource PosAccentBtn}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White" Kind="Plus" />
                                    <TextBlock FontSize="12" Foreground="White" Text="Ajouter sélection" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ADVANCE PANEL  -->
            <Border MaxHeight="450" Margin="0" VerticalAlignment="Top" Style="{StaticResource PosOverlayCard}" Visibility="{Binding ShowAdvancePanel, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource OverlayHeader}">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#7C3AED" Kind="CashClock" />
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="16" FontWeight="Bold" Foreground="#7C3AED" Text="Acompte" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Command="{Binding ToggleAdvancePanelCommand}" Style="{StaticResource PosCloseBtn}" />
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,16,20,20">
                            <!-- Montant de l'acompte reçu -->
                            <Border Margin="0,0,0,16" Padding="14,12" Background="#F5F3FF" BorderThickness="1.5" CornerRadius="10">
                                <Border.BorderBrush>
                                    <SolidColorBrush Opacity="0.4" Color="#7C3AED" />
                                </Border.BorderBrush>
                                <StackPanel>
                                    <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="#7C3AED" Kind="CashCheck" />
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="Bold" Foreground="#7C3AED" Text="Montant reçu *" />
                                    </StackPanel>
                                    <TextBox FontSize="16" FontWeight="SemiBold" IsEnabled="{Binding IsNormalized, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource PosTextBox}" Text="{Binding AdvanceAmountInput, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Top" Foreground="#6D28D9" Kind="InformationOutline" />
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="9" Foreground="#6D28D9" Text="Saisir ce que le client verse maintenant (ex: 50000.00)" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource PosFieldLabel}" Text="ID du groupe" />
                            <TextBox Margin="0,0,0,12" FontFamily="Consolas" Style="{StaticResource PosTextBox}" Text="{Binding AdvanceGroupId, UpdateSourceTrigger=PropertyChanged}" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Command="{Binding CreateNewAdvanceGroupCommand}" Style="{StaticResource PosPurpleBtn}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="White" Kind="PlusCircleOutline" />
                                        <TextBlock Foreground="White" Text="Nouveau" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Command="{Binding LoadAdvanceGroupCommand}" Style="{StaticResource PosGhostBtn}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Kind="FolderOpenOutline" />
                                        <TextBlock FontSize="12" Text="Charger" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding PreviousAdvances}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border MinHeight="44" Margin="0,3" Padding="12,10" Background="#F5F3FF" CornerRadius="8">
                                            <Grid>
                                                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="11">
                                                    <Run FontWeight="SemiBold" Text="{Binding InvoiceNumber}" />
                                                    <Run Text=" — " />
                                                    <Run Text="{Binding Date, StringFormat=dd/MM/yyyy}" />
                                                </TextBlock>
                                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="Bold" Foreground="#7C3AED">
                                                    <Run Text="{Binding Amount, StringFormat=N2}" />
                                                    <Run FontSize="9" Text=" CDF" />
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  COMMENT PANEL  -->
            <Border MaxHeight="540" Margin="0" VerticalAlignment="Top" Style="{StaticResource PosOverlayCard}" Visibility="{Binding ShowCommentPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource OverlayHeader}">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}" Kind="CommentTextOutline" />
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="16" FontWeight="Bold" Text="Commentaires" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Command="{Binding ToggleCommentPanelCommand}" Style="{StaticResource PosCloseBtn}" />
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,16,20,20">
                            <TextBlock Margin="2,0,0,6" FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="SemiBold" Text="{Binding CommentALabel}" />
                            <TextBox Margin="0,0,0,14" Style="{StaticResource PosTextBox}" Text="{Binding CommentA, UpdateSourceTrigger=PropertyChanged}" />
                            <Expander Padding="0,6,0,0" FontFamily="{StaticResource AppFont}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Header="Lignes B–H">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Style="{StaticResource PosFieldLabel}" Text="B" />
                                    <TextBox MinHeight="38" Margin="0,0,0,10" Padding="10,6" Style="{StaticResource PosTextBox}" Text="{Binding CommentB}" />
                                    <TextBlock Style="{StaticResource PosFieldLabel}" Text="C" />
                                    <TextBox MinHeight="38" Margin="0,0,0,10" Padding="10,6" Style="{StaticResource PosTextBox}" Text="{Binding CommentC}" />
                                    <TextBlock Style="{StaticResource PosFieldLabel}" Text="D" />
                                    <TextBox MinHeight="38" Margin="0,0,0,10" Padding="10,6" Style="{StaticResource PosTextBox}" Text="{Binding CommentD}" />
                                    <TextBlock Style="{StaticResource PosFieldLabel}" Text="E" />
                                    <TextBox MinHeight="38" Margin="0,0,0,10" Padding="10,6" Style="{StaticResource PosTextBox}" Text="{Binding CommentE}" />
                                    <TextBlock Style="{StaticResource PosFieldLabel}" Text="F" />
                                    <TextBox MinHeight="38" Margin="0,0,0,10" Padding="10,6" Style="{StaticResource PosTextBox}" Text="{Binding CommentF}" />
                                    <TextBlock Style="{StaticResource PosFieldLabel}" Text="G" />
                                    <TextBox MinHeight="38" Margin="0,0,0,10" Padding="10,6" Style="{StaticResource PosTextBox}" Text="{Binding CommentG}" />
                                    <TextBlock Style="{StaticResource PosFieldLabel}" Text="H" />
                                    <TextBox MinHeight="38" Padding="10,6" Style="{StaticResource PosTextBox}" Text="{Binding CommentH}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  PENDING INVOICES PANEL  -->
            <Border Margin="0" VerticalAlignment="Stretch" Style="{StaticResource PosOverlayCard}" Visibility="{Binding ShowPendingPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource OverlayHeader}">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource WarningBrush}" Kind="TimerSandEmpty" />
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="16" FontWeight="Bold" Text="Factures en attente" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Command="{Binding TogglePendingPanelCommand}" Style="{StaticResource PosCloseBtn}" />
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,16,20,20">
                            <Button Margin="0,0,0,14" HorizontalContentAlignment="Center" Command="{Binding CheckPendingInvoicesCommand}" Style="{StaticResource PosMiniBtn}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White" Kind="Refresh" />
                                    <TextBlock FontSize="12" Foreground="White" Text="Vérifier le dispositif" />
                                </StackPanel>
                            </Button>
                            <ItemsControl ItemsSource="{Binding PendingInvoices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border MinHeight="50" Margin="0,3" Padding="14,10" BorderThickness="1" CornerRadius="8">
                                            <Border.Background>
                                                <SolidColorBrush Opacity="0.05" Color="{StaticResource WarningColor}" />
                                            </Border.Background>
                                            <Border.BorderBrush>
                                                <SolidColorBrush Opacity="0.2" Color="{StaticResource WarningColor}" />
                                            </Border.BorderBrush>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Consolas" FontSize="11" FontWeight="SemiBold">
                                                        <Run Text="UID: " /><Run Text="{Binding Uid}" />
                                                    </TextBlock>
                                                    <TextBlock Margin="0,2,0,0" FontFamily="{StaticResource AppFont}" FontSize="9" Foreground="{StaticResource TextMutedBrush}">
                                                        <Run Text="{Binding Date, StringFormat=dd/MM/yyyy}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1" Command="{Binding DataContext.CancelPendingInvoiceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Uid}" Style="{StaticResource PosDangerBtn}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="#DC2626" Kind="Close" />
                                                        <TextBlock FontSize="11" Foreground="#DC2626" Text="Annuler" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox FontFamily="Consolas" Style="{StaticResource PosTextBox}" Text="{Binding CancelUid, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="UID manuel..." />
                                <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding CancelPendingInvoiceCommand}" Style="{StaticResource PosAccentBtn}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="White" Kind="TrashCanOutline" />
                                        <TextBlock FontSize="12" Foreground="White" Text="Annuler" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border Margin="0,10,0,0" Padding="12,8" CornerRadius="8" Visibility="{Binding ShowPendingSuccess, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border.Background>
                                    <SolidColorBrush Opacity="0.06" Color="{StaticResource SuccessColor}" />
                                </Border.Background>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource SuccessBrush}" Kind="CheckCircleOutline" />
                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10" Foreground="{StaticResource SuccessBrush}" Text="{Binding PendingStatusMessage}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,10,0,0" Padding="12,8" CornerRadius="8" Visibility="{Binding ShowPendingError, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border.Background>
                                    <SolidColorBrush Opacity="0.06" Color="{StaticResource ErrorColor}" />
                                </Border.Background>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource ErrorBrush}" Kind="AlertCircleOutline" />
                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10" Foreground="{StaticResource ErrorBrush}" Text="{Binding PendingStatusMessage}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  HELD PANEL  -->
            <Border Margin="0" VerticalAlignment="Stretch" Style="{StaticResource PosOverlayCard}" Visibility="{Binding ShowHeldPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel>
                    <Border Padding="20,16" CornerRadius="16,16,0,0" DockPanel.Dock="Top">
                        <Border.Background>
                            <SolidColorBrush Opacity="0.1" Color="{StaticResource WarningColor}" />
                        </Border.Background>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#92400E" Kind="PauseCircleOutline" />
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="Bold" Foreground="#92400E" Text="En attente" />
                                <Border Margin="10,0,0,0" Padding="8,2" VerticalAlignment="Center" Background="#92400E" CornerRadius="8">
                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="Bold" Foreground="White" Text="{Binding HeldCount}" />
                                </Border>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Command="{Binding ToggleHeldPanelCommand}" Style="{StaticResource PosCloseBtn}" />
                        </Grid>
                    </Border>
                    <ScrollViewer Padding="12,10" PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding HeldTransactions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border MinHeight="60" Margin="4" Padding="14,12" BorderThickness="1" CornerRadius="10">
                                        <Border.Background>
                                            <SolidColorBrush Opacity="0.04" Color="{StaticResource WarningColor}" />
                                        </Border.Background>
                                        <Border.BorderBrush>
                                            <SolidColorBrush Opacity="0.2" Color="{StaticResource WarningColor}" />
                                        </Border.BorderBrush>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock MaxWidth="180" FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="SemiBold" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,2,0,0" FontFamily="{StaticResource AppFont}" FontSize="10" Foreground="{StaticResource TextMutedBrush}">
                                                    <Run Text="{Binding ItemCount, Mode=OneWay}" />
                                                    <Run Text=" art. · " />
                                                    <Run Text="{Binding TotalDisplay, Mode=OneWay}" />
                                                    <Run Text=" CDF" />
                                                </TextBlock>
                                                <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                                    <materialDesign:PackIcon Width="10" Height="10" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Kind="ClockOutline" />
                                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="9" Foreground="{StaticResource TextMutedBrush}">
                                                        <Run Text="{Binding TimeDisplay, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1" Width="40" Height="40" Margin="8,0,6,0" VerticalAlignment="Center" Command="{Binding DataContext.RecallHeldSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bg" Width="40" Height="40" CornerRadius="10">
                                                                        <Border.Background>
                                                                            <SolidColorBrush x:Name="BgBr" Color="#10B981" />
                                                                        </Border.Background>
                                                                        <materialDesign:PackIcon Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Kind="Play" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <EventTrigger RoutedEvent="MouseEnter">
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <ColorAnimation Storyboard.TargetName="BgBr" Storyboard.TargetProperty="Color" To="#059669" Duration="0:0:0.15" />
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </EventTrigger>
                                                                        <EventTrigger RoutedEvent="MouseLeave">
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <ColorAnimation Storyboard.TargetName="BgBr" Storyboard.TargetProperty="Color" To="#10B981" Duration="0:0:0.18" />
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </EventTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Grid.Column="2" Width="36" Height="36" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Command="{Binding DataContext.DeleteHeldSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Cursor="Hand">
                                                <materialDesign:PackIcon Width="14" Height="14" Foreground="{StaticResource TextMutedBrush}" Kind="TrashCanOutline" Opacity="0.6" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!--  HOLD DIALOG  -->
            <Grid Visibility="{Binding ShowHoldDialog, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="#80000000" CornerRadius="14" />
                <Border Margin="24" Padding="24" VerticalAlignment="Center" Background="{StaticResource CardBrush}" CornerRadius="14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" Opacity="0.2" ShadowDepth="4" Color="#0D2B3E" />
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                            <materialDesign:PackIcon Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#D97706" Kind="PauseCircleOutline" />
                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="16" FontWeight="Bold" Text="Mettre en attente" />
                        </StackPanel>
                        <TextBlock Margin="2,0,0,6" Style="{StaticResource PosFieldLabel}" Text="Raison (optionnel) :" />
                        <TextBox Margin="0,0,0,20" MaxLength="100" Style="{StaticResource PosTextBox}" Text="{Binding HoldReason, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Padding="14,12" Command="{Binding CancelHoldCommand}" Style="{StaticResource PosGhostBtn}">
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="13" Text="Annuler" />
                            </Button>
                            <Button Grid.Column="2" Command="{Binding HoldCurrentSaleCommand}" Style="{StaticResource PosHoldBtn}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White" Kind="PauseCircleOutline" />
                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="Bold" Foreground="White" Text="Confirmer" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>