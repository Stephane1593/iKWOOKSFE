                                        <Border CornerRadius="10" Padding="16,14" Margin="0,4" BorderThickness="1" MinHeight="56">
                                            <Border.Background>
                                                <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.05"/>
                                            </Border.Background>
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.2"/>
                                            </Border.BorderBrush>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
