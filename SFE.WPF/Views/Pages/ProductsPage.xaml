<UserControl x:Class="SFE.WPF.Views.Pages.ProductsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>

        <!-- ── Thin round scrollbar ── -->
        <Style x:Key="SlimScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="3" Background="{StaticResource BorderBrush}"
                                Opacity="0.45" Margin="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimVerticalScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border Background="Transparent" CornerRadius="3"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SlimScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="PanningMode" Value="VerticalOnly"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter Margin="0"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       HorizontalAlignment="Right"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Style="{StaticResource SlimVerticalScrollBar}"
                                       Margin="0,4,1,4"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Form label (local override for tighter spacing) ── -->
        <Style x:Key="PanelLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- ── Section divider ── -->
        <Style x:Key="SectionDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Margin" Value="0,20,0,20"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- LEFT PANEL — Product list                                  -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <DockPanel Grid.Column="0" Margin="28,24,14,24">

            <!-- ── HEADER CARD ── -->
            <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="10" Padding="10" Margin="0,0,14,0"
                                VerticalAlignment="Center">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.08"/>
                            </Border.Background>
                            <materialDesign:PackIcon Kind="PackageVariantClosed" Width="22" Height="22"
                                                     Foreground="{StaticResource PrimaryBrush}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Catalogue Produits" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0">
                                <Run Text="{Binding ProductCount, Mode=OneWay}"/>
                                <Run Text=" produit(s)"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <!-- Search bar -->
                    <Border Grid.Column="1" Background="#F3F4F6" CornerRadius="10"
                            Margin="20,0,12,0" Padding="14,0" MinHeight="42">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                     FontFamily="{StaticResource AppFont}" FontSize="13"
                                     Background="Transparent" BorderThickness="0"
                                     VerticalAlignment="Center" Padding="0,8"/>
                        </Grid>
                    </Border>

                    <!-- Category filter -->
                    <ComboBox Grid.Column="2" ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategoryFilter}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource ModernComboBoxStyle}"
                              FontFamily="{StaticResource AppFont}" FontSize="13"
                              Padding="10,8" MinWidth="150" MinHeight="42" Margin="0,0,10,0"
                              ToolTip="Filtrer par catégorie"/>

                    <!-- Add button -->
                    <Button Grid.Column="3" Command="{Binding StartNewProductCommand}"
                            Background="{StaticResource PrimaryBrush}" Foreground="White"
                            FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"
                            Padding="18,10" BorderThickness="0" Cursor="Hand" MinHeight="44">
                        <Button.Effect>
                            <DropShadowEffect Color="{StaticResource PrimaryColor}"
                                              BlurRadius="12" ShadowDepth="2" Opacity="0.18"/>
                        </Button.Effect>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Nouveau produit" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ── STATUS BANNERS ── -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,10" CornerRadius="8" Padding="14,10"
                    Visibility="{Binding ShowSuccess, Converter={StaticResource BoolToVisibilityConverter}}"
                    BorderThickness="1">
                <Border.Background>
                    <SolidColorBrush Color="{StaticResource SuccessColor}" Opacity="0.06"/>
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Color="{StaticResource SuccessColor}" Opacity="0.2"/>
                </Border.BorderBrush>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CheckCircleOutline" Width="18" Height="18"
                                             Foreground="{StaticResource SuccessBrush}"
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                               FontFamily="{StaticResource AppFont}" FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Top" Margin="0,0,0,10" CornerRadius="8" Padding="14,10"
                    Visibility="{Binding ShowError, Converter={StaticResource BoolToVisibilityConverter}}"
                    BorderThickness="1">
                <Border.Background>
                    <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.06"/>
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.2"/>
                </Border.BorderBrush>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="18" Height="18"
                                             Foreground="{StaticResource ErrorBrush}"
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource ErrorBrush}"
                               FontFamily="{StaticResource AppFont}" FontSize="13"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════ -->
            <!-- PRODUCT GRID (fills remaining space)                   -->
            <!-- ══════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <!-- Empty State -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="0,40">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProductCount}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="72" Height="72" CornerRadius="36"
                                HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.06"/>
                            </Border.Background>
                            <materialDesign:PackIcon Kind="PackageVariantClosed"
                                                     Width="32" Height="32"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource TextMutedBrush}"/>
                        </Border>
                        <TextBlock Text="Aucun produit trouvé"
                                   FontFamily="{StaticResource AppFont}" FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Ajoutez un produit ou modifiez vos filtres"
                                   FontFamily="{StaticResource AppFont}" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- DataGrid -->
                    <DataGrid ItemsSource="{Binding Products}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="True"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              Background="Transparent"
                              FontFamily="{StaticResource AppFont}" FontSize="12"
                              RowHeight="54"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              SelectedItem="{Binding SelectedProduct}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              EnableRowVirtualization="True">

                        <!-- ── Column Header Style ── -->
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="8,12"/>
                                <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <!-- ── Row Style ── -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EFF6FF"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F9FAFB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <!-- ── Cell Style ── -->
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>

                            <!-- ★ FAVORITE -->
                            <DataGridTemplateColumn Header="" Width="38" CanUserSort="False"
                                                    CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Background="Transparent" BorderThickness="0"
                                                Cursor="Hand" HorizontalAlignment="Center"
                                                MinWidth="34" MinHeight="34"
                                                Command="{Binding DataContext.ToggleFavoriteCommand,
                                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Favori">
                                            <materialDesign:PackIcon Width="17" Height="17">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="StarOutline"/>
                                                        <Setter Property="Foreground" Value="#D1D5DB"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                <Setter Property="Kind" Value="Star"/>
                                                                <Setter Property="Foreground" Value="#F59E0B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- CODE -->
                            <DataGridTemplateColumn Header="Code" Width="90"
                                                    SortMemberPath="Code">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Code}"
                                                   FontFamily="Consolas" FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Padding="8,0,4,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- DÉSIGNATION (Name + Description) -->
                            <DataGridTemplateColumn Header="Désignation" Width="*"
                                                    SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="8,0,4,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="10.5"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="16">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Description}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- CATÉGORIE -->
                            <DataGridTemplateColumn Header="Catégorie" Width="110"
                                                    SortMemberPath="Category.Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,4"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left" Margin="4,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.05"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Category}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontFamily="{StaticResource AppFont}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} {1}">
                                                        <Binding Path="Category.Icon"/>
                                                        <Binding Path="Category.Name"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- TAX GROUP (color-coded badge) -->
                            <DataGridTemplateColumn Header="Grp" Width="44"
                                                    SortMemberPath="TaxGroup">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"
                                           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="4,12"/>
                                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Width="28" Height="28"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <SolidColorBrush Color="#6366F1" Opacity="0.08"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TaxGroup}" Value="A">
                                                            <Setter Property="Background">
                                                                <Setter.Value>
                                                                    <SolidColorBrush Color="#10B981" Opacity="0.10"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TaxGroup}" Value="C">
                                                            <Setter Property="Background">
                                                                <Setter.Value>
                                                                    <SolidColorBrush Color="#F59E0B" Opacity="0.10"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TaxGroup}" Value="D">
                                                            <Setter Property="Background">
                                                                <Setter.Value>
                                                                    <SolidColorBrush Color="#3B82F6" Opacity="0.10"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding TaxGroup}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="12" FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#6366F1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TaxGroup}" Value="A">
                                                                <Setter Property="Foreground" Value="#10B981"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TaxGroup}" Value="C">
                                                                <Setter Property="Foreground" Value="#D97706"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TaxGroup}" Value="D">
                                                                <Setter Property="Foreground" Value="#3B82F6"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- HT CDF -->
                            <DataGridTextColumn Header="HT CDF"
                                                Binding="{Binding UnitPriceHtCdf, StringFormat=N0}"
                                                Width="85"
                                                SortMemberPath="UnitPriceHtCdf">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"
                                           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="8,12"/>
                                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Setter Property="Padding" Value="0,0,8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- TTC CDF (primary, bold) -->
                            <DataGridTextColumn Header="TTC CDF"
                                                Binding="{Binding UnitPriceTtcCdf, StringFormat=N0}"
                                                Width="95"
                                                SortMemberPath="UnitPriceTtcCdf">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"
                                           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="8,12"/>
                                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="FontSize" Value="12.5"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="Padding" Value="0,0,8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- USD (stacked HT/TTC) -->
                            <DataGridTemplateColumn Header="USD" Width="90"
                                                    SortMemberPath="UnitPriceHtUsd">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"
                                           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="8,12"/>
                                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,0,8,0">
                                            <TextBlock FontFamily="Consolas" FontSize="11"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{StaticResource TextSecondaryBrush}">
                                                <Run Text="{Binding UnitPriceHtUsd, StringFormat=N2, Mode=OneWay}"/>
                                                <Run Text=" HT" FontSize="8" FontFamily="{StaticResource AppFont}"
                                                     FontWeight="Bold"
                                                     Foreground="{StaticResource TextMutedBrush}"/>
                                            </TextBlock>
                                            <TextBlock FontFamily="Consolas" FontSize="10.5"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{StaticResource TextMutedBrush}">
                                                <Run Text="{Binding UnitPriceTtcUsd, StringFormat=N2, Mode=OneWay}"/>
                                                <Run Text=" TTC" FontSize="8" FontFamily="{StaticResource AppFont}"
                                                     FontWeight="Bold"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- SPECIFIC TAX -->
                            <DataGridTemplateColumn Header="Taxe Spéc." Width="82"
                                                    CanUserSort="False">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"
                                           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="4,12"/>
                                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSpecificTax}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Border CornerRadius="5" Padding="6,2"
                                                    HorizontalAlignment="Center">
                                                <Border.Background>
                                                    <SolidColorBrush Color="#F59E0B" Opacity="0.10"/>
                                                </Border.Background>
                                                <TextBlock Text="{Binding SpecificTaxDisplay}"
                                                           FontFamily="Consolas" FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#D97706"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding TaxSpecificModeShort}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="9"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- DISCOUNT -->
                            <DataGridTemplateColumn Header="Remise" Width="72"
                                                    CanUserSort="False">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"
                                           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="4,12"/>
                                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDefaultDiscount}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border CornerRadius="5" Padding="6,3">
                                                <Border.Background>
                                                    <SolidColorBrush Color="#8B5CF6" Opacity="0.08"/>
                                                </Border.Background>
                                                <TextBlock Text="{Binding DefaultDiscountDisplay}"
                                                           FontFamily="Consolas" FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#7C3AED"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- UNIT -->
                            <DataGridTemplateColumn Header="Unité" Width="55"
                                                    SortMemberPath="Unit">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"
                                           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="4,12"/>
                                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="5" Padding="6,3"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#F1F5F9">
                                            <TextBlock Text="{Binding Unit}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- STOCK (with low-stock indicator) -->
                            <DataGridTemplateColumn Header="Stock" Width="68"
                                                    SortMemberPath="StockQuantity">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"
                                           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="8,12"/>
                                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,0,8,0">
                                            <TextBlock Text="{Binding StockQuantity, StringFormat=N0}"
                                                       FontFamily="Consolas" FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource TextPrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- min level -->
                                            <TextBlock HorizontalAlignment="Right"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="9"
                                                       Foreground="{StaticResource TextMutedBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TrackStock}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="min:"/>
                                                <Run Text="{Binding MinStockLevel, StringFormat=N0, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ACTIONS -->
                            <DataGridTemplateColumn Header="" Width="86"
                                                    CanUserSort="False" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <!-- Edit -->
                                            <Button Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" ToolTip="Modifier"
                                                    MinWidth="36" MinHeight="36"
                                                    Command="{Binding DataContext.StartEditProductCommand,
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="PencilOutline"
                                                                         Width="16" Height="16"
                                                                         Foreground="{StaticResource PrimaryBrush}"/>
                                            </Button>
                                            <!-- Delete -->
                                            <Button Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" ToolTip="Supprimer"
                                                    MinWidth="36" MinHeight="36"
                                                    Command="{Binding DataContext.DeleteProductCommand,
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="TrashCanOutline"
                                                                         Width="16" Height="16"
                                                                         Foreground="{StaticResource TextMutedBrush}"
                                                                         Opacity="0.7"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </DockPanel>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- RIGHT PANEL — Edit form                                    -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="1" Width="430" Margin="0,24,28,24"
                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Style="{StaticResource CardStyle}" Padding="0">
                <ScrollViewer Style="{StaticResource PanelScrollViewer}">
                    <StackPanel Margin="26,24,26,24">

                        <!-- ── TITLE BAR ── -->
                        <Grid Margin="0,0,0,22">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border CornerRadius="8" Padding="8" Margin="0,0,12,0">
                                    <Border.Background>
                                        <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.08"/>
                                    </Border.Background>
                                    <materialDesign:PackIcon Kind="PencilBoxOutline" Width="20" Height="20"
                                                             Foreground="{StaticResource PrimaryBrush}"/>
                                </Border>
                                <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitleStyle}"
                                           Margin="0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" MinWidth="40" MinHeight="40"
                                    Command="{Binding CancelEditCommand}">
                                <materialDesign:PackIcon Kind="Close" Width="20" Height="20"
                                                         Foreground="{StaticResource TextMutedBrush}"/>
                            </Button>
                        </Grid>

                        <!-- ═══════════════════════════════════ -->
                        <!-- SECTION : IDENTITÉ                   -->
                        <!-- ═══════════════════════════════════ -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border CornerRadius="6" Padding="5" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Border.Background>
                                    <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.07"/>
                                </Border.Background>
                                <materialDesign:PackIcon Kind="TagOutline" Width="14" Height="14"
                                                         Foreground="{StaticResource PrimaryBrush}"/>
                            </Border>
                            <TextBlock Text="IDENTITÉ PRODUIT" Style="{StaticResource PanelLabel}"
                                       VerticalAlignment="Center" Margin="0"/>
                        </StackPanel>

                        <!-- ── CODE (auto-generated) + BARCODE ── -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="CODE PRODUIT" Style="{StaticResource PanelLabel}"/>
                                <Grid>
                                    <TextBox Text="{Binding EditCode, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             MinHeight="42"
                                             ToolTip="Auto-généré à la sélection de catégorie — modifiable"/>
                                    <!-- Small auto-badge -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Margin="0,0,8,0" CornerRadius="4" Padding="5,2"
                                            Visibility="{Binding IsNewProduct, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Border.Background>
                                            <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.08"/>
                                        </Border.Background>
                                        <TextBlock Text="AUTO" FontFamily="{StaticResource AppFont}"
                                                   FontSize="9" FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}"/>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="CODE-BARRES" Style="{StaticResource PanelLabel}"/>
                                <TextBox Text="{Binding EditBarcode, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         MinHeight="42"/>
                            </StackPanel>
                        </Grid>

                        <!-- Name -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="DÉSIGNATION *" Style="{StaticResource PanelLabel}"/>
                            <TextBox Text="{Binding EditName}" FontFamily="{StaticResource AppFont}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     FontSize="15" FontWeight="SemiBold" MinHeight="44"/>
                        </StackPanel>

                        <!-- Description -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="DESCRIPTION" Style="{StaticResource PanelLabel}"/>
                            <TextBox Text="{Binding EditDescription}" FontFamily="{StaticResource AppFont}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"/>
                        </StackPanel>

                        <!-- Category -->
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="CATÉGORIE" Style="{StaticResource PanelLabel}"/>
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding EditCategory}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      MinHeight="42"/>
                        </StackPanel>

                        <Border Style="{StaticResource SectionDivider}"/>

                        <!-- ═══════════════════════════════════ -->
                        <!-- SECTION : FISCALITÉ                  -->
                        <!-- ═══════════════════════════════════ -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border CornerRadius="6" Padding="5" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Border.Background>
                                    <SolidColorBrush Color="#9333EA" Opacity="0.08"/>
                                </Border.Background>
                                <materialDesign:PackIcon Kind="ReceiptTextOutline" Width="14" Height="14"
                                                         Foreground="#9333EA"/>
                            </Border>
                            <TextBlock Text="FISCALITÉ" Style="{StaticResource PanelLabel}"
                                       VerticalAlignment="Center" Margin="0"/>
                        </StackPanel>

                        <!-- Item type + Tax group -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="TYPE ARTICLE" Style="{StaticResource PanelLabel}"/>
                                <ComboBox ItemsSource="{Binding ItemTypes}"
                                          SelectedItem="{Binding EditItemType}"
                                          Style="{StaticResource ModernComboBoxStyle}" MinHeight="42"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="GROUPE TVA" Style="{StaticResource PanelLabel}"/>
                                <ComboBox ItemsSource="{Binding TaxGroups}"
                                          SelectedItem="{Binding EditTaxGroup}"
                                          Style="{StaticResource ModernComboBoxStyle}" MinHeight="42"/>
                            </StackPanel>
                        </Grid>

                        <!-- Active tax rate info -->
                        <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,14"
                                Visibility="{Binding ActiveTaxRateDisplay, Converter={StaticResource StringToVisibilityConverter}}"
                                BorderThickness="1">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.04"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.15"/>
                            </Border.BorderBrush>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="InformationOutline" Width="16" Height="16"
                                                         Foreground="{StaticResource PrimaryBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding ActiveTaxRateDisplay}"
                                           FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="#1E40AF" TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Specific tax sub-section -->
                        <TextBlock Text="TAXE SPÉCIFIQUE" Style="{StaticResource PanelLabel}"
                                   FontWeight="Bold" Margin="0,0,0,8"/>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="TYPE DE TAXE" Style="{StaticResource PanelLabel}"/>
                            <ComboBox ItemsSource="{Binding SpecificTaxTypes}"
                                      SelectedItem="{Binding EditSpecificTaxType}"
                                      Style="{StaticResource ModernComboBoxStyle}" MinHeight="42"/>
                        </StackPanel>

                        <!-- Value + Mode (when type ≠ None) -->
                        <Grid Margin="0,0,0,12"
                              Visibility="{Binding ShowSpecificTaxFields, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock >
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource PanelLabel}">
                                            <Setter Property="Text" Value="MONTANT FIXE / UNITÉ"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EditSpecificTaxType}" Value="Percentage">
                                                    <Setter Property="Text" Value="TAUX (%)"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Text="{Binding EditSpecificTaxValue, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}" MinHeight="42">
                                    <TextBox.ToolTip>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Ex : 230 (montant fixe par unité vendue)"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EditSpecificTaxType}" Value="Percentage">
                                                            <Setter Property="Text" Value="Ex : 10 (pour 10 % du montant HT)"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </TextBox.ToolTip>
                                </TextBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="MODE D'APPLICATION" Style="{StaticResource PanelLabel}"/>
                                <ComboBox ItemsSource="{Binding TaxSpecificModes}"
                                          SelectedItem="{Binding EditTaxSpecificMode}"
                                          Style="{StaticResource ModernComboBoxStyle}" MinHeight="42"/>
                            </StackPanel>
                        </Grid>

                        <!-- Info mode T.S. -->
                        <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,10"
                                BorderThickness="1"
                                Visibility="{Binding ShowSpecificTaxFields, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.05"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.18"/>
                            </Border.BorderBrush>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="16" Height="16"
                                                         VerticalAlignment="Center" Margin="0,0,8,0">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="FlashOutline"/>
                                            <Setter Property="Foreground" Value="#92400E"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EditTaxSpecificMode}" Value="OnTotal">
                                                    <Setter Property="Kind" Value="ChartBoxOutline"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="#92400E" TextWrapping="Wrap"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text"
                                                    Value="Par article : T.S. calculée sur chaque ligne individuellement."/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EditTaxSpecificMode}" Value="OnTotal">
                                                    <Setter Property="Text"
                                                            Value="Sur le total : T.S. différée, calculée une seule fois sur le sous-total regroupé."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Info type T.S. -->
                        <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,4"
                                BorderThickness="1"
                                Visibility="{Binding ShowSpecificTaxFields, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource SuccessColor}" Opacity="0.04"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource SuccessColor}" Opacity="0.15"/>
                            </Border.BorderBrush>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="16" Height="16"
                                                         VerticalAlignment="Center" Margin="0,0,8,0">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="PackageVariantClosed"/>
                                            <Setter Property="Foreground" Value="#166534"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EditSpecificTaxType}" Value="Percentage">
                                                    <Setter Property="Kind" Value="Percent"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="#166534" TextWrapping="Wrap"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text"
                                                    Value="Montant fixe par unité vendue (ex : 230 CDF × quantité)."/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EditSpecificTaxType}" Value="Percentage">
                                                    <Setter Property="Text"
                                                            Value="Pourcentage appliqué sur le montant HT (ex : 10 % du HT)."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionDivider}"/>

                        <!-- ═══════════════════════════════════════════ -->
                        <!-- SECTION : TARIFICATION MULTI-DEVISE         -->
                        <!-- ═══════════════════════════════════════════ -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,16">
                            <Border CornerRadius="6" Padding="5" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Border.Background>
                                    <SolidColorBrush Color="#059669" Opacity="0.08"/>
                                </Border.Background>
                                <materialDesign:PackIcon Kind="CurrencyUsd" Width="14" Height="14"
                                                         Foreground="#059669"/>
                            </Border>
                            <TextBlock Text="TARIFICATION MULTI-DEVISE" Style="{StaticResource PanelLabel}"
                                       VerticalAlignment="Center" Margin="0"/>
                        </StackPanel>

                        <!-- ★ DUAL PRICE INPUTS: HT + TTC side-by-side ★ -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Prix unitaire HT (CDF) -->
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource PanelLabel}">
                                    <Run Text="PRIX UNITAIRE HT (CDF)"/>
                                    <Run Text=" *" Foreground="{StaticResource WarningBrush}"/>
                                </TextBlock>
                                <Border CornerRadius="10" BorderThickness="2" MinHeight="52">
                                    <Border.BorderBrush>
                                        <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.6"/>
                                    </Border.BorderBrush>
                                    <Border.Background>
                                        <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.02"/>
                                    </Border.Background>
                                    <TextBox Text="{Binding EditPriceHtInput, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{StaticResource AppFont}" FontSize="20" FontWeight="Bold"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             Background="Transparent" BorderThickness="0"
                                             VerticalContentAlignment="Center" Padding="14,0"
                                             MinHeight="50"
                                             ToolTip="Saisissez le prix HT — le TTC se calcule automatiquement"/>
                                </Border>
                            </StackPanel>

                            <!-- Prix unitaire TTC (CDF) -->
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource PanelLabel}">
                                    <Run Text="PRIX UNITAIRE TTC (CDF)"/>
                                    <Run Text=" *" Foreground="{StaticResource WarningBrush}"/>
                                </TextBlock>
                                <Border CornerRadius="10" BorderThickness="2" MinHeight="52"
