<UserControl x:Class="SFE.WPF.Views.Pages.ProductsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- PANNEAU PRINCIPAL : Liste des produits                     -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <DockPanel Grid.Column="0" Margin="24,20,12,20">

            <!-- HEADER -->
            <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Catalogue Produits" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0">
                            <Run Text="{Binding ProductCount, Mode=OneWay}"/>
                            <Run Text=" produit(s)"/>
                        </TextBlock>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#F3F4F6" CornerRadius="8"
                            Margin="20,0,12,0" Padding="12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                     FontFamily="{StaticResource AppFont}" FontSize="13"
                                     Background="Transparent" BorderThickness="0"
                                     VerticalAlignment="Center" Padding="0,8"/>
                        </Grid>
                    </Border>

                    <ComboBox Grid.Column="2" ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategoryFilter}"
                              DisplayMemberPath="Name"
                              FontFamily="{StaticResource AppFont}" FontSize="13"
                              Padding="8,6" MinWidth="140" Margin="0,0,8,0"
                              ToolTip="Filtrer par catégorie"/>

                    <Button Grid.Column="3" Command="{Binding StartNewProductCommand}"
                            Background="{StaticResource PrimaryBrush}" Foreground="White"
                            FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"
                            Padding="16,8" BorderThickness="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="＋" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Nouveau produit" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- STATUS -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,8" CornerRadius="6" Padding="12,8"
                    Visibility="{Binding ShowSuccess, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#ECFDF5">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                           FontFamily="{StaticResource AppFont}" FontSize="13"/>
            </Border>
            <Border DockPanel.Dock="Top" Margin="0,0,0,8" CornerRadius="6" Padding="12,8"
                    Visibility="{Binding ShowError, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#FEF2F2">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource ErrorBrush}"
                           FontFamily="{StaticResource AppFont}" FontSize="13"/>
            </Border>

            <!-- ══════ GRILLE PRODUITS (ENRICHIE) ══════ -->
            <Border Style="{StaticResource CardStyle}" Padding="0">
                <DataGrid ItemsSource="{Binding Products}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" BorderThickness="0"
                          FontFamily="{StaticResource AppFont}" FontSize="12"
                          RowHeight="48" SelectionMode="Single"
                          SelectedItem="{Binding SelectedProduct}">

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EFF6FF"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F9FAFB"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <!-- ★ Favori -->
                        <DataGridTemplateColumn Header="★" Width="35">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding IsFavorite, Converter={StaticResource BoolToStarConverter}}"
                                            FontSize="14" Background="Transparent" BorderThickness="0"
                                            Cursor="Hand" HorizontalAlignment="Center"
                                            Command="{Binding DataContext.ToggleFavoriteCommand,
                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Code -->
                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="75">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Désignation -->
                        <DataGridTextColumn Header="Désignation" Binding="{Binding Name}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Catégorie -->
                        <DataGridTextColumn Header="Cat." Binding="{Binding Category.Name}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Groupe TVA -->
                        <DataGridTextColumn Header="Grp" Binding="{Binding TaxGroup}" Width="42">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- HT CDF -->
                        <DataGridTextColumn Header="HT CDF" Binding="{Binding UnitPriceHtCdf, StringFormat=N0}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- TTC CDF -->
                        <DataGridTextColumn Header="TTC CDF" Binding="{Binding UnitPriceTtcCdf, StringFormat=N0}" Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- USD (HT + TTC empilés) -->
                        <DataGridTemplateColumn Header="USD" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11"
                                                   HorizontalAlignment="Right">
                                            <Run Text="{Binding UnitPriceHtUsd, StringFormat=N2, Mode=OneWay}"/>
                                            <Run Text=" HT" FontSize="8" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </TextBlock>
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="{Binding UnitPriceTtcUsd, StringFormat=N2, Mode=OneWay}"/>
                                            <Run Text=" TTC" FontSize="8"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Taxe Spécifique (affichage typé + mode) -->
                        <DataGridTemplateColumn Header="T.S." Width="78">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center"
                                                Visibility="{Binding HasSpecificTax, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding SpecificTaxDisplay}"
                                                   FontFamily="{StaticResource AppFont}" FontSize="11"
                                                   HorizontalAlignment="Center" FontWeight="Medium"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding TaxSpecificModeShort}"
                                                   FontFamily="{StaticResource AppFont}" FontSize="9"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Remise par défaut -->
                        <DataGridTemplateColumn Header="Remise" Width="65">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding HasDefaultDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Border Background="#FEE2E2" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding DefaultDiscountDisplay}"
                                                       FontFamily="{StaticResource AppFont}" FontSize="10"
                                                       Foreground="#DC2626" FontWeight="SemiBold"/>
                                        </Border>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Unité -->
                        <DataGridTextColumn Header="Unité" Binding="{Binding Unit}" Width="45">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Stock -->
                        <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity, StringFormat=N0}" Width="55">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Button Content="✏️" FontSize="13" Background="Transparent"
                                                BorderThickness="0" Cursor="Hand" Margin="0,0,4,0"
                                                ToolTip="Modifier"
                                                Command="{Binding DataContext.StartEditProductCommand,
                                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="🗑️" FontSize="13" Background="Transparent"
                                                BorderThickness="0" Cursor="Hand"
                                                ToolTip="Supprimer"
                                                Command="{Binding DataContext.DeleteProductCommand,
                                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- PANNEAU DROIT : Formulaire d'édition                       -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="1" Width="400" Margin="0,20,24,20"
                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- ── TITRE ── -->
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    FontSize="16" Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Foreground="{StaticResource TextSecondaryBrush}"
                                    Command="{Binding CancelEditCommand}"/>
                        </Grid>

                        <!-- ── CODE + CODE-BARRES ── -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Code" FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditCode}" FontFamily="Consolas" Padding="8,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Code-barres" FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditBarcode}" FontFamily="Consolas" Padding="8,6"/>
                            </StackPanel>
                        </Grid>

                        <!-- ── DÉSIGNATION ── -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Désignation *" FontFamily="{StaticResource AppFont}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditName}" FontFamily="{StaticResource AppFont}"
                                     FontSize="14" FontWeight="Medium" Padding="8,8"/>
                        </StackPanel>

                        <!-- ── DESCRIPTION ── -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Description" FontFamily="{StaticResource AppFont}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditDescription}" FontFamily="{StaticResource AppFont}"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="50" Padding="8,6"/>
                        </StackPanel>

                        <!-- ── CATÉGORIE ── -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Catégorie" FontFamily="{StaticResource AppFont}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding EditCategory}"
                                      DisplayMemberPath="Name"
                                      FontFamily="{StaticResource AppFont}" Padding="8,6"/>
                        </StackPanel>

                        <Separator Margin="0,4,0,16"/>

                        <!-- ═══════════════════════════════════ -->
                        <!--  F I S C A L I T É                  -->
                        <!-- ═══════════════════════════════════ -->
                        <TextBlock Text="F I S C A L I T É" FontFamily="{StaticResource AppFont}" FontSize="11"
                                   FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,10"/>

                        <!-- Type article + Groupe TVA -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Type article" FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding ItemTypes}"
                                          SelectedItem="{Binding EditItemType}"
                                          FontFamily="{StaticResource AppFont}" Padding="8,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Groupe TVA" FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding TaxGroups}"
                                          SelectedItem="{Binding EditTaxGroup}"
                                          FontFamily="{StaticResource AppFont}" Padding="8,6"/>
                            </StackPanel>
                        </Grid>

                        <!-- Info taux TVA actif -->
                        <Border Background="#F0F9FF" CornerRadius="6" Padding="10,6" Margin="0,0,0,12"
                                Visibility="{Binding ActiveTaxRateDisplay, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="{Binding ActiveTaxRateDisplay}"
                                       FontFamily="{StaticResource AppFont}" FontSize="11"
                                       Foreground="#1E40AF" TextWrapping="Wrap"/>
                        </Border>

                        <!-- ═══ Taxe spécifique — TYPÉE ═══ -->
                        <TextBlock Text="Taxe spécifique" FontFamily="{StaticResource AppFont}" FontSize="12"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,6"/>

                        <!-- Ligne 1 : Type de taxe spécifique -->
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Type de taxe spécifique" FontFamily="{StaticResource AppFont}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding SpecificTaxTypes}"
                                      SelectedItem="{Binding EditSpecificTaxType}"
                                      FontFamily="{StaticResource AppFont}" Padding="8,6"/>
                        </StackPanel>

                        <!-- Ligne 2 : Valeur + Mode (visible si type ≠ None) -->
                        <Grid Margin="0,0,0,12"
                              Visibility="{Binding ShowSpecificTaxFields, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Montant fixe / unité"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EditSpecificTaxType}" Value="Percentage">
                                                    <Setter Property="Text" Value="Taux (%)"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Text="{Binding EditSpecificTaxValue, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource AppFont}" Padding="8,6">
                                    <TextBox.ToolTip>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Ex : 230 (montant fixe par unité vendue)"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EditSpecificTaxType}" Value="Percentage">
                                                            <Setter Property="Text" Value="Ex : 10 (pour 10% du montant HT)"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </TextBox.ToolTip>
                                </TextBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Mode d'application" FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding TaxSpecificModes}"
                                          SelectedItem="{Binding EditTaxSpecificMode}"
                                          FontFamily="{StaticResource AppFont}" Padding="8,6"/>
                            </StackPanel>
                        </Grid>

                        <!-- Info mode T.S. (visible si type ≠ None) -->
                        <Border Background="#FFFBEB" CornerRadius="6" Padding="10,6" Margin="0,0,0,12"
                                Visibility="{Binding ShowSpecificTaxFields, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11"
                                       Foreground="#92400E" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text"
                                                Value="⚡ Par article : T.S. calculée sur chaque ligne individuellement."/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditTaxSpecificMode}" Value="OnTotal">
                                                <Setter Property="Text"
                                                        Value="📊 Sur le total : T.S. différée, calculée une seule fois sur le sous-total regroupé."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- Info type T.S. (visible si type ≠ None) -->
                        <Border Background="#F0FDF4" CornerRadius="6" Padding="10,6" Margin="0,0,0,12"
                                Visibility="{Binding ShowSpecificTaxFields, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11"
                                       Foreground="#166534" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text"
                                                Value="📦 Montant fixe par unité vendue (ex : 230 CDF × quantité)."/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditSpecificTaxType}" Value="Percentage">
                                                <Setter Property="Text"
                                                        Value="📊 Pourcentage appliqué sur le montant HT (ex : 10% du HT)."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <Separator Margin="0,4,0,16"/>

                        <!-- ═══════════════════════════════════════════ -->
                        <!--  T A R I F I C A T I O N   M U L T I -     -->
                        <!--  D E V I S E                                -->
                        <!-- ═══════════════════════════════════════════ -->
                        <TextBlock Text="T A R I F I C A T I O N   M U L T I - D E V I S E"
                                   FontFamily="{StaticResource AppFont}" FontSize="11"
                                   FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,10"/>

                        <!-- Champ de saisie unique -->
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding EditPriceLabel}" FontFamily="{StaticResource AppFont}"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditPriceInput, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource AppFont}" FontSize="18" FontWeight="Bold"
                                     Padding="10,10" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2"/>
                        </StackPanel>

                        <!-- 4 prix calculés -->
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="14" Margin="0,0,0,8"
                                BorderBrush="#E2E8F0" BorderThickness="1"
                                Visibility="{Binding HasPriceCalculation, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- HT CDF -->
                                <Border CornerRadius="6" Padding="8,6" Margin="0,0,4,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveField}" Value="HT_CDF">
                                                    <Setter Property="Background" Value="#EFF6FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="HT CDF" FontFamily="{StaticResource AppFont}" FontSize="10"
                                                   FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding CalcHtCdf, StringFormat=N2}"
                                                   FontFamily="{StaticResource AppFont}" FontSize="14"
                                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- TTC CDF -->
                                <Border Grid.Column="1" CornerRadius="6" Padding="8,6" Margin="4,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveField}" Value="TTC_CDF">
                                                    <Setter Property="Background" Value="#EFF6FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="TTC CDF" FontFamily="{StaticResource AppFont}" FontSize="10"
                                                   FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                        <TextBlock Text="{Binding CalcTtcCdf, StringFormat=N2}"
                                                   FontFamily="{StaticResource AppFont}" FontSize="14"
                                                   FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- HT USD -->
                                <Border Grid.Row="2" CornerRadius="6" Padding="8,6" Margin="0,0,4,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveField}" Value="HT_USD">
                                                    <Setter Property="Background" Value="#EFF6FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="HT USD" FontFamily="{StaticResource AppFont}" FontSize="10"
                                                   FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding CalcHtUsd, StringFormat=N4}"
                                                   FontFamily="{StaticResource AppFont}" FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- TTC USD -->
                                <Border Grid.Row="2" Grid.Column="1" CornerRadius="6" Padding="8,6" Margin="4,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveField}" Value="TTC_USD">
                                                    <Setter Property="Background" Value="#EFF6FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="TTC USD" FontFamily="{StaticResource AppFont}" FontSize="10"
                                                   FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding CalcTtcUsd, StringFormat=N4}"
                                                   FontFamily="{StaticResource AppFont}" FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Info taux de change -->
                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4">
                            <Run Text="💱 Taux actif : 1 USD ="/>
                            <Run Text="{Binding ExchangeRate, StringFormat=N0, Mode=OneWay}"/>
                            <Run Text=" CDF"/>
                        </TextBlock>

                        <!-- Unité -->
                        <StackPanel Margin="0,8,0,12">
                            <TextBlock Text="Unité de mesure" FontFamily="{StaticResource AppFont}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding CommonUnits}"
                                      SelectedItem="{Binding EditUnit}" IsEditable="True"
                                      FontFamily="{StaticResource AppFont}" Padding="8,6"
                                      ToolTip="Sélectionnez ou saisissez l'unité"/>
                        </StackPanel>

                        <Separator Margin="0,4,0,16"/>

                        <!-- ═══════════════════════════════════ -->
                        <!--  R E M I S E   P A R   D É F A U T -->
                        <!-- ═══════════════════════════════════ -->
                        <TextBlock Text="R E M I S E   P A R   D É F A U T"
                                   FontFamily="{StaticResource AppFont}" FontSize="11"
                                   FontWeight="Bold" Foreground="#DC2626"
                                   Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Type de remise" FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding DiscountTypes}"
                                          SelectedItem="{Binding EditDefaultDiscountType}"
                                          FontFamily="{StaticResource AppFont}" Padding="8,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0"
                                        Visibility="{Binding ShowDiscountValue, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Montant fixe (CDF)"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EditDefaultDiscountType}" Value="Percentage">
                                                    <Setter Property="Text" Value="Pourcentage (%)"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Text="{Binding EditDefaultDiscountValue, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource AppFont}" Padding="8,6"/>
                            </StackPanel>
                        </Grid>

                        <!-- Info remise -->
                        <Border Background="#FFF5F5" CornerRadius="6" Padding="10,6" Margin="0,0,0,12"
                                Visibility="{Binding ShowDiscountValue, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="💸 Cette remise sera appliquée automatiquement lorsque ce produit est ajouté au panier ou à une facture."
                                       FontFamily="{StaticResource AppFont}" FontSize="11"
                                       Foreground="#DC2626" TextWrapping="Wrap"/>
                        </Border>

                        <Separator Margin="0,4,0,16"/>

                        <!-- ═══════════════════════════════════ -->
                        <!--  S T O C K                          -->
                        <!-- ═══════════════════════════════════ -->
                        <TextBlock Text="S T O C K" FontFamily="{StaticResource AppFont}" FontSize="11"
                                   FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,10"/>

                        <CheckBox Content="Suivre le stock" IsChecked="{Binding EditTrackStock}"
                                  FontFamily="{StaticResource AppFont}" FontSize="13" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Quantité en stock" FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditStockQuantity}" FontFamily="{StaticResource AppFont}" Padding="8,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Seuil minimum" FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditMinStockLevel}" FontFamily="{StaticResource AppFont}" Padding="8,6"/>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,4,0,16"/>

                        <!-- ═══════════════════════════════════ -->
                        <!--  O P T I O N S                      -->
                        <!-- ═══════════════════════════════════ -->
                        <CheckBox Content="⭐ Produit favori (accès rapide en caisse)"
                                  IsChecked="{Binding EditIsFavorite}"
                                  FontFamily="{StaticResource AppFont}" FontSize="13" Margin="0,0,0,8"/>

                        <CheckBox Content="Produit actif" IsChecked="{Binding EditIsActive}"
                                  FontFamily="{StaticResource AppFont}" FontSize="13" Margin="0,0,0,16"/>

                        <!-- ═══════════════════════════════════ -->
                        <!--  B O U T O N S                      -->
                        <!-- ═══════════════════════════════════ -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Annuler" Command="{Binding CancelEditCommand}"
                                    FontFamily="{StaticResource AppFont}" FontSize="13"
                                    Padding="12,10" Margin="0,0,6,0" Cursor="Hand"
                                    Background="#F3F4F6" BorderThickness="0"/>
                            <Button Grid.Column="1" Content="💾 Enregistrer"
                                    Command="{Binding SaveProductCommand}"
                                    Background="{StaticResource PrimaryBrush}" Foreground="White"
                                    FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"
                                    Padding="12,10" Margin="6,0,0,0" Cursor="Hand" BorderThickness="0"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</UserControl>