                                </Border.Background>
                                <materialDesign:PackIcon Kind="CogOutline" Width="14" Height="14"
                                                         Foreground="#D97706"/>
                            </Border>
                            <TextBlock Text="OPTIONS" Style="{StaticResource PanelLabel}"
                                       VerticalAlignment="Center" Margin="0"/>
                        </StackPanel>

                        <Border Background="#FEFCE8" CornerRadius="10" Padding="16" Margin="0,0,0,4">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding EditIsFavorite}"
                                          FontFamily="{StaticResource AppFont}" FontSize="13"
                                          MinHeight="40" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Star" Width="16" Height="16"
                                                                 Foreground="#F59E0B"
                                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Produit favori (accès rapide en caisse)"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Content="Produit actif" IsChecked="{Binding EditIsActive}"
                                          FontFamily="{StaticResource AppFont}" FontSize="13"
                                          MinHeight="40"/>
                            </StackPanel>
                        </Border>

                        <!-- ═══════════════════════════════════ -->
                        <!-- ACTION BUTTONS                       -->
                        <!-- ═══════════════════════════════════ -->
                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding CancelEditCommand}"
                                    FontFamily="{StaticResource AppFont}" FontSize="13"
                                    Padding="14,10" Margin="0,0,8,0" Cursor="Hand"
                                    Background="#F3F4F6" BorderThickness="0" MinHeight="46">
                                <TextBlock Text="Annuler" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Button>
                            <Button Grid.Column="1" Command="{Binding SaveProductCommand}"
                                    Background="{StaticResource PrimaryBrush}" Foreground="White"
                                    FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"
                                    Padding="14,10" Margin="8,0,0,0" Cursor="Hand"
                                    BorderThickness="0" MinHeight="46">
                                <Button.Effect>
                                    <DropShadowEffect Color="{StaticResource PrimaryColor}"
                                                      BlurRadius="10" ShadowDepth="2" Opacity="0.15"/>
                                </Button.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18"
                                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Enregistrer" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</UserControl>