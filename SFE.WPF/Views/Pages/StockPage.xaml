<!-- File: SFE.WPF/Views/Pages/StockPage.xaml -->
<UserControl x:Class="SFE.WPF.Views.Pages.StockPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SFE.WPF.ViewModels"
             Background="{StaticResource BackgroundBrush}">

    <Grid>
        <!-- ══════ CONTENU PRINCIPAL ══════ -->
        <DockPanel Margin="20,16">

            <!-- ═══ HEADER ═══ -->
            <Border DockPanel.Dock="Top" Background="White" CornerRadius="14"
                    Padding="20,16" Margin="0,0,0,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.06" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Titre + Recherche -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="📦 Gestion du stock" FontFamily="{StaticResource AppFont}"
                                       FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="Stock par point de vente · Mouvements · Inventaire"
                                       FontFamily="{StaticResource AppFont}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Recherche -->
                        <Border Grid.Column="1" Background="#F3F4F6" CornerRadius="10"
                                Margin="24,0" Padding="14,0" MaxWidth="350">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                         FontFamily="{StaticResource AppFont}" FontSize="13"
                                         Background="Transparent" BorderThickness="0"
                                         VerticalAlignment="Center" Padding="0,10"/>
                            </Grid>
                        </Border>

                        <!-- Actions rapides -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Command="{Binding ShowEntryFormCommand}" Margin="0,0,6,0"
                                    Cursor="Hand" Padding="12,8" BorderThickness="0"
                                    Background="#ECFDF5" Foreground="#065F46"
                                    FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="SemiBold">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📥" Margin="0,0,6,0"/>
                                    <TextBlock Text="Entrée"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ShowExitFormCommand}" Margin="0,0,6,0"
                                    Cursor="Hand" Padding="12,8" BorderThickness="0"
                                    Background="#FEF2F2" Foreground="#991B1B"
                                    FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="SemiBold">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📤" Margin="0,0,6,0"/>
                                    <TextBlock Text="Sortie"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ShowAdjustmentFormCommand}" Margin="0,0,6,0"
                                    Cursor="Hand" Padding="12,8" BorderThickness="0"
                                    Background="#FEF3C7" Foreground="#92400E"
                                    FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="SemiBold">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔧" Margin="0,0,6,0"/>
                                    <TextBlock Text="Ajustement"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ShowInventoryFormCommand}"
                                    Cursor="Hand" Padding="12,8" BorderThickness="0"
                                    Background="#EEF2FF" Foreground="#3730A3"
                                    FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="SemiBold">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📋" Margin="0,0,6,0"/>
                                    <TextBlock Text="Inventaire"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Sélecteur POS -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled" Margin="0,12,0,0" Height="44">
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{Binding PointsOfSale}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,8,0" Cursor="Hand" Padding="14,8"
                                                BorderThickness="0"
                                                FontFamily="{StaticResource AppFont}" FontSize="13"
                                                Command="{Binding DataContext.SelectPosCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                                        CornerRadius="10" Padding="{TemplateBinding Padding}"
                                                                        BorderThickness="2" BorderBrush="Transparent">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="BorderBrush"
                                                                                Value="{StaticResource PrimaryBrush}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🏪" Margin="0,0,6,0"/>
                                                <TextBlock>
                                                    <Run Text="{Binding Code, Mode=OneWay}"/>
                                                    <Run Text=" — "/>
                                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ═══ CARTES KPI ═══ -->
            <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled" Margin="0,0,0,14" Height="90">
                <StackPanel Orientation="Horizontal">
                    <Border Background="White" CornerRadius="12" Padding="20,14" Width="180" Margin="0,0,12,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" Opacity="0.05" ShadowDepth="1"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="📦 Références" FontFamily="{StaticResource AppFont}"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding TotalProducts}" FontFamily="{StaticResource AppFont}"
                                       FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="12" Padding="20,14" Width="180" Margin="0,0,12,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" Opacity="0.05" ShadowDepth="1"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="⚠️ Stock bas" FontFamily="{StaticResource AppFont}"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding LowStockCount}" FontFamily="{StaticResource AppFont}"
                                       FontSize="24" FontWeight="Bold" Foreground="#F59E0B"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="12" Padding="20,14" Width="180" Margin="0,0,12,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" Opacity="0.05" ShadowDepth="1"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="🚫 Rupture" FontFamily="{StaticResource AppFont}"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding OutOfStockCount}" FontFamily="{StaticResource AppFont}"
                                       FontSize="24" FontWeight="Bold" Foreground="#EF4444"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="12" Padding="20,14" Width="220" Margin="0,0,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" Opacity="0.05" ShadowDepth="1"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="💰 Valeur stock" FontFamily="{StaticResource AppFont}"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock FontFamily="{StaticResource AppFont}"
                                       FontSize="22" FontWeight="Bold" Foreground="#10B981"
                                       Margin="0,4,0,0">
                                <Run Text="{Binding TotalStockValue, StringFormat=N0, Mode=OneWay}"/>
                                <Run Text=" CDF" FontSize="12"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══ FILTRES ═══ -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="📋 Tout" Command="{Binding FilterAllCommand}"
                        Padding="12,6" Margin="0,0,6,0" Cursor="Hand"
                        FontFamily="{StaticResource AppFont}" FontSize="12"
                        Background="White" BorderThickness="0"/>
                <Button Content="⚠️ Stock bas" Command="{Binding FilterLowStockCommand}"
                        Padding="12,6" Margin="0,0,6,0" Cursor="Hand"
                        FontFamily="{StaticResource AppFont}" FontSize="12"
                        Background="#FEF3C7" BorderThickness="0"/>
                <Button Content="🚫 Rupture" Command="{Binding FilterOutOfStockCommand}"
                        Padding="12,6" Cursor="Hand"
                        FontFamily="{StaticResource AppFont}" FontSize="12"
                        Background="#FEE2E2" BorderThickness="0"/>
            </StackPanel>

            <!-- ═══ STATUS ═══ -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,8" CornerRadius="8" Padding="12,6"
                    Visibility="{Binding ShowSuccess, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#ECFDF5">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                           FontFamily="{StaticResource AppFont}" FontSize="12"/>
            </Border>
            <Border DockPanel.Dock="Top" Margin="0,0,0,8" CornerRadius="8" Padding="12,6"
                    Visibility="{Binding ShowError, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#FEF2F2">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource ErrorBrush}"
                           FontFamily="{StaticResource AppFont}" FontSize="12"/>
            </Border>

            <!-- ═══ TABLEAU STOCK ═══ -->
            <Border Background="White" CornerRadius="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.06" ShadowDepth="2"/>
                </Border.Effect>
                <DataGrid ItemsSource="{Binding FilteredStockItems}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" BorderThickness="0"
                          FontFamily="{StaticResource AppFont}" FontSize="12"
                          RowHeight="50" SelectionMode="Single">

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                    <Setter Property="Background" Value="#FFF5F5"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                    <Setter Property="Background" Value="#FFFBEB"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F9FAFB"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <!-- Catégorie icône -->
                        <DataGridTextColumn Header="" Binding="{Binding CategoryIcon}" Width="32">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="16"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Code -->
                        <DataGridTextColumn Header="Code" Binding="{Binding ProductCode}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Désignation -->
                        <DataGridTextColumn Header="Désignation" Binding="{Binding ProductName}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Catégorie -->
                        <DataGridTextColumn Header="Cat." Binding="{Binding CategoryName}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Quantité -->
                        <DataGridTextColumn Header="Stock" Binding="{Binding QuantityDisplay}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Min -->
                        <DataGridTextColumn Header="Min" Binding="{Binding MinStockLevel, StringFormat=G}" Width="50">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Statut -->
                        <DataGridTemplateColumn Header="Statut" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="8,3"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#ECFDF5"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontFamily="{StaticResource AppFont}" FontSize="10"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Valeur -->
                        <DataGridTextColumn Header="Valeur" Binding="{Binding ValueDisplay}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Dernier mvt -->
                        <DataGridTextColumn Header="Dern. mvt" Binding="{Binding LastMoveDisplay}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Button Content="🏪" FontSize="13" Background="Transparent"
                                                BorderThickness="0" Cursor="Hand" Margin="0,0,4,0"
                                                ToolTip="Stock dans tous les POS"
                                                Command="{Binding DataContext.ViewProductStockCommand,
                                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="📜" FontSize="13" Background="Transparent"
                                                BorderThickness="0" Cursor="Hand"
                                                ToolTip="Historique des mouvements"
                                                Command="{Binding DataContext.ViewHistoryCommand,
                                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- OVERLAY : Formulaire mouvement                             -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsMovementFormVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#80000000"/>
            <Border Background="White" CornerRadius="16" Padding="28"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Width="500" MaxHeight="600">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" Opacity="0.2" ShadowDepth="5"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Titre -->
                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="{Binding MovementFormTitle}" FontFamily="{StaticResource AppFont}"
                                   FontSize="18" FontWeight="Bold"/>
                        <Button HorizontalAlignment="Right" Content="✕" FontSize="16"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Command="{Binding CancelMovementCommand}"/>
                    </Grid>

                    <!-- POS actif -->
                    <Border Background="#EEF2FF" CornerRadius="8" Padding="12,8" Margin="0,0,0,16">
                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12"
                                   Foreground="#3730A3">
                            <Run Text="🏪 POS : "/>
                            <Run Text="{Binding SelectedPos.Code, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text=" — "/>
                            <Run Text="{Binding SelectedPos.Name, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>

                    <!-- Recherche produit -->
                    <!-- Recherche produit -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Produit *" FontFamily="{StaticResource AppFont}" FontSize="12"
               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Grid>
                            <TextBox x:Name="MvtProductSearch"
                 Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                 FontFamily="{StaticResource AppFont}" FontSize="13" Padding="10,8"/>
                            <Popup IsOpen="{Binding IsProductSearchOpen, Mode=TwoWay}" StaysOpen="False"
               PlacementTarget="{Binding ElementName=MvtProductSearch}"
               Placement="Bottom" Width="{Binding ActualWidth, ElementName=MvtProductSearch}">
                                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="0,0,8,8" MaxHeight="200">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" Opacity="0.12" ShadowDepth="4"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ProductSearchResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- ✅ FIXED: Added Command binding + hover template -->
                                                    <Button HorizontalContentAlignment="Stretch"
                                        Cursor="Hand" Padding="12,8"
                                        Command="{Binding DataContext.SelectProductForMovementCommand,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="BorderThickness" Value="0"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="Bg" 
                                                                Background="{TemplateBinding Background}"
                                                                Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter 
                                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="Bg" 
                                                                        Property="Background" Value="#F3F4F6"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayText}"
                                                   FontFamily="{StaticResource AppFont}" FontSize="13"/>
                                                            <TextBlock FontFamily="Consolas" FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="Stock: "/>
                                            <Run Text="{Binding StockQuantity, StringFormat=G, Mode=OneWay}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding Unit, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>

                    <!-- Produit sélectionné -->
                    <Border Background="#F3F4F6" CornerRadius="8" Padding="12,8" Margin="0,0,0,14"
                            Visibility="{Binding MovementProduct, Converter={StaticResource NullToCollapsedConverter}}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding MovementProduct.ProductName}"
                                           FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="Stock actuel: "/>
                                    <Run Text="{Binding MovementProduct.Quantity, StringFormat=G, Mode=OneWay}" FontWeight="Bold"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding MovementProduct.Unit, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Quantité -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{Binding MovementQuantityLabel}" FontFamily="{StaticResource AppFont}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding MovementQuantity, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource AppFont}" FontSize="18" FontWeight="Bold"
                                 Padding="12,10" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2"/>
                    </StackPanel>

                    <!-- Référence -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Référence (bon de livraison, commande...)"
                                   FontFamily="{StaticResource AppFont}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding MovementReference}" FontFamily="{StaticResource AppFont}" Padding="8,6"/>
                    </StackPanel>

                    <!-- Notes -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Notes" FontFamily="{StaticResource AppFont}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding MovementNotes}" FontFamily="{StaticResource AppFont}"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="50" Padding="8,6"/>
                    </StackPanel>

                    <!-- Opérateur -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Opérateur" FontFamily="{StaticResource AppFont}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding MovementOperator}" FontFamily="{StaticResource AppFont}" Padding="8,6"/>
                    </StackPanel>

                    <!-- Boutons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Annuler" Command="{Binding CancelMovementCommand}"
                                FontFamily="{StaticResource AppFont}" FontSize="13"
                                Padding="12,12" Margin="0,0,6,0" Cursor="Hand"
                                Background="#F3F4F6" BorderThickness="0"/>
                        <Button Grid.Column="1" Command="{Binding SubmitMovementCommand}"
                                Padding="12,12" Margin="6,0,0,0" Cursor="Hand" BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                                        CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Opacity" Value="0.9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="✅ Valider le mouvement" FontFamily="{StaticResource AppFont}"
                                       FontSize="13" FontWeight="Bold" Foreground="White"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- OVERLAY : Détail stock multi-POS                           -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding ShowProductDetail, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#80000000">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseDetailCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Background="White" HorizontalAlignment="Right" Width="420"
                    CornerRadius="16,0,0,16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" Opacity="0.2" ShadowDepth="-5"/>
                </Border.Effect>
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}"
                            Padding="24,20" CornerRadius="16,0,0,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Stock multi-POS" FontFamily="{StaticResource AppFont}"
                                           FontSize="12" Foreground="#BFDBFE"/>
                                <TextBlock Text="{Binding DetailProductName}" FontFamily="{StaticResource AppFont}"
                                           FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="14"
                                           Foreground="#93C5FD" Margin="0,4,0,0">
                                    <Run Text="Total: "/>
                                    <Run Text="{Binding DetailTotalStock, StringFormat=G, Mode=OneWay}" FontWeight="Bold"/>
                                </TextBlock>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Content="✕" FontSize="18" Foreground="White"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding CloseDetailCommand}"/>
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
                        <ItemsControl ItemsSource="{Binding ProductPosStocks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" CornerRadius="10" Padding="16,12"
                                            BorderThickness="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FAFAFA"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrentPos}" Value="True">
                                                        <Setter Property="Background" Value="#EFF6FF"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🏪 " FontSize="12"/>
                                                    <TextBlock Text="{Binding PosCode}" FontFamily="Consolas"
                                                               FontSize="12" FontWeight="Bold"/>
                                                    <TextBlock Text=" — " Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding PosName}" FontFamily="{StaticResource AppFont}"
                                                               FontSize="12"/>
                                                </StackPanel>
                                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0">
                                                    <Run Text="Min: "/>
                                                    <Run Text="{Binding MinStock, StringFormat=G, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" FontFamily="{StaticResource AppFont}"
                                                       FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                                                       Margin="0,0,12,0">
                                                <Run Text="{Binding Quantity, StringFormat=G, Mode=OneWay}"/>
                                            </TextBlock>
                                            <Border Grid.Column="2" CornerRadius="6" Padding="8,3"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#ECFDF5"/>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontFamily="{StaticResource AppFont}" FontSize="10"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- OVERLAY : Historique mouvements                            -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding ShowHistory, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#80000000">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseHistoryCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Background="White" HorizontalAlignment="Right" Width="560"
                    CornerRadius="16,0,0,16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" Opacity="0.2" ShadowDepth="-5"/>
                </Border.Effect>
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#1E293B"
                            Padding="24,20" CornerRadius="16,0,0,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="📜 Historique des mouvements" FontFamily="{StaticResource AppFont}"
                                           FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding HistoryTitle}" FontFamily="{StaticResource AppFont}"
                                           FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Content="✕" FontSize="18" Foreground="White"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding CloseHistoryCommand}"/>
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                        <ItemsControl ItemsSource="{Binding HistoryItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,4" Padding="14,10" Background="#FAFAFA"
                                            CornerRadius="8" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Type -->
                                            <TextBlock Text="{Binding TypeDisplay}" FontFamily="{StaticResource AppFont}"
                                                       FontSize="11" VerticalAlignment="Center" FontWeight="Medium"/>

                                            <!-- Détails -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Reference}" FontFamily="Consolas"
                                                           FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding Notes}" FontFamily="{StaticResource AppFont}"
                                                           FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Quantité delta -->
                                            <TextBlock Grid.Column="2" Text="{Binding QuantityDisplay}"
                                                       FontFamily="{StaticResource AppFont}" FontSize="13"
                                                       FontWeight="Bold" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#10B981"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Quantity, Converter={StaticResource IsNegativeConverter}}" Value="True">
                                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Date -->
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center"
                                                        HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding CreatedAt, StringFormat=dd/MM/yy}"
                                                           FontFamily="{StaticResource AppFont}" FontSize="10"/>
                                                <TextBlock Text="{Binding CreatedAt, StringFormat=HH:mm}"
                                                           FontFamily="{StaticResource AppFont}" FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Spinner -->
        <Border Background="#40000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⏳" FontSize="36" HorizontalAlignment="Center"/>
                <TextBlock Text="Chargement..." FontFamily="{StaticResource AppFont}"
                           FontSize="14" Foreground="White" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>