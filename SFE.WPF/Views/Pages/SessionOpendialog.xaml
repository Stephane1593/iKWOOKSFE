<Window x:Class="SFE.WPF.Views.Pages.SessionOpenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:SFE.WPF.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SessionOpenViewModel}"
        Title="Ouverture de session"
        Width="780" Height="960"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <!-- ══════════ FORM INPUT (animated border) ══════════ -->
        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"       Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize"         Value="14"/>
            <Setter Property="FontFamily"       Value="{StaticResource AppFont}"/>
            <Setter Property="Padding"          Value="12,10"/>
            <Setter Property="CaretBrush"       Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="BdBr" Color="{StaticResource BorderColor}"/>
                            </Border.BorderBrush>
                            <Border.BorderThickness>
                                <Thickness>1.5</Thickness>
                            </Border.BorderThickness>
                            <!-- Reset inner ScrollViewer to default so global style won't break it -->
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer">
                                        <Setter Property="OverridesDefaultStyle" Value="False"/>
                                    </Style>
                                </ScrollViewer.Style>
                            </ScrollViewer>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="GotFocus">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBr"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource PrimaryColor}"
                                                        Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="LostFocus">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBr"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource BorderColor}"
                                                        Duration="0:0:0.22"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBr"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource TextMutedColor}"
                                                        Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBr"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource BorderColor}"
                                                        Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ RATE / AMOUNT INPUT ══════════ -->
        <Style x:Key="RateInput" TargetType="TextBox" BasedOn="{StaticResource FormInput}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{StaticResource BackgroundColor}"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ SECTION LABEL ══════════ -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="Foreground"   Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontFamily"   Value="{StaticResource AppFont}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ══════════ SECTION ICON ══════════ -->
        <Style x:Key="SectionIcon" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- ══════════ CURRENCY BADGE ══════════ -->
        <Style x:Key="CurrBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ══════════ CONFIRM BUTTON ══════════ -->
        <Style x:Key="ConfirmButton" TargetType="Button">
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="FontSize"         Value="15"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="FontFamily"       Value="{StaticResource AppFont}"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="0,14">
                            <Border.Background>
                                <LinearGradientBrush x:Name="BdGrad" StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="G0" Color="#37B1E4" Offset="0"/>
                                    <GradientStop x:Name="G1" Color="#1A8CBF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="3" BlurRadius="14"
                                                  Opacity="0.3" Color="#37B1E4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#2DA0D3" Duration="0:0:0.18"/>
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#1579A8" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#37B1E4" Duration="0:0:0.22"/>
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#1A8CBF" Duration="0:0:0.22"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#1A3D55"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="Effect" Value="{x:Null}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ BYPASS BUTTON ══════════ -->
        <Style x:Key="BypassButton" TargetType="Button">
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="FontSize"         Value="14"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="FontFamily"       Value="{StaticResource AppFont}"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="0,13">
                            <Border.Background>
                                <LinearGradientBrush x:Name="BdGrad" StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="G0" Color="#10B981" Offset="0"/>
                                    <GradientStop x:Name="G1" Color="#059669" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" BlurRadius="12"
                                                  Opacity="0.25" Color="#10B981"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#059669" Duration="0:0:0.18"/>
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#047857" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#10B981" Duration="0:0:0.22"/>
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#059669" Duration="0:0:0.22"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ LOCAL SCROLLBAR — Thin pill for this dialog ══════════ -->
        <Style x:Key="DialogScrollThumb" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" CornerRadius="4" Margin="1">
                            <Border.Background>
                                <SolidColorBrush x:Name="ThumbBg" Color="#C8D0D8"/>
                            </Border.Background>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="ThumbBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#94A3B8" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="ThumbBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#C8D0D8" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#64748B"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogScrollPageBtn" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogScrollBar" TargetType="ScrollBar">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource DialogScrollPageBtn}"
                                                  Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DialogScrollThumb}" MinHeight="30"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource DialogScrollPageBtn}"
                                                  Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ DIALOG SCROLLVIEWER (fade-on-hover) ══════════ -->
        <Style x:Key="DialogScrollViewer" TargetType="ScrollViewer">
            <Setter Property="PanningMode" Value="VerticalOnly"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ScrollContentPresenter Grid.Column="0"
                                                    Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>

                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Style="{StaticResource DialogScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Opacity="0.25"
                                       Margin="2,16"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.25" Duration="0:0:0.5"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ═══ OUTER FRAME ═══ -->
    <Border CornerRadius="16" Margin="18">
        <Border.Background>
            <SolidColorBrush Color="#0D2B3E"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="4"
                              Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══ Top accent bar ═══ -->
            <Border CornerRadius="16,16,0,0" Height="4" VerticalAlignment="Top"
                    Panel.ZIndex="5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#37B1E4" Offset="0"/>
                        <GradientStop Color="#1A8CBF" Offset="0.5"/>
                        <GradientStop Color="#FD4D4D" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- ═══ CLOSE BUTTON ═══ -->
            <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,18,18,0" Width="34" Height="34" Panel.ZIndex="10"
                    Cursor="Hand" Click="CloseButton_Click" IsCancel="True">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="#00FFFFFF"/>
                            </Border.Background>
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18"
                                                     Foreground="#4A6B7C"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#1AFFFFFF" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#00FFFFFF" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- ═══════════════════════════════════ -->
            <!--  DARK HEADER                        -->
            <!-- ═══════════════════════════════════ -->
            <StackPanel Grid.Row="0" Margin="56,38,56,30" HorizontalAlignment="Center">

                <!-- Logo pill -->
                <Border CornerRadius="14" Width="150" Height="52"
                        HorizontalAlignment="Center" Margin="0,0,0,22">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#37B1E4" Offset="0"/>
                            <GradientStop Color="#1A8CBF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="3" BlurRadius="16"
                                          Opacity="0.35" Color="#37B1E4"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CubeOutline" Width="20" Height="20"
                                                 Foreground="White" Margin="0,0,8,0"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="iKWOOK SFE" Foreground="White" FontSize="15"
                                   FontWeight="Bold" VerticalAlignment="Center"
                                   FontFamily="{StaticResource AppFont}"/>
                    </StackPanel>
                </Border>

                <!-- Title -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="CashRegister" Width="20" Height="20"
                                             Foreground="#7CAFC8" Margin="0,0,8,0"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="Ouverture de session de caisse" Foreground="White"
                               FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFont}"/>
                </StackPanel>

                <!-- Date/time chip -->
                <Border CornerRadius="8" Padding="16,7" Margin="0,14,0,0"
                        HorizontalAlignment="Center">
                    <Border.Background>
                        <SolidColorBrush Color="#FFFFFF" Opacity="0.06"/>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="CalendarOutline" Width="14" Height="14"
                                                 Foreground="#7CAFC8" Margin="0,0,6,0"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentDate}" Foreground="#8BAAB9" FontSize="12"
                                   FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                        <TextBlock Text="  ·  " Foreground="#2A4D60" FontSize="12"
                                   VerticalAlignment="Center"/>
                        <materialDesign:PackIcon Kind="ClockOutline" Width="14" Height="14"
                                                 Foreground="#7CAFC8" Margin="0,0,6,0"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentTime}" Foreground="#8BAAB9" FontSize="12"
                                   FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Operator -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <materialDesign:PackIcon Kind="AccountOutline" Width="14" Height="14"
                                             Foreground="#4A6B7C" Margin="0,0,6,0"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="Opérateur : " Foreground="#4A6B7C" FontSize="12"
                               FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding OperatorName}" Foreground="#CBD5E1" FontSize="12"
                               FontWeight="SemiBold" FontFamily="{StaticResource AppFont}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- ═══════════════════════════════════ -->
            <!--  LIGHT FORM AREA                    -->
            <!-- ═══════════════════════════════════ -->
            <Border Grid.Row="1" CornerRadius="20,20,16,16">
                <Border.Background>
                    <SolidColorBrush Color="{StaticResource SurfaceColor}"/>
                </Border.Background>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Style="{StaticResource DialogScrollViewer}"
                              Padding="60,44,60,36">
                    <StackPanel>

                        <!-- ══════════════════════════════════════════════ -->
                        <!--  NO POS WARNING — REGULAR USER (BLOCKED)      -->
                        <!-- ══════════════════════════════════════════════ -->
                        <Border Visibility="{Binding ShowNoPosBlocker, Converter={StaticResource B2V}}"
                                CornerRadius="12" Padding="28,24" Margin="0,0,0,28">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.06"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.3"/>
                            </Border.BorderBrush>
                            <Border.BorderThickness>
                                <Thickness>1.5</Thickness>
                            </Border.BorderThickness>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <materialDesign:PackIcon Kind="AlertOutline" Width="28" Height="28"
                                                             Foreground="#F59E0B"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,12,0"/>
                                    <TextBlock Text="Point de vente indisponible"
                                               FontWeight="Bold" FontSize="15" Foreground="#C2410C"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding NoPosBlockerMessage}"
                                           Foreground="#9A3412" FontSize="13"
                                           TextWrapping="Wrap" LineHeight="20"
                                           FontFamily="{StaticResource AppFont}"/>
                                <Border CornerRadius="8" Padding="14,10" Margin="0,18,0,0">
                                    <Border.Background>
                                        <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.08"/>
                                    </Border.Background>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="LightbulbOnOutline" Width="16" Height="16"
                                                                 Foreground="#B45309" Margin="0,0,8,0"
                                                                 VerticalAlignment="Top"/>
                                        <TextBlock Foreground="#9A3412" FontSize="11.5"
                                                   TextWrapping="Wrap"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontStyle="Italic"
                                                   Text="Fermez cette fenêtre, configurez vos points de vente dans les paramètres, puis réouvrez une session."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════ -->
                        <!--  NO POS — IT TECH BYPASS PANEL                -->
                        <!-- ══════════════════════════════════════════════ -->
                        <Border Visibility="{Binding ShowItTechBypass, Converter={StaticResource B2V}}"
                                CornerRadius="12" Padding="28,24" Margin="0,0,0,28">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource SuccessColor}" Opacity="0.05"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource SuccessColor}" Opacity="0.25"/>
                            </Border.BorderBrush>
                            <Border.BorderThickness>
                                <Thickness>1.5</Thickness>
                            </Border.BorderThickness>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <materialDesign:PackIcon Kind="WrenchOutline" Width="28" Height="28"
                                                             Foreground="{StaticResource SuccessBrush}"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,12,0"/>
                                    <TextBlock Text="Mode Technicien IT"
                                               FontWeight="Bold" FontSize="15" Foreground="#166534"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}"/>
                                </StackPanel>

                                <TextBlock Text="{Binding NoPosBypassMessage}"
                                           Foreground="#15803D" FontSize="13"
                                           TextWrapping="Wrap" LineHeight="20"
                                           FontFamily="{StaticResource AppFont}"/>

                                <Border CornerRadius="8" Padding="14,10" Margin="0,18,0,0">
                                    <Border.Background>
                                        <SolidColorBrush Color="{StaticResource SuccessColor}" Opacity="0.08"/>
                                    </Border.Background>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="16" Height="16"
                                                                 Foreground="#166534" Margin="0,0,8,0"
                                                                 VerticalAlignment="Top"/>
                                        <TextBlock Foreground="#166534" FontSize="11.5"
                                                   TextWrapping="Wrap"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontStyle="Italic"
                                                   Text="En tant que technicien IT, vous pouvez accéder à l'application en mode configuration pour créer des points de vente, gérer les utilisateurs et configurer le système."/>
                                    </StackPanel>
                                </Border>

                                <Button Style="{StaticResource BypassButton}" Margin="0,22,0,0"
                                        Command="{Binding BypassCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ShieldKeyOutline" Width="18" Height="18"
                                                                 Foreground="White" Margin="0,0,10,0"
                                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="Accéder au mode configuration"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White"
                                                   FontFamily="{StaticResource AppFont}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════ -->
                        <!--  NORMAL FORM (visible only if POS)    -->
                        <!-- ══════════════════════════════════════ -->
                        <StackPanel Visibility="{Binding HasPosAvailable, Converter={StaticResource B2V}}">

                            <!-- ── SECTION: POINT DE VENTE ── -->
                            <StackPanel Orientation="Horizontal" Margin="4,0,0,16">
                                <materialDesign:PackIcon Kind="StorefrontOutline"
                                                         Style="{StaticResource SectionIcon}"/>
                                <TextBlock Text="POINT DE VENTE ASSIGNÉ"
                                           Style="{StaticResource SectionLabel}"/>
                            </StackPanel>

                            <!-- POS Card -->
                            <Border CornerRadius="12" Padding="24,18" Margin="0,0,0,12">
                                <Border.Background>
                                    <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.06"/>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.2"/>
                                </Border.BorderBrush>
                                <Border.BorderThickness>
                                    <Thickness>1</Thickness>
                                </Border.BorderThickness>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon badge -->
                                    <Border Grid.Column="0" Width="44" Height="44"
                                            CornerRadius="11" Margin="0,0,18,0"
                                            VerticalAlignment="Center">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#37B1E4" Offset="0"/>
                                                <GradientStop Color="#1A8CBF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <materialDesign:PackIcon Kind="MapMarkerOutline"
                                                                 Width="20" Height="20"
                                                                 Foreground="White"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- POS info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding AssignedPos.Code}" FontWeight="Bold"
                                                       FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontFamily="{StaticResource AppFont}"/>
                                            <TextBlock Text=" — " Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="15"/>
                                            <TextBlock Text="{Binding AssignedPos.Name}" FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontFamily="{StaticResource AppFont}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding AssignedPosDetail}" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,4,0,0"
                                                   FontFamily="{StaticResource AppFont}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Hint -->
                            <StackPanel Orientation="Horizontal" Margin="8,0,0,32">
                                <materialDesign:PackIcon Kind="InformationOutline" Width="12" Height="12"
                                                         Foreground="{StaticResource TextMutedBrush}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,5,0"/>
                                <TextBlock Text="Changez votre POS dans Outils → Gestion des utilisateurs"
                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                           FontStyle="Italic"
                                           FontFamily="{StaticResource AppFont}"/>
                            </StackPanel>

                            <!-- ── SEPARATOR ── -->
                            <Separator Background="{StaticResource BorderLightBrush}"
                                       Height="1" Margin="0,0,0,32"/>

                            <!-- ══════════════════════════════════════════════════ -->
                            <!--  TWO-COLUMN: TAUX (left) │ CAISSE (right)         -->
                            <!-- ══════════════════════════════════════════════════ -->
                            <Grid Margin="8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- ═══ LEFT: EXCHANGE RATES ═══ -->
                                <StackPanel Grid.Column="0">

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                        <materialDesign:PackIcon Kind="SwapHorizontal"
                                                                 Style="{StaticResource SectionIcon}"/>
                                        <TextBlock Text="TAUX DE CHANGE"
                                                   Style="{StaticResource SectionLabel}"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="14"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="14"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="18"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- USD -->
                                        <Border Grid.Row="0" Grid.Column="0"
                                                Style="{StaticResource CurrBadge}"
                                                Background="#EFF6FF">
                                            <TextBlock Text="USD" FontWeight="Bold" FontSize="11"
                                                       Foreground="#2563EB" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}"/>
                                        </Border>
                                        <TextBox Grid.Row="0" Grid.Column="2"
                                                 Text="{Binding RateUSD, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource RateInput}"
                                                 PreviewTextInput="NumericInput_PreviewTextInput"/>

                                        <!-- EUR -->
                                        <Border Grid.Row="2" Grid.Column="0"
                                                Style="{StaticResource CurrBadge}"
                                                Background="#F5F3FF">
                                            <TextBlock Text="EUR" FontWeight="Bold" FontSize="11"
                                                       Foreground="#7C3AED" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}"/>
                                        </Border>
                                        <TextBox Grid.Row="2" Grid.Column="2"
                                                 Text="{Binding RateEUR, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource RateInput}"
                                                 PreviewTextInput="NumericInput_PreviewTextInput"/>

                                        <!-- CNY -->
                                        <Border Grid.Row="4" Grid.Column="0"
                                                Style="{StaticResource CurrBadge}"
                                                Background="#FEF2F2">
                                            <TextBlock Text="CNY" FontWeight="Bold" FontSize="11"
                                                       Foreground="#DC2626" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}"/>
                                        </Border>
                                        <TextBox Grid.Row="4" Grid.Column="2"
                                                 Text="{Binding RateCNY, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource RateInput}"
                                                 PreviewTextInput="NumericInput_PreviewTextInput"/>

                                        <!-- CDF (base — locked) -->
                                        <Border Grid.Row="6" Grid.Column="0"
                                                Style="{StaticResource CurrBadge}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{StaticResource BorderLightColor}"/>
                                            </Border.Background>
                                            <TextBlock Text="CDF" FontWeight="Bold" FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}"/>
                                        </Border>
                                        <StackPanel Grid.Row="6" Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="4,0,0,0">
                                            <materialDesign:PackIcon Kind="LockOutline" Width="13" Height="13"
                                                                     Foreground="{StaticResource TextMutedBrush}"
                                                                     VerticalAlignment="Center"
                                                                     Margin="0,0,6,0"/>
                                            <TextBlock Text="Devise de base" FontSize="12"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       VerticalAlignment="Center"
                                                       FontStyle="Italic"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- ═══ VERTICAL DIVIDER ═══ -->
                                <Border Grid.Column="1" Width="1" Margin="28,0"
                                        VerticalAlignment="Stretch">
                                    <Border.Background>
                                        <SolidColorBrush Color="{StaticResource BorderLightColor}"/>
                                    </Border.Background>
                                </Border>

                                <!-- ═══ RIGHT: CASH ON HAND ═══ -->
                                <StackPanel Grid.Column="2">

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                        <materialDesign:PackIcon Kind="CashMultiple"
                                                                 Style="{StaticResource SectionIcon}"/>
                                        <TextBlock Text="FONDS DE CAISSE"
                                                   Style="{StaticResource SectionLabel}"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="14"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="14"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="14"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- USD -->
                                        <Border Grid.Row="0" Grid.Column="0"
                                                Style="{StaticResource CurrBadge}"
                                                Background="#EFF6FF">
                                            <TextBlock Text="USD" FontWeight="Bold" FontSize="11"
                                                       Foreground="#2563EB" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}"/>
                                        </Border>
                                        <TextBox Grid.Row="0" Grid.Column="2"
                                                 Text="{Binding AmountUSD, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource RateInput}"
                                                 PreviewTextInput="NumericInput_PreviewTextInput"/>

                                        <!-- EUR -->
                                        <Border Grid.Row="2" Grid.Column="0"
                                                Style="{StaticResource CurrBadge}"
                                                Background="#F5F3FF">
                                            <TextBlock Text="EUR" FontWeight="Bold" FontSize="11"
                                                       Foreground="#7C3AED" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}"/>
                                        </Border>
                                        <TextBox Grid.Row="2" Grid.Column="2"
                                                 Text="{Binding AmountEUR, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource RateInput}"
                                                 PreviewTextInput="NumericInput_PreviewTextInput"/>

                                        <!-- CNY -->
                                        <Border Grid.Row="4" Grid.Column="0"
                                                Style="{StaticResource CurrBadge}"
                                                Background="#FEF2F2">
                                            <TextBlock Text="CNY" FontWeight="Bold" FontSize="11"
                                                       Foreground="#DC2626" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}"/>
                                        </Border>
                                        <TextBox Grid.Row="4" Grid.Column="2"
                                                 Text="{Binding AmountCNY, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource RateInput}"
                                                 PreviewTextInput="NumericInput_PreviewTextInput"/>

                                        <!-- CDF -->
                                        <Border Grid.Row="6" Grid.Column="0"
                                                Style="{StaticResource CurrBadge}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{StaticResource PrimaryLightColor}"/>
                                            </Border.Background>
                                            <TextBlock Text="CDF" FontWeight="Bold" FontSize="11"
                                                       Foreground="{StaticResource PrimaryDarkBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}"/>
                                        </Border>
                                        <TextBox Grid.Row="6" Grid.Column="2"
                                                 Text="{Binding AmountCDF, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource RateInput}"
                                                 PreviewTextInput="NumericInput_PreviewTextInput"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- ── TOTAL BAR ── -->
                            <Border CornerRadius="12" Padding="26,18" Margin="0,32,0,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#0D2B3E" Offset="0"/>
                                        <GradientStop Color="#102F45" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Calculator" Width="16" Height="16"
                                                                 Foreground="#7CAFC8"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,8,0"/>
                                        <TextBlock Text="TOTAL FONDS DE CAISSE"
                                                   Foreground="#7CAFC8" FontSize="11" FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TotalEquivCDF}" Foreground="White"
                                                   FontSize="20" FontWeight="Bold"
                                                   VerticalAlignment="Bottom"
                                                   FontFamily="{StaticResource AppFont}"/>
                                        <TextBlock Text=" CDF" Foreground="#7CAFC8" FontSize="13"
                                                   VerticalAlignment="Bottom" Margin="4,0,0,0"
                                                   FontFamily="{StaticResource AppFont}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ── SEPARATOR ── -->
                            <Separator Background="{StaticResource BorderLightBrush}"
                                       Height="1" Margin="0,32"/>

                            <!-- ── NOTES ── -->
                            <StackPanel Orientation="Horizontal" Margin="4,0,0,16">
                                <materialDesign:PackIcon Kind="NoteTextOutline"
                                                         Style="{StaticResource SectionIcon}"/>
                                <TextBlock Text="NOTES (OPTIONNEL)"
                                           Style="{StaticResource SectionLabel}"/>
                            </StackPanel>
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormInput}"
                                     Height="64" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"/>

                            <!-- ── ERROR ── -->
                            <Border Margin="0,22,0,0" CornerRadius="8" Padding="16,12"
                                    Visibility="{Binding HasError, Converter={StaticResource B2V}}">
                                <Border.Background>
                                    <SolidColorBrush Color="{StaticResource ErrorColor}" Opacity="0.08"/>
                                </Border.Background>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="16" Height="16"
                                                             Foreground="{StaticResource ErrorBrush}"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding ErrorMessage}"
                                               Foreground="{StaticResource ErrorBrush}" FontSize="12"
                                               TextWrapping="Wrap"
                                               FontFamily="{StaticResource AppFont}"/>
                                </StackPanel>
                            </Border>

                            <!-- ── CONFIRM BUTTON ── -->
                            <Button Style="{StaticResource ConfirmButton}" Margin="0,28,0,0"
                                    Command="{Binding ConfirmCommand}" IsDefault="True">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="PlayCircleOutline" Width="20" Height="20"
                                                             Foreground="White" Margin="0,0,10,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Ouvrir la session de caisse"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="White"
                                               FontFamily="{StaticResource AppFont}"/>
                                </StackPanel>
                            </Button>

                        </StackPanel>

                        <!-- ── LOADING ── -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Margin="0,22,0,0"
                                    Visibility="{Binding IsLoading, Converter={StaticResource B2V}}">
                            <materialDesign:PackIcon Kind="Loading" Width="16" Height="16"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     Margin="0,0,8,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon.RenderTransform>
                                    <RotateTransform x:Name="LoadingRotation" CenterX="8" CenterY="8"/>
                                </materialDesign:PackIcon.RenderTransform>
                                <materialDesign:PackIcon.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation
                                                    Storyboard.TargetName="LoadingRotation"
                                                    Storyboard.TargetProperty="Angle"
                                                    From="0" To="360" Duration="0:0:1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </materialDesign:PackIcon.Triggers>
                            </materialDesign:PackIcon>
                            <TextBlock Text="Chargement en cours…"
                                       Foreground="#7CAFC8" FontSize="12"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"/>
                        </StackPanel>

                        <!-- ── FOOTER ── -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Margin="0,32,0,16">
                            <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="13" Height="13"
                                                     Foreground="{StaticResource BorderBrush}"
                                                     Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="SFE v2.0 · Conforme DGI-RDC"
                                       Foreground="{StaticResource BorderBrush}" FontSize="11"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>