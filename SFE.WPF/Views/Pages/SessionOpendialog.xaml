<Window x:Class="SFE.WPF.Views.Pages.SessionOpenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SFE.WPF.ViewModels"
        Title="Ouverture de session"
        Width="780"
        Height="960"
        d:DataContext="{d:DesignInstance Type=vm:SessionOpenViewModel}"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />

        <!--  ══════════ FORM INPUT (animated border) ══════════  -->
        <Style x:Key="FormInput"
               TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="BdBr"
                                                 Color="{StaticResource BorderColor}" />
                            </Border.BorderBrush>
                            <Border.BorderThickness>
                                <Thickness>1.5</Thickness>
                            </Border.BorderThickness>
                            <!--  Reset inner ScrollViewer to default so global style won't break it  -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="2,0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer">
                                        <Setter Property="OverridesDefaultStyle" Value="False" />
                                    </Style>
                                </ScrollViewer.Style>
                            </ScrollViewer>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="GotFocus">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBr"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource PrimaryColor}"
                                                        Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="LostFocus">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBr"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource BorderColor}"
                                                        Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBr"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource TextMutedColor}"
                                                        Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBr"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource BorderColor}"
                                                        Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ══════════ RATE / AMOUNT INPUT ══════════  -->
        <Style x:Key="RateInput"
               BasedOn="{StaticResource FormInput}"
               TargetType="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{StaticResource BackgroundColor}" />
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ══════════ SECTION LABEL ══════════  -->
        <Style x:Key="SectionLabel"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  ══════════ SECTION ICON ══════════  -->
        <Style x:Key="SectionIcon"
               TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <!--  ══════════ CURRENCY BADGE ══════════  -->
        <Style x:Key="CurrBadge"
               TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="38" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  ══════════ CONFIRM BUTTON ══════════  -->
        <Style x:Key="ConfirmButton"
               TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Padding="0,14"
                                CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush x:Name="BdGrad" StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="G0" Offset="0" Color="#37B1E4" />
                                    <GradientStop x:Name="G1" Offset="1" Color="#1A8CBF" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14"
                                                  Opacity="0.3"
                                                  ShadowDepth="3"
                                                  Color="#37B1E4" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#2DA0D3"
                                                        Duration="0:0:0.18" />
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#1579A8"
                                                        Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#37B1E4"
                                                        Duration="0:0:0.22" />
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#1A8CBF"
                                                        Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#1A3D55" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="Effect" Value="{x:Null}" />
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ══════════ BYPASS BUTTON ══════════  -->
        <Style x:Key="BypassButton"
               TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Padding="0,13"
                                CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush x:Name="BdGrad" StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="G0" Offset="0" Color="#10B981" />
                                    <GradientStop x:Name="G1" Offset="1" Color="#059669" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12"
                                                  Opacity="0.25"
                                                  ShadowDepth="2"
                                                  Color="#10B981" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#059669"
                                                        Duration="0:0:0.18" />
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#047857"
                                                        Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#10B981"
                                                        Duration="0:0:0.22" />
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#059669"
                                                        Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ══════════ LOCAL SCROLLBAR — Thin pill for this dialog ══════════  -->
        <Style x:Key="DialogScrollThumb"
               TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Margin="1"
                                CornerRadius="4">
                            <Border.Background>
                                <SolidColorBrush x:Name="ThumbBg"
                                                 Color="#C8D0D8" />
                            </Border.Background>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="ThumbBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#94A3B8"
                                                        Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="ThumbBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#C8D0D8"
                                                        Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#64748B" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogScrollPageBtn"
               TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogScrollBar"
               TargetType="ScrollBar">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Style="{StaticResource DialogScrollPageBtn}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="30"
                                           Style="{StaticResource DialogScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Style="{StaticResource DialogScrollPageBtn}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ══════════ DIALOG SCROLLVIEWER (fade-on-hover) ══════════  -->
        <Style x:Key="DialogScrollViewer"
               TargetType="ScrollViewer">
            <Setter Property="PanningMode" Value="VerticalOnly" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ScrollContentPresenter Grid.Column="0"
                                                    Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}" />

                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Margin="2,16"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       Opacity="0.25"
                                       Style="{StaticResource DialogScrollBar}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Value="{TemplateBinding VerticalOffset}" />
                        </Grid>

                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.25"
                                                         Duration="0:0:0.5" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--  ═══ OUTER FRAME ═══  -->
    <Border Margin="18"
            CornerRadius="16">
        <Border.Background>
            <SolidColorBrush Color="#0D2B3E" />
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="40"
                              Opacity="0.5"
                              ShadowDepth="4"
                              Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  ═══ Top accent bar ═══  -->
            <Border Height="4"
                    VerticalAlignment="Top"
                    Panel.ZIndex="5"
                    CornerRadius="16,16,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#37B1E4" />
                        <GradientStop Offset="0.5" Color="#1A8CBF" />
                        <GradientStop Offset="1" Color="#FD4D4D" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!--  ═══ CLOSE BUTTON ═══  -->
            <Button Grid.Row="0"
                    Width="34"
                    Height="34"
                    Margin="0,18,18,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Panel.ZIndex="10"
                    Click="CloseButton_Click"
                    Cursor="Hand"
                    IsCancel="True">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="8">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg"
                                                 Color="#00FFFFFF" />
                            </Border.Background>
                            <materialDesign:PackIcon Width="18"
                                                     Height="18"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Foreground="#4A6B7C"
                                                     Kind="Close" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#1AFFFFFF"
                                                        Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#00FFFFFF"
                                                        Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!--  ═══════════════════════════════════  -->
            <!--  DARK HEADER  -->
            <!--  ═══════════════════════════════════  -->
            <StackPanel Grid.Row="0"
                        Margin="56,38,56,30"
                        HorizontalAlignment="Center">

                <!--  Logo  -->
                <Image Height="45"
                       Margin="0,0,0,22"
                       HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="/Resources/Images/ISFE.png"
                       Stretch="Uniform" />

                <!--  Title  -->
                <StackPanel HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <materialDesign:PackIcon Width="20"
                                             Height="20"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"
                                             Foreground="#7CAFC8"
                                             Kind="CashRegister" />
                    <TextBlock VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="Ouverture de session de caisse" />
                </StackPanel>

                <!--  Date/time chip  -->
                <Border Margin="0,14,0,0"
                        Padding="16,7"
                        HorizontalAlignment="Center"
                        CornerRadius="8">
                    <Border.Background>
                        <SolidColorBrush Opacity="0.06"
                                         Color="#FFFFFF" />
                    </Border.Background>
                    <StackPanel HorizontalAlignment="Center"
                                Orientation="Horizontal">
                        <materialDesign:PackIcon Width="14"
                                                 Height="14"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="#7CAFC8"
                                                 Kind="CalendarOutline" />
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="12"
                                   Foreground="#8BAAB9"
                                   Text="{Binding CurrentDate}" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="#2A4D60"
                                   Text="  ·  " />
                        <materialDesign:PackIcon Width="14"
                                                 Height="14"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="#7CAFC8"
                                                 Kind="ClockOutline" />
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="12"
                                   Foreground="#8BAAB9"
                                   Text="{Binding CurrentTime}" />
                    </StackPanel>
                </Border>

                <!--  Operator  -->
                <StackPanel Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <materialDesign:PackIcon Width="14"
                                             Height="14"
                                             Margin="0,0,6,0"
                                             VerticalAlignment="Center"
                                             Foreground="#4A6B7C"
                                             Kind="AccountOutline" />
                    <TextBlock VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="12"
                               Foreground="#4A6B7C"
                               Text="Opérateur : " />
                    <TextBlock VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#CBD5E1"
                               Text="{Binding OperatorName}" />
                </StackPanel>
            </StackPanel>

            <!--  ═══════════════════════════════════  -->
            <!--  LIGHT FORM AREA  -->
            <!--  ═══════════════════════════════════  -->
            <Border Grid.Row="1"
                    CornerRadius="20,20,16,16">
                <Border.Background>
                    <SolidColorBrush Color="{StaticResource SurfaceColor}" />
                </Border.Background>

                <ScrollViewer Padding="60,44,60,36"
                              Style="{StaticResource DialogScrollViewer}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!--  ══════════════════════════════════════════════  -->
                        <!--  NO POS WARNING — REGULAR USER (BLOCKED)  -->
                        <!--  ══════════════════════════════════════════════  -->
                        <Border Margin="0,0,0,28"
                                Padding="28,24"
                                CornerRadius="12"
                                Visibility="{Binding ShowNoPosBlocker, Converter={StaticResource B2V}}">
                            <Border.Background>
                                <SolidColorBrush Opacity="0.06"
                                                 Color="{StaticResource WarningColor}" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Opacity="0.3"
                                                 Color="{StaticResource WarningColor}" />
                            </Border.BorderBrush>
                            <Border.BorderThickness>
                                <Thickness>1.5</Thickness>
                            </Border.BorderThickness>
                            <StackPanel>
                                <StackPanel Margin="0,0,0,16"
                                            Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="28"
                                                             Height="28"
                                                             Margin="0,0,12,0"
                                                             VerticalAlignment="Center"
                                                             Foreground="#F59E0B"
                                                             Kind="AlertOutline" />
                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#C2410C"
                                               Text="Point de vente indisponible" />
                                </StackPanel>
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="13"
                                           Foreground="#9A3412"
                                           LineHeight="20"
                                           Text="{Binding NoPosBlockerMessage}"
                                           TextWrapping="Wrap" />
                                <Border Margin="0,18,0,0"
                                        Padding="14,10"
                                        CornerRadius="8">
                                    <Border.Background>
                                        <SolidColorBrush Opacity="0.08"
                                                         Color="{StaticResource WarningColor}" />
                                    </Border.Background>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="16"
                                                                 Height="16"
                                                                 Margin="0,0,8,0"
                                                                 VerticalAlignment="Top"
                                                                 Foreground="#B45309"
                                                                 Kind="LightbulbOnOutline" />
                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                   FontSize="11.5"
                                                   FontStyle="Italic"
                                                   Foreground="#9A3412"
                                                   Text="Fermez cette fenêtre, configurez vos points de vente dans les paramètres, puis réouvrez une session."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!--  ══════════════════════════════════════════════  -->
                        <!--  NO POS — IT TECH BYPASS PANEL  -->
                        <!--  ══════════════════════════════════════════════  -->
                        <Border Margin="0,0,0,28"
                                Padding="28,24"
                                CornerRadius="12"
                                Visibility="{Binding ShowItTechBypass, Converter={StaticResource B2V}}">
                            <Border.Background>
                                <SolidColorBrush Opacity="0.05"
                                                 Color="{StaticResource SuccessColor}" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Opacity="0.25"
                                                 Color="{StaticResource SuccessColor}" />
                            </Border.BorderBrush>
                            <Border.BorderThickness>
                                <Thickness>1.5</Thickness>
                            </Border.BorderThickness>
                            <StackPanel>
                                <StackPanel Margin="0,0,0,16"
                                            Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="28"
                                                             Height="28"
                                                             Margin="0,0,12,0"
                                                             VerticalAlignment="Center"
                                                             Foreground="{StaticResource SuccessBrush}"
                                                             Kind="WrenchOutline" />
                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#166534"
                                               Text="Mode Technicien IT" />
                                </StackPanel>

                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="13"
                                           Foreground="#15803D"
                                           LineHeight="20"
                                           Text="{Binding NoPosBypassMessage}"
                                           TextWrapping="Wrap" />

                                <Border Margin="0,18,0,0"
                                        Padding="14,10"
                                        CornerRadius="8">
                                    <Border.Background>
                                        <SolidColorBrush Opacity="0.08"
                                                         Color="{StaticResource SuccessColor}" />
                                    </Border.Background>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="16"
                                                                 Height="16"
                                                                 Margin="0,0,8,0"
                                                                 VerticalAlignment="Top"
                                                                 Foreground="#166534"
                                                                 Kind="ShieldCheckOutline" />
                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                   FontSize="11.5"
                                                   FontStyle="Italic"
                                                   Foreground="#166534"
                                                   Text="En tant que technicien IT, vous pouvez accéder à l'application en mode configuration pour créer des points de vente, gérer les utilisateurs et configurer le système."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Button Margin="0,22,0,0"
                                        Command="{Binding BypassCommand}"
                                        Style="{StaticResource BypassButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="18"
                                                                 Height="18"
                                                                 Margin="0,0,10,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="White"
                                                                 Kind="ShieldKeyOutline" />
                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   Text="Accéder au mode configuration" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!--  ══════════════════════════════════════  -->
                        <!--  NORMAL FORM (visible only if POS)  -->
                        <!--  ══════════════════════════════════════  -->
                        <StackPanel Visibility="{Binding HasPosAvailable, Converter={StaticResource B2V}}">

                            <!--  ── SECTION: POINT DE VENTE ──  -->
                            <StackPanel Margin="4,0,0,16"
                                        Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="StorefrontOutline"
                                                         Style="{StaticResource SectionIcon}" />
                                <TextBlock Style="{StaticResource SectionLabel}"
                                           Text="POINT DE VENTE ASSIGNÉ" />
                            </StackPanel>

                            <!--  POS Card  -->
                            <Border Margin="0,0,0,12"
                                    Padding="24,18"
                                    CornerRadius="12">
                                <Border.Background>
                                    <SolidColorBrush Opacity="0.06"
                                                     Color="{StaticResource PrimaryColor}" />
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush Opacity="0.2"
                                                     Color="{StaticResource PrimaryColor}" />
                                </Border.BorderBrush>
                                <Border.BorderThickness>
                                    <Thickness>1</Thickness>
                                </Border.BorderThickness>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Icon badge  -->
                                    <Border Grid.Column="0"
                                            Width="44"
                                            Height="44"
                                            Margin="0,0,18,0"
                                            VerticalAlignment="Center"
                                            CornerRadius="11">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Offset="0" Color="#37B1E4" />
                                                <GradientStop Offset="1" Color="#1A8CBF" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <materialDesign:PackIcon Width="20"
                                                                 Height="20"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="White"
                                                                 Kind="MapMarkerOutline" />
                                    </Border>

                                    <!--  POS info  -->
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource AppFont}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="{Binding AssignedPos.Code}" />
                                            <TextBlock FontSize="15"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Text=" — " />
                                            <TextBlock FontFamily="{StaticResource AppFont}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="{Binding AssignedPos.Name}" />
                                        </StackPanel>
                                        <TextBlock Margin="0,4,0,0"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="{Binding AssignedPosDetail}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!--  Hint  -->
                            <StackPanel Margin="8,0,0,32"
                                        Orientation="Horizontal">
                                <materialDesign:PackIcon Width="12"
                                                         Height="12"
                                                         Margin="0,0,5,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource TextMutedBrush}"
                                                         Kind="InformationOutline" />
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="10"
                                           FontStyle="Italic"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="Changez votre POS dans Outils → Gestion des utilisateurs" />
                            </StackPanel>

                            <!--  ── SEPARATOR ──  -->
                            <Separator Height="1"
                                       Margin="0,0,0,32"
                                       Background="{StaticResource BorderLightBrush}" />

                            <!--  ══════════════════════════════════════════════════  -->
                            <!--  TWO-COLUMN: TAUX (left) │ CAISSE (right)  -->
                            <!--  ══════════════════════════════════════════════════  -->
                            <Grid Margin="8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  ═══ LEFT: EXCHANGE RATES ═══  -->
                                <StackPanel Grid.Column="0">

                                    <StackPanel Margin="0,0,0,18"
                                                Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="SwapHorizontal"
                                                                 Style="{StaticResource SectionIcon}" />
                                        <TextBlock Style="{StaticResource SectionLabel}"
                                                   Text="TAUX DE CHANGE" />
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="14" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="14" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="18" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!--  USD  -->
                                        <Border Grid.Row="0"
                                                Grid.Column="0"
                                                Background="#EFF6FF"
                                                Style="{StaticResource CurrBadge}">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#2563EB"
                                                       Text="USD" />
                                        </Border>
                                        <TextBox Grid.Row="0"
                                                 Grid.Column="2"
                                                 PreviewTextInput="NumericInput_PreviewTextInput"
                                                 Style="{StaticResource RateInput}"
                                                 Text="{Binding RateUSD, UpdateSourceTrigger=PropertyChanged}" />

                                        <!--  EUR  -->
                                        <Border Grid.Row="2"
                                                Grid.Column="0"
                                                Background="#F5F3FF"
                                                Style="{StaticResource CurrBadge}">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#7C3AED"
                                                       Text="EUR" />
                                        </Border>
                                        <TextBox Grid.Row="2"
                                                 Grid.Column="2"
                                                 PreviewTextInput="NumericInput_PreviewTextInput"
                                                 Style="{StaticResource RateInput}"
                                                 Text="{Binding RateEUR, UpdateSourceTrigger=PropertyChanged}" />

                                        <!--  CNY  -->
                                        <Border Grid.Row="4"
                                                Grid.Column="0"
                                                Background="#FEF2F2"
                                                Style="{StaticResource CurrBadge}">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#DC2626"
                                                       Text="CNY" />
                                        </Border>
                                        <TextBox Grid.Row="4"
                                                 Grid.Column="2"
                                                 PreviewTextInput="NumericInput_PreviewTextInput"
                                                 Style="{StaticResource RateInput}"
                                                 Text="{Binding RateCNY, UpdateSourceTrigger=PropertyChanged}" />

                                        <!--  CDF (base — locked)  -->
                                        <Border Grid.Row="6"
                                                Grid.Column="0"
                                                Style="{StaticResource CurrBadge}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{StaticResource BorderLightColor}" />
                                            </Border.Background>
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Text="CDF" />
                                        </Border>
                                        <StackPanel Grid.Row="6"
                                                    Grid.Column="2"
                                                    Margin="4,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="13"
                                                                     Height="13"
                                                                     Margin="0,0,6,0"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="{StaticResource TextMutedBrush}"
                                                                     Kind="LockOutline" />
                                            <TextBlock VerticalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="12"
                                                       FontStyle="Italic"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Text="Devise de base" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!--  ═══ VERTICAL DIVIDER ═══  -->
                                <Border Grid.Column="1"
                                        Width="1"
                                        Margin="28,0"
                                        VerticalAlignment="Stretch">
                                    <Border.Background>
                                        <SolidColorBrush Color="{StaticResource BorderLightColor}" />
                                    </Border.Background>
                                </Border>

                                <!--  ═══ RIGHT: CASH ON HAND ═══  -->
                                <StackPanel Grid.Column="2">

                                    <StackPanel Margin="0,0,0,18"
                                                Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CashMultiple"
                                                                 Style="{StaticResource SectionIcon}" />
                                        <TextBlock Style="{StaticResource SectionLabel}"
                                                   Text="FONDS DE CAISSE" />
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="14" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="14" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="14" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!--  USD  -->
                                        <Border Grid.Row="0"
                                                Grid.Column="0"
                                                Background="#EFF6FF"
                                                Style="{StaticResource CurrBadge}">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#2563EB"
                                                       Text="USD" />
                                        </Border>
                                        <TextBox Grid.Row="0"
                                                 Grid.Column="2"
                                                 PreviewTextInput="NumericInput_PreviewTextInput"
                                                 Style="{StaticResource RateInput}"
                                                 Text="{Binding AmountUSD, UpdateSourceTrigger=PropertyChanged}" />

                                        <!--  EUR  -->
                                        <Border Grid.Row="2"
                                                Grid.Column="0"
                                                Background="#F5F3FF"
                                                Style="{StaticResource CurrBadge}">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#7C3AED"
                                                       Text="EUR" />
                                        </Border>
                                        <TextBox Grid.Row="2"
                                                 Grid.Column="2"
                                                 PreviewTextInput="NumericInput_PreviewTextInput"
                                                 Style="{StaticResource RateInput}"
                                                 Text="{Binding AmountEUR, UpdateSourceTrigger=PropertyChanged}" />

                                        <!--  CNY  -->
                                        <Border Grid.Row="4"
                                                Grid.Column="0"
                                                Background="#FEF2F2"
                                                Style="{StaticResource CurrBadge}">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#DC2626"
                                                       Text="CNY" />
                                        </Border>
                                        <TextBox Grid.Row="4"
                                                 Grid.Column="2"
                                                 PreviewTextInput="NumericInput_PreviewTextInput"
                                                 Style="{StaticResource RateInput}"
                                                 Text="{Binding AmountCNY, UpdateSourceTrigger=PropertyChanged}" />

                                        <!--  CDF  -->
                                        <Border Grid.Row="6"
                                                Grid.Column="0"
                                                Style="{StaticResource CurrBadge}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{StaticResource PrimaryLightColor}" />
                                            </Border.Background>
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryDarkBrush}"
                                                       Text="CDF" />
                                        </Border>
                                        <TextBox Grid.Row="6"
                                                 Grid.Column="2"
                                                 PreviewTextInput="NumericInput_PreviewTextInput"
                                                 Style="{StaticResource RateInput}"
                                                 Text="{Binding AmountCDF, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!--  ── TOTAL BAR ──  -->
                            <Border Margin="0,32,0,0"
                                    Padding="26,18"
                                    CornerRadius="12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#0D2B3E" />
                                        <GradientStop Offset="1" Color="#102F45" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="16"
                                                                 Height="16"
                                                                 Margin="0,0,8,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="#7CAFC8"
                                                                 Kind="Calculator" />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#7CAFC8"
                                                   Text="TOTAL FONDS DE CAISSE" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Bottom"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   Text="{Binding TotalEquivCDF}" />
                                        <TextBlock Margin="4,0,0,0"
                                                   VerticalAlignment="Bottom"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="13"
                                                   Foreground="#7CAFC8"
                                                   Text=" CDF" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!--  ── SEPARATOR ──  -->
                            <Separator Height="1"
                                       Margin="0,32"
                                       Background="{StaticResource BorderLightBrush}" />

                            <!--  ── NOTES ──  -->
                            <StackPanel Margin="4,0,0,16"
                                        Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="NoteTextOutline"
                                                         Style="{StaticResource SectionIcon}" />
                                <TextBlock Style="{StaticResource SectionLabel}"
                                           Text="NOTES (OPTIONNEL)" />
                            </StackPanel>
                            <TextBox Height="64"
                                     VerticalContentAlignment="Top"
                                     AcceptsReturn="True"
                                     Style="{StaticResource FormInput}"
                                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" />

                            <!--  ── ERROR ──  -->
                            <Border Margin="0,22,0,0"
                                    Padding="16,12"
                                    CornerRadius="8"
                                    Visibility="{Binding HasError, Converter={StaticResource B2V}}">
                                <Border.Background>
                                    <SolidColorBrush Opacity="0.08"
                                                     Color="{StaticResource ErrorColor}" />
                                </Border.Background>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16"
                                                             Height="16"
                                                             Margin="0,0,10,0"
                                                             VerticalAlignment="Center"
                                                             Foreground="{StaticResource ErrorBrush}"
                                                             Kind="AlertCircleOutline" />
                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                               FontSize="12"
                                               Foreground="{StaticResource ErrorBrush}"
                                               Text="{Binding ErrorMessage}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!--  ── CONFIRM BUTTON ──  -->
                            <Button Margin="0,28,0,0"
                                    Command="{Binding ConfirmCommand}"
                                    IsDefault="True"
                                    Style="{StaticResource ConfirmButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="20"
                                                             Height="20"
                                                             Margin="0,0,10,0"
                                                             VerticalAlignment="Center"
                                                             Foreground="White"
                                                             Kind="PlayCircleOutline" />
                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               Text="Ouvrir la session de caisse" />
                                </StackPanel>
                            </Button>

                        </StackPanel>

                        <!--  ── LOADING ──  -->
                        <StackPanel Margin="0,22,0,0"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Visibility="{Binding IsLoading, Converter={StaticResource B2V}}">
                            <materialDesign:PackIcon Width="16"
                                                     Height="16"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     Kind="Loading">
                                <materialDesign:PackIcon.RenderTransform>
                                    <RotateTransform x:Name="LoadingRotation" CenterX="8" CenterY="8" />
                                </materialDesign:PackIcon.RenderTransform>
                                <materialDesign:PackIcon.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="LoadingRotation"
                                                                 Storyboard.TargetProperty="Angle"
                                                                 From="0"
                                                                 To="360"
                                                                 Duration="0:0:1" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </materialDesign:PackIcon.Triggers>
                            </materialDesign:PackIcon>
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="12"
                                       Foreground="#7CAFC8"
                                       Text="Chargement en cours…" />
                        </StackPanel>

                        <!--  ── FOOTER ──  -->
                        <StackPanel Margin="0,32,0,16"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">
                            <materialDesign:PackIcon Width="13"
                                                     Height="13"
                                                     Margin="0,0,5,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource BorderBrush}"
                                                     Kind="ShieldCheckOutline" />
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="11"
                                       Foreground="{StaticResource BorderBrush}"
                                       Text="iSFE v1.0.0 · Conforme DGI-RDC" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>