<Window x:Class="SFE.WPF.Views.Pages.LicenseBlockedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Licence SFE"
        Height="560" Width="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="pack://application:,,,/MaterialDesignThemes.Wpf;component/Resources/Roboto/#Roboto">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header banner -->
        <Border Grid.Row="0" Background="#FFF3F3" BorderBrush="#F5C6C6" BorderThickness="0,0,0,1" Padding="24,20">
            <StackPanel Orientation="Horizontal">
                <md:PackIcon Kind="ShieldAlertOutline" Width="44" Height="44"
                             VerticalAlignment="Center" Foreground="#D32F2F"/>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Licence SFE indisponible"
                               FontSize="22" FontWeight="Bold"
                               Foreground="#B71C1C"/>
                    <TextBlock Text="L'accès à l'application est bloqué tant qu'une licence valide n'est pas installée."
                               FontSize="13" Margin="0,4,0,0"
                               Foreground="#5C1A1A"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20,24,0">
            <StackPanel>

                <!-- Status message -->
                <Border Background="{DynamicResource MaterialDesignChipBackground}"
                        CornerRadius="4" Padding="12,10" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="InformationOutline" Width="20" Height="20"
                                     VerticalAlignment="Top" Foreground="#1976D2" Margin="0,2,10,0"/>
                        <TextBlock x:Name="StatusText"
                                   FontSize="14" TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Instructions -->
                <TextBlock Text="Comment procéder ?"
                           FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="20">
                    <Run Text="1."/>
                    <Run Text="Communiquez les informations machine ci-dessous à votre fournisseur SFE."/>
                    <LineBreak/>
                    <Run Text="2."/>
                    <Run Text="Récupérez le fichier de licence "/>
                    <Run Text=".lic" FontFamily="Consolas" FontWeight="SemiBold"/>
                    <Run Text=" fourni en retour."/>
                    <LineBreak/>
                    <Run Text="3."/>
                    <Run Text="Cliquez sur « Installer une licence » pour l'importer."/>
                </TextBlock>

                <!-- Machine info card -->
                <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="1" CornerRadius="6" Padding="16,12">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <md:PackIcon Kind="DesktopClassic" Width="20" Height="20"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="Informations machine"
                                           FontWeight="SemiBold" FontSize="14"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="CopyButton"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Click="CopyButton_Click"
                                    ToolTip="Copier les informations machine dans le presse-papiers"
                                    Padding="8,4" MinHeight="0" MinWidth="0">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon x:Name="CopyIcon" Kind="ContentCopy"
                                                 Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CopyButtonText" Text="COPIER"
                                               Margin="6,0,0,0" VerticalAlignment="Center"
                                               FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Separator Margin="0,8"/>

                        <TextBox x:Name="FingerprintText"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource MaterialDesignBody}"
                                 VerticalScrollBarVisibility="Auto"
                                 MaxHeight="140"
                                 Padding="0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer with actions -->
        <Border Grid.Row="2" Background="{DynamicResource MaterialDesignToolBarBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           FontSize="12">
                    <md:PackIcon Kind="EmailOutline" Width="14" Height="14"/>
                    <Run Text=" Besoin d'aide ? Contactez votre fournisseur SFE."/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="QuitButton" Content="QUITTER"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Click="QuitButton_Click" Margin="0,0,8,0"/>
                    <Button x:Name="InstallButton"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="InstallButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="FileKeyOutline" Width="18" Height="18"
                                         VerticalAlignment="Center"/>
                            <TextBlock Text="INSTALLER UNE LICENCE..." Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>