<Window x:Class="SFE.WPF.Views.Pages.OfflineQrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SFE.WPF.Converters"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Paiement hors-ligne" Width="440" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="24">
        <!-- Loading -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                         Value="0" IsIndeterminate="True" Width="48" Height="48"/>
            <TextBlock Text="Génération du code…" Margin="0,16,0,0" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Ready -->
        <DockPanel Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
            <TextBlock DockPanel.Dock="Top" Text="{Binding Caption}"
                       TextWrapping="Wrap" TextAlignment="Center"
                       FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding AmountText}"
                       TextAlignment="Center" FontSize="26" FontWeight="Bold"
                       Margin="0,0,0,16"/>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}"
                       TextWrapping="Wrap" TextAlignment="Center" Opacity="0.7"
                       Margin="0,16,0,0"/>
            <Button DockPanel.Dock="Bottom" Content="Fermer" Command="{Binding CloseCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,12,0,0"/>
            <Border Background="White" Padding="12" CornerRadius="8"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="{Binding QrImage}" Width="280" Height="280"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>
        </DockPanel>

        <!-- Logical stop (nothing due / not found) -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding ShowCloseOnly, Converter={StaticResource BoolToVis}}">
            <materialDesign:PackIcon Kind="InformationOutline" Width="48" Height="48"
                                     HorizontalAlignment="Center" Opacity="0.6"/>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,16,0,24" MaxWidth="320"/>
            <Button Content="Fermer" Command="{Binding CloseCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Retryable error -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}">
            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="48" Height="48"
                                     HorizontalAlignment="Center" Opacity="0.6"/>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,16,0,24" MaxWidth="320"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Réessayer" Command="{Binding RefreshCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"/>
                <Button Content="Fermer" Command="{Binding CloseCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>