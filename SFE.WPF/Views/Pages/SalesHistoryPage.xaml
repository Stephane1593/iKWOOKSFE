<UserControl x:Class="SFE.WPF.Views.Pages.SalesHistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SFE.WPF.Views.Pages"
             xmlns:conv="clr-namespace:SFE.WPF.Converters"
             Background="#F1F5F9">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>

        <!-- ═══ FLAT BUTTON ═══ -->
        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ GHOST BUTTON ═══ -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="#CBD5E1" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ LINK BUTTON ═══ -->
        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="txt" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="txt" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ ICON BUTTON (panel toolbar) ═══ -->
        <Style x:Key="SmallIconBtn" TargetType="Button">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ COMPACT INPUT ═══ -->
        <Style x:Key="FilterInput" TargetType="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Filter strip -->
            <RowDefinition Height="Auto"/>
            <!-- Period presets -->
            <RowDefinition Height="Auto"/>
            <!-- Stats cards -->
            <RowDefinition Height="*"/>
            <!-- Two-column content -->
            <RowDefinition Height="Auto"/>
            <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════
             ROW 0: HEADER
             ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="White" Padding="24,14"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Background="#DBEAFE" CornerRadius="8"
                        Width="42" Height="42" Margin="0,0,14,0">
                    <TextBlock Text="📋" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Journal de vente" FontSize="20" FontWeight="Bold"
                               Foreground="#0F172A"/>
                    <TextBlock Text="Historique complet des factures normalisées"
                               FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Search -->
                <Border Grid.Column="2" Background="#F8FAFC" CornerRadius="8"
                        BorderBrush="#E2E8F0" BorderThickness="1"
                        Padding="10,0" Margin="0,0,10,0" Width="260">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="12" Background="Transparent" BorderThickness="0"
                                 VerticalAlignment="Center" Padding="0,8"
                                 ToolTip="Recherche par numéro, client, code DEF...">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource GhostBtn}"
                            Command="{Binding ResetFiltersCommand}"
                            Content="🔄 Réinitialiser" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource FlatBtn}" Background="#3B82F6"
                            Command="{Binding SearchCommand}"
                            Content="🔍 Rechercher"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════
             ROW 1: FILTER STRIP
             ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="White" Padding="24,10"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- User -->
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- E-UF -->
                    <ColumnDefinition Width="20"/>
                    <!-- separator -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Du label -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Du picker -->
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Au label -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Au picker -->
                    <ColumnDefinition Width="20"/>
                    <!-- separator -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Type -->
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Statut -->
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Apply -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- User / Operator -->
                <!-- User / Operator — DROPDOWN -->
                <StackPanel>
                    <TextBlock Text="Opérateur" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                    <ComboBox Style="{StaticResource FilterCombo}" Width="150"
              ItemsSource="{Binding AvailableOperators}"
              SelectedItem="{Binding FilterOperator}"
              IsEditable="True" IsTextSearchEnabled="True"
              Text="{Binding FilterOperator, UpdateSourceTrigger=PropertyChanged}"
              ToolTip="Filtrer par opérateur">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- E-UF Reference -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Réf. E-UF" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                    <TextBox Style="{StaticResource FilterInput}" Width="110"
                             Text="{Binding FilterReference, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" ToolTip="Filtrer par référence E-UF"/>
                </StackPanel>

                <!-- Separator -->
                <Border Grid.Column="3" Width="1" Background="#E2E8F0" Margin="8,4"/>

                <!-- Du -->
                <TextBlock Grid.Column="4" Text="Du :" FontSize="12" Foreground="#64748B"
                           VerticalAlignment="Bottom" Margin="0,0,6,6"/>
                <DatePicker Grid.Column="5" FontSize="12" Width="130"
                            SelectedDate="{Binding DateFrom}"
                            VerticalAlignment="Bottom"/>

                <!-- Au -->
                <TextBlock Grid.Column="7" Text="Au :" FontSize="12" Foreground="#64748B"
                           VerticalAlignment="Bottom" Margin="0,0,6,6"/>
                <DatePicker Grid.Column="8" FontSize="12" Width="130"
                            SelectedDate="{Binding DateTo}"
                            VerticalAlignment="Bottom"/>

                <!-- Separator -->
                <Border Grid.Column="9" Width="1" Background="#E2E8F0" Margin="8,4"/>

                <!-- Type -->
                <StackPanel Grid.Column="10">
                    <TextBlock Text="Type" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                    <ComboBox Style="{StaticResource FilterCombo}" Width="100"
                              ItemsSource="{Binding FilterTypes}"
                              SelectedItem="{Binding FilterType}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="12">
                                    <TextBlock.Text>
                                        <Binding FallbackValue="Tous">
                                            <Binding.TargetNullValue>Tous</Binding.TargetNullValue>
                                        </Binding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Statut -->
                <StackPanel Grid.Column="12">
                    <TextBlock Text="Statut" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                    <ComboBox Style="{StaticResource FilterCombo}" Width="120"
                              ItemsSource="{Binding FilterStatuses}"
                              SelectedItem="{Binding FilterStatus}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="12">
                                    <TextBlock.Text>
                                        <Binding FallbackValue="Tous">
                                            <Binding.TargetNullValue>Tous</Binding.TargetNullValue>
                                        </Binding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Apply -->
                <Button Grid.Column="14" Style="{StaticResource FlatBtn}"
                        Background="#1E40AF" VerticalAlignment="Bottom"
                        Command="{Binding SearchCommand}"
                        Content="🔍 Appliquer"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════
             ROW 2: PERIOD PRESETS
             ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="White" Padding="24,8,24,10"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <ItemsControl ItemsSource="{Binding PeriodPresets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}" Margin="0,0,6,0"
                                Padding="10,5" Cursor="Hand" FontSize="11"
                                BorderThickness="1" BorderBrush="#E2E8F0"
                                Background="#F8FAFC" Foreground="#475569"
                                Command="{Binding DataContext.SetPeriodCommand,
                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="14" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#DBEAFE"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#93C5FD"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- ═══════════════════════════════════════════════════
             ROW 3: STATS CARDS (compact horizontal strip)
             ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Padding="16,10,16,4">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled" Height="70">
                <StackPanel Orientation="Horizontal">

                    <!-- Total ventes -->
                    <Border Background="White" CornerRadius="10" Padding="16,10"
                            Width="160" Margin="0,0,10,0"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Total ventes" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock FontSize="22" FontWeight="Bold" Foreground="#3B82F6" Margin="0,2,0,0">
                                <Run Text="{Binding StatsTotalCount, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- CA TTC -->
                    <Border Background="White" CornerRadius="10" Padding="16,10"
                            Width="190" Margin="0,0,10,0"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="💰 Chiffre d'affaires" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock FontSize="20" FontWeight="Bold" Foreground="#059669" Margin="0,2,0,0">
                                <Run Text="{Binding StatsTotalTTC, StringFormat=N0, Mode=OneWay}"/>
                                <Run Text=" CDF" FontSize="11"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- TVA -->
                    <Border Background="White" CornerRadius="10" Padding="16,10"
                            Width="170" Margin="0,0,10,0"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🏛 TVA collectée" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock FontSize="20" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,2,0,0">
                                <Run Text="{Binding StatsTotalTVA, StringFormat=N0, Mode=OneWay}"/>
                                <Run Text=" CDF" FontSize="11"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Panier moyen -->
                    <Border Background="White" CornerRadius="10" Padding="16,10"
                            Width="160" Margin="0,0,10,0"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🧮 Panier moyen" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock FontSize="20" FontWeight="Bold" Foreground="#F59E0B" Margin="0,2,0,0">
                                <Run Text="{Binding StatsAverage, StringFormat=N0, Mode=OneWay}"/>
                                <Run Text=" CDF" FontSize="11"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Répartition par type (all 6) -->
                    <Border Background="White" CornerRadius="10" Padding="16,8"
                            Margin="0,0,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📄 Répartition" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <WrapPanel>
                                <Border Background="#DBEAFE" CornerRadius="5" Padding="7,3" Margin="0,0,4,3">
                                    <TextBlock FontSize="10" FontWeight="Bold">
                                        <Run Text="FV " Foreground="#3B82F6"/>
                                        <Run Text="{Binding StatsFVCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                                <Border Background="#EDE9FE" CornerRadius="5" Padding="7,3" Margin="0,0,4,3">
                                    <TextBlock FontSize="10" FontWeight="Bold">
                                        <Run Text="FT " Foreground="#8B5CF6"/>
                                        <Run Text="{Binding StatsFTCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                                <Border Background="#FEF3C7" CornerRadius="5" Padding="7,3" Margin="0,0,4,3">
                                    <TextBlock FontSize="10" FontWeight="Bold">
                                        <Run Text="FA " Foreground="#D97706"/>
                                        <Run Text="{Binding StatsFACount, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                                <Border Background="#FEE2E2" CornerRadius="5" Padding="7,3" Margin="0,0,4,3">
                                    <TextBlock FontSize="10" FontWeight="Bold">
                                        <Run Text="EV " Foreground="#EF4444"/>
                                        <Run Text="{Binding StatsEVCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                                <Border Background="#FECACA" CornerRadius="5" Padding="7,3" Margin="0,0,4,3">
                                    <TextBlock FontSize="10" FontWeight="Bold">
                                        <Run Text="EA " Foreground="#DC2626"/>
                                        <Run Text="{Binding StatsEACount, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                                <Border Background="#E0E7FF" CornerRadius="5" Padding="7,3" Margin="0,0,0,3">
                                    <TextBlock FontSize="10" FontWeight="Bold">
                                        <Run Text="ET " Foreground="#4F46E5"/>
                                        <Run Text="{Binding StatsETCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══════════════════════════════════════════════════
             ROW 4: TWO-COLUMN CONTENT (Table + Detail)
             ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="4" Margin="16,8,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ──────────────────────────────────
                 LEFT: DATA TABLE + PAGINATION
                 ────────────────────────────────── -->
            <Border Grid.Column="0" Background="White"
                    CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <!-- No results -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding NoResults, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="📭" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock Text="Aucune facture trouvée" FontSize="15" Foreground="#94A3B8"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Text="Essayez d'élargir vos critères de recherche"
                                       FontSize="12" Foreground="#CBD5E1"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- DataGrid -->
                        <DataGrid ItemsSource="{Binding Invoices}"
                                  SelectedItem="{Binding SelectedInvoice}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F5F9"
                                  BorderThickness="0" Background="White"
                                  RowBackground="White" AlternatingRowBackground="#FAFBFC"
                                  FontSize="12" CanUserResizeRows="False" SelectionUnit="FullRow">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="12,8" Background="{TemplateBinding Background}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#EFF6FF"/>
                                            <Setter Property="Foreground" Value="#1E293B"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F8FAFC"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#EFF6FF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <!-- Date -->
                                <DataGridTemplateColumn Header="Date" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DateDisplay}" FontSize="12"
                                                           Foreground="#1E293B" FontWeight="Medium"/>
                                                <TextBlock Text="{Binding TimeDisplay}" FontSize="10"
                                                           Foreground="#94A3B8"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Type badge -->
                                <DataGridTemplateColumn Header="Type" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="5" Padding="6,2"
                                                    HorizontalAlignment="Left"
                                                    Background="{Binding TypeBadgeBg}">
                                                <TextBlock Text="{Binding TypeLabel}"
                                                           FontSize="10" FontWeight="Bold"
                                                           Foreground="{Binding TypeColor}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Numéro -->
                                <DataGridTextColumn Header="Numéro" Width="90" Binding="{Binding InvoiceNumber}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="Foreground" Value="#1E293B"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Code DEF -->
                                <DataGridTextColumn Header="Code DEF" Width="120" Binding="{Binding CodeDEFShort}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="FontSize" Value="10"/>
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Client -->
                                <DataGridTextColumn Header="Client" Width="*" Binding="{Binding ClientName}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#475569"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Payment -->
                                <DataGridTemplateColumn Header="💳" Width="35">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PaymentIcon}" FontSize="14"
                                                       HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Montant TTC -->
                                <DataGridTextColumn Header="Montant TTC" Width="110" Binding="{Binding TotalDisplay}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="#1E293B"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Statut -->
                                <DataGridTemplateColumn Header="Statut" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="6,2"
                                                    HorizontalAlignment="Center"
                                                    Background="{Binding StatusBadgeBg}">
                                                <TextBlock FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{Binding StatusColor}">
                                                    <Run Text="{Binding StatusIcon, Mode=OneWay}"/>
                                                    <Run Text=" "/>
                                                    <Run Text="{Binding StatusLabel, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Actions -->
                                <DataGridTemplateColumn Header="Action" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Voir →" Style="{StaticResource LinkBtn}"
                                                        Command="{Binding DataContext.ViewInvoiceCommand,
                                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" Margin="0,0,8,0"/>
                                                <Button Content="🖨" FontSize="13" Padding="2"
                                                        Background="Transparent" BorderThickness="0"
                                                        Cursor="Hand" ToolTip="Réimprimer"
                                                        Command="{Binding DataContext.ReprintInvoiceCommand,
                                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Pagination footer -->
                    <Border Grid.Row="1" Padding="14,10"
                            BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
                            Background="#FAFBFC">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding PaginationInfo}" FontSize="12"
                                       Foreground="#94A3B8" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource GhostBtn}" Content="⏮" Padding="6,4"
                                        Command="{Binding GoFirstPageCommand}"
                                        IsEnabled="{Binding CanGoBack}" Margin="0,0,3,0" FontSize="11"/>
                                <Button Style="{StaticResource GhostBtn}" Content="◀" Padding="6,4"
                                        Command="{Binding GoPreviousPageCommand}"
                                        IsEnabled="{Binding CanGoBack}" Margin="0,0,3,0" FontSize="11"/>
                                <Border Background="#3B82F6" CornerRadius="6" Padding="10,4" Margin="0,0,3,0">
                                    <TextBlock FontSize="11" Foreground="White" FontWeight="Bold">
                                        <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                                        <Run Text=" / "/>
                                        <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                                <Button Style="{StaticResource GhostBtn}" Content="▶" Padding="6,4"
                                        Command="{Binding GoNextPageCommand}"
                                        IsEnabled="{Binding CanGoForward}" Margin="0,0,3,0" FontSize="11"/>
                                <Button Style="{StaticResource GhostBtn}" Content="⏭" Padding="6,4"
                                        Command="{Binding GoLastPageCommand}"
                                        IsEnabled="{Binding CanGoForward}" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ──────────────────────────────────
                 RIGHT: INLINE DETAIL PANEL
                 ────────────────────────────────── -->
            <Border Grid.Column="1"
                    Width="420" Margin="12,0,0,0"
                    Background="White" CornerRadius="10"
                    BorderBrush="#E2E8F0" BorderThickness="1"
                    Visibility="{Binding ShowDetailPanel, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- header -->
                        <RowDefinition Height="Auto"/>
                        <!-- totals -->
                        <RowDefinition Height="Auto"/>
                        <!-- client -->
                        <RowDefinition Height="*"/>
                        <!-- items -->
                        <RowDefinition Height="Auto"/>
                        <!-- code DEF -->
                        <RowDefinition Height="Auto"/>
                        <!-- footer -->
                    </Grid.RowDefinitions>

                    <!-- ── Panel header ── -->
                    <Border Grid.Row="0" Padding="16,12"
                            BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄 " FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DetailTypeLabel}"
                                               FontWeight="Bold" FontSize="14" Foreground="#1E293B"/>
                                </StackPanel>
                                <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0">
                                    <Run Text="{Binding DetailNumber, Mode=OneWay}"/>
                                    <Run Text="  •  "/>
                                    <Run Text="{Binding DetailDate, Mode=OneWay}"/>
                                    <Run Text="  •  "/>
                                    <Run Text="{Binding DetailOperator, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Pop out -->
                            <Button Grid.Column="1" Style="{StaticResource SmallIconBtn}"
                                    Content="⧉" ToolTip="Ouvrir dans une fenêtre"
                                    Command="{Binding PopOutDetailCommand}" Margin="4,0"/>
                            <!-- Copy DEF -->
                            <Button Grid.Column="2" Style="{StaticResource SmallIconBtn}"
                                    Content="📋" ToolTip="Copier Code DEF"
                                    Command="{Binding CopyCodeDEFCommand}" Margin="0,0,4,0"/>
                            <!-- Close -->
                            <Button Grid.Column="3" Style="{StaticResource SmallIconBtn}"
                                    Content="✕" ToolTip="Fermer le panneau"
                                    Command="{Binding CloseDetailPanelCommand}"/>
                        </Grid>
                    </Border>

                    <!-- ── Totals strip ── -->
                    <Border Grid.Row="1" Padding="12,10"
                            BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                            Background="#F8FAFC">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Total HT -->
                            <Border Background="White" CornerRadius="8" Padding="10,8" Margin="0,0,6,0"
                                    BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Total HT" FontSize="9" Foreground="#94A3B8"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding DetailTotalHT}" FontSize="14" FontWeight="Bold"
                                               Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- TVA -->
                            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="10,8" Margin="0,0,6,0"
                                    BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="TVA" FontSize="9" Foreground="#94A3B8"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding DetailTotalTVA}" FontSize="14" FontWeight="Bold"
                                               Foreground="#8B5CF6" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Total TTC -->
                            <Border Grid.Column="2" Background="#EFF6FF" CornerRadius="8" Padding="10,8"
                                    BorderBrush="#93C5FD" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Total TTC" FontSize="9" Foreground="#3B82F6"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding DetailTotalTTC}" FontSize="14" FontWeight="Bold"
                                               Foreground="#1D4ED8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ── Client info ── -->
                    <Border Grid.Row="2" Padding="14,10"
                            BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Client" FontSize="9" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding DetailClient}" FontSize="13" FontWeight="Medium"
                                           Foreground="#1E293B" Margin="0,1,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="NIF" FontSize="9" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding DetailClientNIF}" FontSize="11"
                                           FontFamily="Consolas" Foreground="#475569" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ── Items table (scrollable) ── -->
                    <Border Grid.Row="3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Items header -->
                            <Border Background="#F8FAFC" Padding="14,8"
                                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Article" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                    <TextBlock Grid.Column="1" Text="Qté" FontSize="10" FontWeight="SemiBold"
                                               Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="P.U." FontSize="10" FontWeight="SemiBold"
                                               Foreground="#94A3B8" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="TVA" FontSize="10" FontWeight="SemiBold"
                                               Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="Total" FontSize="10" FontWeight="SemiBold"
                                               Foreground="#94A3B8" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- Items rows -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding DetailLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="14,7" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="45"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="70"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                                               Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding QuantityDisplay}"
                                                               FontSize="11" Foreground="#475569"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding UnitPriceDisplay}"
                                                               FontSize="11" Foreground="#475569"
                                                               HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding TVADisplay}"
                                                               FontSize="10" Foreground="#94A3B8"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding TotalDisplay}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="#1E293B" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- ── Code DEF ── -->
                    <Border Grid.Row="4" Padding="14,8"
                            BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
                            Background="#0F172A">
                        <StackPanel>
                            <TextBlock Text="Code DEF / DGI" FontSize="9" Foreground="#64748B" Margin="0,0,0,3"/>
                            <TextBlock Text="{Binding DetailCodeDEF}"
                                       FontFamily="Consolas" FontSize="10"
                                       Foreground="#E2E8F0" TextWrapping="Wrap"
                                       LineHeight="15"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Footer actions ── -->
                    <Border Grid.Row="5" Padding="12,10"
                            BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
                            Background="#F8FAFC">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostBtn}" FontSize="12"
                                    Content="🖨 Imprimer"
                                    Command="{Binding PrintInvoiceCommand}"
                                    Margin="0,0,8,0"/>
                            <Button Style="{StaticResource GhostBtn}" FontSize="12"
                                    Content="📤 Exporter"
                                    Command="{Binding ExportPdfCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════
             ROW 5: STATUS BAR
             ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="5" Padding="16,6"
                Visibility="{Binding ShowSuccess, Converter={StaticResource BoolVis}}"
                Background="#ECFDF5">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#059669" FontSize="12"/>
        </Border>
        <Border Grid.Row="5" Padding="16,6"
                Visibility="{Binding ShowError, Converter={StaticResource BoolVis}}"
                Background="#FEF2F2">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#DC2626" FontSize="12"/>
        </Border>

        <!-- ═══════════════════════════════════════════════════
             OVERLAY: Full document view (pop-out)
             ═══════════════════════════════════════════════════ -->
        <!-- ═══════════════════════════════════════════════════
             OVERLAY: Full document view (pop-out)
             ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Grid.RowSpan="6" Panel.ZIndex="100"
              Visibility="{Binding ShowDocument, Converter={StaticResource BoolVis}}">

            <!-- Dark backdrop — click to close -->
            <Border Background="#CC000000" MouseLeftButtonDown="OnOverlayBackdropClick"/>

            <!-- Dialog card -->
            <Border Background="#F8FAFC" CornerRadius="16"
                    Margin="50,24" MaxWidth="880"
                    MaxHeight="720"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8"
                                      Opacity="0.25" Direction="270" Color="#000"/>
                </Border.Effect>

                <DockPanel>
                    <!-- ── Toolbar ── -->
                    <Border DockPanel.Dock="Top" Background="White"
                            CornerRadius="16,16,0,0" Padding="20,14"
                            BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📄" FontSize="20" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding DocumentViewModel.TypeTitle}"
                                               FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                                    <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#94A3B8">
                                        <Run Text="{Binding DocumentViewModel.InvoiceNumber, Mode=OneWay}"/>
                                        <Run Text="  ·  "/>
                                        <Run Text="{Binding DocumentViewModel.CreatedAtDisplay, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource FlatBtn}" Background="#3B82F6"
                                        Command="{Binding PrintInvoiceCommand}"
                                        Content="🖨 Imprimer" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource FlatBtn}" Background="#059669"
                                        Command="{Binding ExportPdfCommand}"
                                        Content="📥 Télécharger" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource GhostBtn}"
                                        Command="{Binding CopyCodeDEFCommand}"
                                        Content="📋 Code DEF" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource SmallIconBtn}"
                                        Content="✕" FontSize="18"
                                        Command="{Binding CloseDocumentCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ── Document scroll area ── -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="24,16" Background="#F1F5F9">
                        <Border HorizontalAlignment="Center" Background="White"
                                BorderBrush="#E2E8F0" BorderThickness="1"
                                Margin="0,0,0,16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                                  Opacity="0.08" Direction="270"/>
                            </Border.Effect>
                            <ContentControl Content="{Binding DocumentViewModel}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <vm:InvoiceDocumentView DataContext="{Binding}"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </Border>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══ LOADING ═══ -->
        <Border Grid.Row="0" Grid.RowSpan="6" Panel.ZIndex="200"
                Background="#80FFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <Border Background="White" CornerRadius="12" Padding="32,24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4"
                                      Opacity="0.12" Direction="270"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⏳" FontSize="20" Margin="0,0,12,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Chargement..." FontSize="14"
                               Foreground="#64748B" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>