<UserControl x:Class="SFE.WPF.Views.Pages.SalesHistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SFE.WPF.Views.Pages"
             Background="#F0F2F5">

    <Grid>
        <!-- Contenu principal -->
        <DockPanel Margin="20,16">

            <!-- ═══════════════════════════════════════════════ -->
            <!-- HEADER                                          -->
            <!-- ═══════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top" Background="White" CornerRadius="14"
                    Padding="20,16" Margin="0,0,0,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.06" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Titre + Recherche -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="📋 Journal des ventes" FontFamily="{StaticResource AppFont}"
                                       FontSize="20" FontWeight="Bold"/>
                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0">
                                <Run Text="Historique complet des transactions normalisées"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Barre de recherche -->
                        <Border Grid.Column="1" Background="#F3F4F6" CornerRadius="10"
                                Margin="24,0" Padding="14,0" MaxWidth="400">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource AppFont}" FontSize="13"
                                         Background="Transparent" BorderThickness="0"
                                         VerticalAlignment="Center" Padding="0,10"/>
                                <Button Grid.Column="2" Content="Chercher"
                                        Command="{Binding SearchCommand}"
                                        FontFamily="{StaticResource AppFont}" FontSize="11"
                                        Padding="12,6" Background="{StaticResource PrimaryBrush}"
                                        Foreground="White" BorderThickness="0" Cursor="Hand"
                                        Margin="8,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Bouton Reset -->
                        <Button Grid.Column="2" Command="{Binding ResetFiltersCommand}"
                                Background="#F3F4F6" BorderThickness="0" Cursor="Hand"
                                Padding="12,8" ToolTip="Réinitialiser les filtres">
                            <TextBlock Text="🔄 Réinitialiser" FontFamily="{StaticResource AppFont}"
                                       FontSize="12"/>
                        </Button>
                    </Grid>

                    <!-- Périodes rapides -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled" Margin="0,12,0,0"
                                  Height="38">
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{Binding PeriodPresets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" Margin="0,0,6,0"
                                                Padding="12,6" Cursor="Hand"
                                                FontFamily="{StaticResource AppFont}" FontSize="12"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.SetPeriodCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#F3F4F6"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Dates + Filtres Type/Status -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Du" FontFamily="{StaticResource AppFont}" FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <DatePicker SelectedDate="{Binding DateFrom}"
                                        FontFamily="{StaticResource AppFont}" FontSize="12"
                                        Width="130"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="Au" FontFamily="{StaticResource AppFont}" FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <DatePicker SelectedDate="{Binding DateTo}"
                                        FontFamily="{StaticResource AppFont}" FontSize="12"
                                        Width="130"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="Type" FontFamily="{StaticResource AppFont}" FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <ComboBox ItemsSource="{Binding FilterTypes}"
                                      SelectedItem="{Binding FilterType}"
                                      FontFamily="{StaticResource AppFont}" FontSize="12"
                                      Width="100" Padding="6,4">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12">
                                            <TextBlock.Text>
                                                <Binding FallbackValue="Tous" StringFormat="{}">
                                                    <Binding.TargetNullValue>Tous</Binding.TargetNullValue>
                                                </Binding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="0,0,12,0">
                            <TextBlock Text="Statut" FontFamily="{StaticResource AppFont}" FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <ComboBox ItemsSource="{Binding FilterStatuses}"
                                      SelectedItem="{Binding FilterStatus}"
                                      FontFamily="{StaticResource AppFont}" FontSize="12"
                                      Width="120" Padding="6,4">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12">
                                            <TextBlock.Text>
                                                <Binding FallbackValue="Tous" StringFormat="{}">
                                                    <Binding.TargetNullValue>Tous</Binding.TargetNullValue>
                                                </Binding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Bouton Appliquer -->
                        <Button Grid.Column="4" Content="🔍 Appliquer"
                                Command="{Binding SearchCommand}"
                                FontFamily="{StaticResource AppFont}" FontSize="12"
                                Padding="14,8" Background="{StaticResource PrimaryBrush}"
                                Foreground="White" BorderThickness="0" Cursor="Hand"
                                VerticalAlignment="Bottom"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- CARTES STATS                                    -->
            <!-- ═══════════════════════════════════════════════ -->
            <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled" Margin="0,0,0,14"
                          Height="90">
                <StackPanel Orientation="Horizontal">
                    <!-- Total ventes -->
                    <Border Background="White" CornerRadius="12" Padding="20,14"
                            Width="190" Margin="0,0,12,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" Opacity="0.05" ShadowDepth="1"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="📊 Total ventes" FontFamily="{StaticResource AppFont}"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="24"
                                       FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                                       Margin="0,4,0,0">
                                <Run Text="{Binding StatsTotalCount, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Total TTC -->
                    <Border Background="White" CornerRadius="12" Padding="20,14"
                            Width="220" Margin="0,0,12,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" Opacity="0.05" ShadowDepth="1"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="💰 Chiffre d'affaires" FontFamily="{StaticResource AppFont}"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="22"
                                       FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0">
                                <Run Text="{Binding StatsTotalTTC, StringFormat=N0, Mode=OneWay}"/>
                                <Run Text=" CDF" FontSize="12"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- TVA collectée -->
                    <Border Background="White" CornerRadius="12" Padding="20,14"
                            Width="200" Margin="0,0,12,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" Opacity="0.05" ShadowDepth="1"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="🏛 TVA collectée" FontFamily="{StaticResource AppFont}"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="22"
                                       FontWeight="Bold" Foreground="#8B5CF6" Margin="0,4,0,0">
                                <Run Text="{Binding StatsTotalTVA, StringFormat=N0, Mode=OneWay}"/>
                                <Run Text=" CDF" FontSize="12"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Panier moyen -->
                    <Border Background="White" CornerRadius="12" Padding="20,14"
                            Width="190" Margin="0,0,12,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" Opacity="0.05" ShadowDepth="1"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="🧮 Panier moyen" FontFamily="{StaticResource AppFont}"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="22"
                                       FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,0">
                                <Run Text="{Binding StatsAverage, StringFormat=N0, Mode=OneWay}"/>
                                <Run Text=" CDF" FontSize="12"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Répartition FV/FT/EV -->
                    <Border Background="White" CornerRadius="12" Padding="20,14"
                            Width="200" Margin="0,0,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" Opacity="0.05" ShadowDepth="1"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="📄 Répartition" FontFamily="{StaticResource AppFont}"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Background="#DBEAFE" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="Bold">
                                        <Run Text="FV " Foreground="#3B82F6"/>
                                        <Run Text="{Binding StatsFVCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                                <Border Background="#EDE9FE" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="Bold">
                                        <Run Text="FT " Foreground="#8B5CF6"/>
                                        <Run Text="{Binding StatsFTCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                                <Border Background="#FEE2E2" CornerRadius="6" Padding="8,4">
                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="Bold">
                                        <Run Text="EV " Foreground="#EF4444"/>
                                        <Run Text="{Binding StatsEVCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- STATUS BAR                                      -->
            <!-- ═══════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,8" CornerRadius="8" Padding="12,6"
                    Visibility="{Binding ShowSuccess, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#ECFDF5">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                           FontFamily="{StaticResource AppFont}" FontSize="12"/>
            </Border>
            <Border DockPanel.Dock="Top" Margin="0,0,0,8" CornerRadius="8" Padding="12,6"
                    Visibility="{Binding ShowError, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#FEF2F2">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource ErrorBrush}"
                           FontFamily="{StaticResource AppFont}" FontSize="12"/>
            </Border>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- PAGINATION FOOTER                               -->
            <!-- ═══════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Bottom" Background="White" CornerRadius="12"
                    Padding="16,10" Margin="0,10,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" Opacity="0.05" ShadowDepth="1"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding PaginationInfo}" FontFamily="{StaticResource AppFont}"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="⏮" Padding="8,4" Margin="0,0,4,0"
                                Command="{Binding GoFirstPageCommand}"
                                IsEnabled="{Binding CanGoBack}"
                                Background="#F3F4F6" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                        <Button Content="◀" Padding="8,4" Margin="0,0,4,0"
                                Command="{Binding GoPreviousPageCommand}"
                                IsEnabled="{Binding CanGoBack}"
                                Background="#F3F4F6" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                        <Border Background="{StaticResource PrimaryBrush}" CornerRadius="6"
                                Padding="12,4" Margin="0,0,4,0">
                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12"
                                       Foreground="White" FontWeight="Bold">
                                <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                                <Run Text=" / "/>
                                <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>
                        <Button Content="▶" Padding="8,4" Margin="0,0,4,0"
                                Command="{Binding GoNextPageCommand}"
                                IsEnabled="{Binding CanGoForward}"
                                Background="#F3F4F6" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                        <Button Content="⏭" Padding="8,4"
                                Command="{Binding GoLastPageCommand}"
                                IsEnabled="{Binding CanGoForward}"
                                Background="#F3F4F6" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- TABLEAU DES FACTURES                            -->
            <!-- ═══════════════════════════════════════════════ -->
            <Border Background="White" CornerRadius="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.06" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <!-- Message aucun résultat -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding NoResults, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="📭" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="Aucune facture trouvée" FontFamily="{StaticResource AppFont}"
                                   FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Essayez d'élargir vos critères de recherche"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Liste scrollable -->
                    <DockPanel>
                        <!-- Header du tableau -->
                        <Border DockPanel.Dock="Top" Background="#F9FAFB" Padding="16,10"
                                CornerRadius="14,14,0,0" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Date" FontFamily="{StaticResource AppFont}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="Type" FontFamily="{StaticResource AppFont}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="2" Text="Numéro" FontFamily="{StaticResource AppFont}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="3" Text="Code DEF" FontFamily="{StaticResource AppFont}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="4" Text="Client" FontFamily="{StaticResource AppFont}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="5" FontFamily="{StaticResource AppFont}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Text="💳"/>
                                <TextBlock Grid.Column="6" Text="Montant TTC" FontFamily="{StaticResource AppFont}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="7" Text="Statut" FontFamily="{StaticResource AppFont}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="8" Text="Actions" FontFamily="{StaticResource AppFont}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Lignes -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Invoices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="16,10" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1"
                                                Cursor="Hand" x:Name="RowBorder" Background="Transparent">
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="MouseEnter">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ColorAnimation Storyboard.TargetName="RowBorder"
                                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                            To="#F9FAFB" Duration="0:0:0.1"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                                <EventTrigger RoutedEvent="MouseLeave">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ColorAnimation Storyboard.TargetName="RowBorder"
                                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                            To="Transparent" Duration="0:0:0.1"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Date -->
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DateDisplay}" FontFamily="{StaticResource AppFont}"
                                                               FontSize="12"/>
                                                    <TextBlock Text="{Binding TimeDisplay}" FontFamily="{StaticResource AppFont}"
                                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>

                                                <!-- Type badge -->
                                                <Border Grid.Column="1" CornerRadius="6" Padding="6,2"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Background="#EFF6FF">
                                                    <TextBlock Text="{Binding TypeLabel}" FontFamily="{StaticResource AppFont}"
                                                               FontSize="11" FontWeight="Bold"
                                                               Foreground="{Binding TypeColor}"/>
                                                </Border>

                                                <!-- Numéro -->
                                                <TextBlock Grid.Column="2" Text="{Binding InvoiceNumber}"
                                                           FontFamily="Consolas" FontSize="11"
                                                           VerticalAlignment="Center"/>

                                                <!-- Code DEF -->
                                                <TextBlock Grid.Column="3" Text="{Binding CodeDEFShort}"
                                                           FontFamily="Consolas" FontSize="10"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding CodeDEFDGI}"/>

                                                <!-- Client -->
                                                <TextBlock Grid.Column="4" Text="{Binding ClientName}"
                                                           FontFamily="{StaticResource AppFont}" FontSize="12"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <!-- Paiement icon -->
                                                <TextBlock Grid.Column="5" Text="{Binding PaymentIcon}"
                                                           FontSize="14" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>

                                                <!-- Montant -->
                                                <TextBlock Grid.Column="6" Text="{Binding TotalDisplay}"
                                                           FontFamily="{StaticResource AppFont}" FontSize="13"
                                                           FontWeight="Bold" HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource PrimaryBrush}"/>

                                                <!-- Statut badge -->
                                                <Border Grid.Column="7" CornerRadius="8" Padding="8,3"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Background="#F0FDF4">
                                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                                               FontWeight="SemiBold">
                                                        <Run Text="{Binding StatusIcon, Mode=OneWay}"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding StatusLabel, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Border>

                                                <!-- Actions -->
                                                <StackPanel Grid.Column="8" Orientation="Horizontal"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button Content="👁" FontSize="13" Padding="4,2"
                                                            Background="Transparent" BorderThickness="0"
                                                            Cursor="Hand" ToolTip="Voir le détail"
                                                            Command="{Binding DataContext.ViewInvoiceCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="🖨" FontSize="13" Padding="4,2"
                                                            Background="Transparent" BorderThickness="0"
                                                            Cursor="Hand" ToolTip="Réimprimer"
                                                            Command="{Binding DataContext.ReprintInvoiceCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </DockPanel>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- OVERLAY : Détail Facture                                   -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding ShowDocument, Converter={StaticResource BoolToVisibilityConverter}}">

            <!-- Backdrop -->
            <Border Background="#CC000000">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding CloseDocumentCommand}"/>
                </Border.InputBindings>
            </Border>

            <!-- Modal container -->
            <Border Background="#F3F4F6" Margin="40,20" CornerRadius="16"
                    MaxWidth="850" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Opacity="0.3" ShadowDepth="0"/>
                </Border.Effect>
                <DockPanel>

                    <!-- ── TOOLBAR ── -->
                    <Border DockPanel.Dock="Top" Background="White" CornerRadius="16,16,0,0"
                            Padding="20,14" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Title -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📄" FontSize="20" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding DocumentViewModel.TypeTitle}"
                                               FontFamily="{StaticResource AppFont}" FontSize="14"
                                               FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock FontFamily="Consolas" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="{Binding DocumentViewModel.InvoiceNumber, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding DocumentViewModel.CreatedAtDisplay, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <!-- Action buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <!-- Print -->
                                <Button Command="{Binding PrintInvoiceCommand}"
                                        Background="{StaticResource PrimaryBrush}" Foreground="White"
                                        FontFamily="{StaticResource AppFont}" FontSize="12"
                                        FontWeight="SemiBold" Padding="14,8" BorderThickness="0"
                                        Cursor="Hand" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🖨" FontSize="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="Imprimer"/>
                                    </StackPanel>
                                </Button>

                                <!-- Export PDF -->
                                <Button Command="{Binding ExportPdfCommand}"
                                        Background="#10B981" Foreground="White"
                                        FontFamily="{StaticResource AppFont}" FontSize="12"
                                        FontWeight="SemiBold" Padding="14,8" BorderThickness="0"
                                        Cursor="Hand" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📥" FontSize="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="Télécharger"/>
                                    </StackPanel>
                                </Button>

                                <!-- Copy DEF Code -->
                                <Button Command="{Binding CopyCodeDEFCommand}"
                                        Background="#F3F4F6" BorderThickness="1"
                                        BorderBrush="#D1D5DB" Cursor="Hand"
                                        FontFamily="{StaticResource AppFont}" FontSize="12"
                                        Padding="14,8" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📋" FontSize="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="Code DEF"/>
                                    </StackPanel>
                                </Button>

                                <!-- Close -->
                                <Button Content="✕" FontSize="18" Padding="8,4"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Foreground="{StaticResource TextSecondaryBrush}"
                                        Command="{Binding CloseDocumentCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ── DOCUMENT VIEW ── -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  Padding="20">
                        <Border HorizontalAlignment="Center" Background="White">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" Opacity="0.1" ShadowDepth="4"/>
                            </Border.Effect>

                            <!-- The actual invoice document -->
                            <ContentControl Content="{Binding DocumentViewModel}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <vm:InvoiceDocumentView DataContext="{Binding}"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </Border>
                    </ScrollViewer>

                </DockPanel>
            </Border>
        </Grid>

        <!-- Spinner chargement -->
        <Border Background="#40000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⏳" FontSize="36" HorizontalAlignment="Center"/>
                <TextBlock Text="Chargement..." FontFamily="{StaticResource AppFont}"
                           FontSize="14" Foreground="White" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>