<UserControl x:Class="SFE.WPF.Views.Pages.SalesHistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SFE.WPF.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:SFE.WPF.Views.Pages"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolVis" />

        <!--  ════════════════ ACCENT PALETTE ════════════════  -->
        <Color x:Key="AccentBlue">#3B82F6</Color>
        <Color x:Key="AccentBlueDark">#1E40AF</Color>
        <SolidColorBrush x:Key="AccentBlueBrush"
                         Color="{StaticResource AccentBlue}" />
        <Color x:Key="AccentGreen">#059669</Color>
        <Color x:Key="AccentViolet">#8B5CF6</Color>
        <Color x:Key="AccentAmber">#F59E0B</Color>

        <!--  ════════════════ TOUCH SCROLL — VERTICAL ════════════════  -->
        <Style x:Key="TouchScrollThumb"
               TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd"
                                Margin="2,0"
                                CornerRadius="5">
                            <Border.Background>
                                <SolidColorBrush x:Name="ThBg"
                                                 Color="#C4CDD5" />
                            </Border.Background>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="ThBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#A0AEC0"
                                                        Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="ThBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#C4CDD5"
                                                        Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource AccentBlue}" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TouchScrollBar"
               TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border Margin="2,0"
                                    Background="#F1F5F9"
                                    CornerRadius="5" />
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource TouchScrollThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ════════════════ DARK SCROLL (code viewer) ════════════════  -->
        <Style x:Key="DarkScrollThumb"
               TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd"
                                Margin="2,0"
                                CornerRadius="4">
                            <Border.Background>
                                <SolidColorBrush x:Name="ThBg"
                                                 Color="#475569" />
                            </Border.Background>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="ThBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#64748B"
                                                        Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="ThBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#475569"
                                                        Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource AccentBlue}" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkScrollBar"
               TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border Margin="2,0"
                                    Background="#1E293B"
                                    CornerRadius="4" />
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkScrollThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ════════════════ GHOST BUTTON (animated) ════════════════  -->
        <Style x:Key="GhostBtn"
               TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Padding="14,8"
                                BorderThickness="1.5"
                                CornerRadius="10">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg"
                                                 Color="White" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="BdBr"
                                                 Color="{StaticResource BorderColor}" />
                            </Border.BorderBrush>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#F8FAFC"
                                                        Duration="0:0:0.12" />
                                        <ColorAnimation Storyboard.TargetName="BdBr"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#94A3B8"
                                                        Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="White"
                                                        Duration="0:0:0.15" />
                                        <ColorAnimation Storyboard.TargetName="BdBr"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource BorderColor}"
                                                        Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ════════════════ PRIMARY ACCENT BUTTON ════════════════  -->
        <Style x:Key="PrimaryBtn"
               TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Padding="16,8"
                                CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush x:Name="BdG" StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="G0" Offset="0" Color="#3B82F6" />
                                    <GradientStop x:Name="G1" Offset="1" Color="#2563EB" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6"
                                                  Opacity="0.18"
                                                  ShadowDepth="1"
                                                  Color="#3B82F6" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#2563EB"
                                                        Duration="0:0:0.18" />
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#1D4ED8"
                                                        Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#3B82F6"
                                                        Duration="0:0:0.22" />
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#2563EB"
                                                        Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ════════════════ DARK BUTTON (print, etc.) ════════════════  -->
        <Style x:Key="DarkBtn"
               TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Padding="16,8"
                                CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="G0" Offset="0" Color="#1E293B" />
                                    <GradientStop x:Name="G1" Offset="1" Color="#0F172A" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6"
                                                  Opacity="0.12"
                                                  ShadowDepth="1"
                                                  Color="#0F172A" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#334155"
                                                        Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#1E293B"
                                                        Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ════════════════ SUCCESS BUTTON (green) ════════════════  -->
        <Style x:Key="SuccessBtn"
               TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Padding="16,8"
                                CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="G0" Offset="0" Color="#059669" />
                                    <GradientStop x:Name="G1" Offset="1" Color="#047857" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#047857"
                                                        Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#059669"
                                                        Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ════════════════ PANEL ICON BUTTON ════════════════  -->
        <Style x:Key="PanelIconBtn"
               TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="8">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg"
                                                 Color="#00F1F5F9" />
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#F1F5F9"
                                                        Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#00F1F5F9"
                                                        Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ════════════════ LINK BUTTON (animated) ════════════════  -->
        <Style x:Key="LinkBtn"
               TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Txt"
                                   VerticalAlignment="Center"
                                   Text="{TemplateBinding Content}">
                            <TextBlock.Foreground>
                                <SolidColorBrush x:Name="TxtFg"
                                                 Color="{StaticResource AccentBlue}" />
                            </TextBlock.Foreground>
                        </TextBlock>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="TxtFg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource AccentBlueDark}"
                                                        Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="TxtFg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource AccentBlue}"
                                                        Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Txt" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ════════════════ SEARCH BOX ════════════════  -->
        <Style x:Key="SearchBox"
               TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Padding="12,9"
                                BorderThickness="1.5"
                                CornerRadius="10">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg"
                                                 Color="#F8FAFC" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="BdBr"
                                                 Color="{StaticResource BorderColor}" />
                            </Border.BorderBrush>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon x:Name="Ico"
                                                         Width="18"
                                                         Height="18"
                                                         Margin="0,0,10,0"
                                                         VerticalAlignment="Center"
                                                         Kind="Magnify">
                                    <materialDesign:PackIcon.Foreground>
                                        <SolidColorBrush x:Name="IcoFg"
                                                         Color="#94A3B8" />
                                    </materialDesign:PackIcon.Foreground>
                                </materialDesign:PackIcon>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Grid.Column="1"
                                              VerticalAlignment="Center" />
                                <TextBlock x:Name="ph"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="13"
                                           Foreground="#94A3B8"
                                           IsHitTestVisible="False"
                                           Text="Recherche par numéro, client, code DEF…"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="ph" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BdBr"
                                                            Storyboard.TargetProperty="Color"
                                                            To="{StaticResource AccentBlue}"
                                                            Duration="0:0:0.15" />
                                            <ColorAnimation Storyboard.TargetName="BdBg"
                                                            Storyboard.TargetProperty="Color"
                                                            To="White"
                                                            Duration="0:0:0.15" />
                                            <ColorAnimation Storyboard.TargetName="IcoFg"
                                                            Storyboard.TargetProperty="Color"
                                                            To="{StaticResource AccentBlue}"
                                                            Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BdBr"
                                                            Storyboard.TargetProperty="Color"
                                                            To="{StaticResource BorderColor}"
                                                            Duration="0:0:0.18" />
                                            <ColorAnimation Storyboard.TargetName="BdBg"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#F8FAFC"
                                                            Duration="0:0:0.18" />
                                            <ColorAnimation Storyboard.TargetName="IcoFg"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#94A3B8"
                                                            Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ════════════════ FILTER INPUT ════════════════  -->
        <Style x:Key="FilterInput"
               TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Padding="10,7"
                                BorderThickness="1.5"
                                CornerRadius="8">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg"
                                                 Color="#F8FAFC" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="BdBr"
                                                 Color="{StaticResource BorderColor}" />
                            </Border.BorderBrush>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BdBr"
                                                            Storyboard.TargetProperty="Color"
                                                            To="{StaticResource AccentBlue}"
                                                            Duration="0:0:0.15" />
                                            <ColorAnimation Storyboard.TargetName="BdBg"
                                                            Storyboard.TargetProperty="Color"
                                                            To="White"
                                                            Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BdBr"
                                                            Storyboard.TargetProperty="Color"
                                                            To="{StaticResource BorderColor}"
                                                            Duration="0:0:0.18" />
                                            <ColorAnimation Storyboard.TargetName="BdBg"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#F8FAFC"
                                                            Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ════════════════ PERIOD PILL ════════════════  -->
        <Style x:Key="PeriodPill"
               TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Padding="14,7"
                                BorderThickness="1.5"
                                CornerRadius="16">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg"
                                                 Color="White" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="BdBr"
                                                 Color="{StaticResource BorderColor}" />
                            </Border.BorderBrush>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground">
                                            <Setter.Value>
                                                <SolidColorBrush Color="#475569" />
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#EFF6FF"
                                                        Duration="0:0:0.12" />
                                        <ColorAnimation Storyboard.TargetName="BdBr"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#93C5FD"
                                                        Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="White"
                                                        Duration="0:0:0.15" />
                                        <ColorAnimation Storyboard.TargetName="BdBr"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource BorderColor}"
                                                        Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--  ══════════════════════════════════════════════════════════════  -->
    <!--  MAIN LAYOUT  -->
    <!--  ══════════════════════════════════════════════════════════════  -->
    <Grid>
        <DockPanel Margin="24,20">

            <!--  ═══════════════════════════════════════════  -->
            <!--  HEADER CARD  -->
            <!--  ═══════════════════════════════════════════  -->
            <Border Margin="0,0,0,14"
                    Padding="24,18"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="14"
                    DockPanel.Dock="Top">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14"
                                      Opacity="0.06"
                                      ShadowDepth="2"
                                      Color="#0D2B3E" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Icon  -->
                    <Border Margin="0,0,16,0"
                            Padding="10"
                            VerticalAlignment="Center"
                            CornerRadius="10">
                        <Border.Background>
                            <SolidColorBrush Opacity="0.08"
                                             Color="{StaticResource AccentBlue}" />
                        </Border.Background>
                        <materialDesign:PackIcon Width="22"
                                                 Height="22"
                                                 Foreground="{StaticResource AccentBlueBrush}"
                                                 Kind="ReceiptTextOutline" />
                    </Border>

                    <!--  Title  -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock Margin="0"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Text="Journal de vente" />
                        <TextBlock Margin="0,3,0,0"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="Historique complet des factures normalisées" />
                    </StackPanel>

                    <!--  Search  -->
                    <TextBox Grid.Column="2"
                             Width="280"
                             Margin="0,0,12,0"
                             Style="{StaticResource SearchBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return"
                                        Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <!--  Action buttons  -->
                    <StackPanel Grid.Column="3"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Button Margin="0,0,8,0"
                                Command="{Binding ResetFiltersCommand}"
                                Style="{StaticResource GhostBtn}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="15"
                                                         Height="15"
                                                         Margin="0,0,6,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource TextMutedBrush}"
                                                         Kind="Refresh" />
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}"
                                           Text="Réinitialiser" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,8,0"
                                Command="{Binding DataContext.NavigateToPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="ReportHistory"
                                Cursor="Hand"
                                Style="{StaticResource GhostBtn}"
                                ToolTip="Ouvrir l'historique des rapports">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="14"
                                                         Height="14"
                                                         Margin="0,0,6,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource TextMutedBrush}"
                                                         Kind="FileChartOutline" />
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="12"
                                           Text="Rapports" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SearchCommand}"
                                Style="{StaticResource PrimaryBtn}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="15"
                                                         Height="15"
                                                         Margin="0,0,6,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="White"
                                                         Kind="Magnify" />
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}"
                                           Foreground="White"
                                           Text="Rechercher" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  ═══════════════════════════════════════════  -->
            <!--  FILTER CARD (filters + period presets)  -->
            <!--  ═══════════════════════════════════════════  -->
            <Border Margin="0,0,0,14"
                    Padding="20,16"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="14"
                    DockPanel.Dock="Top">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10"
                                      Opacity="0.04"
                                      ShadowDepth="2"
                                      Color="#0D2B3E" />
                </Border.Effect>
                <StackPanel>
                    <!--  Filter row  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Operator  -->
                        <StackPanel>
                            <TextBlock Margin="0,0,0,4"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="Opérateur" />
                            <ComboBox Width="160"
                                      MinHeight="38"
                                      VerticalContentAlignment="Center"
                                      FontFamily="{StaticResource AppFont}"
                                      FontSize="12"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      ItemsSource="{Binding AvailableOperators}"
                                      SelectedItem="{Binding FilterOperator}"
                                      Text="{Binding FilterOperator, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!--  E-UF ref  -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="0,0,0,4"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="Réf. E-UF" />
                            <TextBox Width="120"
                                     FontFamily="Consolas"
                                     Style="{StaticResource FilterInput}"
                                     Text="{Binding FilterReference, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!--  Separator  -->
                        <Border Grid.Column="3"
                                Width="1"
                                Margin="8,4"
                                Background="#E2E8F0" />

                        <!--  Du  -->
                        <TextBlock Grid.Column="4"
                                   Margin="0,0,8,10"
                                   VerticalAlignment="Bottom"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="Du :" />
                        <DatePicker Grid.Column="5"
                                    Width="140"
                                    MinHeight="38"
                                    VerticalAlignment="Bottom"
                                    FontSize="12"
                                    SelectedDate="{Binding DateFrom}" />

                        <!--  Au  -->
                        <TextBlock Grid.Column="7"
                                   Margin="0,0,8,10"
                                   VerticalAlignment="Bottom"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="Au :" />
                        <DatePicker Grid.Column="8"
                                    Width="140"
                                    MinHeight="38"
                                    VerticalAlignment="Bottom"
                                    FontSize="12"
                                    SelectedDate="{Binding DateTo}" />

                        <!--  Separator  -->
                        <Border Grid.Column="9"
                                Width="1"
                                Margin="8,4"
                                Background="#E2E8F0" />

                        <!--  Type  -->
                        <StackPanel Grid.Column="10">
                            <TextBlock Margin="0,0,0,4"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="Type" />
                            <ComboBox Width="110"
                                      MinHeight="38"
                                      VerticalContentAlignment="Center"
                                      FontFamily="{StaticResource AppFont}"
                                      FontSize="12"
                                      ItemsSource="{Binding FilterTypes}"
                                      SelectedItem="{Binding FilterType}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                   FontSize="12">
                                            <TextBlock.Text>
                                                <Binding FallbackValue="Tous">
                                                    <Binding.TargetNullValue>Tous</Binding.TargetNullValue>
                                                </Binding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>


                        <!--  Statut  -->
                        <StackPanel Grid.Column="12">
                            <TextBlock Margin="0,0,0,4"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="Statut" />
                            <ComboBox Width="130"
                                      MinHeight="38"
                                      VerticalContentAlignment="Center"
                                      FontFamily="{StaticResource AppFont}"
                                      FontSize="12"
                                      ItemsSource="{Binding FilterStatuses}"
                                      SelectedItem="{Binding FilterStatus}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                   FontSize="12">
                                            <TextBlock.Text>
                                                <Binding FallbackValue="Tous">
                                                    <Binding.TargetNullValue>Tous</Binding.TargetNullValue>
                                                </Binding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!--  Apply  -->
                        <Button Grid.Column="14"
                                VerticalAlignment="Bottom"
                                Command="{Binding SearchCommand}"
                                Style="{StaticResource DarkBtn}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="15"
                                                         Height="15"
                                                         Margin="0,0,6,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="White"
                                                         Kind="FilterOutline" />
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}"
                                           Foreground="White"
                                           Text="Appliquer" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!--  Period presets row  -->
                    <Border Margin="0,12,0,0"
                            Padding="0,10,0,0"
                            BorderBrush="#F1F5F9"
                            BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="16"
                                                     Height="16"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     Kind="CalendarRangeOutline" />
                            <ItemsControl ItemsSource="{Binding PeriodPresets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SetPeriodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding}"
                                                Style="{StaticResource PeriodPill}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!--  ═══════════════════════════════════════════  -->
            <!--  STATS STRIP  -->
            <!--  ═══════════════════════════════════════════  -->
            <Border Margin="0,0,0,14"
                    DockPanel.Dock="Top">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              PanningMode="HorizontalOnly"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">

                        <!--  Total ventes  -->
                        <Border Width="165"
                                Margin="0,0,10,0"
                                Padding="18,14"
                                Background="{StaticResource CardBrush}"
                                CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10"
                                                  Opacity="0.05"
                                                  ShadowDepth="2"
                                                  Color="#0D2B3E" />
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Margin="0,0,12,0"
                                        Padding="7"
                                        VerticalAlignment="Center"
                                        CornerRadius="8">
                                    <Border.Background>
                                        <SolidColorBrush Opacity="0.08"
                                                         Color="{StaticResource AccentBlue}" />
                                    </Border.Background>
                                    <materialDesign:PackIcon Width="18"
                                                             Height="18"
                                                             Foreground="{StaticResource AccentBlueBrush}"
                                                             Kind="ReceiptTextCheckOutline" />
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="Total ventes" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBlueBrush}"
                                               Text="{Binding StatsTotalCount, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--  CA TTC  -->
                        <Border Width="200"
                                Margin="0,0,10,0"
                                Padding="18,14"
                                Background="{StaticResource CardBrush}"
                                CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10"
                                                  Opacity="0.05"
                                                  ShadowDepth="2"
                                                  Color="#0D2B3E" />
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Margin="0,0,12,0"
                                        Padding="7"
                                        VerticalAlignment="Center"
                                        CornerRadius="8">
                                    <Border.Background>
                                        <SolidColorBrush Opacity="0.08"
                                                         Color="{StaticResource AccentGreen}" />
                                    </Border.Background>
                                    <materialDesign:PackIcon Width="18"
                                                             Height="18"
                                                             Kind="CurrencyUsd">
                                        <materialDesign:PackIcon.Foreground>
                                            <SolidColorBrush Color="{StaticResource AccentGreen}" />
                                        </materialDesign:PackIcon.Foreground>
                                    </materialDesign:PackIcon>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="Chiffre d'affaires" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="18"
                                               FontWeight="Bold">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{StaticResource AccentGreen}" />
                                        </TextBlock.Foreground>
                                        <Run Text="{Binding StatsTotalTTC, StringFormat=N0, Mode=OneWay}" />
                                        <Run FontSize="11"
                                             FontWeight="Normal"
                                             Text=" CDF" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--  TVA  -->
                        <Border Width="180"
                                Margin="0,0,10,0"
                                Padding="18,14"
                                Background="{StaticResource CardBrush}"
                                CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10"
                                                  Opacity="0.05"
                                                  ShadowDepth="2"
                                                  Color="#0D2B3E" />
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Margin="0,0,12,0"
                                        Padding="7"
                                        VerticalAlignment="Center"
                                        CornerRadius="8">
                                    <Border.Background>
                                        <SolidColorBrush Opacity="0.08"
                                                         Color="{StaticResource AccentViolet}" />
                                    </Border.Background>
                                    <materialDesign:PackIcon Width="18"
                                                             Height="18"
                                                             Kind="BankOutline">
                                        <materialDesign:PackIcon.Foreground>
                                            <SolidColorBrush Color="{StaticResource AccentViolet}" />
                                        </materialDesign:PackIcon.Foreground>
                                    </materialDesign:PackIcon>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="TVA collectée" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="18"
                                               FontWeight="Bold">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{StaticResource AccentViolet}" />
                                        </TextBlock.Foreground>
                                        <Run Text="{Binding StatsTotalTVA, StringFormat=N0, Mode=OneWay}" />
                                        <Run FontSize="11"
                                             FontWeight="Normal"
                                             Text=" CDF" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--  Panier moyen  -->
                        <Border Width="170"
                                Margin="0,0,10,0"
                                Padding="18,14"
                                Background="{StaticResource CardBrush}"
                                CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10"
                                                  Opacity="0.05"
                                                  ShadowDepth="2"
                                                  Color="#0D2B3E" />
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Margin="0,0,12,0"
                                        Padding="7"
                                        VerticalAlignment="Center"
                                        CornerRadius="8">
                                    <Border.Background>
                                        <SolidColorBrush Opacity="0.08"
                                                         Color="{StaticResource AccentAmber}" />
                                    </Border.Background>
                                    <materialDesign:PackIcon Width="18"
                                                             Height="18"
                                                             Kind="CartOutline">
                                        <materialDesign:PackIcon.Foreground>
                                            <SolidColorBrush Color="{StaticResource AccentAmber}" />
                                        </materialDesign:PackIcon.Foreground>
                                    </materialDesign:PackIcon>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="Panier moyen" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="18"
                                               FontWeight="Bold">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{StaticResource AccentAmber}" />
                                        </TextBlock.Foreground>
                                        <Run Text="{Binding StatsAverage, StringFormat=N0, Mode=OneWay}" />
                                        <Run FontSize="11"
                                             FontWeight="Normal"
                                             Text=" CDF" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--  Répartition  -->
                        <Border Margin="0"
                                Padding="18,12"
                                Background="{StaticResource CardBrush}"
                                CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10"
                                                  Opacity="0.05"
                                                  ShadowDepth="2"
                                                  Color="#0D2B3E" />
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Margin="0,0,0,6"
                                            Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="14"
                                                             Height="14"
                                                             Margin="0,0,6,0"
                                                             VerticalAlignment="Center"
                                                             Foreground="{StaticResource TextMutedBrush}"
                                                             Kind="ChartDonutVariant" />
                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="Répartition" />
                                </StackPanel>
                                <WrapPanel>
                                    <Border Margin="0,0,4,4"
                                            Padding="8,4"
                                            Background="#EFF6FF"
                                            CornerRadius="6">
                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                   FontSize="10"
                                                   FontWeight="Bold">
                                            <Run Foreground="#3B82F6"
                                                 Text="FV " />
                                            <Run Text="{Binding StatsFVCount, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                    <Border Margin="0,0,4,4"
                                            Padding="8,4"
                                            Background="#EDE9FE"
                                            CornerRadius="6">
                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                   FontSize="10"
                                                   FontWeight="Bold">
                                            <Run Foreground="#8B5CF6"
                                                 Text="FT " />
                                            <Run Text="{Binding StatsFTCount, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                    <Border Margin="0,0,4,4"
                                            Padding="8,4"
                                            Background="#FEF3C7"
                                            CornerRadius="6">
                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                   FontSize="10"
                                                   FontWeight="Bold">
                                            <Run Foreground="#D97706"
                                                 Text="FA " />
                                            <Run Text="{Binding StatsFACount, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                    <Border Margin="0,0,4,4"
                                            Padding="8,4"
                                            Background="#FEE2E2"
                                            CornerRadius="6">
                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                   FontSize="10"
                                                   FontWeight="Bold">
                                            <Run Foreground="#EF4444"
                                                 Text="EV " />
                                            <Run Text="{Binding StatsEVCount, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                    <Border Margin="0,0,4,4"
                                            Padding="8,4"
                                            Background="#FECACA"
                                            CornerRadius="6">
                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                   FontSize="10"
                                                   FontWeight="Bold">
                                            <Run Foreground="#DC2626"
                                                 Text="EA " />
                                            <Run Text="{Binding StatsEACount, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                    <Border Margin="0,0,0,4"
                                            Padding="8,4"
                                            Background="#E0E7FF"
                                            CornerRadius="6">
                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                   FontSize="10"
                                                   FontWeight="Bold">
                                            <Run Foreground="#4F46E5"
                                                 Text="ET " />
                                            <Run Text="{Binding StatsETCount, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!--  ═══════════════════════════════════════════  -->
            <!--  STATUS MESSAGES  -->
            <!--  ═══════════════════════════════════════════  -->
            <Border Margin="0,0,0,10"
                    Padding="14,10"
                    CornerRadius="10"
                    DockPanel.Dock="Top"
                    Visibility="{Binding ShowSuccess, Converter={StaticResource BoolVis}}">
                <Border.Background>
                    <SolidColorBrush Opacity="0.06"
                                     Color="#059669" />
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Opacity="0.18"
                                     Color="#059669" />
                </Border.BorderBrush>
                <Border.BorderThickness>1</Border.BorderThickness>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="18"
                                             Height="18"
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center"
                                             Foreground="#059669"
                                             Kind="CheckCircleOutline" />
                    <TextBlock VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="13"
                               Foreground="#059669"
                               Text="{Binding StatusMessage}" />
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,10"
                    Padding="14,10"
                    CornerRadius="10"
                    DockPanel.Dock="Top"
                    Visibility="{Binding ShowError, Converter={StaticResource BoolVis}}">
                <Border.Background>
                    <SolidColorBrush Opacity="0.06"
                                     Color="#EF4444" />
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Opacity="0.18"
                                     Color="#EF4444" />
                </Border.BorderBrush>
                <Border.BorderThickness>1</Border.BorderThickness>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="18"
                                             Height="18"
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center"
                                             Foreground="#EF4444"
                                             Kind="AlertCircleOutline" />
                    <TextBlock VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="13"
                               Foreground="#EF4444"
                               Text="{Binding StatusMessage}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  ═══════════════════════════════════════════  -->
            <!--  CONTENT: DATA TABLE + DETAIL PANEL  -->
            <!--  ═══════════════════════════════════════════  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  ─── LEFT: DATA TABLE ───  -->
                <Border Grid.Column="0"
                        Background="{StaticResource CardBrush}"
                        ClipToBounds="True"
                        CornerRadius="14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14"
                                          Opacity="0.06"
                                          ShadowDepth="2"
                                          Color="#0D2B3E" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <!--  Empty state  -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding NoResults, Converter={StaticResource BoolVis}}">
                                <Border Width="60"
                                        Height="60"
                                        Margin="0,0,0,16"
                                        HorizontalAlignment="Center"
                                        CornerRadius="30">
                                    <Border.Background>
                                        <SolidColorBrush Opacity="0.06"
                                                         Color="{StaticResource AccentBlue}" />
                                    </Border.Background>
                                    <materialDesign:PackIcon Width="30"
                                                             Height="30"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="{StaticResource AccentBlueBrush}"
                                                             Kind="InboxOutline" />
                                </Border>
                                <TextBlock HorizontalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="Aucune facture trouvée" />
                                <TextBlock Margin="0,4,0,0"
                                           HorizontalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="Essayez d'élargir vos critères de recherche" />
                            </StackPanel>

                            <!--  DataGrid  -->
                            <DataGrid AlternatingRowBackground="#FAFBFC"
                                      AutoGenerateColumns="False"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      CanUserResizeRows="False"
                                      EnableRowVirtualization="True"
                                      FontFamily="{StaticResource AppFont}"
                                      FontSize="12"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      HorizontalGridLinesBrush="#F1F5F9"
                                      IsReadOnly="True"
                                      ItemsSource="{Binding Invoices}"
                                      RowBackground="White"
                                      ScrollViewer.CanContentScroll="True"
                                      SelectedItem="{Binding SelectedInvoice}"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.ScrollUnit="Pixel"
                                      VirtualizingPanel.VirtualizationMode="Recycling">

                                <!--  Custom scrollbars for the DataGrid  -->
                                <DataGrid.Resources>
                                    <Style BasedOn="{StaticResource TouchScrollBar}"
                                           TargetType="ScrollBar" />
                                </DataGrid.Resources>

                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F8FAFC" />
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="FontSize" Value="11" />
                                        <Setter Property="Padding" Value="14,12" />
                                        <Setter Property="BorderBrush" Value="#F1F5F9" />
                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                        <Setter Property="SeparatorVisibility" Value="Collapsed" />
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border x:Name="CellBd"
                                                            Padding="14,10">
                                                        <Border.Background>
                                                            <SolidColorBrush x:Name="CellBg"
                                                                             Color="Transparent" />
                                                        </Border.Background>
                                                        <ContentPresenter VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="CellBd" Property="Background">
                                                                <Setter.Value>
                                                                    <SolidColorBrush Opacity="0.06"
                                                                                     Color="{StaticResource AccentBlue}" />
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGrid.CellStyle>

                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="MinHeight" Value="46" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F8FAFC" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <SolidColorBrush Opacity="0.06"
                                                                         Color="{StaticResource AccentBlue}" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>

                                <DataGrid.Columns>
                                    <!--  Date  -->
                                    <DataGridTemplateColumn Width="95"
                                                            Header="Date">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                                               FontSize="12"
                                                               FontWeight="Medium"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               Text="{Binding DateDisplay}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontFamily="{StaticResource AppFont}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               Text="{Binding TimeDisplay}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--  Type badge  -->
                                    <DataGridTemplateColumn Width="55"
                                                            Header="Type">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Padding="7,3"
                                                        HorizontalAlignment="Left"
                                                        Background="{Binding TypeBadgeBg}"
                                                        CornerRadius="6">
                                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding TypeColor}"
                                                               Text="{Binding TypeLabel}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--  Numéro  -->
                                    <DataGridTextColumn Width="95"
                                                        Binding="{Binding InvoiceNumber}"
                                                        Header="Numéro">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontFamily" Value="Consolas" />
                                                <Setter Property="FontSize" Value="11.5" />
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!--  Code DEF  -->
                                    <DataGridTextColumn Width="120"
                                                        Binding="{Binding CodeDEFShort}"
                                                        Header="Code DEF">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontFamily" Value="Consolas" />
                                                <Setter Property="FontSize" Value="10" />
                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!--  Client  -->
                                    <DataGridTextColumn Width="*"
                                                        Binding="{Binding ClientName}"
                                                        Header="Client">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!--  Payment  -->
                                    <DataGridTemplateColumn Width="40"
                                                            Header="Paie.">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <materialDesign:PackIcon Width="18"
                                                                         Height="18"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="{StaticResource TextMutedBrush}"
                                                                         Kind="{Binding PaymentIconKind}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--  Montant TTC  -->
                                    <DataGridTextColumn Width="115"
                                                        Binding="{Binding TotalDisplay}"
                                                        Header="Montant TTC">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <!--  Tirage  -->
                                    <DataGridTemplateColumn Width="75"
                                                            Header="Tirage">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Padding="7,3"
                                                        HorizontalAlignment="Center"
                                                        Background="{Binding PrintBadgeBg}"
                                                        CornerRadius="6"
                                                        ToolTip="{Binding PrintTooltip}">
                                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding PrintBadgeFg}"
                                                               Text="{Binding PrintBadgeText}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--  Statut  -->
                                    <DataGridTemplateColumn Width="90"
                                                            Header="Statut">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,3"
                                                        HorizontalAlignment="Center"
                                                        Background="{Binding StatusBadgeBg}"
                                                        CornerRadius="8">
                                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding StatusColor}">
                                                        <Run Text="{Binding StatusIcon, Mode=OneWay}" />
                                                        <Run Text=" " />
                                                        <Run Text="{Binding StatusLabel, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--  Actions  -->
                                    <DataGridTemplateColumn Width="100"
                                                            Header="">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel HorizontalAlignment="Center"
                                                            Orientation="Horizontal">
                                                    <Button Width="32"
                                                            Height="32"
                                                            Command="{Binding DataContext.ViewInvoiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource PanelIconBtn}"
                                                            ToolTip="Voir le détail">
                                                        <materialDesign:PackIcon Width="16"
                                                                                 Height="16"
                                                                                 Foreground="{StaticResource AccentBlueBrush}"
                                                                                 Kind="EyeOutline" />
                                                    </Button>
                                                    <Button Width="32"
                                                            Height="32"
                                                            Margin="2,0,0,0"
                                                            Command="{Binding DataContext.ReprintInvoiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource PanelIconBtn}"
                                                            ToolTip="Réimprimer">
                                                        <materialDesign:PackIcon Width="16"
                                                                                 Height="16"
                                                                                 Foreground="{StaticResource TextMutedBrush}"
                                                                                 Kind="Printer" />
                                                    </Button>
                                                    <Button Width="32"
                                                            Height="32"
                                                            Margin="2,0,0,0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Command="{Binding DataContext.ConvertProformaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Cursor="Hand"
                                                            Style="{StaticResource PanelIconBtn}"
                                                            ToolTip="Convertir cette proforma en facture fiscale"
                                                            Visibility="{Binding IsConvertibleProforma, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <materialDesign:PackIcon Width="16"
                                                                                 Height="16"
                                                                                 Foreground="#7C3AED"
                                                                                 Kind="SwapHorizontal" />
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!--  Pagination  -->
                        <Border Grid.Row="1"
                                Padding="16,12"
                                Background="#FAFBFC"
                                BorderBrush="#F1F5F9"
                                BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="{Binding PaginationInfo}" />

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal">
                                    <Button Width="34"
                                            Height="34"
                                            Margin="0,0,2,0"
                                            Command="{Binding GoFirstPageCommand}"
                                            IsEnabled="{Binding CanGoBack}"
                                            Style="{StaticResource PanelIconBtn}">
                                        <materialDesign:PackIcon Width="18"
                                                                 Height="18"
                                                                 Foreground="{StaticResource TextMutedBrush}"
                                                                 Kind="PageFirst" />
                                    </Button>
                                    <Button Width="34"
                                            Height="34"
                                            Margin="0,0,4,0"
                                            Command="{Binding GoPreviousPageCommand}"
                                            IsEnabled="{Binding CanGoBack}"
                                            Style="{StaticResource PanelIconBtn}">
                                        <materialDesign:PackIcon Width="18"
                                                                 Height="18"
                                                                 Foreground="{StaticResource TextMutedBrush}"
                                                                 Kind="ChevronLeft" />
                                    </Button>

                                    <Border Margin="0,0,4,0"
                                            Padding="12,6"
                                            CornerRadius="8">
                                        <Border.Background>
                                            <SolidColorBrush Opacity="0.08"
                                                             Color="{StaticResource AccentBlue}" />
                                        </Border.Background>
                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBlueBrush}">
                                            <Run Text="{Binding CurrentPage, Mode=OneWay}" />
                                            <Run FontWeight="Normal"
                                                 Text=" / " />
                                            <Run Text="{Binding TotalPages, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>

                                    <Button Width="34"
                                            Height="34"
                                            Margin="0,0,2,0"
                                            Command="{Binding GoNextPageCommand}"
                                            IsEnabled="{Binding CanGoForward}"
                                            Style="{StaticResource PanelIconBtn}">
                                        <materialDesign:PackIcon Width="18"
                                                                 Height="18"
                                                                 Foreground="{StaticResource TextMutedBrush}"
                                                                 Kind="ChevronRight" />
                                    </Button>
                                    <Button Width="34"
                                            Height="34"
                                            Command="{Binding GoLastPageCommand}"
                                            IsEnabled="{Binding CanGoForward}"
                                            Style="{StaticResource PanelIconBtn}">
                                        <materialDesign:PackIcon Width="18"
                                                                 Height="18"
                                                                 Foreground="{StaticResource TextMutedBrush}"
                                                                 Kind="PageLast" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!--  ─── RIGHT: DETAIL PANEL ───  -->
                <Border Grid.Column="1"
                        Width="430"
                        Margin="14,0,0,0"
                        Background="{StaticResource CardBrush}"
                        ClipToBounds="True"
                        CornerRadius="14"
                        Visibility="{Binding ShowDetailPanel, Converter={StaticResource BoolVis}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14"
                                          Opacity="0.06"
                                          ShadowDepth="2"
                                          Color="#0D2B3E" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Panel header  -->
                        <Border Grid.Row="0"
                                Padding="18,14"
                                BorderBrush="#F1F5F9"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="20"
                                                                 Height="20"
                                                                 Margin="0,0,8,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{StaticResource AccentBlueBrush}"
                                                                 Kind="FileDocumentOutline" />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Text="{Binding DetailTypeLabel}" />
                                    </StackPanel>
                                    <TextBlock Margin="0,4,0,0"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}">
                                        <Run Text="{Binding DetailNumber, Mode=OneWay}" />
                                        <Run Text="  ·  " />
                                        <Run Text="{Binding DetailDate, Mode=OneWay}" />
                                        <Run Text="  ·  " />
                                        <Run Text="{Binding DetailOperator, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Margin="4,0"
                                        Command="{Binding PopOutDetailCommand}"
                                        Style="{StaticResource PanelIconBtn}"
                                        ToolTip="Ouvrir dans une fenêtre">
                                    <materialDesign:PackIcon Width="16"
                                                             Height="16"
                                                             Foreground="{StaticResource TextMutedBrush}"
                                                             Kind="OpenInNew" />
                                </Button>
                                <Button Grid.Column="2"
                                        Margin="0,0,4,0"
                                        Command="{Binding CopyCodeDEFCommand}"
                                        Style="{StaticResource PanelIconBtn}"
                                        ToolTip="Copier Code DEF">
                                    <materialDesign:PackIcon Width="16"
                                                             Height="16"
                                                             Foreground="{StaticResource TextMutedBrush}"
                                                             Kind="ContentCopy" />
                                </Button>
                                <Button Grid.Column="3"
                                        Command="{Binding CloseDetailPanelCommand}"
                                        Style="{StaticResource PanelIconBtn}"
                                        ToolTip="Fermer le panneau">
                                    <materialDesign:PackIcon Width="16"
                                                             Height="16"
                                                             Foreground="{StaticResource TextMutedBrush}"
                                                             Kind="Close" />
                                </Button>
                            </Grid>
                        </Border>

                        <!--  Totals strip  -->
                        <Border Grid.Row="1"
                                Padding="14,12"
                                Background="#FAFBFC"
                                BorderBrush="#F1F5F9"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Margin="0,0,6,0"
                                        Padding="12,10"
                                        Background="White"
                                        BorderBrush="#F1F5F9"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="9"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="Total HT" />
                                        <TextBlock Margin="0,3,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Text="{Binding DetailTotalHT}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Margin="0,0,6,0"
                                        Padding="12,10"
                                        Background="White"
                                        BorderBrush="#F1F5F9"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="9"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="TVA" />
                                        <TextBlock Margin="0,3,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Text="{Binding DetailTotalTVA}">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{StaticResource AccentViolet}" />
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Padding="12,10"
                                        CornerRadius="10">
                                    <Border.Background>
                                        <SolidColorBrush Opacity="0.06"
                                                         Color="{StaticResource AccentBlue}" />
                                    </Border.Background>
                                    <Border.BorderBrush>
                                        <SolidColorBrush Opacity="0.15"
                                                         Color="{StaticResource AccentBlue}" />
                                    </Border.BorderBrush>
                                    <Border.BorderThickness>1</Border.BorderThickness>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="9"
                                                   Foreground="{StaticResource AccentBlueBrush}"
                                                   Text="Total TTC" />
                                        <TextBlock Margin="0,3,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Text="{Binding DetailTotalTTC}">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{StaticResource AccentBlueDark}" />
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!--  Client info + Print status  -->
                        <Border Grid.Row="2"
                                Padding="16,12"
                                BorderBrush="#F1F5F9"
                                BorderThickness="0,0,0,1">
                            <StackPanel>
                                <!--  Client + NIF  -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                   FontSize="9"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="Client" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Text="{Binding DetailClient}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                HorizontalAlignment="Right">
                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                   FontSize="9"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="NIF" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="{Binding DetailClientNIF}" />
                                    </StackPanel>
                                </Grid>

                                <!--  🆕 Print status banner  -->
                                <Border Margin="0,10,0,0"
                                        Padding="10,7"
                                        Background="{Binding DetailPrintBadgeBg}"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Width="14"
                                                                 Height="14"
                                                                 Margin="0,0,8,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{Binding DetailPrintBadgeFg}"
                                                                 Kind="PrinterCheck" />
                                        <Border Grid.Column="1"
                                                Margin="0,0,8,0"
                                                Padding="6,2"
                                                VerticalAlignment="Center"
                                                Background="White"
                                                CornerRadius="4">
                                            <TextBlock FontFamily="{StaticResource AppFont}"
                                                       FontSize="9.5"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding DetailPrintBadgeFg}"
                                                       Text="{Binding DetailPrintBadge}" />
                                        </Border>
                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="10.5"
                                                   Foreground="{Binding DetailPrintBadgeFg}"
                                                   Text="{Binding DetailPrintStatus}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!--  Items  -->
                        <Border Grid.Row="3">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Padding="16,10"
                                        Background="#FAFBFC"
                                        BorderBrush="#F1F5F9"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="45" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="75" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="Article" />
                                        <TextBlock Grid.Column="1"
                                                   HorizontalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="Qté" />
                                        <TextBlock Grid.Column="2"
                                                   HorizontalAlignment="Right"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="P.U." />
                                        <TextBlock Grid.Column="3"
                                                   HorizontalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="TVA" />
                                        <TextBlock Grid.Column="4"
                                                   HorizontalAlignment="Right"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="Total" />
                                    </Grid>
                                </Border>

                                <ScrollViewer Grid.Row="1"
                                              PanningMode="VerticalOnly"
                                              VerticalScrollBarVisibility="Auto">
                                    <ScrollViewer.Resources>
                                        <Style BasedOn="{StaticResource TouchScrollBar}"
                                               TargetType="ScrollBar" />
                                    </ScrollViewer.Resources>
                                    <ItemsControl ItemsSource="{Binding DetailLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="16,9"
                                                        BorderBrush="#F8FAFC"
                                                        BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="45" />
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="40" />
                                                            <ColumnDefinition Width="75" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                                   FontSize="11.5"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   Text="{Binding Description}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1"
                                                                   HorizontalAlignment="Center"
                                                                   FontFamily="{StaticResource AppFont}"
                                                                   FontSize="11.5"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Text="{Binding QuantityDisplay}" />
                                                        <TextBlock Grid.Column="2"
                                                                   HorizontalAlignment="Right"
                                                                   FontFamily="{StaticResource AppFont}"
                                                                   FontSize="11.5"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Text="{Binding UnitPriceDisplay}" />
                                                        <TextBlock Grid.Column="3"
                                                                   HorizontalAlignment="Center"
                                                                   FontFamily="{StaticResource AppFont}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   Text="{Binding TVADisplay}" />
                                                        <TextBlock Grid.Column="4"
                                                                   HorizontalAlignment="Right"
                                                                   FontFamily="{StaticResource AppFont}"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   Text="{Binding TotalDisplay}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!--  Code DEF  -->
                        <Border Grid.Row="4"
                                Padding="16,12"
                                BorderBrush="#1E293B"
                                BorderThickness="0,1,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#0F172A" />
                                    <GradientStop Offset="1" Color="#1E293B" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,4"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="9"
                                           Foreground="#64748B"
                                           Text="Code DEF / DGI" />
                                <TextBlock FontFamily="Consolas"
                                           FontSize="10.5"
                                           Foreground="#E2E8F0"
                                           LineHeight="16"
                                           Text="{Binding DetailCodeDEF}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!--  Footer actions  -->
                        <Border Grid.Row="5"
                                Padding="14,12"
                                Background="#FAFBFC"
                                BorderBrush="#F1F5F9"
                                BorderThickness="0,1,0,0">
                            <StackPanel HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <Button Margin="0,0,8,0"
                                        Command="{Binding PrintInvoiceCommand}"
                                        Style="{StaticResource GhostBtn}"
                                        ToolTip="{Binding DetailPrintStatus}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="15"
                                                                 Height="15"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{Binding DetailPrintBadgeFg}"
                                                                 Kind="Printer" />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   Text="Imprimer" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ExportPdfCommand}"
                                        Style="{StaticResource GhostBtn}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="15"
                                                                 Height="15"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{StaticResource TextMutedBrush}"
                                                                 Kind="FileExportOutline" />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   Text="Exporter" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>

        <!--  ══════════════════════════════════════════════════════════════  -->
        <!--  OVERLAY: Full document view (pop-out)  -->
        <!--  ══════════════════════════════════════════════════════════════  -->
        <Grid Panel.ZIndex="100"
              Visibility="{Binding ShowDocument, Converter={StaticResource BoolVis}}">
            <Border Background="#CC000000"
                    MouseLeftButtonDown="OnOverlayBackdropClick" />

            <Border MaxWidth="900"
                    MaxHeight="740"
                    Margin="50,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#F8FAFC"
                    ClipToBounds="True"
                    CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40"
                                      Direction="270"
                                      Opacity="0.25"
                                      ShadowDepth="8"
                                      Color="#000" />
                </Border.Effect>

                <DockPanel>
                    <!--  Toolbar  -->
                    <Border Padding="22,16"
                            Background="White"
                            BorderBrush="#F1F5F9"
                            BorderThickness="0,0,0,1"
                            DockPanel.Dock="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                <Border Margin="0,0,12,0"
                                        Padding="7"
                                        CornerRadius="8">
                                    <Border.Background>
                                        <SolidColorBrush Opacity="0.08"
                                                         Color="{StaticResource AccentBlue}" />
                                    </Border.Background>
                                    <materialDesign:PackIcon Width="20"
                                                             Height="20"
                                                             Foreground="{StaticResource AccentBlueBrush}"
                                                             Kind="FileDocumentOutline" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="{Binding DocumentViewModel.TypeTitle}" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}">
                                        <Run Text="{Binding DocumentViewModel.InvoiceNumber, Mode=OneWay}" />
                                        <Run Text="  ·  " />
                                        <Run Text="{Binding DocumentViewModel.CreatedAtDisplay, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal">

                                <Button Margin="0,0,6,0"
                                        Command="{Binding PrintInvoiceCommand}"
                                        Style="{StaticResource PrimaryBtn}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="15"
                                                                 Height="15"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="White"
                                                                 Kind="Printer" />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   Foreground="White"
                                                   Text="Imprimer" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="0,0,6,0"
                                        Command="{Binding ExportPdfCommand}"
                                        Style="{StaticResource SuccessBtn}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="15"
                                                                 Height="15"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="White"
                                                                 Kind="Download" />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   Foreground="White"
                                                   Text="Télécharger" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="0,0,8,0"
                                        Command="{Binding CopyCodeDEFCommand}"
                                        Style="{StaticResource GhostBtn}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="14"
                                                                 Height="14"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{StaticResource TextMutedBrush}"
                                                                 Kind="ContentCopy" />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   Text="Code DEF" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding CloseDocumentCommand}"
                                        Style="{StaticResource PanelIconBtn}">
                                    <materialDesign:PackIcon Width="20"
                                                             Height="20"
                                                             Foreground="{StaticResource TextMutedBrush}"
                                                             Kind="Close" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Document scroll area  -->
                    <ScrollViewer Padding="24,16"
                                  Background="#F1F5F9"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly"
                                  VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <Style BasedOn="{StaticResource TouchScrollBar}"
                                   TargetType="ScrollBar" />
                        </ScrollViewer.Resources>
                        <Border Margin="0,0,0,16"
                                HorizontalAlignment="Center"
                                Background="White"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12"
                                                  Direction="270"
                                                  Opacity="0.08"
                                                  ShadowDepth="2" />
                            </Border.Effect>
                            <ContentControl Content="{Binding DocumentViewModel}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <vm:InvoiceDocumentView DataContext="{Binding}" />
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </Border>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!--  ══════════════════════════════════════════════════════════════  -->
        <!--  LOADING SPINNER  -->
        <!--  ══════════════════════════════════════════════════════════════  -->
        <Border Panel.ZIndex="200"
                Background="#60000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <Border Padding="36,28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24"
                                      Opacity="0.15"
                                      ShadowDepth="4"
                                      Color="#0D2B3E" />
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <materialDesign:PackIcon Width="36"
                                             Height="36"
                                             HorizontalAlignment="Center"
                                             Foreground="{StaticResource AccentBlueBrush}"
                                             Kind="Loading"
                                             RenderTransformOrigin="0.5,0.5">
                        <materialDesign:PackIcon.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" />
                        </materialDesign:PackIcon.RenderTransform>
                        <materialDesign:PackIcon.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0"
                                                         To="360"
                                                         Duration="0:0:1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </materialDesign:PackIcon.Triggers>
                    </materialDesign:PackIcon>
                    <TextBlock Margin="0,14,0,0"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Chargement…" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>