<UserControl x:Class="SFE.WPF.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:SFE.Domain.Enums;assembly=SFE.Domain"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>

        <!--  ── Gradient Brushes ──  -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#1E3A5F" />
            <GradientStop Offset="0.5" Color="#2D5F8A" />
            <GradientStop Offset="1" Color="#1A4D7C" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#2563EB" />
            <GradientStop Offset="0.5" Color="#3B82F6" />
            <GradientStop Offset="1" Color="#1D4ED8" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#3B82F6" />
            <GradientStop Offset="1" Color="#8B5CF6" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#059669" />
            <GradientStop Offset="1" Color="#10B981" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GoldGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#D97706" />
            <GradientStop Offset="1" Color="#F59E0B" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PurpleGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#7C3AED" />
            <GradientStop Offset="1" Color="#9333EA" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="RoseGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#DB2777" />
            <GradientStop Offset="1" Color="#EC4899" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassOverlay" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#20FFFFFF" />
            <GradientStop Offset="1" Color="#08FFFFFF" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardGlow" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FFFFFF" />
            <GradientStop Offset="0.4" Color="#FAFBFD" />
            <GradientStop Offset="1" Color="#F5F7FA" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SubtleShimmer" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#FFFFFF" />
            <GradientStop Offset="0.5" Color="#F8FAFC" />
            <GradientStop Offset="1" Color="#F1F5F9" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SeparatorGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="Transparent" />
            <GradientStop Offset="0.2" Color="#E2E8F0" />
            <GradientStop Offset="0.5" Color="#CBD5E1" />
            <GradientStop Offset="0.8" Color="#E2E8F0" />
            <GradientStop Offset="1" Color="Transparent" />
        </LinearGradientBrush>

        <!--  ── Premium Card ──  -->
        <Style x:Key="PremiumCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardGlow}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="Padding" Value="28" />
            <Setter Property="Margin" Value="0,0,0,20" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" Direction="270"
                                      Opacity="0.06" ShadowDepth="4" Color="#1E3A5F" />
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ── Form TextBox ──  -->
        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6" />
                                <Setter TargetName="bd" Property="Background" Value="White" />
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="12" Opacity="0.12"
                                                          ShadowDepth="0" Color="#3B82F6" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ── Field label ──  -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Margin" Value="2,0,0,8" />
        </Style>

        <!--  ── Primary gradient button ──  -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Padding="24,13"
                                Background="{StaticResource PrimaryGradient}" CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" Direction="270"
                                                  Opacity="0.2" ShadowDepth="3" Color="#2563EB" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="24" Direction="270"
                                                          Opacity="0.3" ShadowDepth="5" Color="#2563EB" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ── Secondary / ghost button ──  -->
        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Padding="16,10" Background="#F1F5F9"
                                BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#CBD5E1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ── Small icon button ──  -->
        <Style x:Key="SmallIconBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Padding="8,6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" ToolTip="{TemplateBinding ToolTip}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#CBD5E1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ── Inner section panel ──  -->
        <Style x:Key="InnerPanel" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#F8FAFC" />
                        <GradientStop Offset="1" Color="#F1F5F9" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <ScrollViewer Padding="32,28"
                  PanningMode="VerticalOnly"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900">

            <!--  ═══════════════════════════════════════════════════  -->
            <!--  PAGE HEADER  -->
            <!--  ═══════════════════════════════════════════════════  -->
            <Border Margin="0,0,0,24"
                    Background="{StaticResource HeaderGradient}"
                    CornerRadius="18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" Direction="270"
                                      Opacity="0.18" ShadowDepth="6" Color="#1E3A5F" />
                </Border.Effect>
                <Border Padding="28,26"
                        Background="{StaticResource GlassOverlay}"
                        CornerRadius="18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="52" Height="52"
                                Background="#18FFFFFF" CornerRadius="14">
                            <md:PackIcon Width="28" Height="28"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Foreground="White" Kind="CogOutline" />
                        </Border>
                        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource AppFont}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="White" Text="Paramètres" />
                            <TextBlock Margin="0,4,0,0"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="12" Foreground="#94B8DB"
                                       Text="Configurez votre entreprise, points de vente, facturation et préférences" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!--  ═══════════════════════════════════════════════════  -->
            <!--  SECTION 1 — ENTREPRISE  -->
            <!--  ═══════════════════════════════════════════════════  -->
            <Border Style="{StaticResource PremiumCard}">
                <StackPanel>
                    <!--  Section header  -->
                    <StackPanel Margin="0,0,0,22" Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#EEF2FF" />
                                    <GradientStop Offset="1" Color="#DBEAFE" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <md:PackIcon Width="22" Height="22"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Foreground="#2563EB" Kind="Domain" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource AppFont}"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="Informations de l'entreprise" />
                            <TextBlock Margin="0,3,0,0"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="12" Foreground="#94A3B8"
                                       Text="Données qui apparaîtront sur vos factures et reçus" />
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Height="1" Margin="0,0,0,22"
                               Fill="{StaticResource SeparatorGradient}" />

                    <!--  LOGO SECTION  -->
                    <Border Margin="0,0,0,22" Padding="22"
                            BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#F8FAFC" />
                                <GradientStop Offset="1" Color="#F1F5F9" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="84" Height="84"
                                    BorderBrush="#CBD5E1" BorderThickness="1"
                                    ClipToBounds="True" CornerRadius="14">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0" Color="#E2E8F0" />
                                        <GradientStop Offset="1" Color="#CBD5E1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" Direction="270"
                                                      Opacity="0.06" ShadowDepth="2" Color="#1E3A5F" />
                                </Border.Effect>
                                <Grid>
                                    <md:PackIcon Width="36" Height="36"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Foreground="#94A3B8" Kind="OfficeBuilding">
                                        <md:PackIcon.Style>
                                            <Style TargetType="md:PackIcon">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </md:PackIcon.Style>
                                    </md:PackIcon>
                                    <Image RenderOptions.BitmapScalingMode="HighQuality"
                                           Source="{Binding CompanyLogoPreview}" Stretch="Uniform"
                                           Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Margin="0,0,0,6"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="10" FontWeight="Bold" Foreground="#94A3B8"
                                           Text="LOGO DE L'ENTREPRISE" />
                                <TextBlock Margin="0,0,0,14"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="11" Foreground="#64748B"
                                           Text="Apparaîtra sur les factures et les rapports. Format recommandé : PNG, 200×200 px."
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding BrowseLogoCommand}">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource BtnPrimary}" TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Padding="14,9"
                                                                    Background="{StaticResource PrimaryGradient}" CornerRadius="10">
                                                                <Border.Effect>
                                                                    <DropShadowEffect BlurRadius="10" Direction="270"
                                                                                      Opacity="0.15" ShadowDepth="2" Color="#2563EB" />
                                                                </Border.Effect>
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Effect">
                                                                        <Setter.Value>
                                                                            <DropShadowEffect BlurRadius="16" Direction="270"
                                                                                              Opacity="0.25" ShadowDepth="3" Color="#2563EB" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Width="16" Height="16" Margin="0,0,6,0"
                                                         VerticalAlignment="Center" Foreground="White" Kind="FolderImage" />
                                            <TextBlock VerticalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="11" FontWeight="SemiBold" Foreground="White"
                                                       Text="Choisir une image" />
                                        </StackPanel>
                                    </Button>
                                    <Button Margin="8,0,0,0" Command="{Binding RemoveLogoCommand}"
                                            Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Padding="14,9"
                                                                    BorderBrush="#FECACA" BorderThickness="1" CornerRadius="10">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                        <GradientStop Offset="0" Color="#FEF2F2" />
                                                                        <GradientStop Offset="1" Color="#FEE2E2" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background">
                                                                        <Setter.Value>
                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                                <GradientStop Offset="0" Color="#FEE2E2" />
                                                                                <GradientStop Offset="1" Color="#FECACA" />
                                                                            </LinearGradientBrush>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Width="14" Height="14" Margin="0,0,5,0"
                                                         VerticalAlignment="Center" Foreground="#DC2626" Kind="Close" />
                                            <TextBlock VerticalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="11" Foreground="#DC2626" Text="Supprimer" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  ═══ COMPANY FIELDS — FIXED GRID LAYOUT ═══  -->
                    <!--  Uses Grid instead of UniformGrid so hidden ISF doesn't leave a gap  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Row 0: Company Name | NIF  -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="NOM DE L'ENTREPRISE" />
                            <TextBox Style="{StaticResource FormInput}"
                                     Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="NIF (NUMÉRO D'IMPÔT FISCAL)" />
                            <TextBox Style="{StaticResource FormInput}"
                                     Text="{Binding CompanyNIF, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!--  Row 1: RCCM | ISF (conditionally visible)  -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="RCCM" />
                            <TextBox Style="{StaticResource FormInput}"
                                     Text="{Binding CompanyRCCM, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,16"
                                    Visibility="{Binding CanSeeISF, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="ISF (IDENTIFIANT SYSTÈME DE FACTURATION)" />
                            <TextBox Style="{StaticResource FormInput}"
                                     Text="{Binding CompanyISF, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!--  Row 2: City | Address  -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="VILLE" />
                            <TextBox Style="{StaticResource FormInput}"
                                     Text="{Binding CompanyCity, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="ADRESSE" />
                            <TextBox Style="{StaticResource FormInput}"
                                     Text="{Binding CompanyAddress, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!--  Row 3: Phone | Email  -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="TÉLÉPHONE" />
                            <TextBox Style="{StaticResource FormInput}"
                                     Text="{Binding CompanyPhone, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="EMAIL" />
                            <TextBox Style="{StaticResource FormInput}"
                                     Text="{Binding CompanyEmail, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  ═══════════════════════════════════════════════════  -->
            <!--  SECTION 2 — DISPOSITIF FISCAL (Test de connexion)  -->
            <!--  ═══════════════════════════════════════════════════  -->
            <Border Style="{StaticResource PremiumCard}">
                <StackPanel>
                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#FDF2F8" />
                                    <GradientStop Offset="1" Color="#FCE7F3" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <md:PackIcon Width="22" Height="22"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Foreground="#DB2777" Kind="AccessPointNetwork" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource AppFont}"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="Test de connexion au dispositif fiscal" />
                            <TextBlock Margin="0,3,0,0"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="12" Foreground="#94A3B8"
                                       Text="Vérifiez que votre dispositif e-MCF ou MCF répond correctement" />
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Height="1" Margin="0,10,0,20" Fill="{StaticResource SeparatorGradient}" />

                    <!--  Info banner  -->
                    <Border Margin="0,0,0,22" Padding="16,14"
                            BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#EFF6FF" />
                                <GradientStop Offset="1" Color="#DBEAFE" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Width="20" Height="20" Margin="0,0,12,0"
                                         VerticalAlignment="Top" Foreground="#1E40AF" Kind="InformationOutline" />
                            <TextBlock FontFamily="{StaticResource AppFont}"
                                       FontSize="12" Foreground="#1E40AF" TextWrapping="Wrap">
                                <Run Text="Renseignez les paramètres ci-dessous et cliquez « Tester ». " />
                                <Run FontWeight="SemiBold"
                                     Text="Les données détaillées du dispositif seront affichées après un test réussi." />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!--  Device type selector  -->
                    <UniformGrid Margin="0,0,0,22" Columns="2">
                        <RadioButton Margin="0,0,8,0" GroupName="DeviceType"
                                     IsChecked="{Binding IsEmcfSelected}"
                                     Style="{StaticResource RadioCardStyle}">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                                    <md:PackIcon Width="20" Height="20" Margin="0,0,8,0"
                                                 VerticalAlignment="Center" Foreground="#2563EB" Kind="AccessPoint" />
                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}" Text="e-MCF" />
                                </StackPanel>
                                <TextBlock Margin="0,2,0,0"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="11" Foreground="#94A3B8"
                                           Text="API REST distante (HTTPS)" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Margin="8,0,0,0" GroupName="DeviceType"
                                     IsChecked="{Binding IsEmcfSelected, Converter={StaticResource InverseBoolConverter}}"
                                     Style="{StaticResource RadioCardStyle}">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                                    <md:PackIcon Width="20" Height="20" Margin="0,0,8,0"
                                                 VerticalAlignment="Center" Foreground="#9333EA" Kind="SerialPort" />
                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}" Text="MCF" />
                                </StackPanel>
                                <TextBlock Margin="0,2,0,0"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="11" Foreground="#94A3B8"
                                           Text="Appareil physique (RS232/USB)" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <!--  Config e-MCF  -->
                    <StackPanel Visibility="{Binding IsEmcfSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Style="{StaticResource InnerPanel}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="URL DE L'API" />
                                <TextBox Margin="0,0,0,14" Style="{StaticResource FormInput}"
                                         Text="{Binding EmcfApiUrl, UpdateSourceTrigger=PropertyChanged}" />
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="TOKEN JWT" />
                                        <TextBox Style="{StaticResource FormInput}"
                                                 Text="{Binding EmcfToken, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="NIM" />
                                        <TextBox Style="{StaticResource FormInput}"
                                                 Text="{Binding EmcfNIM, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                                <Button Margin="0,18,0,0" HorizontalAlignment="Left"
                                        Command="{Binding TestConnectionCommand}"
                                        Style="{StaticResource BtnSecondary}">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Width="16" Height="16" Margin="0,0,8,0"
                                                     VerticalAlignment="Center" Foreground="#2563EB" Kind="LanConnect" />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="12" Foreground="#2563EB"
                                                   Text="Tester la connexion e-MCF" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  Config MCF  -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmcfSelected}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Style="{StaticResource InnerPanel}">
                            <StackPanel>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,16">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="PORT COM" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox ItemsSource="{Binding AvailableComPorts}"
                                                      SelectedItem="{Binding SelectedComPort}"
                                                      Style="{StaticResource ModernComboBoxStyle}" />
                                            <Button Grid.Column="1" Margin="6,0,0,0"
                                                    VerticalAlignment="Stretch"
                                                    Command="{Binding RefreshComPortsCommand}"
                                                    Style="{StaticResource SmallIconBtn}"
                                                    ToolTip="Rafraîchir les ports">
                                                <md:PackIcon Width="16" Height="16"
                                                             Foreground="#64748B" Kind="Refresh" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,16">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="BAUD RATE" />
                                        <ComboBox ItemsSource="{Binding AvailableBaudRates}"
                                                  SelectedItem="{Binding BaudRate}"
                                                  Style="{StaticResource ModernComboBoxStyle}" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Margin="0,0,0,14"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="11" Foreground="#94A3B8">
                                    <Run Text="Format: 8N1 · " />
                                    <Run Text="{Binding AvailableComPorts.Count, Mode=OneWay, StringFormat='{}{0} port(s) détecté(s)'}" />
                                </TextBlock>
                                <Button HorizontalAlignment="Left"
                                        Command="{Binding TestConnectionCommand}"
                                        Style="{StaticResource BtnSecondary}">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Width="16" Height="16" Margin="0,0,8,0"
                                                     VerticalAlignment="Center" Foreground="#9333EA" Kind="SerialPort" />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="12" Foreground="#9333EA"
                                                   Text="Tester la connexion MCF" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  Testing indicator  -->
                    <Border Margin="0,16,0,0" Padding="16,14" CornerRadius="12"
                            Visibility="{Binding IsTestingConnection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#EFF6FF" />
                                <GradientStop Offset="1" Color="#DBEAFE" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Width="20" Height="20" Margin="0,0,12,0"
                                         VerticalAlignment="Center" Foreground="#2563EB" Kind="TimerSand" />
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="13" FontStyle="Italic" Foreground="#2563EB"
                                       Text="Test de connexion en cours…" />
                        </StackPanel>
                    </Border>

                    <!--  Test result  -->
                    <Border Margin="0,16,0,0" Padding="22" CornerRadius="14"
                            Visibility="{Binding HasTestResult, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Offset="0" Color="#F8FAFC" />
                                            <GradientStop Offset="1" Color="#F1F5F9" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="BorderBrush" Value="#E2E8F0" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TestSuccess}" Value="True">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Offset="0" Color="#ECFDF5" />
                                                    <GradientStop Offset="1" Color="#D1FAE5" />
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="BorderBrush" Value="#86EFAC" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TestSuccess}" Value="False">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Offset="0" Color="#FEF2F2" />
                                                    <GradientStop Offset="1" Color="#FEE2E2" />
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="BorderBrush" Value="#FECACA" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>
                            <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                                <Border Width="44" Height="44" Margin="0,0,14,0"
                                        VerticalAlignment="Center" CornerRadius="12">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FEE2E2" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TestSuccess}" Value="True">
                                                    <Setter Property="Background" Value="#D1FAE5" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <md:PackIcon Width="24" Height="24"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Foreground="#059669" Kind="CheckCircle"
                                                     Visibility="{Binding TestSuccess, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <md:PackIcon Width="24" Height="24"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Foreground="#DC2626" Kind="CloseCircle">
                                            <md:PackIcon.Style>
                                                <Style TargetType="md:PackIcon">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TestSuccess}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </md:PackIcon.Style>
                                        </md:PackIcon>
                                    </Grid>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                               FontSize="15" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Connexion échouée" />
                                                <Setter Property="Foreground" Value="#DC2626" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TestSuccess}" Value="True">
                                                        <Setter Property="Text" Value="Connexion réussie" />
                                                        <Setter Property="Foreground" Value="#059669" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Margin="0,2,0,0"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="11" Foreground="#94A3B8"
                                               Text="{Binding TestStatus}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Margin="0,0,0,18"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding TestMessage}" TextWrapping="Wrap" />

                            <!--  Details card  -->
                            <Border Padding="18" Background="White"
                                    BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" Direction="270"
                                                      Opacity="0.04" ShadowDepth="2" Color="#1E3A5F" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12"
                                               FontWeight="SemiBold" Foreground="#64748B" Text="Temps de réponse" />
                                    <TextBlock Grid.Column="2" FontFamily="{StaticResource AppFont}"
                                               FontSize="12" Text="{Binding TestResponseTime}" />
                                    <TextBlock Grid.Row="2" FontFamily="{StaticResource AppFont}" FontSize="12"
                                               FontWeight="SemiBold" Foreground="#64748B" Text="NIM" />
                                    <TextBlock Grid.Row="2" Grid.Column="2"
                                               FontFamily="{StaticResource AppFont}" FontSize="12"
                                               FontWeight="Bold" Foreground="#2563EB" Text="{Binding TestNIM}" />
                                    <TextBlock Grid.Row="4" FontFamily="{StaticResource AppFont}" FontSize="12"
                                               FontWeight="SemiBold" Foreground="#64748B" Text="Type" />
                                    <TextBlock Grid.Row="4" Grid.Column="2"
                                               FontFamily="{StaticResource AppFont}" FontSize="12"
                                               Text="{Binding TestServerVersion}" />
                                </Grid>
                            </Border>

                            <Expander Margin="0,14,0,0" IsExpanded="False">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Width="16" Height="16" Margin="0,0,8,0"
                                                     VerticalAlignment="Center" Foreground="#64748B"
                                                     Kind="ClipboardTextOutline" />
                                        <TextBlock FontFamily="{StaticResource AppFont}"
                                                   FontSize="12" Foreground="#64748B" Text="Détails complets" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Margin="0,0,0,12"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="11" Foreground="#94A3B8"
                                               Text="{Binding TestDetails}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,0,0,8"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="10" FontWeight="Bold" Foreground="#94A3B8"
                                               Text="RÉPONSE BRUTE" />
                                    <Border Padding="16" CornerRadius="10">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Offset="0" Color="#1A202C" />
                                                <GradientStop Offset="1" Color="#0F172A" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                            <TextBlock FontFamily="Consolas" FontSize="11"
                                                       Foreground="#94A3B8" Text="{Binding TestRawResponse}"
                                                       TextWrapping="Wrap" />
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!--  ═══════════════════════════════════════════════════  -->
            <!--  SECTION 2.5 — INFORMATIONS DÉTAILLÉES DU DISPOSITIF  -->
            <!--  ═══════════════════════════════════════════════════  -->
            <Border Style="{StaticResource PremiumCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0" Color="#F0FDF4" />
                                        <GradientStop Offset="1" Color="#DCFCE7" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <md:PackIcon Width="22" Height="22" HorizontalAlignment="Center"
                                 VerticalAlignment="Center" Foreground="#059669" Kind="Memory" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="Informations détaillées du dispositif" />
                                <TextBlock Margin="0,3,0,0" FontFamily="{StaticResource AppFont}" FontSize="12"
                               Foreground="#94A3B8"
                               Text="Données lues en temps réel depuis le MCF / e-MCF connecté" />
                            </StackPanel>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                    Command="{Binding LoadDeviceInfoCommand}" Style="{StaticResource BtnSecondary}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Width="16" Height="16" Margin="0,0,8,0"
                                 VerticalAlignment="Center" Foreground="#059669" Kind="Refresh" />
                                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource AppFont}"
                               FontSize="12" Foreground="#059669" Text="Interroger" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Rectangle Height="1" Margin="0,10,0,22" Fill="{StaticResource SeparatorGradient}" />

                    <!-- Loading -->
                    <Border Margin="0,0,0,16" Padding="16,14" CornerRadius="12"
                Visibility="{Binding IsDeviceInfoLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#EFF6FF" />
                                <GradientStop Offset="1" Color="#DBEAFE" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Width="20" Height="20" Margin="0,0,12,0"
                             VerticalAlignment="Center" Foreground="#2563EB" Kind="TimerSand" />
                            <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource AppFont}"
                           FontSize="13" FontStyle="Italic" Foreground="#2563EB"
                           Text="Interrogation du dispositif fiscal…" />
                        </StackPanel>
                    </Border>

                    <!-- Error -->
                    <Border Margin="0,0,0,16" Padding="16,14" CornerRadius="12"
                BorderBrush="#FECACA" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasDeviceInfo}" Value="True" />
                                            <Condition Binding="{Binding DeviceInfoSuccess}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#FEF2F2" />
                                <GradientStop Offset="1" Color="#FEE2E2" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Width="20" Height="20" Margin="0,0,12,0"
                             VerticalAlignment="Center" Foreground="#DC2626" Kind="AlertCircle" />
                            <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource AppFont}"
                           FontSize="13" Foreground="#DC2626"
                           Text="{Binding DeviceInfoError}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- ═══ Device info content (visible on success) ═══ -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasDeviceInfo}" Value="True" />
                                            <Condition Binding="{Binding DeviceInfoSuccess}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- ═══ Row 1: Identity & Connection ═══ -->
                        <Border Style="{StaticResource InnerPanel}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,14" FontFamily="{StaticResource AppFont}"
                               FontSize="10" FontWeight="Bold" Foreground="#94A3B8"
                               Text="IDENTITÉ DU DISPOSITIF" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Type -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                       FontWeight="Bold" Foreground="#94A3B8" Text="TYPE" />
                                        <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource AppFont}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding DeviceInfoType}" />
                                    </StackPanel>

                                    <!-- NIM -->
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                       FontWeight="Bold" Foreground="#94A3B8" Text="NIM" />
                                        <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource AppFont}"
                                       FontSize="13" FontWeight="Bold" Foreground="#2563EB"
                                       Text="{Binding DeviceNIM}" />
                                    </StackPanel>

                                    <!-- NIF -->
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                       FontWeight="Bold" Foreground="#94A3B8" Text="NIF" />
                                        <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource AppFont}"
                                       FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding DeviceNIF}" />
                                    </StackPanel>

                                    <!-- Connection Status -->
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                       FontWeight="Bold" Foreground="#94A3B8" Text="STATUT CONNEXION DGI" />
                                        <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource AppFont}" FontSize="13">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#DC2626" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DeviceConnectionStatus}" Value="CON">
                                                            <Setter Property="Foreground" Value="#059669" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DeviceConnectionStatus}" Value="TRA">
                                                            <Setter Property="Foreground" Value="#D97706" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                <Run Text="{Binding DeviceConnectionLabel, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Last Sync -->
                                    <StackPanel Grid.Row="4" Grid.Column="0">
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                       FontWeight="Bold" Foreground="#94A3B8" Text="DERNIÈRE SYNC SERVEUR" />
                                        <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource AppFont}"
                                       FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding DeviceLastSync}" />
                                    </StackPanel>

                                    <!-- Device DateTime -->
                                    <StackPanel Grid.Row="4" Grid.Column="2">
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                       FontWeight="Bold" Foreground="#94A3B8" Text="DATE/HEURE DISPOSITIF" />
                                        <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource AppFont}"
                                       FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding DeviceDateTime}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ═══ Row 2: Taxpayer Info ═══ -->
                        <Border Style="{StaticResource InnerPanel}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,14" FontFamily="{StaticResource AppFont}"
                               FontSize="10" FontWeight="Bold" Foreground="#94A3B8"
                               Text="CONTRIBUABLE ENREGISTRÉ" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                       FontWeight="Bold" Foreground="#94A3B8" Text="NOM / RAISON SOCIALE" />
                                        <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource AppFont}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding DeviceTaxpayerName}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                       FontWeight="Bold" Foreground="#94A3B8" Text="VILLE" />
                                        <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource AppFont}"
                                       FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding DeviceTaxpayerCity}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                       FontWeight="Bold" Foreground="#94A3B8" Text="ADRESSE" />
                                        <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource AppFont}"
                                       FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding DeviceTaxpayerAddress}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                       FontWeight="Bold" Foreground="#94A3B8" Text="TÉLÉPHONE" />
                                        <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource AppFont}"
                                       FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding DeviceTaxpayerPhone}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="4" Grid.Column="0">
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                       FontWeight="Bold" Foreground="#94A3B8" Text="EMAIL" />
                                        <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource AppFont}"
                                       FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding DeviceTaxpayerEmail}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ═══ Row 3: Counters ═══ -->
                        <Border Style="{StaticResource InnerPanel}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,14" FontFamily="{StaticResource AppFont}"
                               FontSize="10" FontWeight="Bold" Foreground="#94A3B8"
                               Text="COMPTEURS DE TRANSACTIONS" />
                                <UniformGrid Columns="3" Rows="2">
                                    <!-- Total -->
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                       FontWeight="Bold" Foreground="#94A3B8" Text="TOTAL" />
                                        <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource AppFont}"
                                       FontSize="18" FontWeight="Bold" Foreground="#2563EB"
                                       Text="{Binding DeviceTotalTransactions}" />
                                    </StackPanel>
                                    <!-- Ventes -->
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                       FontWeight="Bold" Foreground="#94A3B8" Text="VENTES" />
                                        <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource AppFont}"
                                       FontSize="18" FontWeight="Bold" Foreground="#059669"
                                       Text="{Binding DeviceSalesCount}" />
                                    </StackPanel>
                                    <!-- Avoirs -->
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                       FontWeight="Bold" Foreground="#94A3B8" Text="AVOIRS" />
                                        <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource AppFont}"
                                       FontSize="18" FontWeight="Bold" Foreground="#D97706"
                                       Text="{Binding DeviceCreditNoteCount}" />
                                    </StackPanel>
                                    <!-- Envoyées -->
                                    <StackPanel>
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                       FontWeight="Bold" Foreground="#94A3B8" Text="ENVOYÉES DGI" />
                                        <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource AppFont}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding DeviceTransactionsSent}" />
                                    </StackPanel>
                                    <!-- En dispositif -->
                                    <StackPanel>
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                       FontWeight="Bold" Foreground="#94A3B8" Text="EN DISPOSITIF" />
                                        <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource AppFont}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding DeviceTransactionsInDevice}" />
                                    </StackPanel>
                                    <!-- En attente -->
                                    <StackPanel>
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                       FontWeight="Bold" Foreground="#94A3B8" Text="EN ATTENTE" />
                                        <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#059669" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DevicePendingCount}" Value="0">
                                                            <Setter Property="Foreground" Value="#059669" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                <Run Text="{Binding DevicePendingCount, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </UniformGrid>

                                <!-- Last Invoice -->
                                <Rectangle Height="1" Margin="0,8,0,14" Fill="{StaticResource SeparatorGradient}" />
                                <StackPanel>
                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                   FontWeight="Bold" Foreground="#94A3B8" Text="DERNIÈRE FACTURE" />
                                    <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource AppFont}"
                                   FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding DeviceLastInvoice}" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ═══ Row 4: Technical / e-MCF specific ═══ -->
                        <Border Style="{StaticResource InnerPanel}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,14" FontFamily="{StaticResource AppFont}"
                               FontSize="10" FontWeight="Bold" Foreground="#94A3B8"
                               Text="INFORMATIONS TECHNIQUES" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                       FontWeight="Bold" Foreground="#94A3B8" Text="VALIDITÉ TOKEN" />
                                        <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource AppFont}"
                                       FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding DeviceTokenValid}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                       FontWeight="Bold" Foreground="#94A3B8" Text="VERSION API" />
                                        <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource AppFont}"
                                       FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding DeviceApiVersion}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                       FontWeight="Bold" Foreground="#94A3B8" Text="STATUT e-MCF" />
                                        <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource AppFont}"
                                       FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding DeviceEmcfStatus}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                       FontWeight="Bold" Foreground="#94A3B8" Text="DERNIÈRE ERREUR" />
                                        <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource AppFont}"
                                       FontSize="12" Foreground="#DC2626"
                                       Text="{Binding DeviceLastError}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Tax Rates -->
                                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                       FontWeight="Bold" Foreground="#94A3B8" Text="TAUX D'IMPOSITION CONFIGURÉS" />
                                        <Border Margin="0,6,0,0" Padding="12,10" Background="#F8FAFC"
                                    BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                                            <TextBlock FontFamily="Consolas" FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{Binding DeviceTaxRatesDisplay}" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ═══ Row 5: DGI Currency Rate Card ═══ -->
                        <Border Style="{StaticResource InnerPanel}" Margin="0,0,0,18"
                    Visibility="{Binding HasDgiRate, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,14" FontFamily="{StaticResource AppFont}"
                               FontSize="10" FontWeight="Bold" Foreground="#94A3B8"
                               Text="TAUX DE CHANGE DGI" />

                                <!-- Currency rates table -->
                                <ItemsControl ItemsSource="{Binding DeviceCurrencyRates}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8" Padding="16,12" CornerRadius="10"
                                        BorderBrush="#FDE68A" BorderThickness="1">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Offset="0" Color="#FFFBEB" />
                                                        <GradientStop Offset="1" Color="#FEF3C7" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <md:PackIcon Width="22" Height="22" Margin="0,0,10,0"
                                                         Foreground="#D97706" Kind="CurrencyUsd" />
                                                        <StackPanel>
                                                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12"
                                                           FontWeight="Bold" Foreground="#92400E"
                                                           Text="{Binding Code}" />
                                                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                                           Foreground="#B45309" Text="{Binding Description}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                                       Foreground="#92400E" HorizontalAlignment="Right">
                                                <Run Text="Publié: " /><Run Text="{Binding Date, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="16"
                                                       FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Right">
                                                <Run Text="{Binding Rate, Mode=OneWay}" /><Run FontSize="11" Text=" CDF" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- ═══ Row 6: e-MCF Devices List ═══ -->
                        <Border Margin="0,0,0,18">
                            <Border.Style>
                                <Style BasedOn="{StaticResource InnerPanel}" TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DeviceEmcfList.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,14" FontFamily="{StaticResource AppFont}"
                               FontSize="10" FontWeight="Bold" Foreground="#94A3B8"
                               Text="DISPOSITIFS e-MCF ENREGISTRÉS" />

                                <!-- Header row -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                   FontWeight="Bold" Foreground="#94A3B8" Text="NIM" />
                                    <TextBlock Grid.Column="1" FontFamily="{StaticResource AppFont}" FontSize="10"
                                   FontWeight="Bold" Foreground="#94A3B8" Text="STATUT" />
                                    <TextBlock Grid.Column="2" FontFamily="{StaticResource AppFont}" FontSize="10"
                                   FontWeight="Bold" Foreground="#94A3B8" Text="BOUTIQUE" />
                                    <TextBlock Grid.Column="3" FontFamily="{StaticResource AppFont}" FontSize="10"
                                   FontWeight="Bold" Foreground="#94A3B8" Text="ADRESSE" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding DeviceEmcfList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,4" Padding="12,10" CornerRadius="8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="White" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="BorderBrush" Value="#E2E8F0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background" Value="#F0FDF4" />
                                                                <Setter Property="BorderBrush" Value="#86EFAC" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontFamily="Consolas" FontSize="12"
                                                   FontWeight="Bold" Foreground="#2563EB"
                                                   VerticalAlignment="Center" Text="{Binding NIM}" />
                                                    <TextBlock Grid.Column="1" FontFamily="{StaticResource AppFont}" FontSize="11"
                                                   VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#94A3B8" />
                                                                <Setter Property="Text" Value="{Binding Status}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Foreground" Value="#059669" />
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="2" FontFamily="{StaticResource AppFont}" FontSize="11"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" Text="{Binding ShopName}" />
                                                    <TextBlock Grid.Column="3" FontFamily="{StaticResource AppFont}" FontSize="11"
                                                   Foreground="#64748B" VerticalAlignment="Center"
                                                   Text="{Binding Address}" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- No data state (when not yet interrogated) -->
                    <StackPanel Margin="0,10,0,10" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasDeviceInfo}" Value="False" />
                                            <Condition Binding="{Binding IsDeviceInfoLoading}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="56" Height="56" Margin="0,0,0,12"
                    HorizontalAlignment="Center" Background="#F0F9FF" CornerRadius="50">
                            <md:PackIcon Width="24" Height="24" HorizontalAlignment="Center"
                             VerticalAlignment="Center" Foreground="#93C5FD" Kind="Memory" />
                        </Border>
                        <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource AppFont}"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Aucune donnée du dispositif" />
                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center"
                       FontFamily="{StaticResource AppFont}" FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="Cliquez « Interroger » pour lire les informations du dispositif connecté" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <!--  ═══════════════════════════════════════════════════  -->
            <!--  SECTION 4 — FACTURATION & CALCUL  -->
            <!--  ═══════════════════════════════════════════════════  -->
            <Border Style="{StaticResource PremiumCard}">
                <StackPanel>
                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#ECFDF5" />
                                    <GradientStop Offset="1" Color="#D1FAE5" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <md:PackIcon Width="22" Height="22"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Foreground="#059669" Kind="CalculatorVariant" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource AppFont}"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="Facturation et calcul" />
                            <TextBlock Margin="0,3,0,0" FontFamily="{StaticResource AppFont}"
                                       FontSize="12" Foreground="#94A3B8"
                                       Text="Mode de prix, calcul de la remise, devise et taux de change" />
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Height="1" Margin="0,10,0,22" Fill="{StaticResource SeparatorGradient}" />

                    <!--  Price mode  -->
                    <Border Margin="0,0,0,14" Style="{StaticResource InnerPanel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Mode HT (Hors Taxes)" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPriceModeTTC}" Value="True">
                                                    <Setter Property="Text" Value="Mode TTC (Toutes Taxes Comprises)" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource AppFont}"
                                           FontSize="12" Foreground="#94A3B8">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Les prix saisis sont hors taxes" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPriceModeTTC}" Value="True">
                                                    <Setter Property="Text" Value="Les prix saisis incluent la TVA" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Margin="0,0,10,0" VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}" FontSize="12"
                                           FontWeight="Bold" Foreground="#64748B" Text="HT" />
                                <ToggleButton IsChecked="{Binding IsPriceModeTTC}"
                                              Style="{StaticResource ToggleSwitchStyle}" />
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}" FontSize="12"
                                           FontWeight="Bold" Foreground="#64748B" Text="TTC" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Discount toggle  -->
                    <Border Margin="0,0,0,14" Style="{StaticResource InnerPanel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Remise après calcul de la TVA" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DiscountBeforeTax}" Value="True">
                                                    <Setter Property="Text" Value="Remise avant calcul de la TVA" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource AppFont}"
                                           FontSize="12" Foreground="#94A3B8">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="La remise est soustraite du montant TTC" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DiscountBeforeTax}" Value="True">
                                                    <Setter Property="Text" Value="La remise est soustraite du prix HT, TVA calculée sur le montant remisé" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Margin="0,0,10,0" VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}" FontSize="12"
                                           FontWeight="Bold" Foreground="#64748B" Text="Après" />
                                <ToggleButton IsChecked="{Binding DiscountBeforeTax}"
                                              Style="{StaticResource ToggleSwitchStyle}" />
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}" FontSize="12"
                                           FontWeight="Bold" Foreground="#64748B" Text="Avant" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ★ Currency & exchange rate — WITH DGI FETCH BUTTON -->
                    <Border Style="{StaticResource InnerPanel}">
                        <StackPanel>
                            <!-- Header with "Fetch from DGI" button -->
                            <Grid Margin="0,0,0,14">
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                           FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"
                                           Text="DEVISE ET TAUX DE CHANGE" />
                                <Button HorizontalAlignment="Right"
                                        Command="{Binding FetchDgiRatesCommand}"
                                        Style="{StaticResource BtnSecondary}">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Width="16" Height="16" Margin="0,0,8,0"
                                                     VerticalAlignment="Center" Foreground="#D97706"
                                                     Kind="CloudDownload" />
                                        <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource AppFont}"
                                                   FontSize="11" Foreground="#D97706">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Récupérer taux DGI" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFetchingDgiRates}" Value="True">
                                                            <Setter Property="Text" Value="Récupération…" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- ★ DGI Rate info banner (shown when rate is available) -->
                            <Border Margin="0,0,0,14" Padding="14,12" CornerRadius="10"
                                    BorderBrush="#FDE68A" BorderThickness="1"
                                    Visibility="{Binding HasDgiRate, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#FFFBEB" />
                                        <GradientStop Offset="1" Color="#FEF3C7" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Width="18" Height="18" Margin="0,0,10,0"
                                                 VerticalAlignment="Center" Foreground="#D97706"
                                                 Kind="CurrencyUsd" />
                                    <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource AppFont}"
                                               FontSize="12" Foreground="#92400E">
                                        <Run Text="Taux DGI : " />
                                        <Run FontWeight="Bold" Text="1 USD = " />
                                        <Run FontWeight="Bold" FontSize="14"
                                             Text="{Binding DgiUsdRate, Mode=OneWay}" />
                                        <Run FontWeight="Bold" Text=" CDF" />
                                        <Run Text="  —  publié le " />
                                        <Run Text="{Binding DgiUsdDate, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- ★ Success feedback -->
                            <Border Margin="0,0,0,14" Padding="12,10" CornerRadius="10"
                                    Visibility="{Binding ShowDgiRateSuccess, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#ECFDF5" />
                                        <GradientStop Offset="1" Color="#D1FAE5" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Width="16" Height="16" Margin="0,0,8,0"
                                                 VerticalAlignment="Center" Foreground="#059669"
                                                 Kind="CheckCircle" />
                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12"
                                               Foreground="#059669" Text="{Binding DgiRateStatus}" />
                                </StackPanel>
                            </Border>

                            <!-- ★ Error feedback -->
                            <Border Margin="0,0,0,14" Padding="12,10" CornerRadius="10"
                                    Visibility="{Binding ShowDgiRateError, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#FEF2F2" />
                                        <GradientStop Offset="1" Color="#FEE2E2" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Width="16" Height="16" Margin="0,0,8,0"
                                                 VerticalAlignment="Center" Foreground="#DC2626"
                                                 Kind="AlertCircle" />
                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12"
                                               Foreground="#DC2626" Text="{Binding DgiRateStatus}" />
                                </StackPanel>
                            </Border>

                            <!-- Currency / Rate mode selectors -->
                            <UniformGrid Margin="0,0,0,14" Columns="2">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="DEVISE PRINCIPALE" />
                                    <ComboBox ItemsSource="{Binding Currencies}"
                                              SelectedItem="{Binding DefaultCurrency}"
                                              Style="{StaticResource ModernComboBoxStyle}" />
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="MODE TAUX DE CHANGE" />
                                    <ComboBox ItemsSource="{Binding ExchangeRateModes}"
                                              SelectedItem="{Binding ExchangeRateMode}"
                                              Style="{StaticResource ModernComboBoxStyle}" />
                                </StackPanel>
                            </UniformGrid>

                            <!-- Rate input fields -->
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="TAUX USD (1 USD = X CDF)" />
                                    <TextBox Style="{StaticResource FormInput}"
                                             Text="{Binding CurrentExchangeRate, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="TAUX EUR (1 EUR = X CDF)" />
                                    <TextBox Style="{StaticResource FormInput}"
                                             Text="{Binding CurrentExchangeRateEUR, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="TAUX CNY (1 CNY = X CDF)" />
                                    <TextBox Style="{StaticResource FormInput}"
                                             Text="{Binding CurrentExchangeRateCNY, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!--  ═══════════════════════════════════════════════════  -->
            <!--  SECTION 5 — FIDÉLITÉ  -->
            <!--  ═══════════════════════════════════════════════════  -->
            <Border Style="{StaticResource PremiumCard}">
                <StackPanel>
                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#FEF3C7" />
                                    <GradientStop Offset="1" Color="#FDE68A" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <md:PackIcon Width="22" Height="22"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Foreground="#D97706" Kind="StarCircle" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource AppFont}"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="Programme de fidélité" />
                            <TextBlock Margin="0,3,0,0" FontFamily="{StaticResource AppFont}"
                                       FontSize="12" Foreground="#94A3B8"
                                       Text="Récompensez vos clients réguliers avec des points" />
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Height="1" Margin="0,10,0,22" Fill="{StaticResource SeparatorGradient}" />

                    <Border Margin="0,0,0,18" Style="{StaticResource InnerPanel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="Activer le programme de fidélité" />
                                <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource AppFont}"
                                           FontSize="12" Foreground="#94A3B8"
                                           Text="Les clients pourront accumuler et utiliser des points" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Margin="0,0,10,0" VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Désactivé" />
                                            <Setter Property="Foreground" Value="#94A3B8" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoyaltyEnabled}" Value="True">
                                                    <Setter Property="Text" Value="Activé" />
                                                    <Setter Property="Foreground" Value="#059669" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ToggleButton IsChecked="{Binding IsLoyaltyEnabled}"
                                              Style="{StaticResource ToggleSwitchSuccessStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoyaltyEnabled}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,10,16">
                                <TextBlock Style="{StaticResource FieldLabel}"
                                           Text="TAUX D'ACCUMULATION (1 POINT PAR X CDF)" />
                                <TextBox Style="{StaticResource FormInput}"
                                         Text="{Binding LoyaltyEarnRate, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="10,0,0,16">
                                <TextBlock Style="{StaticResource FieldLabel}"
                                           Text="VALEUR DE RÉDEMPTION (1 POINT = X CDF)" />
                                <TextBox Style="{StaticResource FormInput}"
                                         Text="{Binding LoyaltyRedeemRate, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="MINIMUM DE POINTS POUR UTILISER" />
                            <TextBox MaxWidth="300" HorizontalAlignment="Left"
                                     Style="{StaticResource FormInput}"
                                     Text="{Binding LoyaltyMinRedeemPoints, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ═══════════════════════════════════════════════════  -->
            <!--  SECTION 6 — LICENCE  -->
            <!--  ═══════════════════════════════════════════════════  -->
            <Border Style="{StaticResource PremiumCard}">
                <StackPanel>
                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#F5F3FF" />
                                    <GradientStop Offset="1" Color="#EDE9FE" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <md:PackIcon Width="22" Height="22"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Foreground="#7C3AED" Kind="ShieldKey" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource AppFont}"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Text="Licence" />
                            <TextBlock Margin="0,3,0,0" FontFamily="{StaticResource AppFont}"
                                       FontSize="12" Foreground="#94A3B8"
                                       Text="Gérez votre licence d'utilisation" />
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Height="1" Margin="0,10,0,22" Fill="{StaticResource SeparatorGradient}" />

                    <Border Margin="0,0,0,22" Padding="22"
                            BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#F5F3FF" />
                                <GradientStop Offset="0.5" Color="#EFF6FF" />
                                <GradientStop Offset="1" Color="#F8FAFC" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" Direction="270"
                                              Opacity="0.04" ShadowDepth="2" Color="#7C3AED" />
                        </Border.Effect>
                        <UniformGrid Columns="2">
                            <StackPanel>
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="PLAN ACTUEL" />
                                <TextBlock Margin="0,8,0,0" FontFamily="{StaticResource AppFont}"
                                           FontSize="22" FontWeight="Bold" Foreground="#7C3AED"
                                           Text="{Binding LicensePlan}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="STATUT" />
                                <TextBlock Margin="0,8,0,0" FontFamily="{StaticResource AppFont}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{Binding LicenseStatus}" />
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="CLÉ DE LICENCE" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox FontFamily="Consolas" Style="{StaticResource FormInput}"
                                 Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Margin="12,0,0,0"
                                Command="{Binding ActivateLicenseCommand}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource BtnPrimary}" TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Padding="22,12" CornerRadius="12">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Offset="0" Color="#7C3AED" />
                                                            <GradientStop Offset="1" Color="#9333EA" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="14" Direction="270"
                                                                          Opacity="0.2" ShadowDepth="3" Color="#7C3AED" />
                                                    </Border.Effect>
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="22" Direction="270"
                                                                                  Opacity="0.3" ShadowDepth="5" Color="#7C3AED" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Width="16" Height="16" Margin="0,0,8,0"
                                             VerticalAlignment="Center" Foreground="White" Kind="KeyVariant" />
                                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource AppFont}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="White" Text="Activer" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Margin="0,12,0,0" Padding="16,14" CornerRadius="12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LicenseMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#FEF2F2" />
                                <GradientStop Offset="1" Color="#FEE2E2" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Width="18" Height="18" Margin="0,0,10,0"
                                         VerticalAlignment="Center" Foreground="#DC2626" Kind="AlertCircle" />
                            <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource AppFont}"
                                       FontSize="12" FontWeight="Medium" Foreground="#DC2626"
                                       Text="{Binding LicenseMessage}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!--  ═══════════════════════════════════════════════════  -->
            <!--  GLOBAL SAVE BAR  -->
            <!--  ═══════════════════════════════════════════════════  -->
            <Border Margin="0,4,0,32" Padding="20,18"
                    BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#FFFFFF" />
                        <GradientStop Offset="0.5" Color="#F8FAFC" />
                        <GradientStop Offset="1" Color="#F1F5F9" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" Direction="270"
                                      Opacity="0.06" ShadowDepth="4" Color="#1E3A5F" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Success message  -->
                    <Border Padding="14,10" VerticalAlignment="Center" CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowSaveSuccess}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#ECFDF5" />
                                <GradientStop Offset="1" Color="#D1FAE5" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Width="20" Height="20" Margin="0,0,10,0"
                                         VerticalAlignment="Center" Foreground="#059669" Kind="CheckCircle" />
                            <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource AppFont}"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#059669"
                                       Text="{Binding SaveStatus}" />
                        </StackPanel>
                    </Border>

                    <!--  Error message  -->
                    <Border Padding="14,10" VerticalAlignment="Center" CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowSaveError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#FEF2F2" />
                                <GradientStop Offset="1" Color="#FEE2E2" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Width="20" Height="20" Margin="0,0,10,0"
                                         VerticalAlignment="Center" Foreground="#DC2626" Kind="AlertCircle" />
                            <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource AppFont}"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#DC2626"
                                       Text="{Binding SaveStatus}" />
                        </StackPanel>
                    </Border>

                    <!--  Save button  -->
                    <Button Grid.Column="1" Command="{Binding SaveSettingsCommand}"
                            Style="{StaticResource BtnPrimary}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Width="18" Height="18" Margin="0,0,10,0"
                                         VerticalAlignment="Center" Foreground="White" Kind="ContentSave" />
                            <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource AppFont}"
                                       FontSize="13" FontWeight="SemiBold" Foreground="White"
                                       Text="Enregistrer les paramètres" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>