<UserControl x:Class="SFE.WPF.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:SFE.Domain.Enums;assembly=SFE.Domain"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28">
        <StackPanel MaxWidth="900">

            <!-- ══════════════════════════════════════════════════════════════ -->
            <!-- TITRE                                                         -->
            <!-- ══════════════════════════════════════════════════════════════ -->
            <TextBlock Text="Paramètres" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Configurez votre entreprise, points de vente, facturation et préférences"
                       Style="{StaticResource PageSubtitleStyle}"/>

            <!-- ══════════════════════════════════════════════════════════════ -->
            <!-- SECTION 1 — ENTREPRISE                                        -->
            <!-- ══════════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="#EEF2FF" CornerRadius="8" Padding="8" Margin="0,0,12,0">
                            <TextBlock Text="&#xE770;" FontFamily="{StaticResource IconFont}"
                                       FontSize="18" Foreground="{StaticResource PrimaryBrush}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Informations de l'entreprise"
                                       Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                            <TextBlock Text="Données qui apparaîtront sur vos factures et reçus"
                                       FontFamily="{StaticResource AppFont}" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 🆕 LOGO SECTION -->
                    <Border Background="#F8FAFC" CornerRadius="10" Padding="20" Margin="0,0,0,20"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Logo preview -->
                            <Border Width="80" Height="80" CornerRadius="10" ClipToBounds="True"
                                    Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1">
                                <Grid>
                                    <!-- Placeholder when no logo -->
                                    <TextBlock Text="🏢" FontSize="32"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- Actual logo -->
                                    <Image Source="{Binding CompanyLogoPreview}"
                                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>
                            </Border>

                            <!-- Logo actions -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="LOGO DE L'ENTREPRISE"
                                           FontFamily="{StaticResource AppFont}" FontSize="10"
                                           FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="Apparaîtra sur les factures et les rapports. Format recommandé : PNG, 200×200 px."
                                           FontFamily="{StaticResource AppFont}" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="📁 Choisir une image"
                                            Command="{Binding BrowseLogoCommand}"
                                            Background="{StaticResource PrimaryBrush}" Foreground="White"
                                            FontFamily="{StaticResource AppFont}" FontSize="11"
                                            FontWeight="SemiBold" Padding="12,6" BorderThickness="0"
                                            Cursor="Hand" Margin="0,0,8,0"/>
                                    <Button Content="✕ Supprimer"
                                            Command="{Binding RemoveLogoCommand}"
                                            Background="#FEE2E2" Foreground="#DC2626"
                                            FontFamily="{StaticResource AppFont}" FontSize="11"
                                            Padding="12,6" BorderThickness="0" Cursor="Hand"
                                            Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Company fields -->
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,12,16">
                            <TextBlock Text="NOM DE L'ENTREPRISE" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="12,0,0,16">
                            <TextBlock Text="NIF (NUMÉRO D'IMPÔT FISCAL)" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding CompanyNIF, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>

                        <!-- 🆕 ISF field -->
                        <StackPanel Margin="0,0,12,16">
                            <TextBlock Text="ISF (IDENTIFIANT SYSTÈME DE FACTURATION)" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding CompanyISF, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="12,0,0,16">
                            <TextBlock Text="RCCM" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding CompanyRCCM, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,12,16">
                            <TextBlock Text="VILLE" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding CompanyCity, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="12,0,0,16">
                            <TextBlock Text="ADRESSE" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding CompanyAddress, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,12,16">
                            <TextBlock Text="TÉLÉPHONE" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding CompanyPhone, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="12,0,0,16">
                            <TextBlock Text="EMAIL" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding CompanyEmail, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════════ -->
            <!-- SECTION 2 — POINTS DE VENTE & DISPOSITIFS FISCAUX             -->
            <!-- ══════════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel DataContext="{Binding PosManagement}">

                    <!-- Header -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Border Background="#E0E7FF" CornerRadius="8" Padding="8" Margin="0,0,12,0">
                                <TextBlock Text="&#xE7BF;" FontFamily="{StaticResource IconFont}"
                                           FontSize="18" Foreground="{StaticResource PrimaryBrush}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Points de vente"
                                           Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}">
                                    <Run Text="Chaque POS dispose de sa propre configuration fiscale · "/>
                                    <Run Text="{Binding AllPos.Count, Mode=OneWay}"/>
                                    <Run Text=" point(s)"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1" VerticalAlignment="Center"
                                Command="{Binding StartNewPosCommand}"
                                Background="{StaticResource PrimaryBrush}" Foreground="White"
                                FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="SemiBold"
                                Padding="14,8" BorderThickness="0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="＋" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Ajouter un POS"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- ── Bandeau succès ── -->
                    <Border Margin="0,0,0,8" CornerRadius="6" Padding="10,6"
                            Visibility="{Binding ShowSuccess, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" Foreground="{StaticResource SuccessBrush}"
                                       FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                                       FontFamily="{StaticResource AppFont}" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Bandeau erreur ── -->
                    <Border Margin="0,0,0,8" CornerRadius="6" Padding="10,6"
                            Visibility="{Binding ShowError, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✗" Foreground="#DC2626"
                                        FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#DC2626"
                                       FontFamily="{StaticResource AppFont}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Liste des POS ── -->
                    <ItemsControl ItemsSource="{Binding AllPos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" CornerRadius="10" Padding="16,12"
                                        Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,12,0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#10B981"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Background" Value="#9CA3AF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Code}" FontFamily="Consolas"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text=" — " Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource AppFont}"
                                                           FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="{Binding City, Mode=OneWay}"/>
                                                </TextBlock>
                                                <Border CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#EEF2FF"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DeviceType}"
                                                                             Value="{x:Static enums:DeviceType.Mcf}">
                                                                    <Setter Property="Background" Value="#FDF4FF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                                               FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="📡 e-MCF"/>
                                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DeviceType}"
                                                                                 Value="{x:Static enums:DeviceType.Mcf}">
                                                                        <Setter Property="Text" Value="🔌 MCF"/>
                                                                        <Setter Property="Foreground" Value="#9333EA"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <Border CornerRadius="4" Padding="6,2" Margin="4,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#ECFDF5"/>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ManagesStock}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="📦 Stock" FontFamily="{StaticResource AppFont}"
                                                               FontSize="10" Foreground="#059669"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="📦 Init. stock"
                                                FontFamily="{StaticResource AppFont}" FontSize="11"
                                                Padding="10,6" Background="#ECFDF5" BorderThickness="0"
                                                Cursor="Hand" Margin="0,0,6,0" VerticalAlignment="Center"
                                                Command="{Binding DataContext.InitializeStockCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ManagesStock}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Grid.Column="3" Content="✏️" FontSize="14"
                                                Background="Transparent" BorderThickness="0"
                                                Cursor="Hand" Margin="0,0,4,0" VerticalAlignment="Center"
                                                Command="{Binding DataContext.EditPosCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>

                                        <Button Grid.Column="4" Content="🗑" FontSize="14"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.DeactivatePosCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ── Formulaire édition POS ── -->
                    <Border Background="#FFFBEB" CornerRadius="12" Padding="24" Margin="0,8,0,0"
                            BorderBrush="#FDE68A" BorderThickness="1"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="{Binding FormTitle}" FontFamily="{StaticResource AppFont}"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Button Content="✕" HorizontalAlignment="Right" FontSize="14"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Command="{Binding CancelEditCommand}"/>
                            </Grid>

                            <TextBlock Text="I N F O R M A T I O N S G É N É R A L E S" FontFamily="{StaticResource AppFont}"
                                       FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,0,10" />

                            <UniformGrid Columns="3" Margin="0,0,0,12">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="CODE *" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding EditCode}" FontFamily="Consolas"
                                             Style="{StaticResource ModernTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="NOM *" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding EditName}"
                                             Style="{StaticResource ModernTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="VILLE" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding EditCity}"
                                             Style="{StaticResource ModernTextBoxStyle}"/>
                                </StackPanel>
                            </UniformGrid>

                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="ADRESSE" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding EditAddress}"
                                             Style="{StaticResource ModernTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="TÉLÉPHONE" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding EditPhone}"
                                             Style="{StaticResource ModernTextBoxStyle}"/>
                                </StackPanel>
                            </UniformGrid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <CheckBox Content="Gère du stock" IsChecked="{Binding EditManagesStock}"
                                          FontFamily="{StaticResource AppFont}" Margin="0,0,24,0"/>
                                <CheckBox Content="Autoriser stock négatif" IsChecked="{Binding EditAllowNegativeStock}"
                                          FontFamily="{StaticResource AppFont}"/>
                            </StackPanel>

                            <Border Height="1" Background="#E5E7EB" Margin="0,0,0,20"/>

                            <TextBlock Text="DISPOSITIF FISCAL DE CE POINT DE VENTE"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,0,12"/>

                            <UniformGrid Columns="2" Margin="0,0,0,16">
                                <RadioButton GroupName="PosDeviceType"
                                             IsChecked="{Binding EditIsEmcf}"
                                             Style="{StaticResource RadioCardStyle}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="📡 e-MCF" FontFamily="{StaticResource AppFont}"
                                                   FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="API REST (Internet)" FontFamily="{StaticResource AppFont}"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="PosDeviceType"
                                             IsChecked="{Binding EditIsEmcf, Converter={StaticResource InverseBoolConverter}}"
                                             Style="{StaticResource RadioCardStyle}" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="🔌 MCF" FontFamily="{StaticResource AppFont}"
                                                   FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Port série (RS232/USB)" FontFamily="{StaticResource AppFont}"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>

                            <!-- Champs e-MCF -->
                            <Border Background="White" CornerRadius="8" Padding="16"
                                    BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,4"
                                    Visibility="{Binding EditIsEmcf, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="URL DE L'API e-MCF" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding EditEmcfUrl, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="TOKEN JWT" Style="{StaticResource FormLabelStyle}"/>
                                            <TextBox Text="{Binding EditEmcfToken, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBoxStyle}"/>
                                        </StackPanel>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="NIM" Style="{StaticResource FormLabelStyle}"/>
                                            <TextBox Text="{Binding EditEmcfNim, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBoxStyle}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- Note MCF -->
                            <Border Background="White" CornerRadius="8" Padding="16"
                                    BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditIsEmcf}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock TextWrapping="Wrap" FontFamily="{StaticResource AppFont}"
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="Le port COM et le baud rate se configurent dans la section "/>
                                    <Run Text="« Test de connexion »" FontWeight="SemiBold"/>
                                    <Run Text=" ci-dessous. Enregistrez d'abord ce POS, puis testez la connexion."/>
                                </TextBlock>
                            </Border>

                            <!-- Boutons form -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                                <Button Content="Annuler" Command="{Binding CancelEditCommand}"
                                        FontFamily="{StaticResource AppFont}" Padding="16,8" Margin="0,0,8,0"
                                        Background="#F3F4F6" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="💾 Enregistrer" Command="{Binding SavePosCommand}"
                                        Background="{StaticResource PrimaryBrush}" Foreground="White"
                                        FontFamily="{StaticResource AppFont}" FontWeight="SemiBold"
                                        Padding="16,8" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Message vide -->
                    <Border Margin="0,4,0,0" Padding="20" CornerRadius="8" Background="#F9FAFB">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AllPos.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Aucun point de vente configuré. Cliquez « Ajouter un POS » pour commencer."
                                   FontFamily="{StaticResource AppFont}" FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" FontStyle="Italic"/>
                    </Border>

                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════════ -->
            <!-- SECTION 3 — TEST DE CONNEXION AU DISPOSITIF FISCAL            -->
            <!-- ══════════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#FDF2F8" CornerRadius="8" Padding="8" Margin="0,0,12,0">
                            <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}"
                                       FontSize="18" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Test de connexion au dispositif fiscal"
                                       Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                            <TextBlock Text="Vérifiez que votre dispositif e-MCF ou MCF répond correctement"
                                       FontFamily="{StaticResource AppFont}" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Background="#EFF6FF" CornerRadius="8" Padding="14" Margin="0,12,0,20"
                            BorderBrush="#BFDBFE" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ️" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Top"/>
                            <TextBlock TextWrapping="Wrap" FontFamily="{StaticResource AppFont}"
                                       FontSize="12" Foreground="#1E40AF">
                                <Run Text="Cette section permet de tester la connexion avec votre dispositif fiscal. "/>
                                <Run Text="Renseignez les paramètres ci-dessous et cliquez « Tester ». "/>
                                <Run Text="Pour la configuration permanente, éditez le point de vente concerné ci-dessus."
                                     FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <UniformGrid Columns="2" Margin="0,0,0,20">
                        <RadioButton GroupName="DeviceType" IsChecked="{Binding IsEmcfSelected}"
                                     Style="{StaticResource RadioCardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="📡 e-MCF" FontFamily="{StaticResource AppFont}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="API REST distante (HTTPS)"
                                           FontFamily="{StaticResource AppFont}" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="DeviceType"
                                     IsChecked="{Binding IsEmcfSelected, Converter={StaticResource InverseBoolConverter}}"
                                     Style="{StaticResource RadioCardStyle}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="🔌 MCF" FontFamily="{StaticResource AppFont}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Appareil physique (RS232/USB)"
                                           FontFamily="{StaticResource AppFont}" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <!-- Config e-MCF -->
                    <StackPanel Visibility="{Binding IsEmcfSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="20"
                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                            <StackPanel>
                                <TextBlock Text="URL DE L'API" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding EmcfApiUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="TOKEN JWT" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox Text="{Binding EmcfToken, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="NIM" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox Text="{Binding EmcfNIM, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBoxStyle}"/>
                                    </StackPanel>
                                </UniformGrid>
                                <Button Content="🔗 Tester la connexion e-MCF" Margin="0,16,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding TestConnectionCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Config MCF -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmcfSelected}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="20"
                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                            <StackPanel>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,16">
                                        <TextBlock Text="PORT COM" Style="{StaticResource FormLabelStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox ItemsSource="{Binding AvailableComPorts}"
                                                      SelectedItem="{Binding SelectedComPort}"
                                                      Style="{StaticResource ModernComboBoxStyle}"/>
                                            <Button Grid.Column="1" Content="🔄" ToolTip="Rafraîchir les ports"
                                                    Command="{Binding RefreshComPortsCommand}"
                                                    Background="Transparent" BorderThickness="1"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    FontSize="14" Padding="8,4" Margin="6,0,0,0"
                                                    Cursor="Hand" VerticalAlignment="Stretch"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,16">
                                        <TextBlock Text="BAUD RATE" Style="{StaticResource FormLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding AvailableBaudRates}"
                                                  SelectedItem="{Binding BaudRate}"
                                                  Style="{StaticResource ModernComboBoxStyle}"/>
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12">
                                    <Run Text="Format: 8N1 · "/>
                                    <Run Text="{Binding AvailableComPorts.Count, Mode=OneWay,
                                               StringFormat='{}{0} port(s) détecté(s)'}"/>
                                </TextBlock>
                                <Button Content="🔌 Tester la connexion MCF"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding TestConnectionCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Indicateur test en cours -->
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0"
                                Visibility="{Binding IsTestingConnection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="#EEF2FF" CornerRadius="12" Padding="6,3" Margin="0,0,8,0">
                            <TextBlock Text="⏳" FontSize="14"/>
                        </Border>
                        <TextBlock Text="Test de connexion en cours..."
                                   FontFamily="{StaticResource AppFont}" FontSize="13"
                                   Foreground="{StaticResource PrimaryBrush}" FontStyle="Italic"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Résultat du test -->
                    <Border Margin="0,16,0,0" CornerRadius="10" Padding="20"
                            Visibility="{Binding HasTestResult, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#F7FAFC"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TestSuccess}" Value="True">
                                        <Setter Property="Background" Value="#F0FFF4"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TestSuccess}" Value="False">
                                        <Setter Property="Background" Value="#FFF5F5"/>
                                        <Setter Property="BorderBrush" Value="#FC8181"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="❌"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TestSuccess}" Value="True">
                                                    <Setter Property="Text" Value="✅"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Connexion échouée"/>
                                                <Setter Property="Foreground" Value="#E53E3E"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TestSuccess}" Value="True">
                                                        <Setter Property="Text" Value="Connexion réussie"/>
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding TestStatus}" FontFamily="{StaticResource AppFont}"
                                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{Binding TestMessage}" TextWrapping="Wrap"
                                       FontFamily="{StaticResource AppFont}" FontSize="13"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                            <Border Background="White" CornerRadius="8" Padding="16"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Temps de réponse" FontFamily="{StaticResource AppFont}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TestResponseTime}"
                                               FontFamily="{StaticResource AppFont}" FontSize="12"/>
                                    <TextBlock Grid.Row="2" Text="NIM" FontFamily="{StaticResource AppFont}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding TestNIM}"
                                               FontFamily="{StaticResource AppFont}" FontSize="12"
                                               FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Grid.Row="4" Text="Type" FontFamily="{StaticResource AppFont}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding TestServerVersion}"
                                               FontFamily="{StaticResource AppFont}" FontSize="12"/>
                                </Grid>
                            </Border>

                            <Expander Margin="0,12,0,0" IsExpanded="False">
                                <Expander.Header>
                                    <TextBlock Text="📋 Détails complets" FontFamily="{StaticResource AppFont}"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Expander.Header>
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="{Binding TestDetails}" TextWrapping="Wrap"
                                               FontFamily="{StaticResource AppFont}" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                                    <TextBlock Text="RÉPONSE BRUTE" FontFamily="{StaticResource AppFont}"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                    <Border Background="#1A202C" CornerRadius="6" Padding="12">
                                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding TestRawResponse}" Foreground="#A0AEC0"
                                                       FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════════ -->
            <!-- SECTION 4 — FACTURATION & CALCUL                              -->
            <!-- ══════════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="#ECFDF5" CornerRadius="8" Padding="8" Margin="0,0,12,0">
                            <TextBlock Text="&#xE8C7;" FontFamily="{StaticResource IconFont}"
                                       FontSize="18" Foreground="{StaticResource SuccessBrush}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Facturation et calcul"
                                       Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                            <TextBlock Text="Mode de prix, calcul de la remise, devise et taux de change"
                                       FontFamily="{StaticResource AppFont}" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Background="#F8FAFC" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="15"
                                           FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Mode HT (Hors Taxes)"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPriceModeTTC}" Value="True">
                                                    <Setter Property="Text" Value="Mode TTC (Toutes Taxes Comprises)"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text"
                                                    Value="Les prix saisis dans les factures sont hors taxes"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPriceModeTTC}" Value="True">
                                                    <Setter Property="Text"
                                                            Value="Les prix saisis dans les factures incluent la TVA"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="HT" FontFamily="{StaticResource AppFont}" FontSize="13"
                                           FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ToggleButton IsChecked="{Binding IsPriceModeTTC}"
                                              Style="{StaticResource ToggleSwitchStyle}"/>
                                <TextBlock Text="TTC" FontFamily="{StaticResource AppFont}" FontSize="13"
                                           FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="#F8FAFC" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="15"
                                           FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Remise après calcul de la TVA"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DiscountBeforeTax}" Value="True">
                                                    <Setter Property="Text" Value="Remise avant calcul de la TVA"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text"
                                                    Value="La remise est soustraite du montant TTC (TVA calculée sur le prix plein)"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DiscountBeforeTax}" Value="True">
                                                    <Setter Property="Text"
                                                            Value="La remise est soustraite du prix HT, la TVA est calculée sur le montant remisé"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Après" FontFamily="{StaticResource AppFont}" FontSize="12"
                                           FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ToggleButton IsChecked="{Binding DiscountBeforeTax}"
                                              Style="{StaticResource ToggleSwitchStyle}"/>
                                <TextBlock Text="Avant" FontFamily="{StaticResource AppFont}" FontSize="12"
                                           FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="#F8FAFC" CornerRadius="10" Padding="20">
                        <StackPanel>
                            <TextBlock Text="DEVISE ET TAUX DE CHANGE"
                                       FontFamily="{StaticResource AppFont}" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="DEVISE PRINCIPALE" Style="{StaticResource FormLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding Currencies}"
                                              SelectedItem="{Binding DefaultCurrency}"
                                              Style="{StaticResource ModernComboBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="TAUX DE CHANGE (CDF/USD)" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding CurrentExchangeRate, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="MODE" Style="{StaticResource FormLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding ExchangeRateModes}"
                                              SelectedItem="{Binding ExchangeRateMode}"
                                              Style="{StaticResource ModernComboBoxStyle}"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════════ -->
            <!-- SECTION 5 — FIDÉLITÉ                                          -->
            <!-- ══════════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="#FEF3C7" CornerRadius="8" Padding="8" Margin="0,0,12,0">
                            <TextBlock Text="&#xEB51;" FontFamily="{StaticResource IconFont}"
                                       FontSize="18" Foreground="{StaticResource WarningBrush}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Programme de fidélité"
                                       Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                            <TextBlock Text="Récompensez vos clients réguliers avec des points"
                                       FontFamily="{StaticResource AppFont}" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Background="#F8FAFC" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Activer le programme de fidélité"
                                           FontFamily="{StaticResource AppFont}" FontSize="15"
                                           FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Les clients pourront accumuler et utiliser des points"
                                           FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="13"
                                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Désactivé"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoyaltyEnabled}" Value="True">
                                                    <Setter Property="Text" Value="Activé"/>
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ToggleButton IsChecked="{Binding IsLoyaltyEnabled}"
                                              Style="{StaticResource ToggleSwitchSuccessStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoyaltyEnabled}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,12,16">
                                <TextBlock Text="TAUX D'ACCUMULATION (1 POINT PAR X CDF)"
                                           Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding LoyaltyEarnRate, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Margin="12,0,0,16">
                                <TextBlock Text="VALEUR DE RÉDEMPTION (1 POINT = X CDF)"
                                           Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding LoyaltyRedeemRate, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel>
                            <TextBlock Text="MINIMUM DE POINTS POUR UTILISER"
                                       Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding LoyaltyMinRedeemPoints, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     MaxWidth="300" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════════ -->
            <!-- SECTION 6 — LICENCE                                           -->
            <!-- ══════════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="#FDF4FF" CornerRadius="8" Padding="8" Margin="0,0,12,0">
                            <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource IconFont}"
                                       FontSize="18" Foreground="#9333EA"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Licence"
                                       Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                            <TextBlock Text="Gérez votre licence d'utilisation"
                                       FontFamily="{StaticResource AppFont}" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Background="#F8FAFC" CornerRadius="10" Padding="20" Margin="0,0,0,20"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <UniformGrid Columns="2">
                            <StackPanel>
                                <TextBlock Text="PLAN ACTUEL" FontFamily="{StaticResource AppFont}"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding LicensePlan}" FontFamily="{StaticResource AppFont}"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="STATUT" FontFamily="{StaticResource AppFont}"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding LicenseStatus}" FontFamily="{StaticResource AppFont}"
                                           FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <TextBlock Text="CLÉ DE LICENCE" Style="{StaticResource FormLabelStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}" FontFamily="Consolas"/>
                        <Button Grid.Column="1" Content="🔓 Activer"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ActivateLicenseCommand}"
                                Margin="12,0,0,0" Padding="24,0"/>
                    </Grid>

                    <TextBlock Text="{Binding LicenseMessage}" Margin="0,8,0,0"
                               FontFamily="{StaticResource AppFont}" FontSize="12"
                               TextWrapping="Wrap" Foreground="#E53E3E">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LicenseMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════════ -->
            <!-- BOUTON ENREGISTRER GLOBAL                                     -->
            <!-- ══════════════════════════════════════════════════════════════ -->
            <Grid Margin="0,8,0,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowSaveSuccess}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="✓" Foreground="{StaticResource SuccessBrush}"
                               FontSize="16" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SaveStatus}" FontFamily="{StaticResource AppFont}"
                               FontSize="14" Foreground="{StaticResource SuccessBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowSaveError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="✗" Foreground="#DC2626"
                               FontSize="16" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SaveStatus}" FontFamily="{StaticResource AppFont}"
                               FontSize="14" Foreground="#DC2626" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" Content="💾  Enregistrer les paramètres"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SaveSettingsCommand}" Padding="32,14"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>