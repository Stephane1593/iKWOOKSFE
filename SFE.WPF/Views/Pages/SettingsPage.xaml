<UserControl x:Class="SFE.WPF.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:SFE.Domain.Enums;assembly=SFE.Domain"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <!--  ── Thin round scrollbar ──  -->
        <Style x:Key="SlimScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Margin="1" Background="{StaticResource BorderBrush}"
                                CornerRadius="3" Opacity="0.45" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimVerticalScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border Background="Transparent" CornerRadius="4" />
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SlimScrollThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TouchScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="PanningMode" Value="VerticalOnly" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter Margin="36,24,36,32" />
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Margin="0,8,2,8" HorizontalAlignment="Right"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       Style="{StaticResource SlimVerticalScrollBar}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Value="{TemplateBinding VerticalOffset}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ── Gradient Brushes ──  -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#1E3A5F" />
            <GradientStop Offset="0.5" Color="#2D5F8A" />
            <GradientStop Offset="1" Color="#1A4D7C" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#2563EB" />
            <GradientStop Offset="0.5" Color="#3B82F6" />
            <GradientStop Offset="1" Color="#1D4ED8" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#059669" />
            <GradientStop Offset="1" Color="#10B981" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GoldGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#D97706" />
            <GradientStop Offset="1" Color="#F59E0B" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassOverlay" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#20FFFFFF" />
            <GradientStop Offset="1" Color="#08FFFFFF" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardGlow" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FFFFFF" />
            <GradientStop Offset="0.4" Color="#FAFBFD" />
            <GradientStop Offset="1" Color="#F5F7FA" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SeparatorGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="Transparent" />
            <GradientStop Offset="0.2" Color="#E2E8F0" />
            <GradientStop Offset="0.5" Color="#CBD5E1" />
            <GradientStop Offset="0.8" Color="#E2E8F0" />
            <GradientStop Offset="1" Color="Transparent" />
        </LinearGradientBrush>

        <!--  ── Premium Card ──  -->
        <Style x:Key="PremiumCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardGlow}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="Padding" Value="28" />
            <Setter Property="Margin" Value="0,0,0,20" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" Direction="270"
                                      Opacity="0.06" ShadowDepth="4" Color="#1E3A5F" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6" />
                                <Setter TargetName="bd" Property="Background" Value="White" />
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="12" Opacity="0.12"
                                                          ShadowDepth="0" Color="#3B82F6" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Margin" Value="2,0,0,8" />
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Padding="24,13"
                                Background="{StaticResource PrimaryGradient}" CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" Direction="270"
                                                  Opacity="0.2" ShadowDepth="3" Color="#2563EB" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="24" Direction="270"
                                                          Opacity="0.35" ShadowDepth="5" Color="#2563EB" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Padding="16,10" Background="#F1F5F9"
                                BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#CBD5E1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallIconBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Padding="8,6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" ToolTip="{TemplateBinding ToolTip}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#CBD5E1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InnerPanel" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#F8FAFC" />
                        <GradientStop Offset="1" Color="#F1F5F9" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ── Quick-jump nav button ──  -->
        <Style x:Key="NavChip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Padding="12,7"
                                Background="#F1F5F9" BorderBrush="#E2E8F0"
                                BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DBEAFE" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#93C5FD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ─────────────────────────────────────────────────────
              🆕 HEALTH BADGE STYLES — driven by DeviceHealthBadgeKind
              ─────────────────────────────────────────────────────  -->

        <!--  Outer card: gradient + border switch on badge kind  -->
        <Style x:Key="HealthCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderThickness" Value="1" />
            <!-- neutral default -->
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#F8FAFC" />
                        <GradientStop Offset="1" Color="#F1F5F9" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DeviceHealthBadgeKind}" Value="ok">
                    <Setter Property="BorderBrush" Value="#86EFAC" />
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#ECFDF5" />
                                <GradientStop Offset="1" Color="#D1FAE5" />
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding DeviceHealthBadgeKind}" Value="warn">
                    <Setter Property="BorderBrush" Value="#FDE68A" />
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#FFFBEB" />
                                <GradientStop Offset="1" Color="#FEF3C7" />
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding DeviceHealthBadgeKind}" Value="error">
                    <Setter Property="BorderBrush" Value="#FECACA" />
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#FEF2F2" />
                                <GradientStop Offset="1" Color="#FEE2E2" />
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Round icon container next to the label  -->
        <Style x:Key="HealthIconBubble" TargetType="Border">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Background" Value="#E2E8F0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DeviceHealthBadgeKind}" Value="ok">
                    <Setter Property="Background" Value="#D1FAE5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DeviceHealthBadgeKind}" Value="warn">
                    <Setter Property="Background" Value="#FEF3C7" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DeviceHealthBadgeKind}" Value="error">
                    <Setter Property="Background" Value="#FEE2E2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Big label text (e.g. "✓ Opérationnel")  -->
        <Style x:Key="HealthLabelText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#475569" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DeviceHealthBadgeKind}" Value="ok">
                    <Setter Property="Foreground" Value="#059669" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DeviceHealthBadgeKind}" Value="warn">
                    <Setter Property="Foreground" Value="#92400E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DeviceHealthBadgeKind}" Value="error">
                    <Setter Property="Foreground" Value="#DC2626" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Warning chip in the warnings list  -->
        <Style x:Key="HealthWarningChip" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFBEB" />
            <Setter Property="BorderBrush" Value="#FDE68A" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.DeviceHealthBadgeKind, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="error">
                    <Setter Property="Background" Value="#FEF2F2" />
                    <Setter Property="BorderBrush" Value="#FECACA" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         ROOT GRID — sticky header (top) + scrollable content + sticky save bar
         ═══════════════════════════════════════════════════════════════ -->
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ═══════════════════════════════════════════════════
              STICKY TOP BAR
              ═══════════════════════════════════════════════════  -->
        <Border Grid.Row="0" Padding="32,16" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" Direction="270"
                                  Opacity="0.06" ShadowDepth="2" Color="#1E3A5F" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" Background="{StaticResource HeaderGradient}"
                            CornerRadius="11">
                        <md:PackIcon Width="22" Height="22"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Foreground="White" Kind="CogOutline" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="16"
                                   FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="Paramètres" />
                        <TextBlock Margin="0,2,0,0" FontFamily="{StaticResource AppFont}"
                                   FontSize="11" Foreground="#94A3B8"
                                   Text="Entreprise · Dispositif · Facturation · Fidélité · Licence" />
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Column="1" Margin="20,0" VerticalAlignment="Center"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource NavChip}" Click="JumpToCompany">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Width="14" Height="14" Margin="0,0,5,0"
                                             VerticalAlignment="Center" Foreground="#2563EB" Kind="Domain" />
                                <TextBlock FontSize="11" Foreground="#1E40AF" Text="Entreprise" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavChip}" Click="JumpToDevice">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Width="14" Height="14" Margin="0,0,5,0"
                                             VerticalAlignment="Center" Foreground="#DB2777" Kind="AccessPointNetwork" />
                                <TextBlock FontSize="11" Foreground="#9D174D" Text="Dispositif" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavChip}" Click="JumpToBilling">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Width="14" Height="14" Margin="0,0,5,0"
                                             VerticalAlignment="Center" Foreground="#059669" Kind="CalculatorVariant" />
                                <TextBlock FontSize="11" Foreground="#065F46" Text="Facturation" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavChip}" Click="JumpToLoyalty">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Width="14" Height="14" Margin="0,0,5,0"
                                             VerticalAlignment="Center" Foreground="#D97706" Kind="StarCircle" />
                                <TextBlock FontSize="11" Foreground="#92400E" Text="Fidélité" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavChip}" Click="JumpToLicense">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Width="14" Height="14" Margin="0,0,5,0"
                                             VerticalAlignment="Center" Foreground="#7C3AED" Kind="ShieldKey" />
                                <TextBlock FontSize="11" Foreground="#5B21B6" Text="Licence" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Column="2" Command="{Binding SaveSettingsCommand}"
                        Style="{StaticResource BtnPrimary}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Width="18" Height="18" Margin="0,0,8,0"
                                     VerticalAlignment="Center" Foreground="White" Kind="ContentSave" />
                        <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource AppFont}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="White"
                                   Text="Enregistrer" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!--  ═══════════════════════════════════════════════════
              SCROLLABLE CONTENT
              ═══════════════════════════════════════════════════  -->
        <ScrollViewer x:Name="MainScroll" Grid.Row="1"
                      Style="{StaticResource TouchScrollViewer}">
            <StackPanel MaxWidth="900">

                <!-- ════════════════════════════════════════════
                     SECTION 1 — ENTREPRISE
                     ════════════════════════════════════════════ -->
                <Border x:Name="SectionCompany" Style="{StaticResource PremiumCard}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,22" Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0" Color="#EEF2FF" />
                                        <GradientStop Offset="1" Color="#DBEAFE" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <md:PackIcon Width="22" Height="22"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Foreground="#2563EB" Kind="Domain" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="15"
                                           FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="Informations de l'entreprise" />
                                <TextBlock Margin="0,3,0,0" FontFamily="{StaticResource AppFont}"
                                           FontSize="12" Foreground="#94A3B8"
                                           Text="Données qui apparaîtront sur vos factures et reçus" />
                            </StackPanel>
                        </StackPanel>

                        <Rectangle Height="1" Margin="0,0,0,22" Fill="{StaticResource SeparatorGradient}" />

                        <Border Margin="0,0,0,22" Padding="22"
                                BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#F8FAFC" />
                                    <GradientStop Offset="1" Color="#F1F5F9" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="84" Height="84" BorderBrush="#CBD5E1"
                                        BorderThickness="1" ClipToBounds="True" CornerRadius="14">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Offset="0" Color="#E2E8F0" />
                                            <GradientStop Offset="1" Color="#CBD5E1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <md:PackIcon Width="36" Height="36"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Foreground="#94A3B8" Kind="OfficeBuilding">
                                            <md:PackIcon.Style>
                                                <Style TargetType="md:PackIcon">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </md:PackIcon.Style>
                                        </md:PackIcon>
                                        <Image RenderOptions.BitmapScalingMode="HighQuality"
                                               Source="{Binding CompanyLogoPreview}" Stretch="Uniform"
                                               Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Margin="0,0,0,6" FontFamily="{StaticResource AppFont}"
                                               FontSize="10" FontWeight="Bold" Foreground="#94A3B8"
                                               Text="LOGO DE L'ENTREPRISE" />
                                    <TextBlock Margin="0,0,0,14" FontFamily="{StaticResource AppFont}"
                                               FontSize="11" Foreground="#64748B"
                                               Text="PNG, 200×200 px recommandé." TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding BrowseLogoCommand}"
                                                Style="{StaticResource BtnSecondary}">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Width="14" Height="14" Margin="0,0,6,0"
                                                             VerticalAlignment="Center" Foreground="#2563EB"
                                                             Kind="FolderImage" />
                                                <TextBlock FontSize="11" Foreground="#2563EB"
                                                           Text="Choisir une image" />
                                            </StackPanel>
                                        </Button>
                                        <Button Margin="8,0,0,0" Command="{Binding RemoveLogoCommand}"
                                                Style="{StaticResource BtnSecondary}"
                                                Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Width="14" Height="14" Margin="0,0,5,0"
                                                             VerticalAlignment="Center" Foreground="#DC2626" Kind="Close" />
                                                <TextBlock FontSize="11" Foreground="#DC2626" Text="Supprimer" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="NOM DE L'ENTREPRISE" />
                                <TextBox Style="{StaticResource FormInput}"
                                         Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="NIF (NUMÉRO D'IMPÔT FISCAL)" />
                                <TextBox Style="{StaticResource FormInput}"
                                         Text="{Binding CompanyNIF, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="RCCM" />
                                <TextBox Style="{StaticResource FormInput}"
                                         Text="{Binding CompanyRCCM, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,16"
                                        Visibility="{Binding CanSeeISF, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="ISF (IDENTIFIANT SYSTÈME DE FACTURATION)" />
                                <TextBox Style="{StaticResource FormInput}"
                                         Text="{Binding CompanyISF, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="VILLE" />
                                <TextBox Style="{StaticResource FormInput}"
                                         Text="{Binding CompanyCity, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="ADRESSE" />
                                <TextBox Style="{StaticResource FormInput}"
                                         Text="{Binding CompanyAddress, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="TÉLÉPHONE" />
                                <TextBox Style="{StaticResource FormInput}"
                                         Text="{Binding CompanyPhone, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="EMAIL" />
                                <TextBox Style="{StaticResource FormInput}"
                                         Text="{Binding CompanyEmail, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ════════════════════════════════════════════
                     SECTION 2 — DISPOSITIF FISCAL
                     ════════════════════════════════════════════ -->
                <Border x:Name="SectionDevice" Style="{StaticResource PremiumCard}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0" Color="#FDF2F8" />
                                        <GradientStop Offset="1" Color="#FCE7F3" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <md:PackIcon Width="22" Height="22"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Foreground="#DB2777" Kind="AccessPointNetwork" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="15"
                                           FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="Dispositif fiscal du POS actif" />
                                <TextBlock Margin="0,3,0,0" FontFamily="{StaticResource AppFont}"
                                           FontSize="12" Foreground="#94A3B8"
                                           Text="Configuration en lecture seule — modifiable dans « Gestion des Points de Vente »" />
                            </StackPanel>
                        </StackPanel>

                        <Rectangle Height="1" Margin="0,10,0,20" Fill="{StaticResource SeparatorGradient}" />

                        <Border Margin="0,0,0,18" Padding="20" CornerRadius="14"
                                BorderBrush="#BFDBFE" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#EFF6FF" />
                                    <GradientStop Offset="1" Color="#DBEAFE" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="48" Height="48" Background="#1E40AF" CornerRadius="12">
                                    <md:PackIcon Width="24" Height="24"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Foreground="White" Kind="StoreOutline" />
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                               FontWeight="Bold" Foreground="#1E40AF" Text="POS ACTIF" />
                                    <TextBlock Margin="0,3,0,0" FontFamily="{StaticResource AppFont}"
                                               FontSize="14" FontWeight="SemiBold" Foreground="#1E3A8A"
                                               Text="{Binding ActivePosLabel}" />
                                    <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource AppFont}"
                                               FontSize="12" Foreground="#1E40AF"
                                               Text="{Binding ActivePosDeviceSummary}" />
                                </StackPanel>

                                <Button Grid.Column="3" VerticalAlignment="Center"
                                        Command="{Binding RefreshActivePosDeviceConfigCommand}"
                                        Style="{StaticResource BtnSecondary}"
                                        ToolTip="Recharger la configuration depuis la base de données">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Width="14" Height="14" Margin="0,0,6,0"
                                                     VerticalAlignment="Center" Foreground="#2563EB" Kind="Refresh" />
                                        <TextBlock FontSize="11" Foreground="#2563EB" Text="Recharger" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Margin="0,0,0,18" Padding="14,12" CornerRadius="10"
                                Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Width="18" Height="18" Margin="0,0,10,0"
                                             VerticalAlignment="Top" Foreground="#92400E" Kind="InformationOutline" />
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11"
                                           Foreground="#92400E" TextWrapping="Wrap">
                                    <Run Text="Pour modifier le type de dispositif (e-MCF / MCF), l'URL API, le token, le port COM ou le baudrate, " />
                                    <Run FontWeight="Bold" Text="ouvrez « Gestion des Points de Vente »" />
                                    <Run Text=" et éditez le POS concerné. Ces paramètres ne sont pas modifiables ici." />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Button HorizontalAlignment="Left"
                                Command="{Binding TestConnectionCommand}"
                                Style="{StaticResource BtnSecondary}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Width="16" Height="16" Margin="0,0,8,0"
                                             VerticalAlignment="Center" Foreground="#2563EB" Kind="LanConnect" />
                                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource AppFont}"
                                           FontSize="12" Foreground="#2563EB"
                                           Text="Tester la connexion du POS actif" />
                            </StackPanel>
                        </Button>

                        <Border Margin="0,16,0,0" Padding="16,14" CornerRadius="12"
                                Visibility="{Binding IsTestingConnection, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#EFF6FF" />
                                    <GradientStop Offset="1" Color="#DBEAFE" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Width="20" Height="20" Margin="0,0,12,0"
                                             VerticalAlignment="Center" Foreground="#2563EB" Kind="TimerSand" />
                                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource AppFont}"
                                           FontSize="13" FontStyle="Italic" Foreground="#2563EB"
                                           Text="Test de connexion en cours…" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,0" Padding="22" CornerRadius="14"
                                Visibility="{Binding HasTestResult, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Offset="0" Color="#F8FAFC" />
                                                <GradientStop Offset="1" Color="#F1F5F9" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TestSuccess}" Value="True">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Offset="0" Color="#ECFDF5" />
                                                        <GradientStop Offset="1" Color="#D1FAE5" />
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="BorderBrush" Value="#86EFAC" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TestSuccess}" Value="False">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Offset="0" Color="#FEF2F2" />
                                                        <GradientStop Offset="1" Color="#FEE2E2" />
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="BorderBrush" Value="#FECACA" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                                    <Border Width="44" Height="44" Margin="0,0,14,0"
                                            VerticalAlignment="Center" CornerRadius="12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FEE2E2" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TestSuccess}" Value="True">
                                                        <Setter Property="Background" Value="#D1FAE5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <md:PackIcon Width="24" Height="24"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Foreground="#059669" Kind="CheckCircle"
                                                         Visibility="{Binding TestSuccess, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <md:PackIcon Width="24" Height="24"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Foreground="#DC2626" Kind="CloseCircle">
                                                <md:PackIcon.Style>
                                                    <Style TargetType="md:PackIcon">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TestSuccess}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </md:PackIcon.Style>
                                            </md:PackIcon>
                                        </Grid>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Connexion échouée" />
                                                    <Setter Property="Foreground" Value="#DC2626" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TestSuccess}" Value="True">
                                                            <Setter Property="Text" Value="Connexion réussie" />
                                                            <Setter Property="Foreground" Value="#059669" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="0,2,0,0" FontFamily="{StaticResource AppFont}"
                                                   FontSize="11" Foreground="#94A3B8" Text="{Binding TestStatus}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Margin="0,0,0,18" FontFamily="{StaticResource AppFont}"
                                           FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{Binding TestMessage}" TextWrapping="Wrap" />

                                <Border Padding="18" Background="White"
                                        BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#64748B" Text="Temps de réponse" />
                                        <TextBlock Grid.Column="2" FontSize="12" Text="{Binding TestResponseTime}" />
                                        <TextBlock Grid.Row="2" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#64748B" Text="NIM" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" FontSize="12"
                                                   FontWeight="Bold" Foreground="#2563EB" Text="{Binding TestNIM}" />
                                        <TextBlock Grid.Row="4" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#64748B" Text="Type" />
                                        <TextBlock Grid.Row="4" Grid.Column="2" FontSize="12"
                                                   Text="{Binding TestServerVersion}" />
                                    </Grid>
                                </Border>

                                <Expander Margin="0,14,0,0" IsExpanded="False">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Width="16" Height="16" Margin="0,0,8,0"
                                                         VerticalAlignment="Center" Foreground="#64748B"
                                                         Kind="ClipboardTextOutline" />
                                            <TextBlock FontSize="12" Foreground="#64748B" Text="Détails complets" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Margin="0,0,0,12" FontSize="11" Foreground="#94A3B8"
                                                   Text="{Binding TestDetails}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,0,0,8" FontSize="10" FontWeight="Bold"
                                                   Foreground="#94A3B8" Text="RÉPONSE BRUTE" />
                                        <Border Padding="16" CornerRadius="10">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0" Color="#1A202C" />
                                                    <GradientStop Offset="1" Color="#0F172A" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                                <TextBlock FontFamily="Consolas" FontSize="11"
                                                           Foreground="#94A3B8" Text="{Binding TestRawResponse}"
                                                           TextWrapping="Wrap" />
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ════════════════════════════════════════════
                     SECTION 2.5 — INFOS DÉTAILLÉES DU DISPOSITIF
                     ════════════════════════════════════════════ -->
                <Border Style="{StaticResource PremiumCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="44" Height="44" CornerRadius="12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Offset="0" Color="#F0FDF4" />
                                            <GradientStop Offset="1" Color="#DCFCE7" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <md:PackIcon Width="22" Height="22" HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" Foreground="#059669" Kind="Memory" />
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="15"
                                               FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="Informations détaillées du dispositif" />
                                    <TextBlock Margin="0,3,0,0" FontFamily="{StaticResource AppFont}"
                                               FontSize="12" Foreground="#94A3B8"
                                               Text="Données lues en temps réel depuis le MCF / e-MCF connecté" />
                                </StackPanel>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Command="{Binding LoadDeviceInfoCommand}" Style="{StaticResource BtnSecondary}">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Width="16" Height="16" Margin="0,0,8,0"
                                                 VerticalAlignment="Center" Foreground="#059669" Kind="Refresh" />
                                    <TextBlock FontSize="12" Foreground="#059669" Text="Interroger" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Margin="0,4,0,0" Padding="10,6" HorizontalAlignment="Right"
                                CornerRadius="8" BorderThickness="1"
                                Visibility="{Binding HasDeviceInfo, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F0FDF4" />
                                    <Setter Property="BorderBrush" Value="#86EFAC" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DeviceUsedFallback}" Value="True">
                                            <Setter Property="Background" Value="#FEF3C7" />
                                            <Setter Property="BorderBrush" Value="#FDE68A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <md:PackIcon.Style>
                                        <Style TargetType="md:PackIcon">
                                            <Setter Property="Kind" Value="ShieldCheck" />
                                            <Setter Property="Foreground" Value="#059669" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeviceUsedFallback}" Value="True">
                                                    <Setter Property="Kind" Value="ShieldAlert" />
                                                    <Setter Property="Foreground" Value="#D97706" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </md:PackIcon.Style>
                                </md:PackIcon>
                                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource AppFont}"
                                           FontSize="11" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#059669" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeviceUsedFallback}" Value="True">
                                                    <Setter Property="Foreground" Value="#92400E" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="Réponse via : " />
                                    <Run Text="{Binding DeviceRespondingBadge, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Rectangle Height="1" Margin="0,14,0,22" Fill="{StaticResource SeparatorGradient}" />

                        <Border Margin="0,0,0,16" Padding="16,14" CornerRadius="12"
                                Visibility="{Binding IsDeviceInfoLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#EFF6FF" />
                                    <GradientStop Offset="1" Color="#DBEAFE" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Width="20" Height="20" Margin="0,0,12,0"
                                             VerticalAlignment="Center" Foreground="#2563EB" Kind="TimerSand" />
                                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource AppFont}"
                                           FontSize="13" FontStyle="Italic" Foreground="#2563EB"
                                           Text="Interrogation du dispositif fiscal…" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,0,16" Padding="16,14" CornerRadius="12"
                                BorderBrush="#FECACA" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasDeviceInfo}" Value="True" />
                                                <Condition Binding="{Binding DeviceInfoSuccess}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#FEF2F2" />
                                    <GradientStop Offset="1" Color="#FEE2E2" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Width="20" Height="20" Margin="0,0,12,0"
                                             VerticalAlignment="Center" Foreground="#DC2626" Kind="AlertCircle" />
                                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource AppFont}"
                                           FontSize="13" Foreground="#DC2626"
                                           Text="{Binding DeviceInfoError}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- ════ Success content ════ -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasDeviceInfo}" Value="True" />
                                                <Condition Binding="{Binding DeviceInfoSuccess}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- ═══════════════════════════════════════════════════
                                 🆕 HEALTH VERDICT — synthetic at-a-glance status
                                 ═══════════════════════════════════════════════════ -->
                            <Border Margin="0,0,0,18" Style="{StaticResource HealthCard}"
                                    Visibility="{Binding HasHealthReport, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <!-- Header row: bubble + label + sync age -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource HealthIconBubble}">
                                            <Grid>
                                                <md:PackIcon Width="22" Height="22"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Kind="HelpCircleOutline" Foreground="#64748B">
                                                    <md:PackIcon.Style>
                                                        <Style TargetType="md:PackIcon">
                                                            <Setter Property="Kind" Value="HelpCircleOutline" />
                                                            <Setter Property="Foreground" Value="#64748B" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DeviceHealthBadgeKind}" Value="ok">
                                                                    <Setter Property="Kind" Value="HeartPulse" />
                                                                    <Setter Property="Foreground" Value="#059669" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DeviceHealthBadgeKind}" Value="warn">
                                                                    <Setter Property="Kind" Value="AlertOutline" />
                                                                    <Setter Property="Foreground" Value="#D97706" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DeviceHealthBadgeKind}" Value="error">
                                                                    <Setter Property="Kind" Value="AlertOctagon" />
                                                                    <Setter Property="Foreground" Value="#DC2626" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </md:PackIcon.Style>
                                                </md:PackIcon>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DeviceHealthLabel}"
                                                       Style="{StaticResource HealthLabelText}" />
                                            <TextBlock Margin="0,3,0,0" FontSize="10" FontWeight="Bold"
                                                       Foreground="#94A3B8" Text="ÉTAT DE SANTÉ DU DISPOSITIF" />
                                        </StackPanel>

                                        <!-- Sync-age pill on the right -->
                                        <Border Grid.Column="3" Padding="10,6" VerticalAlignment="Center"
                                                Background="#FFFFFF" BorderBrush="#E2E8F0"
                                                BorderThickness="1" CornerRadius="10" Opacity="0.85">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Width="13" Height="13" Margin="0,0,6,0"
                                                             VerticalAlignment="Center" Foreground="#64748B"
                                                             Kind="ClockOutline" />
                                                <TextBlock VerticalAlignment="Center" FontSize="11"
                                                           Foreground="#475569" FontWeight="SemiBold">
                                                    <Run Text="Sync : " />
                                                    <Run Text="{Binding DeviceHealthSyncAge, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Summary line -->
                                    <TextBlock Margin="0,0,0,4" FontFamily="{StaticResource AppFont}"
                                               FontSize="13" Foreground="#1E293B"
                                               Text="{Binding DeviceHealthSummary}" TextWrapping="Wrap" />

                                    <!-- Warnings list (only when there are warnings) -->
                                    <StackPanel Margin="0,12,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DeviceHealthWarnings.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <TextBlock Margin="0,0,0,8" FontSize="10" FontWeight="Bold"
                                                   Foreground="#94A3B8" Text="AVERTISSEMENTS" />

                                        <ItemsControl ItemsSource="{Binding DeviceHealthWarnings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource HealthWarningChip}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <md:PackIcon Width="14" Height="14" Margin="0,2,8,0"
                                                                         VerticalAlignment="Top"
                                                                         Foreground="#92400E"
                                                                         Kind="AlertCircleOutline" />
                                                            <TextBlock VerticalAlignment="Center" FontSize="12"
                                                                       Foreground="#7C2D12"
                                                                       Text="{Binding}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Identity & Connection -->
                            <Border Margin="0,0,0,18" Style="{StaticResource InnerPanel}">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,14" FontSize="10" FontWeight="Bold"
                                               Foreground="#94A3B8" Text="IDENTITÉ DU DISPOSITIF" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="TYPE" />
                                            <TextBlock Margin="0,4,0,0" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DeviceInfoType}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="NIM" />
                                            <TextBlock Margin="0,4,0,0" FontSize="13" FontWeight="Bold"
                                                       Foreground="#2563EB" Text="{Binding DeviceNIM}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="NIF" />
                                            <TextBlock Margin="0,4,0,0" FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DeviceNIF}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="STATUT CONNEXION DGI" />
                                            <TextBlock Margin="0,4,0,0" FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#DC2626" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DeviceConnectionStatus}" Value="CON">
                                                                <Setter Property="Foreground" Value="#059669" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DeviceConnectionStatus}" Value="TRA">
                                                                <Setter Property="Foreground" Value="#D97706" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="{Binding DeviceConnectionLabel, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Row="4" Grid.Column="0">
                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="DERNIÈRE SYNC SERVEUR" />
                                            <TextBlock Margin="0,4,0,0" FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DeviceLastSync}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="4" Grid.Column="2">
                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="DATE/HEURE DISPOSITIF" />
                                            <TextBlock Margin="0,4,0,0" FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DeviceDateTime}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Taxpayer info -->
                            <Border Margin="0,0,0,18" Style="{StaticResource InnerPanel}">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,14" FontSize="10" FontWeight="Bold"
                                               Foreground="#94A3B8" Text="CONTRIBUABLE ENREGISTRÉ" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="NOM / RAISON SOCIALE" />
                                            <TextBlock Margin="0,4,0,0" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DeviceTaxpayerName}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="VILLE" />
                                            <TextBlock Margin="0,4,0,0" FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DeviceTaxpayerCity}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="ADRESSE" />
                                            <TextBlock Margin="0,4,0,0" FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DeviceTaxpayerAddress}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="TÉLÉPHONE" />
                                            <TextBlock Margin="0,4,0,0" FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DeviceTaxpayerPhone}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="4" Grid.Column="0">
                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="EMAIL" />
                                            <TextBlock Margin="0,4,0,0" FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DeviceTaxpayerEmail}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Counters -->
                            <Border Margin="0,0,0,18" Style="{StaticResource InnerPanel}">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,14" FontSize="10" FontWeight="Bold"
                                               Foreground="#94A3B8" Text="COMPTEURS DE TRANSACTIONS" />
                                    <UniformGrid Columns="3" Rows="2">
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="TOTAL" />
                                            <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="Bold"
                                                       Foreground="#2563EB" Text="{Binding DeviceTotalTransactions}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="VENTES" />
                                            <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="Bold"
                                                       Foreground="#059669" Text="{Binding DeviceSalesCount}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="AVOIRS" />
                                            <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="Bold"
                                                       Foreground="#D97706" Text="{Binding DeviceCreditNoteCount}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="ENVOYÉES DGI" />
                                            <TextBlock Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DeviceTransactionsSent}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="EN DISPOSITIF" />
                                            <TextBlock Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DeviceTransactionsInDevice}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="EN ATTENTE" />
                                            <TextBlock Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold" Foreground="#059669">
                                                <Run Text="{Binding DevicePendingCount, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </UniformGrid>
                                    <Rectangle Height="1" Margin="0,8,0,14" Fill="{StaticResource SeparatorGradient}" />
                                    <StackPanel>
                                        <TextBlock FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="DERNIÈRE FACTURE" />
                                        <TextBlock Margin="0,4,0,0" FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DeviceLastInvoice}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Technical -->
                            <Border Margin="0,0,0,18" Style="{StaticResource InnerPanel}">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,14" FontSize="10" FontWeight="Bold"
                                               Foreground="#94A3B8" Text="INFORMATIONS TECHNIQUES" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="VALIDITÉ TOKEN" />
                                            <TextBlock Margin="0,4,0,0" FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DeviceTokenValid}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="VERSION API" />
                                            <TextBlock Margin="0,4,0,0" FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DeviceApiVersion}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="STATUT e-MCF" />
                                            <TextBlock Margin="0,4,0,0" FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DeviceEmcfStatus}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="DERNIÈRE ERREUR" />
                                            <TextBlock Margin="0,4,0,0" FontSize="12"
                                                       Foreground="#DC2626" Text="{Binding DeviceLastError}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="TAUX D'IMPOSITION CONFIGURÉS" />
                                            <Border Margin="0,6,0,0" Padding="12,10" Background="#F8FAFC"
                                                    BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                                                <TextBlock FontFamily="Consolas" FontSize="12"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Text="{Binding DeviceTaxRatesDisplay}" TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- DGI Currency Rates -->
                            <Border Margin="0,0,0,18" Style="{StaticResource InnerPanel}"
                                    Visibility="{Binding HasDgiRate, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,14" FontSize="10" FontWeight="Bold"
                                               Foreground="#94A3B8" Text="TAUX DE CHANGE DGI" />
                                    <ItemsControl ItemsSource="{Binding DeviceCurrencyRates}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8" Padding="16,12" CornerRadius="10"
                                                        BorderBrush="#FDE68A" BorderThickness="1">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Offset="0" Color="#FFFBEB" />
                                                            <GradientStop Offset="1" Color="#FEF3C7" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <md:PackIcon Width="22" Height="22" Margin="0,0,10,0"
                                                                         Foreground="#D97706" Kind="CurrencyUsd" />
                                                            <StackPanel>
                                                                <TextBlock FontSize="12" FontWeight="Bold"
                                                                           Foreground="#92400E" Text="{Binding Code}" />
                                                                <TextBlock FontSize="10" Foreground="#B45309" Text="{Binding Description}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <TextBlock FontSize="10" Foreground="#92400E" HorizontalAlignment="Right">
                                                                <Run Text="Publié: " /><Run Text="{Binding Date, Mode=OneWay}" />
                                                            </TextBlock>
                                                            <TextBlock FontSize="16" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Right">
                                                                <Run Text="{Binding Rate, Mode=OneWay}" /><Run FontSize="11" Text=" CDF" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- e-MCF devices list -->
                            <Border Margin="0,0,0,18">
                                <Border.Style>
                                    <Style BasedOn="{StaticResource InnerPanel}" TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DeviceEmcfList.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,14" FontSize="10" FontWeight="Bold"
                                               Foreground="#94A3B8" Text="DISPOSITIFS e-MCF ENREGISTRÉS" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="NIM" />
                                        <TextBlock Grid.Column="1" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="STATUT" />
                                        <TextBlock Grid.Column="2" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="BOUTIQUE" />
                                        <TextBlock Grid.Column="3" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="ADRESSE" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding DeviceEmcfList}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,4" Padding="12,10" CornerRadius="8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="White" />
                                                            <Setter Property="BorderThickness" Value="1" />
                                                            <Setter Property="BorderBrush" Value="#E2E8F0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Background" Value="#F0FDF4" />
                                                                    <Setter Property="BorderBrush" Value="#86EFAC" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="140" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                                                   Foreground="#2563EB" VerticalAlignment="Center" Text="{Binding NIM}" />
                                                        <TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#94A3B8" />
                                                                    <Setter Property="Text" Value="{Binding Status}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                            <Setter Property="Foreground" Value="#059669" />
                                                                            <Setter Property="FontWeight" Value="Bold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="2" FontSize="11"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   VerticalAlignment="Center" Text="{Binding ShopName}" />
                                                        <TextBlock Grid.Column="3" FontSize="11"
                                                                   Foreground="#64748B" VerticalAlignment="Center"
                                                                   Text="{Binding Address}" TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Empty state -->
                        <StackPanel Margin="0,10,0,10" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasDeviceInfo}" Value="False" />
                                                <Condition Binding="{Binding IsDeviceInfoLoading}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="56" Height="56" Margin="0,0,0,12" HorizontalAlignment="Center"
                                    Background="#F0F9FF" CornerRadius="50">
                                <md:PackIcon Width="24" Height="24" HorizontalAlignment="Center"
                                             VerticalAlignment="Center" Foreground="#93C5FD" Kind="Memory" />
                            </Border>
                            <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" Text="Aucune donnée du dispositif" />
                            <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="Cliquez « Interroger » pour lire les informations du dispositif connecté" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ════════════════════════════════════════════
                     SECTION 3 — FACTURATION & CALCUL
                     ════════════════════════════════════════════ -->
                <Border x:Name="SectionBilling" Style="{StaticResource PremiumCard}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0" Color="#ECFDF5" />
                                        <GradientStop Offset="1" Color="#D1FAE5" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <md:PackIcon Width="22" Height="22"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Foreground="#059669" Kind="CalculatorVariant" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Text="Facturation et calcul" />
                                <TextBlock Margin="0,3,0,0" FontFamily="{StaticResource AppFont}"
                                           FontSize="12" Foreground="#94A3B8"
                                           Text="Mode de prix, calcul de la remise, devise et taux de change" />
                            </StackPanel>
                        </StackPanel>

                        <Rectangle Height="1" Margin="0,10,0,22" Fill="{StaticResource SeparatorGradient}" />

                        <Border Margin="0,0,0,14" Style="{StaticResource InnerPanel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Mode HT (Hors Taxes)" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPriceModeTTC}" Value="True">
                                                        <Setter Property="Text" Value="Mode TTC (Toutes Taxes Comprises)" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#94A3B8">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Les prix saisis sont hors taxes" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPriceModeTTC}" Value="True">
                                                        <Setter Property="Text" Value="Les prix saisis incluent la TVA" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock Margin="0,0,10,0" VerticalAlignment="Center"
                                               FontSize="12" FontWeight="Bold" Foreground="#64748B" Text="HT" />
                                    <ToggleButton IsChecked="{Binding IsPriceModeTTC}" Style="{StaticResource ToggleSwitchStyle}" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                               FontSize="12" FontWeight="Bold" Foreground="#64748B" Text="TTC" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,0,0,14" Style="{StaticResource InnerPanel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Remise après calcul de la TVA" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DiscountBeforeTax}" Value="True">
                                                        <Setter Property="Text" Value="Remise avant calcul de la TVA" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#94A3B8">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="La remise est soustraite du montant TTC" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DiscountBeforeTax}" Value="True">
                                                        <Setter Property="Text" Value="La remise est soustraite du prix HT, TVA recalculée" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock Margin="0,0,10,0" VerticalAlignment="Center"
                                               FontSize="12" FontWeight="Bold" Foreground="#64748B" Text="Après" />
                                    <ToggleButton IsChecked="{Binding DiscountBeforeTax}" Style="{StaticResource ToggleSwitchStyle}" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                               FontSize="12" FontWeight="Bold" Foreground="#64748B" Text="Avant" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource InnerPanel}">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="#94A3B8"
                                               VerticalAlignment="Center" Text="DEVISE ET TAUX DE CHANGE" />
                                    <Button HorizontalAlignment="Right" Command="{Binding FetchDgiRatesCommand}"
                                            Style="{StaticResource BtnSecondary}">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Width="16" Height="16" Margin="0,0,8,0"
                                                         VerticalAlignment="Center" Foreground="#D97706" Kind="CloudDownload" />
                                            <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#D97706">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Récupérer taux DGI" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFetchingDgiRates}" Value="True">
                                                                <Setter Property="Text" Value="Récupération…" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Border Margin="0,0,0,14" Padding="14,12" CornerRadius="10"
                                        BorderBrush="#FDE68A" BorderThickness="1"
                                        Visibility="{Binding HasDgiRate, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#FFFBEB" />
                                            <GradientStop Offset="1" Color="#FEF3C7" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Width="18" Height="18" Margin="0,0,10,0"
                                                     VerticalAlignment="Center" Foreground="#D97706" Kind="CurrencyUsd" />
                                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#92400E">
                                            <Run Text="Taux DGI : " />
                                            <Run FontWeight="Bold" Text="1 USD = " />
                                            <Run FontWeight="Bold" FontSize="14" Text="{Binding DgiUsdRate, Mode=OneWay}" />
                                            <Run FontWeight="Bold" Text=" CDF" />
                                            <Run Text="  —  publié le " />
                                            <Run Text="{Binding DgiUsdDate, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,0,0,14" Padding="12,10" CornerRadius="10"
                                        Visibility="{Binding ShowDgiRateSuccess, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#ECFDF5" />
                                            <GradientStop Offset="1" Color="#D1FAE5" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Width="16" Height="16" Margin="0,0,8,0"
                                                     VerticalAlignment="Center" Foreground="#059669" Kind="CheckCircle" />
                                        <TextBlock FontSize="12" Foreground="#059669" Text="{Binding DgiRateStatus}" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,0,0,14" Padding="12,10" CornerRadius="10"
                                        Visibility="{Binding ShowDgiRateError, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#FEF2F2" />
                                            <GradientStop Offset="1" Color="#FEE2E2" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Width="16" Height="16" Margin="0,0,8,0"
                                                     VerticalAlignment="Center" Foreground="#DC2626" Kind="AlertCircle" />
                                        <TextBlock FontSize="12" Foreground="#DC2626" Text="{Binding DgiRateStatus}" />
                                    </StackPanel>
                                </Border>

                                <UniformGrid Margin="0,0,0,14" Columns="2">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="DEVISE PRINCIPALE" />
                                        <ComboBox ItemsSource="{Binding Currencies}"
                                                  SelectedItem="{Binding DefaultCurrency}"
                                                  Style="{StaticResource ModernComboBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="MODE TAUX DE CHANGE" />
                                        <ComboBox ItemsSource="{Binding ExchangeRateModes}"
                                                  SelectedItem="{Binding ExchangeRateMode}"
                                                  Style="{StaticResource ModernComboBoxStyle}" />
                                    </StackPanel>
                                </UniformGrid>

                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="TAUX USD (1 USD = X CDF)" />
                                        <TextBox Style="{StaticResource FormInput}"
                                                 Text="{Binding CurrentExchangeRate, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="TAUX EUR (1 EUR = X CDF)" />
                                        <TextBox Style="{StaticResource FormInput}"
                                                 Text="{Binding CurrentExchangeRateEUR, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="TAUX CNY (1 CNY = X CDF)" />
                                        <TextBox Style="{StaticResource FormInput}"
                                                 Text="{Binding CurrentExchangeRateCNY, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ════════════════════════════════════════════
                     SECTION 4 — FIDÉLITÉ
                     ════════════════════════════════════════════ -->
                <Border x:Name="SectionLoyalty" Style="{StaticResource PremiumCard}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0" Color="#FEF3C7" />
                                        <GradientStop Offset="1" Color="#FDE68A" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <md:PackIcon Width="22" Height="22"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Foreground="#D97706" Kind="StarCircle" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Text="Programme de fidélité" />
                                <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="#94A3B8"
                                           Text="Récompensez vos clients réguliers avec des points" />
                            </StackPanel>
                        </StackPanel>

                        <Rectangle Height="1" Margin="0,10,0,22" Fill="{StaticResource SeparatorGradient}" />

                        <Border Margin="0,0,0,18" Style="{StaticResource InnerPanel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="Activer le programme de fidélité" />
                                    <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#94A3B8"
                                               Text="Les clients pourront accumuler et utiliser des points" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" FontSize="12" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Désactivé" />
                                                <Setter Property="Foreground" Value="#94A3B8" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoyaltyEnabled}" Value="True">
                                                        <Setter Property="Text" Value="Activé" />
                                                        <Setter Property="Foreground" Value="#059669" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ToggleButton IsChecked="{Binding IsLoyaltyEnabled}" Style="{StaticResource ToggleSwitchSuccessStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoyaltyEnabled}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,16">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="TAUX D'ACCUMULATION (1 POINT PAR X CDF)" />
                                    <TextBox Style="{StaticResource FormInput}"
                                             Text="{Binding LoyaltyEarnRate, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="10,0,0,16">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="VALEUR DE RÉDEMPTION (1 POINT = X CDF)" />
                                    <TextBox Style="{StaticResource FormInput}"
                                             Text="{Binding LoyaltyRedeemRate, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </UniformGrid>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="MINIMUM DE POINTS POUR UTILISER" />
                                <TextBox MaxWidth="300" HorizontalAlignment="Left" Style="{StaticResource FormInput}"
                                         Text="{Binding LoyaltyMinRedeemPoints, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ════════════════════════════════════════════
                     SECTION 5 — LICENCE
                     ════════════════════════════════════════════ -->
                <Border x:Name="SectionLicense" Style="{StaticResource PremiumCard}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0" Color="#F5F3FF" />
                                        <GradientStop Offset="1" Color="#EDE9FE" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <md:PackIcon Width="22" Height="22"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Foreground="#7C3AED" Kind="ShieldKey" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Text="Licence" />
                                <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="#94A3B8"
                                           Text="Gérez votre licence d'utilisation" />
                            </StackPanel>
                        </StackPanel>

                        <Rectangle Height="1" Margin="0,10,0,22" Fill="{StaticResource SeparatorGradient}" />

                        <Border Margin="0,0,0,22" Padding="22"
                                BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#F5F3FF" />
                                    <GradientStop Offset="0.5" Color="#EFF6FF" />
                                    <GradientStop Offset="1" Color="#F8FAFC" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <UniformGrid Columns="2">
                                <StackPanel>
                                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="PLAN ACTUEL" />
                                    <TextBlock Margin="0,8,0,0" FontSize="22" FontWeight="Bold"
                                               Foreground="#7C3AED" Text="{Binding LicensePlan}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Text="STATUT" />
                                    <TextBlock Margin="0,8,0,0" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding LicenseStatus}" />
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="CLÉ DE LICENCE" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox FontFamily="Consolas" Style="{StaticResource FormInput}"
                                     Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Margin="12,0,0,0"
                                    Command="{Binding ActivateLicenseCommand}"
                                    Style="{StaticResource BtnPrimary}">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Width="16" Height="16" Margin="0,0,8,0"
                                                 VerticalAlignment="Center" Foreground="White" Kind="KeyVariant" />
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="White" Text="Activer" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Margin="0,12,0,0" Padding="16,14" CornerRadius="12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LicenseMessage}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#FEF2F2" />
                                    <GradientStop Offset="1" Color="#FEE2E2" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Width="18" Height="18" Margin="0,0,10,0"
                                             VerticalAlignment="Center" Foreground="#DC2626" Kind="AlertCircle" />
                                <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="Medium"
                                           Foreground="#DC2626" Text="{Binding LicenseMessage}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Height="20" />

            </StackPanel>
        </ScrollViewer>

        <!--  ═══════════════════════════════════════════════════
              STICKY BOTTOM STATUS BAR
              ═══════════════════════════════════════════════════  -->
        <Border Grid.Row="2" Padding="32,12" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowSaveSuccess}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ShowSaveError}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Border Padding="14,10" VerticalAlignment="Center" CornerRadius="10"
                        HorizontalAlignment="Stretch"
                        Visibility="{Binding ShowSaveSuccess, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#ECFDF5" />
                            <GradientStop Offset="1" Color="#D1FAE5" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Width="20" Height="20" Margin="0,0,10,0"
                                     VerticalAlignment="Center" Foreground="#059669" Kind="CheckCircle" />
                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#059669" Text="{Binding SaveStatus}" />
                    </StackPanel>
                </Border>
                <Border Padding="14,10" VerticalAlignment="Center" CornerRadius="10"
                        HorizontalAlignment="Stretch"
                        Visibility="{Binding ShowSaveError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#FEF2F2" />
                            <GradientStop Offset="1" Color="#FEE2E2" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Width="20" Height="20" Margin="0,0,10,0"
                                     VerticalAlignment="Center" Foreground="#DC2626" Kind="AlertCircle" />
                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#DC2626" Text="{Binding SaveStatus}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!--  ═══════════════════════════════════════════════════
              FLOATING SAVE FAB
              ═══════════════════════════════════════════════════  -->
        <Button Grid.Row="1" Width="56" Height="56" Margin="0,0,32,28"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Cursor="Hand" Command="{Binding SaveSettingsCommand}"
                ToolTip="Enregistrer les paramètres">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="28"
                            Background="{StaticResource SuccessGradient}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" Direction="270"
                                              Opacity="0.35" ShadowDepth="6" Color="#059669" />
                        </Border.Effect>
                        <md:PackIcon Width="26" Height="26"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Foreground="White" Kind="ContentSave" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="28" Direction="270"
                                                      Opacity="0.5" ShadowDepth="8" Color="#059669" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <Button.RenderTransformOrigin>0.5,0.5</Button.RenderTransformOrigin>
        </Button>

    </Grid>
</UserControl>