<UserControl x:Class="SFE.WPF.Views.Pages.PosManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:SFE.Domain.Enums;assembly=SFE.Domain"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource BackgroundBrush}"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <!-- ── Thin round scrollbar ── -->
        <Style x:Key="SlimScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="3" Background="{StaticResource BorderBrush}"
                                Opacity="0.45" Margin="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimVerticalScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border Background="Transparent" CornerRadius="4"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SlimScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TouchScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="PanningMode" Value="VerticalOnly"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter Margin="36,32,36,32"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       HorizontalAlignment="Right"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Style="{StaticResource SlimVerticalScrollBar}"
                                       Margin="0,8,2,8"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource TouchScrollViewer}">
        <StackPanel MaxWidth="920">

            <!-- ── Page header ── -->
            <TextBlock Text="Points de vente" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Créez et gérez vos points de vente, dispositifs fiscaux et imprimantes"
                       Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,28"/>

            <!-- ══════════════════════════════════════════════════════════════ -->
            <!-- POS MANAGEMENT CARD                                            -->
            <!-- ══════════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource CardStyle}" Padding="28">
                <StackPanel>

                    <!-- ── Card header ── -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="10" Padding="10" Margin="0,0,14,0"
                                    VerticalAlignment="Center">
                                <Border.Background>
                                    <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.08"/>
                                </Border.Background>
                                <materialDesign:PackIcon Kind="StorefrontOutline" Width="22" Height="22"
                                                         Foreground="{StaticResource PrimaryBrush}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Points de vente"
                                           Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0">
                                    <Run Text="Chaque POS dispose de sa propre configuration fiscale et imprimante · "/>
                                    <Run Text="{Binding AllPos.Count, Mode=OneWay}"/>
                                    <Run Text=" point(s)"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1" VerticalAlignment="Center"
                                Command="{Binding StartNewPosCommand}"
                                Background="{StaticResource PrimaryBrush}" Foreground="White"
                                FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"
                                Padding="18,10" BorderThickness="0" Cursor="Hand"
                                MinHeight="44">
                            <Button.Effect>
                                <DropShadowEffect Color="{StaticResource PrimaryColor}"
                                                  BlurRadius="12" ShadowDepth="2" Opacity="0.18"/>
                            </Button.Effect>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="18" Height="18"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Ajouter un POS" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- ── Success banner ── -->
                    <Border Margin="0,0,0,10" CornerRadius="8" Padding="14,10"
                            Visibility="{Binding ShowSuccess, Converter={StaticResource BoolToVisibilityConverter}}"
                            BorderThickness="1">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource SuccessColor}" Opacity="0.06"/>
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{StaticResource SuccessColor}" Opacity="0.2"/>
                        </Border.BorderBrush>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckCircleOutline" Width="18" Height="18"
                                                     Foreground="{StaticResource SuccessBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                                       FontFamily="{StaticResource AppFont}" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Error banner ── -->
                    <Border Margin="0,0,0,10" CornerRadius="8" Padding="14,10"
                            Visibility="{Binding ShowError, Converter={StaticResource BoolToVisibilityConverter}}"
                            BorderThickness="1">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.06"/>
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.2"/>
                        </Border.BorderBrush>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="18" Height="18"
                                                     Foreground="{StaticResource WarningBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource WarningBrush}"
                                       FontFamily="{StaticResource AppFont}" FontSize="13"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- ══════════════════════════════════════════════════════ -->
                    <!-- POS LIST                                               -->
                    <!-- ══════════════════════════════════════════════════════ -->
                    <ItemsControl ItemsSource="{Binding AllPos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" CornerRadius="12" Padding="18,16"
                                        Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Status dot -->
                                        <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,14,0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#10B981"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Background" Value="#9CA3AF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <!-- POS info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Code}" FontFamily="Consolas"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text=" — " Foreground="{StaticResource TextMutedBrush}"
                                                           Margin="2,0"/>
                                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource AppFont}"
                                                           FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center">
                                                    <Run Text="{Binding City, Mode=OneWay}"/>
                                                </TextBlock>

                                                <!-- Device type badge -->
                                                <Border CornerRadius="6" Padding="8,4" Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#EEF2FF"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DeviceType}"
                                                                             Value="{x:Static enums:DeviceType.Mcf}">
                                                                    <Setter Property="Background" Value="#FDF4FF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Width="12" Height="12"
                                                                                 VerticalAlignment="Center" Margin="0,0,4,0">
                                                            <materialDesign:PackIcon.Style>
                                                                <Style TargetType="materialDesign:PackIcon">
                                                                    <Setter Property="Kind" Value="AccessPointNetwork"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DeviceType}"
                                                                                     Value="{x:Static enums:DeviceType.Mcf}">
                                                                            <Setter Property="Kind" Value="SerialPort"/>
                                                                            <Setter Property="Foreground" Value="#9333EA"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </materialDesign:PackIcon.Style>
                                                        </materialDesign:PackIcon>
                                                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11"
                                                                   FontWeight="SemiBold" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="e-MCF"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DeviceType}"
                                                                                     Value="{x:Static enums:DeviceType.Mcf}">
                                                                            <Setter Property="Text" Value="MCF"/>
                                                                            <Setter Property="Foreground" Value="#9333EA"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Stock badge -->
                                                <Border CornerRadius="6" Padding="8,4" Margin="6,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#ECFDF5"/>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ManagesStock}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="PackageVariantClosed"
                                                                                 Width="12" Height="12"
                                                                                 Foreground="#059669"
                                                                                 VerticalAlignment="Center"
                                                                                 Margin="0,0,4,0"/>
                                                        <TextBlock Text="Stock" FontFamily="{StaticResource AppFont}"
                                                                   FontSize="11" Foreground="#059669"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Init stock button -->
                                        <Button Grid.Column="2"
                                                FontFamily="{StaticResource AppFont}" FontSize="12"
                                                Padding="14,8" Background="#ECFDF5" BorderThickness="0"
                                                Cursor="Hand" Margin="0,0,8,0" VerticalAlignment="Center"
                                                MinHeight="40"
                                                Command="{Binding DataContext.InitializeStockCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ManagesStock}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="PackageVariantClosedPlus"
                                                                         Width="16" Height="16"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0,0,6,0"/>
                                                <TextBlock Text="Init. stock" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Edit button -->
                                        <Button Grid.Column="3" VerticalAlignment="Center"
                                                Background="Transparent" BorderThickness="0"
                                                Cursor="Hand" Margin="0,0,4,0"
                                                MinWidth="40" MinHeight="40"
                                                Command="{Binding DataContext.EditPosCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18"
                                                                     Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Button>

                                        <!-- Delete button -->
                                        <Button Grid.Column="4" VerticalAlignment="Center"
                                                Background="Transparent" BorderThickness="0"
                                                Cursor="Hand"
                                                MinWidth="40" MinHeight="40"
                                                Command="{Binding DataContext.DeactivatePosCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="18" Height="18"
                                                                     Foreground="{StaticResource TextMutedBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ══════════════════════════════════════════════════════ -->
                    <!-- EDIT FORM                                              -->
                    <!-- ══════════════════════════════════════════════════════ -->
                    <Border CornerRadius="14" Padding="28" Margin="0,10,0,0"
                            BorderThickness="1"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.04"/>
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.22"/>
                        </Border.BorderBrush>
                        <StackPanel>

                            <!-- Form title row -->
                            <Grid Margin="0,0,0,20">
                                <TextBlock Text="{Binding FormTitle}" FontFamily="{StaticResource AppFont}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Button HorizontalAlignment="Right"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        MinWidth="40" MinHeight="40"
                                        Command="{Binding CancelEditCommand}">
                                    <materialDesign:PackIcon Kind="Close" Width="20" Height="20"
                                                             Foreground="{StaticResource TextMutedBrush}"/>
                                </Button>
                            </Grid>

                            <!-- ── SECTION 1 : GENERAL ── -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border CornerRadius="6" Padding="6" Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <Border.Background>
                                        <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.08"/>
                                    </Border.Background>
                                    <materialDesign:PackIcon Kind="InformationOutline" Width="16" Height="16"
                                                             Foreground="{StaticResource PrimaryBrush}"/>
                                </Border>
                                <TextBlock Text="INFORMATIONS GÉNÉRALES"
                                           FontFamily="{StaticResource AppFont}" FontSize="11"
                                           FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <UniformGrid Columns="3" Margin="0,0,0,14">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="CODE *" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding EditCode}" FontFamily="Consolas"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             MinHeight="42"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="NOM *" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding EditName}"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             MinHeight="42"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="VILLE" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding EditCity}"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             MinHeight="42"/>
                                </StackPanel>
                            </UniformGrid>

                            <UniformGrid Columns="2" Margin="0,0,0,14">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="ADRESSE" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding EditAddress}"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             MinHeight="42"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="TÉLÉPHONE" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding EditPhone}"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             MinHeight="42"/>
                                </StackPanel>
                            </UniformGrid>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,24">
                                <CheckBox Content="Gère du stock" IsChecked="{Binding EditManagesStock}"
                                          FontFamily="{StaticResource AppFont}" FontSize="13"
                                          Margin="0,0,28,0" MinHeight="36"/>
                                <CheckBox Content="Autoriser stock négatif" IsChecked="{Binding EditAllowNegativeStock}"
                                          FontFamily="{StaticResource AppFont}" FontSize="13"
                                          MinHeight="36"/>
                            </StackPanel>

                            <Border Height="1" Background="#E5E7EB" Margin="0,0,0,24"/>

                            <!-- ── SECTION 2 : FISCAL DEVICE ── -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border CornerRadius="6" Padding="6" Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <Border.Background>
                                        <SolidColorBrush Color="#9333EA" Opacity="0.08"/>
                                    </Border.Background>
                                    <materialDesign:PackIcon Kind="Chip" Width="16" Height="16"
                                                             Foreground="#9333EA"/>
                                </Border>
                                <TextBlock Text="DISPOSITIF FISCAL"
                                           FontFamily="{StaticResource AppFont}" FontSize="11"
                                           FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <UniformGrid Columns="2" Margin="0,0,0,18">
                                <RadioButton GroupName="PosDeviceType"
                                             IsChecked="{Binding EditIsEmcf}"
                                             Style="{StaticResource RadioCardStyle}" Margin="0,0,8,0"
                                             MinHeight="68">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AccessPointNetwork" Width="22" Height="22"
                                                                 Foreground="{StaticResource PrimaryBrush}"
                                                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="e-MCF" FontFamily="{StaticResource AppFont}"
                                                       FontSize="14" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="API REST (Internet)" FontFamily="{StaticResource AppFont}"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="PosDeviceType"
                                             IsChecked="{Binding EditIsEmcf, Converter={StaticResource InverseBoolConverter}}"
                                             Style="{StaticResource RadioCardStyle}" Margin="8,0,0,0"
                                             MinHeight="68">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="SerialPort" Width="22" Height="22"
                                                                 Foreground="#9333EA"
                                                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="MCF" FontFamily="{StaticResource AppFont}"
                                                       FontSize="14" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Port série (RS232/USB)" FontFamily="{StaticResource AppFont}"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>

                            <!-- e-MCF fields -->
                            <Border Background="White" CornerRadius="10" Padding="20"
                                    BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,6"
                                    Visibility="{Binding EditIsEmcf, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="URL DE L'API e-MCF" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding EditEmcfUrl, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             MinHeight="42" Margin="0,0,0,14"/>
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="TOKEN JWT" Style="{StaticResource FormLabelStyle}"/>
                                            <TextBox Text="{Binding EditEmcfToken, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBoxStyle}"
                                                     MinHeight="42"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="NIM" Style="{StaticResource FormLabelStyle}"/>
                                            <TextBox Text="{Binding EditEmcfNim, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBoxStyle}"
                                                     MinHeight="42"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- MCF note -->
                            <Border Background="White" CornerRadius="10" Padding="20"
                                    BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditIsEmcf}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18"
                                                             Foreground="{StaticResource TextSecondaryBrush}"
                                                             VerticalAlignment="Top" Margin="0,2,10,0"/>
                                    <TextBlock TextWrapping="Wrap" FontFamily="{StaticResource AppFont}"
                                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                               LineHeight="20">
                                        <Run Text="Le port COM et le baud rate se configurent dans "/>
                                        <Run Text="Paramètres → Test de connexion" FontWeight="SemiBold"/>
                                        <Run Text=". Enregistrez d'abord ce POS, puis testez la connexion."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Height="1" Background="#E5E7EB" Margin="0,24,0,24"/>

                            <!-- ── SECTION 3 : THERMAL PRINTER ── -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Border CornerRadius="8" Padding="8" Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <Border.Background>
                                        <SolidColorBrush Color="#EA580C" Opacity="0.08"/>
                                    </Border.Background>
                                    <materialDesign:PackIcon Kind="Printer" Width="20" Height="20"
                                                             Foreground="#EA580C"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Imprimante thermique"
                                               FontFamily="{StaticResource AppFont}" FontSize="14"
                                               FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Configuration de l'impression des reçus pour ce POS"
                                               FontFamily="{StaticResource AppFont}" FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Background="White" CornerRadius="12" Padding="24"
                                    BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,6">
                                <StackPanel>

                                    <TextBlock Text="NOM DE L'IMPRIMANTE WINDOWS"
                                               Style="{StaticResource FormLabelStyle}"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox IsEditable="True"
                                                  Text="{Binding EditPrinterName, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding DetectedPrinters}"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  MinHeight="42"/>
                                        <Button Grid.Column="1"
                                                Command="{Binding AutoDetectPrinterCommand}"
                                                FontFamily="{StaticResource AppFont}" FontSize="12"
                                                Padding="14,8" BorderThickness="0" Cursor="Hand"
                                                Margin="8,0,0,0" VerticalAlignment="Stretch"
                                                MinHeight="42">
                                            <Button.Background>
                                                <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.08"/>
                                            </Button.Background>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16"
                                                                         Foreground="{StaticResource PrimaryBrush}"
                                                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Détecter" Foreground="{StaticResource PrimaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2"
                                                ToolTip="Rafraîchir la liste des imprimantes"
                                                Command="{Binding RefreshPrinterListCommand}"
                                                Background="Transparent"
                                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                                Padding="10,8" Cursor="Hand" Margin="6,0,0,0"
                                                VerticalAlignment="Stretch" MinHeight="42">
                                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"
                                                                     Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="Laissez vide pour auto-détection au démarrage. Ex : EPSON TM-T88V, POS-80C"
                                               FontFamily="{StaticResource AppFont}" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,20"/>

                                    <UniformGrid Columns="3" Margin="0,0,0,18">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="LARGEUR PAPIER" Style="{StaticResource FormLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding PaperWidths}"
                                                      SelectedItem="{Binding EditPaperWidth}"
                                                      Style="{StaticResource ModernComboBoxStyle}"
                                                      MinHeight="42">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock FontFamily="{StaticResource AppFont}">
                                                            <Run Text="{Binding Mode=OneWay}"/>
                                                            <Run Text=" mm"/>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="COPIES AUTO" Style="{StaticResource FormLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding PrintCopiesOptions}"
                                                      SelectedItem="{Binding EditPrintCopies}"
                                                      Style="{StaticResource ModernComboBoxStyle}"
                                                      MinHeight="42"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="PAGE DE CODE" Style="{StaticResource FormLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding CodePages}"
                                                      SelectedItem="{Binding EditCodePage}"
                                                      Style="{StaticResource ModernComboBoxStyle}"
                                                      MinHeight="42"/>
                                        </StackPanel>
                                    </UniformGrid>

                                    <!-- Options checkboxes -->
                                    <Border Background="#F8FAFC" CornerRadius="10" Padding="20" Margin="0,0,0,18">
                                        <UniformGrid Columns="2" Rows="2">
                                            <CheckBox Content="Impression auto après normalisation"
                                                      IsChecked="{Binding EditAutoPrint}"
                                                      FontFamily="{StaticResource AppFont}" FontSize="13"
                                                      MinHeight="40" Margin="0,0,0,8"/>
                                            <CheckBox Content="Imprimer le logo entreprise"
                                                      IsChecked="{Binding EditPrintLogo}"
                                                      FontFamily="{StaticResource AppFont}" FontSize="13"
                                                      MinHeight="40" Margin="0,0,0,8"/>
                                            <CheckBox Content="Affichage client (écran secondaire)"
                                                      IsChecked="{Binding EditEnableCustomerDisplay}"
                                                      FontFamily="{StaticResource AppFont}" FontSize="13"
                                                      MinHeight="40"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox Content="Tiroir-caisse"
                                                          IsChecked="{Binding EditEnableCashDrawer}"
                                                          FontFamily="{StaticResource AppFont}" FontSize="13"
                                                          MinHeight="40" Margin="0,0,14,0"/>
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding EditEnableCashDrawer,
                                                                Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="Pin :" FontFamily="{StaticResource AppFont}"
                                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <ComboBox ItemsSource="{Binding CashDrawerPins}"
                                                              SelectedItem="{Binding EditCashDrawerPin}"
                                                              Width="60" Padding="6,4" MinHeight="36"
                                                              FontFamily="{StaticResource AppFont}" FontSize="12"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </UniformGrid>
                                    </Border>

                                    <TextBlock Text="TEXTE PIED DE TICKET" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding EditFooterText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             MinHeight="42" MaxLength="500" Margin="0,0,0,18"/>

                                    <!-- Test print button -->
                                    <Button Command="{Binding TestPrintCommand}"
                                            HorizontalAlignment="Left"
                                            FontFamily="{StaticResource AppFont}" FontSize="13"
                                            Padding="18,10" BorderThickness="1" Cursor="Hand"
                                            MinHeight="44">
                                        <Button.Background>
                                            <SolidColorBrush Color="#EA580C" Opacity="0.06"/>
                                        </Button.Background>
                                        <Button.BorderBrush>
                                            <SolidColorBrush Color="#EA580C" Opacity="0.25"/>
                                        </Button.BorderBrush>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="PrinterCheck" Width="18" Height="18"
                                                                     Foreground="#C2410C"
                                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="Imprimer un ticket test" Foreground="#C2410C"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- ── Form action buttons ── -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                                <Button Command="{Binding CancelEditCommand}"
                                        FontFamily="{StaticResource AppFont}" FontSize="13"
                                        Padding="20,10" Margin="0,0,10,0"
                                        Background="#F3F4F6" BorderThickness="0" Cursor="Hand"
                                        MinHeight="44">
                                    <TextBlock Text="Annuler" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Button>
                                <Button Command="{Binding SavePosCommand}"
                                        Background="{StaticResource PrimaryBrush}" Foreground="White"
                                        FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"
                                        Padding="20,10" BorderThickness="0" Cursor="Hand"
                                        MinHeight="44">
                                    <Button.Effect>
                                        <DropShadowEffect Color="{StaticResource PrimaryColor}"
                                                          BlurRadius="10" ShadowDepth="2" Opacity="0.15"/>
                                    </Button.Effect>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18"
                                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Enregistrer" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── Empty state ── -->
                    <Border Margin="0,6,0,0" Padding="32" CornerRadius="10" Background="#F9FAFB">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AllPos.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="StorefrontRemoveOutline"
                                                     Width="36" Height="36"
                                                     HorizontalAlignment="Center"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     Margin="0,0,0,12"/>
                            <TextBlock Text="Aucun point de vente configuré"
                                       FontFamily="{StaticResource AppFont}" FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Cliquez « Ajouter un POS » pour commencer."
                                       FontFamily="{StaticResource AppFont}" FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>