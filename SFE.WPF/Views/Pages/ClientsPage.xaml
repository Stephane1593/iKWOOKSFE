<UserControl x:Class="SFE.WPF.Views.Pages.ClientsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SFE.WPF.ViewModels"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="480"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════ -->
        <!-- COLONNE GAUCHE — Liste                     -->
        <!-- ══════════════════════════════════════════ -->
        <DockPanel Grid.Column="0" Margin="0,0,16,0">

            <!-- HEADER -->
            <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👥" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Gestion des clients" Style="{StaticResource SectionTitleStyle}" 
                                       VerticalAlignment="Center"/>
                            <Border Background="#EFF6FF" CornerRadius="10" Padding="8,3" Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}">
                                    <Run Text="{Binding ClientCount, Mode=OneWay}"/>
                                    <Run Text=" clients"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <Button HorizontalAlignment="Right" Content="+ Nouveau client"
                                Command="{Binding NewClientCommand}"
                                Background="{StaticResource PrimaryBrush}" Foreground="White"
                                FontFamily="{StaticResource AppFont}" FontWeight="SemiBold"
                                Padding="16,8" BorderThickness="0" Cursor="Hand"/>
                    </Grid>

                    <!-- Search + Filter -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                 FontFamily="{StaticResource AppFont}" Padding="10,8" Margin="0,0,8,0">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Tag" Value="🔍 Rechercher par nom, NIF ou téléphone..."/>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <ComboBox Grid.Column="1" SelectedItem="{Binding FilterType}"
                                  FontFamily="{StaticResource AppFont}" Padding="8,6">
                            <ComboBoxItem Content="Tous les types" IsSelected="True"/>
                            <ComboBoxItem Content="PP — Pers. physique" Tag="PP"/>
                            <ComboBoxItem Content="PM — Pers. morale" Tag="PM"/>
                            <ComboBoxItem Content="PC — Commerçant" Tag="PC"/>
                            <ComboBoxItem Content="PL — Prof. libérale" Tag="PL"/>
                            <ComboBoxItem Content="AO — Ambassade/Org." Tag="AO"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- CLIENT LIST -->
            <Border Style="{StaticResource CardStyle}">
                <DataGrid ItemsSource="{Binding Clients}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          BorderThickness="0" FontFamily="{StaticResource AppFont}" FontSize="12"
                          SelectionMode="Single" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">

                    <DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick"
                                      Command="{Binding EditClientCommand}"
                                      CommandParameter="{Binding SelectedItem, 
                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                    </DataGrid.InputBindings>

                    <DataGrid.Columns>
                        <!-- Type badge -->
                        <DataGridTemplateColumn Header="Type" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F3F4F6"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TypeCode}" Value="PM">
                                                        <Setter Property="Background" Value="#DBEAFE"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TypeCode}" Value="AO">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding TypeCode}" FontWeight="Bold" FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="NIF" Binding="{Binding NIF}" Width="110"/>
                        <DataGridTextColumn Header="Nom / Dénomination" Binding="{Binding Name}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Téléphone" Binding="{Binding Phone}" Width="120"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="150"/>
                        <DataGridTextColumn Header="Créé le" Binding="{Binding CreatedDisplay}" Width="85"/>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="✏️" FontSize="13" Background="Transparent"
                                                BorderThickness="0" Cursor="Hand" Padding="4,2"
                                                ToolTip="Modifier"
                                                Command="{Binding DataContext.EditClientCommand,
                                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="🗑️" FontSize="13" Background="Transparent"
                                                BorderThickness="0" Cursor="Hand" Padding="4,2"
                                                ToolTip="Supprimer"
                                                Command="{Binding DataContext.DeleteClientCommand,
                                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- ══════════════════════════════════════════ -->
        <!-- COLONNE DROITE — Formulaire                -->
        <!-- ══════════════════════════════════════════ -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">

            <!-- ★ FIX: Grid wrapper — ScrollViewer needs exactly ONE child -->
            <Grid>

                <!-- ÉTAT VIDE (pas en édition) -->
                <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolConverter}}"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,60,0,0">
                    <TextBlock Text="👤" FontSize="48" HorizontalAlignment="Center" Opacity="0.3"/>
                    <TextBlock Text="Sélectionnez un client ou créez-en un nouveau"
                               FontFamily="{StaticResource AppFont}" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,12,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- FORMULAIRE (en édition) -->
                <Border Style="{StaticResource CardStyle}"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <!-- Title -->
                        <Grid>
                            <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitleStyle}"/>
                            <Button Content="✕" HorizontalAlignment="Right" FontSize="14"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding CancelEditCommand}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>

                        <!-- Type -->
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="Type de client *" FontFamily="{StaticResource AppFont}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding ClientTypes}"
                                      SelectedItem="{Binding FormType}"
                                      FontFamily="{StaticResource AppFont}" Padding="8,6"/>
                        </StackPanel>

                        <!-- Type description -->
                        <Border Background="#F8FAFC" CornerRadius="6" Padding="10,6" Margin="0,6,0,0">
                            <TextBlock Text="{Binding FormTypeDescription}"
                                       FontFamily="{StaticResource AppFont}" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"/>
                        </Border>

                        <!-- NIF -->
                        <StackPanel Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="NIF" FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"
                                           Visibility="{Binding IsNifRequired, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                            <TextBox Text="{Binding FormNIF, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource AppFont}" Padding="8,6" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Nom / Dénomination -->
                        <StackPanel Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Nom / Dénomination" FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"
                                           Visibility="{Binding IsNameRequired, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                            <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource AppFont}" Padding="8,6" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Adresse -->
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Adresse" FontFamily="{StaticResource AppFont}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource AppFont}" Padding="8,6"/>
                        </StackPanel>

                        <!-- Téléphone + Email -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="Téléphone" FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormPhone}" FontFamily="{StaticResource AppFont}" Padding="8,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Email" FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormEmail}" FontFamily="{StaticResource AppFont}" Padding="8,6"/>
                            </StackPanel>
                        </Grid>

                        <!-- RCCM -->
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="RCCM" FontFamily="{StaticResource AppFont}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding FormRCCM}" FontFamily="{StaticResource AppFont}" Padding="8,6"/>
                        </StackPanel>

                        <!-- BUTTONS -->
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Annuler" Command="{Binding CancelEditCommand}"
                                    FontFamily="{StaticResource AppFont}" Padding="14,8"
                                    Background="#F3F4F6" BorderThickness="0" Cursor="Hand"
                                    HorizontalAlignment="Left"/>
                            <Button Grid.Column="1" Command="{Binding SaveClientCommand}"
                                    Background="{StaticResource PrimaryBrush}" Foreground="White"
                                    FontFamily="{StaticResource AppFont}" FontWeight="SemiBold"
                                    Padding="20,8" BorderThickness="0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💾" Margin="0,0,6,0"/>
                                    <TextBlock Text="Enregistrer"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Status -->
                        <Border Margin="0,12,0,0" CornerRadius="6" Padding="10,8"
                                Visibility="{Binding ShowSuccess, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="#ECFDF5">
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                                       FontFamily="{StaticResource AppFont}" FontSize="12" TextWrapping="Wrap"/>
                        </Border>
                        <Border Margin="0,12,0,0" CornerRadius="6" Padding="10,8"
                                Visibility="{Binding ShowError, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="#FEF2F2">
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource ErrorBrush}"
                                       FontFamily="{StaticResource AppFont}" FontSize="12" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

            </Grid>
            <!-- ★ END FIX -->

        </ScrollViewer>
    </Grid>
</UserControl>