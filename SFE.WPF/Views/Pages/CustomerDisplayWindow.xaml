<Window x:Class="SFE.WPF.Views.Pages.CustomerDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Affichage Client" WindowStyle="None"
        Background="#1E293B" Foreground="White"
        ShowInTaskbar="False" Topmost="True">

    <Grid>
        <!-- ══ IDLE STATE: Company branding ══ -->
        <Grid x:Name="IdlePanel"
              Visibility="{Binding ShowIdle, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding CompanyName}" FontSize="42"
                           FontWeight="Bold" HorizontalAlignment="Center"
                           FontFamily="{StaticResource AppFont}" Foreground="White"/>
                <TextBlock Text="Bienvenue" FontSize="28" Margin="0,20,0,0"
                           HorizontalAlignment="Center" Foreground="#94A3B8"
                           FontFamily="{StaticResource AppFont}"/>
                <TextBlock Text="{Binding CurrentTime}" FontSize="64" Margin="0,40,0,0"
                           HorizontalAlignment="Center" FontFamily="Consolas"
                           Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="{Binding CurrentDate}" FontSize="18" Margin="0,8,0,0"
                           HorizontalAlignment="Center" Foreground="#64748B"
                           FontFamily="{StaticResource AppFont}"/>
            </StackPanel>
        </Grid>

        <!-- ══ ACTIVE SALE: Cart items + running total ══ -->
        <Grid Visibility="{Binding ShowCart, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Background="#0F172A" Padding="30,20">
                <Grid>
                    <TextBlock Text="{Binding CompanyName}" FontSize="24"
                               FontWeight="Bold" FontFamily="{StaticResource AppFont}"/>
                    <TextBlock Text="{Binding CurrentTime}" FontSize="20"
                               HorizontalAlignment="Right" FontFamily="Consolas"
                               Foreground="#94A3B8" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Scrolling item list -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Margin="30,10">
                <ItemsControl ItemsSource="{Binding DisplayItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="16,12" Margin="0,4" CornerRadius="8"
                                    Background="#334155">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="22"
                                               FontFamily="{StaticResource AppFont}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" FontSize="18"
                                               Foreground="#94A3B8" VerticalAlignment="Center"
                                               Margin="16,0" FontFamily="{StaticResource AppFont}">
                                        <Run Text="x"/>
                                        <Run Text="{Binding Quantity, StringFormat=G}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" FontSize="22"
                                               FontWeight="Bold" HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               FontFamily="{StaticResource AppFont}">
                                        <Run Text="{Binding Total, StringFormat=N0}"/>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Grand total -->
            <Border Grid.Row="2" Background="#0F172A" Padding="30,24">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding GrandTotalLabel}" FontSize="18"
                                   Foreground="#94A3B8" FontFamily="{StaticResource AppFont}"/>
                        <TextBlock FontSize="20" Foreground="#94A3B8" Margin="0,4,0,0"
                                   FontFamily="{StaticResource AppFont}">
                            <Run Text="{Binding ItemCount, Mode=OneWay}"/>
                            <Run Text=" article(s)"/>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="56" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               FontFamily="{StaticResource AppFont}">
                        <Run Text="{Binding GrandTotal, StringFormat=N0, Mode=OneWay}"/>
                        <Run Text=" CDF" FontSize="28"/>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <!-- ══ NORMALIZED: Thank you + QR Code ══ -->
        <Grid Visibility="{Binding ShowReceipt, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0F172A" Offset="0"/>
                    <GradientStop Color="#1E3A5F" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="✓" FontSize="80" HorizontalAlignment="Center"
                           Foreground="#10B981"/>
                <TextBlock Text="Merci pour votre achat !" FontSize="36"
                           FontWeight="Bold" HorizontalAlignment="Center"
                           Margin="0,20,0,0" FontFamily="{StaticResource AppFont}"/>
                <TextBlock Text="{Binding CompanyName}" FontSize="22"
                           HorizontalAlignment="Center" Foreground="#94A3B8"
                           Margin="0,8,0,30" FontFamily="{StaticResource AppFont}"/>

                <!-- Total -->
                <Border Background="#1E293B" CornerRadius="16" Padding="40,20"
                        HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="TOTAL" FontSize="16" Foreground="#94A3B8"
                                   HorizontalAlignment="Center"
                                   FontFamily="{StaticResource AppFont}"/>
                        <TextBlock FontSize="52" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   FontFamily="{StaticResource AppFont}">
                            <Run Text="{Binding GrandTotal, StringFormat=N0, Mode=OneWay}"/>
                            <Run Text=" CDF" FontSize="24"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- QR Code -->
                <Border Background="White" CornerRadius="12" Padding="16"
                        Margin="0,30,0,0" HorizontalAlignment="Center">
                    <Image Source="{Binding QrCodeImage}" Width="200" Height="200"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>

                <TextBlock Text="{Binding CodeDEFDGI}" FontSize="14"
                           Foreground="#64748B" HorizontalAlignment="Center"
                           Margin="0,12,0,0" FontFamily="Consolas"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>