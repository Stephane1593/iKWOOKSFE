<Window x:Class="SFE.WPF.Views.Pages.ConvertProformaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Convertir la proforma"
        Width="480" Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <materialDesign:PackIcon Width="24" Height="24" Margin="0,0,10,0"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource PrimaryBrush}"
                                     Kind="SwapHorizontal"/>
            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="18"
                       FontWeight="Bold" VerticalAlignment="Center"
                       Text="Convertir la proforma"/>
        </StackPanel>

        <Border Grid.Row="1" Padding="14,10" Background="#ECEFF1" CornerRadius="8"
                Margin="0,0,0,16">
            <TextBlock x:Name="InfoText" FontSize="12" Foreground="#37474F"
                       TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="2">
            <TextBlock FontSize="12" Margin="0,0,0,6"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Type de facture fiscale à émettre *"/>
            <ComboBox x:Name="TypeCombo" MinHeight="42" Padding="10,8" FontSize="13">
                <ComboBoxItem Content="FV — Facture de vente"            Tag="FV" IsSelected="True"/>
                <ComboBoxItem Content="EV — Facture de vente (export)"   Tag="EV"/>
                <ComboBoxItem Content="FT — Facture d'acompte"           Tag="FT"/>
                <ComboBoxItem Content="ET — Facture d'acompte (export)"  Tag="ET"/>
            </ComboBox>

            <StackPanel x:Name="AdvancePanel" Margin="0,14,0,0" Visibility="Collapsed">
                <TextBlock FontSize="12" Margin="0,0,0,6"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Montant de l'acompte reçu (CDF) *"/>
                <TextBox x:Name="AdvanceBox" MinHeight="42" Padding="12,10" FontSize="13"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="CancelBtn" Content="Annuler" Click="Cancel_Click"
                    MinHeight="42" MinWidth="90" Margin="0,0,8,0"
                    Background="{StaticResource BackgroundBrush}"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    BorderThickness="0" Padding="14,10" Cursor="Hand"/>
            <Button x:Name="OkBtn" Content="Convertir" Click="Ok_Click"
                    MinHeight="42" MinWidth="120"
                    Background="{StaticResource PrimaryBrush}" Foreground="White"
                    BorderThickness="0" Padding="14,10" Cursor="Hand"
                    FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>