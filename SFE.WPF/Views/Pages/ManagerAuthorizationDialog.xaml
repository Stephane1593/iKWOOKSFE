<Window x:Class="SFE.WPF.Views.Pages.ManagerAuthorizationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Autorisation Manager"
        Width="560" Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">
    <Border CornerRadius="16" Background="#0F172A">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" Opacity="0.5" ShadowDepth="6" Color="#000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="20,16" Background="#1E293B"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ShieldKeyOutline" Width="22" Height="22"
                                             Foreground="#F59E0B" VerticalAlignment="Center"/>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="AUTORISATION MANAGER REQUISE" FontSize="13"
                                   FontWeight="Bold" Foreground="#F59E0B"/>
                        <TextBlock Text="{Binding ActionLabel}" FontSize="12"
                                   Foreground="#94A3B8" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Body -->
            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}"
                        Background="Transparent" BorderThickness="0" Margin="16,12">

                <!-- Barcode tab -->
                <TabItem Header="Code-barres">
                    <StackPanel Margin="12,20">
                        <TextBlock Text="Scannez la carte manager :"
                                   Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <TextBox x:Name="BarcodeBox"
                                 Text="{Binding BarcodePayload, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="BarcodeBox_KeyDown"
                                 Background="#0F172A" Foreground="White"
                                 FontSize="16" Padding="12" BorderBrush="#334155"/>
                        <TextBlock Text="Astuce : appuyez sur Entrée aprčs saisie manuelle."
                                   Foreground="#64748B" FontSize="11" Margin="0,8,0,0"/>
                    </StackPanel>
                </TabItem>

                <!-- PIN tab -->
                <TabItem Header="PIN">
                    <StackPanel Margin="12,20">
                        <TextBlock Text="Identifiant manager (optionnel)" Foreground="#94A3B8"/>
                        <TextBox Text="{Binding PinUsername, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#0F172A" Foreground="White" Padding="10"
                                 Margin="0,4,0,12" BorderBrush="#334155"/>
                        <TextBlock Text="PIN" Foreground="#94A3B8"/>
                        <PasswordBox x:Name="PinBox"
                                     PasswordChanged="PinBox_PasswordChanged"
                                     Background="#0F172A" Foreground="White"
                                     FontSize="18" Padding="10" Margin="0,4,0,0"
                                     BorderBrush="#334155"/>
                        <Button Content="Valider PIN" Margin="0,16,0,0"
                                Command="{Binding SubmitPinCommand}"
                                Background="#3B82F6" Foreground="White"
                                Padding="14,10" BorderThickness="0"/>
                    </StackPanel>
                </TabItem>

                <!-- Credentials tab -->
                <TabItem Header="Identifiants complets">
                    <StackPanel Margin="12,20">
                        <TextBlock Text="Identifiant manager" Foreground="#94A3B8"/>
                        <TextBox Text="{Binding CredUsername, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#0F172A" Foreground="White" Padding="10"
                                 Margin="0,4,0,12" BorderBrush="#334155"/>
                        <TextBlock Text="Mot de passe" Foreground="#94A3B8"/>
                        <PasswordBox x:Name="CredBox"
                                     PasswordChanged="CredBox_PasswordChanged"
                                     Background="#0F172A" Foreground="White"
                                     Padding="10" Margin="0,4,0,0" BorderBrush="#334155"/>
                        <Button Content="Valider identifiants" Margin="0,16,0,0"
                                Command="{Binding SubmitCredentialsCommand}"
                                Background="#3B82F6" Foreground="White"
                                Padding="14,10" BorderThickness="0"/>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <!-- Footer -->
            <Border Grid.Row="2" Padding="20,14" Background="#1E293B">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Grid.Column="1" Content="Annuler"
                            Command="{Binding CancelCommand}"
                            Background="#334155" Foreground="White"
                            Padding="16,10" BorderThickness="0"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>