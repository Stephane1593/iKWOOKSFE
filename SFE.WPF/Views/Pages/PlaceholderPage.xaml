<UserControl x:Class="SFE.WPF.Views.Pages.PlaceholderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel HorizontalAlignment="Center">
            <!-- Icône grande -->
            <Border Background="{StaticResource PrimaryLightBrush}"
                    CornerRadius="24" Width="80" Height="80"
                    HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}"
                           FontSize="32" Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock x:Name="TitleText"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <TextBlock x:Name="DescriptionText"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="14"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="🚧 En cours de développement"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="13"
                       Foreground="{StaticResource WarningBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>