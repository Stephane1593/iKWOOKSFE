<UserControl x:Class="SFE.WPF.Views.Pages.PlaceholderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource BackgroundBrush}">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel HorizontalAlignment="Center" MaxWidth="400">

            <!-- ── Outer glow circle ── -->
            <Border Width="120" Height="120" CornerRadius="60"
                    HorizontalAlignment="Center" Margin="0,0,0,8">
                <Border.Background>
                    <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.04"/>
                </Border.Background>

                <!-- Inner icon circle -->
                <Border Width="88" Height="88" CornerRadius="44"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Background>
                        <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.08"/>
                    </Border.Background>
                    <materialDesign:PackIcon Kind="HammerWrench" Width="38" Height="38"
                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon.Foreground>
                            <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.45"/>
                        </materialDesign:PackIcon.Foreground>
                    </materialDesign:PackIcon>
                </Border>
            </Border>

            <!-- ── Title ── -->
            <TextBlock x:Name="TitleText"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       Margin="0,16,0,0"/>

            <!-- ── Description ── -->
            <TextBlock x:Name="DescriptionText"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="14" LineHeight="22"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>

            <!-- ── Status badge ── -->
            <Border HorizontalAlignment="Center" Margin="0,28,0,0"
                    CornerRadius="12" Padding="18,10">
                <Border.Background>
                    <SolidColorBrush Color="{StaticResource WarningColor}" Opacity="0.08"/>
                </Border.Background>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ProgressWrench" Width="16" Height="16"
                                             Foreground="{StaticResource WarningBrush}"
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="En cours de développement"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="13" FontWeight="Medium"
                               Foreground="{StaticResource WarningBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</UserControl>