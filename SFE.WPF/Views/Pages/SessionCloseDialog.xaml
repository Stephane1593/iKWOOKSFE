<Window x:Class="SFE.WPF.Views.Pages.SessionCloseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clôture de Session — Rapport Z"
        Width="720" Height="860"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E2E"
        Foreground="White"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Section header -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#A0C4FF"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Label -->
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Value -->
        <Style x:Key="Val" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- Input TextBox -->
        <Style x:Key="AmountInput" TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444466"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <!-- Thin separator -->
        <Style x:Key="Sep" TargetType="Border">
            <Setter Property="Background" Value="#333355"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Background="#252540" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="CLÔTURE DE SESSION" FontSize="18" FontWeight="Bold" Foreground="#FF6B6B"/>
                    <TextBlock Text="Rapport Z — Fermeture de caisse" FontSize="12" Foreground="#888" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding CurrentDate}" FontSize="11" Foreground="#888" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding CurrentTime}" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ LOADING ═══ -->
        <Border Grid.Row="1" Background="#1E1E2E" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                Panel.ZIndex="10">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⏳ Chargement des données de session..." FontSize="14" Foreground="#888"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ═══ CONTENT ═══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,10">
            <StackPanel>

                <!-- Section: Session Info -->
                <TextBlock Text="📋 RÉSUMÉ DE SESSION" Style="{StaticResource SectionHeader}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Opérateur" Style="{StaticResource Lbl}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OperatorName}" Foreground="White" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Point de vente" Style="{StaticResource Lbl}"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding PosName}" Foreground="White" FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ouverture" Style="{StaticResource Lbl}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OpenedAtDisplay}" Foreground="White"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Code POS" Style="{StaticResource Lbl}"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding PosCode}" Foreground="White"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Durée" Style="{StaticResource Lbl}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DurationDisplay}" Foreground="#FFD700" FontWeight="SemiBold"/>
                </Grid>

                <Border Style="{StaticResource Sep}"/>

                <!-- Section: Sales Summary -->
                <TextBlock Text="📊 VENTES DE LA SESSION" Style="{StaticResource SectionHeader}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Factures normalisées" Style="{StaticResource Lbl}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalInvoiceCount}" Style="{StaticResource Val}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Total TTC net" Style="{StaticResource Lbl}"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" FontSize="14" FontWeight="Bold" Foreground="#4ADE80"
                               HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Run Text="{Binding NetTTCDisplay, Mode=OneWay}"/><Run Text=" CDF"/>
                    </TextBlock>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Dont ventes" Style="{StaticResource Lbl}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SalesCount}" Style="{StaticResource Val}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Paiements non-espèces" Style="{StaticResource Lbl}"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource Val}">
                        <Run Text="{Binding NonCashTotalDisplay, Mode=OneWay}"/><Run Text=" CDF"/>
                    </TextBlock>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Dont avoirs" Style="{StaticResource Lbl}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CreditNoteCount}" Style="{StaticResource Val}" Foreground="#FF6B6B"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Ventes incomplètes" Style="{StaticResource Lbl}"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding IncompleteCount}" Style="{StaticResource Val}" Foreground="#FF6B6B"/>
                </Grid>

                <Border Style="{StaticResource Sep}"/>

                <!-- Section: Currency Table -->
                <TextBlock Text="💰 DÉTAIL PAR DEVISE" Style="{StaticResource SectionHeader}"/>

                <!-- Header row -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Devise" Foreground="#666" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="Ouverture" Foreground="#666" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="Mvt. espèces" Foreground="#666" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="Attendu" Foreground="#666" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="4" Text="Compté (saisir)" Foreground="#666" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="Écart" Foreground="#666" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>

                <!-- USD Row -->
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="USD" Foreground="#4ADE80" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding OpeningUSD, StringFormat=N2}" Style="{StaticResource Val}"/>
                    <TextBlock Grid.Column="2" Text="{Binding CashSalesUSD}" Foreground="#A0C4FF" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding ExpectedUSD}" Foreground="#FFD700" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBox   Grid.Column="4" Text="{Binding ClosingAmountUSD, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AmountInput}" Margin="8,0"/>
                    <TextBlock Grid.Column="5" Text="{Binding VarianceUSD}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- CDF Row -->
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CDF" Foreground="#4ADE80" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding OpeningCDF, StringFormat=N0}" Style="{StaticResource Val}"/>
                    <TextBlock Grid.Column="2" Text="{Binding CashSalesCDF}" Foreground="#A0C4FF" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding ExpectedCDF}" Foreground="#FFD700" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBox   Grid.Column="4" Text="{Binding ClosingAmountCDF, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AmountInput}" Margin="8,0"/>
                    <TextBlock Grid.Column="5" Text="{Binding VarianceCDF}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- EUR Row -->
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="EUR" Foreground="#4ADE80" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding OpeningEUR, StringFormat=N2}" Style="{StaticResource Val}"/>
                    <TextBlock Grid.Column="2" Text="{Binding CashSalesEUR}" Foreground="#A0C4FF" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding ExpectedEUR}" Foreground="#FFD700" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBox   Grid.Column="4" Text="{Binding ClosingAmountEUR, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AmountInput}" Margin="8,0"/>
                    <TextBlock Grid.Column="5" Text="{Binding VarianceEUR}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- CNY Row -->
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CNY" Foreground="#4ADE80" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding OpeningCNY, StringFormat=N2}" Style="{StaticResource Val}"/>
                    <TextBlock Grid.Column="2" Text="{Binding CashSalesCNY}" Foreground="#A0C4FF" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding ExpectedCNY}" Foreground="#FFD700" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBox   Grid.Column="4" Text="{Binding ClosingAmountCNY, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AmountInput}" Margin="8,0"/>
                    <TextBlock Grid.Column="5" Text="{Binding VarianceCNY}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- Totals row -->
                <Border Background="#252540" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="TOTAL" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding OpeningTotalCDF}" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="2" Text="" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding ExpectedTotalCDF}" Foreground="#FFD700" FontWeight="Bold"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="4" Text="{Binding ClosingTotalCDF}" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                        <TextBlock Grid.Column="5" Text="{Binding VarianceTotalCDF}" FontWeight="Bold"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
                    </Grid>
                </Border>

                <!-- Quick fill button -->
                <Button Content="📋 Remplir avec les montants attendus" Margin="0,8,0,0"
                        Command="{Binding FillExpectedAmountsCommand}"
                        Background="Transparent" Foreground="#A0C4FF" BorderThickness="0"
                        FontSize="11" HorizontalAlignment="Left" Cursor="Hand"/>

                <Border Style="{StaticResource Sep}"/>

                <!-- Variance Status -->
                <Border Background="#252540" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                    <TextBlock Text="{Binding VarianceStatus}" FontSize="15" FontWeight="Bold"
                               HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#4ADE80"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasVariance}" Value="True">
                                        <Setter Property="Foreground" Value="#FF6B6B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <Border Style="{StaticResource Sep}"/>

                <!-- Notes -->
                <TextBlock Text="📝 NOTES DE CLÔTURE" Style="{StaticResource SectionHeader}"/>
                <TextBox Text="{Binding ClosingNotes, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource AmountInput}"
                         HorizontalContentAlignment="Left"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         Height="60" VerticalScrollBarVisibility="Auto"/>

                <!-- Error / Success messages -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF6B6B" FontSize="12"
                           Margin="0,10,0,0" TextWrapping="Wrap"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <TextBlock Text="{Binding SuccessMessage}" Foreground="#4ADE80" FontSize="12"
                           Margin="0,10,0,0" TextWrapping="Wrap"
                           Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Border Height="20"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ FOOTER BUTTONS ═══ -->
        <Border Grid.Row="2" Background="#252540" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Warning if held transactions -->
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Foreground="#FF6B6B" FontSize="11"
                           Text="⚠ Vérifiez qu'aucun panier n'est en attente avant de clôturer."/>

                <Button Grid.Column="1" Content="Annuler" Padding="24,10"
                        Command="{Binding CancelCommand}"
                        Background="#3A3A50" Foreground="White" BorderThickness="0"
                        FontSize="13" Cursor="Hand"/>

                <Button Grid.Column="3" Padding="24,10"
                        Command="{Binding ConfirmCommand}"
                        IsEnabled="{Binding IsDataLoaded}"
                        Background="#FF6B6B" Foreground="White" BorderThickness="0"
                        FontSize="13" FontWeight="Bold" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔒 Clôturer &amp; Générer Z" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>