<!-- File: SFE.WPF/Views/Pages/SessionCloseDialog.xaml -->
<Window x:Class="SFE.WPF.Views.Pages.SessionCloseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Clôture de Session — Rapport Z"
        Width="800" Height="940"
        MinWidth="640" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>

        <!-- ══════════════════════════════════════════════ -->
        <!--  COLOUR PALETTE                                -->
        <!-- ══════════════════════════════════════════════ -->
        <Color x:Key="AccentBlue">#3B82F6</Color>
        <Color x:Key="AccentBlueDark">#2563EB</Color>
        <Color x:Key="AccentBlueDeep">#1D4ED8</Color>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}"/>

        <Color x:Key="DangerRed">#EF4444</Color>
        <Color x:Key="DangerRedDark">#DC2626</Color>
        <Color x:Key="DangerRedDeep">#B91C1C</Color>

        <Color x:Key="DarkBase">#0F172A</Color>
        <Color x:Key="DarkCard">#1E293B</Color>
        <Color x:Key="DarkElevated">#334155</Color>
        <Color x:Key="DarkElevatedHover">#475569</Color>
        <SolidColorBrush x:Key="DarkBaseBrush"     Color="{StaticResource DarkBase}"/>
        <SolidColorBrush x:Key="DarkCardBrush"     Color="{StaticResource DarkCard}"/>
        <SolidColorBrush x:Key="DarkElevatedBrush" Color="{StaticResource DarkElevated}"/>
        <SolidColorBrush x:Key="DarkTextPrimary"   Color="#F1F5F9"/>
        <SolidColorBrush x:Key="DarkTextMuted"     Color="#94A3B8"/>
        <SolidColorBrush x:Key="DarkBorder"        Color="#334155"/>

        <!-- ══════════════════════════════════════════════ -->
        <!--  CUSTOM SCROLLBAR THUMB                        -->
        <!-- ══════════════════════════════════════════════ -->
        <Style x:Key="DarkScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBd" CornerRadius="4" Margin="2,0">
                            <Border.Background>
                                <SolidColorBrush x:Name="ThumbBg" Color="#475569"/>
                            </Border.Background>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="ThumbBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#64748B" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="ThumbBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#475569" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource AccentBlue}"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════ -->
        <!--  VERTICAL SCROLLBAR                            -->
        <!-- ══════════════════════════════════════════════ -->
        <Style x:Key="DarkScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border CornerRadius="4" Background="#1E293B" Margin="2,0"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════ -->
        <!--  LABEL / VALUE text styles                     -->
        <!-- ══════════════════════════════════════════════ -->
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Val" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ══════════════════════════════════════════════ -->
        <!--  TOUCH INPUT (TextBox)                         -->
        <!-- ══════════════════════════════════════════════ -->
        <Style x:Key="TouchInput" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="1.5">
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="BdBr" Color="#334155"/>
                            </Border.BorderBrush>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="GotKeyboardFocus">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBr"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource AccentBlue}"
                                                        Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="LostKeyboardFocus">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBr"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#334155"
                                                        Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════ -->
        <!--  TITLE BAR ICON BUTTON                         -->
        <!-- ══════════════════════════════════════════════ -->
        <Style x:Key="TitleBarIconBtn" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="Transparent"/>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#334155" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="Transparent" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════ -->
        <!--  CLOSE (✕) BUTTON — red on hover               -->
        <!-- ══════════════════════════════════════════════ -->
        <Style x:Key="CloseIconBtn" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="Transparent"/>
                            </Border.Background>
                            <materialDesign:PackIcon x:Name="Ico" Kind="Close"
                                Width="18" Height="18"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon.Foreground>
                                    <SolidColorBrush x:Name="IcoFg" Color="#94A3B8"/>
                                </materialDesign:PackIcon.Foreground>
                            </materialDesign:PackIcon>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#DC2626" Duration="0:0:0.12"/>
                                        <ColorAnimation Storyboard.TargetName="IcoFg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="White" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="Transparent" Duration="0:0:0.18"/>
                                        <ColorAnimation Storyboard.TargetName="IcoFg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#94A3B8" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════ -->
        <!--  DARK GHOST BUTTON (animated)                  -->
        <!-- ══════════════════════════════════════════════ -->
        <Style x:Key="DarkGhostBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource DarkTextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="20,11"
                                BorderThickness="1">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="{StaticResource DarkElevated}"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="BdBr" Color="#475569"/>
                            </Border.BorderBrush>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource DarkElevatedHover}"
                                                        Duration="0:0:0.15"/>
                                        <ColorAnimation Storyboard.TargetName="BdBr"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#64748B" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource DarkElevated}"
                                                        Duration="0:0:0.18"/>
                                        <ColorAnimation Storyboard.TargetName="BdBr"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#475569" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════ -->
        <!--  DANGER BUTTON (red gradient, animated)        -->
        <!-- ══════════════════════════════════════════════ -->
        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="22,12">
                            <Border.Background>
                                <LinearGradientBrush x:Name="BdGrad" StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="G0" Color="{StaticResource DangerRed}" Offset="0"/>
                                    <GradientStop x:Name="G1" Color="{StaticResource DangerRedDark}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="10"
                                                  Opacity="0.3" Color="{StaticResource DangerRed}"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource DangerRedDark}"
                                                        Duration="0:0:0.18"/>
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource DangerRedDeep}"
                                                        Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource DangerRed}"
                                                        Duration="0:0:0.22"/>
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource DangerRedDark}"
                                                        Duration="0:0:0.22"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════ -->
        <!--  LINK BUTTON (subtle, for "fill expected")     -->
        <!-- ══════════════════════════════════════════════ -->
        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#60A5FA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="12,8"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bd"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#1E293B" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bd"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="Transparent" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ══════════════════════════════════════════════════════ -->
    <!--  OUTER SHELL  (rounded window with shadow)            -->
    <!-- ══════════════════════════════════════════════════════ -->
    <Border CornerRadius="16" ClipToBounds="True"
            TextElement.Foreground="#F1F5F9">
        <Border.Background>
            <SolidColorBrush Color="{StaticResource DarkBase}"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" Opacity="0.5"
                              ShadowDepth="6" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════ -->
            <!--  TITLE BAR                                  -->
            <!-- ═══════════════════════════════════════════ -->
            <Border Grid.Row="0" Padding="24,18"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1E293B" Offset="0"/>
                        <GradientStop Color="#253449" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Color="#334155" Opacity="0.5"/>
                </Border.BorderBrush>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon badge -->
                    <Border CornerRadius="10" Padding="9" Margin="0,0,16,0"
                            VerticalAlignment="Center">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource DangerRed}" Opacity="0.12"/>
                        </Border.Background>
                        <materialDesign:PackIcon Kind="LockOutline"
                                                 Width="20" Height="20"
                                                 Foreground="#EF4444"/>
                    </Border>

                    <!-- Title + date/time -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource AppFont}"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#EF4444"
                                   Text="CLÔTURE DE SESSION"/>
                        <TextBlock FontFamily="{StaticResource AppFont}"
                                   FontSize="11.5" Foreground="#94A3B8"
                                   Margin="0,3,0,0"
                                   Text="Rapport Z — Fermeture de caisse"/>
                    </StackPanel>

                    <!-- Live clock -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                HorizontalAlignment="Right" Margin="0,0,16,0">
                        <TextBlock Text="{Binding CurrentDate}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="11" Foreground="#64748B"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding CurrentTime}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="#F1F5F9"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>

                    <!-- Minimize -->
                    <Button Grid.Column="3" Style="{StaticResource TitleBarIconBtn}"
                            Click="MinimizeClick" Margin="0,0,4,0"
                            VerticalAlignment="Top">
                        <materialDesign:PackIcon Kind="WindowMinimize"
                            Width="16" Height="16"
                            Foreground="#94A3B8"/>
                    </Button>

                    <!-- Close -->
                    <Button Grid.Column="4" Style="{StaticResource CloseIconBtn}"
                            Click="CloseClick" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════ -->
            <!--  LOADING OVERLAY                            -->
            <!-- ═══════════════════════════════════════════ -->
            <Border Grid.Row="1" Panel.ZIndex="10"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border.Background>
                    <SolidColorBrush Color="{StaticResource DarkBase}" Opacity="0.92"/>
                </Border.Background>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="TimerSand"
                        Width="36" Height="36" Foreground="#60A5FA"
                        HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <TextBlock Text="Chargement des données de session…"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="14" Foreground="#94A3B8"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════ -->
            <!--  SCROLLABLE CONTENT                         -->
            <!-- ═══════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <ScrollViewer.Resources>
                    <Style TargetType="{x:Type ScrollBar}"
                           BasedOn="{StaticResource DarkScrollBar}"/>
                </ScrollViewer.Resources>

                <StackPanel Margin="24,20,24,24">

                    <!-- ───────────────────────────────── -->
                    <!--  CARD 1 — Session Info             -->
                    <!-- ───────────────────────────────── -->
                    <Border Background="#1E293B" CornerRadius="14"
                            Padding="22,18" Margin="0,0,0,14">

                        <StackPanel>
                            <!-- Section header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border CornerRadius="8" Padding="7" Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <Border.Background>
                                        <SolidColorBrush Color="{StaticResource AccentBlue}" Opacity="0.1"/>
                                    </Border.Background>
                                    <materialDesign:PackIcon Kind="ClipboardTextOutline"
                                        Width="16" Height="16"
                                        Foreground="{StaticResource AccentBlueBrush}"/>
                                </Border>
                                <TextBlock Text="RÉSUMÉ DE SESSION"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="#60A5FA"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="38"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="Opérateur" Style="{StaticResource Lbl}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding OperatorName}"
                                           FontFamily="{StaticResource AppFont}"
                                           Foreground="White" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Text="Point de vente" Style="{StaticResource Lbl}"/>
                                <TextBlock Grid.Row="0" Grid.Column="3"
                                           Text="{Binding PosName}"
                                           FontFamily="{StaticResource AppFont}"
                                           Foreground="White" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="Ouverture" Style="{StaticResource Lbl}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding OpenedAtDisplay}"
                                           FontFamily="{StaticResource AppFont}"
                                           Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="2"
                                           Text="Code POS" Style="{StaticResource Lbl}"/>
                                <TextBlock Grid.Row="1" Grid.Column="3"
                                           Text="{Binding PosCode}"
                                           FontFamily="{StaticResource AppFont}"
                                           Foreground="White" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="Durée" Style="{StaticResource Lbl}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="{Binding DurationDisplay}"
                                           FontFamily="{StaticResource AppFont}"
                                           Foreground="#FBBF24" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ───────────────────────────────── -->
                    <!--  CARD 2 — Sales Summary            -->
                    <!-- ───────────────────────────────── -->
                    <Border Background="#1E293B" CornerRadius="14"
                            Padding="22,18" Margin="0,0,0,14">

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border CornerRadius="8" Padding="7" Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <Border.Background>
                                        <SolidColorBrush Color="#8B5CF6" Opacity="0.1"/>
                                    </Border.Background>
                                    <materialDesign:PackIcon Kind="ChartBar"
                                        Width="16" Height="16" Foreground="#A78BFA"/>
                                </Border>
                                <TextBlock Text="VENTES DE LA SESSION"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="#A78BFA"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="38"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="Factures normalisées" Style="{StaticResource Lbl}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding TotalInvoiceCount}" Style="{StaticResource Val}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Text="Total TTC net" Style="{StaticResource Lbl}"/>
                                <TextBlock Grid.Row="0" Grid.Column="3"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="15" FontWeight="Bold" Foreground="#4ADE80"
                                           HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Run Text="{Binding NetTTCDisplay, Mode=OneWay}"/><Run Text=" CDF"/>
                                </TextBlock>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="Dont ventes" Style="{StaticResource Lbl}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding SalesCount}" Style="{StaticResource Val}"/>
                                <TextBlock Grid.Row="1" Grid.Column="2"
                                           Text="Paiements non-espèces" Style="{StaticResource Lbl}"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource Val}">
                                    <Run Text="{Binding NonCashTotalDisplay, Mode=OneWay}"/><Run Text=" CDF"/>
                                </TextBlock>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="Dont avoirs" Style="{StaticResource Lbl}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="{Binding CreditNoteCount}"
                                           Style="{StaticResource Val}" Foreground="#EF4444"/>
                                <TextBlock Grid.Row="2" Grid.Column="2"
                                           Text="Ventes incomplètes" Style="{StaticResource Lbl}"/>
                                <TextBlock Grid.Row="2" Grid.Column="3"
                                           Text="{Binding IncompleteCount}"
                                           Style="{StaticResource Val}" Foreground="#EF4444"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ───────────────────────────────── -->
                    <!--  CARD 3 — Currency Detail Table    -->
                    <!-- ───────────────────────────────── -->
                    <Border Background="#1E293B" CornerRadius="14"
                            Padding="22,18" Margin="0,0,0,14">

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border CornerRadius="8" Padding="7" Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <Border.Background>
                                        <SolidColorBrush Color="#F59E0B" Opacity="0.1"/>
                                    </Border.Background>
                                    <materialDesign:PackIcon Kind="CashMultiple"
                                        Width="16" Height="16" Foreground="#FBBF24"/>
                                </Border>
                                <TextBlock Text="DÉTAIL PAR DEVISE"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="#FBBF24"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- ── Unified grid for perfect column alignment ── -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="54"/>
                                    <RowDefinition Height="1"/>
                                    <RowDefinition Height="54"/>
                                    <RowDefinition Height="1"/>
                                    <RowDefinition Height="54"/>
                                    <RowDefinition Height="1"/>
                                    <RowDefinition Height="54"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="52"/>
                                </Grid.RowDefinitions>

                                <!-- ── Header row ── -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="DEVISE" Style="{StaticResource ColHeader}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="OUVERTURE" Style="{StaticResource ColHeader}"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Text="MVT. ESP." Style="{StaticResource ColHeader}"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="0" Grid.Column="3"
                                           Text="ATTENDU" Style="{StaticResource ColHeader}"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="0" Grid.Column="4"
                                           Text="COMPTÉ" Style="{StaticResource ColHeader}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="5"
                                           Text="ÉCART" Style="{StaticResource ColHeader}"
                                           HorizontalAlignment="Right"/>

                                <!-- ── USD row ── -->
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="USD" FontFamily="{StaticResource AppFont}"
                                           Foreground="#4ADE80" FontWeight="Bold" FontSize="13"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding OpeningUSD, StringFormat=N2}"
                                           Style="{StaticResource Val}"/>
                                <TextBlock Grid.Row="1" Grid.Column="2"
                                           Text="{Binding CashSalesUSD}"
                                           FontFamily="{StaticResource AppFont}"
                                           Foreground="#60A5FA" FontSize="12"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="3"
                                           Text="{Binding ExpectedUSD}"
                                           FontFamily="{StaticResource AppFont}"
                                           Foreground="#FBBF24" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBox   Grid.Row="1" Grid.Column="4"
                                           Text="{Binding ClosingAmountUSD, UpdateSourceTrigger=PropertyChanged}"
                                           Style="{StaticResource TouchInput}" Margin="10,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="5"
                                           Text="{Binding VarianceUSD}"
                                           FontFamily="{StaticResource AppFont}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <!-- Sep -->
                                <Border Grid.Row="2" Grid.ColumnSpan="6"
                                        Background="#334155" Opacity="0.3"/>

                                <!-- ── CDF row ── -->
                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Text="CDF" FontFamily="{StaticResource AppFont}"
                                           Foreground="#4ADE80" FontWeight="Bold" FontSize="13"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="3" Grid.Column="1"
                                           Text="{Binding OpeningCDF, StringFormat=N0}"
                                           Style="{StaticResource Val}"/>
                                <TextBlock Grid.Row="3" Grid.Column="2"
                                           Text="{Binding CashSalesCDF}"
                                           FontFamily="{StaticResource AppFont}"
                                           Foreground="#60A5FA" FontSize="12"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="3" Grid.Column="3"
                                           Text="{Binding ExpectedCDF}"
                                           FontFamily="{StaticResource AppFont}"
                                           Foreground="#FBBF24" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBox   Grid.Row="3" Grid.Column="4"
                                           Text="{Binding ClosingAmountCDF, UpdateSourceTrigger=PropertyChanged}"
                                           Style="{StaticResource TouchInput}" Margin="10,4"/>
                                <TextBlock Grid.Row="3" Grid.Column="5"
                                           Text="{Binding VarianceCDF}"
                                           FontFamily="{StaticResource AppFont}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <!-- Sep -->
                                <Border Grid.Row="4" Grid.ColumnSpan="6"
                                        Background="#334155" Opacity="0.3"/>

                                <!-- ── EUR row ── -->
                                <TextBlock Grid.Row="5" Grid.Column="0"
                                           Text="EUR" FontFamily="{StaticResource AppFont}"
                                           Foreground="#4ADE80" FontWeight="Bold" FontSize="13"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="5" Grid.Column="1"
                                           Text="{Binding OpeningEUR, StringFormat=N2}"
                                           Style="{StaticResource Val}"/>
                                <TextBlock Grid.Row="5" Grid.Column="2"
                                           Text="{Binding CashSalesEUR}"
                                           FontFamily="{StaticResource AppFont}"
                                           Foreground="#60A5FA" FontSize="12"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="5" Grid.Column="3"
                                           Text="{Binding ExpectedEUR}"
                                           FontFamily="{StaticResource AppFont}"
                                           Foreground="#FBBF24" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBox   Grid.Row="5" Grid.Column="4"
                                           Text="{Binding ClosingAmountEUR, UpdateSourceTrigger=PropertyChanged}"
                                           Style="{StaticResource TouchInput}" Margin="10,4"/>
                                <TextBlock Grid.Row="5" Grid.Column="5"
                                           Text="{Binding VarianceEUR}"
                                           FontFamily="{StaticResource AppFont}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <!-- Sep -->
                                <Border Grid.Row="6" Grid.ColumnSpan="6"
                                        Background="#334155" Opacity="0.3"/>

                                <!-- ── CNY row ── -->
                                <TextBlock Grid.Row="7" Grid.Column="0"
                                           Text="CNY" FontFamily="{StaticResource AppFont}"
                                           Foreground="#4ADE80" FontWeight="Bold" FontSize="13"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="7" Grid.Column="1"
                                           Text="{Binding OpeningCNY, StringFormat=N2}"
                                           Style="{StaticResource Val}"/>
                                <TextBlock Grid.Row="7" Grid.Column="2"
                                           Text="{Binding CashSalesCNY}"
                                           FontFamily="{StaticResource AppFont}"
                                           Foreground="#60A5FA" FontSize="12"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="7" Grid.Column="3"
                                           Text="{Binding ExpectedCNY}"
                                           FontFamily="{StaticResource AppFont}"
                                           Foreground="#FBBF24" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBox   Grid.Row="7" Grid.Column="4"
                                           Text="{Binding ClosingAmountCNY, UpdateSourceTrigger=PropertyChanged}"
                                           Style="{StaticResource TouchInput}" Margin="10,4"/>
                                <TextBlock Grid.Row="7" Grid.Column="5"
                                           Text="{Binding VarianceCNY}"
                                           FontFamily="{StaticResource AppFont}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <!-- ── TOTAL row (highlighted) ── -->
                                <Border Grid.Row="9" Grid.ColumnSpan="6"
                                        Background="#253449" CornerRadius="10"/>

                                <TextBlock Grid.Row="9" Grid.Column="0"
                                           Text="TOTAL" FontFamily="{StaticResource AppFont}"
                                           FontWeight="Bold" Foreground="White" FontSize="13"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <TextBlock Grid.Row="9" Grid.Column="1"
                                           Text="{Binding OpeningTotalCDF}"
                                           FontFamily="{StaticResource AppFont}"
                                           Foreground="White" FontWeight="Bold" FontSize="12.5"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,0,4,0"/>
                                <TextBlock Grid.Row="9" Grid.Column="3"
                                           Text="{Binding ExpectedTotalCDF}"
                                           FontFamily="{StaticResource AppFont}"
                                           Foreground="#FBBF24" FontWeight="Bold" FontSize="12.5"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,0,4,0"/>
                                <TextBlock Grid.Row="9" Grid.Column="4"
                                           Text="{Binding ClosingTotalCDF}"
                                           FontFamily="{StaticResource AppFont}"
                                           Foreground="White" FontWeight="Bold" FontSize="13.5"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="9" Grid.Column="5"
                                           Text="{Binding VarianceTotalCDF}"
                                           FontFamily="{StaticResource AppFont}"
                                           FontWeight="Bold" FontSize="12.5"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,0,4,0"/>
                            </Grid>

                            <!-- Fill expected amounts button -->
                            <Button Style="{StaticResource LinkBtn}" Margin="0,10,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding FillExpectedAmountsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ClipboardCheckOutline"
                                        Width="15" Height="15" Foreground="#60A5FA"
                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Remplir avec les montants attendus"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="12" Foreground="#60A5FA"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- ───────────────────────────────── -->
                    <!--  CARD 4 — Variance Status          -->
                    <!-- ───────────────────────────────── -->
                    <Border Background="#1E293B" CornerRadius="14"
                            Padding="22,18" Margin="0,0,0,14">
                        <TextBlock Text="{Binding VarianceStatus}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#4ADE80"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasVariance}" Value="True">
                                            <Setter Property="Foreground" Value="#EF4444"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- ───────────────────────────────── -->
                    <!--  CARD 5 — Closing Notes            -->
                    <!-- ───────────────────────────────── -->
                    <Border Background="#1E293B" CornerRadius="14"
                            Padding="22,18" Margin="0,0,0,14">

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border CornerRadius="8" Padding="7" Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <Border.Background>
                                        <SolidColorBrush Color="#10B981" Opacity="0.1"/>
                                    </Border.Background>
                                    <materialDesign:PackIcon Kind="NoteEditOutline"
                                        Width="16" Height="16" Foreground="#34D399"/>
                                </Border>
                                <TextBlock Text="NOTES DE CLÔTURE"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="#34D399"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBox Text="{Binding ClosingNotes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TouchInput}"
                                     HorizontalContentAlignment="Left"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     Height="80" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Error / Success messages ── -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               FontFamily="{StaticResource AppFont}"
                               Foreground="#EF4444" FontSize="12.5"
                               Margin="4,0,0,8" TextWrapping="Wrap"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <TextBlock Text="{Binding SuccessMessage}"
                               FontFamily="{StaticResource AppFont}"
                               Foreground="#4ADE80" FontSize="12.5"
                               Margin="4,0,0,8" TextWrapping="Wrap"
                               Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVisibilityConverter}}"/>

                </StackPanel>
            </ScrollViewer>

            <!-- ═══════════════════════════════════════════ -->
            <!--  FOOTER                                     -->
            <!-- ═══════════════════════════════════════════ -->
            <Border Grid.Row="2" Padding="24,18"
                    BorderThickness="0,1,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1E293B" Offset="0"/>
                        <GradientStop Color="#253449" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Color="#334155" Opacity="0.5"/>
                </Border.BorderBrush>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Warning -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="AlertOutline"
                            Width="15" Height="15" Foreground="#FBBF24"
                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock FontFamily="{StaticResource AppFont}"
                                   FontSize="11.5" Foreground="#94A3B8"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap">
                            <Run Text="Vérifiez qu'aucun panier n'est en attente avant de clôturer."/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Cancel -->
                    <Button Grid.Column="1" Style="{StaticResource DarkGhostBtn}"
                            Command="{Binding CancelCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close"
                                Width="15" Height="15"
                                Foreground="#94A3B8"
                                VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Annuler" VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"/>
                        </StackPanel>
                    </Button>

                    <!-- Confirm -->
                    <Button Grid.Column="3" Style="{StaticResource DangerBtn}"
                            Command="{Binding ConfirmCommand}"
                            IsEnabled="{Binding IsDataLoaded}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LockOutline"
                                Width="16" Height="16" Foreground="White"
                                VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Clôturer &amp; Générer Z"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"
                                       Foreground="White"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ── Invisible resize grip ── -->
            <ResizeGrip Grid.Row="2" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom" Opacity="0"
                        Width="16" Height="16"/>
        </Grid>
    </Border>
</Window>