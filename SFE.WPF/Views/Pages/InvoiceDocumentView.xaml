<UserControl x:Class="SFE.WPF.Views.Pages.InvoiceDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="750"
             Background="White">

    <UserControl.Resources>
        <Style x:Key="CellBorder"
               TargetType="Border">
            <Setter Property="BorderBrush" Value="#333" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
        <Style x:Key="HeaderText"
               TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DataText"
               TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LabelText"
               TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Border Padding="0"
            Background="White"
            BorderBrush="#333"
            BorderThickness="1">
        <StackPanel>

            <!--  ═══════════════════════════════════════════════  -->
            <!--  ROW 1: COMPANY HEADER (Logo + Info)  -->
            <!--  ═══════════════════════════════════════════════  -->
            <Border Padding="12,10"
                    BorderBrush="#333"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Logo  -->
                    <Border Width="100"
                            Height="60"
                            VerticalAlignment="Center">
                        <Grid>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="30"
                                       Text="">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CompanyLogo}"
                                                         Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Image RenderOptions.BitmapScalingMode="HighQuality"
                                   Source="{Binding CompanyLogo}"
                                   Stretch="Uniform" />
                        </Grid>
                    </Border>

                    <!--  Company info text  -->
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI"
                               FontSize="9"
                               LineHeight="14"
                               Text="{Binding CompanyFullAddress}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!--  ═══════════════════════════════════════════════  -->
            <!--  ROW 2: INVOICE TITLE  -->
            <!--  ═══════════════════════════════════════════════  -->
            <Border Padding="0,12">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               FontFamily="Segoe UI"
                               FontSize="16"
                               FontWeight="Bold"
                               Text="{Binding TypeTitle}" />
                </StackPanel>
            </Border>

            <!--  ═══════════════════════════════════════════════  -->
            <!--  ROW 3: INVOICE # + ISF + MODE  -->
            <!--  ═══════════════════════════════════════════════  -->
            <Border Padding="12,6"
                    BorderBrush="#333"
                    BorderThickness="0,1,0,1">
                <Grid>
                    <TextBlock FontFamily="Segoe UI"
                               FontSize="11"
                               FontWeight="Bold">
                        <Run Text="FACTURE # " />
                        <Run Text="{Binding InvoiceNumber, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <TextBlock Margin="0,0,24,0"
                                   FontFamily="Segoe UI"
                                   FontSize="9"
                                   FontWeight="Bold">
                            <Run Text="ISF : " />
                            <Run Text="{Binding Isf, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock FontFamily="Segoe UI"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Text="{Binding PriceModeLabel}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  ═══════════════════════════════════════════════  -->
            <!--  ROW 4: COMPANY + CLIENT DETAILS TABLE  -->
            <!--  ═══════════════════════════════════════════════  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Company details  -->
                <Border Padding="12,8"
                        BorderBrush="#333"
                        BorderThickness="0,0,0.5,1">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,3"
                                   FontSize="10"
                                   Style="{StaticResource LabelText}"
                                   Text="{Binding CompanyName}" />
                        <TextBlock Style="{StaticResource DataText}">
                            <Run FontWeight="SemiBold"
                                 Text="Point de Vente : " />
                            <Run Text="{Binding PosName, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource DataText}">
                            <Run FontWeight="SemiBold"
                                 Text="NIF : " />
                            <Run Text="{Binding CompanyNIF, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource DataText}"
                                   TextWrapping="Wrap">
                            <Run Text="{Binding CompanyAddress, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource DataText}"
                                   Text="{Binding CompanyCity}" />
                    </StackPanel>
                </Border>

                <!--  Client details (table style)  -->
                <Border Grid.Column="1"
                        BorderBrush="#333"
                        BorderThickness="0.5,0,0,1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource CellBorder}">
                            <TextBlock Style="{StaticResource LabelText}"
                                       Text="Client" />
                        </Border>
                        <Border Grid.Row="0"
                                Grid.Column="1"
                                Style="{StaticResource CellBorder}">
                            <TextBlock Style="{StaticResource HeaderText}"
                                       Text="{Binding ClientName}" />
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource CellBorder}">
                            <TextBlock Style="{StaticResource LabelText}"
                                       Text="Type" />
                        </Border>
                        <Border Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource CellBorder}">
                            <TextBlock Style="{StaticResource DataText}"
                                       Text="{Binding ClientType}" />
                        </Border>

                        <Border Grid.Row="2"
                                Grid.Column="0"
                                Style="{StaticResource CellBorder}">
                            <TextBlock Style="{StaticResource LabelText}"
                                       Text="NIF" />
                        </Border>
                        <Border Grid.Row="2"
                                Grid.Column="1"
                                Style="{StaticResource CellBorder}">
                            <TextBlock Style="{StaticResource DataText}"
                                       Text="{Binding ClientNIF}" />
                        </Border>

                        <Border Grid.Row="3"
                                Grid.Column="0"
                                Style="{StaticResource CellBorder}">
                            <TextBlock Style="{StaticResource LabelText}"
                                       Text="Contact" />
                        </Border>
                        <Border Grid.Row="3"
                                Grid.Column="1"
                                Style="{StaticResource CellBorder}">
                            <TextBlock Style="{StaticResource DataText}"
                                       Text="{Binding ClientContact}" />
                        </Border>

                        <Border Grid.Row="4"
                                Grid.Column="0"
                                Style="{StaticResource CellBorder}">
                            <TextBlock Style="{StaticResource LabelText}"
                                       Text="Adresse" />
                        </Border>
                        <Border Grid.Row="4"
                                Grid.Column="1"
                                Style="{StaticResource CellBorder}">
                            <TextBlock Style="{StaticResource DataText}"
                                       Text="{Binding ClientAddress}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!--  ═══════════════════════════════════════════════  -->
            <!--  ROW 5: OPERATOR  -->
            <!--  ═══════════════════════════════════════════════  -->
            <Border Padding="12,6"
                    BorderBrush="#333"
                    BorderThickness="0,0,0,1">
                <TextBlock FontFamily="Segoe UI"
                           FontSize="9">
                    <Run FontWeight="SemiBold"
                         Text="Opérateur :" />
                    <Run Text="{Binding OperatorName, Mode=OneWay}" />
                </TextBlock>
            </Border>

            <!--  ═══════════════════════════════════════════════  -->
            <!--  ROW 6: ARTICLE TABLE  -->
            <!--  ═══════════════════════════════════════════════  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="55" />
                    <ColumnDefinition Width="85" />
                </Grid.ColumnDefinitions>

                <!--  Header  -->
                <Border Grid.Column="0"
                        Background="#F0F0F0"
                        Style="{StaticResource CellBorder}">
                    <TextBlock HorizontalAlignment="Center"
                               Style="{StaticResource HeaderText}"
                               Text="#" />
                </Border>
                <Border Grid.Column="1"
                        Background="#F0F0F0"
                        Style="{StaticResource CellBorder}">
                    <TextBlock Style="{StaticResource HeaderText}"
                               Text="CODE" />
                </Border>
                <Border Grid.Column="2"
                        Background="#F0F0F0"
                        Style="{StaticResource CellBorder}">
                    <TextBlock Style="{StaticResource HeaderText}"
                               Text="Désignation" />
                </Border>
                <Border Grid.Column="3"
                        Background="#F0F0F0"
                        Style="{StaticResource CellBorder}">
                    <TextBlock HorizontalAlignment="Center"
                               Style="{StaticResource HeaderText}"
                               Text="" />
                </Border>
                <Border Grid.Column="4"
                        Background="#F0F0F0"
                        Style="{StaticResource CellBorder}">
                    <TextBlock HorizontalAlignment="Right"
                               Style="{StaticResource HeaderText}"
                               Text="PU HT" />
                </Border>
                <Border Grid.Column="5"
                        Background="#F0F0F0"
                        Style="{StaticResource CellBorder}">
                    <TextBlock HorizontalAlignment="Center"
                               Style="{StaticResource HeaderText}"
                               Text="TS" />
                </Border>
                <Border Grid.Column="6"
                        Background="#F0F0F0"
                        Style="{StaticResource CellBorder}">
                    <TextBlock HorizontalAlignment="Right"
                               Style="{StaticResource HeaderText}"
                               Text="QTE" />
                </Border>
                <Border Grid.Column="7"
                        Background="#F0F0F0"
                        Style="{StaticResource CellBorder}">
                    <TextBlock HorizontalAlignment="Right"
                               Style="{StaticResource HeaderText}"
                               Text="TOTAL HT" />
                </Border>
            </Grid>

            <!--  Article rows  -->
            <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="55" />
                                <ColumnDefinition Width="85" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource CellBorder}">
                                <TextBlock HorizontalAlignment="Center"
                                           Style="{StaticResource DataText}"
                                           Text="{Binding Number}" />
                            </Border>
                            <Border Grid.Column="1"
                                    Style="{StaticResource CellBorder}">
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           FontSize="8"
                                           Text="{Binding Code}" />
                            </Border>
                            <Border Grid.Column="2"
                                    Style="{StaticResource CellBorder}">
                                <TextBlock Style="{StaticResource DataText}"
                                           Text="{Binding Name}"
                                           TextWrapping="Wrap" />
                            </Border>
                            <Border Grid.Column="3"
                                    Style="{StaticResource CellBorder}">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           FontSize="8"
                                           Text="{Binding TaxGroupLabel}" />
                            </Border>
                            <Border Grid.Column="4"
                                    Style="{StaticResource CellBorder}">
                                <TextBlock HorizontalAlignment="Right"
                                           Style="{StaticResource DataText}"
                                           Text="{Binding UnitPriceHT, StringFormat=N2}" />
                            </Border>
                            <Border Grid.Column="5"
                                    Style="{StaticResource CellBorder}">
                                <TextBlock HorizontalAlignment="Center"
                                           Style="{StaticResource DataText}"
                                           Text="{Binding TaxSpecific}" />
                            </Border>
                            <Border Grid.Column="6"
                                    Style="{StaticResource CellBorder}">
                                <TextBlock HorizontalAlignment="Right"
                                           Style="{StaticResource DataText}"
                                           Text="{Binding Quantity, StringFormat=N3}" />
                            </Border>
                            <Border Grid.Column="7"
                                    Style="{StaticResource CellBorder}">
                                <TextBlock HorizontalAlignment="Right"
                                           FontWeight="SemiBold"
                                           Style="{StaticResource DataText}"
                                           Text="{Binding TotalHT, StringFormat=N2}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  ═══════════════════════════════════════════════  -->
            <!--  ROW 7: SUMMARY (Tax breakdown + Totals)  -->
            <!--  ═══════════════════════════════════════════════  -->
            <Border Padding="0"
                    BorderBrush="#333"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>

                    <!--  Tax breakdown (left)  -->
                    <Border Padding="12,8"
                            BorderBrush="#333"
                            BorderThickness="0,0,0.5,0">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,6"
                                       Style="{StaticResource LabelText}">
                                <Run Text="Nombre d'articles :   " />
                                <Run FontWeight="Bold"
                                     Text="{Binding LineCount, Mode=OneWay}" />
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding TaxBreakdown}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center"
                                                       FontFamily="Segoe UI"
                                                       FontSize="8.5"
                                                       Text="{Binding Label}" />
                                            <TextBlock Grid.Column="1"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe UI"
                                                       FontSize="8.5"
                                                       Text="{Binding Amount, StringFormat=N2}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!--  Totals (right)  -->
                    <Border Grid.Column="1"
                            Padding="12,8">
                        <StackPanel>
                            <!--  Exchange rate  -->
                            <Grid Margin="0,0,0,6"
                                  Visibility="{Binding HasExchangeRate, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource LabelText}"
                                           Text="Taux de change :" />
                                <TextBlock HorizontalAlignment="Right"
                                           FontWeight="Bold"
                                           Style="{StaticResource DataText}"
                                           Text="{Binding ExchangeRateDisplay}" />
                            </Grid>

                            <!--  Total TVA  -->
                            <Border Margin="0,0,0,4"
                                    Padding="0,4"
                                    BorderBrush="#333"
                                    BorderThickness="0,0,0,0.5">
                                <Grid>
                                    <TextBlock Style="{StaticResource LabelText}"
                                               Text="TOTAL TVA" />
                                    <TextBlock HorizontalAlignment="Right"
                                               FontWeight="Bold"
                                               Style="{StaticResource DataText}"
                                               Text="{Binding TotalTVA, StringFormat=N2}" />
                                </Grid>
                            </Border>

                            <!--  Total TTC CDF  -->
                            <Border Margin="0,0,0,4"
                                    Padding="8,6"
                                    Background="#F0F0F0">
                                <Grid>
                                    <TextBlock FontSize="10"
                                               Style="{StaticResource LabelText}"
                                               Text="Total TTC : CDF" />
                                    <TextBlock HorizontalAlignment="Right"
                                               FontFamily="Segoe UI"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Text="{Binding TotalTTC, StringFormat=N2}" />
                                </Grid>
                            </Border>

                            <!--  Montant TTC USD  -->
                            <Grid Visibility="{Binding HasExchangeRate, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource LabelText}"
                                           Text="Montant TTC USD" />
                                <TextBlock HorizontalAlignment="Right"
                                           FontWeight="Bold"
                                           Style="{StaticResource DataText}"
                                           Text="{Binding TotalTTCUsdDisplay}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!--  ═══════════════════════════════════════════════  -->
            <!--  ROW 8: AMOUNT IN WORDS  -->
            <!--  ═══════════════════════════════════════════════  -->
            <Border Padding="12,8"
                    BorderBrush="#333"
                    BorderThickness="0,1,0,1">
                <TextBlock FontFamily="Segoe UI"
                           FontSize="8.5"
                           FontStyle="Italic"
                           Text="{Binding AmountInWords}"
                           TextWrapping="Wrap" />
            </Border>

            <!--  ═══════════════════════════════════════════════  -->
            <!--  ROW 9: COMMENTS + PAYMENT TABLE  -->
            <!--  ═══════════════════════════════════════════════  -->
            <Grid MinHeight="80">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <!--  Comments  -->
                <Border Padding="12,8"
                        BorderBrush="#333"
                        BorderThickness="0,0,0.5,1">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,4"
                                   Style="{StaticResource LabelText}"
                                   Text="COMMENTAIRES" />
                        <Border MinHeight="50"
                                Padding="4"
                                BorderBrush="#999"
                                BorderThickness="1" />
                    </StackPanel>
                </Border>

                <!--  Payment table  -->
                <Border Grid.Column="1"
                        BorderBrush="#333"
                        BorderThickness="0,0,0,1">
                    <StackPanel>
                        <!--  Payment header  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <Border Background="#F0F0F0"
                                    Style="{StaticResource CellBorder}">
                                <TextBlock Style="{StaticResource HeaderText}"
                                           Text="MODE DE PAIEMENT" />
                            </Border>
                            <Border Grid.Column="1"
                                    Background="#F0F0F0"
                                    Style="{StaticResource CellBorder}">
                                <TextBlock HorizontalAlignment="Right"
                                           Style="{StaticResource HeaderText}"
                                           Text="MONTANT" />
                            </Border>
                        </Grid>

                        <!--  Payment rows  -->
                        <ItemsControl ItemsSource="{Binding Payments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource CellBorder}">
                                            <TextBlock VerticalAlignment="Center"
                                                       FontFamily="Segoe UI"
                                                       FontSize="9"
                                                       Text="{Binding Label}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTotal}"
                                                                         Value="True">
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <Border Grid.Column="1"
                                                Style="{StaticResource CellBorder}">
                                            <TextBlock HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe UI"
                                                       FontSize="9"
                                                       Text="{Binding Amount, StringFormat=N2}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTotal}"
                                                                         Value="True">
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!--  ═══════════════════════════════════════════════  -->
            <!--  ROW 10: SECURITY ELEMENTS + QR CODE  -->
            <!--  ═══════════════════════════════════════════════  -->
            <Border Padding="0"
                    Visibility="{Binding HasNormalization, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid MinHeight="120">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>

                    <!--  Security info + QR  -->
                    <Border Padding="12,10"
                            BorderBrush="#333"
                            BorderThickness="0,0,0.5,0">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,8"
                                       Style="{StaticResource LabelText}"
                                       Text="----ELEMENTS DE SECURITE DE LA FACTURE" />

                            <TextBlock Margin="0,0,0,4"
                                       FontFamily="Segoe UI"
                                       FontSize="8.5"
                                       FontWeight="Bold">
                                <Run Text="CODE DEF/DGI  " />
                                <Run FontWeight="Bold"
                                     Foreground="#1A365D"
                                     Text="{Binding CodeDEFDGI, Mode=OneWay}" />
                            </TextBlock>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  QR Code  -->
                                <Border Width="80"
                                        Height="80"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Top">
                                    <Grid>
                                        <!--  Fallback if no QR image  -->
                                        <Border Background="#F5F5F5"
                                                CornerRadius="4"
                                                Visibility="{Binding QrCodeImage, Converter={StaticResource NullToVisibilityConverter}}">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="#999"
                                                       Text="QR" />
                                        </Border>
                                        <Image RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               Source="{Binding QrCodeImage}"
                                               Stretch="Uniform" />
                                    </Grid>
                                </Border>

                                <!--  DEF details  -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Margin="0,0,0,3"
                                               FontFamily="Segoe UI"
                                               FontSize="8.5">
                                        <Run FontWeight="SemiBold"
                                             Text="DEF /NID   " />
                                        <Run Text="{Binding DefNid, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Margin="0,0,0,3"
                                               FontFamily="Segoe UI"
                                               FontSize="8.5">
                                        <Run FontWeight="SemiBold"
                                             Text="DEF Compteurs:   " />
                                        <Run Text="{Binding Counters, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock FontFamily="Segoe UI"
                                               FontSize="8.5">
                                        <Run FontWeight="SemiBold"
                                             Text="DEF Heure   " />
                                        <Run Text="{Binding NormalizedAtDisplay, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  Payment reference  -->
                    <Border Grid.Column="1"
                            Padding="12,10">
                        <TextBlock VerticalAlignment="Top"
                                   FontFamily="Segoe UI"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Text="PAYEMENT CASH A LA COMMANDE" />
                    </Border>
                </Grid>
            </Border>

        </StackPanel>
    </Border>
</UserControl>