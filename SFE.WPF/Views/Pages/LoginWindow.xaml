<Window x:Class="SFE.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SFE.WPF.ViewModels"
        Title="iKWOOK SFE"
        Width="900"
        Height="600"
        d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />

        <!--  ══════════ TEXTBOX (with icon support) ══════════  -->
        <Style x:Key="LoginTextBox"
               TargetType="TextBox">
            <Setter Property="Background" Value="#0A1E2E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="BdBrush"
                                                 Color="#1A3D55" />
                            </Border.BorderBrush>
                            <Border.BorderThickness>
                                <Thickness>1.5</Thickness>
                            </Border.BorderThickness>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="2,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="GotFocus">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#37B1E4"
                                                        Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="LostFocus">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#1A3D55"
                                                        Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#2A6080"
                                                        Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#1A3D55"
                                                        Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ══════════ PASSWORDBOX ══════════  -->
        <Style x:Key="LoginPasswordBox"
               TargetType="PasswordBox">
            <Setter Property="Background" Value="#0A1E2E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="BdBrush"
                                                 Color="#1A3D55" />
                            </Border.BorderBrush>
                            <Border.BorderThickness>
                                <Thickness>1.5</Thickness>
                            </Border.BorderThickness>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="2,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="GotFocus">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#37B1E4"
                                                        Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="LostFocus">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#1A3D55"
                                                        Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#2A6080"
                                                        Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#1A3D55"
                                                        Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ══════════ LOGIN BUTTON (gradient + animation) ══════════  -->
        <Style x:Key="LoginButton"
               TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Padding="0,14"
                                CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush x:Name="BdGrad" StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="G0" Offset="0" Color="#37B1E4" />
                                    <GradientStop x:Name="G1" Offset="1" Color="#1A8CBF" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14"
                                                  Opacity="0.3"
                                                  ShadowDepth="3"
                                                  Color="#37B1E4" />
                            </Border.Effect>
                            <StackPanel HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                <materialDesign:PackIcon x:Name="BtnIcon"
                                                         Width="20"
                                                         Height="20"
                                                         Margin="0,0,10,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="White"
                                                         Kind="LoginVariant" />
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           Foreground="{TemplateBinding Foreground}"
                                           Text="{TemplateBinding Content}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#2DA0D3"
                                                        Duration="0:0:0.2" />
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#1579A8"
                                                        Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#37B1E4"
                                                        Duration="0:0:0.25" />
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#1A8CBF"
                                                        Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#1A3D55" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="Effect" Value="{x:Null}" />
                                <Setter Property="Foreground" Value="#4A6B7C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ══════════ FEATURE BULLET (left panel) ══════════  -->
        <Style x:Key="FeatureBullet"
               TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </Window.Resources>

    <!--  ═══ Outer frame (rounded window with shadow) ═══  -->
    <Border Margin="12"
            ClipToBounds="True"
            CornerRadius="16">
        <Border.Background>
            <SolidColorBrush Color="#0D2B3E" />
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30"
                              Opacity="0.5"
                              ShadowDepth="2"
                              Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
                ╔══════════════════════════════════════════════╗
                ║   LEFT PANEL — BRANDING / LOGO / IMAGERY     ║
                ╚══════════════════════════════════════════════╝
            -->
            <Grid Grid.Column="0">
                <!--  Base gradient (visible if no image is set)  -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#0A1E2E" />
                            <GradientStop Offset="0.55" Color="#123A52" />
                            <GradientStop Offset="1" Color="#0A1E2E" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!--
                    ┌────────────────────────────────────────┐
                    │  ►► SLOT 1 : BACKGROUND IMAGE          │
                    │  Drop your image in Assets/ and set    │
                    │  Build Action = Resource.              │
                    │  Uncomment to activate.                │
                    └────────────────────────────────────────┘
                -->
                <!--
                <Image Source="/Assets/login-bg.jpg"
                       Stretch="UniformToFill"
                       Opacity="0.35"/>
                -->

                <!--  Dark scrim so text stays legible over any image  -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#CC0A1E2E" />
                            <GradientStop Offset="0.5" Color="#990A1E2E" />
                            <GradientStop Offset="1" Color="#E60A1E2E" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!--  Subtle decorative glow  -->
                <Ellipse Width="320"
                         Height="320"
                         Margin="-120,0,0,-140"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         Opacity="0.18">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#37B1E4" />
                            <GradientStop Offset="1" Color="#0037B1E4" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!--  Branding content  -->
                <StackPanel Margin="48,0"
                            VerticalAlignment="Center">

                    <!-- ┌────────────────────────────────────┐
                         │  ►► SLOT 2 : COMPANY LOGO          │
                         │  White card sized for a real logo. │
                         │  Replace the PackIcon+TextBlock    │
                         │  below with your <Image/>.         │
                         └────────────────────────────────────┘-->
                    <Border x:Name="LogoContainer"
                            Width="200"
                            Height="90"
                            Margin="0,0,0,32"
                            Padding="16"
                            HorizontalAlignment="Left"
                            CornerRadius="14">
                        <Border.Background>
                            <SolidColorBrush Opacity="0.95"
                                             Color="#FFFFFF" />
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20"
                                              Opacity="0.35"
                                              ShadowDepth="4"
                                              Color="#000000" />
                        </Border.Effect>

                        <Image Source="/Resources/Images/ISFE.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <!--  Tagline  -->
                    <TextBlock FontFamily="{StaticResource AppFont}"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="White"
                               LineHeight="34"
                               Text="Système de Facturation Électronique"
                               TextWrapping="Wrap" />

                    <TextBlock Margin="0,12,0,36"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="13"
                               Foreground="#7CAFC8"
                               LineHeight="21"
                               Text="Gérez vos factures en toute conformité avec la réglementation fiscale."
                               TextWrapping="Wrap" />

                    <!--  Feature bullets  -->
                    <StackPanel Style="{StaticResource FeatureBullet}">
                        <materialDesign:PackIcon Width="18"
                                                 Height="18"
                                                 Margin="0,0,12,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="#37B1E4"
                                                 Kind="CheckDecagram" />
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="13"
                                   Foreground="#B8D4E3"
                                   Text="Certification DGI-RDC" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource FeatureBullet}">
                        <materialDesign:PackIcon Width="18"
                                                 Height="18"
                                                 Margin="0,0,12,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="#37B1E4"
                                                 Kind="LightningBolt" />
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="13"
                                   Foreground="#B8D4E3"
                                   Text="Facturation en masse" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource FeatureBullet}">
                        <materialDesign:PackIcon Width="18"
                                                 Height="18"
                                                 Margin="0,0,12,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="#37B1E4"
                                                 Kind="ShieldLock" />
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="13"
                                   Foreground="#B8D4E3"
                                   Text="Données sécurisées" />
                    </StackPanel>
                </StackPanel>

                <!--  Left panel footer  -->
                <StackPanel Margin="48,0,0,32"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal">
                    <materialDesign:PackIcon Width="13"
                                             Height="13"
                                             Margin="0,0,5,0"
                                             VerticalAlignment="Center"
                                             Foreground="#4A6B7C"
                                             Kind="Copyright" />
                    <TextBlock VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="11"
                               Foreground="#4A6B7C"
                               Text="2026 iKWOOK · Tous droits réservés" />
                </StackPanel>
            </Grid>

            <!--  Vertical divider  -->
            <Border Grid.Column="1"
                    Width="1"
                    HorizontalAlignment="Left">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#001A3D55" />
                        <GradientStop Offset="0.5" Color="#1A3D55" />
                        <GradientStop Offset="1" Color="#001A3D55" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!--
                ╔══════════════════════════════════════════════╗
                ║          RIGHT PANEL — LOGIN FORM            ║
                ╚══════════════════════════════════════════════╝
            -->
            <Grid Grid.Column="1">

                <!--  Decorative top gradient bar  -->
                <Border Height="4"
                        VerticalAlignment="Top"
                        CornerRadius="0,16,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#37B1E4" />
                            <GradientStop Offset="0.5" Color="#1A8CBF" />
                            <GradientStop Offset="1" Color="#FD4D4D" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!--  Close button  -->
                <Button Width="34"
                        Height="34"
                        Margin="0,12,12,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="CloseButton_Click"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    CornerRadius="8">
                                <Border.Background>
                                    <SolidColorBrush x:Name="BdBg"
                                                     Color="#00FFFFFF" />
                                </Border.Background>
                                <materialDesign:PackIcon Width="18"
                                                         Height="18"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="#4A6B7C"
                                                         Kind="Close" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BdBg"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#1AFFFFFF"
                                                            Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BdBg"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#00FFFFFF"
                                                            Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!--  Form  -->
                <StackPanel Margin="56,0"
                            VerticalAlignment="Center">

                    <TextBlock FontFamily="{StaticResource AppFont}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="Bienvenue" />
                    <TextBlock Margin="0,6,0,34"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="13"
                               Foreground="#4A6B7C"
                               Text="Connectez-vous pour continuer" />

                    <!--  ═══ USERNAME ═══  -->
                    <StackPanel Margin="0,0,0,8"
                                Orientation="Horizontal">
                        <materialDesign:PackIcon Width="14"
                                                 Height="14"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="#7CAFC8"
                                                 Kind="AccountOutline" />
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#7CAFC8"
                                   Text="NOM D'UTILISATEUR" />
                    </StackPanel>
                    <Grid>
                        <TextBox x:Name="UsernameBox"
                                 Padding="42,12,14,12"
                                 KeyDown="InputField_KeyDown"
                                 Style="{StaticResource LoginTextBox}"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                        <materialDesign:PackIcon Width="20"
                                                 Height="20"
                                                 Margin="14,0,0,0"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"
                                                 Foreground="#4A6B7C"
                                                 IsHitTestVisible="False"
                                                 Kind="AccountCircleOutline" />
                    </Grid>

                    <!--  ═══ PASSWORD ═══  -->
                    <StackPanel Margin="0,20,0,8"
                                Orientation="Horizontal">
                        <materialDesign:PackIcon Width="14"
                                                 Height="14"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="#7CAFC8"
                                                 Kind="LockOutline" />
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#7CAFC8"
                                   Text="MOT DE PASSE" />
                    </StackPanel>
                    <Grid>
                        <PasswordBox x:Name="PasswordBox"
                                     Padding="42,12,14,12"
                                     KeyDown="PasswordBox_KeyDown"
                                     Style="{StaticResource LoginPasswordBox}" />
                        <materialDesign:PackIcon Width="20"
                                                 Height="20"
                                                 Margin="14,0,0,0"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"
                                                 Foreground="#4A6B7C"
                                                 IsHitTestVisible="False"
                                                 Kind="ShieldLockOutline" />
                    </Grid>

                    <!--  ═══ ERROR MESSAGE ═══  -->
                    <Border Margin="0,16,0,0"
                            Padding="12,10"
                            CornerRadius="8"
                            Visibility="{Binding HasError, Converter={StaticResource B2V}}">
                        <Border.Background>
                            <SolidColorBrush Opacity="0.1"
                                             Color="#FD0F0F" />
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="16"
                                                     Height="16"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="#FD4D4D"
                                                     Kind="AlertCircleOutline" />
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="12"
                                       Foreground="#FD4D4D"
                                       Text="{Binding ErrorMessage}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!--  ═══ LOGIN BUTTON ═══  -->
                    <Button Margin="0,24,0,0"
                            Click="LoginButton_Click"
                            Content="Se connecter"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                            Style="{StaticResource LoginButton}" />

                    <!--  ═══ LOADING INDICATOR ═══  -->
                    <StackPanel Margin="0,16,0,0"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{Binding IsLoading, Converter={StaticResource B2V}}">
                        <materialDesign:PackIcon Width="16"
                                                 Height="16"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="#37B1E4"
                                                 Kind="Loading">
                            <materialDesign:PackIcon.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotation" CenterX="8" CenterY="8" />
                            </materialDesign:PackIcon.RenderTransform>
                            <materialDesign:PackIcon.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0"
                                                             To="360"
                                                             Duration="0:0:1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </materialDesign:PackIcon.Triggers>
                        </materialDesign:PackIcon>
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="12"
                                   Foreground="#7CAFC8"
                                   Text="Connexion en cours..." />
                    </StackPanel>
                </StackPanel>

                <!--  Right panel footer  -->
                <StackPanel Margin="0,0,0,28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal">
                    <materialDesign:PackIcon Width="13"
                                             Height="13"
                                             Margin="0,0,5,0"
                                             VerticalAlignment="Center"
                                             Foreground="#1A3D55"
                                             Kind="ShieldCheckOutline" />
                    <TextBlock VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="11"
                               Foreground="#1A3D55"
                               Text="SFE v2.0 · Conforme DGI-RDC" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>