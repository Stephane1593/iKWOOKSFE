<Window x:Class="SFE.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SFE.WPF.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="iKWOOK SFE"
        Width="460" Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <!-- ══════════ TEXTBOX (with icon support) ══════════ -->
        <Style x:Key="LoginTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0A1E2E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="BdBrush" Color="#1A3D55"/>
                            </Border.BorderBrush>
                            <Border.BorderThickness>
                                <Thickness>1.5</Thickness>
                            </Border.BorderThickness>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Smooth border color on focus -->
                            <EventTrigger RoutedEvent="GotFocus">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#37B1E4" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="LostFocus">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#1A3D55" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#2A6080" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#1A3D55" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ PASSWORDBOX ══════════ -->
        <Style x:Key="LoginPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#0A1E2E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="BdBrush" Color="#1A3D55"/>
                            </Border.BorderBrush>
                            <Border.BorderThickness>
                                <Thickness>1.5</Thickness>
                            </Border.BorderThickness>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="GotFocus">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#37B1E4" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="LostFocus">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#1A3D55" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#2A6080" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#1A3D55" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ LOGIN BUTTON (gradient + animation) ══════════ -->
        <Style x:Key="LoginButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="0,14">
                            <Border.Background>
                                <LinearGradientBrush x:Name="BdGrad" StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="G0" Color="#37B1E4" Offset="0"/>
                                    <GradientStop x:Name="G1" Color="#1A8CBF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="3" BlurRadius="14"
                                                  Opacity="0.3" Color="#37B1E4"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon x:Name="BtnIcon"
                                    Kind="LoginVariant" Width="20" Height="20"
                                    Foreground="White" Margin="0,0,10,0"
                                    VerticalAlignment="Center"/>
                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#2DA0D3" Duration="0:0:0.2"/>
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#1579A8" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#37B1E4" Duration="0:0:0.25"/>
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#1A8CBF" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#1A3D55"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="Effect" Value="{x:Null}"/>
                                <Setter Property="Foreground" Value="#4A6B7C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ═══ Outer frame (rounded window with shadow) ═══ -->
    <Border CornerRadius="16" Margin="12">
        <Border.Background>
            <SolidColorBrush Color="#0D2B3E"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="2"
                              Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <!-- ═══ Decorative top gradient bar ═══ -->
            <Border CornerRadius="16,16,0,0" Height="4" VerticalAlignment="Top">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#37B1E4" Offset="0"/>
                        <GradientStop Color="#1A8CBF" Offset="0.5"/>
                        <GradientStop Color="#FD4D4D" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- ═══ Close button ═══ -->
            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,12,12,0" Width="34" Height="34"
                    Cursor="Hand" Click="CloseButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="#00FFFFFF"/>
                            </Border.Background>
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18"
                                                     Foreground="#4A6B7C"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#1AFFFFFF" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#00FFFFFF" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- ═══════════════ LOGIN FORM ═══════════════ -->
            <StackPanel VerticalAlignment="Center" Margin="52,0">

                <!-- ── Logo (gradient pill + icon) ── -->
                <Border CornerRadius="16" Width="160" Height="64"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#37B1E4" Offset="0"/>
                            <GradientStop Color="#1A8CBF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="3" BlurRadius="18"
                                          Opacity="0.35" Color="#37B1E4"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CubeOutline" Width="24" Height="24"
                                                 Foreground="White" Margin="0,0,8,0"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="iKWOOK SFE" Foreground="White" FontSize="18"
                                   FontWeight="Bold" VerticalAlignment="Center"
                                   FontFamily="{StaticResource AppFont}"/>
                    </StackPanel>
                </Border>

                <!-- ── Titles ── -->
                <TextBlock Text="Système de Facturation" Foreground="White"
                           FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource AppFont}"/>
                <TextBlock Text="Connectez-vous pour continuer" Foreground="#4A6B7C"
                           FontSize="13" HorizontalAlignment="Center"
                           Margin="0,4,0,36"
                           FontFamily="{StaticResource AppFont}"/>

                <!-- ═══ USERNAME ═══ -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <materialDesign:PackIcon Kind="AccountOutline" Width="14" Height="14"
                                             Foreground="#7CAFC8" Margin="0,0,6,0"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="NOM D'UTILISATEUR" Foreground="#7CAFC8"
                               FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFont}"/>
                </StackPanel>
                <!-- Input with icon -->
                <Grid>
                    <TextBox x:Name="UsernameBox"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource LoginTextBox}"
                             Padding="42,12,14,12"
                             KeyDown="InputField_KeyDown"/>
                    <materialDesign:PackIcon Kind="AccountCircleOutline"
                                             Width="20" Height="20"
                                             Foreground="#4A6B7C"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Left"
                                             Margin="14,0,0,0"
                                             IsHitTestVisible="False"/>
                </Grid>

                <!-- ═══ PASSWORD ═══ -->
                <StackPanel Orientation="Horizontal" Margin="0,20,0,8">
                    <materialDesign:PackIcon Kind="LockOutline" Width="14" Height="14"
                                             Foreground="#7CAFC8" Margin="0,0,6,0"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="MOT DE PASSE" Foreground="#7CAFC8"
                               FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFont}"/>
                </StackPanel>
                <Grid>
                    <PasswordBox x:Name="PasswordBox"
                                 Style="{StaticResource LoginPasswordBox}"
                                 Padding="42,12,14,12"
                                 KeyDown="PasswordBox_KeyDown"/>
                    <materialDesign:PackIcon Kind="ShieldLockOutline"
                                             Width="20" Height="20"
                                             Foreground="#4A6B7C"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Left"
                                             Margin="14,0,0,0"
                                             IsHitTestVisible="False"/>
                </Grid>

                <!-- ═══ ERROR MESSAGE ═══ -->
                <Border Margin="0,16,0,0" CornerRadius="8" Padding="12,10"
                        Visibility="{Binding HasError, Converter={StaticResource B2V}}">
                    <Border.Background>
                        <SolidColorBrush Color="#FD0F0F" Opacity="0.1"/>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertCircleOutline"
                                                 Width="16" Height="16"
                                                 Foreground="#FD4D4D"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#FD4D4D" FontSize="12"
                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                   FontFamily="{StaticResource AppFont}"/>
                    </StackPanel>
                </Border>

                <!-- ═══ LOGIN BUTTON ═══ -->
                <Button Content="Se connecter"
                        Style="{StaticResource LoginButton}"
                        Margin="0,24,0,0"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        Click="LoginButton_Click"/>

                <!-- ═══ LOADING INDICATOR ═══ -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,16,0,0"
                            Visibility="{Binding IsLoading, Converter={StaticResource B2V}}">
                    <materialDesign:PackIcon Kind="Loading" Width="16" Height="16"
                                             Foreground="#37B1E4" Margin="0,0,8,0"
                                             VerticalAlignment="Center">
                        <materialDesign:PackIcon.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotation" CenterX="8" CenterY="8"/>
                        </materialDesign:PackIcon.RenderTransform>
                        <materialDesign:PackIcon.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360"
                                                         Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </materialDesign:PackIcon.Triggers>
                    </materialDesign:PackIcon>
                    <TextBlock Text="Connexion en cours..."
                               Foreground="#7CAFC8" FontSize="12"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFont}"/>
                </StackPanel>

                <!-- ═══ FOOTER ═══ -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,40,0,0">
                    <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="13" Height="13"
                                             Foreground="#1A3D55" Margin="0,0,5,0"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="SFE v2.0 · Conforme DGI-RDC"
                               Foreground="#1A3D55" FontSize="11"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFont}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>