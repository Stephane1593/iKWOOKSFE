<UserControl x:Class="SFE.WPF.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:converters="clr-namespace:SFE.WPF.Converters"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <converters:StringToBrushConverter x:Key="StringToBrush"/>

        <!-- ═══ RECLAIM CUSTOM SCROLLBAR (MaterialDesign overrides implicit) ═══ -->
        <Style TargetType="ScrollBar"
               BasedOn="{StaticResource ThinScrollBarStyle}"/>
        <Style TargetType="ScrollViewer"
               BasedOn="{StaticResource FadeScrollViewerStyle}"/>
    </UserControl.Resources>

    <Grid>
        <!-- ═══ LOADING OVERLAY ═══ -->
        <Border Background="#80F4F9FC" Panel.ZIndex="10"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="160"
                             Style="{StaticResource MaterialDesignLinearProgressBar}"
                             Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="Chargement du tableau de bord…"
                           FontFamily="{StaticResource AppFont}" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,12,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ═══ MAIN SCROLLABLE CONTENT ═══ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">
            <StackPanel MaxWidth="1400" Margin="32,24,32,32">

                <!-- ══════════ HEADER ══════════ -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Tableau de bord" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Vue d'ensemble de votre activité commerciale"
                                   Style="{StaticResource PageSubtitleStyle}" Margin="0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            VerticalAlignment="Center" Padding="16,10">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16"
                                                     Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Actualiser" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ══════════ KPI CARDS ══════════ -->
                <UniformGrid Columns="4" Margin="0,0,0,20">

                    <!-- Ventes du jour -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#E1F3FB" CornerRadius="10"
                                    Padding="10" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="CashMultiple" Width="20" Height="20"
                                                         Foreground="{StaticResource PrimaryBrush}"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="{Binding TodaySalesAmount}"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="2" Text="Ventes du jour"
                                       FontFamily="{StaticResource AppFont}" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="3" Text="{Binding SalesTrend}"
                                       FontFamily="{StaticResource AppFont}" FontSize="12"
                                       FontWeight="SemiBold" Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#EF4444"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SalesTrendPositive}" Value="True">
                                                <Setter Property="Foreground" Value="#10B981"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Factures -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#FDF2F8" CornerRadius="10"
                                    Padding="10" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="ReceiptTextOutline" Width="20" Height="20"
                                                         Foreground="{StaticResource AccentBrush}"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="{Binding TodayInvoiceCount}"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="2" Text="Factures aujourd'hui"
                                       FontFamily="{StaticResource AppFont}" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="3" FontFamily="{StaticResource AppFont}"
                                       FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,6,0,0">
                                <Run Text="{Binding MonthInvoiceCount, Mode=OneWay}"/>
                                <Run Text=" ce mois"/>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Clients fidélité -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#ECFDF5" CornerRadius="10"
                                    Padding="10" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="AccountHeartOutline" Width="20" Height="20"
                                                         Foreground="{StaticResource SuccessBrush}"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="{Binding LoyaltyMemberCount}"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="2" Text="Clients fidélité"
                                       FontFamily="{StaticResource AppFont}" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Alertes stock -->
                    <Border Style="{StaticResource CardStyle}" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#FEF2F2" CornerRadius="10"
                                    Padding="10" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="AlertOutline" Width="20" Height="20"
                                                         Foreground="#EF4444"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="{Binding LowStockAlerts}"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="24" FontWeight="Bold" Foreground="#EF4444"/>
                            <TextBlock Grid.Row="2" Text="Alertes stock"
                                       FontFamily="{StaticResource AppFont}" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- ══════════ SUMMARY CHIPS ══════════ -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardCompactStyle}" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#EFF6FF" CornerRadius="8" Padding="8" Margin="0,0,14,0">
                                <materialDesign:PackIcon Kind="CalendarWeek" Width="18" Height="18"
                                                         Foreground="#2563EB"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Ventes de la semaine"
                                           FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding WeekSalesAmount}"
                                           FontFamily="{StaticResource AppFont}" FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardCompactStyle}" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#ECFDF5" CornerRadius="8" Padding="8" Margin="0,0,14,0">
                                <materialDesign:PackIcon Kind="CalendarMonth" Width="18" Height="18"
                                                         Foreground="#059669"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Ventes du mois"
                                           FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding MonthSalesAmount}"
                                           FontFamily="{StaticResource AppFont}" FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ══════════ ROW 1: Sales Chart + Payments ══════════ -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sales chart -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0">
                        <Grid>
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Évolution des ventes"
                                               Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                                    <TextBlock Text="7 derniers jours" HorizontalAlignment="Right"
                                               FontFamily="{StaticResource AppFont}" FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Chart visible only when data exists -->
                                <lvc:CartesianChart
                                    Series="{Binding SalesSeries}"
                                    XAxes="{Binding SalesXAxes}"
                                    YAxes="{Binding SalesYAxes}"
                                    Height="260"
                                    TooltipPosition="Top"
                                    AnimationsSpeed="0:0:0.3"
                                    ZoomMode="None">
                                    <lvc:CartesianChart.Style>
                                        <Style TargetType="lvc:CartesianChart">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSalesData}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </lvc:CartesianChart.Style>
                                </lvc:CartesianChart>
                            </StackPanel>

                            <!-- Empty state overlay -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Margin="0,40,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSalesData}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Background="#F0F9FF" CornerRadius="50"
                                        Width="64" Height="64" Margin="0,0,0,14"
                                        HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ChartBar" Width="28" Height="28"
                                                             Foreground="#93C5FD"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Aucune vente cette semaine"
                                           FontFamily="{StaticResource AppFont}" FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Les données apparaîtront ici dès la première facture normalisée"
                                           FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"
                                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Payment pie -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Modes de paiement"
                                           Style="{StaticResource SectionTitleStyle}"/>
                                <lvc:PieChart
                                    Series="{Binding PaymentSeries}"
                                    Height="260"
                                    LegendPosition="Bottom"
                                    InitialRotation="-90"
                                    AnimationsSpeed="0:0:0.3">
                                    <lvc:PieChart.Style>
                                        <Style TargetType="lvc:PieChart">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasPaymentData}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </lvc:PieChart.Style>
                                </lvc:PieChart>
                            </StackPanel>

                            <!-- Empty state -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Margin="0,40,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPaymentData}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Background="#F0FDF4" CornerRadius="50"
                                        Width="56" Height="56" Margin="0,0,0,12"
                                        HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CreditCardOutline" Width="24" Height="24"
                                                             Foreground="#86EFAC"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Aucun paiement"
                                           FontFamily="{StaticResource AppFont}" FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Les modes de paiement apparaîtront ici"
                                           FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ══════════ ROW 2: Invoice Types + Top Products ══════════ -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Invoice types donut -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0">
                        <Grid>
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Types de factures"
                                               Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                                    <TextBlock Text="Ce mois" HorizontalAlignment="Right"
                                               FontFamily="{StaticResource AppFont}" FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <lvc:PieChart
                                    Series="{Binding InvoiceTypeSeries}"
                                    Height="240"
                                    LegendPosition="Bottom"
                                    InitialRotation="-90"
                                    AnimationsSpeed="0:0:0.3">
                                    <lvc:PieChart.Style>
                                        <Style TargetType="lvc:PieChart">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasInvoiceTypeData}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </lvc:PieChart.Style>
                                </lvc:PieChart>
                            </StackPanel>

                            <!-- Empty state -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Margin="0,40,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasInvoiceTypeData}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Background="#F5F3FF" CornerRadius="50"
                                        Width="56" Height="56" Margin="0,0,0,12"
                                        HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="FileDocumentOutline" Width="24" Height="24"
                                                             Foreground="#C4B5FD"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Aucune facture"
                                           FontFamily="{StaticResource AppFont}" FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="La répartition apparaîtra ici"
                                           FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Top products -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0">
                        <Grid>
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Top 5 Produits"
                                               Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                                    <TextBlock Text="30 derniers jours" HorizontalAlignment="Right"
                                               FontFamily="{StaticResource AppFont}" FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <lvc:CartesianChart
                                    Series="{Binding TopProductsSeries}"
                                    XAxes="{Binding TopProductsXAxes}"
                                    YAxes="{Binding TopProductsYAxes}"
                                    Height="240"
                                    TooltipPosition="Top"
                                    AnimationsSpeed="0:0:0.3"
                                    ZoomMode="None">
                                    <lvc:CartesianChart.Style>
                                        <Style TargetType="lvc:CartesianChart">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasTopProductsData}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </lvc:CartesianChart.Style>
                                </lvc:CartesianChart>
                            </StackPanel>

                            <!-- Empty state -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Margin="0,40,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasTopProductsData}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Background="#FFF7ED" CornerRadius="50"
                                        Width="56" Height="56" Margin="0,0,0,12"
                                        HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="PackageVariantClosed" Width="24" Height="24"
                                                             Foreground="#FDBA74"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Aucun produit vendu"
                                           FontFamily="{StaticResource AppFont}" FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Le classement apparaîtra après les premières ventes"
                                           FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"
                                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="250"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ══════════ RECENT ACTIVITY ══════════ -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Activité récente"
                                       Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                            <TextBlock Text="10 dernières factures" HorizontalAlignment="Right"
                                       FontFamily="{StaticResource AppFont}" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Table header -->
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="16,10" Margin="0,0,0,4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRecentData}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="DATE"
                                           FontFamily="{StaticResource AppFont}" FontSize="11"
                                           FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="1" Text="N° FACTURE"
                                           FontFamily="{StaticResource AppFont}" FontSize="11"
                                           FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="2" Text="CLIENT"
                                           FontFamily="{StaticResource AppFont}" FontSize="11"
                                           FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="3" Text="TYPE"
                                           FontFamily="{StaticResource AppFont}" FontSize="11"
                                           FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="MONTANT"
                                           FontFamily="{StaticResource AppFont}" FontSize="11"
                                           FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Rows -->
                        <ItemsControl ItemsSource="{Binding RecentInvoices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16,12" BorderThickness="0,0,0,1"
                                            BorderBrush="{StaticResource BorderLightBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="140"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding FormattedDate}"
                                                       FontFamily="{StaticResource AppFont}" FontSize="13"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding InvoiceNumber}"
                                                       FontFamily="{StaticResource AppFont}" FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ClientName}"
                                                       FontFamily="{StaticResource AppFont}" FontSize="13"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="3" CornerRadius="6"
                                                    Padding="10,4" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding TypeBgColor,
                                                        Converter={StaticResource StringToBrush}}">
                                                <TextBlock Text="{Binding TypeLabel}"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="11" FontWeight="Bold"
                                                           Foreground="{Binding TypeColor,
                                                               Converter={StaticResource StringToBrush}}"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="4" Text="{Binding FormattedAmount}"
                                                       FontFamily="{StaticResource AppFont}" FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state for recent activity -->
                        <StackPanel Margin="0,30,0,30" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRecentData}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Background="#F0F9FF" CornerRadius="50"
                                    Width="64" Height="64" Margin="0,0,0,14"
                                    HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="ReceiptTextClockOutline" Width="28" Height="28"
                                                         Foreground="#93C5FD"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Aucune facture récente"
                                       FontFamily="{StaticResource AppFont}" FontSize="14"
                                       FontWeight="SemiBold"
