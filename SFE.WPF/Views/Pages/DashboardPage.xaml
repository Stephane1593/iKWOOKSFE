<UserControl x:Class="SFE.WPF.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SFE.WPF.Converters"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
        <converters:StringToBrushConverter x:Key="StringToBrush" />

        <!--  ═══ RECLAIM CUSTOM SCROLLBAR (MaterialDesign overrides implicit) ═══  -->
        <Style BasedOn="{StaticResource ThinScrollBarStyle}"
               TargetType="ScrollBar" />
        <Style BasedOn="{StaticResource FadeScrollViewerStyle}"
               TargetType="ScrollViewer" />
    </UserControl.Resources>

    <Grid>
        <!--  ═══ LOADING OVERLAY ═══  -->
        <Border Panel.ZIndex="10"
                Background="#80F4F9FC"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ProgressBar Width="160"
                             Foreground="{StaticResource PrimaryBrush}"
                             IsIndeterminate="True"
                             Style="{StaticResource MaterialDesignLinearProgressBar}" />
                <TextBlock Margin="0,12,0,0"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Chargement du tableau de bord…" />
            </StackPanel>
        </Border>

        <!--  ═══ MAIN SCROLLABLE CONTENT ═══  -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1400"
                        Margin="32,24,32,32">

                <!--  ══════════ HEADER ══════════  -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource PageTitleStyle}"
                                   Text="Tableau de bord" />
                        <TextBlock Margin="0"
                                   Style="{StaticResource PageSubtitleStyle}"
                                   Text="Vue d'ensemble de votre activité commerciale" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Padding="16,10"
                            VerticalAlignment="Center"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="16"
                                                     Height="16"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Kind="Refresh" />
                            <TextBlock VerticalAlignment="Center"
                                       Text="Actualiser" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!--  ══════════ WELCOME BANNER (NEW) ══════════  -->
                <Border Margin="0,0,0,20"
                        Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Greeting icon  -->
                        <Border Grid.Column="0"
                                Width="56"
                                Height="56"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center"
                                Background="#E1F3FB"
                                CornerRadius="14">
                            <materialDesign:PackIcon Width="28"
                                                     Height="28"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     Kind="{Binding GreetingIconKey}" />
                        </Border>

                        <!--  Greeting text + date  -->
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{Binding GreetingText}" />
                                <TextBlock Margin="4,0"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="20"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text=" · " />
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding FullDateLabel}" />
                            </StackPanel>
                            <TextBlock Margin="0,2,0,0"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="{Binding GreetingSubtext}" />
                        </StackPanel>

                        <!--  Fiscal countdown chip  -->
                        <Border Grid.Column="2"
                                Padding="14,10"
                                VerticalAlignment="Center"
                                Background="#FFFBEB"
                                CornerRadius="10">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="18"
                                                         Height="18"
                                                         Margin="0,0,10,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="#D97706"
                                                         Kind="CalendarAlert" />
                                <StackPanel>
                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#D97706">
                                        <Run Text="Clôture mensuelle · " />
                                        <Run Text="{Binding MonthEndLabel, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Margin="0,2,0,0"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="{Binding FiscalReminder}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>


                <!--  ══════════ KPI CARDS ══════════  -->
                <UniformGrid Margin="0,0,0,20"
                             Columns="4">

                    <!--  Ventes du jour  -->
                    <Border Margin="0,0,16,0"
                            Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Margin="0,0,0,12"
                                    Padding="10"
                                    HorizontalAlignment="Left"
                                    Background="#E1F3FB"
                                    CornerRadius="10">
                                <materialDesign:PackIcon Width="20"
                                                         Height="20"
                                                         Foreground="{StaticResource PrimaryBrush}"
                                                         Kind="CashMultiple" />
                            </Border>
                            <TextBlock Grid.Row="1"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding TodaySalesAmount}" />
                            <TextBlock Grid.Row="2"
                                       Margin="0,4,0,0"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Ventes du jour" />
                            <TextBlock Grid.Row="3"
                                       Margin="0,6,0,0"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Text="{Binding SalesTrend}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#EF4444" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SalesTrendPositive}"
                                                         Value="True">
                                                <Setter Property="Foreground" Value="#10B981" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!--  Factures  -->
                    <Border Margin="0,0,16,0"
                            Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Margin="0,0,0,12"
                                    Padding="10"
                                    HorizontalAlignment="Left"
                                    Background="#FDF2F8"
                                    CornerRadius="10">
                                <materialDesign:PackIcon Width="20"
                                                         Height="20"
                                                         Foreground="{StaticResource AccentBrush}"
                                                         Kind="ReceiptTextOutline" />
                            </Border>
                            <TextBlock Grid.Row="1"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding TodayInvoiceCount}" />
                            <TextBlock Grid.Row="2"
                                       Margin="0,4,0,0"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Factures aujourd'hui" />
                            <TextBlock Grid.Row="3"
                                       Margin="0,6,0,0"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}">
                                <Run Text="{Binding MonthInvoiceCount, Mode=OneWay}" />
                                <Run Text=" ce mois" />
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!--  Clients fidélité  -->
                    <Border Margin="0,0,16,0"
                            Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Margin="0,0,0,12"
                                    Padding="10"
                                    HorizontalAlignment="Left"
                                    Background="#ECFDF5"
                                    CornerRadius="10">
                                <materialDesign:PackIcon Width="20"
                                                         Height="20"
                                                         Foreground="{StaticResource SuccessBrush}"
                                                         Kind="AccountHeartOutline" />
                            </Border>
                            <TextBlock Grid.Row="1"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding LoyaltyMemberCount}" />
                            <TextBlock Grid.Row="2"
                                       Margin="0,4,0,0"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Clients fidélité" />
                        </Grid>
                    </Border>

                    <!--  Alertes stock  -->
                    <Border Margin="0"
                            Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Margin="0,0,0,12"
                                    Padding="10"
                                    HorizontalAlignment="Left"
                                    Background="#FEF2F2"
                                    CornerRadius="10">
                                <materialDesign:PackIcon Width="20"
                                                         Height="20"
                                                         Foreground="#EF4444"
                                                         Kind="AlertOutline" />
                            </Border>
                            <TextBlock Grid.Row="1"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#EF4444"
                                       Text="{Binding LowStockAlerts}" />
                            <TextBlock Grid.Row="2"
                                       Margin="0,4,0,0"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Alertes stock" />
                        </Grid>
                    </Border>
                </UniformGrid>

                <!--  ══════════ SUMMARY CHIPS ══════════  -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Margin="0"
                            Style="{StaticResource CardCompactStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Border Margin="0,0,14,0"
                                    Padding="8"
                                    Background="#EFF6FF"
                                    CornerRadius="8">
                                <materialDesign:PackIcon Width="18"
                                                         Height="18"
                                                         Foreground="#2563EB"
                                                         Kind="CalendarWeek" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="Ventes de la semaine" />
                                <TextBlock Margin="0,2,0,0"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{Binding WeekSalesAmount}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Margin="0"
                            Style="{StaticResource CardCompactStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Border Margin="0,0,14,0"
                                    Padding="8"
                                    Background="#ECFDF5"
                                    CornerRadius="8">
                                <materialDesign:PackIcon Width="18"
                                                         Height="18"
                                                         Foreground="#059669"
                                                         Kind="CalendarMonth" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource AppFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="Ventes du mois" />
                                <TextBlock Margin="0,2,0,0"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{Binding MonthSalesAmount}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!--  ══════════ DRC WORLD CLOCKS (NEW) ══════════  -->
                <Border Margin="0,0,0,16"
                        Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                <materialDesign:PackIcon Width="20"
                                                         Height="20"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource PrimaryBrush}"
                                                         Kind="EarthBox" />
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource SectionTitleStyle}"
                                           Text="Horloges RDC" />
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}">
                                <Run Text="Ouest UTC+1  ·  Est UTC+2" />
                            </TextBlock>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding CityClocks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="6"
                                                 Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="4"
                                            Padding="14,12"
                                            Background="#F8FAFC"
                                            BorderBrush="{StaticResource BorderLightBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <StackPanel>
                                            <!--  City + UTC offset  -->
                                            <Grid>
                                                <TextBlock FontFamily="{StaticResource AppFont}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Text="{Binding CityName}" />
                                                <Border Padding="5,1"
                                                        HorizontalAlignment="Right"
                                                        Background="#E8F1F7"
                                                        CornerRadius="4">
                                                    <TextBlock FontFamily="{StaticResource AppFont}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource PrimaryBrush}"
                                                               Text="{Binding UtcOffsetLabel}" />
                                                </Border>
                                            </Grid>

                                            <!--  Region  -->
                                            <TextBlock Margin="0,1,0,0"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Text="{Binding Region}" />

                                            <!--  Time  -->
                                            <TextBlock Margin="0,8,0,2"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="{Binding CurrentTime}" />

                                            <!--  Date  -->
                                            <TextBlock FontFamily="{StaticResource AppFont}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="{Binding CurrentDateShort}" />

                                            <!--  Status row  -->
                                            <StackPanel Margin="0,8,0,0"
                                                        Orientation="Horizontal">
                                                <Ellipse Width="8"
                                                         Height="8"
                                                         VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#94A3B8" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBusinessOpen}"
                                                                             Value="True">
                                                                    <Setter Property="Fill" Value="#10B981" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Margin="6,0,8,0"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding BusinessStatus}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBusinessOpen}"
                                                                             Value="True">
                                                                    <Setter Property="Foreground" Value="#059669" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Margin="0,0,8,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Text="·" />
                                                <TextBlock VerticalAlignment="Center"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Text="{Binding PeriodLabel}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!--  ══════════ ROW 1: Sales Chart + Payments ══════════  -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <!--  Sales chart  -->
                    <Border Grid.Column="0"
                            Margin="0"
                            Style="{StaticResource CardStyle}">
                        <Grid>
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Margin="0"
                                               Style="{StaticResource SectionTitleStyle}"
                                               Text="Évolution des ventes" />
                                    <TextBlock HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="7 derniers jours" />
                                </Grid>

                                <!--  Chart visible only when data exists  -->
                                <lvc:CartesianChart Height="260"
                                                    AnimationsSpeed="0:0:0.3"
                                                    Series="{Binding SalesSeries}"
                                                    TooltipPosition="Top"
                                                    XAxes="{Binding SalesXAxes}"
                                                    YAxes="{Binding SalesYAxes}"
                                                    ZoomMode="None">
                                    <lvc:CartesianChart.Style>
                                        <Style TargetType="lvc:CartesianChart">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSalesData}"
                                                             Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </lvc:CartesianChart.Style>
                                </lvc:CartesianChart>
                            </StackPanel>

                            <!--  Empty state overlay  -->
                            <StackPanel Margin="0,40,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSalesData}"
                                                         Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Width="64"
                                        Height="64"
                                        Margin="0,0,0,14"
                                        HorizontalAlignment="Center"
                                        Background="#F0F9FF"
                                        CornerRadius="50">
                                    <materialDesign:PackIcon Width="28"
                                                             Height="28"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="#93C5FD"
                                                             Kind="ChartBar" />
                                </Border>
                                <TextBlock HorizontalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="Aucune vente cette semaine" />
                                <TextBlock MaxWidth="280"
                                           Margin="0,4,0,0"
                                           HorizontalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="Les données apparaîtront ici dès la première facture normalisée"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Payment pie  -->
                    <Border Grid.Column="2"
                            Margin="0"
                            Style="{StaticResource CardStyle}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                           Text="Modes de paiement" />
                                <lvc:PieChart Height="260"
                                              AnimationsSpeed="0:0:0.3"
                                              InitialRotation="-90"
                                              LegendPosition="Bottom"
                                              Series="{Binding PaymentSeries}">
                                    <lvc:PieChart.Style>
                                        <Style TargetType="lvc:PieChart">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasPaymentData}"
                                                             Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </lvc:PieChart.Style>
                                </lvc:PieChart>
                            </StackPanel>

                            <!--  Empty state  -->
                            <StackPanel Margin="0,40,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPaymentData}"
                                                         Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Width="56"
                                        Height="56"
                                        Margin="0,0,0,12"
                                        HorizontalAlignment="Center"
                                        Background="#F0FDF4"
                                        CornerRadius="50">
                                    <materialDesign:PackIcon Width="24"
                                                             Height="24"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="#86EFAC"
                                                             Kind="CreditCardOutline" />
                                </Border>
                                <TextBlock HorizontalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="Aucun paiement" />
                                <TextBlock Margin="0,4,0,0"
                                           HorizontalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="Les modes de paiement apparaîtront ici" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!--  ══════════ ROW 2: Invoice Types + Top Products ══════════  -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <!--  Invoice types donut  -->
                    <Border Grid.Column="0"
                            Margin="0"
                            Style="{StaticResource CardStyle}">
                        <Grid>
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Margin="0"
                                               Style="{StaticResource SectionTitleStyle}"
                                               Text="Types de factures" />
                                    <TextBlock HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="Ce mois" />
                                </Grid>
                                <lvc:PieChart Height="240"
                                              AnimationsSpeed="0:0:0.3"
                                              InitialRotation="-90"
                                              LegendPosition="Bottom"
                                              Series="{Binding InvoiceTypeSeries}">
                                    <lvc:PieChart.Style>
                                        <Style TargetType="lvc:PieChart">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasInvoiceTypeData}"
                                                             Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </lvc:PieChart.Style>
                                </lvc:PieChart>
                            </StackPanel>

                            <!--  Empty state  -->
                            <StackPanel Margin="0,40,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasInvoiceTypeData}"
                                                         Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Width="56"
                                        Height="56"
                                        Margin="0,0,0,12"
                                        HorizontalAlignment="Center"
                                        Background="#F5F3FF"
                                        CornerRadius="50">
                                    <materialDesign:PackIcon Width="24"
                                                             Height="24"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="#C4B5FD"
                                                             Kind="FileDocumentOutline" />
                                </Border>
                                <TextBlock HorizontalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="Aucune facture" />
                                <TextBlock Margin="0,4,0,0"
                                           HorizontalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="La répartition apparaîtra ici" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Top products  -->
                    <Border Grid.Column="2"
                            Margin="0"
                            Style="{StaticResource CardStyle}">
                        <Grid>
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Margin="0"
                                               Style="{StaticResource SectionTitleStyle}"
                                               Text="Top 5 Produits" />
                                    <TextBlock HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="30 derniers jours" />
                                </Grid>
                                <lvc:CartesianChart Height="240"
                                                    AnimationsSpeed="0:0:0.3"
                                                    Series="{Binding TopProductsSeries}"
                                                    TooltipPosition="Top"
                                                    XAxes="{Binding TopProductsXAxes}"
                                                    YAxes="{Binding TopProductsYAxes}"
                                                    ZoomMode="None">
                                    <lvc:CartesianChart.Style>
                                        <Style TargetType="lvc:CartesianChart">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasTopProductsData}"
                                                             Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </lvc:CartesianChart.Style>
                                </lvc:CartesianChart>
                            </StackPanel>

                            <!--  Empty state  -->
                            <StackPanel Margin="0,40,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasTopProductsData}"
                                                         Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Width="56"
                                        Height="56"
                                        Margin="0,0,0,12"
                                        HorizontalAlignment="Center"
                                        Background="#FFF7ED"
                                        CornerRadius="50">
                                    <materialDesign:PackIcon Width="24"
                                                             Height="24"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="#FDBA74"
                                                             Kind="PackageVariantClosed" />
                                </Border>
                                <TextBlock HorizontalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="Aucun produit vendu" />
                                <TextBlock MaxWidth="250"
                                           Margin="0,4,0,0"
                                           HorizontalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="Le classement apparaîtra après les premières ventes"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!--  ══════════ RECENT ACTIVITY ══════════  -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Margin="0"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Text="Activité récente" />
                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="10 dernières factures" />
                        </Grid>

                        <!--  Table header  -->
                        <Border Margin="0,0,0,4"
                                Padding="16,10"
                                Background="#F8FAFC"
                                CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRecentData}"
                                                     Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="DATE" />
                                <TextBlock Grid.Column="1"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="N° FACTURE" />
                                <TextBlock Grid.Column="2"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="CLIENT" />
                                <TextBlock Grid.Column="3"
                                           HorizontalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="TYPE" />
                                <TextBlock Grid.Column="4"
                                           HorizontalAlignment="Right"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="MONTANT" />
                            </Grid>
                        </Border>

                        <!--  Rows  -->
                        <ItemsControl ItemsSource="{Binding RecentInvoices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16,12"
                                            BorderBrush="{StaticResource BorderLightBrush}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="140" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="{Binding FormattedDate}" />
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="{Binding InvoiceNumber}" />
                                            <TextBlock Grid.Column="2"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="{Binding ClientName}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="3"
                                                    Padding="10,4"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding TypeBgColor, Converter={StaticResource StringToBrush}}"
                                                    CornerRadius="6">
                                                <TextBlock HorizontalAlignment="Center"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding TypeColor, Converter={StaticResource StringToBrush}}"
                                                           Text="{Binding TypeLabel}" />
                                            </Border>
                                            <TextBlock Grid.Column="4"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="{Binding FormattedAmount}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  Empty state for recent activity  -->
                        <StackPanel Margin="0,30,0,30"
                                    HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRecentData}"
                                                     Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="64"
                                    Height="64"
                                    Margin="0,0,0,14"
                                    HorizontalAlignment="Center"
                                    Background="#F0F9FF"
                                    CornerRadius="50">
                                <materialDesign:PackIcon Width="28"
                                                         Height="28"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="#93C5FD"
                                                         Kind="ReceiptTextClockOutline" />
                            </Border>
                            <TextBlock HorizontalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Aucune facture récente" />
                            <TextBlock MaxWidth="380"
                                       Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="Créez des factures depuis Fichier → Caisse ou Facture pour voir l'activité ici"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>