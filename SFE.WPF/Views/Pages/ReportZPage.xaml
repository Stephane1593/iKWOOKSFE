<!-- File: SFE.WPF/Views/Pages/ReportZPage.xaml -->
<UserControl x:Class="SFE.WPF.Views.Pages.ReportZPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:SFE.WPF.Converters"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>

        <!-- ══════════ ACCENT COLORS (Red theme for Z) ══════════ -->
        <Color x:Key="ZAccent">#DC2626</Color>
        <Color x:Key="ZAccentDark">#B91C1C</Color>
        <Color x:Key="ZAccentDeep">#991B1B</Color>
        <SolidColorBrush x:Key="ZAccentBrush" Color="{StaticResource ZAccent}"/>

        <!-- ══════════ TOUCH SCROLLBAR THUMB ══════════ -->
        <Style x:Key="TouchScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBd" CornerRadius="5" Margin="2,0">
                            <Border.Background>
                                <SolidColorBrush x:Name="ThumbBg" Color="#C4CDD5"/>
                            </Border.Background>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="ThumbBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#A0AEC0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="ThumbBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#C4CDD5" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource ZAccent}"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ VERTICAL TOUCH SCROLLBAR ══════════ -->
        <Style x:Key="TouchScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border CornerRadius="5" Background="#F1F5F9" Margin="2,0"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource TouchScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ HORIZONTAL TOUCH SCROLLBAR ══════════ -->
        <Style x:Key="TouchScrollBarH" TargetType="ScrollBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="MinHeight" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border CornerRadius="3" Background="#F1F5F9" Margin="0,2"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="#C4CDD5" Margin="0,2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ DATAGRID COLUMN HEADER ══════════ -->
        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,14"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="SeparatorVisibility" Value="Collapsed"/>
        </Style>

        <!-- ══════════ DATAGRID CELL STYLE ══════════ -->
        <Style x:Key="GridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ══════════ ROW STYLE (animated hover + selection) ══════════ -->
        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="RowBd" BorderThickness="0,0,0,1"
                                BorderBrush="#F1F5F9">
                            <Border.Background>
                                <SolidColorBrush x:Name="RowBg" Color="Transparent"/>
                            </Border.Background>
                            <SelectiveScrollingGrid>
                                <SelectiveScrollingGrid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </SelectiveScrollingGrid.ColumnDefinitions>
                                <SelectiveScrollingGrid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </SelectiveScrollingGrid.RowDefinitions>
                                <DataGridCellsPresenter Grid.Column="1"
                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                <DataGridDetailsPresenter Grid.Column="1" Grid.Row="1"
                                    SelectiveScrollingGrid.SelectiveScrollingOrientation=
                                        "{Binding AreRowDetailsFrozen,
                                         ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical},
                                         Converter={x:Static DataGrid.RowDetailsScrollingConverter},
                                         RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                    Visibility="{TemplateBinding DetailsVisibility}"/>
                                <DataGridRowHeader Grid.RowSpan="2"
                                    SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"
                                    Visibility="{Binding HeadersVisibility,
                                                 ConverterParameter={x:Static DataGridHeadersVisibility.Row},
                                                 Converter={x:Static DataGrid.HeadersVisibilityConverter},
                                                 RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>
                            </SelectiveScrollingGrid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="RowBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#FEF2F2" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="RowBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="Transparent" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="RowBg"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#FEE2E2" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="RowBg"
                                                            Storyboard.TargetProperty="Color"
                                                            To="Transparent" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ PRIMARY BUTTON (red gradient, animated) ══════════ -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="18,10">
                            <Border.Background>
                                <LinearGradientBrush x:Name="BdGrad" StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="G0" Color="{StaticResource ZAccent}" Offset="0"/>
                                    <GradientStop x:Name="G1" Color="{StaticResource ZAccentDark}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="8"
                                                  Opacity="0.18" Color="{StaticResource ZAccent}"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource ZAccentDark}" Duration="0:0:0.18"/>
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource ZAccentDeep}" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="G0"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource ZAccent}" Duration="0:0:0.22"/>
                                        <ColorAnimation Storyboard.TargetName="G1"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource ZAccentDark}" Duration="0:0:0.22"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ GHOST BUTTON (outline, animated) ══════════ -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="14,8"
                                BorderThickness="1.5">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="White"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="BdBr" Color="{StaticResource BorderColor}"/>
                            </Border.BorderBrush>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#F8FAFC" Duration="0:0:0.12"/>
                                        <ColorAnimation Storyboard.TargetName="BdBr"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#94A3B8" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="White" Duration="0:0:0.15"/>
                                        <ColorAnimation Storyboard.TargetName="BdBr"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource BorderColor}"
                                                        Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ LINK BUTTON (animated arrow) ══════════ -->
        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ZAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="4,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="txt" Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <materialDesign:PackIcon x:Name="arr" Kind="ArrowRight"
                                    Width="14" Height="14" Margin="4,0,0,0"
                                    Foreground="{TemplateBinding Foreground}"
                                    VerticalAlignment="Center" Opacity="0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="arr"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="arr"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ PANEL ICON BUTTON ══════════ -->
        <Style x:Key="PanelIconBtn" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8">
                            <Border.Background>
                                <SolidColorBrush x:Name="BdBg" Color="#00F1F5F9"/>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#F1F5F9" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#00F1F5F9" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <!-- ═══════════════════════════════════════════ -->
        <!-- MAIN CONTENT                                -->
        <!-- ═══════════════════════════════════════════ -->
        <DockPanel Margin="28,24">

            <!-- ═══════════════════════════════════════ -->
            <!-- HEADER CARD                             -->
            <!-- ═══════════════════════════════════════ -->
            <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}"
                    CornerRadius="14" Padding="24,20" Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" Opacity="0.06"
                                      ShadowDepth="2" Color="#0D2B3E"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon Badge + Title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="10" Padding="10" Margin="0,0,14,0"
                                VerticalAlignment="Center">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource ZAccent}" Opacity="0.08"/>
                            </Border.Background>
                            <materialDesign:PackIcon Kind="LockCheckOutline"
                                                     Width="22" Height="22"
                                                     Foreground="{StaticResource ZAccentBrush}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Rapport Z — Clôture"
                                       Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                            <TextBlock Text="Rapports de clôture de session (compteurs remis à zéro)"
                                       FontFamily="{StaticResource AppFont}" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Refresh Button -->
                    <Button Grid.Column="2" Style="{StaticResource GhostBtn}"
                            Command="{Binding RefreshCommand}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16"
                                                     Foreground="{StaticResource TextSecondaryBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Actualiser" VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}"/>
                        </StackPanel>
                    </Button>

                    <!-- Clôturer Button -->
                    <Button Grid.Column="3" Style="{StaticResource PrimaryBtn}"
                            Command="{Binding GenerateZCommand}"
                            IsEnabled="{Binding CanGenerate}"
                            ToolTip="{Binding GenerateTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LockOutline"
                                                     Width="16" Height="16"
                                                     Foreground="White" VerticalAlignment="Center"
                                                     Margin="0,0,8,0"/>
                            <TextBlock Text="Clôturer la session" VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════ -->
            <!-- KPI STATS ROW                           -->
            <!-- ═══════════════════════════════════════ -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                        Margin="0,0,0,16">

                <!-- Total Reports -->
                <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                        Padding="18,14" Margin="0,0,12,0" MinWidth="180">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Opacity="0.05"
                                          ShadowDepth="2" Color="#0D2B3E"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Clôtures effectuées"
                                       FontFamily="{StaticResource AppFont}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TotalCount}"
                                       FontFamily="{StaticResource AppFont}" FontSize="26"
                                       FontWeight="Bold" Foreground="{StaticResource ZAccentBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="10" Padding="8"
                                VerticalAlignment="Top">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource ZAccent}" Opacity="0.08"/>
                            </Border.Background>
                            <materialDesign:PackIcon Kind="LockCheckOutline"
                                Width="20" Height="20"
                                Foreground="{StaticResource ZAccentBrush}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Last Generated -->
                <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                        Padding="18,14" MinWidth="260">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Opacity="0.05"
                                          ShadowDepth="2" Color="#0D2B3E"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Dernière clôture"
                                       FontFamily="{StaticResource AppFont}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding LastGeneratedInfo}"
                                       FontFamily="{StaticResource AppFont}" FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="10" Padding="8"
                                VerticalAlignment="Top">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.08"/>
                            </Border.Background>
                            <materialDesign:PackIcon Kind="ClockOutline"
                                Width="20" Height="20"
                                Foreground="{StaticResource PrimaryBrush}"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ═══════════════════════════════════════ -->
            <!-- STATUS MESSAGE                          -->
            <!-- ═══════════════════════════════════════ -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,12" CornerRadius="10"
                    Padding="14,10"
                    Visibility="{Binding HasStatus, Converter={StaticResource BoolVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="#059669" Opacity="0.06"/>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush">
                            <Setter.Value>
                                <SolidColorBrush Color="#059669" Opacity="0.18"/>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#EF4444" Opacity="0.06"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="BorderBrush">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#EF4444" Opacity="0.18"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="18" Height="18"
                                             VerticalAlignment="Center" Margin="0,0,10,0">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Kind" Value="CheckCircleOutline"/>
                                <Setter Property="Foreground" Value="#059669"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Kind" Value="AlertCircleOutline"/>
                                        <Setter Property="Foreground" Value="#EF4444"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontFamily="{StaticResource AppFont}" FontSize="13"
                               VerticalAlignment="Center" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#059669"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Foreground" Value="#EF4444"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════ -->
            <!-- TWO-COLUMN: TABLE + DETAIL PANEL        -->
            <!-- ═══════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ── LEFT: REPORTS TABLE ── -->
                <Border Grid.Column="0" Background="{StaticResource CardBrush}"
                        CornerRadius="14" ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" Opacity="0.06"
                                          ShadowDepth="2" Color="#0D2B3E"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- DataGrid -->
                        <DataGrid ItemsSource="{Binding Reports}"
                                  SelectedItem="{Binding SelectedReport}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  HeadersVisibility="Column" GridLinesVisibility="None"
                                  BorderThickness="0" Background="Transparent"
                                  FontFamily="{StaticResource AppFont}" FontSize="13"
                                  RowHeight="58" CanUserResizeRows="False"
                                  CanUserReorderColumns="False" CanUserSortColumns="True"
                                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                  CellStyle="{StaticResource GridCellStyle}"
                                  RowStyle="{StaticResource GridRowStyle}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.CanContentScroll="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  EnableRowVirtualization="True"
                                  Visibility="{Binding IsEmpty, Converter={StaticResource InvBoolVis}}">

                            <DataGrid.Resources>
                                <Style TargetType="ScrollBar"
                                       BasedOn="{StaticResource TouchScrollBar}"/>
                            </DataGrid.Resources>

                            <DataGrid.Columns>

                                <!-- ═══ DATE ═══ -->
                                <DataGridTemplateColumn Header="DATE" Width="160"
                                                        SortMemberPath="CreatedAt">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="CalendarOutline"
                                                    Width="14" Height="14" Margin="0,0,8,0"
                                                    Foreground="{StaticResource TextMutedBrush}"
                                                    VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DateDisplay}"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="13" FontWeight="Medium"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- ═══ OPERATOR ═══ -->
                                <DataGridTemplateColumn Header="OPÉRATEUR" Width="*"
                                                        SortMemberPath="OperatorName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Border Width="30" Height="30"
                                                        CornerRadius="15" Margin="0,0,10,0"
                                                        VerticalAlignment="Center">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{StaticResource ZAccent}" Opacity="0.08"/>
                                                    </Border.Background>
                                                    <materialDesign:PackIcon Kind="AccountOutline"
                                                        Width="16" Height="16"
                                                        Foreground="{StaticResource ZAccentBrush}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding OperatorName}"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- ═══ REFERENCE ═══ -->
                                <DataGridTemplateColumn Header="RÉF. E-UF" Width="120"
                                                        SortMemberPath="ReferenceDisplay">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#FEF2F2" CornerRadius="6"
                                                    Padding="8,4" HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ReferenceDisplay}"
                                                           FontFamily="Consolas" FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource ZAccentBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- ═══ TOTAL TTC ═══ -->
                                <DataGridTemplateColumn Header="TOTAL TTC" Width="130"
                                                        SortMemberPath="TotalDisplay">
                                    <DataGridTemplateColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader"
                                               BasedOn="{StaticResource GridHeaderStyle}">
                                            <Setter Property="HorizontalContentAlignment"
                                                    Value="Right"/>
                                        </Style>
                                    </DataGridTemplateColumn.HeaderStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="CurrencyEur"
                                                    Width="13" Height="13" Margin="0,0,4,0"
                                                    Foreground="{StaticResource TextMutedBrush}"
                                                    VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding TotalDisplay}"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- ═══ ACTION ═══ -->
                                <DataGridTemplateColumn Header="" Width="130"
                                                        CanUserSort="False"
                                                        CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource LinkBtn}"
                                                    Content="Voir détails"
                                                    Command="{Binding DataContext.ViewDetailCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Empty State -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
                            <Border Width="64" Height="64" CornerRadius="32"
                                    HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Border.Background>
                                    <SolidColorBrush Color="{StaticResource ZAccent}" Opacity="0.06"/>
                                </Border.Background>
                                <materialDesign:PackIcon Kind="LockCheckOutline"
                                    Width="32" Height="32"
                                    Foreground="{StaticResource ZAccentBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Aucun Z-Rapport"
                                       FontFamily="{StaticResource AppFont}" FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Clôturez votre première session pour générer un rapport"
                                       FontFamily="{StaticResource AppFont}" FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- Table Footer -->
                        <Border Grid.Row="1" Padding="16,12"
                                BorderBrush="#F1F5F9" BorderThickness="0,1,0,0"
                                Background="#FAFBFC">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Style="{StaticResource GhostBtn}"
                                        Command="{Binding PrintReportCommand}"
                                        CommandParameter="{Binding SelectedReport}"
                                        IsEnabled="{Binding HasSelectedReport}"
                                        Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Printer"
                                            Width="15" Height="15"
                                            VerticalAlignment="Center" Margin="0,0,6,0"
                                            Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="Imprimer" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostBtn}"
                                        Command="{Binding ExportReportCommand}"
                                        CommandParameter="{Binding SelectedReport}"
                                        IsEnabled="{Binding HasSelectedReport}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileExportOutline"
                                            Width="15" Height="15"
                                            VerticalAlignment="Center" Margin="0,0,6,0"
                                            Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="Exporter" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ── RIGHT: DETAIL PANEL ── -->
                <Border Grid.Column="1" Width="440" Margin="14,0,0,0"
                        Background="{StaticResource CardBrush}" CornerRadius="14"
                        ClipToBounds="True"
                        Visibility="{Binding ShowDetailPanel, Converter={StaticResource BoolVis}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" Opacity="0.06"
                                          ShadowDepth="2" Color="#0D2B3E"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Detail Header -->
                        <Border Grid.Row="0" Padding="20,16"
                                BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DetailTitle}"
                                               FontFamily="{StaticResource AppFont}"
                                               FontWeight="Bold" FontSize="15"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding DetailSubtitle}"
                                               FontFamily="{StaticResource AppFont}" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Button Grid.Column="1" Style="{StaticResource PanelIconBtn}"
                                        ToolTip="Ouvrir dans une fenêtre"
                                        Command="{Binding PopOutDetailCommand}"
                                        Margin="4,0">
                                    <materialDesign:PackIcon Kind="OpenInNew"
                                        Width="18" Height="18"
                                        Foreground="{StaticResource TextMutedBrush}"/>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource PanelIconBtn}"
                                        ToolTip="Copier"
                                        Command="{Binding CopyDetailCommand}"
                                        Margin="0,0,4,0">
                                    <materialDesign:PackIcon Kind="ContentCopy"
                                        Width="18" Height="18"
                                        Foreground="{StaticResource TextMutedBrush}"/>
                                </Button>
                                <Button Grid.Column="3" Style="{StaticResource PanelIconBtn}"
                                        ToolTip="Fermer"
                                        Command="{Binding CloseDetailPanelCommand}">
                                    <materialDesign:PackIcon Kind="Close"
                                        Width="18" Height="18"
                                        Foreground="{StaticResource TextMutedBrush}"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Detail Content (code viewer) -->
                        <ScrollViewer Grid.Row="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      PanningMode="Both">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar"
                                       BasedOn="{StaticResource TouchScrollBar}"/>
                            </ScrollViewer.Resources>
                            <Border Padding="24,20">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#0F172A" Offset="0"/>
                                        <GradientStop Color="#1E293B" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="{Binding DetailContent}"
                                           FontFamily="Consolas" FontSize="12"
                                           LineHeight="19" Foreground="#E2E8F0"
                                           TextWrapping="NoWrap"/>
                            </Border>
                        </ScrollViewer>

                        <!-- Detail Footer -->
                        <Border Grid.Row="2" Padding="16,12"
                                BorderBrush="#F1F5F9" BorderThickness="0,1,0,0"
                                Background="#FAFBFC">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Style="{StaticResource GhostBtn}"
                                        Command="{Binding PrintReportCommand}"
                                        CommandParameter="{Binding DetailItem}"
                                        Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Printer"
                                            Width="15" Height="15"
                                            VerticalAlignment="Center" Margin="0,0,6,0"
                                            Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="Imprimer" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostBtn}"
                                        Command="{Binding ExportReportCommand}"
                                        CommandParameter="{Binding DetailItem}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileExportOutline"
                                            Width="15" Height="15"
                                            VerticalAlignment="Center" Margin="0,0,6,0"
                                            Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="Exporter" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- LOADING SPINNER                                            -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Background="#60000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}">
            <Border Background="{StaticResource CardBrush}" CornerRadius="16"
                    Padding="32,28" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.15"
                                      ShadowDepth="4" Color="#0D2B3E"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="Loading" Width="36" Height="36"
                                             Foreground="{StaticResource ZAccentBrush}"
                                             HorizontalAlignment="Center"
                                             RenderTransformOrigin="0.5,0.5">
                        <materialDesign:PackIcon.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate"/>
                        </materialDesign:PackIcon.RenderTransform>
                        <materialDesign:PackIcon.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetName="SpinnerRotate"
                                            Storyboard.TargetProperty="Angle"
                                            From="0" To="360" Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </materialDesign:PackIcon.Triggers>
                    </materialDesign:PackIcon>
                    <TextBlock Text="Chargement en cours..."
                               FontFamily="{StaticResource AppFont}" FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>