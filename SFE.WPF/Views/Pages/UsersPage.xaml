<UserControl x:Class="SFE.WPF.Views.Pages.UsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SFE.WPF.ViewModels"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════ -->
        <!-- HEADER + TAB BAR                           -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title row -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🛡️" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Gestion des utilisateurs et rôles"
                               Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Tabs -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                    <!-- Users Tab Button -->
                    <Button Command="{Binding SwitchToUsersTabCommand}" Cursor="Hand"
                            Padding="16,8" Margin="0,0,4,0" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUsersTab}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥" Margin="0,0,6,0"/>
                            <TextBlock Text="Utilisateurs"/>
                            <Border Background="#FFFFFF30" CornerRadius="8" Padding="6,1" Margin="8,0,0,0">
                                <TextBlock Text="{Binding UserCount}" FontSize="11"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Roles Tab Button -->
                    <Button Command="{Binding SwitchToRolesTabCommand}" Cursor="Hand"
                            Padding="16,8" Margin="0,0,4,0" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUsersTab}" Value="False">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔑" Margin="0,0,6,0"/>
                            <TextBlock Text="Rôles"/>
                            <Border Background="#FFFFFF30" CornerRadius="8" Padding="6,1" Margin="8,0,0,0">
                                <TextBlock Text="{Binding RoleCount}" FontSize="11"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════ -->
        <!-- TAB CONTENT                                -->
        <!-- ══════════════════════════════════════════ -->
        <Grid Grid.Row="1">

            <!-- ======================================== -->
            <!--  USERS TAB                                -->
            <!-- ======================================== -->
            <Grid Visibility="{Binding IsUsersTab, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="480"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT — User List -->
                <DockPanel Grid.Column="0" Margin="0,0,16,0">

                    <!-- Search bar -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardCompactStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                     FontFamily="{StaticResource AppFont}" Padding="10,8"
                                     ToolTip="Rechercher par nom, identifiant ou rôle..."/>
                            <Button Grid.Column="1" Content="+ Nouvel utilisateur"
                                    Command="{Binding NewUserCommand}" Margin="8,0,0,0"
                                    Background="{StaticResource PrimaryBrush}" Foreground="White"
                                    FontFamily="{StaticResource AppFont}" FontWeight="SemiBold"
                                    Padding="16,8" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- DataGrid -->
                    <Border Style="{StaticResource CardStyle}">
                        <DataGrid ItemsSource="{Binding Users}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  BorderThickness="0" FontFamily="{StaticResource AppFont}" FontSize="12"
                                  SelectionMode="Single">

                            <DataGrid.InputBindings>
                                <MouseBinding Gesture="LeftDoubleClick"
                                              Command="{Binding EditUserCommand}"
                                              CommandParameter="{Binding SelectedItem,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataGrid.InputBindings>

                            <DataGrid.Columns>
                                <!-- Username -->
                                <DataGridTemplateColumn Header="Identifiant" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔒" FontSize="11" Margin="0,0,4,0"
                                                           ToolTip="Compte protégé"
                                                           Visibility="{Binding IsSuperAdmin,
                                                               Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <TextBlock Text="{Binding Username}" FontWeight="SemiBold"
                                                           FontFamily="{StaticResource AppFont}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Nom complet" Binding="{Binding FullName}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Role badge -->
                                <DataGridTemplateColumn Header="Rôle" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#EFF6FF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSuperAdmin}" Value="True">
                                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding RoleName}" FontSize="11"
                                                           FontWeight="Bold" FontFamily="{StaticResource AppFont}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSuperAdmin}" Value="True">
                                                                    <Setter Property="Foreground" Value="#B45309"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Active badge -->
                                <DataGridTemplateColumn Header="Statut" Width="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background" Value="#D1FAE5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ActiveDisplay}" FontSize="11"
                                                           FontWeight="Bold" FontFamily="{StaticResource AppFont}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Foreground" Value="#059669"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Dernière connexion" Binding="{Binding LastLoginDisplay}" Width="130"/>

                                <!-- Actions -->
                                <DataGridTemplateColumn Header="" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="✏️" FontSize="13" Background="Transparent"
                                                        BorderThickness="0" Cursor="Hand" Padding="4,2"
                                                        ToolTip="Modifier"
                                                        Command="{Binding DataContext.EditUserCommand,
                                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="⏻" FontSize="13" Background="Transparent"
                                                        BorderThickness="0" Cursor="Hand" Padding="4,2"
                                                        ToolTip="Activer / Désactiver"
                                                        Command="{Binding DataContext.ToggleUserActiveCommand,
                                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="🗑️" FontSize="13" Background="Transparent"
                                                        BorderThickness="0" Cursor="Hand" Padding="4,2"
                                                        ToolTip="Supprimer"
                                                        Command="{Binding DataContext.DeleteUserCommand,
                                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>

                <!-- RIGHT — User Form -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- Empty state -->
                        <StackPanel Visibility="{Binding IsEditingUser, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                    VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,60,0,0">
                            <TextBlock Text="👤" FontSize="48" HorizontalAlignment="Center" Opacity="0.3"/>
                            <TextBlock Text="Sélectionnez un utilisateur ou créez-en un nouveau"
                                       FontFamily="{StaticResource AppFont}" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,12,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Form -->
                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{Binding IsEditingUser, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <!-- Title -->
                                <Grid>
                                    <TextBlock Text="{Binding UserFormTitle}" Style="{StaticResource SectionTitleStyle}"/>
                                    <Button Content="✕" HorizontalAlignment="Right" FontSize="14"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding CancelUserEditCommand}"
                                            Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Grid>

                                <!-- Protected banner -->
                                <Border Background="#FEF3C7" CornerRadius="6" Padding="10,8" Margin="0,8,0,0"
                                        Visibility="{Binding IsProtectedUser, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="🔒 Compte SuperAdmin protégé — seuls le nom et le mot de passe peuvent être modifiés."
                                               FontFamily="{StaticResource AppFont}" FontSize="11"
                                               Foreground="#92400E" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Username -->
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="Nom d'utilisateur *" FontFamily="{StaticResource AppFont}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding FormUsername, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{StaticResource AppFont}" Padding="8,6"
                                             IsEnabled="{Binding IsProtectedUser, Converter={StaticResource InverseBoolConverter}}"/>
                                </StackPanel>

                                <!-- Password -->
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Nouveau mot de passe (laisser vide = inchangé)"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCreatingUser}" Value="True">
                                                        <Setter Property="Text" Value="Mot de passe * (min. 4 caractères)"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox Text="{Binding FormPassword, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{StaticResource AppFont}" Padding="8,6"/>
                                </StackPanel>

                                <!-- Full Name -->
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="Nom complet *" FontFamily="{StaticResource AppFont}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding FormFullName, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{StaticResource AppFont}" Padding="8,6"/>
                                </StackPanel>

                                <!-- Role -->
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="Rôle *" FontFamily="{StaticResource AppFont}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding AvailableRoles}"
                                              SelectedItem="{Binding FormRole}"
                                              DisplayMemberPath="Name"
                                              FontFamily="{StaticResource AppFont}" Padding="8,6"
                                              IsEnabled="{Binding IsProtectedUser, Converter={StaticResource InverseBoolConverter}}"/>
                                </StackPanel>

                                <!-- Active toggle -->
                                <StackPanel Margin="0,12,0,0" Orientation="Horizontal"
                                            IsEnabled="{Binding IsProtectedUser, Converter={StaticResource InverseBoolConverter}}">
                                    <CheckBox IsChecked="{Binding FormIsActive}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Compte actif" FontFamily="{StaticResource AppFont}" FontSize="13"
                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- POS Assignment -->
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="Points de vente assignés" FontFamily="{StaticResource AppFont}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                    <Border Background="#F8FAFC" CornerRadius="6" Padding="10,8"
                                            MaxHeight="160">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding AvailablePos}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsAssigned}" Margin="0,3"
                                                                  FontFamily="{StaticResource AppFont}" FontSize="12">
                                                            <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                    <TextBlock Text="Si aucun POS n'est sélectionné, l'utilisateur devra en choisir un à la connexion."
                                               FontFamily="{StaticResource AppFont}" FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"
                                               TextWrapping="Wrap" FontStyle="Italic"/>
                                </StackPanel>

                                <!-- Buttons -->
                                <Grid Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Annuler" Command="{Binding CancelUserEditCommand}"
                                            FontFamily="{StaticResource AppFont}" Padding="14,8"
                                            Background="#F3F4F6" BorderThickness="0" Cursor="Hand"
                                            HorizontalAlignment="Left"/>
                                    <Button Grid.Column="1" Command="{Binding SaveUserCommand}"
                                            Background="{StaticResource PrimaryBrush}" Foreground="White"
                                            FontFamily="{StaticResource AppFont}" FontWeight="SemiBold"
                                            Padding="20,8" BorderThickness="0" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💾" Margin="0,0,6,0"/>
                                            <TextBlock Text="Enregistrer"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Status -->
                                <Border Margin="0,12,0,0" CornerRadius="6" Padding="10,8"
                                        Visibility="{Binding ShowSuccess, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="#ECFDF5">
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                                               FontFamily="{StaticResource AppFont}" FontSize="12" TextWrapping="Wrap"/>
                                </Border>
                                <Border Margin="0,12,0,0" CornerRadius="6" Padding="10,8"
                                        Visibility="{Binding ShowError, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="#FEF2F2">
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource ErrorBrush}"
                                               FontFamily="{StaticResource AppFont}" FontSize="12" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ======================================== -->
            <!--  ROLES TAB                                -->
            <!-- ======================================== -->
            <Grid Visibility="{Binding IsUsersTab, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT — Role List -->
                <DockPanel Grid.Column="0" Margin="0,0,16,0">

                    <Button DockPanel.Dock="Top" Content="+ Nouveau rôle"
                            Command="{Binding NewRoleCommand}" Margin="0,0,0,12"
                            Background="{StaticResource PrimaryBrush}" Foreground="White"
                            FontFamily="{StaticResource AppFont}" FontWeight="SemiBold"
                            Padding="14,8" BorderThickness="0" Cursor="Hand"
                            HorizontalAlignment="Stretch"/>

                    <Border Style="{StaticResource CardStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Roles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" CornerRadius="8" Padding="12,10" Cursor="Hand"
                                                BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F8FAFC"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSuperAdmin}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#FDE68A"/>
                                                            <Setter Property="Background" Value="#FFFBEB"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick"
                                                              Command="{Binding DataContext.EditRoleCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🔒" FontSize="11" Margin="0,0,4,0"
                                                                   Visibility="{Binding IsSuperAdmin,
                                                                       Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"
                                                                   FontFamily="{StaticResource AppFont}"/>
                                                    </StackPanel>
                                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11"
                                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0">
                                                        <Run Text="{Binding UserCount, Mode=OneWay}"/>
                                                        <Run Text=" utilisateur(s)"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <Button Grid.Column="1" Content="🗑️" FontSize="12"
                                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                        Padding="4,2" VerticalAlignment="Center"
                                                        ToolTip="Supprimer le rôle"
                                                        Visibility="{Binding IsSuperAdmin,
                                                            Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                        Command="{Binding DataContext.DeleteRoleCommand,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>

                <!-- RIGHT — Role Form / Permission Editor -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- Empty state -->
                        <StackPanel Visibility="{Binding IsEditingRole, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                    VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,60,0,0">
                            <TextBlock Text="🔑" FontSize="48" HorizontalAlignment="Center" Opacity="0.3"/>
                            <TextBlock Text="Sélectionnez un rôle pour voir et modifier ses permissions"
                                       FontFamily="{StaticResource AppFont}" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,12,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Form -->
                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{Binding IsEditingRole, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <!-- Title -->
                                <Grid>
                                    <TextBlock Text="{Binding RoleFormTitle}" Style="{StaticResource SectionTitleStyle}"/>
                                    <Button Content="✕" HorizontalAlignment="Right" FontSize="14"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding CancelRoleEditCommand}"
                                            Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Grid>

                                <!-- Protected banner -->
                                <Border Background="#FEF3C7" CornerRadius="6" Padding="10,8" Margin="0,8,0,0"
                                        Visibility="{Binding IsProtectedRole, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="🔒 Rôle SuperAdmin protégé — ce rôle ne peut pas être modifié ni supprimé. Toutes les permissions sont activées en permanence."
                                               FontFamily="{StaticResource AppFont}" FontSize="11"
                                               Foreground="#92400E" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Role Name -->
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="Nom du rôle *" FontFamily="{StaticResource AppFont}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding FormRoleName, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{StaticResource AppFont}" Padding="8,6"
                                             IsEnabled="{Binding IsProtectedRole, Converter={StaticResource InverseBoolConverter}}"/>
                                </StackPanel>

                                <!-- Permissions -->
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Text="Permissions" FontFamily="{StaticResource AppFont}" FontSize="14"
                                               FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,10"/>

                                    <ItemsControl ItemsSource="{Binding FormPermissions}"
                                                  IsEnabled="{Binding IsProtectedRole, Converter={StaticResource InverseBoolConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="2,3" Padding="8,6" CornerRadius="6">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#F8FAFC"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsGranted}" Value="True">
                                                                    <Setter Property="Background" Value="#ECFDF5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <CheckBox IsChecked="{Binding IsGranted}"
                                                              FontFamily="{StaticResource AppFont}" FontSize="12">
                                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                                                    </CheckBox>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Buttons (hidden for protected) -->
                                <Grid Margin="0,20,0,0"
                                      Visibility="{Binding IsProtectedRole, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Annuler" Command="{Binding CancelRoleEditCommand}"
                                            FontFamily="{StaticResource AppFont}" Padding="14,8"
                                            Background="#F3F4F6" BorderThickness="0" Cursor="Hand"
                                            HorizontalAlignment="Left"/>
                                    <Button Grid.Column="1" Command="{Binding SaveRoleCommand}"
                                            Background="{StaticResource PrimaryBrush}" Foreground="White"
                                            FontFamily="{StaticResource AppFont}" FontWeight="SemiBold"
                                            Padding="20,8" BorderThickness="0" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💾" Margin="0,0,6,0"/>
                                            <TextBlock Text="Enregistrer"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Status -->
                                <Border Margin="0,12,0,0" CornerRadius="6" Padding="10,8"
                                        Visibility="{Binding ShowSuccess, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="#ECFDF5">
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                                               FontFamily="{StaticResource AppFont}" FontSize="12" TextWrapping="Wrap"/>
                                </Border>
                                <Border Margin="0,12,0,0" CornerRadius="6" Padding="10,8"
                                        Visibility="{Binding ShowError, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="#FEF2F2">
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource ErrorBrush}"
                                               FontFamily="{StaticResource AppFont}" FontSize="12" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>

        </Grid>

    </Grid>
</UserControl>