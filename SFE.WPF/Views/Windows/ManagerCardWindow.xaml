<Window x:Class="SFE.WPF.Views.Windows.ManagerCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:ctrl="clr-namespace:SFE.WPF.Controls"
        Title="Carte manager"
        Width="620" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>

        <!-- Header gradient -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1E3A5F" Offset="0"/>
            <GradientStop Color="#2563EB" Offset="1"/>
        </LinearGradientBrush>

        <!-- Ghost button -->
        <Style x:Key="BtnGhost" TargetType="Button">
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary button -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="MinWidth" Value="170"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1E40AF"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Border Width="42" Height="42" CornerRadius="12" Background="#7C3AED">
                <md:PackIcon Kind="CardAccountDetails"
                             Width="22"
                             Height="22"
                             Foreground="White"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
            </Border>

            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Carte manager émise"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="16"
                           FontWeight="Bold"/>

                <TextBlock Text="Imprimez la carte maintenant — le code ne sera plus affiché."
                           FontFamily="{StaticResource AppFont}"
                           FontSize="11"
                           Foreground="#94A3B8"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Warning banner -->
        <Border Grid.Row="1"
                CornerRadius="12"
                Padding="14"
                Margin="0,0,0,16"
                Background="#FEF3C7"
                BorderBrush="#FDE68A"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <md:PackIcon Kind="AlertOctagon"
                             Width="20"
                             Height="20"
                             Foreground="#92400E"
                             Margin="0,0,10,0"
                             VerticalAlignment="Center"/>

                <TextBlock TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="12"
                           Foreground="#92400E"
                           Text="Ce code d'autorisation ne sera plus jamais réaffiché. Imprimez la carte et remettez-la au manager. Toute nouvelle génération invalide la carte précédente."/>
            </StackPanel>
        </Border>

        <!-- Card preview -->
        <Border Grid.Row="2"
                x:Name="CardRoot"
                Width="480"
                Height="300"
                CornerRadius="14"
                BorderBrush="#1E3A5F"
                BorderThickness="1"
                Background="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24"
                                  ShadowDepth="6"
                                  Direction="270"
                                  Opacity="0.15"
                                  Color="#1E3A5F"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Card header strip -->
                <Border Grid.Row="0"
                        CornerRadius="14,14,0,0"
                        Padding="18,12"
                        Background="{StaticResource HeaderGradient}">
                    <Grid>
                        <TextBlock Text="ASSIUM"
                                   Foreground="White"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Left"/>

                        <TextBlock Text="CARTE MANAGER"
                                   Foreground="#FDE68A"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Identity -->
                <StackPanel Grid.Row="1" Margin="20,16,20,0">
                    <TextBlock x:Name="TxtFullName"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#1E3A5F"/>

                    <TextBlock x:Name="TxtRole"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="12"
                               Foreground="#64748B"
                               Margin="0,4,0,0"/>

                    <TextBlock x:Name="TxtPos"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="11"
                               Foreground="#94A3B8"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Barcode -->
                <StackPanel Grid.Row="2"
                            Margin="20,0,20,4"
                            HorizontalAlignment="Center">
                    <ctrl:Code128Barcode x:Name="Barcode"
                                         Height="56"
                                         ModuleWidth="1.6"/>

                    <TextBlock x:Name="TxtCode"
                               FontFamily="Consolas"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#1E3A5F"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Footer -->
                <Border Grid.Row="3"
                        Padding="20,10"
                        Background="#F8FAFC"
                        CornerRadius="0,0,14,14"
                        BorderBrush="#E2E8F0"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <TextBlock x:Name="TxtIssued"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="10"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Left"/>

                        <TextBlock Text="SFE • Système Fiscal Électronique"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="10"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
            Content="Fermer"
            Style="{StaticResource BtnGhost}"
            Click="OnClose"/>

            <!-- 80 mm thermal receipt (barcode only) -->
            <Button Grid.Column="2"
            Style="{StaticResource BtnGhost}"
            Margin="0,0,8,0"
            ToolTip="Imprimer uniquement le code-barres sur imprimante thermique 80 mm (Xprinter)"
            Click="OnPrintThermal">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="ReceiptTextOutline"
                         Width="18"
                         Height="18"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0"/>
                    <TextBlock Text="Ticket 80 mm"
                       VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Full card (regular printer) -->
            <Button Grid.Column="3"
            Style="{StaticResource BtnPrimary}"
            Click="OnPrint">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Printer"
                         Width="18"
                         Height="18"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0"/>
                    <TextBlock Text="Imprimer la carte"
                       VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>